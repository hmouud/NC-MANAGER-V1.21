+class TestDimensionLineDrag(unittest.TestCase):
+    """F5 -- the dimension LINE drags in parallel with extension lines."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_2d_line_drag_parallel(self):
+        w = NcViewer()
+        w.resize(800, 500)
+        w.set_geometry_object(MULTI_FACE)
+        w.set_mode('measure')
+        w.mousePressEvent(_press(*w._to_screen(300.0, 325.0)))
+        w.mousePressEvent(_press(*w._to_screen(3300.0, 325.0)))
+        self.assertEqual(len(w._measurements), 1)
+        # press ON the line (midpoint) -> dim drag starts
+        s1, s2, p1, p2, _perp, _off = w._measure_line_geometry(0)
+        mid = QPointF((p1.x() + p2.x()) / 2, (p1.y() + p2.y()) / 2)
+        self.assertEqual(w._measure_line_at(mid), 0)
+        w.mousePressEvent(_press(mid.x(), mid.y()))
+        self.assertEqual(w._dim_drag, 0)
+        # move perpendicular: 20 px up -> dim_off follows the perpendicular
+        w.mouseMoveEvent(_move(mid.x(), mid.y() - 20.0))
+        _s1, _s2, _p1, _p2, _perp, dim_off = w._measure_line_geometry(0)
+        self.assertNotAlmostEqual(dim_off, 0.0, delta=1e-6)
+        self.assertAlmostEqual(abs(dim_off), 20.0, delta=1e-6)
+        w.mouseReleaseEvent(_release(mid.x(), mid.y() - 20.0))
+        self.assertIsNone(w._dim_drag)
+        # the measured points are untouched: the value never changes
+        self.assertEqual(len(w._measurements), 1)
+
+    def test_2d_clear_measurements(self):
+        w = NcViewer()
+        w.resize(800, 500)
+        w.set_geometry_object(MULTI_FACE)
