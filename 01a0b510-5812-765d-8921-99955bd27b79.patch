+class TestExactBand(unittest.TestCase):
+    """Two-band priority: strong kinds dominate near a corner."""
+
+    def _corner_targets(self):
+        return OsnapTargets(
+            points=[(0, 0), (100, 0)],
+            segments=[((0, 0), (100, 0)), ((0, 0), (0, 50))],
+        )
+
+    def test_band_prefers_endpoint_within_band(self):
+        # cursor (4,3): endpoint at (0,0) is 5px away (inside the band) and
+        # must beat the nearer nearest-foot (4,0, 3px) thanks to priority.
+        t = self._corner_targets()
+        pt, kind, _ = resolve_osnap(t, (4.0, 3.0),
+                                    (ENDPOINT, NEAREST), tol=12.0,
+                                    exact_band=6.0)
+        self.assertEqual(kind, ENDPOINT)
+        self.assertEqual(pt, (0, 0))
+
+    def test_no_band_keeps_closest(self):
+        # default exact_band=0.0 preserves the historical closest-point rule
+        t = self._corner_targets()
+        pt, kind, _ = resolve_osnap(t, (5.0, 4.0),
+                                    (ENDPOINT, NEAREST), tol=12.0)
+        self.assertEqual(kind, NEAREST)
+
+    def _junction_targets(self):
+        # a CAPNEST-style slot: tiny centre circle next to an in-band line-arc
+        # junction intersection (both within the 4 px exact band)
+        return OsnapTargets(
+            circles=[(0.0, 0.0, 0.3)],
+            segments=[((3.0, -20.0), (3.0, 20.0))],
+            arcs=[(0.0, 0.0, 4.0, -90.0, 90.0)],
+        )
+
+    def test_dead_on_centre_beats_inband_intersection(self):
+        # cursor exactly on the centre: the dead-on CENTRE wins even though a
+        # junction INTERSECTION sits inside the exact band a few px away
+        t = self._junction_targets()
+        pt, kind, _ = resolve_osnap(t, (0.0, 0.0), (CENTRE, INTERSECTION),
+                                    tol=12.0, exact_band=4.0)
+        self.assertEqual(kind, CENTRE)
+        self.assertEqual(pt, (0.0, 0.0))
+
+    def test_inband_priority_still_dominates_offcentre(self):
+        # cursor 1 px off the centre: no dead-on, so INTERSECTION (prio 1)
+        # still beats CENTRE (prio 2) inside the band - the sticky-strong rule
+        t = self._junction_targets()
+        pt, kind, _ = resolve_osnap(t, (1.0, 0.0), (CENTRE, INTERSECTION),
+                                    tol=12.0, exact_band=4.0)
+        self.assertEqual(kind, INTERSECTION)
+
+
+class TestDesignFacade(unittest.TestCase):
+    def test_facade_reexports_engine(self):
+        from nccorrection import design
+        from nccorrection.design import snaps as facade
+        from nccorrection.design.snaps import resolve_snap, SnapTargets
+        self.assertIs(facade.resolve_snap, resolve_osnap)
+        self.assertIs(facade.SnapTargets, OsnapTargets)
+        self.assertIs(resolve_snap, resolve_osnap)
+        self.assertIs(SnapTargets, OsnapTargets)
+        self.assertIs(design.resolve_snap, resolve_osnap)
+        self.assertIs(design.SnapTargets, OsnapTargets)
+
+
+if __name__ == '__main__':
+    unittest.main()
