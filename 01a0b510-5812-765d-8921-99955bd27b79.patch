+    def test_3d_pick_dstv_maps_bottom_flange(self):
+        """The default 3D camera views the -z side, so the visible surface
+        is the bottom flange (u): pick_dstv maps the clicked surface to the
+        real DSTV u-face. The signed-depth scoring disambiguates the
+        coincident v/h/o/u planes (from_3d alone returns an inside point
+        for several of them). The click sits beside the web (y=-60) so the
+        ray deterministically hits the flange plane, never the web-bottom
+        strip at the same z."""
+        self._load_beam()
+        v3 = self.w.viewer3d
+        v3.resize(900, 700)
+        v3.fit_view()
+        sx, sy = v3._project((300.0, -60.0, 0.0))  # visible bottom plane z=0
+        res = v3.pick_dstv(QPointF(sx, sy))
+        self.assertIsNotNone(res)
+        face, x, y = res
+        self.assertEqual(face, 'u')
+        # u-frame anchor (0,-b/2,0): DSTV y = world y + b/2 = -60 + 75
+        self.assertAlmostEqual(x, 300.0, delta=1e-3)
+        self.assertAlmostEqual(y, 15.0, delta=1e-3)
+
+    def test_3d_pick_dstv_maps_web_rear_from_front_preset(self):
+        """The app's 'front' preset (camera along +y) reveals the web REAR
+        side (visible facet at y=-tw/2): pick_dstv maps it to the DSTV h
+        face at the clicked part coords. The signed-depth scoring resolves
+        the coincident v/h plane (both frames sit on y=0) to the +d side --
+        the surface the user is actually looking at. The preset deliberately
+        keeps a 0.02 rad tilt (edge-on degeneracy), so the picked z sits a
+        fraction of a millimetre off 150 -> assert with a 0.5 mm tolerance."""
+        self._load_beam()
+        v3 = self.w.viewer3d
+        v3.resize(900, 700)
+        v3.set_preset('front')
+        v3.fit_view()
+        sx, sy = v3._project((300.0, 0.0, 150.0))  # web plane y=0, z=150
+        res = v3.pick_dstv(QPointF(sx, sy))
+        self.assertIsNotNone(res)
+        face, x, y = res
+        self.assertEqual(face, 'h')
+        self.assertAlmostEqual(x, 300.0, delta=1e-3)
+        self.assertAlmostEqual(y, 150.0, delta=0.5)
+
