+    def _import_cad_files(self, paths, kind):
+        """Import individually picked CAD/NC files with the SAME project law
+        as the folder import (owner 2026-08-19/20): flat copy under the
+        ORIGINAL name inside projects/<order>/, order line handled per kind,
+        same-name conflicts deferred to Replace / Ignore / Compare at the
+        end. The import mechanism itself is NOT touched - this is a new
+        entry point that reuses it.
+        - kind 'nc' : the order is read from the file content (choice
+          dialog when several distinct orders are found).
+        - kind 'dxf': the order is the user's choice (existing project or a
+          new name); the part is a PLATE (PL4..PL40) with a manual quantity;
+          the stored copy keeps its original name and content (DXF has no
+          order line to rewrite).
+        """
+        if not paths:
+            return
+        entries = []
+        for p in paths:
+            try:
+                with open(p, 'rb') as fh:
+                    raw = fh.read()
+                st = os.stat(p)
+            except OSError:
+                continue
+            if kind == 'nc':
+                text = raw.decode('latin-1')
+                order = _extract_order(text) or ''
+            else:  # dxf
+                text = raw.decode('latin-1', errors='replace')
+                order = ''
+            entries.append({
+                'path': p, 'name': os.path.basename(p), 'text': text,
+                'hash': compute_hash(raw), 'order': order, 'kind': kind,
+                'size': st.st_size, 'ctime': st.st_ctime, 'mtime': st.st_mtime,
+            })
+        if not entries:
+            self._set_status(self.tr_('import_folder_empty'))
+            self._toast(self.tr_('import_folder_empty'), kind='warn',
+                        title=self.tr_('add_files'))
+            return
+        # 1) order / project name
+        if kind == 'nc':
+            orders = distinct_orders(entries)
+            if len(orders) > 1:
+                chosen = self._ask_order_choice(orders)
+            elif len(orders) == 1:
+                chosen = orders[0]
+            else:
+                chosen = self._ask_import_project_name()
+        else:
+            chosen = self._ask_dxf_order()
+        if not chosen:
+            self._set_status(self.tr_('import_cancelled'))
+            return
+        self._current_project = chosen
+        # 2) DXF plate params (thickness + quantity), once for all files
+        thickness = qty = None
+        if kind == 'dxf':
+            params = self._ask_dxf_params()
+            if not params:
+                self._set_status(self.tr_('import_cancelled'))
+                return
+            thickness, qty = params
+        # Same open-or-empty rule as the folder import.
+        if os.path.isdir(self.projects.project_path(chosen)) \
+                and self.projects.load_project(chosen) is not None:
+            self._load_project(chosen)
+        else:
+            self.files = []
+        base = self.projects.project_path(self._current_project)
+        imported = 0
+        conflicts = []
+        added_hashes = set()
+        for inc in entries:
+            if kind == 'nc':
+                new_text = _replace_order_in_text(inc['text'], self._current_project)
+                new_hash = compute_hash(new_text.encode('latin-1'))
+            else:
+                new_text = inc['text']
+                new_hash = inc['hash']
+            if kind == 'nc':
+                c = classify_text(new_text, inc['name'])
+                rec = self._make_record(inc['path'], new_text, new_hash, c)
+            else:
+                rec = self._make_dxf_record(inc, thickness, qty)
+            rec['order'] = self._current_project
+            rec['src_path'] = inc['path']
+            rec['ctime'] = inc['ctime']
+            rec['mtime'] = inc['mtime']
+            rec['size'] = inc['size']
+            stored, status = self.projects.store_copy(
+                self._current_project, inc['name'], inc['path'],
+                new_text, new_hash)
+            if status == 'conflict':
+                conflicts.append({'rec': rec, 'stored': stored})
+                continue
+            if status == 'duplicate':
+                continue
+            rec['path'] = os.path.join(base, stored)
+            self.files.append(rec)
+            added_hashes.add(rec['hash'])
+            imported += 1
+        for conf in conflicts:
+            action = self._ask_folder_conflict(conf['rec'])
+            if action == 'replace':
+                stored, status = self.projects.store_copy(
+                    self._current_project, conf['rec']['name'],
+                    conf['rec']['src_path'], conf['rec']['text'],
+                    conf['rec']['hash'], overwrite=True)
+                conf['rec']['path'] = os.path.join(base, stored)
+                for i, f in enumerate(self.files):
+                    if f.get('name', '').lower() == \
+                            conf['rec']['name'].lower():
+                        self.files[i] = conf['rec']
+                        break
+                else:
+                    self.files.append(conf['rec'])
+                added_hashes.add(conf['rec']['hash'])
+                imported += 1
+        self.projects.save_project(
+            self._current_project, self.files,
+            settings={k: self.settings.get(k) for k in
+                      ('language', 'theme', 'outputName', 'themeCustom')},
+            notes=dict(self.settings.get_all_notes() or {}),
+            hole_overrides=self.hole_overrides,
+            hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+            added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+            qty_overrides={h: f.get('qty_override') for f in self.files
+                           for h in [f['hash']] if f.get('qty_override') is not None},
+            source_folder=None,
+            orders=self.orders)
+        self._render_table()
+        self._refresh_order_combo()
+        self._saved_hashes = {f['hash'] for f in self.files}
+        self._session_edited.update(f['hash'] for f in self.files)
+        self._session_added.update(added_hashes)
+        done = (self.tr_('dxf_import_done') if kind == 'dxf'
+                else self.tr_('import_done'))
+        self._set_status(f'+{imported} ' + done.format(n=imported) + ' '
+                         + self._current_project)
+        self.audit.log(f'Imported {imported} {kind} file(s) into project '
+                       f'{self._current_project}', 'ok' if imported else 'warn',
+                       'OK-105')
+
+    def _make_dxf_record(self, inc, thickness, qty):
+        """Record for a DXF import: always a PLATE (owner spec: DXF = 2D
+        plate parts; profile PL<thickness>, family PL like the classifier),
+        quantity entered manually."""
+        return {
+            'name': inc['name'], 'path': inc['path'], 'text': inc['text'],
+            'hash': inc['hash'], 'src_path': inc['path'],
+            'category': 'PLATE', 'family': 'PL', 'profile': thickness,
+            'folder': thickness, 'status': self.tr_('ready'),
+            'qty': qty, 'qty_override': None, 'o': None, 'si': False,
+            'size': inc['size'], 'modified': inc['mtime'],
+            'steel': thickness, 'quality': thickness,
+            'order': '', 'dirty': False, 'kind': 'dxf',
+            'length_mm': 0, 'weight': 0,
+        }
+
+    def _find_dwg_converter(self):
+        """Locate the ODA File Converter: settings override, well-known
+        install path, or the bundled tools/ folder (owner: the converter
+        must be embedded inside the program, not run standalone)."""
+        try:
+            cfg = self.settings.get('dwg_converter')
+        except Exception as e:
+            self._report_error('dwg-converter-settings', e)
+            cfg = None
+        if cfg and os.path.isfile(cfg):
+            return cfg
+        for root in (r'C:\Program Files\ODA\ODAFileConverter',
+                     r'C:\Program Files (x86)\ODA\ODAFileConverter'):
+            exe = os.path.join(root, 'ODAFileConverter.exe')
+            if os.path.isfile(exe):
+                return exe
+        try:
+            bundled = os.path.join(self.resources.base_dir, 'tools',
+                                   'ODAFileConverter.exe')
+        except Exception as e:
+            self._report_error('dwg-converter-bundled', e)
+            bundled = ''
+        if bundled and os.path.isfile(bundled):
+            return bundled
+        return ''
+
+    def _dwg_convert(self, converter, paths):
+        """Convert DWG files to DXF via the ODA converter (batch mode) in a
+        temp folder; returns the list of produced .dxf paths."""
+        import shutil
+        import subprocess
+        import tempfile
+        src = tempfile.mkdtemp(prefix='ncm_dwg_')
+        out = tempfile.mkdtemp(prefix='ncm_dxf_')
+        try:
+            for p in paths:
+                shutil.copy2(p, src)
+            subprocess.run([converter, src, out, 'ACAD2018', 'DXF', '0', '1'],
+                           timeout=120, check=False)
+            return [os.path.join(out, f) for f in os.listdir(out)
+                    if f.lower().endswith('.dxf')]
+        except Exception as e:
+            self._report_error('dwg-convert-run', e, toast=True)
+            return []
+        finally:
+            shutil.rmtree(src, ignore_errors=True)
+
+    def _import_dwg_files(self, paths):
+        """DWG import integration point (owner 2026-08-20): DWG is decoded
+        through the ODA File Converter (embedded in the program) or the
+        LibreDWG route. Until a converter is available/configured the user
+        gets a clear message and NOTHING is modified."""
+        if not paths:
+            return
+        converter = self._find_dwg_converter()
+        if not converter:
+            QMessageBox.warning(self, self.tr_('dwg_missing'),
+                                self.tr_('dwg_missing_msg'))
+            return
+        out = self._dwg_convert(converter, paths)
+        if not out:
+            QMessageBox.warning(self, self.tr_('dwg_convert_fail'),
+                                ', '.join(os.path.basename(p) for p in paths))
+            return
+        try:
+            self._import_cad_files(out, 'dxf')
+        finally:
+            import shutil
+            shutil.rmtree(os.path.dirname(out[0]), ignore_errors=True)
+
+    def _dxf_file(self, f):
+        """True when a record is a DXF part (kind marker, or original
+        .dxf name after a project reload where only standard fields
+        survive)."""
+        return (f.get('kind') == 'dxf'
+                or (f.get('name') or '').lower().endswith('.dxf'))
+
+    def _flat_suffixed_dst(self, base, safe_name):
+        """Organizer-style numeric suffix for a flat stored copy when the bare
+        display name is already occupied inside the project folder
+        (``C1_2.nc1`` - the DISPLAY name never changes, only the stored file
+        gets the suffix, exactly like the sort-into-folders collision rule)."""
+        root, ext = os.path.splitext(safe_name)
+        n = 2
+        dst = os.path.join(base, f'{root}_{n}{ext}')
+        while os.path.exists(dst):
+            n += 1
+            dst = os.path.join(base, f'{root}_{n}{ext}')
+        return dst
+
+    def _import_folder(self, folder):
+        """NEW folder import (owner law 2026-08-19).
+
+        The user picks a FOLDER. The program scans the NC/NC1 files inside,
+        reads the ORDER from inside each file, and when several distinct
+        orders are found asks the user to pick one (or type their own).
+        The project folder ``projects/<chosen>`` is created, every imported
+        NC1 is stored under its ORIGINAL file name (flat, NO hash in the
+        path) and the order line inside each file is REWRITTEN to the chosen
+        name. Same-name conflicts NEVER block the import: they are collected
+        and shown at the END with Replace / Ignore / Compare (each file's
+        creation date and modification info displayed).
+        """
+        scan = scan_folder(folder)
+        if not scan:
+            self._set_status(self.tr_('import_folder_empty'))
+            self._toast(self.tr_('import_folder_empty'), kind='warn',
+                        title=self.tr_('add_files'))
+            return
+        orders = distinct_orders(scan)
+        if len(orders) > 1:
+            chosen = self._ask_order_choice(orders)
+        elif len(orders) == 1:
+            chosen = orders[0]
+        else:
+            chosen = self._ask_import_project_name()
+        if not chosen:
+            self._set_status(self.tr_('import_cancelled'))
+            return
+        self._current_project = chosen
+
+        # If the chosen project already exists, OPEN it first (_load_project
+        # rebuilds the records with size/modified and restores overrides):
+        # the conflict dialogs need the existing file's info (creation date,
+        # modification time), the replace branch needs the existing row, and
+        # save_project below must never rewrite the manifest without them.
+        # A brand-new project starts with an EMPTY file list (folder import
+        # = isolated project, never mixed with whatever was open before).
+        if os.path.isdir(self.projects.project_path(chosen)) \
+                and self.projects.load_project(chosen) is not None:
+            self._load_project(chosen)
+        else:
+            self.files = []
+
+        total = len(scan)
+        prog = QProgressDialog(f'Import {self._current_project}...',
+                               self.tr_('cancel'), 0, total, self)
+        prog.setWindowTitle(self.tr_('import_order_title'))
+        prog.setWindowModality(Qt.WindowModal)
+        prog.setMinimumDuration(0)
+
+        imported = 0
+        conflicts = []
+        added_hashes = set()
+        base = self.projects.project_path(self._current_project)
+        for i, inc in enumerate(scan):
+            prog.setValue(i)
+            QApplication.processEvents()
+            if prog.wasCanceled():
+                break
+            # The order INSIDE the file follows the chosen project name
+            # (owner law: header + stored file + project folder all change).
+            new_text = _replace_order_in_text(inc['text'], self._current_project)
+            # Identity = the EXACT stored bytes (rewritten header) - the same
+            # rule P3/P6 already use (content hash of the stored copy).
+            new_hash = compute_hash(new_text.encode('latin-1'))
+            c = classify_text(new_text, inc['name'])
+            rec = self._make_record(inc['path'], new_text, new_hash, c)
+            rec['order'] = self._current_project
+            rec['src_path'] = inc['path']
+            rec['ctime'] = inc['ctime']
+            rec['mtime'] = inc['mtime']
+            rec['size'] = inc['size']
+            stored, status = self.projects.store_copy(
+                self._current_project, inc['name'], inc['path'],
+                new_text, new_hash)
+            if status == 'conflict':
+                conflicts.append({'rec': rec, 'stored': stored})
+                continue
+            if status == 'duplicate':
+                continue
+            rec['path'] = os.path.join(base, stored)
+            self.files.append(rec)
+            added_hashes.add(rec['hash'])
+            imported += 1
+        prog.setValue(total)
+
+        # Deferred conflicts: shown at the END so they never block the
+        # import (owner requirement). Per conflict: Replace / Ignore /
+        # Compare with the creation + modification info of both files.
+        for conf in conflicts:
+            action = self._ask_folder_conflict(conf['rec'])
+            if action == 'replace':
+                stored, status = self.projects.store_copy(
+                    self._current_project, conf['rec']['name'],
+                    conf['rec']['src_path'], conf['rec']['text'],
+                    conf['rec']['hash'], overwrite=True)
+                conf['rec']['path'] = os.path.join(base, stored)
+                # Replace the EXISTING row in place (same name -> one row).
+                for i, f in enumerate(self.files):
+                    if f.get('name', '').lower() == \
+                            conf['rec']['name'].lower():
+                        self.files[i] = conf['rec']
+                        break
+                else:
+                    self.files.append(conf['rec'])
+                added_hashes.add(conf['rec']['hash'])
+                imported += 1
+            # ignore -> the incoming file is skipped; compare -> the user
+            # looked at both files and decided inside the dialog.
+
+        self.projects.save_project(
+            self._current_project, self.files,
+            settings={k: self.settings.get(k) for k in
+                      ('language', 'theme', 'outputName', 'themeCustom')},
+            notes=dict(self.settings.get_all_notes() or {}),
+            hole_overrides=self.hole_overrides,
+            hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+            added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+            qty_overrides={h: f.get('qty_override') for f in self.files
+                           for h in [f['hash']] if f.get('qty_override') is not None},
+            source_folder=folder,
+            orders=self.orders)
+
+        self._render_table()
+        self._refresh_order_combo()
+        self._saved_hashes = {f['hash'] for f in self.files}
+        self._session_edited.update(f['hash'] for f in self.files)
+        self._session_added.update(added_hashes)
+        self._set_status(f'+{imported} ' + self.tr_('import_done')
+                         .format(n=imported) + ' ' + self._current_project)
+        self.audit.log(f'Imported {imported} file(s) into project '
+                       f'{self._current_project} from folder {folder}',
+                       'ok' if imported else 'warn', 'OK-105')
+
