+def _press(x, y, ctrl=False):
+    mod = Qt.ControlModifier if ctrl else Qt.NoModifier
+    return QMouseEvent(QEvent.MouseButtonPress, QPointF(x, y),
+                       Qt.LeftButton, Qt.LeftButton, mod)
