+"""Order (job number) extraction/rewrite rules for NC1 ST headers.
+
+Single source of truth for the order line rules - shared by the importer
+(core) and the UI (app.py imports these). NEVER duplicate these scanning
+rules elsewhere.
+"""
+import re
+
+_STOP_AT = re.compile(
+    r'^\s*(?:AK|IK|BO|SI|PU|KO|KA|EO|HA|CO|OZ|EV|BK|EZ|WH)\b', re.I)
+_RECORD_CODES = {'ST', 'AK', 'IK', 'BO', 'SI', 'PU', 'KO', 'KA',
+                 'EO', 'HA', 'CO', 'OZ', 'EV', 'BK', 'EZ', 'WH'}
+
+
+def _extract_order(text):
+    """Extract the job/order number from the NC1 ST header block.
+
+    Only the lines of the ST header are scanned (scanning stops at the first
+    geometry record: AK/IK/BO/SI/PU/KO/KA) so hole coordinates like ``100.00``
+    are never mistaken for an order. The ``ST`` marker, comments (``**``) and
+    record-code lines are skipped; the first remaining header line wins.
+    """
+    for raw in (text or '').splitlines():
+        x = raw.strip()
+        if not x or x.startswith('**'):
+            continue
+        if x.upper() in _RECORD_CODES:
+            continue
+        if _STOP_AT.match(x):
+            return ''
+        return x
+    return ''
+
+
+def _replace_order_in_text(text, new_order):
+    """Replace the order line inside the NC1 ST header with ``new_order``.
+
+    Uses exactly the same scanning rules as ``_extract_order``: the first
+    non-comment, non-record-code header line before any geometry record is the
+    order line and gets replaced (indentation preserved). The display file name
+    (e.g. ``C1.nc1``) is NEVER changed - only the order content inside the file.
+    Returns the original text unchanged when no order line is found.
+    """
+    lines = (text or '').splitlines(keepends=True)
+    for i, raw in enumerate(lines):
+        x = raw.strip()
+        if not x or x.startswith('**'):
+            continue
+        if x.upper() in _RECORD_CODES:
+            continue
+        if _STOP_AT.match(x):
+            break
+        indent = raw[:len(raw) - len(raw.lstrip())]
+        lines[i] = indent + new_order + ('\n' if raw.endswith('\n') else '')
+        return ''.join(lines)
+    return text
\ No newline at end of file
