+def _read(path):
+    with open(path, encoding='ascii') as fh:
+        return fh.read()
+
+
+def _entities(text, layer):
+    """(entity_type, tag/value-pairs) groups whose layer matches."""
+    lines = text.splitlines()
+    out = []
+    i = 0
+    n = len(lines)
+    while i < n - 1:
+        if lines[i] == '0' and lines[i + 1] in ('LINE', 'CIRCLE'):
+            etype = lines[i + 1]
+            j = i + 2
+            grp = []
+            while j < n and lines[j] != '0':
+                grp.append((lines[j], lines[j + 1]))
+                j += 2
+            if any(pair[0] == '8' and pair[1] == layer for pair in grp):
+                out.append((etype, grp))
+            i = j
+        else:
+            i += 2
+    return out
+
+
+def _lines_on(text, layer):
+    return [g for t, g in _entities(text, layer) if t == 'LINE']
+
+
+def _circles_on(text, layer):
+    return [g for t, g in _entities(text, layer) if t == 'CIRCLE']
+
+
+def _points(grp, tag):
+    """(x, y) list from a LINE group using 10/20 (tag) and 11/21."""
+    vals = {}
+    for k, v in grp:
+        vals[k] = v
+    if tag == '10':
+        return [(float(vals['10']), float(vals['20']))]
+    return [(float(vals['11']), float(vals['21']))]
+
+
+def _circle(grp):
+    vals = {k: v for k, v in grp}
+    return (float(vals['10']), float(vals['20']), float(vals['40']))
+
+
