+class TestTitleBlockAndMiterAngles(unittest.TestCase):
+    """STEP 1 (Fabrication Title Block) + STEP 2 (auto miter-cut angles).
+
+    Verifies the cartouche renders onto the unfolded blueprint and that the
+    non-90-degree end-cut detection math is correct (0 deg on a straight web,
+    a real non-zero angle on a diagonal end).
+    """
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        self.w = DstvRenderer2D()
+        self.w.resize(900, 640)
+
+    # ---------------------------------------------------------------- STEP 2
+    def test_straight_web_has_no_miter_angle(self):
+        """A web with perfectly vertical ends (the SAMPLE preset) must NOT be
+        reported as a miter: every end run yields abs(atan2(dx, dy)) < 0.1."""
+        part = DstvParser().parse_text(SAMPLE)
+        self.w.set_part(part)
+        vface = part.get_face('v')
+        verts = vface.outer_contour.vertices
+        n = len(verts)
+        ys = [v.y for v in verts]
+        span = max(ys) - min(ys)
+
+        def end_run(pair):
+            a, b = pair
+            return abs(a.y - b.y) >= 0.9 * span
+
+        angles = []
+        for i in range(n):
+            a, b = verts[i], verts[(i + 1) % n]
+            dx = a.x - b.x
+            dy = a.y - b.y
+            if end_run((a, b)) and abs(dy) >= 1e-6:
+                # match the renderer: deviation-from-vertical magnitude
+                angles.append(math.degrees(math.atan2(abs(dx), abs(dy))))
+        # SAMPLE web ends are perfectly vertical -> every end angle ~ 0 deg
+        self.assertTrue(angles)
+        for ang in angles:
+            self.assertLess(abs(ang), 0.1)
+
+        # the drawing path executes cleanly (no exceptions) on a pixmap
+        pm = QPixmap(self.w.size())
+        pm.fill(QColor('white'))
+        p = QPainter(pm)
+        self.w._draw_miter_angles(p, vface, lambda x, y: (x, y))
+        p.end()
+        self.assertFalse(pm.isNull())
+
+    def test_diagonal_web_end_matches_atan2_math(self):
+        """The MITER preset's right end runs from (5000,0) bottom to
+        (4990,190) top. The detected angle must equal the exact
+        math.degrees(math.atan2(dx, dy)) applied to that end run, and be
+        > 0.1 so a miter callout actually fires."""
+        part = DstvParser().parse_text(MITER)
+        self.w.set_part(part)
+        vface = part.get_face('v')
+        verts = vface.outer_contour.vertices
+        # the right end is the run connecting the max-X bottom corner and the
+        # top corner it joins; in the preset the pair is (5000,0) -> (4990,190)
+        right_run = None
+        for i in range(len(verts)):
+            a, b = verts[i], verts[(i + 1) % len(verts)]
+            if a.x == 5000.0 and b.x == 4990.0:
+                right_run = (a, b)
+                break
+        self.assertIsNotNone(right_run)
+        a, b = right_run
+        dx = abs(a.x - b.x)
+        dy = abs(a.y - b.y)
+        self.assertAlmostEqual(dx, 10.0, delta=1e-6)
+        self.assertAlmostEqual(dy, 190.0, delta=1e-6)
+        expected = math.degrees(math.atan2(dx, dy))
+        # ~ 3.01 deg, well past the 0.1 deg miter threshold
+        self.assertGreater(abs(expected), 0.1)
+
+        # the drawing path executes cleanly on the miter part (no exceptions)
+        pm = QPixmap(self.w.size())
+        pm.fill(QColor('white'))
+        p = QPainter(pm)
+        self.w._draw_miter_angles(p, vface, lambda x, y: (x, y))
+        p.end()
+        self.assertFalse(pm.isNull())
+
+    # ---------------------------------------------------------------- STEP 1
+    def test_title_block_draws_on_unfold(self):
+        """The Fabrication Title Block is drawn after the geometry on the
+        unfolded blueprint. It must execute cleanly to a pixmap, with the
+        part's header fields (position mark, profile, length, quantity,
+        grade, order) read verbatim without crashing."""
+        part = DstvParser().parse_text(SAMPLE)
+        self.w.set_part(part)
+        self.w.set_unfold_mode(True)
+        self.assertTrue(self.w._show_title_block)
+        self.assertTrue(self.w._show_cut_angles)
+        pm = QPixmap(self.w.size())
+        pm.fill(QColor(self.w._bp['bg']))
+        p = QPainter(pm)
+        self.w.render_unfolded(p)
+        p.end()
+        self.assertFalse(pm.isNull())
+        # header data reachable for the cartouche cells; the parser now fills
+        # profile_name / length / quantity / steel_grade / order_id AND
+        # position_mark (STEP 2: line index 1 of the ST block). In the SAMPLE
+        # fixture line index 1 is '1', so position_mark == '1'.
+        hdr = part.header
+        self.assertEqual(hdr.profile_name, 'HEA200')
+        self.assertEqual(hdr.length, 5000.0)
+        self.assertEqual(hdr.quantity, 1)
+        self.assertEqual(hdr.steel_grade, 'S235JR')
+        self.assertEqual(hdr.position_mark, '1')
+
+
+if __name__ == '__main__':
+    unittest.main()
