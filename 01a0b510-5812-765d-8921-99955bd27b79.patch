@@ -0,0 +1,648 @@
+"""Interactive Canvas — Live unfolded view with zoom, pan, and Tekla cotation.
+
+Renders the unfolded flat pattern of structural profiles (I, U, L, B, T)
+with face mapping (.v, .o, .u, .h) and automatic e/ga dimensioning.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Optional, Tuple, Dict
+
+from PySide6.QtWidgets import QWidget, QMenu
+from PySide6.QtGui import (
+    QPainter, QPen, QColor, QFont, QFontMetrics,
+    QBrush, QPolygonF, QPainterPath,
+)
+from PySide6.QtCore import Qt, QPointF, QRectF, Signal
+
+from nccorrection.ui._colors import C
+
+
+# ────────────────────────────────────────────────────────────────────
+# Face colors (Tekla-style)
+# ────────────────────────────────────────────────────────────────────
+
+_FACE_COLORS = {
+    'v': QColor("#38bdf8"),   # Web — cyan
+    'o': QColor("#22c55e"),   # Top flange — green
+    'u': QColor("#f97316"),   # Bottom flange — orange
+    'h': QColor("#a78bfa"),   # Rear web — purple
+}
+
+_FACE_LABELS = {
+    'v': "Web (.v)",
+    'o': "Top Flange (.o)",
+    'u': "Bottom Flange (.u)",
+    'h': "Rear Web (.h)",
+}
+
+
+# ────────────────────────────────────────────────────────────────────
+# Geometry builder — unfolds profile faces into flat pattern
+# ────────────────────────────────────────────────────────────────────
+
+def build_unfolded_geometry(
+    profile_kind: str,
+    length: float,
+    depth: float,
+    width: float,
+    web_thick: float,
+    flange_thick: float,
+    angle_steg_front: float = 0.0,
+    angle_steg_rear: float = 0.0,
+    angle_flange_front: float = 0.0,
+    angle_flange_rear: float = 0.0,
+) -> Dict[str, List[Tuple[float, float]]]:
+    """Build the unfolded flat pattern geometry for a structural profile.
+
+    Returns a dict of face_key → list of (x, y) contour points.
+    Coordinates are in mm, origin at bottom-left of the unfolded pattern.
+
+    Unfolding logic (Tekla standard):
+      - I-beam:  o (top flange) → v (web) → u (bottom flange)
+      - U-channel: o (top flange) → v (web) → u (bottom flange)
+      - L-angle: o (horizontal leg) → v (vertical leg)
+      - B (plate): single face v
+      - T (SHS/RHS): single face v (simplified)
+
+    Cut angles offset the left/right edges of each face by
+    depth * tan(angle), giving a Tekla-style diagonal-cut view.
+    """
+    import math
+
+    def _dx(depth_face: float, angle_deg: float) -> float:
+        """Horizontal offset for a cut angle on a face of given height."""
+        if angle_deg == 0.0:
+            return 0.0
+        return depth_face * math.tan(math.radians(angle_deg))
+
+    faces = {}
+
+    if profile_kind == 'I':
+        # I-beam unfolded: top flange → web → bottom flange
+        web_h = depth - 2 * flange_thick
+
+        # Front/rear offsets for flange and web
+        fl_f = _dx(flange_thick, angle_flange_front)
+        fl_r = _dx(flange_thick, angle_flange_rear)
+        w_f = _dx(web_h, angle_steg_front)
+        w_r = _dx(web_h, angle_steg_rear)
+
+        # Top flange (o) — angled cut on front (left) and rear (right) edges
+        faces['o'] = [
+            (fl_f, 0), (length - fl_r, 0),
+            (length - fl_r, flange_thick), (fl_f, flange_thick),
+        ]
+        # Web (v)
+        web_top = flange_thick
+        web_bottom = flange_thick + web_h
+        faces['v'] = [
+            (w_f, web_top), (length - w_r, web_top),
+            (length - w_r, web_bottom), (w_f, web_bottom),
+        ]
+        # Bottom flange (u)
+        faces['u'] = [
+            (fl_f, web_bottom), (length - fl_r, web_bottom),
+            (length - fl_r, web_bottom + flange_thick), (fl_f, web_bottom + flange_thick),
+        ]
+
+    elif profile_kind == 'U':
+        # U-channel unfolded: top flange → web → bottom flange
+        web_h = depth - 2 * flange_thick
+
+        fl_f = _dx(flange_thick, angle_flange_front)
+        fl_r = _dx(flange_thick, angle_flange_rear)
+        w_f = _dx(web_h, angle_steg_front)
+        w_r = _dx(web_h, angle_steg_rear)
+
+        faces['o'] = [
+            (fl_f, 0), (length - fl_r, 0),
+            (length - fl_r, flange_thick), (fl_f, flange_thick),
+        ]
+        web_top = flange_thick
+        web_bottom = flange_thick + web_h
+        faces['v'] = [
+            (w_f, web_top), (length - w_r, web_top),
+            (length - w_r, web_bottom), (w_f, web_bottom),
+        ]
+        faces['u'] = [
+            (fl_f, web_bottom), (length - fl_r, web_bottom),
+            (length - fl_r, web_bottom + flange_thick), (fl_f, web_bottom + flange_thick),
+        ]
+
+    elif profile_kind == 'L':
+        # L-angle unfolded: horizontal leg → vertical leg
+        leg_v = depth - flange_thick
+
+        fl_f = _dx(flange_thick, angle_flange_front)
+        fl_r = _dx(flange_thick, angle_flange_rear)
+        v_f = _dx(leg_v, angle_steg_front)
+        v_r = _dx(leg_v, angle_steg_rear)
+
+        faces['o'] = [
+            (fl_f, 0), (length - fl_r, 0),
+            (length - fl_r, flange_thick), (fl_f, flange_thick),
+        ]
+        faces['v'] = [
+            (v_f, flange_thick), (length - v_r, flange_thick),
+            (length - v_r, flange_thick + leg_v), (v_f, flange_thick + leg_v),
+        ]
+
+    else:
+        # Plate / tube / unknown: single face
+        faces['v'] = [
+            (0, 0), (length, 0),
+            (length, depth), (0, depth),
+        ]
+
+    return faces
+
+
+# ────────────────────────────────────────────────────────────────────
+# Canvas widget
+# ────────────────────────────────────────────────────────────────────
+
+class LiveUnfoldedCanvas(QWidget):
+    """Live interactive canvas for unfolded profile view.
+
+    Features:
+      - Zoom (mouse wheel) and pan (middle-click or Alt+left-click drag)
+      - Face mapping with color-coded regions
+      - Tekla-style cotation (e, ga, e) with automatic dimensioning
+      - Right-click context menu for adding holes/slots
+      - Real-time sync when parameters change
+    """
+
+    add_hole_requested = Signal(float, float, str)  # (x, y, face)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setMinimumSize(400, 300)
+        self.setStyleSheet(
+            f"background-color: #0b1121; border: 1px solid {C.line}; border-radius: 4px;"
+        )
+        self.setMouseTracking(True)
+
+        # Geometry data
+        self._faces: Dict[str, List[Tuple[float, float]]] = {}
+        self._holes: List[Dict] = []  # [{x, y, d, face}, ...]
+
+        # View transform
+        self._scale = 1.0
+        self._pan = QPointF(0, 0)
+        self._last_mouse: Optional[QPointF] = None
+
+        # Cotation
+        self._show_cotation = True
+        self._edge_distance = 20.0   # e (edge distance, mm)
+        self._gauge = 40.0           # ga (gauge/trusquinage, mm)
+
+        # Style
+        self._bg_color = QColor("#0b1121")
+        self._grid_color = QColor("#1e3a5f")
+        self._text_color = QColor(C.txt)
+        self._dim_color = QColor("#e67e22")      # amber for e
+        self._gauge_color = QColor("#00cec9")    # cyan for ga
+
+    # ── Data setters ──────────────────────────────────────────────
+
+    def set_faces(self, faces: Dict[str, List[Tuple[float, float]]]):
+        """Set the unfolded face geometry (from build_unfolded_geometry)."""
+        self._faces = faces
+        self._fit_view()
+        self.update()
+
+    def set_holes(self, holes: List[Dict]):
+        """Set hole positions [{x, y, d, face}, ...]."""
+        self._holes = holes or []
+        self.update()
+
+    def set_cotation_params(self, edge_dist: float = 20.0, gauge: float = 40.0):
+        """Set e (edge distance) and ga (gauge) values."""
+        self._edge_distance = edge_dist
+        self._gauge = gauge
+        self.update()
+
+    def toggle_cotation(self, show: bool):
+        """Show/hide cotation dimensions."""
+        self._show_cotation = show
+        self.update()
+
+    # ── View transforms ───────────────────────────────────────────
+
+    def _fit_view(self):
+        """Auto-fit the geometry to fill the canvas."""
+        all_pts = []
+        for pts in self._faces.values():
+            all_pts.extend(pts)
+        if not all_pts:
+            return
+        xs = [p[0] for p in all_pts]
+        ys = [p[1] for p in all_pts]
+        gw = max(xs) - min(xs)
+        gh = max(ys) - min(ys)
+        if gw <= 0 or gh <= 0:
+            return
+        pad = 60
+        ww = self.width() - 2 * pad
+        wh = self.height() - 2 * pad
+        self._scale = min(ww / gw, wh / gh)
+        # Center
+        cx = (min(xs) + max(xs)) / 2
+        cy = (min(ys) + max(ys)) / 2
+        self._pan = QPointF(
+            self.width() / 2 - cx * self._scale,
+            self.height() / 2 - cy * self._scale,
+        )
+
+    def _to_screen(self, x: float, y: float) -> QPointF:
+        """Transform world coords to screen coords."""
+        return QPointF(x * self._scale + self._pan.x(),
+                       y * self._scale + self._pan.y())
+
+    def _to_world(self, screen: QPointF) -> QPointF:
+        """Transform screen coords to world coords."""
+        return QPointF((screen.x() - self._pan.x()) / self._scale,
+                       (screen.y() - self._pan.y()) / self._scale)
+
+    # ── Mouse events ──────────────────────────────────────────────
+
+    def wheelEvent(self, event):
+        zoom_in = event.angleDelta().y() > 0
+        factor = 1.15 if zoom_in else 1.0 / 1.15
+        # Zoom toward cursor
+        cursor = event.position()
+        world_before = self._to_world(cursor)
+        self._scale *= factor
+        self._scale = max(0.05, min(50.0, self._scale))
+        # Adjust pan so cursor stays on the same world point
+        screen_after = self._to_screen(world_before.x(), world_before.y())
+        self._pan += cursor - screen_after
+        self.update()
+
+    def mousePressEvent(self, event):
+        if event.button() == Qt.MiddleButton or \
+           (event.button() == Qt.LeftButton and event.modifiers() == Qt.AltModifier):
+            self._last_mouse = event.position()
+            self.setCursor(Qt.ClosedHandCursor)
+        elif event.button() == Qt.RightButton:
+            self._show_context_menu(event.position())
+
+    def mouseMoveEvent(self, event):
+        if self._last_mouse is not None:
+            delta = event.position() - self._last_mouse
+            self._pan += delta
+            self._last_mouse = event.position()
+            self.update()
+        else:
+            # Show coordinates in status
+            world = self._to_world(event.pos())
+            self.setToolTip(f"X={world.x():.1f}  Y={world.y():.1f}")
+
+    def mouseReleaseEvent(self, event):
+        self._last_mouse = None
+        self.setCursor(Qt.ArrowCursor)
+
+    # ── Context menu ──────────────────────────────────────────────
+
+    def _show_context_menu(self, pos):
+        menu = QMenu(self)
+        menu.setStyleSheet(
+            f"QMenu {{ background-color: {C.panel}; color: {C.txt}; "
+            f"border: 1px solid {C.line}; }} "
+            f"QMenu::item:selected {{ background-color: {C.accent}; }}"
+        )
+        world = self._to_world(pos)
+        face = self._hit_test_face(world)
+
+        act_hole = menu.addAction("[+] Add Hole")
+        act_slot = menu.addAction("[+] Add Slot")
+
+        action = menu.exec(self.mapToGlobal(pos.toPoint()))
+        if action == act_hole:
+            self.add_hole_requested.emit(world.x(), world.y(), face)
+        elif action == act_slot:
+            self.add_hole_requested.emit(world.x(), world.y(), face)
+
+    def _hit_test_face(self, world: QPointF) -> str:
+        """Determine which face a world point belongs to."""
+        x, y = world.x(), world.y()
+        for face_key, pts in self._faces.items():
+            if len(pts) < 4:
+                continue
+            xs = [p[0] for p in pts]
+            ys = [p[1] for p in pts]
+            if min(xs) <= x <= max(xs) and min(ys) <= y <= max(ys):
+                return face_key
+        return 'v'
+
+    # ── Painting ──────────────────────────────────────────────────
+
+    def paintEvent(self, event):
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), self._bg_color)
+
+        if not self._faces:
+            p.end()
+            return
+
+        # Draw grid
+        self._draw_grid(p)
+
+        # Draw faces
+        self._draw_faces(p)
+
+        # Draw holes
+        self._draw_holes(p)
+
+        # Draw cotation
+        if self._show_cotation:
+            self._draw_tekla_cotations(p)
+
+        # Draw face labels
+        self._draw_face_labels(p)
+
+        p.end()
+
+    def _draw_grid(self, p: QPainter):
+        """Draw a subtle grid in world space."""
+        grid_pen = QPen(self._grid_color, 0.3)
+        p.setPen(grid_pen)
+        grid_spacing = 50  # mm
+        # Compute visible world bounds
+        tl = self._to_world(QPointF(0, 0))
+        br = self._to_world(QPointF(self.width(), self.height()))
+        x_start = int(tl.x() // grid_spacing) * grid_spacing
+        y_start = int(tl.y() // grid_spacing) * grid_spacing
+        x = x_start
+        while x <= br.x():
+            sp = self._to_screen(x, 0)
+            p.drawLine(int(sp.x()), 0, int(sp.x()), self.height())
+            x += grid_spacing
+        y = y_start
+        while y <= br.y():
+            sp = self._to_screen(0, y)
+            p.drawLine(0, int(sp.y()), self.width(), int(sp.y()))
+            y += grid_spacing
+
+    def _draw_faces(self, p: QPainter):
+        """Draw each face as a filled polygon with colored border."""
+        for face_key, pts in self._faces.items():
+            if len(pts) < 3:
+                continue
+            color = _FACE_COLORS.get(face_key, QColor(C.mut))
+            screen_pts = [self._to_screen(x, y) for x, y in pts]
+
+            # Fill
+            path = QPainterPath()
+            path.moveTo(screen_pts[0])
+            for sp in screen_pts[1:]:
+                path.lineTo(sp)
+            path.closeSubpath()
+
+            fill_color = QColor(color)
+            fill_color.setAlpha(30)
+            p.setBrush(QBrush(fill_color))
+            p.setPen(QPen(color, 1.5))
+            p.drawPath(path)
+
+            # Face boundary highlight
+            p.setPen(QPen(color, 0.8, Qt.DashLine))
+            p.setBrush(Qt.NoBrush)
+            p.drawPolygon(QPolygonF(screen_pts))
+
+    def _draw_holes(self, p: QPainter):
+        """Draw hole circles on the faces."""
+        hole_pen = QPen(QColor("#ef4444"), 1.5)
+        hole_brush = QBrush(QColor("#ef444440"))
+        p.setPen(hole_pen)
+        p.setBrush(hole_brush)
+        for h in self._holes:
+            cx, cy = h['x'], h['y']
+            d = h.get('d', 12.0)
+            sp = self._to_screen(cx, cy)
+            r = d / 2 * self._scale
+            p.drawEllipse(sp, r, r)
+            # Center crosshair
+            cross_len = r * 0.6
+            p.drawLine(sp.x() - cross_len, sp.y(),
+                       sp.x() + cross_len, sp.y())
+            p.drawLine(sp.x(), sp.y() - cross_len,
+                       sp.x(), sp.y() + cross_len)
+
+    def _draw_tekla_cotations(self, p: QPainter):
+        """Draw Tekla-style e (edge distance) and ga (gauge) dimensions.
+
+        e = distance from part edge to first hole
+        ga = distance between hole centers (gauge/trusquinage)
+        """
+        if not self._faces or not self._holes:
+            return
+
+        # Compute bounding box of all faces
+        all_pts = []
+        for pts in self._faces.values():
+            all_pts.extend(pts)
+        xs = [pt[0] for pt in all_pts]
+        ys = [pt[1] for pt in all_pts]
+        part_min_x, part_max_x = min(xs), max(xs)
+        part_min_y, part_max_y = min(ys), max(ys)
+
+        # Sort holes by X position for ga dimensioning
+        sorted_holes = sorted(self._holes, key=lambda h: h.get('x', 0))
+
+        # ── e dimension (edge distance: part edge → first hole) ──
+        if sorted_holes:
+            first_hole = sorted_holes[0]
+            hx = first_hole['x']
+            hy = first_hole['y']
+            d = first_hole.get('d', 12.0) / 2
+
+            # Horizontal e: from left edge to hole center
+            e_val = hx - part_min_x
+            if e_val > 0.5:
+                y_e = part_min_y - 15  # below part
+                self._draw_dim_line(p,
+                    (part_min_x, y_e), (hx, y_e),
+                    f"e={e_val:.0f}", self._dim_color)
+
+            # Vertical e: from bottom edge to hole center
+            e_val_v = hy - part_min_y
+            if e_val_v > 0.5:
+                x_e = part_min_x - 15  # left of part
+                self._draw_dim_line_vertical(p,
+                    (x_e, part_min_y), (x_e, hy),
+                    f"e={e_val_v:.0f}", self._dim_color)
+
+        # ── ga dimension (gauge: between holes) ──────────────────
+        if len(sorted_holes) >= 2:
+            for i in range(len(sorted_holes) - 1):
+                h1 = sorted_holes[i]
+                h2 = sorted_holes[i + 1]
+                ga = h2['x'] - h1['x']
+                if ga > 0.5:
+                    y_ga = part_min_y - 30  # further below
+                    self._draw_dim_line(p,
+                        (h1['x'], y_ga), (h2['x'], y_ga),
+                        f"ga={ga:.0f}", self._gauge_color)
+
+        # ── e from last hole to right edge ────────────────────────
+        if sorted_holes:
+            last_hole = sorted_holes[-1]
+            e_right = part_max_x - last_hole['x']
+            if e_right > 0.5:
+                y_e = part_min_y - 15
+                self._draw_dim_line(p,
+                    (last_hole['x'], y_e), (part_max_x, y_e),
+                    f"e={e_right:.0f}", self._dim_color)
+
+    def _draw_dim_line(self, p: QPainter,
+                       p1: Tuple[float, float], p2: Tuple[float, float],
+                       label: str, color: QColor):
+        """Draw a horizontal dimension line with arrows and text (Tekla style)."""
+        s1 = self._to_screen(*p1)
+        s2 = self._to_screen(*p2)
+
+        # Dimension line (broken at text)
+        line_pen = QPen(color, 1.0)
+        line_pen.setCosmetic(True)
+        p.setPen(line_pen)
+
+        mid_x = (s1.x() + s2.x()) / 2
+        mid_y = s1.y()
+
+        font = QFont("Segoe UI", max(8, int(9 * min(self._scale, 2.0))))
+        font.setBold(True)
+        metrics = QFontMetrics(font)
+        tw = metrics.horizontalAdvance(label)
+        text_gap = tw / 2 + 4
+
+        # Line before text
+        if mid_x - text_gap > s1.x() + 2:
+            p.drawLine(s1.x(), mid_y, mid_x - text_gap, mid_y)
+        # Line after text
+        if mid_x + text_gap < s2.x() - 2:
+            p.drawLine(mid_x + text_gap, mid_y, s2.x(), mid_y)
+
+        # Arrows
+        arrow_sz = 5
+        self._draw_arrow(p, s1.x(), mid_y, -1, 0, arrow_sz, color)
+        self._draw_arrow(p, s2.x(), mid_y, 1, 0, arrow_sz, color)
+
+        # Extension lines (vertical drops)
+        ext_pen = QPen(color, 0.5)
+        ext_pen.setStyle(Qt.DashLine)
+        ext_pen.setCosmetic(True)
+        p.setPen(ext_pen)
+        p.drawLine(s1.x(), mid_y, s1.x(), mid_y + 10)
+        p.drawLine(s2.x(), mid_y, s2.x(), mid_y + 10)
+
+        # Text with background
+        bg = QColor("#0b1121")
+        text_rect = QRectF(mid_x - tw / 2 - 3, mid_y - metrics.height() / 2 - 2,
+                           tw + 6, metrics.height() + 4)
+        p.fillRect(text_rect, bg)
+        p.setPen(QPen(color, 1.0))
+        p.setFont(font)
+        p.drawText(QPointF(mid_x - tw / 2, mid_y + metrics.height() / 3), label)
+
+    def _draw_dim_line_vertical(self, p: QPainter,
+                                p1: Tuple[float, float], p2: Tuple[float, float],
+                                label: str, color: QColor):
+        """Draw a vertical dimension line with arrows and text."""
+        s1 = self._to_screen(*p1)
+        s2 = self._to_screen(*p2)
+
+        line_pen = QPen(color, 1.0)
+        line_pen.setCosmetic(True)
+        p.setPen(line_pen)
+
+        mid_x = s1.x()
+        mid_y = (s1.y() + s2.y()) / 2
+
+        font = QFont("Segoe UI", max(8, int(9 * min(self._scale, 2.0))))
+        font.setBold(True)
+        metrics = QFontMetrics(font)
+        tw = metrics.horizontalAdvance(label)
+        text_gap = tw / 2 + 4
+
+        # Line before text
+        if mid_y - text_gap > s2.y() + 2:
+            p.drawLine(mid_x, s2.y(), mid_x, mid_y - text_gap)
+        # Line after text
+        if mid_y + text_gap < s1.y() - 2:
+            p.drawLine(mid_x, mid_y + text_gap, mid_x, s1.y())
+
+        # Arrows
+        arrow_sz = 5
+        self._draw_arrow(p, mid_x, s1.y(), 0, 1, arrow_sz, color)
+        self._draw_arrow(p, mid_x, s2.y(), 0, -1, arrow_sz, color)
+
+        # Extension lines (horizontal drops)
+        ext_pen = QPen(color, 0.5)
+        ext_pen.setStyle(Qt.DashLine)
+        ext_pen.setCosmetic(True)
+        p.setPen(ext_pen)
+        p.drawLine(mid_x, s1.y(), mid_x - 10, s1.y())
+        p.drawLine(mid_x, s2.y(), mid_x - 10, s2.y())
+
+        # Rotated text
+        p.save()
+        p.translate(QPointF(mid_x, mid_y))
+        p.rotate(-90)
+        bg = QColor("#0b1121")
+        text_rect = QRectF(-tw / 2 - 3, -metrics.height() / 2 - 2,
+                           tw + 6, metrics.height() + 4)
+        p.fillRect(text_rect, bg)
+        p.setPen(QPen(color, 1.0))
+        p.setFont(font)
+        p.drawText(QPointF(-tw / 2, metrics.height() / 3), label)
+        p.restore()
+
+    def _draw_arrow(self, p: QPainter,
+                    tip_x: float, tip_y: float,
+                    dir_x: float, dir_y: float,
+                    size: float, color: QColor):
+        """Draw a filled triangle arrow."""
+        length = math.hypot(dir_x, dir_y)
+        if length < 1e-9:
+            return
+        ux, uy = dir_x / length, dir_y / length
+        px, py = -uy, ux
+        p.setBrush(QBrush(color))
+        p.setPen(Qt.NoPen)
+        p.drawPolygon(QPolygonF([
+            QPointF(tip_x, tip_y),
+            QPointF(tip_x - ux * size + px * size * 0.35,
+                    tip_y - uy * size + py * size * 0.35),
+            QPointF(tip_x - ux * size - px * size * 0.35,
+                    tip_y - uy * size - py * size * 0.35),
+        ]))
+
+    def _draw_face_labels(self, p: QPainter):
+        """Draw face key labels (.v, .o, .u, .h) at the center of each face."""
+        font = QFont("Segoe UI", max(8, int(10 * min(self._scale, 2.0))))
+        font.setBold(True)
+        p.setFont(font)
+
+        for face_key, pts in self._faces.items():
+            if len(pts) < 3:
+                continue
+            # Center of face
+            cx = sum(pt[0] for pt in pts) / len(pts)
+            cy = sum(pt[1] for pt in pts) / len(pts)
+            sp = self._to_screen(cx, cy)
+            color = _FACE_COLORS.get(face_key, QColor(C.mut))
+            label = _FACE_LABELS.get(face_key, face_key)
+
+            # Background
+            metrics = QFontMetrics(font)
+            tw = metrics.horizontalAdvance(label)
+            th = metrics.height()
+            bg = QColor("#0b1121")
+            bg.setAlpha(180)
+            p.fillRect(QRectF(sp.x() - tw / 2 - 3, sp.y() - th / 2 - 2,
+                              tw + 6, th + 4), bg)
+            p.setPen(QPen(color, 1.0))
+            p.drawText(QPointF(sp.x() - tw / 2, sp.y() + th / 3), label)
diff --git a/src/nccorrection/ui/components/modern_button.py b/src/nccorrection/ui/components/modern_button.py
new file mode 100644
index 0000000..58a0859
--- /dev/null
+++ b/src/nccorrection/ui/components/modern_button.py
@@ -0,0 +1,237 @@
+"""Modern animated push buttons for the presentation layer.
+
+``AnimatedButton`` is a ``QPushButton`` subclass that paints itself from the
+active theme palette and animates smooth color transitions on hover (0 -> 1)
+and press (0 -> 1) using ``QVariantAnimation``.
+
+Theming: colors come ONLY from the theme dict passed in (the same palette
+produced by ``styles.apply_theme``), so the button works flawlessly in light
+and dark modes and with user-customized themes. The few literals used are
+semantic fallbacks for keys the palette never defines (e.g. white text on a
+colored fill).
+
+Variants (mapped to the existing palette, web-framework style):
+    default  -> card/panel background, line border, txt text
+    primary  -> (SPRINT 1) renders as ghost — monochrome, no colored fill
+    success  -> (SPRINT 1) renders as ghost — monochrome, no colored fill
+    danger   -> (SPRINT 1) renders as ghost — monochrome, no colored fill
+    warning  -> (SPRINT 1) renders as ghost — monochrome, no colored fill
+    ghost    -> transparent background, txt text, accent border on hover
+
+SPRINT 1 (CTO 2026-09-02) INDUSTRIAL MONOCHROME: ALL variants render as ghost
+buttons. The colored primary/success/danger/warning fills were removed so no
+button ever paints a colored background. Steel Blue (#007acc, theme 'accent')
+is used EXCLUSIVELY for the Active/Checked/selected state.
+
+Scaling: all paddings, radii, minimum heights and fonts go through
+``scaling.sp`` / ``scaling.font_pt`` so buttons stay crisp on high-DPI
+displays. When the app's global QSS is still applied to other buttons, this
+class ignores the QSS background/border by painting itself and never calling
+``super().paintEvent`` — QSS rules remain a fallback for non-animated buttons.
+"""
+from __future__ import annotations
+
+from PySide6.QtCore import Qt, QPointF, QRectF, QVariantAnimation, QEasingCurve
+from PySide6.QtGui import QColor, QPainter, QPainterPath, QFont, QBrush, QPen
+from PySide6.QtWidgets import QPushButton
+
+from nccorrection.ui._colors import C
+from nccorrection.ui.components.scaling import sp, font_pt
+
+_VARIANTS = ('default', 'primary', 'success', 'danger', 'warning', 'ghost')
+
+_WHITE = QColor(C.txt)
+_BLACK = QColor('#000000')
+
+_HOVER_MS = 130
+_PRESS_MS = 110
+
+
+def _mix(a, b, t):
+    """Blend two QColors by t in [0, 1]."""
+    if t <= 0.0:
+        return QColor(a)
+    if t >= 1.0:
+        return QColor(b)
+    return QColor(
+        int(a.red() + (b.red() - a.red()) * t),
+        int(a.green() + (b.green() - a.green()) * t),
+        int(a.blue() + (b.blue() - a.blue()) * t),
+        int(a.alpha() + (b.alpha() - a.alpha()) * t),
+    )
+
+
+def _hx(theme, key, fallback):
+    return QColor(theme.get(key, fallback) or fallback)
+
+
+class AnimatedButton(QPushButton):
+    """A QPushButton with animated hover/press colors from the theme palette."""
+
+    def __init__(self, text='', variant='default', theme=None, parent=None,
+                 height=None):
+        super().__init__(text, parent)
+        if variant not in _VARIANTS:
+            variant = 'default'
+        self._variant = variant
+        self._theme = dict(theme) if theme else {}
+        self._hover = 0.0
+        self._pressed = 0.0
+
+        self.setCursor(Qt.PointingHandCursor)
+        self.setMinimumHeight(height if height is not None else sp(30))
+        self.setMinimumWidth(sp(48))
+        self.setFocusPolicy(Qt.StrongFocus)
+
+        self._hover_anim = QVariantAnimation(self)
+        self._hover_anim.setDuration(_HOVER_MS)
+        self._hover_anim.setEasingCurve(QEasingCurve.OutCubic)
+        self._hover_anim.valueChanged.connect(self._set_hover)
+
+        self._press_anim = QVariantAnimation(self)
+        self._press_anim.setDuration(_PRESS_MS)
+        self._press_anim.setEasingCurve(QEasingCurve.OutCubic)
+        self._press_anim.valueChanged.connect(self._set_pressed)
+
+    # ---------------------------------------------------------------- theme
+    def set_theme(self, theme):
+        self._theme = dict(theme) if theme else {}
+        self.update()
+
+    def variant(self):
+        return self._variant
+
+    def set_variant(self, variant):
+        if variant not in _VARIANTS:
+            variant = 'default'
+        self._variant = variant
+        self.update()
+
+    # ------------------------------------------------------------ animation
+    def _set_hover(self, value):
+        self._hover = float(value)
+        self.update()
+
+    def _set_pressed(self, value):
+        self._pressed = float(value)
+        self.update()
+
+    def enterEvent(self, event):
+        self._hover_anim.stop()
+        self._hover_anim.setStartValue(self._hover)
+        self._hover_anim.setEndValue(1.0)
+        self._hover_anim.start()
+        super().enterEvent(event)
+
+    def leaveEvent(self, event):
+        self._hover_anim.stop()
+        self._hover_anim.setStartValue(self._hover)
+        self._hover_anim.setEndValue(0.0)
+        self._hover_anim.start()
+        super().leaveEvent(event)
+
+    def mousePressEvent(self, event):
+        if event.button() == Qt.LeftButton and not self.isEnabled():
+            return super().mousePressEvent(event)
+        self._press_anim.stop()
+        self._press_anim.setStartValue(self._pressed)
+        self._press_anim.setEndValue(1.0)
+        self._press_anim.start()
+        super().mousePressEvent(event)
+
+    def mouseReleaseEvent(self, event):
+        self._press_anim.stop()
+        self._press_anim.setStartValue(self._pressed)
+        self._press_anim.setEndValue(0.0)
+        self._press_anim.start()
+        super().mouseReleaseEvent(event)
+
+    def changeEvent(self, event):
+        super().changeEvent(event)
+        if event.type() == event.Type.EnabledChange:
+            self.update()
+
+    # ------------------------------------------------------------- palette
+    def _base(self):
+        # SPRINT 1 (CTO 2026-09-02): STRICT INDUSTRIAL MONOCHROME.
+        # Every variant is a Ghost button now — transparent background with
+        # silver text. Steel Blue (#007acc) is reserved EXCLUSIVELY for the
+        # Active/Checked/selected state (see paintEvent). The old colored
+        # primary/success/danger/warning fills are intentionally gone so no
+        # colored background is ever painted on a button.
+        t = self._theme
+        return QColor(0, 0, 0, 0), _hx(t, 'txt', '#cccccc')
+
+    def _hover_color(self):
+        # Gray hover: #333333 on the ghost background (monochrome directive).
+        return _hx(self._theme, 'panel2', '#333333')
+
+    def _press_color(self):
+        # Pressed state: darker gray fill (monochrome), no colored flash.
+        return _hx(self._theme, 'line', '#3a3a3a')
+
+    # ---------------------------------------------------------------- paint
+    def paintEvent(self, event):
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing, True)
+        rect = QRectF(self.rect())
+        r = sp(2)  # SPRINT 1 (CTO 2026-09-02): <=2px industrial monochrome corners
+        path = QPainterPath()
+        path.addRoundedRect(rect.adjusted(0.5, 0.5, -0.5, -0.5), r, r)
+
+        if self.isEnabled():
+            base, text_color = self._base()
+            bg = _mix(base, self._hover_color(), self._hover)
+            if self._pressed > 0.0:
+                bg = _mix(bg, self._press_color(), self._pressed)
+            if self.isCheckable() and self.isChecked():
+                # Active/Checked state: SOLID steel blue (#007acc) + white text.
+                # Monochrome rule — steel blue is the ONLY color a button shows.
+                bg = _hx(self._theme, 'accent', C.accent)
+                text_color = _WHITE
+                self._hover = self._pressed = 0.0
+        else:
+            bg = _hx(self._theme, 'panel', '#141c2c')
+            text_color = _hx(self._theme, 'mut', '#8ea3c0')
+            self._hover = self._pressed = 0.0
+
+        p.fillPath(path, bg)
+
+        # border: line, accent on hover/focus; steel blue when checked
+        checked = self.isCheckable() and self.isChecked() and self.isEnabled()
+        if checked:
+            p.setPen(QPen(_hx(self._theme, 'accent', C.accent), 1.0))
+            p.drawPath(path)
+        else:
+            border = _hx(self._theme, 'line', '#2c3a52')
+            if self.isEnabled():
+                accent = _hx(self._theme, 'accent', C.accent)
+                if self.hasFocus() or self._hover > 0.0:
+                    border = _mix(border, accent, min(1.0, self._hover + (0.6 if self.hasFocus() else 0.0)))
+            p.setPen(border)
+            p.drawPath(path)
+
+        # icon + label
+        icon = self.icon()
+        text_rect = rect.adjusted(sp(8), 0, -sp(8), 0)
+        if not icon.isNull():
+            pm = icon.pixmap(sp(16), sp(16))
+            iw = pm.width() / max(1.0, pm.devicePixelRatio())
+            icon_rect = QRectF(rect.left() + sp(8),
+                               rect.center().y() - sp(8), iw, sp(16))
+            p.drawPixmap(icon_rect, pm, QRectF(pm.rect()))
+            text_rect.setLeft(icon_rect.right() + sp(6))
+
+        f = QFont(self.font())
+        f.setPointSize(font_pt(10))
+        p.setFont(f)
+        flags = int(Qt.AlignCenter)
+        p.setPen(text_color)
+        p.drawText(text_rect, flags, self.text())
+
+        if self.isCheckable() and self.isChecked() and self.isEnabled():
+            p.setPen(Qt.NoPen)
+            p.setBrush(QBrush(_hx(self._theme, 'txt', '#e8edf6')))
+            p.drawEllipse(QPointF(rect.right() - sp(9), rect.center().y()),
+                          sp(3), sp(3))
+        p.end()
