+"""Tests for builders/closure_builder.py."""
+import unittest
+from nccorrection.engine.contour.builders.closure_builder import ClosureBuilder
+from nccorrection.engine.contour.models.contour_point import ContourPoint
+from nccorrection.engine.contour.core.enums import Face
+
+
+class TestClosureBuilder(unittest.TestCase):
+    def test_closes_contour(self):
+        points = [
+            ContourPoint(x=0, y=0, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+            ContourPoint(x=100, y=50, face=Face.V),
+            ContourPoint(x=0, y=50, face=Face.V),
+        ]
+        cb = ClosureBuilder(Face.V, points)
+        contour = cb.build()
+        self.assertTrue(contour.is_closed)
+        self.assertEqual(contour.point_count, 5)
+
+    def test_first_equals_last(self):
+        points = [
+            ContourPoint(x=0, y=0, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+            ContourPoint(x=100, y=50, face=Face.V),
+            ContourPoint(x=0, y=50, face=Face.V),
+        ]
+        cb = ClosureBuilder(Face.V, points)
+        contour = cb.build()
+        self.assertAlmostEqual(contour.points[0].x, contour.points[-1].x)
+        self.assertAlmostEqual(contour.points[0].y, contour.points[-1].y)
+
+    def test_face_preserved(self):
+        points = [
+            ContourPoint(x=0, y=0, face=Face.O),
+            ContourPoint(x=100, y=0, face=Face.O),
+            ContourPoint(x=100, y=50, face=Face.O),
+            ContourPoint(x=0, y=50, face=Face.O),
+        ]
+        cb = ClosureBuilder(Face.O, points)
+        contour = cb.build()
+        self.assertEqual(contour.face, Face.O)
