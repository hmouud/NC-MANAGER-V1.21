+"""Deep analysis V3 — correct column parsing for NC1 AK format."""
+import os, re, math
+
+base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+root = os.path.join(base_dir, 'src', 'nccorrection', 'engine', 'profile_catalog', 'templates')
+
+def parse_nc1_v3(filepath):
+    with open(filepath, encoding='utf-8') as f:
+        lines = f.read().split('\n')
+    
+    result = {
+        'file': os.path.basename(filepath),
+        'header': {},
+        'dims': [],
+        'faces': {},
+        'bo_lines': [],
+        'ka_lines': [],
+        'ik_blocks': [],
+    }
+    
+    if len(lines) > 9:
+        result['header'] = {
+            'profile': lines[8].strip(),
+            'kind': lines[9].strip(),
+            'steel': lines[6].strip(),
+        }
+    
+    for i in range(10, min(22, len(lines))):
+        try:
+            result['dims'].append(float(lines[i].strip()))
+        except:
+            pass
+    
+    current_block = None
+    current_face = None
+    current_points = []
+    
+    def flush_face():
+        nonlocal current_face, current_points
+        if current_face and current_points:
+            result['faces'].setdefault(current_face, []).append(current_points)
+        current_points = []
+    
+    def parse_num_with_suffix(raw):
+        """Parse a number that may have a suffix letter (e.g. '262.00w' → 262.00, 'w')."""
+        suffix = ''
+        for ch in raw:
+            if ch.isalpha():
+                suffix = ch
+                break
+        val = float(re.sub(r'[a-zA-Z]', '', raw))
+        return val, suffix
+    
+    for raw in lines:
+        l = raw.strip()
+        
+        if l in ('AK', 'BO', 'KA', 'IK'):
+            if current_block == 'AK':
+                flush_face()
+            current_block = l
+            current_face = None
+            current_points = []
+            continue
+        
+        if l in ('EN', 'SI', 'PU', 'KO', 'SC', 'TO', 'UE', 'PR', 'IN', ''):
+            if current_block == 'AK':
+                flush_face()
+            current_block = None
+            current_face = None
+            current_points = []
+            continue
+        
+        parts = l.split()
+        
+        if current_block == 'AK' and len(parts) >= 2:
+            # Determine if this line starts with a face character
+            first_col = parts[0]
+            has_face = first_col in ('v', 'o', 'u', 'h')
+            
+            suffix = ''
+            if has_face:
+                # Start of a new face
+                flush_face()
+                current_face = first_col
+                # x is parts[1], y is parts[2], cols are parts[3..7]
+                x, sx = parse_num_with_suffix(parts[1])
+                y_val, sy = parse_num_with_suffix(parts[2])
+                suffix = sx or sy  # suffix can be on X or Y
+                # 8-column format: face + x + y + 5 data cols = 8 total
+                col3 = float(parts[3]) if len(parts) > 3 else 0
+                col4 = float(parts[4]) if len(parts) > 4 else 0
+                col5 = float(parts[5]) if len(parts) > 5 else 0
+                col6 = float(parts[6]) if len(parts) > 6 else 0
+                col7 = float(parts[7]) if len(parts) > 7 else 0
+            else:
+                # Continuation: x is parts[0], y is parts[1], cols are parts[2..6]
+                x, sx = parse_num_with_suffix(parts[0])
+                y_val, sy = parse_num_with_suffix(parts[1])
+                suffix = sx or sy
+                col3 = float(parts[2]) if len(parts) > 2 else 0
+                col4 = float(parts[3]) if len(parts) > 3 else 0
+                col5 = float(parts[4]) if len(parts) > 4 else 0
+                col6 = float(parts[5]) if len(parts) > 5 else 0
+                col7 = float(parts[6]) if len(parts) > 6 else 0
+            
+            current_points.append({
+                'x': x, 'y': y_val,
+                'suffix': suffix,
+                'bulge': col3, 'angle': col4, 'thickness': col5,
+                'col6': col6, 'col7': col7,
+            })
+        
+        elif current_block == 'BO':
+            result['bo_lines'].append(l)
+        
+        elif current_block == 'KA':
+            result['ka_lines'].append(l)
+        
+        elif current_block == 'IK':
+            result['ik_blocks'].append(l)
+    
+    if current_block == 'AK':
+        flush_face()
+    
+    return result
+
+
+# ========== DETAILED ANALYSIS ==========
+print("=" * 100)
+print("DETAILED NC1 TEMPLATE ANALYSIS V2 — ALL 37 FILES")
+print("=" * 100)
+
+all_data = []
+for fname in sorted(os.listdir(root)):
+    if not fname.endswith('.nc1'):
+        continue
+    fp = os.path.join(root, fname)
+    data = parse_nc1_v3(fp)
+    all_data.append(data)
+
+# Print ALL files
+for data in all_data:
+    fname = data['file']
+    h = data['header']
+    dims = data['dims']
+    
+    print(f"\n{'-'*100}")
+    print(f"FILE: {fname} — {h['profile']} ({h['kind']}) — Steel: {h['steel']}")
+    print(f"  Dims: {dims}")
+    
+    has_angles = False
+    if len(dims) > 11:
+        angles = dims[8:12]
+        if any(a != 0.0 for a in angles):
+            print(f"  CUT ANGLES: steg_front={angles[0]}, steg_rear={angles[1]}, flange_front={angles[2]}, flange_rear={angles[3]}")
+            has_angles = True
+    
+    for face_name, segments in data['faces'].items():
+        for seg_idx, segment in enumerate(segments):
+            print(f"  Face '{face_name}' seg {seg_idx}: {len(segment)} points")
+            for i, p in enumerate(segment):
+                suffix_mark = f" [{p['suffix']}]" if p['suffix'] else ""
+                extras = []
+                if p['bulge'] != 0: extras.append(f"bulge={p['bulge']}")
+                if p['angle'] != 0: extras.append(f"angle={p['angle']}")
+                if p['thickness'] != 0: extras.append(f"thick={p['thickness']}")
+                if p['col6'] != 0: extras.append(f"col6={p['col6']}")
+                if p['col7'] != 0: extras.append(f"col7={p['col7']}")
+                extra_str = "  " + "  ".join(extras) if extras else ""
+                print(f"    P{i}: ({p['x']:10.2f}, {p['y']:8.2f}){suffix_mark}{extra_str}")
+    
+    if data['bo_lines']:
+        print(f"  BO ({len(data['bo_lines'])} holes):")
+        for bo in data['bo_lines']:
+            print(f"    {bo}")
+    
+    if data['ka_lines']:
+        print(f"  KA ({len(data['ka_lines'])} bends):")
+        for ka in data['ka_lines']:
+            print(f"    {ka}")
+    
+    if data['ik_blocks']:
+        print(f"  IK ({len(data['ik_blocks'])} lines):")
+        for ik in data['ik_blocks']:
+            print(f"    {ik}")
+
+
+# ========== SUMMARY ==========
+print(f"\n{'='*100}")
+print("SUMMARY STATISTICS")
+print(f"{'='*100}")
+
+suffix_counts = {}
+total_points = 0
+multi_seg_files = []
+files_with_angles = []
+files_with_w_suffix = []
+files_with_bo = []
+files_with_ka = []
+files_with_ik = []
+face_counts = {'v': 0, 'o': 0, 'u': 0, 'h': 0}
+
+for data in all_data:
+    dims = data['dims']
+    has_angles = False
+    if len(dims) > 11 and any(a != 0 for a in dims[8:12]):
+        has_angles = True
+        files_with_angles.append(data['file'])
+    
+    for face_name, segments in data['faces'].items():
+        face_counts[face_name] = face_counts.get(face_name, 0) + 1
+        for seg_idx, seg in enumerate(segments):
+            total_points += len(seg)
+            if len(segments) > 1 and seg_idx == len(segments) - 1:
+                multi_seg_files.append(data['file'])
+            for p in seg:
+                s = p['suffix'] or 'none'
+                suffix_counts[s] = suffix_counts.get(s, 0) + 1
+                if p['suffix'] == 'w':
+                    files_with_w_suffix.append(data['file'])
+    
+    if data['bo_lines']:
+        files_with_bo.append(data['file'])
+    if data['ka_lines']:
+        files_with_ka.append(data['file'])
+    if data['ik_blocks']:
+        files_with_ik.append(data['file'])
+
+print(f"\nTotal files: {len(all_data)}")
+print(f"Total AK points: {total_points}")
+print(f"\nFace distribution: {face_counts}")
+print(f"Suffix distribution: {suffix_counts}")
+print(f"\nFiles with cut angles: {len(files_with_angles)} -> {files_with_angles}")
+print(f"Files with 'w' suffix: {len(files_with_w_suffix)} -> {sorted(set(files_with_w_suffix))}")
+print(f"Files with BO holes: {len(files_with_bo)} -> {files_with_bo}")
+print(f"Files with KA bends: {len(files_with_ka)} -> {files_with_ka}")
+print(f"Files with IK blocks: {len(files_with_ik)} -> {files_with_ik}")
+print(f"Files with multi-segment faces: {len(multi_seg_files)} -> {multi_seg_files}")
+
+# Cut angle math verification
+print(f"\n{'='*100}")
+print("CUT ANGLE MATH VERIFICATION")
+print(f"{'='*100}")
+
+for data in all_data:
+    dims = data['dims']
+    if len(dims) < 12:
+        continue
+    angles = dims[8:12]
+    if all(a == 0 for a in angles):
+        continue
+    
+    h = data['header']
+    H, b, tf, tw = dims[1], dims[2], dims[3], dims[4]
+    
+    print(f"\n{data['file']} — {h['profile']}: H={H}, b={b}, tf={tf}, tw={tw}")
+    print(f"  Dims[8:12] = {angles}")
+    
+    for i, angle in enumerate(angles):
+        if angle == 0:
+            continue
+        rad = math.radians(angle)
+        web_offset = H * math.tan(rad)
+        flange_offset = (H/2 - tf) * math.tan(rad)
+        label = ['steg_front', 'steg_rear', 'flange_front', 'flange_rear'][i]
+        print(f"  {label} = {angle} deg:")
+        print(f"    tan = {math.tan(rad):.6f}")
+        print(f"    web_offset (H * tan) = {H} * {math.tan(rad):.6f} = {web_offset:.2f}")
+        print(f"    flange_offset ((H/2-tf) * tan) = {H/2-tf} * {math.tan(rad):.6f} = {flange_offset:.2f}")
+    
+    # Verify: show the actual contour X offsets from the data
+    for face_name, segments in data['faces'].items():
+        for seg in segments:
+            xs = [p['x'] for p in seg]
+            non_zero_xs = sorted(set(x for x in xs if x > 0))
+            print(f"  Face '{face_name}' X values: {non_zero_xs}")
