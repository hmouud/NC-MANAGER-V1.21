@@ -0,0 +1,94 @@
+"""Cotation engine — data model for dimension sets.
+
+Pure data: no Qt dependency, no rendering logic.
+A DimensionSet = a chain of measurements along a reference direction line.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+
+@dataclass
+class DimensionStyle:
+    """Visual style for dimension rendering (all values in mm)."""
+    text_height: float = 3.5
+    arrow_size: float = 2.5
+    precision: int = 0              # decimal places
+    extension_gap: float = 1.5      # gap between part and extension line start
+    line_offset: float = 0.3        # dimension line thickness
+    color: str = "#f8fafc"          # default text/line color
+    extension_color: str = "#94a3b8"  # extension line color
+
+
+@dataclass
+class DimensionPoint:
+    """A single measurement point projected onto a direction line."""
+    world: Tuple[float, float]      # original world position
+    projected: float = 0.0          # distance along direction line from origin
+    label: str = ""                 # optional override label (empty = auto)
+
+
+@dataclass
+class DimensionSet:
+    """A chain of measurements along a reference direction.
+
+    The reference line (ref_p1 → ref_p2) defines the measurement axis.
+    Points are projected onto this axis and measured from ref_p1.
+    """
+    ref_p1: Tuple[float, float] = (0.0, 0.0)
+    ref_p2: Tuple[float, float] = (1.0, 0.0)
+    points: List[DimensionPoint] = field(default_factory=list)
+    offset: float = 30.0           # distance of dimension line from part (mm)
+    kind: str = "horizontal"       # horizontal | vertical | orthogonal
+    style: DimensionStyle = field(default_factory=DimensionStyle)
+
+    @property
+    def direction(self) -> Tuple[float, float]:
+        """Unit vector along the reference line."""
+        dx = self.ref_p2[0] - self.ref_p1[0]
+        dy = self.ref_p2[1] - self.ref_p1[1]
+        length = math.hypot(dx, dy)
+        if length < 1e-12:
+            return (1.0, 0.0)
+        return (dx / length, dy / length)
+
+    @property
+    def normal(self) -> Tuple[float, float]:
+        """Unit vector perpendicular to the reference line (left-hand side)."""
+        dx, dy = self.direction
+        return (-dy, dx)
+
+    @property
+    def dimension_line_p1(self) -> Tuple[float, float]:
+        """Start of the dimension line (offset from ref_p1)."""
+        nx, ny = self.normal
+        return (self.ref_p1[0] + nx * self.offset,
+                self.ref_p1[1] + ny * self.offset)
+
+    @property
+    def dimension_line_p2(self) -> Tuple[float, float]:
+        """End of the dimension line (offset from last projected point)."""
+        if not self.points:
+            return self.dimension_line_p1
+        nx, ny = self.normal
+        dx, dy = self.direction
+        last_proj = max(p.projected for p in self.points)
+        return (self.ref_p1[0] + dx * last_proj + nx * self.offset,
+                self.ref_p1[1] + dy * last_proj + ny * self.offset)
+
+    def segment_values(self) -> List[float]:
+        """Return distances between consecutive projected points."""
+        if len(self.points) < 2:
+            return []
+        sorted_pts = sorted(self.points, key=lambda p: p.projected)
+        return [sorted_pts[i + 1].projected - sorted_pts[i].projected
+                for i in range(len(sorted_pts) - 1)]
+
+    def total_value(self) -> float:
+        """Total distance from first to last projected point."""
+        if len(self.points) < 2:
+            return 0.0
+        projected = [p.projected for p in self.points]
+        return max(projected) - min(projected)
