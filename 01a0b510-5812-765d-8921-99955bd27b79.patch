+        w.mousePressEvent(_press(*w._to_screen(3300.0, 325.0)))
+        self.assertEqual(len(w._measurements), 1)
+        w.clear_measurements()
+        self.assertEqual(w._measurements, [])
+        self.assertIsNone(w._m1)
+
+    def test_blueprint_line_drag_parallel(self):
+        fb = DstvRenderer2D()
+        fb.resize(900, 640)
+        part = DstvParser().parse_text(LONG_BEAM)
+        fb.set_part(part)
+        fb.set_mode('measure')
