+"""Color tokens for NC Manager — single source of truth for UI colors.
+
+This module provides named constants that map to the theme dict in
+``styles.py``.  All UI code should use these tokens instead of
+hardcoded hex strings.
+
+Usage::
+
+    from nccorrection.ui._colors import C
+
+    # In stylesheet / paint code:
+    QColor(C.bg)        # '#0f172a'
+    QColor(C.panel)     # '#1e293b'
+
+    # Access the full active theme dict:
+    C.theme['accent']   # '#007acc'
+
+The active theme is set once at startup via ``C.set_theme(name)``.
+All token reads reflect the current theme automatically.
+"""
+from __future__ import annotations
+
+from nccorrection.ui.styles import THEMES
+
+
+class _ColorTokens:
+    """Dynamic color tokens backed by the active theme dict."""
+
+    def __init__(self):
+        self._theme: dict = dict(THEMES.get('industrial-dark', {}))
+
+    # ── Theme switching ────────────────────────────────────────────
+
+    def set_theme(self, name: str):
+        """Switch active theme by name (e.g. 'industrial-dark')."""
+        self._theme = dict(THEMES.get(name, THEMES.get('industrial-dark', {})))
+
+    @property
+    def theme(self) -> dict:
+        """Full active theme dict (read-only view)."""
+        return dict(self._theme)
+
+    # ── Core palette ───────────────────────────────────────────────
+
+    @property
+    def bg(self) -> str:
+        """Main background (#0f172a)."""
+        return self._theme.get('bg', '#0f172a')
+
+    @property
+    def panel(self) -> str:
+        """Panel / sidebar background (#1e293b)."""
+        return self._theme.get('panel', '#1e293b')
+
+    @property
+    def panel2(self) -> str:
+        """Secondary panel background (#263449)."""
+        return self._theme.get('panel2', '#263449')
+
+    @property
+    def card(self) -> str:
+        """Card background (#2f4059)."""
+        return self._theme.get('card', '#2f4059')
+
+    @property
+    def line(self) -> str:
+        """Border / separator color (#3b4a63)."""
+        return self._theme.get('line', '#3b4a63')
+
+    @property
+    def txt(self) -> str:
+        """Primary text (#e2e8f0)."""
+        return self._theme.get('txt', '#e2e8f0')
+
+    @property
+    def mut(self) -> str:
+        """Muted / secondary text (#94a3b8)."""
+        return self._theme.get('mut', '#94a3b8')
+
+    # ── Accent colors ──────────────────────────────────────────────
+
+    @property
+    def blue(self) -> str:
+        """Primary accent / blue (#007acc)."""
+        return self._theme.get('blue', '#007acc')
+
+    @property
+    def green(self) -> str:
+        """Success / green accent (#10b981)."""
+        return self._theme.get('green', '#10b981')
+
+    @property
+    def red(self) -> str:
+        """Error / red accent (#ef4444)."""
+        return self._theme.get('red', '#ef4444')
+
+    @property
+    def yel(self) -> str:
+        """Warning / yellow accent (#f59e0b)."""
+        return self._theme.get('yel', '#f59e0b')
+
+    @property
+    def vio(self) -> str:
+        """Purple / violet accent (#a855f7)."""
+        return self._theme.get('vio', '#a855f7')
+
+    @property
+    def accent(self) -> str:
+        """Primary accent (same as blue in most themes)."""
+        return self._theme.get('accent', '#007acc')
+
+    # ── Toolbar / bar colors ───────────────────────────────────────
+
+    @property
+    def barA(self) -> str:
+        """Toolbar background A (#0f172a)."""
+        return self._theme.get('barA', '#0f172a')
+
+    @property
+    def barB(self) -> str:
+        """Toolbar background B (#1d3a5f)."""
+        return self._theme.get('barB', '#1d3a5f')
+
+    @property
+    def contrast(self) -> float:
+        """Contrast multiplier (1.0 = default)."""
+        return self._theme.get('contrast', 1.0)
+
+    @property
+    def select(self) -> str:
+        """Selection highlight color (#0d3c66)."""
+        return self._theme.get('select', '#0d3c66')
+
+    # ── CAD viewer tokens (Linear Dark spec) ──────────────────────
+
+    @property
+    def canvas(self) -> str:
+        """CAD canvas background — Linear's #010102 (deepest black)."""
+        return self._theme.get('canvas', '#010102')
+
+    @property
+    def contour(self) -> str:
+        """AK contour line color (#38bdf8 sky-blue)."""
+        return self._theme.get('contour', '#38bdf8')
+
+    @property
+    def hole(self) -> str:
+        """BO hole color (#f87171 red)."""
+        return self._theme.get('hole', '#f87171')
+
+    @property
+    def slot(self) -> str:
+        """BO slot color (#fbbf24 amber)."""
+        return self._theme.get('slot', '#fbbf24')
+
+    @property
+    def bend(self) -> str:
+        """KA bend line color (#fbbf24 amber)."""
+        return self._theme.get('bend', '#fbbf24')
+
+    @property
+    def notch(self) -> str:
+        """Notch (w-suffix) point color (#c4b5fd violet)."""
+        return self._theme.get('notch', '#c4b5fd')
+
+    @property
+    def dim(self) -> str:
+        """Dimension annotation color (#94a3b8 muted)."""
+        return self._theme.get('dim', '#94a3b8')
+
+    @property
+    def grid_minor(self) -> str:
+        """Minor grid line color."""
+        return self._theme.get('grid_minor', '#1a1c20')
+
+    @property
+    def grid_major(self) -> str:
+        """Major grid line color."""
+        return self._theme.get('grid_major', '#23252a')
+
+
+# Module-level singleton — import and use directly.
+C = _ColorTokens()
