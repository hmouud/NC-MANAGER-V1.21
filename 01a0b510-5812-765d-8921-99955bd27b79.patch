+"""contour.py — Contour data class.
+
+🚨 GUARDIAN LAW: pure data + validation. No business logic.
+
+الـ Contour هو مجموعة من النقاط مرتبة (counter-clockwise للـ AK).
+"""
+from __future__ import annotations
+from dataclasses import dataclass, field
+from typing import List
+
+from ..core.enums import Face
+from .contour_point import ContourPoint
+
+
+@dataclass
+class Contour:
+    """محيط كامل لوجه واحد (AK face)."""
+    face: Face
+    points: List[ContourPoint] = field(default_factory=list)
+    is_closed: bool = False
+
+    def add_point(self, point: ContourPoint) -> None:
+        """كايضيف نقطة للمحيط."""
+        self.points.append(point)
+
+    def add_points(self, points: List[ContourPoint]) -> None:
+        """كايضيف قائمة نقاط."""
+        self.points.extend(points)
+
+    def close(self) -> None:
+        """كايسد المحيط: كايضيف أول نقطة ف الآخر.
+
+        هادشي ضروري لـ DSTV (كل AK face خاصو يكون closed).
+        """
+        if self.points and not self.is_closed:
+            first = self.points[0]
+            self.points.append(ContourPoint(
+                x=first.x, y=first.y, face=first.face,
+                suffix=None,
+            ))
+            self.is_closed = True
+
+    @property
+    def point_count(self) -> int:
+        return len(self.points)
+
+    @property
+    def notches(self) -> List[ContourPoint]:
+        """كايرجع الـ notches من هاد المحيط."""
+        return [p for p in self.points if p.has_special_suffix]
+
+    def __len__(self) -> int:
+        return len(self.points)
+
+    def __iter__(self):
+        return iter(self.points)
