@@ -0,0 +1,131 @@
+"""Cotation engine — dimension chain management.
+
+Add/remove points to existing DimensionSets, link/unlink chains.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Optional, Tuple
+
+from .models import DimensionPoint, DimensionSet, DimensionStyle
+
+
+def add_point(
+    dim: DimensionSet,
+    point: Tuple[float, float],
+    *,
+    label: str = "",
+) -> DimensionSet:
+    """Add a measurement point to an existing DimensionSet.
+
+    Returns a new DimensionSet (immutable pattern).
+    """
+    dp = DimensionPoint(world=point, label=label)
+
+    # Project onto the reference line
+    dx = dim.ref_p2[0] - dim.ref_p1[0]
+    dy = dim.ref_p2[1] - dim.ref_p1[1]
+    length_sq = dx * dx + dy * dy
+    if length_sq > 1e-18:
+        t = ((point[0] - dim.ref_p1[0]) * dx +
+             (point[1] - dim.ref_p1[1]) * dy) / length_sq
+        dp.projected = t * math.sqrt(length_sq)
+
+    new_points = list(dim.points) + [dp]
+    return DimensionSet(
+        ref_p1=dim.ref_p1,
+        ref_p2=dim.ref_p2,
+        points=new_points,
+        offset=dim.offset,
+        kind=dim.kind,
+        style=dim.style,
+    )
+
+
+def remove_point(
+    dim: DimensionSet,
+    index: int,
+) -> DimensionSet:
+    """Remove a measurement point by index.
+
+    Returns a new DimensionSet. Raises IndexError if index is out of range.
+    """
+    if index < 0 or index >= len(dim.points):
+        raise IndexError(f"Point index {index} out of range (0..{len(dim.points) - 1})")
+
+    new_points = [p for i, p in enumerate(dim.points) if i != index]
+    return DimensionSet(
+        ref_p1=dim.ref_p1,
+        ref_p2=dim.ref_p2,
+        points=new_points,
+        offset=dim.offset,
+        kind=dim.kind,
+        style=dim.style,
+    )
+
+
+def remove_point_at(
+    dim: DimensionSet,
+    world: Tuple[float, float],
+    tolerance: float = 5.0,
+) -> DimensionSet:
+    """Remove the nearest point within *tolerance* mm of *world*.
+
+    Returns a new DimensionSet unchanged if no point is close enough.
+    """
+    best_idx = -1
+    best_dist = tolerance
+    for i, pt in enumerate(dim.points):
+        d = math.hypot(pt.world[0] - world[0], pt.world[1] - world[1])
+        if d < best_dist:
+            best_dist = d
+            best_idx = i
+
+    if best_idx < 0:
+        return dim
+
+    return remove_point(dim, best_idx)
+
+
+def link_chains(
+    dims: List[DimensionSet],
+) -> List[DimensionSet]:
+    """Link dimension chains that share the same reference line direction.
+
+    Returns the input list unchanged — linking is a visual grouping hint,
+    not a data mutation. This is a placeholder for future chain-link
+    rendering logic.
+    """
+    # Placeholder: in Phase 4+ this would merge collinear chains
+    return dims
+
+
+def unlink_chains(
+    dims: List[DimensionSet],
+) -> List[DimensionSet]:
+    """Unlink dimension chains.
+
+    Placeholder for future chain-ungroup logic.
+    """
+    return dims
+
+
+def find_nearest_point(
+    dim: DimensionSet,
+    world: Tuple[float, float],
+) -> Optional[Tuple[int, DimensionPoint]]:
+    """Find the nearest DimensionPoint to *world*.
+
+    Returns (index, DimensionPoint) or None if the set is empty.
+    """
+    best_idx = -1
+    best_dist = float("inf")
+    for i, pt in enumerate(dim.points):
+        d = math.hypot(pt.world[0] - world[0], pt.world[1] - world[1])
+        if d < best_dist:
+            best_dist = d
+            best_idx = i
+
+    if best_idx < 0:
+        return None
+    return (best_idx, dim.points[best_idx])
diff --git a/src/nccorrection/engine/cotation/linear.py b/src/nccorrection/engine/cotation/linear.py
new file mode 100644
index 0000000..f29f8f1
--- /dev/null
+++ b/src/nccorrection/engine/cotation/linear.py
@@ -0,0 +1,101 @@
+"""Cotation engine — linear dimension builders (Horizontal, Vertical, Orthogonal).
+
+Each builder takes measurement points and returns a DimensionSet with
+projected values ready for rendering.
+"""
+from __future__ import annotations
+
+from typing import List, Tuple
+
+from .models import DimensionPoint, DimensionSet, DimensionStyle
+
+
+def horizontal(
+    points: List[Tuple[float, float]],
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Create a horizontal dimension chain (X-axis measurement).
+
+    All points are projected onto the X-axis.
+    The dimension line is placed at *offset* mm above the points.
+    """
+    if len(points) < 2:
+        return DimensionSet(kind="horizontal", offset=offset,
+                            style=style or DimensionStyle())
+
+    ref_p1 = (min(p[0] for p in points), points[0][1])
+    ref_p2 = (max(p[0] for p in points), points[0][1])
+
+    dim_points = [
+        DimensionPoint(world=p, projected=p[0] - ref_p1[0])
+        for p in points
+    ]
+
+    return DimensionSet(
+        ref_p1=ref_p1,
+        ref_p2=ref_p2,
+        points=dim_points,
+        offset=offset,
+        kind="horizontal",
+        style=style or DimensionStyle(),
+    )
+
+
+def vertical(
+    points: List[Tuple[float, float]],
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Create a vertical dimension chain (Y-axis measurement).
+
+    All points are projected onto the Y-axis.
+    The dimension line is placed at *offset* mm to the left of the points.
+    """
+    if len(points) < 2:
+        return DimensionSet(kind="vertical", offset=offset,
+                            style=style or DimensionStyle())
+
+    ref_p1 = (points[0][0], min(p[1] for p in points))
+    ref_p2 = (points[0][0], max(p[1] for p in points))
+
+    dim_points = [
+        DimensionPoint(world=p, projected=p[1] - ref_p1[1])
+        for p in points
+    ]
+
+    return DimensionSet(
+        ref_p1=ref_p1,
+        ref_p2=ref_p2,
+        points=dim_points,
+        offset=offset,
+        kind="vertical",
+        style=style or DimensionStyle(),
+    )
+
+
+def orthogonal(
+    points: List[Tuple[float, float]],
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Create an orthogonal dimension — auto-detects Horizontal or Vertical.
+
+    Uses the axis with the largest span. If the spans are equal,
+    defaults to horizontal.
+    """
+    if len(points) < 2:
+        return DimensionSet(kind="horizontal", offset=offset,
+                            style=style or DimensionStyle())
+
+    xs = [p[0] for p in points]
+    ys = [p[1] for p in points]
+    dx = max(xs) - min(xs)
+    dy = max(ys) - min(ys)
+
+    if dy > dx:
+        return vertical(points, offset=offset, style=style)
+    return horizontal(points, offset=offset, style=style)
