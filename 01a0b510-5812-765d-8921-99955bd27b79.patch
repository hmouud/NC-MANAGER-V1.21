+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h, lt = p["width"], p["height"], p["leg_thick"]
+        lt = min(lt, w / 2, h)
+        outer = [
+            (0, 0), (w, 0), (w, h), (w - lt, h),
+            (w - lt, lt), (lt, lt), (lt, h), (0, h),
+        ]
+        return ShapeResult(outer=outer)
