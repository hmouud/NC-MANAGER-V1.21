+"""contour_builder.py — Main Contour Builder (Facade).
+
+🚨 GUARDIAN LAW: هاد الملف كايستعمل الـ Builders الفرعيين.
+ما كايحتويش على منطق هندسي (هادشي ف interpreters/detectors).
+ما كايحتويش على parsing (هادشي ف detectors).
+"""
+from __future__ import annotations
+from typing import Dict, List, Optional
+
+from ..core.enums import Face
+from ..core.constants import TOLERANCE_MM
+from ..models.cut_angles import CutAngles
+from ..models.profile_model import ProfileGeometryModel
+from ..models.contour import Contour
+from ..models.contour_point import ContourPoint
+from ..interpreters.cut_interpreter import CutInterpreter
+from ..detectors.notch_detector import NotchDetector
+from .face_builder import FaceBuilder
+from .segment_builder import SegmentBuilder
+from .closure_builder import ClosureBuilder
+
+
+class ContourBuilder:
+    """Builder الرئيسي: كايجمع كلشي و كايبني الـ Contours.
+
+    الاستعمال:
+        builder = ContourBuilder(model, angles, detector)
+        contours = builder.build_all()  # {face: Contour}
+    """
+
+    def __init__(
+        self,
+        model: ProfileGeometryModel,
+        angles: CutAngles,
+        detector: Optional[NotchDetector] = None,
+    ):
+        self.model = model
+        self.angles = angles
+        self.detector = detector or NotchDetector()
+        self.interpreter = CutInterpreter(model, angles)
+
+    def build_face(self, face: Face) -> Contour:
+        """كايبني محيط وجه واحد.
+
+        الخطوات:
+            1. الوجه الأساسي (FaceBuilder).
+            2. قسّمو حسب cuts (SegmentBuilder).
+            3. ضيف الـ notches من الـ Detector.
+            4. سد المحيط (ClosureBuilder).
+        """
+        fb = FaceBuilder(face, self.model.dimensions)
+        base_points = fb.build()
+
+        intersections = self.interpreter.compute(face)
+        sb = SegmentBuilder(face, self.model.dimensions, intersections)
+        segments = sb.build()
+
+        merged_points = self._merge_segments(segments)
+
+        notch_points = self.detector.get_points(face)
+        if notch_points:
+            merged_points = self._merge_notches(merged_points, notch_points)
+
+        cb = ClosureBuilder(face, merged_points)
+        return cb.build()
+
+    def build_all(self) -> Dict[Face, Contour]:
+        """كايبني كل الوجوه دفعة وحدة."""
+        return {face: self.build_face(face) for face in self.model.faces}
+
+    def _merge_segments(
+        self, segments: List[List[ContourPoint]]
+    ) -> List[ContourPoint]:
+        """كايدمج الـ segments ف قائمة نقاط وحدة."""
+        if not segments:
+            return []
+
+        merged: List[ContourPoint] = []
+        for seg in segments:
+            for pt in seg:
+                if not merged or not self._is_same_point(merged[-1], pt):
+                    merged.append(pt)
+        return merged
+
+    def _merge_notches(
+        self,
+        base_points: List[ContourPoint],
+        notch_points: List[ContourPoint],
+    ) -> List[ContourPoint]:
+        """كايدمج الـ notches مع النقاط الأساسية."""
+        result = list(base_points)
+        for notch in notch_points:
+            for i, pt in enumerate(result):
+                if self._is_same_point(pt, notch):
+                    result[i] = notch
+                    break
+        return result
+
+    @staticmethod
+    def _is_same_point(a: ContourPoint, b: ContourPoint) -> bool:
+        """كايتحقق واش جوج نقاط نفس الإحداثيات."""
+        return (
+            abs(a.x - b.x) < TOLERANCE_MM
+            and abs(a.y - b.y) < TOLERANCE_MM
+        )
