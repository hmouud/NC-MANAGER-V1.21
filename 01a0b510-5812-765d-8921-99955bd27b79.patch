@@ -0,0 +1,124 @@
+"""Hole / Slot editing logic extracted from the NCManagerApp monolith (P2).
+
+The app still OWNS the override stores (``hole_overrides`` / ``added_holes``
+-- they are handed to the 2D/3D viewers), so every service method receives
+them explicitly. All methods are static, pure and UI-free.
+
+Store contract (mirrors the app's pre-existing behaviour):
+  * positive index -> ``hole_overrides[part_hash][index]`` (replaces)
+  * negative index -> ``added_holes[part_hash][-index - 1]`` (merges)
+"""
+from __future__ import annotations
+
+from nccorrection.core.input_mode import absolute_y
+from nccorrection.core.viewer import parse_geometry
+
+
+class HoleEditService:
+    """Pure hole/slot override conversion and application (P2 split).
+
+    Reliability rule: the stored model ALWAYS keeps the absolute DSTV Y
+    (``core.input_mode.absolute_y``); the UI converts on display and this
+    service converts back on save, so every viewer renders the same result.
+    """
+
+    @staticmethod
+    def normalize_override(ov):
+        """Legacy override shapes (dict / tuple / list / scalar / None) -> flat dict.
+
+        None values are dropped (a partial override must never shadow base
+        hole data with an empty field).
+        """
+        if isinstance(ov, dict):
+            return {k: v for k, v in ov.items() if v is not None}
+        if isinstance(ov, (tuple, list)):
+            return {'d': ov[0],
+                    'length': ov[1] if len(ov) > 1 and ov[1] is not None else None,
+                    'angle': ov[2] if len(ov) > 2 and ov[2] is not None else None}
+        if ov is not None:
+            return {'d': ov}
+        return {}
+
+    @staticmethod
+    def current_values(ov_dict, h):
+        """Display values for the editor: normalized override merged onto the
+        base hole record (override wins, base hole fills the rest).
+
+        Returns the dict consumed by the dialog: d, x, y, length, angle,
+        face, sym, top, ymode. ``ymode`` is derived from the stored booleans
+        when no legacy ``ymode`` string is present.
+        """
+        sym = bool(ov_dict.get('sym', h.get('sym') or False))
+        top = bool(ov_dict.get('top', h.get('top') or False))
+        return {
+            'd': ov_dict.get('d', h['d']),
+            'x': ov_dict.get('x', h['x']),
+            'y': ov_dict.get('y', h['y']),
+            'length': ov_dict.get('length', h.get('length') or 0.0),
+            'angle': ov_dict.get('angle', h.get('angle') or 0.0),
+            'face': ov_dict.get('face', h.get('face') or 'v'),
+            'sym': sym,
+            'top': top,
+            'ymode': (ov_dict.get('ymode')
+                      or ('sym' if sym else 'top' if top else 'abs')),
+        }
+
+    @staticmethod
+    def part_dims(text):
+        """ST-block dimensions of an NC1 text ([] when not parseable)."""
+        try:
+            return list((parse_geometry(text).get('st') or {}).get('dims') or [])
+        except Exception:
+            return []
+
+    @staticmethod
+    def build_override(st_type, dims, face, mode, y_in, d_in, x_in,
+                       is_slot, length_in, axis_id, sym=False, top=False):
+        """Convert raw editor inputs into the stored override dict.
+
+        Y is stored in ABSOLUTE DSTV coordinates via ``absolute_y`` (the
+        mode/sym/top checkboxes describe how the user's offset maps, they are
+        never persisted as the coordinate). Slot semantics: Width = d (minor
+        axis, face-local X); Length = major axis; ``axis_id == 1`` (the Y
+        radio) stores angle 90.0 and swaps the two fields so the Length runs
+        along Y.
+        """
+        o = {'d': d_in, 'x': x_in,
+             'y': absolute_y(st_type, dims, face, mode, y_in),
+             'face': face,
+             'sym': sym, 'top': top,
+             'ymode': mode}
+        if is_slot:
+            width = o['d']
+            if axis_id == 1:
+                o['d'] = length_in
+                o['length'] = width
+                o['angle'] = 90.0
+            else:
+                o['length'] = length_in
+                o['angle'] = 0.0
+            o['kind'] = 'slot'
+        return o
+
+    @staticmethod
+    def apply_hole_override(part_hash, hole_index, new_data,
+                            hole_overrides, added_holes):
+        """Store ``new_data`` for ``hole_index`` of ``part_hash``.
+
+        Returns True when the record existed and was updated, False when a
+        negative index pointed past the added-holes list (no write either
+        way -- mirrors the app's previous silent behaviour).
+        """
+        if hole_index >= 0:
+            ov = dict(hole_overrides.get(part_hash, {}))
+            ov[hole_index] = new_data
+            hole_overrides[part_hash] = ov
+            return True
+        lst = list(added_holes.get(part_hash, []))
+        i = -hole_index - 1
+        if 0 <= i < len(lst):
+            lst[i] = dict(lst[i])
+            lst[i].update(new_data)
+            added_holes[part_hash] = lst
+            return True
+        return False
