+"""Measure mixin for NcViewer — snapping, dimension lines, corner angles."""
+
+import math
+
+from PySide6.QtCore import Qt, QPointF, QRectF, QLineF
+from PySide6.QtGui import QPen, QBrush, QColor, QFont, QFontMetrics
+from nccorrection.ui._colors import C
+from nccorrection.design.snaps import resolve_snap, polar_snap
+from nccorrection.design.measure import corner_label, angle_verdict
+
+
+class _ViewerMeasureMixin:
+    """Mixin that holds all measurement / snapping methods for NcViewer.
+
+    This is a plain class (NOT QWidget).  All methods access ``self`` which
+    is the actual :class:`NcViewer` instance at runtime.
+    """
+
+    def _measure_line_geometry(self, i):
+        """Screen geometry of measurement ``i`` as
+        ``(s1, s2, p1, p2, perp, dim_off)`` where ``p1/p2`` are the points of
+        the dimension line shifted parallel by ``dim_off`` (Tekla/AutoCAD
+        style) and ``perp`` is the unit perpendicular of the base line.
+        """
+        a, bpt, off, dim_off = self._measurements[i]
+        s1 = QPointF(*self._to_screen(a.x(), a.y()))
+        s2 = QPointF(*self._to_screen(bpt.x(), bpt.y()))
+        ln = math.hypot(s2.x() - s1.x(), s2.y() - s1.y())
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2.y() - s1.y()) / ln, (s2.x() - s1.x()) / ln)
+        shift = perp * dim_off
+        return s1, s2, s1 + shift, s2 + shift, perp, dim_off
+
+    def _measure_line_at(self, pos, tol=6.0):
+        """Index of the measurement whose dimension LINE (parallel-shifted or
+        not) is within ``tol`` px of ``pos``, or None."""
+        for i in range(len(self._measurements)):
+            _s1, _s2, p1, p2, _perp, _off = self._measure_line_geometry(i)
+            # distance from pos to segment p1-p2
+            vx, vy = p2.x() - p1.x(), p2.y() - p1.y()
+            wx, wy = pos.x() - p1.x(), pos.y() - p1.y()
+            L2 = vx * vx + vy * vy
+            if L2 < 1e-12:
+                d = math.hypot(wx, wy)
+            else:
+                t = max(0.0, min(1.0, (wx * vx + wy * vy) / L2))
+                d = math.hypot(wx - t * vx, wy - t * vy)
+            if d <= tol:
+                return i
+        return None
+
+    def _snap_detail(self, pos):
+        """Return (scene_point, snap_kind) via the shared design snap engine."""
+        targets = self._snap_targets
+        if targets is None or not (targets.points or targets.segments
+                                   or targets.circles or targets.arcs):
+            return QPointF(*self._scene_pt(pos)), None
+        enabled, tol, exact_band = self.snap_config()
+        sx, sy = self._to_scene(pos.x(), pos.y())
+        res = resolve_snap(targets, (sx, sy), enabled=enabled, tol=tol,
+                           exact_band=exact_band)
+        if res is None:
+            return QPointF(*self._scene_pt(pos)), None
+        pt, kind, _ = res
+        return QPointF(*pt), kind
+    def _snap_ortho(self, p1, p2):
+        """Snap a preview point to an exact polar ray relative to p1.
+
+        With polar tracking enabled the cursor is locked onto the nearest
+        multiple of ``polar_angle`` (default 15 deg) within ``polar_tol``;
+        otherwise only exact horizontal/vertical (2 deg) are honoured.
+
+        Returns (snapped_point, angle_degrees, is_ortho, polar_deg_or_None):
+        ``angle`` is the displayed angle (0 horizontal, 90 vertical, or the
+        real angle otherwise); ``polar_deg`` is the locked polar multiple when
+        a polar guide engaged, else None.
+        """
+        dx = p2.x() - p1.x()
+        dy = p2.y() - p1.y()
+        if abs(dx) < 1e-6 and abs(dy) < 1e-6:
+            return p2, 0.0, True, 0.0
+        if self._design is not None and self._design.polar_enabled():
+            res = polar_snap((p1.x(), p1.y()), (p2.x(), p2.y()),
+                             self._design.polar_angle(),
+                             self._design.polar_tol())
+            if res is not None:
+                pt, m = res
+                q = QPointF(*pt)
+                return q, (m % 180.0), m in (0.0, 90.0, 180.0, 270.0), m
+        ang = math.degrees(math.atan2(dy, dx)) % 180.0
+        if ang < 2.0 or ang > 178.0:
+            return QPointF(p2.x(), p1.y()), 0.0, True, None
+        if abs(ang - 90.0) < 2.0:
+            return QPointF(p1.x(), p2.y()), 90.0, True, None
+        return p2, ang, False, None
+
+    def _arc_radius_between(self, p1, p2):
+        """Check if p1 and p2 lie on the same circular contour.
+
+        Returns (radius, centre_x, centre_y) if both points are within
+        tolerance of a contour whose arc convention is ``radius`` and the
+        contour forms a complete circle.  ``None`` otherwise.
+        """
+        if not self._geometry:
+            return None
+        metas = self._geometry.get('contour_meta') or []
+        contours = self._geometry.get('contours', [])
+        tol = 3.0 / max(self._scale * self._zoom, 1e-6)  # 3 px tolerance
+        for ci, (contour, meta) in enumerate(zip(contours, metas)):
+            if meta.get('arc_convention') != 'radius':
+                continue
+            arc_vals = meta.get('arc_values', [])
+            if not arc_vals or not any(abs(v) > 1e-12 for v in arc_vals):
+                continue
+            # Build circle from the radius-based arc vertices
+            pts_arc = [(float(x), float(y)) for x, y in contour]
+            # Use first 3 distinct points to compute circle via bisector
+            if len(pts_arc) < 2:
+                continue
+            # Quick filter: both points must be within the bounding box of
+            # this contour (expanded by radius) to avoid cross-contour false
+            # positives.
+            xs = [p[0] for p in pts_arc]
+            ys = [p[1] for p in pts_arc]
+            r_avg = sum(abs(v) for v in arc_vals) / len(arc_vals)
+            cx = (min(xs) + max(xs)) / 2.0
+            cy = (min(ys) + max(ys)) / 2.0
+            # Check both measured points are roughly on this circle
+            d1 = math.hypot(p1.x() - cx, p1.y() - cy)
+            d2 = math.hypot(p2.x() - cx, p2.y() - cy)
+            if (abs(d1 - r_avg) < tol and abs(d2 - r_avg) < tol):
+                return (r_avg, cx, cy)
+        return None
+
+    def _draw_measure(self, p):
+        c1 = QColor(self._mp['line'])
+        c2 = QColor(self._mp['label_text'])
+
+        # 1. LIVE HOVER GLYPH (ALWAYS RENDER IF HOVER EXISTS)
+        if self._hover_pt and self._hover_kind:
+            hp_screen = self._to_screen(self._hover_pt.x(), self._hover_pt.y())
+            self._snap_badge(p, hp_screen, self._hover_kind) # Render the Box/Triangle live!
+
+        # committed measurements stay visible
+        for i, item in enumerate(self._measurements):
+            if len(item) == 5:
+                a, bpt, off, dim_off, kind = item
+            else:
+                a, bpt, off, dim_off = item[:4]
+                kind = 'aligned'
+            self._draw_one_measure(p, a, bpt, c1, c2, off, dim_off, kind=kind)
+
+        # committed diameter dimensions
+        for cx, cy, r, d, px, py in getattr(self, '_diameter_measures', []):
+            self._draw_diameter_measure(p, cx, cy, r, d, px, py, c1, c2)
+
+        # live diameter dimension preview
+        active_circ = getattr(self, '_circle_first_click', None)
+        if active_circ and self._hover_pt:
+            cx, cy, r, d = active_circ
+            self._draw_diameter_measure(p, cx, cy, r, d, self._hover_pt.x(), self._hover_pt.y(), c1, c2)
+
+        # corner-angle measures: two arms from the vertex + angle label
+        for a, vertex, b, ang in self._corner_measures:
+            self._draw_corner_measure(p, a, vertex, b, ang, c1, c2)
+        if self._corner_mode and self._corner_pts:
+            self._draw_corner_progress(p, c1)
+        if self._m1 is None:
+            self._draw_status(p)
+            return
+        s1 = self._to_screen(self._m1.x(), self._m1.y())
+        p.setPen(QPen(c1, 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(QBrush(c1))
+        p.drawEllipse(QPointF(*s1), 4, 4)
+        p.setBrush(Qt.NoBrush)
+        p.setPen(QPen(c1, 0.8))
+        p.drawLine(QPointF(s1[0] - 7, s1[1]), QPointF(s1[0] + 7, s1[1]))
+        p.drawLine(QPointF(s1[0], s1[1] - 7), QPointF(s1[0], s1[1] + 7))
+        # live preview: line from the first point to the snapped cursor with
+        # angle feedback (straight/90\u00b0 vs slanted) BEFORE the second click
+        hover = self._hover_pt
+        if hover is None:
+            self._draw_status(p)
+            return
+        sp, ang, ortho, polar_deg = self._snap_ortho(self._m1, hover)
+        s2 = self._to_screen(sp.x(), sp.y())
+        dist = math.hypot(sp.x() - self._m1.x(), sp.y() - self._m1.y())
+        p.setPen(QPen(c1, 0.8, Qt.DashLine, Qt.RoundCap))
+        p.setBrush(Qt.NoBrush)
+        p.drawLine(QPointF(*s1), QPointF(*s2))
+        self._arrow(p, QLineF(QPointF(*s1), QPointF(*s2)), c1)
+        if self._hover_kind:
+            self._snap_badge(p, s2, self._hover_kind)
+        # angle + distance feedback next to the cursor
+        if polar_deg is not None:
+            ang_label = f'{round(polar_deg % 180.0)}\u00b0'
+        elif ang == 90.0:
+            ang_label = '90\u00b0'
+        elif ortho:
+            ang_label = '0\u00b0'
+        else:
+            ang_label = f'{ang:.1f}\u00b0'
+        label = f'{dist:.1f} mm  \u2220{ang_label}  [{angle_verdict(ang)}]'
+        if polar_deg is not None:
+            label += '  [polar]'
+        elif ortho and dist > 0:
+            label += '  [aligned]'
+        # label rides the LIVE line midpoint, no frame hiding the view
+        # (halo text = CAD standard stencil over the line)
+        fm = p.fontMetrics()
+        tw = fm.horizontalAdvance(label) + 16
+        mid = QPointF((s1.x() + s2.x()) / 2, (s1.y() + s2.y()) / 2 - 24)
+        rect = QRectF(mid.x() - tw / 2, mid.y(), tw, 20)
+        self._halo_text(p, rect, label, c2)
+        self._draw_status(p)
+
+    def _measure_label_rect(self, a, bpt, off=(0.0, 0.0), dim_off=0.0):
+        s1 = self._to_screen(a.x(), a.y())
+        s2 = self._to_screen(bpt.x(), bpt.y())
+        dist = math.hypot(bpt.x() - a.x(), bpt.y() - a.y())
+        dx = bpt.x() - a.x()
+        dy = bpt.y() - a.y()
+        ang = math.degrees(math.atan2(dy, dx))
+        aabs = abs(ang % 180.0)
+        if aabs < 2.0 or aabs > 178.0:
+            ang_label = '0\u00b0'
+            verdict = angle_verdict(0.0)
+        elif abs(aabs - 90.0) < 2.0:
+            ang_label = '90\u00b0'
+            verdict = angle_verdict(90.0)
+        else:
+            ang_label = f'{aabs:.1f}\u00b0'
+            verdict = angle_verdict(aabs)
+        label = f'{dist:.1f} mm  \u2220{ang_label}  [{verdict}]'
+        fm = QFontMetrics(QFont('Arial', 9, QFont.Bold))
+        tw = fm.horizontalAdvance(label) + 16
+        ln = math.hypot(s2[0] - s1[0], s2[1] - s1[1])
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2[1] - s1[1]) / ln, (s2[0] - s1[0]) / ln)
+        # the label rides the (possibly parallel-shifted) line midpoint
+        mid = QPointF((s1[0] + s2[0]) / 2 + perp.x() * dim_off,
+                      (s1[1] + s2[1]) / 2 - 24 + perp.y() * dim_off)
+        return QRectF(mid.x() - tw / 2 + off[0], mid.y() + off[1], tw, 20), label
+
+    def _draw_one_measure(self, p, a, bpt, c1, c2, off=(0.0, 0.0), dim_off=0.0, kind='aligned'):
+        s1 = QPointF(*self._to_screen(a.x(), a.y()))
+        s2 = QPointF(*self._to_screen(bpt.x(), bpt.y()))
+
+        if kind == 'horizontal':
+            # Strict Horizontal Dimension: ΔX
+            dx_val = abs(bpt.x() - a.x())
+            label = f"{dx_val:.1f} mm"
+            dim_y = min(s1.y(), s2.y()) - 28.0 - abs(dim_off)
+            p1 = QPointF(s1.x(), dim_y)
+            p2 = QPointF(s2.x(), dim_y)
+            p.setPen(QPen(c1, 0.7, Qt.SolidLine, Qt.RoundCap))
+            p.drawLine(s1, p1)
+            p.drawLine(s2, p2)
+            line = QLineF(p1, p2)
+            p.setPen(QPen(c1, 1.0, Qt.SolidLine, Qt.RoundCap))
+            p.drawLine(line)
+            self._arrow(p, line, c1)
+            p.setBrush(QBrush(c1))
+            p.setPen(Qt.NoPen)
+            p.drawEllipse(s1, 3, 3)
+            p.drawEllipse(s2, 3, 3)
+            fm = p.fontMetrics()
+            tw = fm.horizontalAdvance(label) + 12
+            rect = QRectF((p1.x() + p2.x()) / 2 - tw / 2 + off[0], dim_y - 18 + off[1], tw, 18)
+            self._halo_text(p, rect, label, c1)
+            return
+
+        if kind == 'vertical':
+            # Strict Vertical Dimension: ΔY
+            dy_val = abs(bpt.y() - a.y())
+            label = f"{dy_val:.1f} mm"
+            dim_x = max(s1.x(), s2.x()) + 28.0 + abs(dim_off)
+            p1 = QPointF(dim_x, s1.y())
+            p2 = QPointF(dim_x, s2.y())
+            p.setPen(QPen(c1, 0.7, Qt.SolidLine, Qt.RoundCap))
+            p.drawLine(s1, p1)
+            p.drawLine(s2, p2)
+            line = QLineF(p1, p2)
+            p.setPen(QPen(c1, 1.0, Qt.SolidLine, Qt.RoundCap))
+            p.drawLine(line)
+            self._arrow(p, line, c1)
+            p.setBrush(QBrush(c1))
+            p.setPen(Qt.NoPen)
+            p.drawEllipse(s1, 3, 3)
+            p.drawEllipse(s2, 3, 3)
+            fm = p.fontMetrics()
+            tw = fm.horizontalAdvance(label) + 12
+            rect = QRectF(dim_x + 8 + off[0], (p1.y() + p2.y()) / 2 - 9 + off[1], tw, 18)
+            self._halo_text(p, rect, label, c1)
+            return
+
+        ln = math.hypot(s2.x() - s1.x(), s2.y() - s1.y())
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2.y() - s1.y()) / ln, (s2.x() - s1.x()) / ln)
+        shift = perp * dim_off
+        p1, p2 = s1 + shift, s2 + shift
+        p.setPen(QPen(c1, 0.7, Qt.SolidLine, Qt.RoundCap))
+        if abs(dim_off) > 1e-6:
+            p.drawLine(s1, p1)
+            p.drawLine(s2, p2)
+        line = QLineF(p1, p2)
+        p.setPen(QPen(c1, 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(QBrush(c1))
+        p.drawLine(line)
+        self._arrow(p, line, c1)
+        p.setBrush(QBrush(c2))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(s2, 3, 3)
+        p.setBrush(QBrush(c1))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(s1, 3, 3)
+        rect, label = self._measure_label_rect(a, bpt, off, dim_off)
+        self._halo_text(p, rect, label, c1)
+
+    def _draw_corner_measure(self, p, a, vertex, b, ang, c1, c2):
+        sv = self._to_screen(*vertex)
+        s1 = self._to_screen(*a)
+        s2 = self._to_screen(*b)
+        p.setPen(QPen(c1, 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(Qt.NoBrush)
+        p.drawLine(QPointF(*sv), QPointF(*s1))
+        p.drawLine(QPointF(*sv), QPointF(*s2))
+        p.setBrush(QBrush(c1))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(QPointF(*sv), 4, 4)
+        p.drawEllipse(QPointF(*s1), 3, 3)
+        p.drawEllipse(QPointF(*s2), 3, 3)
+        label = corner_label(ang)
+        fm = QFontMetrics(QFont('Arial', 9, QFont.Bold))
+        tw = fm.horizontalAdvance(label) + 16
+        rect = QRectF(sv[0] - tw / 2, sv[1] - 40, tw, 20)
+        self._halo_text(p, rect, label, c2)
+
+    def _draw_corner_progress(self, p, c1):
+        p.setPen(QPen(c1, 0.8, Qt.DashLine, Qt.RoundCap))
+        p.setBrush(QBrush(c1))
+        for pt in self._corner_pts:
+            sx, sy = self._to_screen(*pt)
+            p.drawEllipse(QPointF(sx, sy), 3, 3)
+        if len(self._corner_pts) == 2 and self._hover_pt is not None:
+            sv = self._to_screen(*self._corner_pts[0])
+            sh = self._to_screen(self._hover_pt.x(), self._hover_pt.y())
+            p.drawLine(QPointF(*sv), QPointF(*sh))
+
+    def _detect_circle_at(self, scene_x, scene_y, tol_px=14.0):
+        """Auto-detect circle/hole near scene_x, scene_y.
+
+        Returns (cx, cy, radius, diameter) if detected, else None.
+        """
+        tol = tol_px / max(self._scale * self._zoom, 1e-6)
+        if not self._geometry:
+            return None
+        # 1. Check holes
+        for h in self._geometry.get('holes', []):
+            hx = h.get('x', 0.0)
+            hy = self._explode_y(h.get('face') or 'v', h.get('y', 0.0))
+            d = float(h.get('d', 0.0))
+            r = d / 2.0
+            dist_to_center = math.hypot(scene_x - hx, scene_y - hy)
+            dist_to_rim = abs(dist_to_center - r)
+            if dist_to_center <= r + tol or dist_to_rim <= tol:
+                return (hx, hy, r, d)
+        # 2. Check snap targets circles
+        if getattr(self, '_snap_targets', None) and self._snap_targets.circles:
+            for cx, cy, r in self._snap_targets.circles:
+                dist_to_center = math.hypot(scene_x - cx, scene_y - cy)
+                dist_to_rim = abs(dist_to_center - r)
+                if dist_to_center <= r + tol or dist_to_rim <= tol:
+                    return (cx, cy, r, 2.0 * r)
+        return None
+
+    def _draw_diameter_measure(self, p, cx, cy, r, d, px, py, c1, c2):
+        """Draw AutoCAD-style circle diameter dimension with center mark and leader."""
+        scx, scy = self._to_screen(cx, cy)
+        spx, spy = self._to_screen(px, py)
+
+        # 1. AutoCAD Center Mark (+)
+        mark_len = max(6.0, min(14.0, r * self._scale * self._zoom * 0.45))
+        p.setPen(QPen(c1, 1.2))
+        p.drawLine(QPointF(scx - mark_len, scy), QPointF(scx + mark_len, scy))
+        p.drawLine(QPointF(scx, scy - mark_len), QPointF(scx, scy + mark_len))
+
+        # 2. Angle from center to placement point
+        ang = math.atan2(spy - scy, spx - scx)
+        cos_a, sin_a = math.cos(ang), math.sin(ang)
+
+        # Leader starts at circle rim
+        rr_px = r * self._scale * self._zoom
+        rim_x = scx + rr_px * cos_a
+        rim_y = scy + rr_px * sin_a
+
+        # Leader line from rim to landing point
+        p.setPen(QPen(c1, 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.drawLine(QPointF(rim_x, rim_y), QPointF(spx, spy))
+
+        # AutoCAD-style arrowhead at circle rim
+        arr_size = 7.0
+        base_x = rim_x - arr_size * cos_a
+        base_y = rim_y - arr_size * sin_a
+        splay = 0.25
+        tri = QPolygonF([
+            QPointF(rim_x, rim_y),
+            QPointF(base_x - arr_size * splay * sin_a, base_y + arr_size * splay * cos_a),
+            QPointF(base_x + arr_size * splay * sin_a, base_y - arr_size * splay * cos_a),
+        ])
+        p.setBrush(QBrush(c1))
+        p.drawPolygon(tri)
+        p.setBrush(Qt.NoBrush)
+
+        # 3. Horizontal landing bar
+        landing_dir = 1.0 if spx >= scx else -1.0
+        landing_len = 24.0 * landing_dir
+        p.drawLine(QPointF(spx, spy), QPointF(spx + landing_len, spy))
+
+        # 4. Text annotation
+        label = f"\u00d8{d:g} mm"
+        p.setFont(QFont('Segoe UI', 9, QFont.Bold))
+        fm = p.fontMetrics()
+        tw = fm.horizontalAdvance(label) + 12
+        th = fm.height() + 4
+        text_x = spx + landing_len + (2 if landing_dir > 0 else -tw - 2)
+        rect = QRectF(text_x, spy - th, tw, th)
+        p.setPen(QPen(c1, 0.8))
+        p.setBrush(QColor(15, 23, 42, 220))
+        p.drawRoundedRect(rect, 3, 3)
+        p.setPen(c2)
+        p.drawText(rect, Qt.AlignCenter, label)
+
+    def _snap_badge(self, p, pos, kind):
+        from nccorrection.design.glyphs import draw_snap_glyph
+        from nccorrection.design.theme import SNAP_BADGE_COLORS, snap_label
+        color = self._mp['badges'].get(kind, SNAP_BADGE_COLORS.get(kind, C.mut))
+        scale = self._design.snap_badge_size() if self._design else 1.0
+        draw_snap_glyph(p, pos, kind, QColor(color), scale)
+        x, y = (pos.x(), pos.y()) if hasattr(pos, 'x') else pos
+        r = 6.0 * scale
+        p.setFont(QFont('Arial', 8, QFont.Bold))
+        p.setPen(QColor(color))
+        p.drawText(QPointF(x + r * 1.6, y + r * 2.0), snap_label(kind))
diff --git a/src/nccorrection/ui/qt_viewer_painting.py b/src/nccorrection/ui/qt_viewer_painting.py
