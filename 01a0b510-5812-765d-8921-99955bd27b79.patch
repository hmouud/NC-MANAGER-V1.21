+    def test_fold_lifts_flap_toward_plus_z(self):
+        flat_z = self._zmax()
+        self.v.set_fold_state({'show_line': False, 'fold': True})
+        # flap width 500 at 90 degrees -> tip height ~500 above the plane
+        folded_z = self._zmax()
+        self.assertGreater(folded_z, flat_z + 400)
+        self.assertAlmostEqual(folded_z, flat_z + 500.0, delta=10.0)
+
+    def test_unfold_restores_flat_model(self):
