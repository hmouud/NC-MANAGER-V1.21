+class TestShapeCreatorScalingAndArray(unittest.TestCase):
+    """Test Shape Creator scaling and 2D multi-part array repeat."""
+
+    def test_shape_scaling(self):
+        from nccorrection.engine.part_creator.shapes import RectangleShape
+        rect_shape = RectangleShape()
+        params = {'width': 100.0, 'height': 50.0}
+        orig = rect_shape.generate(params)
+        orig_w = max(p[0] for p in orig.outer) - min(p[0] for p in orig.outer)
+        orig_h = max(p[1] for p in orig.outer) - min(p[1] for p in orig.outer)
+        self.assertAlmostEqual(orig_w, 100.0)
+        self.assertAlmostEqual(orig_h, 50.0)
+
+        # Scale by 2.0x
+        scaled = orig.scale(2.0)
+        scaled_w = max(p[0] for p in scaled.outer) - min(p[0] for p in scaled.outer)
+        scaled_h = max(p[1] for p in scaled.outer) - min(p[1] for p in scaled.outer)
+        self.assertAlmostEqual(scaled_w, 200.0)
+        self.assertAlmostEqual(scaled_h, 100.0)
+
+    def test_shape_array_repeat(self):
+        from nccorrection.engine.part_creator.shapes import RectangleShape
+        rect_shape = RectangleShape()
+        params = {'width': 100.0, 'height': 50.0}
+        # 2 x 2 array of parts
+        tiled = rect_shape.generate_transformed(params, scale=1.0, count_x=2, count_y=2, spacing_x=20.0, spacing_y=20.0)
+        # 1 main outer + 3 repeated parts in inners = 4 parts total
+        self.assertEqual(len(tiled.inners), 3)
+
+
+if __name__ == '__main__':
+    unittest.main()
