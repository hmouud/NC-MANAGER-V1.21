+def _ipe750x137_geometry():
+    """Nominal IPE 750 x 137 geometry (h=753, b=263, tw=11.5, tf=17.0).
+
+    Ix/Iy/Wpl/area are COMPUTED from the rectangular flange+web model
+    (fillets ignored) because no verified published table was available in
+    session. These are deterministic engineering formulas, not invented
+    values:
+
+        area   = 2·b·tf + (h−2·tf)·tw
+        Ix     = (b·h³ − (b−tw)·(h−2·tf)³)/12
+        Iy     = (2·tf·b³ + (h−2·tf)·tw³)/12
+        Wpl.x  = b·tf·(h−tf) + (h−2·tf)²·tw/4
+        Wpl.y  = tf·b²/2 + (h−2·tf)·tw²/4
+
+    The Owner's published Mémotech/NF A 45-209 table is the final authority
+    for this row; replacing the numbers is a one-line edit.
+    """
+    h, b, tw, tf = 753.0, 263.0, 11.5, 17.0
+    hw = h - 2.0 * tf  # web height between flanges
+    area = 2.0 * b * tf + hw * tw
+    ix_mm4 = (b * h ** 3 - (b - tw) * hw ** 3) / 12.0
+    iy_mm4 = (2.0 * tf * b ** 3 + hw * tw ** 3) / 12.0
+    wpl_x = b * tf * (h - tf) + hw ** 2 * tw / 4.0
+    wpl_y = tf * b ** 2 / 2.0 + hw * tw ** 2 / 4.0
+    return area, ix_mm4 / 1e4, iy_mm4 / 1e4, wpl_x, wpl_y
+
+
