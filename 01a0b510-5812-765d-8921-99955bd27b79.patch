+def _coplanar(pts, eps=1e-6):
+    """True when every point lies on ONE plane (Newell-equivalent check)."""
+    if len(pts) < 3:
+        return False
+    p0, p1, p2 = pts[0], pts[1], pts[2]
+    ux, uy, uz = p1[0] - p0[0], p1[1] - p0[1], p1[2] - p0[2]
+    vx, vy, vz = p2[0] - p0[0], p2[1] - p0[1], p2[2] - p0[2]
+    nx = uy * vz - uz * vy
+    ny = uz * vx - ux * vz
+    nz = ux * vy - uy * vx
+    ln = math.sqrt(nx * nx + ny * ny + nz * nz)
+    if ln < 1e-12:
+        return False
+    d = -(nx * p0[0] + ny * p0[1] + nz * p0[2])
+    return all(abs(nx * p[0] + ny * p[1] + nz * p[2] + d) <= eps
+               for p in pts)
+
