index 0000000..8fd2c1f
--- /dev/null
+++ b/src/nccorrection/design/dimensioning/types.py
@@ -0,0 +1,337 @@
+"""Pure data types for the dimensioning engine.
+
+No Qt imports, no rendering — just dataclasses that describe WHAT to draw.
+The renderer module reads these and calls QPainter to paint them.
+This separation means the same dimension objects can be serialized, tested,
+and reused across 2D / blueprint / DXF export without touching Qt.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from enum import Enum, auto
+from typing import List, Optional, Tuple
+
+
+# ────────────────────────────────────────────────────────────────────
+# Enums
+# ────────────────────────────────────────────────────────────────────
+
+class DimType(Enum):
+    """Dimension entity type — mirrors DXF dimtype values."""
+    RADIUS = auto()       # R xxx leader
+    DIAMETER = auto()     # Ø xxx leader
+    ANGULAR = auto()      # Angle arc between two lines
+    LINEAR = auto()       # Linear distance between two points
+    LEADER = auto()       # Arrow + text note
+    CENTER_MARK = auto()  # Cross / plus at circle center
+
+
+class ArrowStyle(Enum):
+    """Arrowhead rendering style."""
+    FILLED = auto()       # Closed filled triangle (AutoCAD default)
+    OPEN = auto()         # Open V-shape
+    TICK = auto()         # Oblique stroke (/  /)
+    DOT = auto()          # Filled circle
+    NONE = auto()         # No arrow
+
+
+class TextPlacement(Enum):
+    """Where the dimension text sits relative to the dimension line."""
+    OUTSIDE = auto()      # Outside the circle/arc (default for radius)
+    INSIDE = auto()       # Inside the circle/arc
+    ALONG = auto()        # Aligned with the dimension line
+    HORIZONTAL = auto()   # Always horizontal (regardless of dim line angle)
+    ABOVE = auto()        # Above the dimension line
+
+
+class LeaderStyle(Enum):
+    """Leader line path style."""
+    STRAIGHT = auto()     # Single straight segment
+    BENT = auto()         # One bend (horizontal tail after the slant)
+    SPLINE = auto()       # Curved path (future use)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Core data classes
+# ────────────────────────────────────────────────────────────────────
+
+@dataclass
+class Point2D:
+    """Immutable 2D point."""
+    x: float
+    y: float
+
+    def to_tuple(self) -> Tuple[float, float]:
+        return (self.x, self.y)
+
+    def distance_to(self, other: 'Point2D') -> float:
+        return math.hypot(other.x - self.x, other.y - self.y)
+
+    def angle_to(self, other: 'Point2D') -> float:
+        """Angle in degrees from self to other (0=right, 90=up)."""
+        return math.degrees(math.atan2(other.y - self.y, other.x - self.x))
+
+    def lerp(self, other: 'Point2D', t: float) -> 'Point2D':
+        """Linear interpolation: t=0 → self, t=1 → other."""
+        return Point2D(
+            self.x + (other.x - self.x) * t,
+            self.y + (other.y - self.y) * t,
+        )
+
+    def offset(self, dx: float = 0.0, dy: float = 0.0) -> 'Point2D':
+        return Point2D(self.x + dx, self.y + dy)
+
+    def rotated(self, angle_deg: float, origin: 'Point2D' = None) -> 'Point2D':
+        """Rotate by angle_deg around origin (default: self)."""
+        if origin is None:
+            origin = self
+        rad = math.radians(angle_deg)
+        cos_a, sin_a = math.cos(rad), math.sin(rad)
+        dx, dy = self.x - origin.x, self.y - origin.y
+        return Point2D(
+            origin.x + dx * cos_a - dy * sin_a,
+            origin.y + dx * sin_a + dy * cos_a,
+        )
+
+
+@dataclass
+class Circle:
+    """Circle defined by center + radius."""
+    center: Point2D
+    radius: float
+
+    def contains_point(self, pt: Point2D, tol: float = 0.5) -> bool:
+        """True if pt is within tol mm of the circumference."""
+        return abs(pt.distance_to(self.center) - self.radius) < tol
+
+
+@dataclass
+class Arc:
+    """Arc defined by center + radius + start/end angles."""
+    center: Point2D
+    radius: float
+    start_angle_deg: float  # 0-360
+    end_angle_deg: float    # 0-360
+
+    @property
+    def sweep_deg(self) -> float:
+        """Sweep angle (always positive, 0-360)."""
+        sweep = self.end_angle_deg - self.start_angle_deg
+        if sweep < 0:
+            sweep += 360.0
+        return sweep
+
+    def point_at(self, angle_deg: float) -> Point2D:
+        """Point on the arc at the given angle."""
+        rad = math.radians(angle_deg)
+        return Point2D(
+            self.center.x + self.radius * math.cos(rad),
+            self.center.y + self.radius * math.sin(rad),
+        )
+
+
+# ────────────────────────────────────────────────────────────────────
+# Dimension entities
+# ────────────────────────────────────────────────────────────────────
+
+@dataclass
+class RadiusDimension:
+    """R xxx leader dimension for a circle or arc.
+
+    Draws: arrow at point_on_circle, line from center to edge, text "R xxx".
+    """
+    center: Point2D
+    point_on_circle: Point2D
+    radius: float
+    angle_deg: float = 0.0          # Orientation of the dimension line
+    label: str = ''                  # Override text (default: "R {radius:.0f}")
+    text_placement: TextPlacement = TextPlacement.OUTSIDE
+    face: str = 'v'                  # DSTV face this dimension belongs to
+
+    @property
+    def text(self) -> str:
+        return self.label or f'R {self.radius:.1f}'
+
+    @property
+    def direction(self) -> Point2D:
+        """Unit vector from center toward point_on_circle."""
+        dx = self.point_on_circle.x - self.center.x
+        dy = self.point_on_circle.y - self.center.y
+        length = math.hypot(dx, dy)
+        if length < 1e-12:
+            return Point2D(1.0, 0.0)
+        return Point2D(dx / length, dy / length)
+
+
+@dataclass
+class DiameterDimension:
+    """Ø xxx leader dimension for a full circle.
+
+    Draws: arrow at point_on_circle, line through center to opposite side,
+    text "Ø xxx".
+    """
+    center: Point2D
+    point_on_circle: Point2D
+    diameter: float
+    angle_deg: float = 0.0          # Orientation of the dimension line
+    label: str = ''                  # Override text
+    text_placement: TextPlacement = TextPlacement.OUTSIDE
+    face: str = 'v'
+
+    @property
+    def text(self) -> str:
+        return self.label or f'\u00d8 {self.diameter:.1f}'
+
+    @property
+    def radius(self) -> float:
+        return self.diameter / 2.0
+
+    @property
+    def direction(self) -> Point2D:
+        dx = self.point_on_circle.x - self.center.x
+        dy = self.point_on_circle.y - self.center.y
+        length = math.hypot(dx, dy)
+        if length < 1e-12:
+            return Point2D(1.0, 0.0)
+        return Point2D(dx / length, dy / length)
+
+
+@dataclass
+class AngularDimension:
+    """Angle arc between two lines sharing a vertex.
+
+    Draws: arc from line1 to line2, extension lines, text "xx.x°".
+    """
+    vertex: Point2D                   # Common point (usually circle center)
+    line1_end: Point2D                # End of first arm
+    line2_end: Point2D                # End of second arm
+    dim_arc_radius: float = 0.0       # Distance from vertex to dimension arc (0=auto)
+    label: str = ''                    # Override text
+    text_placement: TextPlacement = TextPlacement.ALONG
+    face: str = 'v'
+
+    @property
+    def angle_deg(self) -> float:
+        """Angle in degrees between the two arms (0-180)."""
+        a1 = math.atan2(self.line1_end.y - self.vertex.y,
+                        self.line1_end.x - self.vertex.x)
+        a2 = math.atan2(self.line2_end.y - self.vertex.y,
+                        self.line2_end.x - self.vertex.x)
+        diff = abs(a2 - a1)
+        if diff > math.pi:
+            diff = 2.0 * math.pi - diff
+        return math.degrees(diff)
+
+    @property
+    def text(self) -> str:
+        return self.label or f'{self.angle_deg:.1f}\u00b0'
+
+    @property
+    def line1_angle(self) -> float:
+        return math.degrees(math.atan2(
+            self.line1_end.y - self.vertex.y,
+            self.line1_end.x - self.vertex.x))
+
+    @property
+    def line2_angle(self) -> float:
+        return math.degrees(math.atan2(
+            self.line2_end.y - self.vertex.y,
+            self.line2_end.x - self.vertex.x))
+
+
+@dataclass
+class LinearDimension:
+    """Linear distance between two points.
+
+    Draws: extension lines, dimension line with arrows, text "xxx.x".
+    """
+    point1: Point2D
+    point2: Point2D
+    offset: float = 0.0               # Perpendicular offset from the line
+    angle_deg: float = 0.0            # Rotation of dimension line (0=aligned)
+    label: str = ''
+    text_placement: TextPlacement = TextPlacement.ABOVE
+    face: str = 'v'
+
+    @property
+    def distance(self) -> float:
+        return self.point1.distance_to(self.point2)
+
+    @property
+    def text(self) -> str:
+        return self.label or f'{self.distance:.1f}'
+
+
+@dataclass
+class LeaderDimension:
+    """Arrow + text note (leader line without measuring anything).
+
+    Draws: arrow at start, line to tail, horizontal tail, text.
+    """
+    start: Point2D                     # Arrow tip location
+    tail: Point2D                      # End of leader (text goes here)
+    text: str = 'Note'
+    face: str = 'v'
+
+
+@dataclass
+class CenterMark:
+    """Cross / plus at a circle center.
+
+    Draws: small cross at center, optionally extended lines to radius.
+    """
+    center: Point2D
+    mark_size: float = 3.0            # Half-size of the cross (mm)
+    extended: bool = False             # If True, lines extend toward radius
+    radius: float = 0.0               # Extension length (when extended=True)
+    face: str = 'v'
+
+
+@dataclass
+class BoltCirclePattern:
+    """Detected bolt circle: N holes equally spaced on a circle.
+
+    Auto-generated by detector.py when 3+ holes share the same radius.
+    """
+    center: Point2D
+    bolt_radius: float                 # Radius of the bolt circle
+    hole_positions: List[Point2D]      # Centers of the holes
+    hole_diameter: float = 0.0         # Diameter of each hole (for labeling)
+    face: str = 'v'
+
+    @property
+    def hole_count(self) -> int:
+        return len(self.hole_positions)
+
+    @property
+    def angular_spacing(self) -> float:
+        """Angular spacing in degrees (assuming equal spacing)."""
+        if self.hole_count < 2:
+            return 0.0
+        return 360.0 / self.hole_count
+
+
+@dataclass
+class DimensionGroup:
+    """Collection of dimensions for a single face / contour.
+
+    Groups all dimension entities that belong together so the renderer
+    can draw them in one pass with consistent styling.
+    """
+    face: str = 'v'
+    radii: List[RadiusDimension] = field(default_factory=list)
+    diameters: List[DiameterDimension] = field(default_factory=list)
+    angulars: List[AngularDimension] = field(default_factory=list)
+    linears: List[LinearDimension] = field(default_factory=list)
+    leaders: List[LeaderDimension] = field(default_factory=list)
+    center_marks: List[CenterMark] = field(default_factory=list)
+    bolt_circles: List[BoltCirclePattern] = field(default_factory=list)
+
+    @property
+    def is_empty(self) -> bool:
+        return not any([
+            self.radii, self.diameters, self.angulars,
+            self.linears, self.leaders, self.center_marks,
+            self.bolt_circles,
+        ])
