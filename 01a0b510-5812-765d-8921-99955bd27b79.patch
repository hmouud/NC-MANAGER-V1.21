+import sys, os, unittest
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.core.hole_ops import apply_edits, row_index
+
+
+TEXT = ("ST\nI\nHEA300\n6000.0\n300.0\n150.0\n10.0\n6.0\nBO\n"
+        "v 100.00 120.00 18.00\nu 300.00 30.00 22.00\n"
+        "v 2000.00 120.00 22.00 60.00\nEN\n")
+
+
+class TestHoleOps(unittest.TestCase):
+    def setUp(self):
+        self.geo = parse_geometry(TEXT)
+
+    def test_no_edits(self):
+        g, active = apply_edits(self.geo)
+        self.assertEqual(len(g['holes']), 3)
+        self.assertEqual(active, [0, 1, 2])
+
+    def test_modify(self):
+        g, active = apply_edits(self.geo, {0: {'d': 30.0, 'x': 150.0}})
+        self.assertEqual(g['holes'][0]['d'], 30.0)
+        self.assertEqual(g['circles'][0][2], 30.0)
+        self.assertEqual(active, [0, 1, 2])
+
+    def test_delete(self):
+        g, active = apply_edits(self.geo, {}, deleted=[1])
+        self.assertEqual(len(g['holes']), 2)
+        self.assertEqual(active, [0, 2])
+        self.assertEqual(g['holes'][1]['d'], 22.0)
+        self.assertEqual(row_index(active, 1), 2)
+
+    def test_add(self):
+        g, active = apply_edits(
+            self.geo, {},
+            added=[{'x': 500.0, 'y': 90.0, 'd': 14.0},
+                   {'x': 600.0, 'y': 20.0, 'd': 16.0, 'length': 50.0}])
+        self.assertEqual(len(g['holes']), 5)
+        self.assertEqual(len(g['circles']), 3)
+        self.assertEqual(len(g['slots']), 2)
+        self.assertEqual(active, [0, 1, 2, -1, -2])
+        self.assertEqual(g['holes'][3]['kind'], 'hole')
+        self.assertEqual(g['holes'][4]['kind'], 'slot')
+
+    def test_delete_and_add_together(self):
+        g, active = apply_edits(
+            self.geo, {}, deleted=[0],
+            added=[{'x': 400.0, 'y': 100.0, 'd': 12.0}])
+        self.assertEqual(len(g['holes']), 3)
+        self.assertEqual(active, [1, 2, -1])
+        self.assertEqual(g['holes'][0]['d'], 22.0)
+        self.assertEqual(g['holes'][2]['d'], 12.0)
+
+
+if __name__ == '__main__':
+    unittest.main()
