+"""base_builder.py — Abstract base builder.
+
+🚨 GUARDIAN LAW: Template Method Pattern.
+كايحدد الهيكل العام، و كايخلي التفاصيل للـ subclasses.
+"""
+from __future__ import annotations
+from abc import ABC, abstractmethod
+from typing import Any
+
+
+class BaseBuilder(ABC):
+    """Abstract Builder — الأساس لكل الـ Builders ف الـ Contour Engine."""
+
+    def __init__(self) -> None:
+        self._result: Any = None
+        self._is_built: bool = False
+
+    @abstractmethod
+    def _build_impl(self) -> Any:
+        """التنفيذ الفعلي ديال البناء."""
+        raise NotImplementedError
+
+    @abstractmethod
+    def _validate(self) -> bool:
+        """التحقق من صحة النتيجة قبل الإرجاع."""
+        raise NotImplementedError
+
+    def build(self) -> Any:
+        """Template Method: كايبني، كايتحقق، كايرجع النتيجة."""
+        self._result = self._build_impl()
+        if not self._validate():
+            raise ValueError(
+                f"{self.__class__.__name__}: validation failed after build"
+            )
+        self._is_built = True
+        return self._result
+
+    def reset(self) -> None:
+        """كايفرّغ الـ state باش نعاودو نستعملو الكائن."""
+        self._result = None
+        self._is_built = False
+
+    @property
+    def is_built(self) -> bool:
+        return self._is_built
+
+    @property
+    def result(self) -> Any:
+        return self._result
