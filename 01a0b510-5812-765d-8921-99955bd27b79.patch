+
+    # ------------------------------------------------------- faces layout
+    # Face order matches the blueprint unfold layout (renderer_2d
+    # `_unfold_layout`): bottom flange `u` at the bottom, web `v` above it,
+    # top flange `o` above that, rear face `h` topmost -- the same vertical
+    # order as the blueprint (o top / v middle / u bottom).
+    _FACE_PRIORITY = {'u': 0, 'v': 1, 'o': 2, 'h': 3}
+    _FACE_GAP = 25.0
+
+    def _ensure_face_bands(self):
+        """Per-face Y-stack layout for multi-face parts (IPE/HEA/L ...).
+
+        Returns a list of ``(face, offset_y, ymin, ymax)`` bands when the
+        part has >= 2 faces with contours: the classic 2D view then draws
+        every face in its own horizontal band (like the blueprint) instead
+        of overlapping them at raw coordinates. Colours, sizes and hole
+        colours are NOT touched -- only the layout.
+
+        Single-face geometry (plates, DXF, one-contour parts) returns ``[]``
+        and keeps the exact historical behaviour.
+
+        Face order follows the blueprint unfold layout: ``u`` (bottom flange)
+        at the bottom, ``v`` (web) above it, ``o`` (top flange) above that,
+        ``h`` topmost -- the same vertical arrangement as the blueprint
+        (o top / v middle / u bottom).
+        """
+        if self._face_bands is not None or not self._geometry:
+            return self._face_bands or []
+        faces = [f for f in self._geometry.get('contour_faces', []) if f]
+        if len(set(faces)) < 2:
+            self._face_bands = []
+            return self._face_bands
+        ext = {}
+        for face, contour in zip(faces, self._geometry.get('contours', [])):
+            for x, y in contour:
+                b = ext.setdefault(face, [x, y, x, y])
+                if x < b[0]:
+                    b[0] = x
+                if y < b[1]:
+                    b[1] = y
+                if x > b[2]:
+                    b[2] = x
+                if y > b[3]:
+                    b[3] = y
+        # faces that only carry holes/slots (no contour) get their own band
+        for h in self._geometry.get('holes', []):
+            face = h.get('face') or 'v'
+            if face in ext:
+                continue
+            y = h.get('y', 0.0)
+            d = max(h.get('d') or 0.0, 1.0) / 2.0
+            ext[face] = [0.0, y - d, 0.0, y + d]
+        bands = []
+        off = 0.0
+        for face in sorted(ext, key=lambda f: self._FACE_PRIORITY.get(f, 9)):
+            b = ext[face]
+            ymin, ymax = b[1], b[3]
+            if ymax - ymin < 1e-9:
+                ymax = ymin + 1.0
+            bands.append((face, off, ymin, ymax))
+            off += (ymax - ymin) + self._FACE_GAP
+        self._face_bands = bands
+        return bands
+
+    def _explode_y(self, face, y):
+        """Raw DSTV y -> display y inside the face's band (identity when the
+        faces layout is inactive)."""
+        for f, off, ymin, _ymax in self._face_bands or ():
+            if f == face:
+                return off + (y - ymin)
+        return y
+
+    def _unexplode_y(self, display_y):
+        """Map exploded display y back to (face, local_y)."""
+        bands = self._ensure_face_bands()
+        if not bands:
+            return 'v', display_y
+        for f, off, ymin, ymax in bands:
+            h = ymax - ymin
+            if off <= display_y <= off + h + self._FACE_GAP:
+                local_y = ymin + (display_y - off)
+                local_y = max(ymin, min(ymax, local_y))
+                return f, local_y
+        # If outside bands, find the nearest band
+        nearest_f = 'v'
+        min_dist = float('inf')
+        local_y = display_y
+        for f, off, ymin, ymax in bands:
+            mid = off + (ymax - ymin) / 2.0
+            dist = abs(display_y - mid)
+            if dist < min_dist:
+                min_dist = dist
+                nearest_f = f
+                local_y = max(ymin, min(ymax, ymin + (display_y - off)))
+        return nearest_f, local_y
+
+    def _exploded_bounds(self):
+        """Display-space bounds of the stacked faces (x shared, y stacked)."""
+        bands = self._ensure_face_bands()
+        if not bands:
+            return None
+        xb = compute_bounds(self._geometry, margin=2.0)
+        if not xb:
+            return None
+        total = sum((ymax - ymin) for _, _o, ymin, ymax in bands) \
+            + self._FACE_GAP * (len(bands) - 1)
+        return (xb[0], 0.0, xb[2], total)
+
+    def _build_snap_targets(self):
+        """Snap targets from the current geometry (drawn coordinates).
+
+        With the faces layout active the targets are built in DISPLAY space
+        (each face translated into its band) so measure snapping hits exactly
+        what is drawn; single-face geometry keeps the raw coordinates.
+        """
+        if not self._geometry:
+            return SnapTargets()
+        bands = self._ensure_face_bands()
+        pts = []
+        segs = []
+        circles = []
+        arcs = []
+        if bands:
+            offs = {f: (off, ymin) for f, off, ymin, _ymax in bands}
+
+            def _dy(face, y):
+                o, ym = offs.get(face, (0.0, 0.0))
+                return o + (y - ym)
+
+            for face, contour in zip(
+                    self._geometry.get('contour_faces', []),
+                    self._geometry.get('contours', [])):
+                if not contour:
+                    continue
+                n = len(contour)
+                for i, (x, y) in enumerate(contour):
+                    pts.append((x, _dy(face, y)))
+                    nxt = contour[(i + 1) % n]
+                    segs.append(((x, _dy(face, y)), (nxt[0], _dy(face, nxt[1]))))
+            holes = self._geometry.get('holes', [])
+            c_faces = [h.get('face') or 'v' for h in holes
+                       if h.get('kind') == 'hole']
+            s_faces = [h.get('face') or 'v' for h in holes
+                       if h.get('kind') == 'slot']
+            for i, (x, y, d) in enumerate(self._geometry.get('circles', [])):
+                face = c_faces[i] if i < len(c_faces) else 'v'
+                r = max(d, 1e-9) / 2.0
+                circles.append((x, _dy(face, y), r))
+                arcs.append((x, _dy(face, y), r, 0.0, 360.0))
+            for i, slot in enumerate(self._geometry.get('slots', [])):
+                face = s_faces[i] if i < len(s_faces) else 'v'
+                d = slot[4] if len(slot) > 4 and slot[4] else (slot[2] or 0.0)
+                L = slot[5] if len(slot) > 5 else 0.0
+                ang = slot[6] if len(slot) > 6 else 0.0
+                overall = (L + d) if L > 0 else (d or 0.0)
+                if overall <= 0:
+                    continue
+                ssegs, s_arcs = stadium_rim(slot[0], _dy(face, slot[1]),
+                                            d, overall, ang)
+                segs.extend(ssegs)
+                arcs.extend(s_arcs)
+                circles.append((slot[0], _dy(face, slot[1]),
+                                max(d / 2.0, 1e-9)))
+            return SnapTargets(points=pts, segments=segs, circles=circles,
+                               arcs=arcs, insertion=(0.0, 0.0))
+        for contour in self._geometry.get('contours', []):
+            if not contour:
+                continue
+            n = len(contour)
+            for i, (x, y) in enumerate(contour):
+                pts.append((x, y))
+                nxt = contour[(i + 1) % n]
+                segs.append(((x, y), (nxt[0], nxt[1])))
+        for x, y, d in self._geometry.get('circles', []):
+            r = max(d, 1e-9) / 2.0
+            circles.append((x, y, r))
+            arcs.append((x, y, r, 0.0, 360.0))
+        for slot in self._geometry.get('slots', []):
+            d = slot[4] if len(slot) > 4 and slot[4] else (slot[2] or 0.0)
+            L = slot[5] if len(slot) > 5 else 0.0
+            ang = slot[6] if len(slot) > 6 else 0.0
+            overall = (L + d) if L > 0 else (d or 0.0)
+            if overall <= 0:
+                continue
+            ssegs, s_arcs = stadium_rim(slot[0], slot[1], d, overall, ang)
+            segs.extend(ssegs)
+            arcs.extend(s_arcs)
+            circles.append((slot[0], slot[1], max(d / 2.0, 1e-9)))
+        return SnapTargets(points=pts, segments=segs, circles=circles,
+                           arcs=arcs, insertion=(0.0, 0.0))
+
+    def snap_config(self):
+        """(enabled_snaps, tol, exact_band) from the design settings."""
+        if self._design is None:
+            from nccorrection.design.snaps import SNAP_KINDS
+            return set(SNAP_KINDS), 12.0, 0.0
+        return (self._design.enabled_snaps(), self._design.snap_tol(),
+                self._design.snap_exact_band())
+    def keyPressEvent(self, event):
+        if event.key() == Qt.Key_Escape and self.mode == 'measure':
+            # Echap: interruption/cancel the current measure point.
+            if self._m1 is not None:
+                self._m1 = None # Interruption/Cancel current measure point
+                self._hover_pt = None
+                self.update()
+            event.accept()
+            return
+        super().keyPressEvent(event)
+
+    # ---------------------------------------------------------------- theme
+    def set_theme(self, theme):
