+        fb._measurements.append((('v', 500.0, 145.0, 'centre'),
+                                 ('v', 11500.0, 145.0, 'centre'), 0.0))
+        s1, s2, p1, p2, _perp, _off = fb._measure_line_geometry(0)
+        self.assertIsNotNone(s1)
+        mid = QPointF((p1.x() + p2.x()) / 2, (p1.y() + p2.y()) / 2)
+        self.assertEqual(fb._measure_line_at(mid), 0)
+        fb.mousePressEvent(_press(mid.x(), mid.y()))
+        self.assertEqual(fb._dim_drag, 0)
+        # move PERPENDICULAR to the line: the parallel component does nothing
+        fb.mouseMoveEvent(_move(mid.x(), mid.y() - 15.0))
+        _s1, _s2, _p1, _p2, _perp2, dim_off = fb._measure_line_geometry(0)
+        self.assertNotAlmostEqual(dim_off, 0.0, delta=1e-6)
+        fb.mouseReleaseEvent(_release(mid.x(), mid.y() - 15.0))
+        self.assertIsNone(fb._dim_drag)
+        # the original measured points survive the drag
+        a, bpt, off = fb._measurements[0]
+        self.assertEqual(a[1], 500.0)
+        self.assertEqual(bpt[1], 11500.0)
+
+    def test_blueprint_clear_measurements(self):
+        fb = DstvRenderer2D()
+        fb.set_part(DstvParser().parse_text(LONG_BEAM))
+        fb._measurements.append((('v', 500.0, 145.0, 'centre'),
+                                 ('v', 11500.0, 145.0, 'centre'), 0.0))
