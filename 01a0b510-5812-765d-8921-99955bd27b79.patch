+class Test3DMiter(unittest.TestCase):
+    """A 45-degree web/flange end cut ('o'/'u' bevel + diagonal 'v' contour)
+    is a real miter plane in the 3D solid, on both flanges and the web."""
+
+    def test_45deg_miter_plane(self):
+        from nccorrection.core.part3d import build_model
+        model = build_model(IPE360_MITER)
+        self.assertTrue(model)
+        L, H, tf = 7870.0, 360.0, 12.7
+
+        def max_x(z):
+            return max(x for f in model for x, y, zz in f['pts']
+                       if abs(zz - z) < 1e-6)
+
+        # cut plane x = 7510 + z: bottom of beam cut back 360 mm ...
+        self.assertAlmostEqual(max_x(0.0), 7510.0, delta=0.05)
+        # ... top of bottom flange cut back 347.3 mm ...
+        self.assertAlmostEqual(max_x(tf), L - (H - tf), delta=0.05)
+        # ... bottom of top flange cut back 12.7 mm ...
+        self.assertAlmostEqual(max_x(H - tf), L - tf, delta=0.05)
+        # ... top surface untouched
+        self.assertAlmostEqual(max_x(H), L, delta=0.05)
+        # both flanges miter over exactly one flange thickness -> 45 deg
+        self.assertAlmostEqual(L - max_x(H - tf), tf, delta=0.05)
+        self.assertAlmostEqual(max_x(tf) - max_x(0.0), tf, delta=0.05)
