+    def test_slot_path_is_true_stadium_geometry(self):
+        """INJECTION 2: _build_slot_path must build a stadium (two semi-
+        circles joined by two straight lines) of overall length x diameter,
+        centred on the hole and rotating with the slot angle.
+
+        The function now takes the OVERALL slot length (the NC centre-to-
+        centre distance PLUS one diameter, as per the explicit B-Rep rule) so
+        the straight part between the two drill centres is ``overall - d`` and
+        a real NC slot (``length=18``, ``d=22``) is passed as ``18 + 22 = 40``.
+        """
+        # overall 60 (= centre-to-centre 40 + diameter 20) -> stadium 60 x 20
+        path = self.w._build_slot_path(100, 100, 20.0, 60.0, 0.0, 1.0)
+        br = path.boundingRect()
+        self.assertAlmostEqual(br.width(), 60.0, delta=1e-6)
+        self.assertAlmostEqual(br.height(), 20.0, delta=1e-6)
+        self.assertAlmostEqual(br.center().x(), 100.0, delta=1e-6)
+        self.assertAlmostEqual(br.center().y(), 100.0, delta=1e-6)
+        # 90 deg swings the length onto the vertical axis
+        br90 = self.w._build_slot_path(0, 0, 20.0, 60.0, 90.0, 1.0).boundingRect()
+        self.assertAlmostEqual(br90.width(), 20.0, delta=1e-6)
+        self.assertAlmostEqual(br90.height(), 60.0, delta=1e-6)
+        # overall == diameter degenerates to a plain circle of the diameter
+        brc = self.w._build_slot_path(0, 0, 20.0, 20.0, 0.0, 1.0).boundingRect()
+        self.assertAlmostEqual(brc.width(), 20.0, delta=1e-6)
+        self.assertAlmostEqual(brc.height(), 20.0, delta=1e-6)
+
+    def test_break_lines_constrained_to_face_height(self):
+        """INJECTION 3: each zig-zag must span only the face it cuts, not the
+        whole blueprint envelope."""
+        part = DstvParser().parse_text(LONG_BEAM)
+        self.w.set_part(part)
+        self.w.set_foreshorten(True)
+        self.w.set_unfold_mode(True)
+        offs, bounds, mapping = self.w._unfold_scene(part)
+        rect = self.w.rect()
+        scale, ox, oy = self.w._unfold_fit(rect, bounds)
+        marks = mapping.break_marks()
+        self.assertTrue(marks)
+        mid = (marks[0]['sx0'] + marks[0]['sx1']) / 2.0
+        amp = max(3.0, min(8.0, (marks[0]['sx1'] - marks[0]['sx0'])
+                           * scale / 4.0))
+        vb = self.w._face_box(part.get_face('v'))
+        ty = offs['v'][1]
+        y_top = oy - (ty + vb[3]) * scale
+        y_bot = oy - (ty + vb[1]) * scale
+        zig = self.w._zigzag_points(ox + mid * scale, y_top, y_bot, amp)
+        ys = [pt.y() for pt in zig]
+        # the zig-zag starts/ends exactly on the web face's projected edges
+        self.assertAlmostEqual(min(ys), y_top, delta=1e-6)
+        self.assertAlmostEqual(max(ys), y_bot, delta=1e-6)
+        # and is far smaller than the whole blueprint envelope
+        self.assertLess(y_bot - y_top,
+                        (bounds[3] - bounds[1]) * scale * 0.6)
+
+    def test_measure_returns_true_dstv_distance_across_void(self):
+        """Clicking across the hidden 11 000 mm void must report 11 600 mm."""
+        part = DstvParser().parse_text(LONG_BEAM)
+        self.w.set_part(part)
+        self.w.set_foreshorten(True)
+        self.w.set_unfold_mode(True)
+        cvs = self.w._snap_canvases()
+        tc = {c: t for c, _f, _s, t, _fc in cvs}
+        fc = {c: f for c, _f, _s, _t, f in cvs}
+        self.assertIn('v', tc)
+        a = tc['v'](200.0, 145.0)
+        b = tc['v'](11800.0, 145.0)
+        # the compressed screen span is far shorter than the real 11 600 mm
+        span = math.hypot(b[0] - a[0], b[1] - a[1])
+        self.assertLess(span, 500.0)
+        # from_canvas inverts back to the true physical coordinates
+        ra = fc['v'](*a)
+        rb = fc['v'](*b)
+        self.assertAlmostEqual(rb[0] - ra[0], 11600.0, delta=1e-3)
+        # the full measure-tool path snaps to real DSTV points and distances;
+        # the clicks land on the two web hole centres (real snap targets)
+        self.w.set_mode('measure')
+        code1, p1, k1, _d1 = self.w._snap_detail(
+            QPointF(*tc['v'](500.0, 145.0)))
+        code2, p2, k2, _d2 = self.w._snap_detail(
+            QPointF(*tc['v'](11500.0, 145.0)))
+        self.assertEqual(code1, 'v')
+        self.assertEqual(code2, 'v')
+        self.assertEqual(k1, 'centre')
+        self.assertEqual(k2, 'centre')
+        d = math.hypot(p2[0] - p1[0], p2[1] - p1[1])
+        self.assertAlmostEqual(d, 11000.0, delta=1e-3)
+
+    def test_measure_on_rear_web_reports_true_distance(self):
