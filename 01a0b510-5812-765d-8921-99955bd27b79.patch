@@ -0,0 +1,160 @@
+"""2026 modern collapsible Sidebar (shadcn/ui-inspired, native PySide6).
+
+A left-hand navigation shell hosting the primary app destinations:
+
+    [2D View]  [3D View]  [Blueprint]  [Steel Engine]
+
+The buttons are :class:`AnimatedButton` items (theme-aware, rounded
+``radius 7px``, animated hover/press, checked accent) with modern minimalist
+SVG icons resolved through :mod:`svg_icon` — the Owner supplies the final
+``rsc/icons/modern_*.svg`` artwork; until then the loader falls back to the
+matching PNG or a built-in placeholder glyph.
+
+A slim collapse control (top right of the bar) animates the sidebar between
+the full labelled width and a narrow icon-only rail, so the workspace keeps
+the web-app feel without stealing canvas real estate.
+
+Signals
+-------
+    nav_requested(key: str)   emitted with '2d' | '3d' | 'blueprint' |
+                              'steel' when a nav button is
+                              activated.
+    collapse_toggled(on: bool)
+"""
+
+from __future__ import annotations
+
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtWidgets import (QFrame, QHBoxLayout, QLabel, QPushButton,
+                               QVBoxLayout)
+
+from nccorrection.ui.components.modern_button import AnimatedButton
+from nccorrection.ui.components.scaling import sp
+from nccorrection.ui.components.svg_icon import load_icon
+from nccorrection.ui._colors import C
+
+# (key, translation-key, icon base name)
+_NAV_ITEMS = [
+    ('2d', 'viewer_2d', 'modern_view_2d'),
+    ('3d', 'viewer_3d', 'modern_view_3d'),
+    ('blueprint', 'blueprint', 'modern_blueprint'),
+    ('steel', 'steel_engine', 'modern_steel'),
+]
+
+_EXPANDED_W = 208
+_COLLAPSED_W = 60
+
+
+class AppSidebar(QFrame):
+    nav_requested = Signal(str)
+    collapse_toggled = Signal(bool)
+
+    def __init__(self, theme=None, tr=lambda s: s, parent=None):
+        super().__init__(parent)
+        self._theme = dict(theme) if theme else {}
+        self._tr = tr
+        self._collapsed = False
+        self._buttons = {}
+        self.setObjectName('appSidebar')
+        self.setFixedWidth(sp(_EXPANDED_W))
+        self.setAttribute(Qt.WA_StyledBackground, True)
+
+        outer = QVBoxLayout(self)
+        outer.setContentsMargins(sp(8), sp(10), sp(8), sp(10))
+        outer.setSpacing(sp(6))
+
+        # -- brand row ---------------------------------------------------
+        brand = QHBoxLayout()
+        brand.setSpacing(sp(6))
+        logo = QLabel('STEEL', self)
+        logo.setStyleSheet(self._text_css('accent', 'bold', 11))
+        brand.addWidget(logo)
+        brand.addStretch(1)
+        collapse = QPushButton('\u2039', self)   # ‹
+        collapse.setObjectName('sidebarCollapse')
+        collapse.setFixedSize(sp(24), sp(24))
+        collapse.setCursor(Qt.PointingHandCursor)
+        collapse.setToolTip(self._tr('sidebar_collapse'))
+        collapse.clicked.connect(self._toggle_collapsed)
+        brand.addWidget(collapse)
+        outer.addLayout(brand)
+        self._collapse_btn = collapse
+
+        outer.addSpacing(sp(4))
+
+        # -- nav buttons -------------------------------------------------
+        for key, tkey, icon_name in _NAV_ITEMS:
+            btn = AnimatedButton(self._tr(tkey), variant='ghost',
+                                 theme=self._theme, parent=self)
+            btn.setCheckable(True)
+            btn.setIcon(load_icon(icon_name))
+            btn.setMinimumHeight(sp(38))
+            btn.setFixedHeight(sp(38))
+            btn.clicked.connect(lambda _=False, k=key: self._nav(k))
+            self._buttons[key] = btn
+            outer.addWidget(btn)
+
+        outer.addStretch(1)
+
+        version = QLabel('2026', self)
+        version.setObjectName('mut')
+        version.setStyleSheet(self._text_css('mut', 'normal', 8))
+        version.setAlignment(Qt.AlignCenter)
+        outer.addWidget(version)
+
+        self._apply_theme_css()
+
+    # ---------------------------------------------------------------- style
+    def _text_css(self, color_key, weight, px):
+        c = self._theme.get(color_key, C.mut)
+        return (f'color:{c}; background:transparent; font-weight:{weight}; '
+                f'font-size:{px}pt;')
+
+    def _apply_theme_css(self):
+        bg = self._theme.get('panel', C.panel)
+        line = self._theme.get('line', C.line)
+        txt = self._theme.get('txt', C.txt)
+        self.setStyleSheet(
+            f'#appSidebar {{ background:{bg}; border:none; '
+            f'border-right:1px solid {line}; }}'
+            f'#sidebarCollapse {{ background:transparent; color:{txt}; '
+            f'border:1px solid {line}; border-radius:{sp(6)}px; }}'
+            f'#sidebarCollapse:hover {{ background:{self._theme.get("panel2", C.panel2)}; }}'
+            f'QToolTip {{ color:{txt}; background:{bg}; border:1px solid {line}; }}')
+
+    def set_theme(self, theme):
+        self._theme = dict(theme) if theme else {}
+        for b in self._buttons.values():
+            b.set_theme(self._theme)
+        self._apply_theme_css()
+
+    # ------------------------------------------------------------ behaviour
+    def _nav(self, key):
+        for k, b in self._buttons.items():
+            b.setChecked(k == key)
+        self.nav_requested.emit(key)
+
+    def select(self, key):
+        """Programmatically activate a nav item (keeps check state in sync)."""
+        if key in self._buttons:
+            self._nav(key)
+
+    def current(self):
+        for k, b in self._buttons.items():
+            if b.isChecked():
+                return k
+        return None
+
+    def set_collapsed(self, on):
+        self._collapsed = bool(on)
+        self.setFixedWidth(sp(_COLLAPSED_W if self._collapsed else _EXPANDED_W))
+        self._collapse_btn.setText('\u203a' if self._collapsed else '\u2039')
+        for b in self._buttons.values():
+            # label visible only when expanded (icon-only rail otherwise)
+            b.setText(self._tr(b.text()) if not self._collapsed else '')
+            b.setToolTip('' if self._collapsed else '')
+        self.collapse_toggled.emit(self._collapsed)
+        self.updateGeometry()
+
+    def _toggle_collapsed(self):
+        self.set_collapsed(not self._collapsed)
