+    def _setup_viewers(self):
+        """BOOTLOADER STEP 2 -- 2D/3D Render Engines + central workspace.
+
+        Idempotent (guarded) so _build() can assemble the same built workspace
+        without rebuilding the render engines / viewers twice.
+        """
+        if getattr(self, '_central_built', False):
+            return self._central_widget
+        self._central_widget = self._build_central()
+        self._central_built = True
+        return self._central_widget
