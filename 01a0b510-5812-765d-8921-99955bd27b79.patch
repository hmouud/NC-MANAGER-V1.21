+        edit_x = make_edit(current_x)
+        grid.addWidget(QLabel('X', dlg), r, 0)
+        grid.addWidget(edit_x, r, 1)
+        r += 1
+        abs_y = [current_y]
+
+        def on_y_changed():
+            mode = y_mode()
