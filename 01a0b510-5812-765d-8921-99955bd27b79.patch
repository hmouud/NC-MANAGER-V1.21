+"""Tests for interpreters/cut_interpreter.py."""
+import unittest
+from nccorrection.engine.contour.interpreters.cut_interpreter import CutInterpreter
+from nccorrection.engine.contour.models.profile_model import create_profile_model
+from nccorrection.engine.contour.models.cut_angles import CutAngles
+from nccorrection.engine.contour.core.enums import Face
+
+
+class TestCutInterpreter(unittest.TestCase):
+    def setUp(self):
+        self.model = create_profile_model(
+            "I",
+            [4500, 524, 306, 40, 21, 27, 270, 2.18, 38.621, 41.05, 0, 0],
+        )
+        self.angles = CutAngles(steg_front=38.621, steg_rear=41.05)
+        self.ci = CutInterpreter(self.model, self.angles)
+
+    def test_is_cut_present(self):
+        self.assertTrue(self.ci.is_cut_present)
+
+    def test_web_dispatch(self):
+        web_points = self.ci.compute(Face.V)
+        self.assertEqual(len(web_points), 2)
+
+    def test_flange_dispatch_no_cut(self):
+        flange_points = self.ci.compute(Face.O)
+        self.assertEqual(len(flange_points), 0)
+
+    def test_compute_all(self):
+        results = self.ci.compute_all()
+        self.assertIn(Face.V, results)
+        self.assertIn(Face.O, results)
+        self.assertIn(Face.U, results)
+        self.assertEqual(len(results[Face.V]), 2)
+        self.assertEqual(len(results[Face.O]), 0)
+
+    def test_web_interpreter_exposed(self):
+        self.assertIsNotNone(self.ci.web_interpreter)
+
+    def test_flange_interpreter_exposed(self):
+        self.assertIsNotNone(self.ci.flange_interpreter)
+
+
+class TestCutInterpreterNoCuts(unittest.TestCase):
+    def test_no_cuts(self):
+        model = create_profile_model("I", [4500, 524, 306, 40, 21, 27])
+        ci = CutInterpreter(model, CutAngles())
+        self.assertFalse(ci.is_cut_present)
+        for face, points in ci.compute_all().items():
+            self.assertEqual(len(points), 0)
