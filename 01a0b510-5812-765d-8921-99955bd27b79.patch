+class Test3DAxes(unittest.TestCase):
+    """F1 -- the orientation triad rotates with the model (Tekla style)."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_triad_default_view(self):
+        from nccorrection.ui.qt_viewer_3d import _rot_matrix
+        w = NcViewer3D()
+        w.resize(800, 500)
+        w._R = _rot_matrix(0.0, 0.01)
+        t = w._axis_triad()
+        # X right, Y up, Z ~horizontal at the default elevation
+        self.assertGreater(t['X'][0], 0.9)
+        self.assertAlmostEqual(t['X'][1], 0.0, delta=1e-6)
+        self.assertLess(t['Y'][1], -0.9)
+        self.assertAlmostEqual(t['Y'][0], 0.0, delta=1e-6)
+        self.assertAlmostEqual(t['Z'][0], 0.0, delta=1e-6)
+
+    def test_triad_rotates_with_model(self):
+        from nccorrection.ui.qt_viewer_3d import _rot_matrix, _mmul, \
+            _axis_angle_matrix
+        w = NcViewer3D()
+        w.resize(800, 500)
+        w._R = _rot_matrix(0.0, 0.01)
+        t1 = w._axis_triad()
+        # rotate the model 90 deg around the world Y axis -> the X/Z triad
+        # directions MUST change with it (this is the whole point); Y is the
+        # rotation axis itself, so it stays
+        w._R = _mmul(_axis_angle_matrix((0.0, 1.0, 0.0), math.pi / 2), w._R)
+        t2 = w._axis_triad()
+        # X world -> -Z world under a 90 deg Y-rotation: the triad directions
+        # change with the model (Z now points right, X almost vanished from
+        # the screen plane); Y is the rotation axis itself, so it stays
+        self.assertGreater(abs(t1['X'][0] - t2['X'][0]), 0.5)
+        self.assertGreater(abs(t1['Z'][0] - t2['Z'][0]), 0.5)
+        self.assertAlmostEqual(t2['Y'][1], t1['Y'][1], delta=1e-6)
+        # axes still render without crashing
+        w.set_geometry_object(MULTI_FACE)
+        w.grab()
+
+
+if __name__ == '__main__':
+    unittest.main()
