+class TestBoBlock(unittest.TestCase):
+    def setUp(self):
+        self.part = DstvParser().parse_text(SAMPLE)
+
+    def test_parse_bo_block(self):
+        holes = self.part.holes
+        self.assertEqual(len(holes), 4)
+        v_holes = [h for h in holes if h.face == 'v']
+        self.assertEqual(len(v_holes), 2)
+        self.assertAlmostEqual(v_holes[0].x, 200.00)
+        self.assertAlmostEqual(v_holes[0].y, 95.00)
+        self.assertAlmostEqual(v_holes[0].diameter, 18.00)
+        self.assertFalse(v_holes[0].is_slot)
