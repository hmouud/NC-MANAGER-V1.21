+            DstvParser().parse_text(f['text'])))
+        canvases = fv._snap_canvases()
+        self.assertTrue(canvases)
+        v_found = u_found = False
+        for code, face, scale, tc, fc in canvases:
+            if code == 'v':
+                v_found = True
+                sx, sy = tc(400.0, 145.0)
+                res = fv.dstv_point_at(sx, sy)
+                self.assertIsNotNone(res)
+                self.assertEqual(res[0], 'v')
+                self.assertAlmostEqual(res[1], 400.0, delta=1e-6)
+                self.assertAlmostEqual(res[2], 145.0, delta=1e-6)
+            elif code == 'u':
+                u_found = True
+                sx, sy = tc(100.0, 40.0)
+                res = fv.dstv_point_at(sx, sy)
+                self.assertIsNotNone(res)
+                self.assertEqual(res[0], 'u')
+                self.assertAlmostEqual(res[1], 100.0, delta=1e-6)
+                self.assertAlmostEqual(res[2], 40.0, delta=1e-6)
+        self.assertTrue(v_found)
+        self.assertTrue(u_found)
+        self.assertIsNone(fv.dstv_point_at(2.0, 2.0))
