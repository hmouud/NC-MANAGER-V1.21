+++ b/src/nccorrection/engine/steel_engine/catalog.py
@@ -0,0 +1,874 @@
+"""Steel profile catalogue — the *data foundation* of the Steel Engine.
+
+This module is a self-contained, dependency-free library of industrial
+steel profiles. It stores the canonical cross-section properties for the
+IPE, HEA, HEB, UPN, UPE and L (angle) ranges plus tubes and plates, and
+exposes dict-like lookup helpers that the Nesting engine, the 3D builder
+and the UI all consume through one single source of truth.
+
+Data provenance
+---------------
+The six legacy fields (``area`` mm², ``depth`` h mm, ``width`` b mm,
+``ix``/``iy`` in cm⁴) for IPE80–IPE600 are the published EN 10365 / Euronorm
+section properties (unchanged since the original catalogue — IPE300 still
+holds A=5380 mm², h=300 mm, b=150 mm, Ix=8360 cm⁴, Iy=604 cm⁴).
+
+The five fields added by CTO Option A (``web_thick``, ``flange_thick``,
+``root_radius``, ``wpl_x``, ``wpl_y``) follow the machine-readable steel
+knowledge base ``BOBA/KNOWLEDGE/PROFILES/IPE_STANDARDS.json`` (KNOW-009),
+cross-checked against the Owner's Mémotech 2009 extraction (KNOW-010):
+
+- web/flange thickness, root radius and plastic moduli (mm³) come from
+  KNOW-009 — precise EN 10365 / Orange Book figures.
+- ``IPE750x134`` is the modern EN 10365 variant (full row from KNOW-009).
+- ``IPE750x137`` is the Mémotech-era variant (h=753, b=263, tw=11.5,
+  tf=17.0 — from the KNOW-009 verification note; Mémotech 2009 itself only
+  lists the modern x147/x173/x196 series). Its area/Ix/Iy/Wpl are COMPUTED
+  from the nominal rectangular flange+web geometry (see
+  ``_ipe750x137_geometry``) because no verified published table was
+  available in-session. The Owner's Mémotech/NF A 45-209 table is the final
+  authority: replacing that row is a one-line edit.
+
+THE GRAND FUSION — Step 1 (catalogue completion, 2026-09-12 session):
+
+- ``_HEA_ROWS`` / ``_HEB_ROWS`` (24 rows each, kind ``'I'``) come from the
+  BOBA HEA/HEB tables (``BOBA/INDUSTRIAL/PROFILES/HEA.md``, ``HEB.md``),
+  cross-checked against published EN 10365 values and a physical
+  re-derivation from A/h/b/tw/tf. The BOBA ``iz`` (minor axis, cm⁴) values
+  are stored AS-IS — the breath-on-1e-4 rule confirmed them already in cm⁴
+  (HEA300 iz=6310, HEB300 iz=8563 match the published tables). ``wpl_x`` /
+  ``wpl_y`` = 0.0 because BOBA carries no Wpl tables for these series.
+- ``_UPN_ROWS`` / ``_UPE_ROWS`` (16 + 14 rows, kind ``'U'``) come from the
+  stad.fr section tables (HTML precision; UPE200/UPE400 keep the PDF-paper
+  anchor values for iz / wpl_y). UPN200 matches the app's own REAL UPN200
+  ST fixture (test_hole_edit_service) used by the DSTV parser hole flow:
+  dims = [L, 200, 75, 11.5, 8.5, 11.5, ...] — flange thickness at dims[3],
+  web thickness at dims[4], root radius at dims[5], exactly the order the
+  DSTV parser (``dstv_parser.py``) and ``_catalog_dims`` (file_factory)
+  write and read.
+- ``_L_ROWS`` (20 equal-leg angles, kind ``'L'``) come from the BOBA
+  L_ANGLES table (EN 10056-1) — area, Iy=Iz, t and r verified row by row.
+  The 20-row selection is a proposal pending the Owner's confirmation
+  (the full L_ANGLES table holds ~58 rows; the 20 chosen span L30x3 …
+  L200x20).
+
+Row layout is uniform across all rolled families — same 11 fields the IPE
+rows use: (name, area mm², depth mm, width mm, ix cm⁴, iy cm⁴, web_thick
+mm, flange_thick mm, root_radius mm, Wpl.x mm³, Wpl.y mm³). Adding any
+further series only requires a row table plus one registration loop.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, Iterator, List, Optional, Tuple
+
+_STEEL_DENSITY_KG_MM3 = 7850e-9  # 7850 kg/m³ = 7.85e-6 kg/mm³
+
+
+@dataclass(frozen=True)
+class SteelProfile:
+    """A single structural profile in the catalogue.
+
+    Units: ``area`` mm², ``depth`` mm, ``width`` mm, ``ix``/``iy`` cm⁴,
+    ``web_thick``/``flange_thick``/``root_radius`` mm, ``wpl_x``/``wpl_y``
+    mm³. ``weight_per_m`` (kg/m) is derived lazily from the density constant
+    so the raw table and the derived metric can never drift apart.
+    """
+
+    name: str                   # e.g. "IPE300"
+    area: float                 # A   [mm²]
+    depth: float                # h   [mm]
+    width: float                # b   [mm]
+    ix: float                   # Ix  [cm⁴]
+    iy: float                   # Iy  [cm⁴]
+    web_thick: float = 0.0      # tw  [mm]
+    flange_thick: float = 0.0   # tf  [mm]
+    root_radius: float = 0.0    # r   [mm]
+    wpl_x: float = 0.0          # Wpl.x [mm³]
+    wpl_y: float = 0.0          # Wpl.y [mm³]
+    kind: str = 'I'             # DSTV family letter: I beam | B plate | T tube
+                                # (extends later, Step 6: U channel, L angle, C)
+
+    @property
+    def weight_per_m(self) -> float:
+        """Linear mass in kg/m (7850 kg/m³ steel density).
+
+        Derived from the stored cross-sectional ``area`` for every family so
+        the raw table and the derived metric can never drift apart. For
+        plates the caller should compute weight from the user dimensions
+        (L·W·t·7.85) — see the Create/plate dialog — but ``area`` here holds
+        the nominal section area (width×thickness) used for display and for
+        the rolled-fallback weight chain.
+        """
+        return self.area * _STEEL_DENSITY_KG_MM3 * 1000.0
+
+    @property
+    def is_plate(self) -> bool:
+        """True for the plate family (weight computed from user dims)."""
+        return self.kind == 'B'
+
+    def __str__(self) -> str:  # pragma: no cover - cosmetic only
+        return (f'{self.name}: A={self.area:.0f}mm² h={self.depth:.0f}mm '
+                f'b={self.width:.0f}mm Ix={self.ix:.0f}cm⁴ Iy={self.iy:.0f}cm⁴')
+# --------------------------------------------------------------------------
+# IPE range (EN 10365 section-property reference values + Mémotech fields)
+# --------------------------------------------------------------------------
+# Row layout: (name, area mm², depth h mm, width b mm, Ix cm⁴, Iy cm⁴,
+#              web_thick mm, flange_thick mm, root_radius mm,
+#              Wpl.x mm³, Wpl.y mm³)
+# The 6 legacy values for IPE80–IPE600 are untouched; the 5 Mémotech fields
+# come from KNOW-009 (IPE_STANDARDS.json), verified against Mémotech 2009.
+_IPE_ROWS: List[Tuple[str, float, float, float, float, float,
+                      float, float, float, float, float]] = [
+    ('IPE80',     764.0,   80.0,   46.0,    80.1,     8.49,
+     3.8,  5.2,   5.0,    23200.0,    5600.0),
+    ('IPE100',   1030.0,  100.0,   55.0,   171.0,    15.9,
