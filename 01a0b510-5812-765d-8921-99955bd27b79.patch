+    def test_face_filtering(self):
+        for code, expected in (('v', 2), ('o', 1), ('u', 1), ('h', 0)):
+            face = self.part.get_face(code)
+            if expected:
+                self.assertIsNotNone(face)
+                self.assertEqual(len(face.holes), expected)
+            else:
+                self.assertIsNone(face)
+
+    def _parse_slot_line(self, bo_line):
+        text = (
+            'ST\n  B\n  1\n  1\n  P\n  P\n  S235JR\n  1\n  PL10\n'
+            '  1000.00\n  200.00\n  10.00\n'
+            'AK\n  v 0 0 1000 0 1000 200 0 200\n'
+            'BO\n  ' + bo_line + '\n'
+            'EN\n'
+        )
+        part = DstvParser().parse_text(text)
+        holes = part.holes
+        self.assertEqual(len(holes), 1)
+        return holes[0]
+
+    def test_angular_slot_no_marker(self):
