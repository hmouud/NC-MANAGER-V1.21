+"""enums.py — Enumerations for the Contour Engine.
+
+كل الـ Enums ديال المشروع ف بلاصة وحدة. type safety + zero magic strings.
+"""
+from __future__ import annotations
+from enum import Enum
+
+
+class ProfileKind(str, Enum):
+    """أكواد أنواع البروفيلات حسب DSTV/NC1."""
+    I = "I"      # I-beam (IPE/HEA/HEB/HEM/IPN)
+    U = "U"      # Channel (UPN/UPE)
+    L = "L"      # Angle
+    O = "O"      # Round tube (CHS)
+    T = "T"      # SHS/RHS
+    B = "B"      # Plate
+    FB = "FB"    # Flat Bar
+
+    @classmethod
+    def is_valid(cls, code: str) -> bool:
+        """كايتحقق واش الكود صالح بلا ما يرفع Exception."""
+        try:
+            cls(code.upper())
+            return True
+        except ValueError:
+            return False
+
+
+class Face(str, Enum):
+    """رموز الوجوه ف بلوك AK."""
+    V = "v"      # Web (Front)
+    O = "o"      # Top Flange
+    U = "u"      # Bottom Flange
+    H = "h"      # Back Web
+
+    @property
+    def is_web(self) -> bool:
+        """واش هاد الوجه ويب؟ (v ولا h)"""
+        return self in (Face.V, Face.H)
+
+    @property
+    def is_flange(self) -> bool:
+        """واش هاد الوجه فلانج؟ (o ولا u)"""
+        return self in (Face.O, Face.U)
+
+
+class PointSuffix(str, Enum):
+    """لواحق النقاط ف بلوك AK (من التحليل V3).
+    مؤكد من SDS/2 CNC PDF و Byndyusoft.DSTV.Net:
+      s = Start point, u = Continuation, w = Hole/Notch, t = Tangential Notch
+    """
+    S = "s"      # Start
+    U = "u"      # Continuation
+    W = "w"      # Hole/Notch
+    T = "t"      # Tangential Notch
+
+
+class CutSide(str, Enum):
+    """جهة القطع (للـ Debugging و التمييز)."""
+    FRONT = "front"
+    REAR = "rear"
