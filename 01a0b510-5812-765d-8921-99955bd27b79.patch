+"""Ribbon toolbar for Advanced Profile Creator.
+
+Standard CAD ribbon with SVG icons: File, Edit, Draw, Modify, Dim, Annotate, Tools.
+Uses load_icon() from ui/components/svg_icon.py for SVG icons.
+Uses C.* tokens from ui/_colors.py (no hardcoded colors).
+"""
+from __future__ import annotations
+
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtWidgets import QWidget, QHBoxLayout, QToolButton, QFrame, QMenu
+
+from nccorrection.ui._colors import C
+from nccorrection.ui.components.svg_icon import load_icon
+
+
+class RibbonToolbar(QWidget):
+    """Top ribbon toolbar with SVG icons for CAD operations.
+
+    Signals:
+        action_triggered(str): emitted when any ribbon action is clicked.
+            The string is the action name (e.g. 'Smart', 'Linear', 'Hole').
+    """
+
+    action_triggered = Signal(str)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setFixedHeight(40)
+        self.setStyleSheet(f"""
+            QWidget {{
+                background-color: {C.panel};
+                border-bottom: 1px solid {C.line};
+            }}
+            QToolButton {{
+                background-color: transparent;
+                color: {C.txt};
+                border: 1px solid transparent;
+                border-radius: 3px;
+                padding: 4px 8px;
+                font-size: 10px;
+                font-family: 'Arial';
+            }}
+            QToolButton:hover {{
+                background-color: {C.panel2};
+                border: 1px solid {C.line};
+            }}
+            QToolButton:pressed {{
+                background-color: {C.accent};
+                color: white;
+            }}
+        """)
+
+        layout = QHBoxLayout(self)
+        layout.setContentsMargins(8, 4, 8, 4)
+        layout.setSpacing(2)
+
+        # ── Ribbon buttons with SVG icons ──
+        ribbon_items = [
+            ("File", "folder-scan", ["New", "Open", "Save", "Export", "Add to Project"]),
+            ("Edit", "check-double", ["Undo", "Redo", "Cut", "Copy", "Paste"]),
+            ("Draw", "plus", ["Hole", "Slot", "Cut", "Line", "Circle", "Arc", "Rectangle"]),
+            ("Modify", None, ["Move", "Copy", "Rotate", "Mirror", "Delete"]),
+            ("Dim", None, ["Smart", "Linear", "Angular", "Radius", "Diameter", "Leader"]),
+            ("Annotate", None, ["Text", "Leader"]),
+            ("Tools", "settings", ["Drafting", "Snap"]),
+        ]
+
+        for label, icon_name, sub_items in ribbon_items:
+            btn = QToolButton()
+            btn.setText(label)
+            btn.setPopupMode(QToolButton.ToolButtonPopupMode.InstantPopup)
+
+            # Load SVG icon if available
+            if icon_name:
+                icon = load_icon(icon_name)
+                if not icon.isNull():
+                    btn.setIcon(icon)
+
+            # Build dropdown menu
+            menu = QMenu(btn)
+            menu.setStyleSheet(f"""
+                QMenu {{
+                    background-color: {C.panel};
+                    color: {C.txt};
+                    border: 1px solid {C.line};
+                }}
+                QMenu::item:selected {{
+                    background-color: {C.accent};
+                    color: white;
+                }}
+            """)
+            for item in sub_items:
+                action = menu.addAction(item)
+                # Connect each action to emit the signal with the item name
+                action.triggered.connect(
+                    lambda checked=False, name=item: self.action_triggered.emit(name))
+            btn.setMenu(menu)
+
+            layout.addWidget(btn)
+
+        layout.addStretch()
+
+        # ── Quick action buttons (right side) ──
+        for label, icon_name in [
+            ("Fit", None),
+            ("+", None),
+            ("-", None),
+            ("Grid", None),
+            ("Blueprint", None),
+        ]:
+            btn = QToolButton()
+            btn.setText(label)
+            if icon_name:
+                icon = load_icon(icon_name)
+                if not icon.isNull():
+                    btn.setIcon(icon)
+            btn.clicked.connect(
+                lambda checked=False, name=label: self.action_triggered.emit(name))
+            layout.addWidget(btn)
