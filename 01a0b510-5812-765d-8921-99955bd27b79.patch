+class TestPart3D(unittest.TestCase):
+    def test_profile_kind(self):
+        self.assertEqual(profile_kind('I'), 'prism')
+        self.assertEqual(profile_kind('L'), 'prism')
+        self.assertEqual(profile_kind('U'), 'prism')
+        self.assertEqual(profile_kind('B'), 'plate')
+        self.assertEqual(profile_kind(None), 'plate')
+
+    def test_rounded_beam_cross_section(self):
+        from nccorrection.core.part3d import cross_section_rounded
+        g = parse_geometry(BEAM_TEXT)
+        dims = g['st']['dims']
+        cs = cross_section_rounded('I', dims)  # IPE360 fillet r=18
+        self.assertIsNotNone(cs)
+        ys = [p[0] for p in cs]
+        zs = [p[1] for p in cs]
+        self.assertAlmostEqual(min(ys), -85.0)
+        self.assertAlmostEqual(max(ys), 85.0)
+        self.assertAlmostEqual(min(zs), 0.0)
+        self.assertAlmostEqual(max(zs), 360.0)
+        # the four inner corners are blended: the web/flange tangent points
+        # of the fillet exist (bottom-right: (hw+r, tf) and (hw, tf+r))
+        self.assertIn((4.0 + 18.0, 12.7), cs)
+        self.assertIn((4.0, 12.7 + 18.0), cs)
+        # every fillet interior point sits on the arc circle
+        import math
+        c = (4.0 + 18.0, 12.7 + 18.0)
+        for p in cs:
+            if 4.0 < p[0] < 22.0 and 12.7 < p[1] < 30.7:
+                self.assertAlmostEqual(math.hypot(p[0] - c[0], p[1] - c[1]),
+                                       18.0, places=6)
+        # a beam without a fillet radius keeps the plain sharp polygon
+        from nccorrection.core.part3d import cross_section
+        sharp = cross_section('I', [6000, 300, 150, 10.0, 6.0])
+        self.assertEqual(len(sharp), 12)
+        self.assertIsNone(cross_section_rounded('I', [6000, 300, 150, 10.0, 6.0]))
+
+    def test_plain_beam_model_has_fillets(self):
+        g = parse_geometry(BEAM_TEXT)
+        model = build_model(g)
+        pts = [p for f in model for p in f['pts']]
+        # the rounded web-flange corner is really in the solid: a vertex with
+        # y between web half-width (4) and web+fillet (22) at a height above
+        # the bottom flange (tf=12.7)
+        self.assertTrue(any(4.5 < abs(y) < 21.5 and 13.0 < z < 29.5
+                            for x, y, z in pts),
