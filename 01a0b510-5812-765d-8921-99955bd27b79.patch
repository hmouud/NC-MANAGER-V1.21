+    # ────────────────────────────────────────────────────────────────
+    # Profile Change & NC1 Generation (State & Catalog & Template)
+    # ────────────────────────────────────────────────────────────────
+
+    def _current_profile_dims(self) -> Dict[str, float]:
+        """Return dict with h, b, tw, tf of currently selected profile."""
+        profile_name = self.state_ctrl.state.profile.profile_name
+        try:
+            from nccorrection.engine.steel_engine.catalog import get_profile
+            p = get_profile(profile_name)
+            if p:
+                return {'h': p.depth, 'b': p.width, 'tw': p.web_thick, 'tf': p.flange_thick}
+        except Exception:
+            pass
+        return {
+            'h': self.state_ctrl.state.profile.height or 240.0,
+            'b': self.state_ctrl.state.profile.width or 120.0,
+            'tw': self.state_ctrl.state.profile.web or 6.2,
+            'tf': self.state_ctrl.state.profile.flange or 9.8,
+        }
+
+    def _update_canvas_preview(self) -> None:
+        """Generate NC1 text from current state (using template or parametric) and update canvas."""
+        profile_name = self.state_ctrl.state.profile.profile_name
+        length = self.state_ctrl.state.profile.length
+        material = self.state_ctrl.state.profile.material
+        if not profile_name:
+            return
+
+        try:
+            from nccorrection.engine.steel_engine.catalog import get_profile
+            profile = get_profile(profile_name)
+            if profile is None:
+                return
+
+            self.state_ctrl.set_profile_dims(
+                profile.width, profile.depth,
+                profile.web_thick, profile.flange_thick,
+            )
+
+            all_features = self.state_ctrl.get_all_features()
+
+            from nccorrection.engine.profile_catalog.nc1_template import (
+                get_template, generate_nc1_from_template,
+            )
+            tmpl = get_template(profile_name)
+
+            self.left_panel.update_profile_info(profile, has_template=(tmpl is not None))
+
+            p_state = self.state_ctrl.state.profile
+            cut_angles_dict = {
+                'steg_front': p_state.angle_steg_front,
+                'steg_rear': p_state.angle_steg_rear,
+                'flange_front': p_state.angle_flange_front,
+                'flange_rear': p_state.angle_flange_rear,
+            }
+
+            if tmpl is not None:
+                # ── Route 1: Pre-made exact NC1 Template ──
+                nc1_text = generate_nc1_from_template(
+                    tmpl,
+                    length,
+                    steel_grade=material,
+                    holes=all_features,
+                    cut_angles=cut_angles_dict,
+                )
+            else:
+                # ── Route 2: Parametric Contour Generator + BO injection ──
+                dims = [
+                    length,
+                    profile.depth,
+                    profile.width,
+                    profile.flange_thick,
+                    profile.web_thick,
+                    profile.root_radius,
+                    getattr(profile, 'weight_per_m', 0.0) or 0.0,
+                    0.0,
+                    p_state.angle_steg_front,
+                    p_state.angle_steg_rear,
+                    p_state.angle_flange_front,
+                    p_state.angle_flange_rear,
+                ]
+
+                from nccorrection.engine.contour import generate_nc1
+                base_nc1 = generate_nc1(
+                    dims=dims,
+                    kind_code=profile.kind,
+                    profile_name=profile.name,
+                    steel_grade=material,
+                )
+
+                if all_features and base_nc1:
+                    from nccorrection.core.nc1_writer import apply_hole_edits
+                    nc1_text = apply_hole_edits(base_nc1, {}, add_holes=all_features)
+                else:
+                    nc1_text = base_nc1
+
+            # ── Route 3: Inject Cuts & Notches (IK blocks) ──
+            cuts = self.state_ctrl.get_cuts()
+            if cuts and nc1_text:
+                nc1_text = apply_cuts_to_nc1(nc1_text, cuts)
+
+            if nc1_text:
+                self._current_nc1_text = nc1_text
+                self.canvas.set_geometry(nc1_text)
+                if hasattr(self.canvas, 'set_holes'):
+                    self.canvas.set_holes(all_features)
+        except Exception as e:
+            self.status_label.setText(f"Error updating preview: {e}")
+
+    # ────────────────────────────────────────────────────────────────
+    # Ribbon Action Dispatcher
+    # ────────────────────────────────────────────────────────────────
+
+    def _on_ribbon_action(self, name: str) -> None:
+        dim_map = {
+            'Smart': self._on_dim_smart,
+            'Linear': self._on_dim_linear,
+            'Angular': self._on_dim_angular,
+            'Radius': self._on_dim_radius,
+            'Diameter': self._on_dim_diameter,
+            'Leader': self._on_dim_leader,
+        }
+        if name in dim_map:
+            dim_map[name]()
+            return
+
+        draw_map = {
+            'Hole': self._on_add_hole,
+            'Slot': self._on_add_slot,
+            'Cut': self._on_create_cut,
+            'RectCut': self._on_create_cut,
+        }
+        if name in draw_map:
+            draw_map[name]()
+            return
+
+        view_map = {
+            'Fit': self._on_zoom_fit,
+            'Grid': self._on_toggle_grid,
+        }
+        if name in view_map:
+            view_map[name]()
+            return
+
+        if name == 'Add to Project':
+            self._on_add_to_project()
+            return
