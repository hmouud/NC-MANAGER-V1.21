new file mode 100644
index 0000000..3c167f9
--- /dev/null
+++ b/src/nccorrection/ui/components/custom_header.py
@@ -0,0 +1,234 @@
+from __future__ import annotations
+
+try:
+    from PySide6.QtWidgets import (
+        QHeaderView, QDialog, QVBoxLayout, QHBoxLayout,
+        QLineEdit, QListWidget, QListWidgetItem, QPushButton,
+        QFrame, QLabel
+    )
+    from PySide6.QtGui import QAction
+    from PySide6.QtCore import Qt, Signal, QPoint
+except ImportError:
+    # Headless / mock fallback for testing without PySide6
+    class QHeaderView:
+        pass
+    class Signal:
+        def __init__(self, *args): pass
+        def emit(self, *args): pass
+    class Qt:
+        Horizontal = 1
+        Popup = 2
+        Checked = 2
+        Unchecked = 0
+        ItemIsUserCheckable = 1
+        ItemIsEnabled = 2
+    class QPoint:
+        def __init__(self, x, y): pass
+
+from nccorrection.ui._colors import C
+
+
+class ColumnFilterPopup(QDialog):
+    """Compact, scrollable Excel-style filter popup with instant search box."""
+
+    def __init__(self, values: list, selected: set, parent=None):
+        super().__init__(parent, Qt.Popup | Qt.FramelessWindowHint)
+        self.setAttribute(Qt.WA_DeleteOnClose, True)
+        self._all_values = [str(v) for v in values]
+        self._selected = set(str(s) for s in selected)
+        self._result_selected = None
+
+        self.setFixedWidth(240)
+        self.setStyleSheet(f"""
+            QDialog {{
+                background-color: {C.panel};
+                border: 1px solid {C.line};
+                border-radius: 6px;
+            }}
+            QLineEdit {{
+                background-color: {C.bg};
+                color: {C.txt};
+                border: 1px solid {C.line};
+                border-radius: 4px;
+                padding: 4px 8px;
+                font-size: 11px;
+            }}
+            QLineEdit:focus {{
+                border-color: {C.accent};
+            }}
+            QListWidget {{
+                background-color: {C.bg};
+                color: {C.txt};
+                border: 1px solid {C.line};
+                border-radius: 4px;
+                padding: 2px;
+                font-size: 11px;
+            }}
+            QListWidget::item {{
+                padding: 3px;
+                border-radius: 2px;
+            }}
+            QListWidget::item:hover {{
+                background-color: {C.panel2};
+            }}
+            QPushButton {{
+                background-color: {C.card};
+                color: {C.txt};
+                border: 1px solid {C.line};
+                border-radius: 3px;
+                padding: 3px 8px;
+                font-size: 10px;
+            }}
+            QPushButton:hover {{
+                background-color: {C.accent};
+                color: white;
+            }}
+        """)
+
+        layout = QVBoxLayout(self)
+        layout.setContentsMargins(8, 8, 8, 8)
+        layout.setSpacing(6)
+
+        # Search box
+        self.search_edit = QLineEdit(self)
+        self.search_edit.setPlaceholderText("Search...")
+        self.search_edit.textChanged.connect(self._on_search_changed)
+        layout.addWidget(self.search_edit)
+
+        # Quick actions (Select All / Clear)
+        btn_row = QHBoxLayout()
+        btn_row.setSpacing(4)
+        self.btn_select_all = QPushButton("Select All", self)
+        self.btn_select_all.clicked.connect(self._select_all)
+        btn_row.addWidget(self.btn_select_all)
+
+        self.btn_clear = QPushButton("Clear", self)
+        self.btn_clear.clicked.connect(self._clear_all)
+        btn_row.addWidget(self.btn_clear)
+        layout.addLayout(btn_row)
+
+        # Scrollable list of checkboxes
+        self.list_widget = QListWidget(self)
+        self.list_widget.setFixedHeight(180)
+        self.list_widget.itemChanged.connect(self._on_item_changed)
+        layout.addWidget(self.list_widget)
+
+        # Populate initial list
+        self._populate_list(self._all_values)
+
+        # OK / Cancel bottom buttons
+        bottom_row = QHBoxLayout()
+        bottom_row.addStretch()
+        self.btn_ok = QPushButton("Apply", self)
+        self.btn_ok.setStyleSheet(f"background-color: {C.accent}; color: white; font-weight: bold;")
+        self.btn_ok.clicked.connect(self._on_apply)
+        bottom_row.addWidget(self.btn_ok)
+
+        self.btn_cancel = QPushButton("Cancel", self)
+        self.btn_cancel.clicked.connect(self.reject)
+        bottom_row.addWidget(self.btn_cancel)
+        layout.addLayout(bottom_row)
+
+    def _populate_list(self, items: list[str]):
+        self.list_widget.blockSignals(True)
+        self.list_widget.clear()
+        for val in items:
+            item = QListWidgetItem(str(val), self.list_widget)
+            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
+            is_checked = val in self._selected if self._selected else False
+            item.setCheckState(Qt.Checked if is_checked else Qt.Unchecked)
+        self.list_widget.blockSignals(False)
+
+    def _on_search_changed(self, text: str):
+        query = text.strip().lower()
+        filtered = [v for v in self._all_values if query in v.lower()]
+        self._populate_list(filtered)
+
+    def _on_item_changed(self, item: QListWidgetItem):
+        val = item.text()
+        if item.checkState() == Qt.Checked:
+            self._selected.add(val)
+        else:
+            self._selected.discard(val)
+
+    def _select_all(self):
+        self.list_widget.blockSignals(True)
+        for i in range(self.list_widget.count()):
+            item = self.list_widget.item(i)
+            item.setCheckState(Qt.Checked)
+            self._selected.add(item.text())
+        self.list_widget.blockSignals(False)
+
+    def _clear_all(self):
+        self.list_widget.blockSignals(True)
+        for i in range(self.list_widget.count()):
+            item = self.list_widget.item(i)
+            item.setCheckState(Qt.Unchecked)
+            self._selected.discard(item.text())
+        self.list_widget.blockSignals(False)
+
+    def _on_apply(self):
+        self._result_selected = set(self._selected)
+        self.accept()
+
+    def get_selected(self) -> set:
+        return self._result_selected if self._result_selected is not None else self._selected
+
+
+class ExcelFilterHeader(QHeaderView):
+    """Excel-style filter header with robust compact scrollable search popup.
+
+    Emits filter_changed(column_index, selected_values) when a filter is applied.
+    """
+
+    filter_changed = Signal(int, list)  # column index, list of selected values
+
+    def __init__(self, parent=None):
+        super().__init__(Qt.Horizontal, parent)
+        self.setSectionsClickable(True)
+        self._active_filters = {}  # col_index -> set of selected values
+        self.sectionClicked.connect(self._on_section_clicked)
+
+    def update_filter_data(self, col_index, unique_values):
+        """Provide the column's unique values for the filter popup."""
+        self._active_filters[col_index] = {
+            'values': list(unique_values),
+            'selected': set()
+        }
+
+    def _on_section_clicked(self, logicalIndex):
+        if logicalIndex not in self._active_filters:
+            return
+
+        data = self._active_filters[logicalIndex]
+        values = data['values']
+        selected = data['selected']
+
+        popup = ColumnFilterPopup(values, selected, self)
+        
+        # Position popup directly under the column header
+        rect = self.sectionViewportPosition(logicalIndex)
+        global_pos = self.mapToGlobal(QPoint(rect, 0))
+        y = global_pos.y() + self.height()
+        x = global_pos.x()
+        popup.move(x, y)
+
+        if popup.exec():
+            new_selected = popup.get_selected()
+            self._active_filters[logicalIndex]['selected'] = new_selected
+            self.filter_changed.emit(logicalIndex, list(new_selected))
+            self.viewport().update()
+
+    def _set_selection(self, col_index, values):
+        self._active_filters[col_index]['selected'] = set(values) if values else set()
+        self.filter_changed.emit(
+            col_index, list(self._active_filters[col_index]['selected'])
+        )
+        self.viewport().update()
+
+    def get_filters(self):
+        """Return dict of column_index -> set of selected values."""
+        result = {}
+        for col_idx, data in self._active_filters.items():
+            result[col_idx] = data['selected']
+        return result
