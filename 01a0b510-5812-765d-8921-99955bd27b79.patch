+"""Tabbed Drafting Settings dialog (the UI control centre).
+
+An isolated, AutoCAD-style ``QDialog`` whose tabs bind *live* to the single
+:class:`~nccorrection.design.settings.DesignSettings` object owned by the main
+window. Because the Measure toolbar, the OSNAP engine and every viewer already
+operate on that same object, every edit made here is instantly visible in the
+right-click measure menu, the snap resolution and the renderers - a real
+two-way sync:
+
+    Dialog control -> DesignSettings -> toolbar.refresh_tooltip() / engine
+
+Tab 1  OSNAP: a master "Enable OSNAP" switch and a per-kind grid of snap types.
+Tab 2  Display & Dimensions: snap-marker colour/size and dimension text scale.
+
+Signals:
+    changed()  some option was edited; the app should save + refresh views.
+"""
+
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtWidgets import (
+    QDialog, QVBoxLayout, QHBoxLayout, QFormLayout, QTabWidget, QWidget,
+    QCheckBox, QSlider, QLabel, QComboBox, QPushButton, QGroupBox, QGridLayout,
+)
+
+from nccorrection.design.snaps import SNAP_KINDS
+from nccorrection.design.theme import snap_label
+
+SNAP_MARKER_COLORS = [
+    ('#3cb371', 'drafting_color_green'),
+    ('#22d3ee', 'drafting_color_cyan'),
+    ('#fbbf24', 'drafting_color_amber'),
+    ('#f472b6', 'drafting_color_pink'),
+    ('#a78bfa', 'drafting_color_violet'),
+]
+
+
+class DraftingSettingsDialog(QDialog):
+    """Two-tab modal whose controls are two-way bound to DesignSettings."""
+
+    changed = Signal()
+    committed = Signal()
+
+    def __init__(self, design, tr_=None, parent=None):
+        super().__init__(parent)
+        self._design = design
+        self._tr = tr_ or (lambda key: key)
+        self._snap_checks = {}
+        self.setObjectName('draftingDialog')
+        self.setWindowTitle(self._tr('drafting_settings'))
+        self.setModal(True)
+        self.setMinimumWidth(440)
+
+        root = QVBoxLayout(self)
+        root.setContentsMargins(12, 12, 12, 12)
+        root.setSpacing(10)
+
+        tabs = QTabWidget(self)
+        tabs.addTab(self._build_snap_tab(), self._tr('drafting_tab_snaps'))
+        tabs.addTab(self._build_display_tab(), self._tr('drafting_tab_display'))
+        root.addWidget(tabs)
+
+        actions = QHBoxLayout()
+        actions.addStretch(1)
+        restore = QPushButton(self._tr('drafting_restore'))
+        restore.clicked.connect(self._restore_defaults)
+        cancel_btn = QPushButton(self._tr('drafting_cancel'))
+        cancel_btn.clicked.connect(self._cancel)
+        apply_btn = QPushButton(self._tr('drafting_apply'))
+        apply_btn.clicked.connect(self._apply)
+        ok_btn = QPushButton(self._tr('drafting_ok'))
+        ok_btn.setDefault(True)
+        ok_btn.setObjectName('primaryBtn')
+        ok_btn.clicked.connect(self._ok)
+        for b in (restore, cancel_btn, apply_btn, ok_btn):
+            actions.addWidget(b)
+        root.addLayout(actions)
+        self._baseline = self._design.snapshot()
+
+    # ------------------------------------------------------------ OSNAP tab
+    def _build_snap_tab(self):
+        """Master OSNAP switch + a grid of the individual snap kinds + tol."""
+        page = QWidget()
+        outer = QVBoxLayout(page)
+        outer.setContentsMargins(4, 8, 4, 8)
+        outer.setSpacing(8)
+
+        self._osnap_master = QCheckBox(self._tr('drafting_enable_osnap'))
+        self._osnap_master.toggled.connect(self._on_osnap_master)
+        outer.addWidget(self._osnap_master)
+
+        grp = QGroupBox(self._tr('drafting_tab_snaps'))
+        grid = QGridLayout(grp)
+        grid.setHorizontalSpacing(16)
+        grid.setVerticalSpacing(6)
+        for i, kind in enumerate(SNAP_KINDS):
+            check = QCheckBox(snap_label(kind), grp)
+            check.toggled.connect(
+                lambda on, k=kind: (self._design.set_snap(k, bool(on)),
+                                    self.changed.emit()))
+            self._snap_checks[kind] = check
+            grid.addWidget(check, i // 2, i % 2)
+        self._snap_grid = grp
+        outer.addWidget(grp)
+
+        self._tol_slider = QSlider(Qt.Horizontal)
+        self._tol_slider.setRange(1, 50)
+        self._tol_slider.valueChanged.connect(self._on_tol)
+        self._tol_value = QLabel('0 px')
+        self._tol_value.setMinimumWidth(48)
+        tol_inner = QHBoxLayout()
+        tol_inner.addWidget(self._tol_slider, 1)
+        tol_inner.addWidget(self._tol_value)
+        form = QFormLayout()
+        form.addRow(self._tr('drafting_snap_tol'), tol_inner)
+        outer.addLayout(form)
+        outer.addStretch(1)
+        return page
+
+    # --------------------------------------------------- Display & Dimensions
+    def _build_display_tab(self):
+        """Marker colour/size, dimension scale, guides and draft options."""
+        page = QWidget()
+        outer = QVBoxLayout(page)
+        outer.setContentsMargins(4, 8, 4, 8)
+        outer.setSpacing(8)
+
+        grp = QGroupBox(self._tr('drafting_tab_display'))
+        form = QFormLayout(grp)
+        form.setSpacing(8)
+
+        self._color_combo = QComboBox(grp)
+        for hex_c, key in SNAP_MARKER_COLORS:
+            self._color_combo.addItem(self._tr(key), hex_c)
+        self._color_combo.currentIndexChanged.connect(self._on_color)
+
+        self._size_slider = QSlider(Qt.Horizontal, grp)
+        self._size_slider.setRange(60, 180)
+        self._size_value = QLabel('1.0x')
+        size_inner = QHBoxLayout()
+        size_inner.addWidget(self._size_slider, 1)
+        size_inner.addWidget(self._size_value)
+        rows = [(self._tr('drafting_marker_color'), self._color_combo),
+                (self._tr('drafting_marker_size'), size_inner)]
+
+        self._dim_slider = QSlider(Qt.Horizontal, grp)
+        self._dim_slider.setRange(60, 180)
+        self._dim_value = QLabel('1.0x')
+        dim_inner = QHBoxLayout()
+        dim_inner.addWidget(self._dim_slider, 1)
+        dim_inner.addWidget(self._dim_value)
+        rows.append((self._tr('drafting_dimension_scale'), dim_inner))
+
+        self._size_slider.valueChanged.connect(self._on_size)
+        self._dim_slider.valueChanged.connect(self._on_dim)
+
+        self._ortho_chk = QCheckBox(grp)
+        self._flip_x_chk = QCheckBox(grp)
+        self._flip_y_chk = QCheckBox(grp)
+        self._rotate_combo = QComboBox(grp)
+        for value, key in ((0, 'drafting_rotate_0'), (90, 'drafting_rotate_90'),
+                           (180, 'drafting_rotate_180'), (270, 'drafting_rotate_270')):
+            self._rotate_combo.addItem(self._tr(key), value)
+        rows += [(self._tr('drafting_show_ortho'), self._ortho_chk),
+                 (self._tr('drafting_flip_x'), self._flip_x_chk),
+                 (self._tr('drafting_flip_y'), self._flip_y_chk),
+                 (self._tr('drafting_rotate'), self._rotate_combo)]
+        for name, widget in rows:
+            form.addRow(name, widget)
+        outer.addWidget(grp)
+
+        self._ortho_chk.toggled.connect(
+            lambda on: (self._design.set_show_ortho(bool(on)), self.changed.emit()))
+        self._flip_x_chk.toggled.connect(
+            lambda on: (self._design.set_flip_x(bool(on)), self.changed.emit()))
+        self._flip_y_chk.toggled.connect(
+            lambda on: (self._design.set_flip_y(bool(on)), self.changed.emit()))
+        self._rotate_combo.currentIndexChanged.connect(self._on_rotate)
+        outer.addStretch(1)
+        return page
+
+    # ------------------------------------------------------------- binding
+    def _reload(self):
+        """Push the current settings into every widget (signal-guarded)."""
+        self._osnap_master.blockSignals(True)
+        self._osnap_master.setChecked(self._design.osnap_enabled())
+        self._osnap_master.blockSignals(False)
+        self._set_snap_grid_enabled(self._design.osnap_enabled())
+
+        for kind, check in self._snap_checks.items():
+            check.blockSignals(True)
+            check.setChecked(self._design.snap_enabled(kind))
+            check.blockSignals(False)
+        self._tol_slider.blockSignals(True)
+        self._tol_slider.setValue(round(self._design.snap_tol()))
+        self._tol_slider.blockSignals(False)
+        self._tol_value.setText(f'{self._design.snap_tol():.0f} px')
+
+        idx = self._color_combo.findData(self._design.snap_badge_color())
+        self._color_combo.blockSignals(True)
+        self._color_combo.setCurrentIndex(max(0, idx))
+        self._color_combo.blockSignals(False)
+
+        self._size_slider.blockSignals(True)
+        self._size_slider.setValue(round(self._design.snap_badge_size() * 100))
+        self._size_slider.blockSignals(False)
+        self._size_value.setText(f'{self._design.snap_badge_size():.1f}x')
+
+        self._dim_slider.blockSignals(True)
+        self._dim_slider.setValue(round(self._design.dimension_scale() * 100))
+        self._dim_slider.blockSignals(False)
+        self._dim_value.setText(f'{self._design.dimension_scale():.1f}x')
+
+        for source, chk in ((self._design.show_ortho(), self._ortho_chk),
+                            (self._design.flip_x(), self._flip_x_chk),
+                            (self._design.flip_y(), self._flip_y_chk)):
+            chk.blockSignals(True)
+            chk.setChecked(source)
+            chk.blockSignals(False)
+
+        idx = self._rotate_combo.findData(self._design.rotate())
+        self._rotate_combo.blockSignals(True)
+        self._rotate_combo.setCurrentIndex(max(0, idx))
+        self._rotate_combo.blockSignals(False)
+
+    def _set_snap_grid_enabled(self, on):
+        for check in self._snap_checks.values():
+            check.setEnabled(bool(on))
+
+    # ---------------------------------------------------------------- binds
+    def _on_osnap_master(self, on):
+        self._design.set_osnap_enabled(bool(on))
+        self._set_snap_grid_enabled(on)
+        self.changed.emit()
+
+    def _on_tol(self, value):
+        self._tol_value.setText(f'{value} px')
+        self._design.set_snap_tol(value)
+        self.changed.emit()
+
+    def _on_color(self):
+        self._design.set_snap_badge_color(self._color_combo.currentData())
+        self.changed.emit()
+
+    def _on_size(self, value):
+        scale = value / 100.0
+        self._size_value.setText(f'{scale:.1f}x')
+        self._design.set_snap_badge_size(scale)
+        self.changed.emit()
+
+    def _on_dim(self, value):
+        scale = value / 100.0
+        self._dim_value.setText(f'{scale:.1f}x')
+        self._design.set_dimension_scale(scale)
+        self.changed.emit()
+
+    def _on_rotate(self):
+        self._design.set_rotate(self._rotate_combo.currentData())
+        self.changed.emit()
+
+    def _restore_defaults(self):
+        self._design.reset()
+        self._reload()
+        self.changed.emit()
+
+    def _apply(self):
+        """Persist the current in-memory options and re-base the snapshot."""
+        self._design.persist()
+        self._baseline = self._design.snapshot()
+        self.committed.emit()
+
+    def _ok(self):
+        self._apply()
+        self.accept()
+
+    def _cancel(self):
+        """Discard every edit made since the dialog opened and revert."""
+        self._design.restore_snapshot(self._baseline)
+        self.changed.emit()
+        self.reject()
+
+    def showEvent(self, event):
+        """Snapshot the state and re-sync widgets when the dialog opens."""
+        self._baseline = self._design.snapshot()
+        self._reload()
+        super().showEvent(event)
