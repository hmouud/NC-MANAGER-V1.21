@@ -0,0 +1,179 @@
+import json, os
+
+PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
+SETTINGS_DIR = os.path.join(PROJECT_ROOT, 'settings')
+
+DEFAULT_SETTINGS = {
+    'language': 'en',
+    'theme': 'industrial-dark',
+    'mode': 'MOVE',
+    'outputMode': 'SAME_FOLDER',
+    'outputName': 'output',
+    'outputPath': '',
+    'organizeOriginalAction': 'KEEP',
+    'auditEnabled': True,
+    'panels': {'classification': True, 'viewer': True, 'logs': True, 'preview': True},
+    'viewOpts': {'2d_grid': True, '2d_axes': True, '2d_cotation': False,
+                 '2d_unfold': False, '2d_blueprint': False, '3d_legend': False,
+                 '3d_section': False, '3d_wire': False, '3d_spin': False},
+    'beginnerHelp': False,
+    'siEnMode': 'ask',
+    'themeCustom': {'accent': '#38bdf8', 'barA': '#0f172a', 'barB': '#075985', 'contrast': 1.0},
+    'last_project': '',
+    'columns': {},
+    'columnWidths': {},
+    'windowGeometry': {'x': 100, 'y': 100, 'w': 1280, 'h': 800, 'maximized': False}
+}
+
+# Canonical column definitions — Repère, Profile, Qty, Status as primaries
+# Repère = st (dirty marker), Profile = profile, Qty = qty, Status = st
+DEFAULT_COLUMNS = {
+    'sel': {'visible': False, 'width': 52},
+    'st': {'visible': True, 'width': 52},      # Repère / Status
+    'name': {'visible': True, 'width': 240},
+    'path': {'visible': False, 'width': 360},
+    'folder': {'visible': False, 'width': 120},
+    'qty': {'visible': True, 'width': 70},      # Qty
+    'profile': {'visible': True, 'width': 105}, # Profile
+    'quality': {'visible': True, 'width': 90},
+    'length_mm': {'visible': True, 'width': 90},
+    'weight': {'visible': True, 'width': 80},
+    'order': {'visible': False, 'width': 90},
+    'cat': {'visible': False, 'width': 100},
+    'fam': {'visible': False, 'width': 90},
+    'target': {'visible': False, 'width': 280},
+    'warning': {'visible': False, 'width': 200},
+    'size': {'visible': False, 'width': 85},
+    'modified': {'visible': False, 'width': 150},
+    'hash': {'visible': False, 'width': 180},
+    'o': {'visible': False, 'width': 80},
+    'si': {'visible': False, 'width': 70},
+    'notes': {'visible': False, 'width': 170},
+}
+
+
+class SettingsService:
+    def __init__(self, settings_dir=None):
+        self._data = {}
+        self._file_notes = {}
+        base_dir = settings_dir if settings_dir else SETTINGS_DIR
+        self._settings_path = os.path.join(base_dir, 'ui_settings.json')
+        self._notes_path = os.path.join(base_dir, 'file_notes.json')
+        os.makedirs(base_dir, exist_ok=True)
+        self.load()
+
+    def load(self):
+        self._data = self._load_json(self._settings_path, DEFAULT_SETTINGS)
+        self._file_notes = self._load_json(self._notes_path, {})
+        self._ensure_columns()
+
+    def _ensure_columns(self):
+        cols = self._data.get('columns') or {}
+        widths = self._data.get('columnWidths') or {}
+
+        # Migration: old schemas with Status/Steel column
+        if 'status' in cols or 'steel' in cols:
+            cols = {k: v['visible'] for k, v in DEFAULT_COLUMNS.items()}
+            widths = {k: v['width'] for k, v in DEFAULT_COLUMNS.items()}
+
+        # Migration: ensure primary columns (Repère, Profile, Qty, Status) are visible
+        # Primary columns per CTO: Repère=st, Profile=profile, Qty=qty, Status=st
+        primary_cols = ('st', 'name', 'qty', 'profile', 'quality', 'length_mm', 'weight')
+        needs_migration = any(not cols.get(k, False) for k in primary_cols)
+        if needs_migration:
+            for k in primary_cols:
+                cols[k] = True
+                widths.setdefault(k, DEFAULT_COLUMNS.get(k, {}).get('width', 100))
+
+        # Ensure all DEFAULT_COLUMNS keys exist
+        for k, v in DEFAULT_COLUMNS.items():
+            cols.setdefault(k, v['visible'])
+            widths.setdefault(k, v['width'])
+
+        self._data['columns'] = cols
+        self._data['columnWidths'] = widths
+
+    def _load_json(self, path, default):
+        try:
+            if os.path.exists(path):
+                with open(path, 'r', encoding='utf-8') as f:
+                    return {**default, **json.load(f)}
+        except (json.JSONDecodeError, OSError):
+            pass
+        return dict(default)
+
+    def _save_json(self, path, data):
+        try:
+            with open(path, 'w', encoding='utf-8') as f:
+                json.dump(data, f, indent=2, ensure_ascii=False)
+        except OSError:
+            pass
+
+    def save(self):
+        self._save_json(self._settings_path, self._data)
+
+    def get(self, key, default=None):
+        return self._data.get(key, default)
+
+    def set(self, key, value):
+        self._data[key] = value
+        self.save()
+
+    def get_view_opt(self, key):
+        return self._data.get('viewOpts', {}).get(key, DEFAULT_SETTINGS.get('viewOpts', {}).get(key, False))
+
+    def set_view_opt(self, key, value):
+        self._data.setdefault('viewOpts', {})[key] = bool(value)
+        self.save()
+
+    def get_beginner_help(self):
+        return self._data.get('beginnerHelp', DEFAULT_SETTINGS.get('beginnerHelp', False))
+
+    def set_beginner_help(self, value):
+        self._data['beginnerHelp'] = bool(value)
+        self.save()
+
+    def get_si_en_mode(self):
+        return self._data.get('siEnMode', DEFAULT_SETTINGS.get('siEnMode', 'ask'))
+
+    def set_si_en_mode(self, value):
+        self._data['siEnMode'] = value if value in ('none', 'ask', 'auto') else 'ask'
+        self.save()
+
+    def get_column_visible(self, col_key):
+        return self._data.get('columns', {}).get(col_key, DEFAULT_COLUMNS.get(col_key, {}).get('visible', True))
+
+    def set_column_visible(self, col_key, visible):
+        self._data.setdefault('columns', {})[col_key] = visible
+        self.save()
+
+    def get_column_width(self, col_key):
+        return self._data.get('columnWidths', {}).get(col_key, DEFAULT_COLUMNS.get(col_key, {}).get('width', 100))
+
+    def set_column_width(self, col_key, width):
+        self._data.setdefault('columnWidths', {})[col_key] = width
+        self.save()
+
+    def get_note(self, file_hash):
+        return self._file_notes.get(file_hash, '')
+
+    def set_note(self, file_hash, note):
+        self._file_notes[file_hash] = note
+        self._save_json(self._notes_path, self._file_notes)
+
+    def get_all_notes(self):
+        return dict(self._file_notes)
+
+    def get_column_defaults(self):
+        return list(DEFAULT_COLUMNS.items())
+
