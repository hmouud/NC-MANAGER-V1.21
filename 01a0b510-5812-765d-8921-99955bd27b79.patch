+            tmpl_dir = os.path.join(root, 'src', 'nccorrection', 'engine', 'profile_catalog', 'templates')
+            if os.path.isdir(tmpl_dir):
+                for fname in sorted(os.listdir(tmpl_dir)):
+                    if fname.lower().endswith('.nc1'):
+                        found = os.path.join(tmpl_dir, fname)
