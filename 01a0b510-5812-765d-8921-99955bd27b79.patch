+# A 90-degree press-brake bend across a 1000x200 plate: line along Y at
+# x1=400, so the X > 400 flap folds down to a 90-deg wall.
+BEND_90 = {'x1': 400.0, 'y1': 0.0, 'x2': 400.0, 'y2': 200.0,
+           'angle': 90.0, 'thickness': 10.0}
