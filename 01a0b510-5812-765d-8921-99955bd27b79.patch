index 0000000..e2588ab
--- /dev/null
+++ b/src/nccorrection/core/importer.py
@@ -0,0 +1,127 @@
+"""Folder import planning - pure logic (no Qt).
+
+Owner import law (2026-08-19):
+- The user picks a FOLDER; the program scans the NC1 files INSIDE it.
+- The ORDER is read from inside each file (not from the file name).
+- Files in one folder may carry several distinct orders; the user picks one
+  (or types their own) and the project is created under that name.
+- Stored copies keep the ORIGINAL file name - NO hash names anywhere.
+- Same-name files ALWAYS trigger a message with replace/ignore/compare;
+  conflicts are deferred to the end so they never block the import.
+"""
+import difflib
+import hashlib
+import os
+from datetime import datetime
+
+from nccorrection.core.order_utils import _extract_order
+
+_NC_EXTS = ('.nc', '.nc1')
+
+
+def scan_folder(folder):
+    """Scan ``folder`` (top level only) for *.nc / *.nc1 files.
+
+    Returns a list of dicts: path, name, text, hash, order, size, mtime, ctime.
+    Files that cannot be read are skipped.
+    """
+    result = []
+    try:
+        names = sorted(os.listdir(folder))
+    except OSError:
+        return result
+    for n in names:
+        if not n.lower().endswith(_NC_EXTS):
+            continue
+        p = os.path.join(folder, n)
+        if not os.path.isfile(p):
+            continue
+        try:
+            with open(p, 'rb') as fh:
+                raw = fh.read()
+            text = raw.decode('latin-1')
+        except (OSError, UnicodeDecodeError):
+            continue
+        result.append({
+            'path': p,
+            'name': n,
+            'text': text,
+            'hash': hashlib.sha256(raw).hexdigest(),
+            'order': _extract_order(text) or '',
+            'size': os.path.getsize(p),
+            'mtime': os.path.getmtime(p),
+            'ctime': os.path.getctime(p),
+        })
+    return result
+
+
+def distinct_orders(scan):
+    """Ordered list of distinct non-empty orders found in the scan."""
+    seen = []
+    for f in scan:
+        o = (f.get('order') or '').strip()
+        if o and o not in seen:
+            seen.append(o)
+    return seen
+
+
+def plan_import(scan, existing):
+    """Classify scanned files against the project's existing records.
+
+    ``existing``: list of records (each with ``name`` and ``hash``).
+    ``scan``: output of :func:`scan_folder`.
+
+    Returns ``{'new': [], 'duplicates': [], 'conflicts': []}``:
+    - new: name not present in the project.
+    - duplicates: same name AND identical content hash (nothing to do).
+    - conflicts: same name, different content. Each entry carries the
+      incoming file, the existing record and the similarity (0.0..1.0).
+    """
+    by_name = {}
+    for rec in existing:
+        by_name.setdefault(rec.get('name'), []).append(rec)
+
+    plan = {'new': [], 'duplicates': [], 'conflicts': []}
+    for inc in scan:
+        same = by_name.get(inc['name'], [])
+        if not same:
+            plan['new'].append(inc)
+            continue
+        if any(r.get('hash') == inc['hash'] for r in same):
+            plan['duplicates'].append(inc)
+            continue
+        sim = 0.0
+        ex_text = same[0].get('text', '')
+        if ex_text and inc.get('text'):
+            sim = difflib.SequenceMatcher(None, ex_text, inc['text']).ratio()
+        plan['conflicts'].append({
+            'incoming': inc,
+            'existing': same[0],
+            'similarity': sim,
+        })
+    return plan
+
+
+def fmt_date(ts):
+    """Format a timestamp for the conflict info (creation / modification)."""
+    try:
+        return datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M')
+    except (OSError, ValueError):
+        return '?'
+
+
+def file_info_lines(rec):
+    """Human-readable info lines for one file (conflict dialogs).
+
+    Owner requirement: show the creation date (تاريخ الصنع) and the last
+    modification, so the user can see whether someone edited the file.
+    """
+    order = (rec.get('order') or '').strip() or '(none)'
+    lines = [
+        f"Name : {rec.get('name', '?')}",
+        f"Size : {rec.get('size', 0)} bytes",
+        f"Created : {fmt_date(rec.get('ctime', 0))}",
+        f"Modified : {fmt_date(rec.get('mtime', 0))}",
+        f"Order : {order}",
+    ]
+    return '\n'.join(lines)
\ No newline at end of file
