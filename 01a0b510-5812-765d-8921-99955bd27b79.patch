+"""Tests for interpreters/flange_interpreter.py."""
+import unittest
+from nccorrection.engine.contour.interpreters.flange_interpreter import FlangeInterpreter
+from nccorrection.engine.contour.geometry.dimensions import ProfileDimensions
+from nccorrection.engine.contour.models.cut_angles import CutAngles
+from nccorrection.engine.contour.core.enums import Face, CutSide
+
+
+class TestFlangeInterpreter(unittest.TestCase):
+    def setUp(self):
+        # A40: IPE400, flange_front=-57.13
+        dims = ProfileDimensions(H=400, b=180, tf=13.5, tw=8.6, r=21)
+        angles = CutAngles(flange_front=-57.13)
+        self.fi = FlangeInterpreter(dims, angles)
+
+    def test_offset_57(self):
+        """Ground truth: A40 flange_cut = 288.62mm (magnitude)."""
+        offset = self.fi.offset(-57.13)
+        self.assertAlmostEqual(abs(offset), 288.62, delta=1.0)
+
+    def test_offset_zero(self):
+        self.assertEqual(self.fi.offset(0.0), 0.0)
+
+    def test_compute_returns_one_point(self):
+        points = self.fi.compute(Face.O)
+        self.assertEqual(len(points), 1)
+
+    def test_negative_angle_gives_negative_x(self):
+        """Flange with -57deg: X should be negative (rear side)."""
+        points = self.fi.compute(Face.O)
+        self.assertLess(points[0].x, 0)
+
+
+class TestFlangeInterpreterNoCut(unittest.TestCase):
