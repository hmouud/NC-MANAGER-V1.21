@@ -0,0 +1,627 @@
+"""Shape Reference dialog — parametric plate creator.
+
+VSP-style dialog: shape selector grid on the left, parameter form +
+live preview on the right.  Generates NC1 text or a geometry dict that
+can be imported into the project.
+
+Features added during Phase 1 expansion:
+  - Category filter buttons (All / Circular / Rectangular / Triangular / ...)
+  - Live search box for shape name
+  - French / English translation toggle
+"""
+from __future__ import annotations
+
+import math
+from PySide6.QtWidgets import (
+    QDialog, QVBoxLayout, QHBoxLayout, QFormLayout, QWidget,
+    QLabel, QPushButton, QDoubleSpinBox, QComboBox, QScrollArea,
+    QFrame, QGridLayout, QSizePolicy, QSpinBox, QLineEdit,
+    QToolButton, QButtonGroup, QSizePolicy,
+)
+from PySide6.QtCore import Qt, Signal, QRectF, QPointF, QSize
+from PySide6.QtGui import (
+    QPainter, QPen, QBrush, QColor, QFont, QPainterPath, QPixmap,
+)
+
+from nccorrection.engine.part_creator.shapes import (
+    SHAPE_LIBRARY, CATEGORIES, PlateShape, ShapeResult,
+    get_shape, shapes_by_category,
+)
+from nccorrection.engine.part_creator.geometry_preview import shape_to_geometry
+from nccorrection.engine.part_creator.nc1_generator import generate_nc1
+
+
+# ────────────────────────────────────────────────────────────────────
+# Translation tables
+# ────────────────────────────────────────────────────────────────────
+
+_I18N = {
+    'en': {
+        'dialog_title': "Shape Reference",
+        'shapes_label': "Shapes",
+        'all': "All",
+        'search_placeholder': "Search shapes...",
+        'part_name': "Part name",
+        'qty': "Qty",
+        'thk': "Thk (mm)",
+        'steel': "Steel",
+        'cancel': "Cancel",
+        'ok': "OK",
+        'contour_pts': "Contour: {n} pts",
+        'inner_contours': "Inner contours: {n}",
+        'holes': "Holes: {n}",
+        'lang_btn': "FR",
+    },
+    'fr': {
+        'dialog_title': "Referentiel Formes",
+        'shapes_label': "Formes",
+        'all': "Tout",
+        'search_placeholder': "Rechercher formes...",
+        'part_name': "Nom piece",
+        'qty': "Qte",
+        'thk': "Ep (mm)",
+        'steel': "Acier",
+        'cancel': "Annuler",
+        'ok': "OK",
+        'contour_pts': "Contour: {n} pts",
+        'inner_contours': "Contours int: {n}",
+        'holes': "Trous: {n}",
+        'lang_btn': "EN",
+    },
+}
+
+
+# ────────────────────────────────────────────────────────────────────
+# Shape thumbnail painter (small preview icon)
+# ────────────────────────────────────────────────────────────────────
+
+def _paint_shape_thumb(painter: QPainter, rect, shape: PlateShape,
+                       params: dict, color='#00a8ff'):
+    """Paint a small shape thumbnail into *rect*."""
+    result = shape.generate(shape.validate(params))
+    if not result.outer:
+        return
+
+    xs = [pt[0] for pt in result.outer]
+    ys = [pt[1] for pt in result.outer]
+    for inner in result.inners:
+        for pt in inner:
+            xs.append(pt[0])
+            ys.append(pt[1])
+
+    x0, x1 = min(xs), max(xs)
+    y0, y1 = min(ys), max(ys)
+    w = max(x1 - x0, 1e-6)
+    h = max(y1 - y0, 1e-6)
+
+    pad = 12
+    rw = rect.width() - 2 * pad
+    rh = rect.height() - 2 * pad
+    scale = min(rw / w, rh / h)
+    ox = rect.x() + pad + (rw - w * scale) / 2
+    oy = rect.y() + pad + (rh - h * scale) / 2
+
+    def to_screen(x, y):
+        return QPointF(ox + (x - x0) * scale,
+                       oy + (y1 - y) * scale)  # flip Y
+
+    pen = QPen(QColor(color), 1.5)
+    painter.setPen(pen)
+    painter.setBrush(Qt.NoBrush)
+
+    path = QPainterPath()
+    path.moveTo(to_screen(*result.outer[0]))
+    for pt in result.outer[1:]:
+        path.lineTo(to_screen(*pt))
+    path.closeSubpath()
+    painter.drawPath(path)
+
+    inner_pen = QPen(QColor('#f59e0b'), 1.0)
+    painter.setPen(inner_pen)
+    for inner in result.inners:
+        if not inner:
+            continue
+        ipath = QPainterPath()
+        ipath.moveTo(to_screen(*inner[0]))
+        for pt in inner[1:]:
+            ipath.lineTo(to_screen(*pt))
+        ipath.closeSubpath()
+        painter.drawPath(ipath)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Shape preview widget (larger live preview)
+# ────────────────────────────────────────────────────────────────────
+
+class ShapePreviewWidget(QWidget):
+    """Live preview widget that renders the current shape."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setMinimumSize(280, 280)
+        self._shape: PlateShape | None = None
+        self._params: dict = {}
+        self._scale: float = 1.0
+        self._count_x: int = 1
+        self._count_y: int = 1
+
+    def set_shape(self, shape: PlateShape, params: dict, scale: float = 1.0, count_x: int = 1, count_y: int = 1):
+        self._shape = shape
+        self._params = params
+        self._scale = scale
+        self._count_x = count_x
+        self._count_y = count_y
+        self.update()
+
+    def paintEvent(self, event):
+        if not self._shape:
+            return
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+
+        p.fillRect(self.rect(), QColor('#0f172a'))
+
+        p.setPen(QPen(QColor('#1e293b'), 0.5))
+        for x in range(0, self.width(), 20):
+            p.drawLine(x, 0, x, self.height())
+        for y in range(0, self.height(), 20):
+            p.drawLine(0, y, self.width(), y)
+
+        _paint_shape_thumb(p, QRectF(self.rect()), self._shape,
+                           self._params, '#00a8ff')
+
+        scale = getattr(self, '_scale', 1.0)
+        count_x = getattr(self, '_count_x', 1)
+        count_y = getattr(self, '_count_y', 1)
+        result = self._shape.generate_transformed(self._shape.validate(self._params),
+                                                  scale=scale, count_x=count_x, count_y=count_y)
+        if result.outer:
+            xs = [pt[0] for pt in result.outer]
+            ys = [pt[1] for pt in result.outer]
+            w = max(xs) - min(xs)
+            h = max(ys) - min(ys)
+            p.setPen(QColor('#64748b'))
+            p.setFont(QFont('Arial', 9))
+            p.drawText(self.rect().adjusted(6, 6, 0, 0),
+                       Qt.AlignLeft | Qt.AlignTop,
+                       f'{w:.1f} x {h:.1f} mm')
+        p.end()
+
+
+# ────────────────────────────────────────────────────────────────────
+# Shape button (grid selector item)
+# ────────────────────────────────────────────────────────────────────
+
+class ShapeButton(QFrame):
+    """Clickable shape thumbnail for the selector grid."""
+    clicked = Signal(str)  # emits shape name
+
+    def __init__(self, shape: PlateShape, parent=None):
+        super().__init__(parent)
+        self._shape = shape
+        self.setFixedSize(110, 110)
+        self.setCursor(Qt.PointingHandCursor)
+        self.setStyleSheet(
+            "ShapeButton { border: 1px solid #334155; border-radius: 4px; "
+            "background: #1e293b; }"
+            "ShapeButton:hover { border-color: #007acc; background: #1e3a5f; }"
+        )
+
+    def paintEvent(self, event):
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), QColor('#1e293b'))
+        _paint_shape_thumb(p, QRectF(self.rect()).adjusted(2, 2, -2, -22),
+                           self._shape, self._shape.defaults(), '#00a8ff')
+        p.setPen(QColor('#94a3b8'))
+        p.setFont(QFont('Arial', 7))
+        label_rect = QRectF(0, self.height() - 18, self.width(), 16)
+        p.drawText(label_rect, Qt.AlignCenter, self._shape.name)
+        p.end()
+
+    def mousePressEvent(self, event):
+        self.clicked.emit(self._shape.name)
+        super().mousePressEvent(event)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Category filter button
+# ────────────────────────────────────────────────────────────────────
+
+_CATEGORY_BTN_STYLE = (
+    "QToolButton {{ background: {bg}; color: {fg}; border: 1px solid #334155; "
+    "padding: 4px 10px; border-radius: 3px; font-size: 11px; font-weight: bold; }}"
+    "QToolButton:hover {{ border-color: #007acc; }}"
+)
+_CAT_ACTIVE_BG = '#007acc'
+_CAT_ACTIVE_FG = '#ffffff'
+_CAT_NORMAL_BG = '#1e293b'
+_CAT_NORMAL_FG = '#94a3b8'
+
+
+# ────────────────────────────────────────────────────────────────────
+# Main dialog
+# ────────────────────────────────────────────────────────────────────
+
+class ShapeReferenceDialog(QDialog):
+    """VSP-style Shape Reference dialog.
+
+    Signals
+    -------
