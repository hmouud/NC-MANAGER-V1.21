index 0000000..9abb02b
--- /dev/null
+++ b/src/nccorrection/design/draft.py
@@ -0,0 +1,39 @@
+"""Draft transform: geometry flip / rotation applied before measuring.
+
+CAD-style "flip before use": when a part arrives mirrored (or the operator
+wants it rotated), snap targets are transformed first so measurements and
+snap marks land on the corrected orientation. Pure math, applied by viewers
+before they build snap targets.
+"""
+from __future__ import annotations
+
+from nccorrection.design.snaps import SnapTargets
+
+
+class DraftTransform:
+    def __init__(self, flip_x=False, flip_y=False, rotate=0):
+        self.flip_x = bool(flip_x)
+        self.flip_y = bool(flip_y)
+        self.rotate = int(rotate) % 360
+    def apply_pt(self, x, y):
+        x = -x if self.flip_x else x
+        y = -y if self.flip_y else y
+        if self.rotate == 90:
+            return -y, x
+        if self.rotate == 180:
+            return -x, -y
+        if self.rotate == 270:
+            return y, -x
+        return x, y
+
+    def apply_targets(self, targets: SnapTargets) -> SnapTargets:
+        pts = [self.apply_pt(x, y) for x, y in targets.points]
+        segs = [(self.apply_pt(x1, y1), self.apply_pt(x2, y2))
+                for (x1, y1), (x2, y2) in targets.segments]
+        circles = []
+        for cx, cy, r in targets.circles:
+            nx, ny = self.apply_pt(cx, cy)
+            circles.append((nx, ny, r))
+        ins = self.apply_pt(*targets.insertion)
+        return SnapTargets(points=pts, segments=segs, circles=circles,
+                           insertion=ins)
diff --git a/src/nccorrection/design/glyphs.py b/src/nccorrection/design/glyphs.py
new file mode 100644
index 0000000..2d3a986
--- /dev/null
+++ b/src/nccorrection/design/glyphs.py
@@ -0,0 +1,69 @@
+"""CAD object-snap glyphs, drawn on screen space (single source of truth).
+
+Every viewer (classic 2D ``qt_viewer``, blueprint ``renderer_2d``, and the
+3D ``qt_viewer_3d``) renders its hover markers through :func:`draw_snap_glyph`
+so the Box / Triangle / Cross / Ring convention stays pixel-identical across
+all three, with exactly one copy of the drawing code.
+
+Glyph convention (CAD-standard):
+    endpoint      box
+    midpoint      upward triangle
+    centre        ring + crosshair
+    intersection  X cross
+    extension     upward triangle
+    tangent       upward triangle
+    nearest       ring + plus
+    insertion     ring + plus
+
+The marker is always drawn flattened in screen coordinates: a 3D hovered
+point is projected with the viewer's camera ``_project()`` and the glyph is
+drawn at ``(sx, sy)``. The label is *not* part of the glyph - callers draw the
+``snap_label(kind)`` text next to it with the theme colour.
+"""
+
+from PySide6.QtCore import Qt, QPointF, QRectF
+from PySide6.QtGui import QPen, QPolygonF
+
+
+def _xy(pos):
+    """Accept both a ``QPointF`` and a plain ``(x, y)`` tuple."""
+    return (pos.x(), pos.y()) if hasattr(pos, 'x') else (pos[0], pos[1])
+
+
+def draw_snap_glyph(p, pos, kind, color, scale=1.0):
+    """Draw the CAD marker for a snap ``kind`` at screen ``pos``.
+
+    ``p`` is a QPainter already clipped to the widget; ``pos`` is a QPointF
+    or ``(x, y)``; ``color`` is a QColor (theme/design driven by the caller);
+    ``scale`` scales the marker radius (``snap_badge_size``). No label drawn.
+    """
+    x, y = _xy(pos)
+    r = 6.0 * scale
+    pen = QPen(color, max(1.2, 1.5 * scale))
+    p.setPen(pen)
+    p.setBrush(Qt.NoBrush)
+    if kind == 'endpoint':
+        p.drawRect(QRectF(x - r, y - r, 2 * r, 2 * r))
+    elif kind == 'midpoint':
+        tri = QPolygonF([QPointF(x, y - r * 1.35),
+                         QPointF(x - r * 1.15, y + r * 0.9),
+                         QPointF(x + r * 1.15, y + r * 0.9)])
+        p.drawPolygon(tri)
+    elif kind == 'centre':
+        p.drawEllipse(QPointF(x, y), r, r)
+        p.drawLine(QPointF(x - r, y), QPointF(x + r, y))
+        p.drawLine(QPointF(x, y - r), QPointF(x, y + r))
+    elif kind == 'intersection':
+        p.drawLine(QPointF(x - r * 1.2, y - r * 1.2),
+                   QPointF(x + r * 1.2, y + r * 1.2))
+        p.drawLine(QPointF(x - r * 1.2, y + r * 1.2),
+                   QPointF(x + r * 1.2, y - r * 1.2))
+    elif kind in ('extension', 'tangent'):
+        tri = QPolygonF([QPointF(x, y - r * 1.35),
+                         QPointF(x - r * 1.15, y + r * 0.9),
+                         QPointF(x + r * 1.15, y + r * 0.9)])
+        p.drawPolygon(tri)
+    else:  # nearest / insertion
+        p.drawEllipse(QPointF(x, y), r, r)
+        p.drawLine(QPointF(x - r * 1.2, y), QPointF(x + r * 1.2, y))
+        p.drawLine(QPointF(x, y - r * 1.2), QPointF(x, y + r * 1.2))
\ No newline at end of file
diff --git a/src/nccorrection/design/measure.py b/src/nccorrection/design/measure.py
new file mode 100644
index 0000000..b7893fe
--- /dev/null
+++ b/src/nccorrection/design/measure.py
@@ -0,0 +1,122 @@
+"""Measurement model shared by every viewer (2D, 3D, blueprint).
+
+Pure data: a measurement is two points plus their distance / angle and the
+snap kinds that produced them, plus an optional label offset for dragging the
+label to a corner (Tekla-style).
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+
+@dataclass
+class Measurement:
+    a: tuple
+    b: tuple
+    dist: float
+    angle: float
+    kind_a: str = None
+    kind_b: str = None
+    off: tuple = (0.0, 0.0)
+
+
+def measure_info(a, b, kind_a=None, kind_b=None):
+    """Return (distance, angle_degrees, ortho) for two points (2D or 3D)."""
+    if len(a) >= 3 and len(b) >= 3:
+        dist = math.sqrt((b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2 + (b[2] - a[2]) ** 2)
+    else:
+        dist = math.hypot(b[0] - a[0], b[1] - a[1])
+    dx = b[0] - a[0]
+    dy = b[1] - a[1]
+    if abs(dx) < 1e-9 and abs(dy) < 1e-9:
+        return dist, 0.0, True
+    ang = math.degrees(math.atan2(dy, dx)) % 180.0
+    if ang < 2.0 or ang > 178.0:
+        return dist, 0.0, True
+    if abs(ang - 90.0) < 2.0:
+        return dist, 90.0, True
+    return dist, ang, False
+
+
+def angle_label(angle: float) -> str:
+    if angle == 0.0:
+        return '0\u00b0'
+    if angle == 90.0:
+        return '90\u00b0'
+    return f'{angle:.1f}\u00b0'
+
+
+def angle_verdict(angle: float) -> str:
+    """Classify a 0..180 angle: right angle, acute (<= 90) or obtuse (> 90)."""
+    if abs(angle - 90.0) < 0.5:
+        return 'Right angle (90\u00b0)'
+    if angle < 90.0:
+        return 'Acute (\u2264 90\u00b0)'
+    return 'Obtuse (> 90\u00b0)'
+
+
+def corner_angle(a, vertex, b) -> float:
+    """Angle in degrees (0..180) at ``vertex`` between arms to ``a`` and ``b``.
+
+    Accepts 2D or 3D points.
+    """
+    v1 = tuple(ai - vi for ai, vi in zip(a, vertex))
+    v2 = tuple(bi - vi for bi, vi in zip(b, vertex))
+    n1 = math.sqrt(sum(c * c for c in v1))
+    n2 = math.sqrt(sum(c * c for c in v2))
+    if n1 < 1e-9 or n2 < 1e-9:
+        return 0.0
+    dot = sum(c1 * c2 for c1, c2 in zip(v1, v2))
+    cosv = max(-1.0, min(1.0, dot / (n1 * n2)))
+    return math.degrees(math.acos(cosv))
+
+
+def corner_label(angle: float) -> str:
+    return f'\u2220 {angle_label(angle)}  [{angle_verdict(angle)}]'
+
+
+class MeasurementSet:
+    """Ordered committed measurements with label-drag support."""
+
+    def __init__(self):
+        self._items = []
+
+    def __iter__(self):
+        return iter(self._items)
+
+    def __len__(self):
+        return len(self._items)
+
+    def clear(self):
+        self._items.clear()
+
+    def add(self, a, b, kind_a=None, kind_b=None):
+        dist, ang, _ = measure_info(a, b)
+        self._items.append(Measurement(a, b, dist, ang, kind_a, kind_b))
+        return self._items[-1]
+
+    def label_at(self, pos, to_screen, hit_tol=14.0):
+        """Return (index, a, b, off) when ``pos`` hits a label, else None.
+
+        ``to_screen`` projects a data point to widget pixels so this works for
+        every viewer (2D scene, 3D projection, blueprint canvas). Labels are
+        anchored just above the segment midpoint plus their drag offset.
+        """
+        px, py = pos
+        for i, m in enumerate(self._items):
+            s1 = to_screen(m.a)
+            s2 = to_screen(m.b)
+            mid = ((s1[0] + s2[0]) / 2.0 + m.off[0],
+                   (s1[1] + s2[1]) / 2.0 + m.off[1])
+            if math.hypot(px - mid[0], py - (mid[1] - 24.0)) <= hit_tol:
+                return i, m.a, m.b, m.off
+        return None
+
+    def move_label(self, index, delta):
+        """Apply a drag delta to the label offset of measurement ``index``."""
+        if 0 <= index < len(self._items):
+            m = self._items[index]
+            m.off = (m.off[0] + delta[0], m.off[1] + delta[1])
+            return m.off
+        return None
diff --git a/src/nccorrection/design/settings.py b/src/nccorrection/design/settings.py
new file mode 100644
index 0000000..2383845
--- /dev/null
+++ b/src/nccorrection/design/settings.py
@@ -0,0 +1,198 @@
+"""Design settings: which snaps are active, measure options and draft flip.
+
+Persisted inside the app's existing settings store under the ``design`` key so
+toggles survive restarts. Independent of the UI: the menu just calls these
+setters.
+"""
+from __future__ import annotations
+
+from PySide6.QtCore import QObject, Signal
+
+from nccorrection.design.snaps import SNAP_KINDS
+
+
+class DesignSettings(QObject):
+    """Design settings: which snaps are active, measure options and draft flip.
+
+    Persisted inside the app's existing settings store under the ``design`` key so
+    toggles survive restarts. Independent of the UI: the menu just calls these
+    setters.
+
+    ``changed`` fires every time a value is mutated, so every instantiated
+    viewer (2D, 3D, Blueprint) can re-read the configuration simultaneously.
+    """
+
+    changed = Signal()
+
+    DEFAULTS = {
+        'snaps': list(SNAP_KINDS),
+        'osnap_enabled': True,
+        'snap_tol': 12.0,
+        'snap_exact_band': 4.0,
+        'polar_enabled': True,
+        'polar_angle': 15.0,
+        'polar_tol': 2.0,
+        'snap_badge_color': '#3cb371',
+        'snap_badge_size': 1.0,
+        'dimension_scale': 1.0,
+        'show_ortho': True,
+        'flip_x': False,
+        'flip_y': False,
+        'rotate': 0,
+    }
+
+    def __init__(self, service=None):
+        super().__init__()
+        self._svc = service
+        stored = (service.get('design') or {}) if service else {}
+        self._data = {**self.DEFAULTS, **stored}
+
+    def _save(self):
+        if self._svc is not None:
+            self._svc.set('design', self._data)
+        self.changed.emit()
+
+    # ------------------------------------------------------------ snaps
+    def ordered_kinds(self) -> list:
+        return list(SNAP_KINDS)
+
+    # master switch: when off the engine performs no object snap at all
+    def osnap_enabled(self) -> bool:
+        return bool(self._data.get('osnap_enabled', True))
+
+    def set_osnap_enabled(self, on: bool):
+        self._data['osnap_enabled'] = bool(on)
+        self._save()
+
+    def enabled_snaps(self) -> set:
+        return {k for k in self._data.get('snaps', []) if k in SNAP_KINDS}
+
+    def snap_enabled(self, kind: str) -> bool:
+        return kind in self.enabled_snaps()
+
+    def set_snap(self, kind: str, on: bool):
+        snaps = self.enabled_snaps()
+        if on:
+            snaps.add(kind)
+        else:
+            snaps.discard(kind)
+        self._data['snaps'] = [k for k in SNAP_KINDS if k in snaps]
+        self._save()
+
+    def toggle_snap(self, kind: str):
+        self.set_snap(kind, not self.snap_enabled(kind))
+
+    def snap_tol(self) -> float:
+        return float(self._data.get('snap_tol', 12.0))
+
+    def set_snap_tol(self, tol: float):
+        self._data['snap_tol'] = float(tol)
+        self._save()
+
+    def snap_exact_band(self) -> float:
+        """Radius (data units) where a strong kind dominates a near one."""
+        return float(self._data.get('snap_exact_band', 4.0))
+
+    def set_snap_exact_band(self, band: float):
+        self._data['snap_exact_band'] = max(0.0, float(band))
+        self._save()
+
+    # ----------------------------------------------------------- polar tracking
+    def polar_enabled(self) -> bool:
+        return bool(self._data.get('polar_enabled', True))
+
+    def set_polar_enabled(self, on: bool):
+        self._data['polar_enabled'] = bool(on)
+        self._save()
+
+    def polar_angle(self) -> float:
+        return float(self._data.get('polar_angle', 15.0))
+
+    def set_polar_angle(self, deg: float):
+        self._data['polar_angle'] = max(1.0, min(90.0, float(deg)))
+        self._save()
+
+    def polar_tol(self) -> float:
+        return float(self._data.get('polar_tol', 2.0))
+
+    def set_polar_tol(self, deg: float):
+        self._data['polar_tol'] = max(0.25, min(15.0, float(deg)))
+        self._save()
+
+    # ------------------------------------------------------ snap markers
+    def snap_badge_color(self) -> str:
+        return str(self._data.get('snap_badge_color', '#3cb371'))
+
+    def set_snap_badge_color(self, hex_color: str):
+        self._data['snap_badge_color'] = str(hex_color)
+        self._save()
+
+    def snap_badge_size(self) -> float:
+        return float(self._data.get('snap_badge_size', 1.0))
+
+    def set_snap_badge_size(self, scale: float):
+        self._data['snap_badge_size'] = max(0.6, min(1.8, float(scale)))
+        self._save()
+
+    def dimension_scale(self) -> float:
+        return float(self._data.get('dimension_scale', 1.0))
+
+    def set_dimension_scale(self, scale: float):
+        self._data['dimension_scale'] = max(0.6, min(1.8, float(scale)))
+        self._save()
+
+    # -------------------------------------------------------------- display
+    def show_ortho(self) -> bool:
+        return bool(self._data.get('show_ortho'))
+
+    def set_show_ortho(self, on: bool):
+        self._data['show_ortho'] = bool(on)
+        self._save()
+
+    # ------------------------------------------------------------- draft
+    def restore_defaults(self):
+        """Reset every design option back to its default and persist."""
+        self._data = {**DesignSettings.DEFAULTS}
+        self._save()
+
+    # ------------------------------------------------------ transactional
+    def snapshot(self) -> dict:
+        """Deep copy of the current state (for dialog Cancel)."""
+        return {k: (list(v) if isinstance(v, list) else v)
+                for k, v in self._data.items()}
+
+    def restore_snapshot(self, data: dict):
+        """Replace the state from a previous :meth:`snapshot` and persist."""
+        self._data = {k: (list(v) if isinstance(v, list) else v)
+                      for k, v in data.items()}
+        self._save()
+
+    def reset(self):
+        """Reset in-memory options to defaults and persist."""
+        self._data = {**DesignSettings.DEFAULTS}
+        self._save()
+
+    def persist(self):
+        """Write the current state to the settings service."""
+        self._save()
+
+    def flip_x(self) -> bool:
+        return bool(self._data.get('flip_x'))
+
+    def flip_y(self) -> bool:
+        return bool(self._data.get('flip_y'))
+
+    def rotate(self) -> int:
+        return int(self._data.get('rotate', 0)) % 360
+
+    def set_flip_x(self, on: bool):
+        self._data['flip_x'] = bool(on)
+        self._save()
+
+    def set_flip_y(self, on: bool):
+        self._data['flip_y'] = bool(on)
+        self._save()
+
+    def set_rotate(self, deg: int):
+        self._data['rotate'] = int(deg) % 360
+        self._save()
diff --git a/src/nccorrection/design/snaps.py b/src/nccorrection/design/snaps.py
new file mode 100644
index 0000000..83b3743
--- /dev/null
+++ b/src/nccorrection/design/snaps.py
@@ -0,0 +1,27 @@
+"""Snap detection facade (pure geometry, no Qt).
+
+The snap mathematics live in the isolated engine module
+:mod:`nccorrection.engine.math.osnap` (a leaf module with no dependencies on
+widgets, DSTV or the design layer). This module re-exports that API under the
+design-layer names every viewer already uses, so snapping behaviour is defined
+in exactly one place and the independent design layer stays the
+consumer-facing surface - no viewer ever imports the engine math directly.
+"""
+
+from nccorrection.engine.math.osnap import (  # noqa: F401
+    OsnapTargets as SnapTargets,
+    resolve_osnap as resolve_snap,
+    polar_snap,
+    stadium_rim,
+    OSNAP_KINDS as SNAP_KINDS,
+    SNAP_PRIORITY,
+    ENDPOINT, MIDPOINT, NEAREST, INTERSECTION, CENTRE, TANGENT,
+    EXTENSION, INSERTION,
+)
+
+__all__ = [
+    'SnapTargets', 'resolve_snap', 'polar_snap', 'stadium_rim',
+    'SNAP_KINDS', 'SNAP_PRIORITY',
+    'ENDPOINT', 'MIDPOINT', 'NEAREST', 'INTERSECTION', 'CENTRE',
+    'TANGENT', 'EXTENSION', 'INSERTION',
+]
diff --git a/src/nccorrection/design/theme.py b/src/nccorrection/design/theme.py
new file mode 100644
index 0000000..d052266
--- /dev/null
+++ b/src/nccorrection/design/theme.py
@@ -0,0 +1,110 @@
+"""Professional design palettes for the blueprint and measure tools.
+
+Independent colour layer: viewers receive these palettes (as plain dicts) from
+the app, they never define design colours themselves. ``blueprint_palette``
+adapts the classic blueprint look to the active app theme, ``measure_palette``
+keeps measurement feedback consistent across 2D / 3D / blueprint.
+"""
+
+from PySide6.QtGui import QColor
+
+SNAP_BADGE_COLORS = {
+    'endpoint': '#22d3ee',
+    'midpoint': '#fbbf24',
+    'nearest': '#4ade80',
+    'intersection': '#a78bfa',
+    'centre': '#f472b6',
+    'tangent': '#2dd4bf',
+    'extension': '#fb923c',
+    'insertion': '#f8fafc',
+}
+
+_SNAP_LABELS = {
+    'endpoint': 'Endpoint',
+    'midpoint': 'Midpoint',
+    'nearest': 'Nearest',
+    'intersection': 'Intersection',
+    'centre': 'Centre',
+    'tangent': 'Tangent',
+    'extension': 'Extension',
+    'insertion': 'Insertion',
+}
+
+
+def snap_label(kind):
+    return _SNAP_LABELS.get(kind, kind)
+
+
+def blueprint_palette(theme=None):
+    """Professional blueprint colours for the developed-face sheet.
+
+    With no argument (or no usable theme) the classic light industrial sheet
+    is returned -- a near-white ``#f0f3f4`` background, machined-metal grey
+    faces and steel-blue contour ink -- matching the machinist drawing on
+    paper.
+
+    When an app theme dict is provided (the 2D dark slate themes), the sheet
+    is translated into the same 2D dark drafting look: navy canvas, panel
+    "paper", cyan steel contour ink, rose holes and amber slots, so the
+    developed faces of the blueprint read exactly like the 2D beam view.
+    """
+    if theme and isinstance(theme, dict):
+        bg = theme.get('bg', '#f0f3f4')
+        # detect a dark sheet: light themes keep the classic paper look
+        r = int(bg[1:3], 16); g = int(bg[3:5], 16); b = int(bg[5:7], 16)
+        if (r + g + b) / 3.0 < 128:
+            panel = theme.get('panel2', '#1b2638')
+            card = theme.get('card', '#1f2b3f')
+            line = theme.get('line', '#2c3a52')
+            txt = theme.get('txt', '#e8edf6')
+            blue = theme.get('blue', '#38bdf8')
+            yel = theme.get('yel', '#fbbf24')
+            red = theme.get('red', '#fb7185')
+            return {
+                'bg': theme.get('barA', bg),
+                'paper': panel,
+                'fill_web': card,
+                'fill_flange': QColor(line).darker(130).name()
+                if QColor(line).lightnessF() > 0.25 else line,
+                'fill_rear': line,
+                'contour': blue,
+                'contour_dim': QColor(blue).darker(115).name(),
+                'cut': yel,
+                'miter': theme.get('vio', '#a78bfa'),
+                'hole': red,
+                'grid': QColor(line).darker(140).name(),
+                'axis': theme.get('mut', '#8ea3c0'),
+                'break': QColor(line).darker(120).name(),
+                'text': txt,
+                'measure_line': blue,
+                'measure_label': yel,
+            }
+    return {
+        'bg': '#f0f3f4',
+        'paper': '#ffffff',
+        'fill_web': '#bdc3c7',
+        'fill_flange': '#a7b1b8',
+        'fill_rear': '#a7b1b8',
+        'contour': '#2980b9',
+        'contour_dim': '#2471a3',
+        'cut': '#e67e22',
+        'miter': '#d35400',
+        'hole': '#e67e22',
+        'grid': '#d7dee1',
+        'axis': '#95a5a6',
+        'break': '#95a5a6',
+        'text': '#2c3e50',
+        'measure_line': '#2980b9',
+        'measure_label': '#e67e22',
+    }
+
+
+def measure_palette(theme=None):
+    return {
+        'line': '#22d3ee',
+        'point': '#22d3ee',
+        'label_bg': '#0f172a',
+        'label_text': '#fbbf24',
+        'status': '#94a3b8',
+        'badges': dict(SNAP_BADGE_COLORS),
+    }
