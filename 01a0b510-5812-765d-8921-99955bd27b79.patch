+    def _draw_cut_markers(self, p):
+        """Highlight cut features (angles) directly on the part."""
+        try:
+            from nccorrection.core.viewer import classify_cuts
+            cuts = classify_cuts(self._display_geometry())
+        except Exception:
+            return
+        if not cuts:
+            return
+        p.setFont(QFont('Arial', 8, QFont.Bold))
+        apen = QPen(QColor('#fb7185'), 0.9)
+        for c in cuts:
+            if c.get('x') is None:
+                continue
+            # Skip square pointage boxes
+            if c.get('kind') == 'grougage':
+                continue
+            sx, sy = self._to_screen(
+                c['x'], self._explode_y(c.get('face') or 'v',
+                                        c.get('y') or 0.0))
+            p.setPen(apen)
+            p.setBrush(Qt.NoBrush)
+            p.drawEllipse(QPointF(sx, sy), 5, 5)
+            ang = abs(c['angle']) if c.get('angle') is not None else 0.0
+            label = c['label']
+            if ang > 1e-9:
+                label += f" {ang:.1f}\u00b0"
+            p.setPen(QColor('#fb7185'))
+            p.drawText(QPointF(sx + 8, sy + 8), label)
+
+    def _draw_trusquinage(self, p, b):
+        """Draw trusquinage (standard steel gage lines) through hole rows."""
+        geom = self._display_geometry()
+        holes = geom.get('holes') or []
+        if not holes or not b:
+            return
+        rows_by_face = {}
+        for h in holes:
+            face = h.get('face') or 'v'
+            y = round(float(h.get('y', 0.0)), 1)
+            rows_by_face.setdefault(face, set()).add(y)
+
+        p.save()
+        tpen = QPen(QColor(148, 163, 184, 180), 0.8, Qt.DashDotLine)
+        p.setFont(QFont('Arial', 7))
+
+        x_start = b[0]
+        x_end = b[2]
+
+        for face, y_set in rows_by_face.items():
+            for y in sorted(y_set):
+                disp_y = self._explode_y(face, y)
+                sx1, sy1 = self._to_screen(x_start, disp_y)
+                sx2, sy2 = self._to_screen(x_end, disp_y)
+                p.setPen(tpen)
+                p.drawLine(QPointF(sx1, sy1), QPointF(sx2, sy2))
+                p.setPen(QColor('#94a3b8'))
+                p.drawText(QPointF(sx1 + 4, sy1 - 3), f"Trusquinage Y={y:g}")
+        p.restore()
+
+    def _draw_fold_lines(self, p):
+        """Draw the DSTV KA bend lines dashed #e67e22 with their angle
+        annotation ('Show Folded Line' -- no folding, just the bend
+        location). Bend lines belong to the flat pattern so they are always
+        drawn at their ORIGINAL coordinates (the fold axis does not move when
+        the Folded View is active)."""
+        bends = self._geometry.get('bends') or []
+        if not bends:
+            return
+        pen = QPen(QColor('#e67e22'), 1.2, Qt.DashLine)
+        pen.setDashPattern([6, 4])
+        p.setPen(pen)
+        p.setBrush(Qt.NoBrush)
+        p.setFont(QFont('Arial', 7, QFont.Bold))
+        for b in bends:
+            sx1, sy1 = self._to_screen(b['x1'], self._explode_y('v', b['y1']))
+            sx2, sy2 = self._to_screen(b['x2'], self._explode_y('v', b['y2']))
+            p.drawLine(QPointF(sx1, sy1), QPointF(sx2, sy2))
+            ang = b.get('angle')
+            if ang:
+                mx, my = (sx1 + sx2) / 2.0, (sy1 + sy2) / 2.0
+                p.setPen(QColor('#e67e22'))
+                p.drawText(QPointF(mx + 4, my - 4), f'{ang:g}\u00b0')
+
+    def _draw_cotation(self, p, b):
+        """Tekla-style dimensioning: hole spacing and edge->hole distances.
+
+        Horizontal chains run above the part (edge -> hole -> hole -> edge);
+        vertical chains run on the right side (top edge -> hole row, hole
+        row -> bottom edge). Diameter labels are drawn on every hole.
+
+        With the faces layout active every band gets its own chains so the
+        dimensions stay attached to the face they belong to.
+        """
+        if self._ensure_face_bands():
+            self._draw_band_cotations(p)
+            return
+        self._draw_contour_radius_label(p)
+        circles = self._geometry.get('circles', [])
+        slots = self._geometry.get('slots', [])
+        pts = [(c[0], c[1]) for c in circles] + [(s[0], s[1]) for s in slots]
+        if not pts:
+            return
+        gap = 14.0 / max(self._scale * self._zoom, 1e-6)
+        xs = sorted({round(pt[0], 3) for pt in pts})
+        ys = sorted({round(pt[1], 3) for pt in pts})
+        p.setFont(QFont('Arial', 8))
+        self._cotation_chain(p, b, xs, 'x', b[3] + gap, b[3])
+        self._cotation_chain(p, b, ys, 'y', b[2] + gap, b[2])
+
+    def _draw_band_cotations(self, p):
+        """Per-face dimension chains inside each band of the faces layout."""
+        circles = self._geometry.get('circles', [])
+        slots = self._geometry.get('slots', [])
+        holes = self._geometry.get('holes', [])
+        c_faces = [h.get('face') or 'v' for h in holes
+                   if h.get('kind') == 'hole']
+        s_faces = [h.get('face') or 'v' for h in holes
+                   if h.get('kind') == 'slot']
+        gap = 14.0 / max(self._scale * self._zoom, 1e-6)
+        xb = compute_bounds(self._geometry, margin=2.0)
+        if not xb:
+            return
+        p.setFont(QFont('Arial', 8))
+        for face, off, ymin, ymax in self._ensure_face_bands():
+            pts = []
+            for i, (x, y, _d) in enumerate(circles):
+                if (c_faces[i] if i < len(c_faces) else 'v') == face:
+                    pts.append((x, self._explode_y(face, y)))
+            for i, slot in enumerate(slots):
+                if (s_faces[i] if i < len(s_faces) else 'v') == face:
+                    pts.append((slot[0], self._explode_y(face, slot[1])))
+            if not pts:
+                continue
+            xs = sorted({round(pt[0], 3) for pt in pts})
+            ys = sorted({round(pt[1], 3) for pt in pts})
+            top = off + (ymax - ymin)
+            bb = (xb[0], off, xb[2], top)
+            self._cotation_chain(p, bb, xs, 'x', top + gap, top)
+            self._cotation_chain(p, bb, ys, 'y', xb[2] + gap, xb[2])
+
+    def _draw_contour_radius_label(self, p):
+        """Auto-dimension circular contours using the dimensioning engine.
+
+        For radius-convention contours: R leader + center mark.
+        For detected bolt circles: angular spacing labels.
+        """
+        from nccorrection.design.dimensioning import (
+            DimensionRenderer, auto_dimensions, style_from_theme)
+        dims = auto_dimensions(self._geometry)
+        if dims.is_empty:
+            return
+        style = style_from_theme(self._mp)
+        renderer = DimensionRenderer(p, style, self._to_screen)
+        renderer.draw_group(dims)
+
+    def _cotation_chain(self, p, b, refs, axis, base, edge):
+        """Draw a dimension chain between consecutive sorted refs.
+
+        axis 'x' => horizontal chain at y=base, extension lines from y=edge.
+        axis 'y' => vertical chain at x=base, extension lines from x=edge.
+        """
+        dim_pen = QPen(QColor('#f59e0b'), 0.7)
+        ext_pen = QPen(QColor(245, 158, 11, 150), 0.5, Qt.DashLine)
+        txt_col = QColor('#f59e0b')
+        lo, hi = (b[0], b[2]) if axis == 'x' else (b[1], b[3])
+        allrefs = [lo] + refs + [hi]
+        for i in range(len(allrefs) - 1):
+            v1, v2 = allrefs[i], allrefs[i + 1]
+            dist = v2 - v1
+            if dist < 1e-3:
+                continue
+            if axis == 'x':
+                a1 = self._to_screen(v1, base)
+                a2 = self._to_screen(v2, base)
+                t1 = self._to_screen(v1, edge)
+                t2 = self._to_screen(v2, edge)
+            else:
+                a1 = self._to_screen(base, v1)
+                a2 = self._to_screen(base, v2)
+                t1 = self._to_screen(edge, v1)
+                t2 = self._to_screen(edge, v2)
+            p.setPen(ext_pen)
+            p.drawLine(QPointF(t1[0], t1[1]), QPointF(a1[0], a1[1]))
+            p.drawLine(QPointF(t2[0], t2[1]), QPointF(a2[0], a2[1]))
+            p.setPen(dim_pen)
+            p.drawLine(QPointF(a1[0], a1[1]), QPointF(a2[0], a2[1]))
+            self._dim_arrow(p, QPointF(a1[0], a1[1]), QPointF(a2[0], a2[1]))
+            label = f"{dist:.0f}"
+            fm = QFontMetrics(p.font())
+            tw = fm.horizontalAdvance(label) + 10
+            rect = QRectF((a1[0] + a2[0]) / 2 - tw / 2, a1[1] - 9, tw, 16)
+            p.setPen(Qt.NoPen)
+            p.setBrush(QColor(11, 21, 38, 210))
+            p.drawRoundedRect(rect, 4, 4)
+            p.setPen(txt_col)
+            p.drawText(rect, Qt.AlignCenter, label)
+
+    def _dim_arrow(self, p, a, b):
+        """AutoCAD-style solid filled arrowhead between dimension points."""
+        ang = math.atan2(b.y() - a.y(), b.x() - a.x())
+        for tip, tip_ang in ((b, ang), (a, ang + math.pi)):
+            cos_a, sin_a = math.cos(tip_ang), math.sin(tip_ang)
+            size = 7.0
+            base = (tip.x() - size * cos_a, tip.y() - size * sin_a)
+            splay = 0.2
+            p.setPen(QPen(QColor('#f59e0b'), 0.2))
+            p.setBrush(QBrush(QColor('#f59e0b')))
+            tri = QPolygonF([
+                QPointF(tip.x(), tip.y()),
+                QPointF(base[0] - size * splay * sin_a,
+                        base[1] + size * splay * cos_a),
+                QPointF(base[0] + size * splay * sin_a,
+                        base[1] - size * splay * cos_a),
+            ])
+            p.drawPolygon(tri)
+            p.setBrush(Qt.NoBrush)
+
+    # ------------------------------------------------------------ unfold view
+    def _unfold_bands(self, stype, dims, faces):
+        """Band heights (mm) for the unfolded faces of a profile."""
+        H = dims[1] if len(dims) > 1 else 200.0
+        B = dims[2] if len(dims) > 2 else 100.0
+        band = {}
+        if stype in ('I', 'C', 'U', 'O', 'Z', 'S', 'T'):
+            for f in faces:
+                band[f] = H if f in ('v', 'h') else B
+        elif stype == 'L':
+            for f in faces:
+                band[f] = H if f in ('v', 'h') else B
+        else:
+            for f in faces:
+                band[f] = 60.0
+        order = sorted([f for f in faces], key=lambda f: self._EURO_ORDER.get(f, 9))
+        return [(f, band.get(f, 60.0)) for f in order]
+
+    def _draw_unfold(self, p):
+        holes = self._geometry.get('holes', [])
+        st = self._geometry.get('st') or {}
+        stype = st.get('type') or 'B'
+        dims = st.get('dims') or []
+        xs = [h['x'] for h in holes]
+        xs += [c[0] for c in self._geometry.get('circles', [])]
+        xs += [s[0] for s in self._geometry.get('slots', [])]
+        if not xs:
+            return
+        xmin, xmax = min(xs), max(xs)
+        if xmax - xmin < 1e-6:
+            xmin, xmax = xmin - 500.0, xmax + 500.0
+        length = xmax - xmin
+        faces = []
+        for h in holes:
+            if h.get('face') not in faces:
+                faces.append(h.get('face'))
+        bands = self._unfold_bands(stype, dims, faces)
+        if not bands:
+            return
+        margin = 30
+        avail_w = max(self.width() - 2 * margin, 10)
+        avail_h = max(self.height() - 2 * margin, 10)
+        total_h = sum(h for _, h in bands)
+        scale = min(avail_w / length, avail_h / total_h)
+        ox = (self.width() - length * scale) / 2.0
+        base_y = self.height() - margin
+        band_col = QColor('#475569')
+        hole_col = QColor('#38bdf8')
+        slot_col = QColor('#fbbf24')
+        face_tint = {'v': QColor('#38bdf8'), 'o': QColor('#34d399'),
+                     'u': QColor('#a78bfa'), 'h': QColor('#f472b6')}
+        for face, bh in bands:
+            top = base_y - bh * scale
+            rect = QRectF(ox, top, length * scale, max(bh * scale, 6.0))
+            tint = face_tint.get(face, band_col)
+            p.setPen(QPen(tint, 0.8))
+            p.setBrush(QColor(tint.red(), tint.green(), tint.blue(), 26))
+            p.drawRect(rect)
+            p.setPen(tint)
+            p.setFont(QFont('Arial', 8, QFont.Bold))
+            p.drawText(QRectF(ox - 44, top, 38, max(bh * scale, 6.0)),
+                       Qt.AlignVCenter | Qt.AlignRight, face.upper())
+            p.setFont(QFont('Arial', 8))
+            for h in holes:
+                if h.get('face') != face:
+                    continue
+                hx = ox + (h['x'] - xmin) * scale
+                hy = base_y - min(max(h['y'], 0.0), bh) * scale
+                d = h.get('d', 0.0)
+                length_h = h.get('length') or 0.0
+                if h.get('kind') == 'slot' and length_h > 0:
+                    r = max(d / 2.0 * scale, 2.0)
+                    overall = length_h + d
+                    path = self._build_slot_path(hx, hy, d, overall,
+                                                 h.get('angle') or 0.0, scale)
+                    p.setPen(QPen(slot_col, 0.9))
+                    p.setBrush(QColor(0, 0, 0, 60))
+                    p.drawPath(path)
+                    p.setPen(slot_col)
+                    p.drawText(QPointF(hx + r + 3, hy - 3),
+                               f'\u00d8{d:g}\u00d7{overall:g}')
+                else:
+                    r = max(d / 2.0 * scale, 2.5)
+                    p.setPen(QPen(hole_col, 0.9))
+                    p.setBrush(QColor(0, 0, 0, 40))
+                    p.drawEllipse(QPointF(hx, hy), r, r)
+                    p.setPen(hole_col)
+                    p.drawText(QPointF(hx + r + 3, hy - 3), f'\u00d8{d:g}')
+            base_y = top
+        self._draw_mini_profile(p, stype, dims)
+
+    def _draw_mini_profile(self, p, stype, dims):
+        H = dims[1] if len(dims) > 1 else 200.0
+        B = dims[2] if len(dims) > 2 else 100.0
+        tw = dims[3] if len(dims) > 3 else 10.0
+        tf = dims[4] if len(dims) > 4 else 10.0
+        box = 66
+        cx = self.width() - box / 2.0 - 6
+        cy = self.height() - box / 2.0 - 6
+        s = min(box * 0.8 / max(B, H, 1e-3), box * 0.8 / max(B, H, 1e-3))
+        w, hgt = max(B * s, 6.0), max(H * s, 6.0)
+        x0, y0 = cx - w / 2.0, cy - hgt / 2.0
+        path = QPainterPath()
+        if stype in ('I', 'H'):
+            path.addRect(QRectF(x0, y0, w, max(tf * s, 4.0)))
+            path.addRect(QRectF(x0, y0 + hgt - max(tf * s, 4.0), w, max(tf * s, 4.0)))
+            path.addRect(QRectF(x0 + (w - max(tw * s, 3.0)) / 2, y0,
+                                max(tw * s, 3.0), hgt))
+        elif stype in ('U', 'C', 'O'):
+            path.addRect(QRectF(x0, y0, w, max(tf * s, 4.0)))
+            path.addRect(QRectF(x0, y0 + hgt - max(tf * s, 4.0), w, max(tf * s, 4.0)))
+            path.addRect(QRectF(x0 + (w - max(tw * s, 3.0)) / 2, y0,
+                                max(tw * s, 3.0), hgt))
+        elif stype == 'L':
+            path.addRect(QRectF(x0, y0 + hgt - max(tf * s, 4.0), w, max(tf * s, 4.0)))
+            path.addRect(QRectF(x0, y0, max(tw * s, 4.0), hgt))
+        else:
+            path.addRect(QRectF(x0, y0, w, hgt))
+        p.setBrush(QColor(38, 50, 70, 150))
+        p.setPen(QPen(QColor(C.mut), 0.8))
+        p.drawPath(path)
+        p.setPen(QColor(C.mut))
+        p.setFont(QFont('Arial', 7))
+        p.drawText(QRectF(x0, y0 + hgt + 2, w, 14), Qt.AlignHCenter,
+                   (self._geometry.get('st') or {}).get('profile', stype))
+        # face labels on the section
+        p.setPen(QColor('#f59e0b'))
+        if stype in ('I', 'H'):
+            p.drawText(QRectF(x0 + w / 2 - 20, y0 + hgt / 2 - 12, 40, 24),
+                       Qt.AlignCenter, 'v')
+            p.drawText(QRectF(x0 + w / 2 - 20, y0 - 10, 40, 12), Qt.AlignHCenter, 'o')
+            p.drawText(QRectF(x0 + w / 2 - 20, y0 + hgt, 40, 12), Qt.AlignHCenter, 'u')
+        elif stype in ('U', 'C', 'O'):
+            p.drawText(QRectF(x0 + w / 2 - 20, y0 + hgt / 2 - 12, 40, 24),
+                       Qt.AlignCenter, 'v')
+            p.drawText(QRectF(x0 + w / 2 - 20, y0 - 10, 40, 12), Qt.AlignHCenter, 'o')
+            p.drawText(QRectF(x0 + w / 2 - 20, y0 + hgt, 40, 12), Qt.AlignHCenter, 'u')
+        elif stype == 'L':
+            p.drawText(QRectF(x0 - 20, y0 + hgt - 20, 20, 14), Qt.AlignCenter, 'v')
+            p.drawText(QRectF(x0 + w - 20, y0 + hgt - 20, 20, 14), Qt.AlignCenter, 'o')
+
+    def _halo_text(self, p, rect, label, color):
+        """Draw a label with a stencil halo (no frame hiding the view).
+
+        The text is drawn four times in the viewer background around the
+        final position, then once in the label colour -- the CAD-standard
+        readable text over a line without any box.
+        """
+        p.setFont(QFont('Arial', 9, QFont.Bold))
+        halo = QColor(self._mp.get('label_bg', C.bg))
+        p.setPen(halo)
+        for hx, hy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            p.drawText(rect.translated(hx, hy), Qt.AlignCenter, label)
+        p.setPen(color)
+        p.drawText(rect, Qt.AlignCenter, label)
+
+    def _arrow(self, p, line, color):
+        ang = math.atan2(-(line.y2() - line.y1()), line.x2() - line.x1())
+        a = math.radians(20)
+        l = 9.0
+        for x, y, direction in ((line.x1(), line.y1(), 1), (line.x2(), line.y2(), -1)):
+            p.setBrush(QBrush(color))
+            p.setPen(Qt.NoPen)
+            poly = QPolygonF([
+                QPointF(x, y),
+                QPointF(x - direction * l * math.cos(ang + a),
+                        y + direction * l * math.sin(ang + a)),
+                QPointF(x - direction * l * math.cos(ang - a),
+                        y + direction * l * math.sin(ang - a)),
+            ])
+            p.drawPolygon(poly)
+
+    def _draw_status(self, p):
+        # SPRINT 1 (CTO 2026-09-02, Injection 3 / D2): the status INFO line
+        # (profile / L / H / scale) is removed from the canvas -- "ONLY geometry
+        # and dimensions". The transient mode-hint (navigation aid) is KEPT.
+        hint = {'pan': 'Middle-drag = pan | Wheel = zoom | Click a hole = edit',
+                'rotate': 'Middle-drag = pan | Wheel = zoom | Click a hole = edit',
+                'measure': 'Click to add measurements (snaps to holes/edges, 0\u00b0/90\u00b0 alignment) | Esc = clear all'}.get(self.mode, '')
+        p.setPen(QColor(C.mut))
+        p.drawText(8, 14, hint)
