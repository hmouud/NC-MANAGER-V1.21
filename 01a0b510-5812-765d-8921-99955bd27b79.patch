+class SingleCogShape(PlateShape):
+    """Single cog tooth profile."""
+    name = "Single Cog"
+    category = "Special"
+    parameters = [
+        ShapeParam("Pitch radius", "pitch_radius", 80.0, 5.0, 5000.0),
+        ShapeParam("Tooth height", "tooth_height", 15.0, 1.0, 2000.0),
+        ShapeParam("Tooth width angle", "tooth_angle", 20.0, 1.0, 90.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["pitch_radius"]
+        th = p["tooth_height"]
+        ta = p["tooth_angle"]
+        r_base = R - th / 2
+        r_tip = R + th / 2
+        half_a = ta / 2
+        # Tooth: base arc, radial up, tip arc, radial down
+        base_left = _arc_pts(0, 0, r_base, -half_a - 30, -half_a, 8)
+        tip_arc = _arc_pts(0, 0, r_tip, -half_a, half_a, 12)
+        base_right = _arc_pts(0, 0, r_base, half_a, half_a + 30, 8)
+        # Bottom line connecting the two base arcs
+        outer = base_left + tip_arc + base_right
+        outer.append((r_base * math.cos(math.radians(half_a + 30)),
+                       r_base * math.sin(math.radians(-half_a - 30))))
+        return ShapeResult(outer=outer)
+
