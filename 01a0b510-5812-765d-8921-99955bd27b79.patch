+    def test_hole_rims_visible_when_zoomed_out(self):
+        # Regression: on long parts the true projected hole radius drops below
+        # one pixel, so holes become invisible/flickery in 3D. The rims must be
+        # drawn with a minimum on-screen radius at every rotation.
+        from PySide6.QtGui import QImage
+
+        def is_rose(px):
+            return px.red() > 200 and px.green() < 200 and px.blue() < 200
