+"""UI Mixins — domain modules extracted from app.py.
+
+Each mixin defines a set of related methods that live on NCManagerApp
+via multiple inheritance.  The main app.py imports these and composes
+them into the final application class.
+
+Domains:
+    UIBuilderMixin       — window construction, toolbar, panels, status
+    FileImportMixin      — CAD/DXF/DWG import, file drop, conflict resolution
+    FileManagementMixin  — table rendering, cell editing, delegates, dirty tracking
+    Viewer2D3DMixin      — 2D/3D/Blueprint views, zoom, grid, cotation, fold
+    HolesEditorMixin     — hole/slot CRUD, context menus, face assignment
+    OrderManagerMixin    — order creation, rename, move, copy, undo/redo
+    PartCreatorMixin     — profile wizard, shape reference, part editing
+    OrganizeMixin        — sort-into-folders popup
+    ExportMixin          — DXF/PDF/NC1 export, face preview
+    ProjectMixin         — project open/save/close, load
+    SettingsMixin        — theme, language, about, settings dialog
+    CloseQuitMixin       — save prompt, close, quit
+"""
+from .ui_builder import UIBuilderMixin
+from .file_import import FileImportMixin
+from .file_management import FileManagementMixin
+from .viewer_2d3d import Viewer2D3DMixin
+from .holes_editor import HolesEditorMixin
+from .order_manager import OrderManagerMixin
+from .part_creator import PartCreatorMixin
+from .organize import OrganizeMixin
+from .export import ExportMixin
+from .project import ProjectMixin
+from .settings_ui import SettingsMixin
+from .close_quit import CloseQuitMixin
+
+__all__ = [
+    'UIBuilderMixin',
+    'FileImportMixin',
+    'FileManagementMixin',
+    'Viewer2D3DMixin',
+    'HolesEditorMixin',
+    'OrderManagerMixin',
+    'PartCreatorMixin',
+    'OrganizeMixin',
+    'ExportMixin',
+    'ProjectMixin',
+    'SettingsMixin',
+    'CloseQuitMixin',
+]
