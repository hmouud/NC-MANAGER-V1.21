new file mode 100644
index 0000000..6a57a9c
--- /dev/null
+++ b/src/nccorrection/engine/math/osnap.py
@@ -0,0 +1,490 @@
+"""OSNAP - Object Snap engine (pure 2D geometry, no Qt).
+
+The mathematical foundation for CAD snapping. Every function operates on plain
+``(x, y)`` tuples in whatever coordinate space the caller feeds (scene space,
+screen space or a face-local frame), so the exact same math drives the classic
+2D viewer, the blueprint face view and the 3D viewer. Nothing in this module
+knows about widgets, DSTV, parts or themes.
+
+The design-layer facade ``nccorrection.design.snaps`` re-exports these symbols
+under the names the viewers already use; no viewer imports the engine math
+directly.
+
+Supported snaps:
+    endpoint     existing vertices / corners / hole centres
+    midpoint     middle of an edge / of an arc segment
+    nearest      closest point on any edge (perpendicular foot) or on an arc
+    intersection crossing of two edges (line-line) and of an edge with a
+                 circle (line-arc); both solved on the infinite lines, arc
+                 crossings filtered to the arc's angular span
+    centre       hole / circle centres
+    tangent      exact tangent points on a circle plus the nearest rim point
+                 when the cursor sits inside the circle
+    extension    a point on the infinite line of an edge beyond its ends
+    insertion    the part's reference / insertion point
+
+Polar tracking (``polar_snap``) is also provided here so the same math drives
+the AutoCAD-style polar guide in every viewer: when the cursor direction from
+the measure anchor lies within ``tol`` degrees of a multiple of ``increment``,
+the cursor is projected exactly onto that ray.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+ENDPOINT = 'endpoint'
+MIDPOINT = 'midpoint'
+NEAREST = 'nearest'
+INTERSECTION = 'intersection'
+CENTRE = 'centre'
+TANGENT = 'tangent'
+EXTENSION = 'extension'
+INSERTION = 'insertion'
+
+OSNAP_KINDS = (ENDPOINT, MIDPOINT, NEAREST, INTERSECTION, CENTRE, TANGENT,
+               EXTENSION, INSERTION)
+
+# lower wins on equal distance (a deterministic, CAD-style priority order)
+_PRIORITY = {ENDPOINT: 0, INTERSECTION: 1, CENTRE: 2, MIDPOINT: 3,
+             TANGENT: 4, NEAREST: 5, EXTENSION: 6, INSERTION: 7}
+
+#: A candidate closer than this (same units as the targets) is a dead-on hit:
+#: exact, so it always wins over near-but-stronger kinds inside the exact band.
+_DEAD_BAND = 0.5
+
+#: Public alias so the renderer can break cross-face ties the same way the
+#: per-face resolver does (lower number = stronger snap).
+SNAP_PRIORITY = _PRIORITY
+
+Pt = Tuple[float, float]
+Seg = Tuple[Pt, Pt]
+Circle = Tuple[float, float, float]
+#: Arc = (cx, cy, r, a0_deg, a1_deg) counter-clockwise from a0 to a1.
+Arc = Tuple[float, float, float, float, float]
+
+
+@dataclass
+class OsnapTargets:
+    """Everything a part exposes for snapping, in one coordinate space."""
+    points: list = field(default_factory=list)          # (x, y)
+    segments: list = field(default_factory=list)        # ((x1,y1),(x2,y2))
+    circles: list = field(default_factory=list)         # (cx, cy, r)
+    arcs: list = field(default_factory=list)            # (cx, cy, r, a0, a1)
+    insertion: Pt = (0.0, 0.0)
+
+
+def _dist(a: Pt, b: Pt) -> float:
+    return math.hypot(a[0] - b[0], a[1] - b[1])
+
+
+# --------------------------------------------------------------- primitives
+def closest_on_segment(p: Pt, a: Pt, b: Pt) -> Tuple[Pt, float]:
+    """Return (closest point on segment a-b to p, parameter t in [0, 1])."""
+    vx, vy = b[0] - a[0], b[1] - a[1]
+    l2 = vx * vx + vy * vy
+    if l2 < 1e-12:
+        return a, 0.0
+    t = ((p[0] - a[0]) * vx + (p[1] - a[1]) * vy) / l2
+    t = max(0.0, min(1.0, t))
+    return (a[0] + t * vx, a[1] + t * vy), t
+
+
+# ------------------------------------------------------------- polar tracking
+def polar_snap(p1: Pt, cursor: Pt, increment: float = 15.0,
+               tol: float = 2.0) -> Optional[Tuple[Pt, float]]:
+    """AutoCAD-style polar tracking from the anchor ``p1`` to ``cursor``.
+
+    When the cursor direction (``atan2`` of cursor-p1) lies within ``tol``
+    degrees of a multiple of ``increment``, returns
+    ``(point_on_that_ray, polar_angle_deg)`` with the cursor projected exactly
+    onto the ray; otherwise returns ``None``. A zero-length vector snaps to
+    the anchor at 0 degrees. Angles are measured full-circle 0..360 so a ray
+    to the left (180) and a ray down (270) are distinct tracking directions.
+    """
+    dx = cursor[0] - p1[0]
+    dy = cursor[1] - p1[1]
+    if abs(dx) < 1e-9 and abs(dy) < 1e-9:
+        return p1, 0.0
+    ang = math.degrees(math.atan2(dy, dx)) % 360.0
+    m = round(ang / increment) * increment
+    delta = abs(ang - m)
+    if delta > tol:
+        return None
+    m = m % 360.0
+    rad = math.radians(m)
+    d = dx * math.cos(rad) + dy * math.sin(rad)
+    if d < 0.0:
+        d = 0.0
+    return (p1[0] + d * math.cos(rad), p1[1] + d * math.sin(rad)), m
+
+
+# ------------------------------------------------------------- arc primitives
+def _arc_angle(cx: float, cy: float, pt: Pt) -> float:
+    """Polar angle in degrees (0..360) of ``pt`` about the arc centre."""
+    return math.degrees(math.atan2(pt[1] - cy, pt[0] - cx)) % 360.0
+
+
+def _arc_contains(angle: float, a0: float, a1: float) -> bool:
+    """True when ``angle`` lies inside the CCW arc span ``a0``..``a1``.
+
+    Handles spans that wrap past 360 (e.g. a0=270, a1=450).
+    """
+    a = angle % 360.0
+    a0 = a0 % 360.0
+    a1 = a1 % 360.0
+    if a1 < a0:
+        return a >= a0 or a <= a1
+    return a0 <= a <= a1
+
+
+def _ang_dist(a: float, b: float) -> float:
+    d = (a - b) % 360.0
+    return d if d <= 180.0 else 360.0 - d
+
+
+def closest_on_arc(p: Pt, arc: Arc) -> Tuple[Pt, float]:
+    """Return (closest point on arc to p, t_angle_rad)."""
+    cx, cy, r, a0, a1 = arc
+    ang = _arc_angle(cx, cy, p)
+    if _arc_contains(ang, a0, a1):
+        a = math.radians(ang)
+    elif _ang_dist(ang, a0) <= _ang_dist(ang, a1):
+        a = math.radians(a0)
+    else:
+        a = math.radians(a1)
+    return (cx + r * math.cos(a), cy + r * math.sin(a)), a
+
+
+def stadium_rim(cx: float, cy: float, width: float, length: float,
+                angle_deg: float = 0.0) -> Tuple[List[Seg], List[Arc]]:
+    """True stadium/stadion rim of width ``width`` and overall ``length``.
+
+    ``length`` is the OVERALL tip-to-tip length (the two drill holes that
+    form the slot plus the straight span between them), so the two end-cap
+    circle centres sit ``(length - width) / 2`` apart. ``angle_deg`` rotates
+    the long axis (0 = along +X). Returns ``(segments, arcs)`` describing the
+    exact same B-Rep the renderers draw:
+      * two tangent walls  -> segments
+      * two semicircular caps -> arcs (CCW from a0 to a1)
+    """
+    r = width / 2.0
+    half = (length - width) / 2.0
+    rad = math.radians(angle_deg % 360.0)
+    ax, ay = math.cos(rad), math.sin(rad)
+    px, py = -ay, ax
+    c1 = (cx - half * ax, cy - half * ay)
+    c2 = (cx + half * ax, cy + half * ay)
+    a = math.degrees(rad)
+    cap_m = (c1[0], c1[1], r, a + 90.0, a + 270.0)
+    cap_p = (c2[0], c2[1], r, a - 90.0, a + 90.0)
+    segs = [
+        ((c1[0] + px * r, c1[1] + py * r), (c2[0] + px * r, c2[1] + py * r)),
+        ((c1[0] - px * r, c1[1] - py * r), (c2[0] - px * r, c2[1] - py * r)),
+    ]
+    return segs, [cap_m, cap_p]
+
+
+def os_line_line_intersection(a: Pt, b: Pt, c: Pt, d: Pt) -> Optional[Pt]:
+    """Intersection of the infinite lines a-b and c-d (None if parallel).
+
+    Closed form from Cramer's rule on the two line equations; the result lies
+    on the infinite extensions, so extension snaps and corner copes work even
+    when the two edges do not literally touch.
+    """
+    x1, y1 = a
+    x2, y2 = b
+    x3, y3 = c
+    x4, y4 = d
+    den = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
+    if abs(den) < 1e-12:
+        return None
+    px = ((x1 * y2 - y1 * x2) * (x3 - x4) - (x1 - x2) * (x3 * y4 - y3 * x4)) / den
+    py = ((x1 * y2 - y1 * x2) * (y3 - y4) - (y1 - y2) * (x3 * y4 - y3 * x4)) / den
+    return px, py
+
+
+def os_line_arc_intersection(p: Pt, q: Pt, center: Pt,
+                             radius: float) -> List[Pt]:
+    """Intersection points of the infinite line through p,q and the circle.
+
+    Returns 0, 1 or 2 points. Solved as the classic quadratic:
+
+        point(t) = p + t*d            d = q - p
+        |point(t) - center|^2 = r^2
+        a = d.d   b = 2*d.(p-c)   c = |p-c|^2 - r^2
+        t = (-b +- sqrt(b^2 - 4ac)) / 2a
+
+    A negative discriminant means the line misses the circle; a zero
+    discriminant is the tangent case (one double root).
+    """
+    cx, cy = center
+    dx, dy = q[0] - p[0], q[1] - p[1]
+    a = dx * dx + dy * dy
+    if a < 1e-12:
+        return []
+    b = 2.0 * (dx * (p[0] - cx) + dy * (p[1] - cy))
+    c = (p[0] - cx) ** 2 + (p[1] - cy) ** 2 - radius * radius
+    disc = b * b - 4.0 * a * c
+    if disc < 0.0:
+        return []
+    if disc < 1e-12:
+        t = -b / (2.0 * a)
+        return [(p[0] + t * dx, p[1] + t * dy)]
+    sq = math.sqrt(disc)
+    t1 = (-b + sq) / (2.0 * a)
+    t2 = (-b - sq) / (2.0 * a)
+    return [(p[0] + t1 * dx, p[1] + t1 * dy),
+            (p[0] + t2 * dx, p[1] + t2 * dy)]
+
+
+# ----------------------------------------------------------- kind detectors
+# Each detector returns (point, kind) for the best candidate within ``tol`` of
+# the cursor, or None. The resolver then picks the closest enabled candidate,
+# breaking ties by priority.
+def os_endpoint(targets: OsnapTargets, pos: Pt, tol: float):
+    best, bd = None, tol
+    for p in targets.points:
+        d = _dist(p, pos)
+        if d <= bd:
+            bd, best = d, p
+    d = _dist(targets.insertion, pos)
+    if d <= bd:
+        best = targets.insertion
+    return (best, ENDPOINT) if best is not None else None
+
+
+def os_midpoint(targets: OsnapTargets, pos: Pt, tol: float):
+    best, bd = None, tol
+    for a, b in targets.segments:
+        m = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)
+        d = _dist(m, pos)
+        if d <= bd:
+            bd, best = d, m
+    for cx, cy, r, a0, a1 in targets.arcs:
+        a1b = a1 + (360.0 if a1 < a0 else 0.0)
+        am = math.radians((a0 + a1b) / 2.0)
+        m = (cx + r * math.cos(am), cy + r * math.sin(am))
+        d = _dist(m, pos)
+        if d <= bd:
+            bd, best = d, m
+    return (best, MIDPOINT) if best is not None else None
+
+
+def os_nearest(targets: OsnapTargets, pos: Pt, tol: float):
+    best, bd = None, tol
+    for a, b in targets.segments:
+        q, _ = closest_on_segment(pos, a, b)
+        d = _dist(q, pos)
+        if d <= bd:
+            bd, best = d, q
+    for arc in targets.arcs:
+        q, _ = closest_on_arc(pos, arc)
+        d = _dist(q, pos)
+        if d <= bd:
+            bd, best = d, q
+    return (best, NEAREST) if best is not None else None
+
+
+def os_intersection(targets: OsnapTargets, pos: Pt, tol: float):
+    """Line-line intersections plus line-arc (edge crossed with a hole).
+
+    Arc crossings are computed against the arc's underlying circle and then
+    filtered to the arc's angular span, so a slot's semicircular cap only
+    reports intersections that lie on the drawn arc.
+    """
+    best, bd = None, tol
+    segs = targets.segments
+    n = len(segs)
+    for i in range(n):
+        a, b = segs[i]
+        for j in range(i + 1, n):
+            c, d = segs[j]
+            pt = os_line_line_intersection(a, b, c, d)
+            if pt is None:
+                continue
+            dist = _dist(pt, pos)
+            if dist <= bd:
+                bd, best = dist, pt
+        for cx, cy, r in targets.circles:
+            for pt in os_line_arc_intersection(a, b, (cx, cy), r):
+                dist = _dist(pt, pos)
+                if dist <= bd:
+                    bd, best = dist, pt
+        for cx, cy, r, a0, a1 in targets.arcs:
+            for pt in os_line_arc_intersection(a, b, (cx, cy), r):
+                if not _arc_contains(_arc_angle(cx, cy, pt), a0, a1):
+                    continue
+                dist = _dist(pt, pos)
+                if dist <= bd:
+                    bd, best = dist, pt
+    return (best, INTERSECTION) if best is not None else None
+
+
+def os_center(targets: OsnapTargets, pos: Pt, tol: float):
+    best, bd = None, tol
+    for cx, cy, _r in targets.circles:
+        d = _dist((cx, cy), pos)
+        if d <= bd:
+            bd, best = d, (cx, cy)
+    return (best, CENTRE) if best is not None else None
+
+
+def os_tangent(targets: OsnapTargets, pos: Pt, tol: float):
+    """Exact tangent points from the cursor to each circle / arc.
+
+    A tangent point T on a circle (C, r) satisfies the right-triangle rule
+    |CT| = r and CT perpendicular to the tangent line, so the angle at C is
+    given by ``acos(r / |P-C|)``. Two symmetric solutions exist for a point
+    outside the circle; when the cursor is inside, snap to the nearest rim
+    point instead (the projected radial point). Arc tangents are filtered to
+    the arc's angular span so a slot cap only offers tangents on the drawn
+    semicircle.
+    """
+    best, bd = None, tol
+    for cx, cy, r in targets.circles:
+        res = _tangent_points(pos, cx, cy, r, bd)
+        if res is None:
+            continue
+        pt, d = res
+        bd, best = d, pt
+    for cx, cy, r, a0, a1 in targets.arcs:
+        dx, dy = pos[0] - cx, pos[1] - cy
+        l = math.hypot(dx, dy)
+        if l < 1e-9:
+            continue
+        base = math.atan2(dy, dx)
+        if l <= r:
+            ta = base
+            cand = (cx + math.cos(ta) * r, cy + math.sin(ta) * r)
+            if _arc_contains(_arc_angle(cx, cy, cand), a0, a1):
+                d = _dist(cand, pos)
+                if d <= bd:
+                    bd, best = d, cand
+            else:
+                cand, _ = closest_on_arc(pos, (cx, cy, r, a0, a1))
+                d = _dist(cand, pos)
+                if d <= bd:
+                    bd, best = d, cand
+            continue
+        aoff = math.acos(r / l)
+        for off in (aoff, -aoff):
+            ta = base + off
+            cand = (cx + math.cos(ta) * r, cy + math.sin(ta) * r)
+            if not _arc_contains(_arc_angle(cx, cy, cand), a0, a1):
+                continue
+            d = _dist(cand, pos)
+            if d <= bd:
+                bd, best = d, cand
+    return (best, TANGENT) if best is not None else None
+
+
+def _tangent_points(pos, cx, cy, r, bd):
+    """Best tangent candidate from ``pos`` to a full circle, or None."""
+    dx, dy = pos[0] - cx, pos[1] - cy
+    l = math.hypot(dx, dy)
+    if l < 1e-9:
+        return None
+    if l <= r:
+        pt = (cx + dx / l * r, cy + dy / l * r)
+        d = _dist(pt, pos)
+        return (pt, d) if d <= bd else None
+    base = math.atan2(dy, dx)
+    aoff = math.acos(r / l)
+    best, bd_ = None, bd
+    for off in (aoff, -aoff):
+        ta = base + off
+        pt = (cx + math.cos(ta) * r, cy + math.sin(ta) * r)
+        d = _dist(pt, pos)
+        if d <= bd_:
+            bd_, best = d, pt
+    return (best, bd_) if best is not None else None
+
+
+def os_extension(targets: OsnapTargets, pos: Pt, tol: float):
+    """Point on an edge's infinite line outside its [0, 1] parameter range."""
+    best, bd = None, tol
+    for a, b in targets.segments:
+        vx, vy = b[0] - a[0], b[1] - a[1]
+        l2 = vx * vx + vy * vy
+        if l2 < 1e-12:
+            continue
+        t = ((pos[0] - a[0]) * vx + (pos[1] - a[1]) * vy) / l2
+        if 0.0 <= t <= 1.0:
+            continue
+        q = (a[0] + t * vx, a[1] + t * vy)
+        d = _dist(q, pos)
+        if d <= bd:
+            bd, best = d, q
+    return (best, EXTENSION) if best is not None else None
+
+
+def os_insertion(targets: OsnapTargets, pos: Pt, tol: float):
+    d = _dist(targets.insertion, pos)
+    return (targets.insertion, INSERTION) if d <= tol else None
+
+
+_SNAPS = {
+    ENDPOINT: os_endpoint,
+    MIDPOINT: os_midpoint,
+    NEAREST: os_nearest,
+    INTERSECTION: os_intersection,
+    CENTRE: os_center,
+    TANGENT: os_tangent,
+    EXTENSION: os_extension,
+    INSERTION: os_insertion,
+}
+
+
+def resolve_osnap(targets: OsnapTargets, pos: Pt, enabled=OSNAP_KINDS,
+                  tol=12.0, exact_band=0.0):
+    """Pick the best snap for ``pos`` among the enabled kinds.
+
+    Returns ``(point, kind, distance)`` or ``None`` when nothing is within
+    ``tol``. Selection is two-band (CAD-style):
+
+    * **exact band** (``d <= exact_band``): the highest-priority kind wins,
+      ties broken by distance - so near a corner an endpoint/intersection
+      dominates a slightly closer nearest/extension snap instead of flickering.
+    * **normal band** (``exact_band < d <= tol``): the closest point wins,
+      ties broken by priority.
+
+    With the default ``exact_band=0.0`` the exact band never fires and the
+    result is purely "closest point, priority on equal distance" - the
+    historical behaviour.
+    """
+    exact, normal = None, None
+    exact_d = normal_d = float('inf')
+    exact_k = normal_k = None
+    exact_p = normal_p = 99
+    dead = dead_k = None
+    dead_d = float('inf')
+    for kind in OSNAP_KINDS:
+        if kind not in enabled:
+            continue
+        res = _SNAPS[kind](targets, pos, tol)
+        if not res:
+            continue
+        pt, _ = res
+        d = _dist(pt, pos)
+        if d > tol:
+            continue
+        prio = _PRIORITY[kind]
+        if d <= _DEAD_BAND and d < dead_d:
+            # dead-on exact hit: always wins, so clicking the middle of a
+            # slot grabs CENTRE rather than a nearby wall-cap junction
+            dead, dead_k, dead_d = pt, kind, d
+        if exact_band > 0.0 and d <= exact_band:
+            if prio < exact_p or (prio == exact_p and d < exact_d):
+                exact, exact_d, exact_k, exact_p = pt, d, kind, prio
+        elif d < normal_d or (d == normal_d and prio < normal_p):
+            normal, normal_d, normal_k, normal_p = pt, d, kind, prio
+    if dead is not None:
+        return dead, dead_k, dead_d
+    if exact is not None:
+        return exact, exact_k, exact_d
+    if normal is not None:
+        return normal, normal_k, normal_d
+    return None
