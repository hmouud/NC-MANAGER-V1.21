index 0000000..e40c89d
--- /dev/null
+++ b/src/nccorrection/engine/cotation/auto_dim.py
@@ -0,0 +1,138 @@
+"""Cotation engine — auto-dimensioning along grid lines and part geometry.
+
+Automatically generates dimension sets for:
+- Grid-based layout (X, Y, or both axes)
+- Part boundaries (bounding box of entities)
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Tuple
+
+from .models import DimensionSet, DimensionStyle
+from .linear import horizontal, vertical
+
+
+def auto_grid_x(
+    grid_xs: List[float],
+    y: float,
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Create horizontal dimensions along grid X positions at a given Y.
+
+    *grid_xs* must be sorted ascending.
+    """
+    if len(grid_xs) < 2:
+        return DimensionSet(kind="horizontal", offset=offset,
+                            style=style or DimensionStyle())
+    points = [(x, y) for x in grid_xs]
+    return horizontal(points, offset=offset, style=style)
+
+
+def auto_grid_y(
+    grid_ys: List[float],
+    x: float,
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Create vertical dimensions along grid Y positions at a given X.
+
+    *grid_ys* must be sorted ascending.
+    """
+    if len(grid_ys) < 2:
+        return DimensionSet(kind="vertical", offset=offset,
+                            style=style or DimensionStyle())
+    points = [(x, y) for y in grid_ys]
+    return vertical(points, offset=offset, style=style)
+
+
+def auto_bounding_box(
+    entities: List,
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> List[DimensionSet]:
+    """Auto-dimension the bounding box of a list of canvas entities.
+
+    Returns up to 2 DimensionSets (horizontal + vertical) covering
+    the extreme corners of all entities.
+    """
+    all_x = []
+    all_y = []
+
+    for ent in entities:
+        kind = getattr(ent, "kind", "")
+        if kind == "line":
+            for pt in ent.points:
+                all_x.append(pt[0])
+                all_y.append(pt[1])
+        elif kind == "arc":
+            cx, cy = ent.center
+            r = ent.radius
+            all_x.extend([cx - r, cx + r])
+            all_y.extend([cy - r, cy + r])
+        elif kind == "circle":
+            cx, cy = ent.center
+            r = ent.radius
+            all_x.extend([cx - r, cx + r])
+            all_y.extend([cy - r, cy + r])
+        elif kind == "rect":
+            for pt in ent.points:
+                all_x.append(pt[0])
+                all_y.append(pt[1])
+
+    if not all_x or not all_y:
+        return []
+
+    result = []
+    min_x, max_x = min(all_x), max(all_x)
+    min_y, max_y = min(all_y), max(all_y)
+
+    if max_x - min_x > 0.1:
+        pts = [(min_x, min_y), (max_x, min_y)]
+        result.append(horizontal(pts, offset=offset, style=style))
+
+    if max_y - min_y > 0.1:
+        pts = [(min_x, min_y), (min_x, max_y)]
+        result.append(vertical(pts, offset=offset, style=style))
+
+    return result
+
+
+def auto_grid_from_spacing(
+    x_start: float,
+    x_end: float,
+    y_start: float,
+    y_end: float,
+    spacing_x: float,
+    spacing_y: float,
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> List[DimensionSet]:
+    """Generate a full grid of dimensions from start/end positions and spacing.
+
+    Returns a list of DimensionSets covering the grid.
+    """
+    xs = []
+    x = x_start
+    while x <= x_end + 1e-6:
+        xs.append(round(x, 6))
+        x += spacing_x
+
+    ys = []
+    y = y_start
+    while y <= y_end + 1e-6:
+        ys.append(round(y, 6))
+        y += spacing_y
+
+    result = []
+    if len(xs) >= 2:
+        result.append(auto_grid_x(xs, y_start, offset=offset, style=style))
+    if len(ys) >= 2:
+        result.append(auto_grid_y(ys, x_start, offset=offset, style=style))
+
+    return result
diff --git a/src/nccorrection/engine/cotation/chain.py b/src/nccorrection/engine/cotation/chain.py
