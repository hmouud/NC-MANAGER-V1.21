+"""Holes & Slots editing mixin for NCManagerApp.
+
+Extracted from ``app.py`` to keep the holes-editing domain in a single,
+focused file.  Every method accesses application state through ``self``
+(the host ``NCManagerApp`` instance).
+"""
+
+from __future__ import annotations
+
+from PySide6.QtCore import Qt
+from PySide6.QtGui import QColor
+from PySide6.QtWidgets import QMenu, QTableWidgetItem
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.core.nc1_writer import valid_faces
+from nccorrection.engine.dxf.dxf_parser import read_dxf, plate_thickness
+
+# Canonical dark QMenu look for viewer context menus.
+_VIEWER_MENU_QSS = """
+    QMenu { background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; }
+    QMenu::item { padding: 4px 24px 4px 8px; color: #f8fafc; }
+    QMenu::item:selected { background: #334155; }
+"""
+
+
+class HolesEditorMixin:
+    """Mixin that groups every hole/slot editing operation.
+
+    The host class (``NCManagerApp``) must expose the attributes and
+    methods these methods rely on via ``self``.
+    """
+
+    # ---------------------------------------------------------------- populate
+    def _populate_holes_table(self, f):
+        self.holes_table.blockSignals(True)
+        self.holes_table.setRowCount(0)
+        if self._dxf_file(f):
+            # DXF holes are READ-ONLY (owner 2026-08-20): shown for
+            # inspection, never editable in this version.
+            geometry = None
+            try:
+                profile = f.get('profile') or 'PL10'
+                geometry = read_dxf(path=f.get('path'), text=f.get('text'),
+                                    thickness=plate_thickness(profile),
+                                    profile=profile)
+            except Exception as e:
+                self._report_error('holes-table-dxf-read', e, status=True)
+                geometry = None
+            if geometry is None:
+                self.holes_table.blockSignals(False)
+                return
+            holes = geometry.get('holes', [])
+            self._current_active = list(range(len(holes)))
+            self.holes_table.setRowCount(len(holes))
+            for r, h in enumerate(holes):
+                values = [
+                    (h.get('face', '') or '').upper(),
+                    self.tr_('slot') if h['kind'] == 'slot' else self.tr_('hole'),
+                    f"{h['x']:.2f}", f"{h['y']:.2f}",
+                    f"{h['d']:.1f}",
+                    f"{h.get('length', 0):.1f}" if h['kind'] == 'slot' else '',
+                ]
+                for c, val in enumerate(values):
+                    it = QTableWidgetItem(val)
+                    it.setData(Qt.UserRole, r)
+                    it.setToolTip(self.tr_('dxf_holes_readonly'))
+                    self.holes_table.setItem(r, c, it)
+            self.holes_table.blockSignals(False)
+            return
+        try:
+            geometry = parse_geometry(f['text'])
+        except Exception as e:
+            self._report_error('holes-table-parse', e, status=True)
+            geometry = None
+        if geometry is None:
+            self.holes_table.blockSignals(False)
+            return
+        overrides = self.hole_overrides.get(f['hash'], {})
+        deleted = self.hole_deleted.get(f['hash'], set())
+        added = self.added_holes.get(f['hash'], [])
+        from nccorrection.core.hole_ops import apply_edits
+        try:
+            geometry, active = apply_edits(geometry, overrides, deleted, added)
+        except Exception as e:
+            self._report_error('holes-table-apply-edits', e, status=True)
+            active = []
+        self._current_active = active
+        holes = geometry.get('holes', [])
+        self.holes_table.setRowCount(len(holes))
+        for r, h in enumerate(holes):
+            orig = active[r] if r < len(active) else r
+            values = [
+                (h.get('face', '') or '').upper(),
+                self.tr_('slot') if h['kind'] == 'slot' else self.tr_('hole'),
+                f"{h['x']:.2f}", f"{h['y']:.2f}",
+                f"{h['d']:.1f}",
+                f"{h.get('length', 0):.1f}" if h['kind'] == 'slot' else '',
+            ]
+            edited = orig in overrides or orig < 0
+            for c, val in enumerate(values):
+                it = QTableWidgetItem(val)
+                it.setData(Qt.UserRole, orig)
+                if edited and c in (4, 5):
+                    it.setForeground(QColor(self._theme['yel']))
+                if c in (4, 5):
+                    it.setToolTip(self.tr_('edit_diameter_hint'))
+                self.holes_table.setItem(r, c, it)
+        self.holes_table.blockSignals(False)
+
+    # ---------------------------------------------------------------- context menu
+    def _holes_context_menu(self, pos):
+        if not self._current_file:
+            return
+        if self._dxf_file(self._current_file):
+            # DXF holes are read-only in this version
+            self._toast(self.tr_('dxf_holes_readonly'), kind='warn')
+            return
+        row = self.holes_table.rowAt(pos.y())
+        if row < 0 or row >= len(getattr(self, '_current_active', [])):
+            self._holes_context_blank(pos)
+            return
+        orig = self._current_active[row]
+        menu = QMenu(self)
+        act_copy = menu.addAction(self.tr_('hole_copy'))
+        act_paste = menu.addAction(self.tr_('hole_paste'))
+        act_paste.setEnabled(bool(getattr(self, '_hole_clipboard', None)))
+        menu.addSeparator()
+        act_edit = menu.addAction(self.tr_('hole_edit'))
+        act_clone = menu.addAction(self.tr_('hole_clone'))
+        act_del = menu.addAction(self.tr_('hole_delete'))
+        menu.addSeparator()
+        face_menu = menu.addMenu(self.tr_('hole_face'))
+        faces = self._holes_faces()
+        for fa in faces:
+            a = face_menu.addAction(fa)
+            a.setCheckable(True)
+            a.setChecked(self._face_at(orig) == fa)
+            a.triggered.connect(lambda _=False, ff=fa: self._set_hole_face(orig, ff))
+        sel = menu.exec(self.holes_table.viewport().mapToGlobal(pos))
+        if sel == act_copy:
+            self._copy_holes()
+        elif sel == act_paste:
+            self._paste_holes()
+        elif sel == act_edit:
+            self._edit_hole_by_index(orig)
+        elif sel == act_clone:
+            self._clone_hole(orig)
+        elif sel == act_del:
+            self._delete_hole(orig)
+
+    def _holes_context_blank(self, pos):
+        if self._current_file and self._dxf_file(self._current_file):
+            self._toast(self.tr_('dxf_holes_readonly'), kind='warn')
+            return
+        menu = QMenu(self)
+        act_add = menu.addAction(self.tr_('hole_add'))
+        menu.addSeparator()
+        act_paste = menu.addAction(self.tr_('hole_paste'))
+        act_paste.setEnabled(bool(getattr(self, '_hole_clipboard', None)))
+        sel = menu.exec(self.holes_table.viewport().mapToGlobal(pos))
+        if sel == act_add:
+            self._add_hole()
+        elif sel == act_paste:
+            self._paste_holes()
+
+    # ---------------------------------------------------------------- profile / faces
+    def _profile_type(self):
+        f = self._current_file
+        try:
+            return (parse_geometry(f['text']).get('st') or {}).get('type') or 'B'
+        except Exception as e:
+            self._report_error('profile-type', e)
+            return 'B'
+
+    def _holes_faces(self):
+        """Faces a hole may be placed on, resolved from the parsed part.
+
+        The faces that *physically exist* are read from the AK contour blocks
+        of the parsed file, intersected with the faces the profile family
+        supports. This keeps an L-profile from offering non-existent h/o
+        faces even when the static family table is permissive.
+
+        Dynamic extraction: reads the actual contour face letters ('v','o','u','h')
+        from the parsed DSTV AK blocks, rather than relying on a static family table.
+        """
+        f = self._current_file
+        if not f:
+            return []
+        try:
+            g = parse_geometry(f['text'])
+            seen = g.get('contour_faces') or []
+            if seen:
+                # Dynamically return only faces that exist in the parsed part
+                # Intersect with profile family supported faces
+                family_faces = valid_faces(self._profile_type())
+                # Return faces that are both in the parsed part AND supported by family
+                dynamic_faces = [x for x in seen if x in family_faces]
+                if dynamic_faces:
+                    return dynamic_faces
+                # If parsed part has faces not in family, family wins
+                return family_faces
+        except Exception as e:
+            self._report_error('holes-faces', e)
+            pass
+        # Fallback to static family validation
+        return valid_faces(self._profile_type())
+
+    def _face_at(self, orig):
+        f = self._current_file
+        try:
+            holes = parse_geometry(f['text']).get('holes', [])
+            if 0 <= orig < len(holes):
+                ov = self.hole_overrides.get(f['hash'], {}).get(orig)
+                if isinstance(ov, dict) and ov.get('face'):
+                    return ov['face']
+                return holes[orig].get('face', 'v')
+            if orig < 0:
+                lst = self.added_holes.get(f['hash'], [])
+                idx = -orig - 1
+                if 0 <= idx < len(lst):
+                    return lst[idx].get('face', 'v')
+        except Exception as e:
+            self._report_error('face-at', e)
+            pass
+        return 'v'
+
+    # ---------------------------------------------------------------- face / delete / add / clone
+    def _set_hole_face(self, orig, face):
+        if not self._current_file:
+            return
+        f = self._current_file
+        ov = dict(self.hole_overrides.get(f['hash'], {}))
+        if orig >= 0:
+            entry = dict(ov.get(orig, {})) if isinstance(ov.get(orig), dict) else {}
+            entry['face'] = face
+            ov[orig] = entry
+        else:
+            lst = list(self.added_holes.get(f['hash'], []))
+            idx = -orig - 1
+            if 0 <= idx < len(lst):
+                lst[idx] = dict(lst[idx])
+                lst[idx]['face'] = face
+                self.added_holes[f['hash']] = lst
+        self._push_undo()
+        if orig >= 0:
+            self.hole_overrides[f['hash']] = ov
+        self._mark_dirty(f)
+        self._refresh_viewers(f, preserve_view=True)
+        self._populate_holes_table(f)
+        self.audit.log(f'Hole {orig} face -> {face} for {f["name"]}', 'ok', 'OK-110')
+
+    def _delete_hole(self, orig):
+        if not self._current_file:
+            return
+        f = self._current_file
+        if orig >= 0:
+            deleted = set(self.hole_deleted.get(f['hash'], set()))
+            deleted.add(orig)
+            self.hole_deleted[f['hash']] = deleted
+        else:
+            lst = list(self.added_holes.get(f['hash'], []))
+            idx = -orig - 1
+            if 0 <= idx < len(lst):
+                lst.pop(idx)
+                self.added_holes[f['hash']] = lst
+        self._push_undo()
+        self._mark_dirty(f)
+        self._refresh_viewers(f, preserve_view=True)
+        self._populate_holes_table(f)
+        self.audit.log(f'Hole {orig} deleted for {f["name"]}', 'ok', 'OK-110')
+
+    def _add_hole(self, hole=None):
+        if not self._current_file:
+            return
+        f = self._current_file
+        if hole is None:
+            hole = {'face': self._holes_faces()[0],
+                    'x': 0.0, 'y': 0.0, 'd': 14.0,
+                    'length': 0.0, 'angle': 0.0}
+        lst = list(self.added_holes.get(f['hash'], []))
+        lst.append(hole)
+        self.added_holes[f['hash']] = lst
+        new_orig = -(len(lst))
+        self._push_undo()
+        self._mark_dirty(f)
+        self._refresh_viewers(f, preserve_view=True)
+        self._populate_holes_table(f)
+        self._edit_hole_by_index(new_orig)
+        self.audit.log(f'Hole added for {f["name"]}', 'ok', 'OK-110')
+
+    def _clone_hole(self, orig):
+        if not self._current_file:
+            return
+        f = self._current_file
+        try:
+            geometry = parse_geometry(f['text'])
+            holes = geometry.get('holes', [])
+        except Exception as e:
+            self._report_error('clone-hole-parse', e, toast=True)
+            return
+        if orig >= 0 and 0 <= orig < len(holes):
+            base = holes[orig]
+        elif orig < 0:
+            lst = self.added_holes.get(f['hash'], [])
+            idx = -orig - 1
+            if not (0 <= idx < len(lst)):
+                return
+            base = lst[idx]
+        else:
+            return
+        ov = self.hole_overrides.get(f['hash'], {}).get(orig, {})
+        if isinstance(ov, dict):
+            for k, v in ov.items():
+                if v is not None:
+                    base = dict(base)
+                    base[k] = v
+        copy = {'face': base.get('face', 'v'),
+                'x': float(base.get('x', 0.0)) + 50.0,
+                'y': float(base.get('y', 0.0)),
+                'd': float(base.get('d', 14.0)),
+                'length': float(base.get('length') or 0.0),
+                'angle': float(base.get('angle') or 0.0)}
+        self._add_hole(copy)
+
+    # ------------------------------------------------------------ P7 holes copy/paste
+    def _copy_holes(self, orig=None):
+        """P7: Ctrl+C on the holes panel - remember the selected hole
+        definitions (face, position, diameter, slot length/angle). The
+        clipboard is app-level: it survives switching the current file.
+
+        ``orig`` (right-click in a viewer): copy THAT single hole/slot."""
+        if not self._current_file:
+            return
+        f = self._current_file
+        if orig is not None:
+            h = self._base_hole(orig)
+            if h is None:
+                self._set_status(self.tr_('hole_copy_none'))
+                return
+            self._hole_clipboard = [{'face': h.get('face', 'v'),
+                                     'x': float(h.get('x', 0.0)),
+                                     'y': float(h.get('y', 0.0)),
+                                     'd': float(h.get('d', 14.0)),
+                                     'length': float(h.get('length') or 0.0),
+                                     'angle': float(h.get('angle') or 0.0)}]
+            self._set_status(self.tr_('hole_copy_done').format(n=1))
+            return
+        try:
+            geometry = parse_geometry(f['text'])
+            holes = geometry.get('holes', [])
+        except Exception as e:
+            self._report_error('copy-holes-parse', e, toast=True)
+            return
+        added = self.added_holes.get(f['hash'], [])
+        overrides = self.hole_overrides.get(f['hash'], {})
+        sm = self.holes_table.selectionModel()
+        rows = sorted({idx.row() for idx in sm.selectedRows()})
+        if not rows:
+            self._set_status(self.tr_('hole_copy_none'))
+            return
+        clip = []
+        for r in rows:
+            if r >= len(getattr(self, '_current_active', [])):
+                continue
+            orig = self._current_active[r]
+            if orig >= 0 and 0 <= orig < len(holes):
+                base = dict(holes[orig])
+                ov = overrides.get(orig)
+                if isinstance(ov, dict):
+                    for k, v in ov.items():
+                        if v is not None:
+                            base[k] = v
+            elif orig < 0:
+                idx = -orig - 1
+                if not (0 <= idx < len(added)):
+                    continue
+                base = dict(added[idx])
+            else:
+                continue
+            clip.append({'face': base.get('face', 'v'),
+                         'x': float(base.get('x', 0.0)),
+                         'y': float(base.get('y', 0.0)),
+                         'd': float(base.get('d', 14.0)),
+                         'length': float(base.get('length') or 0.0),
+                         'angle': float(base.get('angle') or 0.0)})
+        if not clip:
+            self._set_status(self.tr_('hole_copy_none'))
+            return
+        self._hole_clipboard = clip
+        self._set_status(self.tr_('hole_copy_done').format(n=len(clip)))
+
+    def _paste_holes(self):
+        """P7: Ctrl+V on the holes panel - paste the copied holes onto the
+        CURRENT part. Asks first: same faces, or choose other faces (change
+        plane)? Works on ANY part, even after switching files entirely."""
+        from PySide6.QtWidgets import QInputDialog
+        if not self._current_file:
+            self._set_status(self.tr_('hole_paste_nofile'))
+            return
+        if not getattr(self, '_hole_clipboard', None):
+            self._set_status(self.tr_('hole_clipboard_empty'))
+            return
+        f = self._current_file
+        faces = self._holes_faces()
+        choice, ok = QInputDialog.getItem(
+            self, self.tr_('hole_paste_title'), self.tr_('hole_paste_ask'),
+            [self.tr_('hole_paste_same'), self.tr_('hole_paste_choose'),
+             self.tr_('cancel')], 0, False)
+        if not ok or choice == self.tr_('cancel'):
+            return
+        chosen_face = None
+        if choice == self.tr_('hole_paste_choose'):
+            if not faces:
+                return
+            chosen_face, ok2 = QInputDialog.getItem(
+                self, self.tr_('hole_paste_title'), self.tr_('hole_paste_face'),
+                faces, 0, False)
+            if not ok2:
+                return
+        lst = list(self.added_holes.get(f['hash'], []))
+        pasted = 0
+        for h in self._hole_clipboard:
+            face = chosen_face or h.get('face', 'v')
+            if face not in faces:
+                face = faces[0] if faces else 'v'
+            lst.append({'face': face,
+                        'x': float(h.get('x', 0.0)),
+                        'y': float(h.get('y', 0.0)),
+                        'd': float(h.get('d', 14.0)),
+                        'length': float(h.get('length') or 0.0),
+                        'angle': float(h.get('angle') or 0.0)})
+            pasted += 1
+        self.added_holes[f['hash']] = lst
+        self._push_undo()
+        self._mark_dirty(f)
+        self._refresh_viewers(f, preserve_view=True)
+        self._populate_holes_table(f)
+        self._set_status(self.tr_('hole_paste_done').format(n=pasted))
+        self.audit.log(f'Holes pasted: {pasted} onto {f["name"]} '
+                       f'(faces: {chosen_face or "same"})', 'ok', 'OK-116')
+
+    # ---------------------------------------------------------------- viewer hole menu
+    def _build_hole_menu(self, row):
+        """Right-click context menu for a hole/slot in any viewer.
+
+        Owner rule: hole/slot editing from EVERY view (2D, 3D, blueprint) -
+        Edit, Change plane, Copy hole, Paste hole, Delete - no drag."""
+        if not self._current_file:
+            return None
+        active = getattr(self, '_current_active', None)
+        if not active or not (0 <= row < len(active)):
+            return None
+        orig = active[row]
+        h = self._base_hole(orig)
+        if h is None:
+            return None
+        menu = QMenu(self)
+        menu.setStyleSheet(_VIEWER_MENU_QSS)
+        kind = self.tr_('slot') if h.get('kind') == 'slot' \
+            else self.tr_('hole')
+        act = menu.addAction(self.tr_('edit') + ' ' + kind)
+        act.triggered.connect(
+            lambda: self.dialog_manager.open_hole_editor(orig))
+        face_menu = menu.addMenu(self.tr_('hole_change_plane'))
+        current_face = h.get('face') or 'v'
+        for face in self._holes_faces():
+            a = face_menu.addAction(face)
+            a.setCheckable(True)
+            a.setChecked(face == current_face)
+            a.triggered.connect(
+                lambda checked, fc=face: self._set_hole_face(orig, fc))
+        menu.addSeparator()
+        act = menu.addAction(self.tr_('hole_copy'))
+        act.triggered.connect(lambda: self._copy_holes(orig))
+        act = menu.addAction(self.tr_('hole_paste'))
+        act.setEnabled(bool(self._hole_clipboard))
+        act.triggered.connect(lambda: self._paste_holes())
+        menu.addSeparator()
+        act = menu.addAction(self.tr_('delete'))
+        act.triggered.connect(lambda: self._delete_hole(orig))
+        return menu
+
+    # ---------------------------------------------------------------- start add hole
+    def _start_add_hole(self, view, local_pos):
+        """[+] Add Hole/Slot - create a NEW hole at the clicked position.
+
+        Appends a base hole record to the file's added-holes store (the same
+        store the paste flow uses), then opens the hole editor on that
+        record in ADD mode. ``pre_state`` is captured BEFORE the insertion
+        so cancel/undo remove the record together with the edit. Accept
+        merges it via HoleEditService.apply_hole_override (negative index).
+
+        The click maps to DSTV part coordinates per viewer: 2D uses the 2D
+        scene transform; blueprint uses the face canvas under the cursor
+        (``dstv_point_at``); 3D uses the hit-tested surface mapped through
+        the real face planes (``pick_dstv``). Empty space in 3D/blueprint
+        falls back to the part centre on face v (CTO).
+        """
+        f = self._current_file
+        if f is None:
+            self._set_status(self.tr_('create_no_project'))
+            return
+        if self._measuring():
+            return
+        x = y = 0.0
+        face = 'v'
+        try:
+            if view == '3d':
+                res = self.viewer3d.pick_dstv(local_pos)
+                if res is None:
+                    face, x, y = self.viewer3d.center_dstv()
+                else:
+                    face, x, y = res
+            elif view == 'faces':
+                res = self.face_viewer.dstv_point_at(
+                    local_pos.x(), local_pos.y())
+                if res is None:
+                    face, x, y = self.viewer3d.center_dstv()
+                else:
+                    face, x, y = res
+            else:
+                cx, cy = self.viewer._to_scene(local_pos.x(), local_pos.y())
+                x, y = cx, cy
+        except Exception as e:
+            self._report_error('start-add-hole-to-scene', e, toast=True)
+            x = y = 0.0
+        pre = self._snapshot_state()
+        added = self.added_holes.setdefault(f['hash'], [])
+        idx = -len(added) - 1
+        new_h = {'kind': 'hole', 'face': face, 'x': x, 'y': y,
+                 'd': 10.0, 'length': 0.0, 'angle': 0.0}
+        added.append(new_h)
+        self.dialog_manager.open_hole_editor(idx, new_h, pre_state=pre)
+
+    # ---------------------------------------------------------------- base hole / edit
+    def _base_hole(self, orig):
+        """Return the current (override-applied) hole dict for an original index."""
+        f = self._current_file
+        try:
+            geometry = parse_geometry(f['text'])
+            holes = geometry.get('holes', [])
+        except Exception as e:
+            self._report_error('base-hole-parse', e)
+            holes = []
+        ov = self.hole_overrides.get(f['hash'], {}).get(orig) if orig >= 0 else None
+        if 0 <= orig < len(holes):
+            h = holes[orig]
+            if isinstance(ov, dict):
+                h = dict(h)
+                for k in ('x', 'y', 'd', 'face', 'length', 'angle'):
+                    if ov.get(k) is not None:
+                        h[k] = ov[k]
+            elif isinstance(ov, (tuple, list)):
+                h = dict(h)
+                h['d'] = ov[0]
+                if len(ov) > 1 and ov[1] is not None:
+                    h['length'] = ov[1]
+                if len(ov) > 2 and ov[2] is not None:
+                    h['angle'] = ov[2]
+            elif ov is not None:
+                h = dict(h)
+                h['d'] = ov
+            return h
+        if orig < 0:
+            lst = self.added_holes.get(f['hash'], [])
+            idx = -orig - 1
+            if 0 <= idx < len(lst):
+                h = dict(lst[idx])
+                h.setdefault('kind', 'slot' if h.get('length') else 'hole')
+                return h
+        return None
+
+    def _edit_hole_by_index(self, index):
+        if not self._current_file:
+            return
+        if self._dxf_file(self._current_file):
+            self._toast(self.tr_('dxf_holes_readonly'), kind='warn')
+            return
+        active = getattr(self, '_current_active', None)
+        # Viewers report the ROW inside the edited geometry; map it to the
+        # original index so the dialog edits the RIGHT hole even after other
+        # holes were deleted (negative markers for added holes pass through).
+        if isinstance(active, (list, tuple)) and index >= 0 \
+                and index < len(active):
+            index = active[index]
+        h = self._base_hole(index)
+        if h is None:
+            return
+        self._edit_hole_dialog(index, h)
+
+    def _edit_hole_dialog(self, index, h):
+        """P2: hole editor moved to DialogManager. Thin delegate kept as the
+        interception point for _edit_hole_by_index (one test patches it to
+        observe the (index, h) mapping)."""
+        return self.dialog_manager.open_hole_editor(index, h)
+
+    def _edit_hole_diameter(self, row, col):
+        if col != 4 or not self._current_file:
+            return
+        if self._dxf_file(self._current_file):
+            self._toast(self.tr_('dxf_holes_readonly'), kind='warn')
+            return
+            return
+        active = getattr(self, '_current_active', [])
+        if not (0 <= row < len(active)):
+            return
+        self._edit_hole_by_index(active[row])
