+class TestPolarSnap(unittest.TestCase):
+    """AutoCAD-style polar tracking against a measure anchor."""
+
+    def test_exact_multiple_45(self):
+        pt, ang = polar_snap((0, 0), (10, 10), increment=15.0, tol=2.0)
+        self.assertAlmostEqual(ang, 45.0)
+        self.assertAlmostEqual(pt[0], pt[1], places=6)
+
+    def test_within_tolerance_snaps_to_ray(self):
+        # cursor at 31.8 deg snaps onto the 30 deg ray (orthogonal projection)
+        pt, ang = polar_snap((0, 0), (100, 62), increment=15.0, tol=2.0)
+        self.assertAlmostEqual(ang, 30.0)
+        d = 100 * math.cos(math.radians(30.0)) + 62 * math.sin(math.radians(30.0))
+        self.assertAlmostEqual(pt[0], d * math.cos(math.radians(30.0)), places=6)
+        self.assertAlmostEqual(pt[1], d * math.sin(math.radians(30.0)), places=6)
+
+    def test_off_ray_returns_none(self):
+        self.assertIsNone(polar_snap((0, 0), (100, 45), increment=15.0, tol=2.0))
+
+    def test_left_ray_180(self):
+        pt, ang = polar_snap((0, 0), (-50, 1), increment=15.0, tol=2.0)
+        self.assertAlmostEqual(ang, 180.0)
+        self.assertAlmostEqual(pt[1], 0.0, places=6)
+
+    def test_down_ray_270(self):
+        pt, ang = polar_snap((0, 0), (1, -50), increment=15.0, tol=2.0)
+        self.assertAlmostEqual(ang, 270.0)
+        self.assertAlmostEqual(pt[0], 0.0, places=6)
+
+    def test_zero_length_anchor(self):
+        pt, ang = polar_snap((5, 5), (5, 5), increment=15.0)
+        self.assertEqual(pt, (5, 5))
+        self.assertEqual(ang, 0.0)
+
