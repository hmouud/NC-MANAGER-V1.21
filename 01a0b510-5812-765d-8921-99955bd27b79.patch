+        receives an empty kind set and performs no object snap at all (exactly
+        like disabling OSNAP in a CAD package).
+        """
+        if self._design is None:
+            return set(SNAP_KINDS), 12.0
+        enabled = (self._design.enabled_snaps()
+                   if self._design.osnap_enabled() else set())
