new file mode 100644
index 0000000..1a07139
--- /dev/null
+++ b/src/nccorrection/engine/dxf/dxf_parser.py
@@ -0,0 +1,448 @@
+"""DXF -> geometry adapter (2D only, PLATE profile).
+
+Owner spec (2026-08-19/20):
+- DXF is read for 2D use only; there is never a 3D DXF body.
+- Quantity is entered manually at import time.
+- The profile is always a PLATE: the user picks the thickness (PL4/PL6/PL12...).
+- The engine needs polylines AND arcs (a professional polyline/arc engine).
+- Internal (closed) contours inside the part are read as HOLES by some
+  machines, so inner loops are converted to holes automatically.
+- The module NEVER touches the DSTV/NC1 engines: it produces the SAME
+  geometry-dict contract as ``core/viewer.parse_geometry`` so the existing
+  2D renderer can draw DXF parts without any engine change.
+
+Reading:
+- ``read_dxf(path=..., text=...)`` uses ezdxf (R12+ ASCII and binary DXF).
+- Units: $INSUNITS from the header is converted to mm when present; R12 files
+  without a header are assumed to be mm (owner rule: mm always).
+"""
+
+import io
+import math
+
+# $INSUNITS -> mm conversion factor (ezdxf/ACAD values).
+_INSUNITS_MM = {
+    0: 25.4,    # unitless (assume inch, same as ACAD default)
+    1: 25.4,    # inch
+    2: 304.8,   # foot
+    3: 914.4,   # yard
+    4: 1.0,     # mm
+    5: 10.0,    # cm
+    6: 1000.0,  # m
+}
+
+_CIRCLE_SEGMENTS = 64          # polygon approximation for CIRCLE loops
+_MIN_ARC_SEGMENTS = 6
+_MAX_ARC_SEGMENTS = 512
+_ARC_CHORD_TOL = 0.5           # mm chord tolerance for arc flattening
+_CHAIN_TOL = 0.01              # mm endpoint tolerance when chaining LINEs
+
+
+# ---------------------------------------------------------------- primitives
+def _flatten_arc_points(p1, apex, p2):
+    """Flatten an arc defined by start point, apex (bulge point) and end point
+    into a polyline of (x, y). Works for any orientation (no sign tricks)."""
+    ax, ay = p1
+    bx, by = apex
+    cx, cy = p2
+    d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by))
+    if abs(d) < 1e-12:
+        return [p1, p2]  # collinear -> straight segment
+    ux = ((ax * ax + ay * ay) * (by - cy)
+          + (bx * bx + by * by) * (cy - ay)
+          + (cx * cx + cy * cy) * (ay - by)) / d
+    uy = ((ax * ax + ay * ay) * (cx - bx)
+          + (bx * bx + by * by) * (ax - cx)
+          + (cx * cx + cy * cy) * (bx - ax)) / d
+    r = math.hypot(ax - ux, ay - uy)
+    a1 = math.atan2(ay - uy, ax - ux)
+    a2 = math.atan2(cy - uy, cx - ux)
+    # sweep direction: bulge apex side decides CW/CCW
+    sweep = a2 - a1
+    while sweep <= -math.pi:
+        sweep += 2 * math.pi
+    while sweep > math.pi:
+        sweep -= 2 * math.pi
+    steps = max(_MIN_ARC_SEGMENTS,
+                min(_MAX_ARC_SEGMENTS,
+                    int(abs(sweep) * r / _ARC_CHORD_TOL) + 1))
+    pts = [p1]
+    for i in range(1, steps):
+        a = a1 + sweep * i / steps
+        pts.append((ux + r * math.cos(a), uy + r * math.sin(a)))
+    pts.append(p2)
+    return pts
+
+
+def _lwpolyline_points(pl):
+    """Flatten an ezdxf LWPOLYLINE (bulge-aware) into [(x, y), ...]."""
+    pts = []
+    verts = list(pl.get_points('xyb'))
+    if not verts:
+        return pts
+    n = len(verts)
+    for i in range(n):
+        x1, y1, b = verts[i]
+        if i + 1 < n:
+            x2, y2, _ = verts[i + 1]
+        elif pl.closed:
+            x2, y2, _ = verts[0]
+        else:
+            pts.append((x1, y1))
+            break
+        if abs(b) < 1e-12:
+            pts.append((x1, y1))
+        else:
+            # apex of the bulge: midpoint + left-perpendicular * sagitta
+            dx, dy = x2 - x1, y2 - y1
+            chord = math.hypot(dx, dy)
+            if chord < 1e-12:
+                pts.append((x1, y1))
+                continue
+            mx, my = (x1 + x2) / 2.0, (y1 + y2) / 2.0
+            nx, ny = -dy / chord, dx / chord
+            sag = b * chord / 2.0
+            apex = (mx + nx * sag, my + ny * sag)
+            pts.extend(_flatten_arc_points((x1, y1), apex, (x2, y2)))
+    return pts
+
+
+def _polyline_points(pl):
+    """Flatten a legacy ezdxf POLYLINE (bulge-aware)."""
+    pts = []
+    verts = list(pl.vertices)
+    if not verts:
+        return pts
+    n = len(verts)
+    closed = bool(pl.is_closed)
+    for i, v in enumerate(verts):
+        x1, y1 = v.dxf.location.x, v.dxf.location.y
+        b = float(v.dxf.bulge if v.dxf.hasattr('bulge') else 0.0)
+        if i + 1 < n:
+            nv = verts[i + 1]
+            x2, y2 = nv.dxf.location.x, nv.dxf.location.y
+        elif closed:
+            x2, y2 = verts[0].dxf.location.x, verts[0].dxf.location.y
+        else:
+            pts.append((x1, y1))
+            break
+        if abs(b) < 1e-12:
+            pts.append((x1, y1))
+        else:
+            dx, dy = x2 - x1, y2 - y1
+            chord = math.hypot(dx, dy)
+            if chord < 1e-12:
+                pts.append((x1, y1))
+                continue
+            mx, my = (x1 + x2) / 2.0, (y1 + y2) / 2.0
+            nx, ny = -dy / chord, dx / chord
+            sag = b * chord / 2.0
+            pts.extend(_flatten_arc_points((x1, y1), (mx + nx * sag, my + ny * sag),
+                                           (x2, y2)))
+    return pts
+
+
+def _arc_entity_points(arc):
+    """Flatten an ezdxf ARC entity (DXF angles are CCW degrees)."""
+    c = arc.dxf.center
+    r = float(arc.dxf.radius)
+    a0 = math.radians(float(arc.dxf.start_angle))
+    a1 = math.radians(float(arc.dxf.end_angle))
+    sweep = a1 - a0
+    while sweep <= 0:
+        sweep += 2 * math.pi
+    steps = max(_MIN_ARC_SEGMENTS,
+                min(_MAX_ARC_SEGMENTS, int(abs(sweep) * r / _ARC_CHORD_TOL) + 1))
+    return [(c.x + r * math.cos(a0 + sweep * i / steps),
+             c.y + r * math.sin(a0 + sweep * i / steps))
+            for i in range(steps + 1)]
+
+
+def _circle_loop(circle, segments=_CIRCLE_SEGMENTS):
+    """Closed loop points for a CIRCLE entity (treated as a contour loop)."""
+    c = circle.dxf.center
+    r = float(circle.dxf.radius)
+    return [(c.x + r * math.cos(2 * math.pi * i / segments),
+             c.y + r * math.sin(2 * math.pi * i / segments))
+            for i in range(segments)]
+
+
+def _spline_points(spline):
+    """Flatten a SPLINE (and ELLIPSE via flattening) into a point strip."""
+    try:
+        return [(p.x, p.y) for p in spline.flattening(0.5)]
+    except Exception:
+        return []
+
+
+# ---------------------------------------------------------------- chaining
+def _chain_lines(segments):
+    """Chain raw line segments [(a, b), ...] (endpoint tolerance) into
+    polylines; loops are returned when the chain closes on its start."""
+    segs = list(segments)
+    loops = []
+    chains = []
+    while segs:
+        a, b = segs.pop(0)
+        chain = [a, b]
+        changed = True
+        while changed:
+            changed = False
+            for i, (sa, sb) in enumerate(segs):
+                if _near(sa, chain[-1]):
+                    chain.append(sb)
+                    segs.pop(i)
+                    changed = True
+                    break
+                if _near(sb, chain[-1]):
+                    chain.append(sa)
+                    segs.pop(i)
+                    changed = True
+                    break
+                if _near(sa, chain[0]):
+                    chain.insert(0, sb)
+                    segs.pop(i)
+                    changed = True
+                    break
+                if _near(sb, chain[0]):
+                    chain.insert(0, sa)
+                    segs.pop(i)
+                    changed = True
+                    break
+        if len(chain) >= 3 and _near(chain[0], chain[-1]):
+            loops.append(chain[:-1])
+        else:
+            chains.append(chain)
+    return loops, chains
+
+
+def _near(p, q, tol=_CHAIN_TOL):
+    return abs(p[0] - q[0]) <= tol and abs(p[1] - q[1]) <= tol
+
+
+# ---------------------------------------------------------------- analysis
+def _polygon_area(pts):
+    """Signed shoelace area (positive = CCW)."""
+    s = 0.0
+    n = len(pts)
+    for i in range(n):
+        x1, y1 = pts[i]
+        x2, y2 = pts[(i + 1) % n]
+        s += x1 * y2 - x2 * y1
+    return s / 2.0
+
+
+def _polygon_centroid(pts):
+    """Area centroid of a polygon."""
+    a = _polygon_area(pts)
+    if abs(a) < 1e-12:
+        xs = [p[0] for p in pts]
+        ys = [p[1] for p in pts]
+        return sum(xs) / len(xs), sum(ys) / len(ys)
+    cx = cy = 0.0
+    n = len(pts)
+    for i in range(n):
+        x1, y1 = pts[i]
+        x2, y2 = pts[(i + 1) % n]
+        cross = x1 * y2 - x2 * y1
+        cx += (x1 + x2) * cross
+        cy += (y1 + y2) * cross
+    return cx / (6 * a), cy / (6 * a)
+
+
+def _point_in_polygon(pt, poly):
+    """Ray-casting point-in-polygon test."""
+    x, y = pt
+    inside = False
+    n = len(poly)
+    j = n - 1
+    for i in range(n):
+        xi, yi = poly[i]
+        xj, yj = poly[j]
+        if ((yi > y) != (yj > y)) and \
+                (x < (xj - xi) * (y - yi) / (yj - yi) + xi):
+            inside = not inside
+        j = i
+    return inside
+
+
+def _bbox(pts):
+    xs = [p[0] for p in pts]
+    ys = [p[1] for p in pts]
+    return min(xs), min(ys), max(xs), max(ys)
+
+
+def classify_loops(loops):
+    """Split closed loops into (outers, inners).
+
+    The largest loop is the part outline; any loop fully inside an already
+    accepted outer is an INNER contour (read as a hole by machines, owner
+    spec). Loops not contained in any outer become outers (multiple plates
+    in one file are allowed).
+    """
+    ordered = sorted(loops, key=lambda l: abs(_polygon_area(l)), reverse=True)
+    outers = []
+    inners = []
+    for loop in ordered:
+        contained = False
+        for out in outers:
+            if _loop_inside(loop, out):
+                contained = True
+                break
+        if contained:
+            inners.append(loop)
+        else:
+            outers.append(loop)
+    return outers, inners
+
+
+def _loop_inside(inner, outer):
+    ob = _bbox(outer)
+    ib = _bbox(inner)
+    if ib[0] < ob[0] or ib[1] < ob[1] or ib[2] > ob[2] or ib[3] > ob[3]:
+        return False
+    cx, cy = _polygon_centroid(inner)
+    return _point_in_polygon((cx, cy), outer)
+
+
+def _equivalent_hole(loop):
+    """(x, y, d) of the hole a closed loop represents (area-equivalent circle)."""
+    a = abs(_polygon_area(loop))
+    d = 2.0 * math.sqrt(a / math.pi) if a > 1e-9 else 0.0
+    cx, cy = _polygon_centroid(loop)
+    return round(cx, 3), round(cy, 3), round(d, 2)
+
+
+# ---------------------------------------------------------------- reading
+def _insunits_factor(doc):
+    try:
+        return _INSUNITS_MM.get(int(doc.header.get('$INSUNITS', 4)), 1.0)
+    except Exception:
+        return 1.0
+
+
+def read_shapes(doc):
+    """Extract 2D shapes from the DXF modelspace into
+    (loops, open_chains, ...) - all coordinates in mm.
+
+    LINE entities are chained by endpoint proximity into closed loops or
+    open polylines; LWPOLYLINE/POLYLINE/CIRCLE give closed loops (or open
+    polylines when not closed); ARC/SPLINE/ELLIPSE give open chains."""
+    factor = _insunits_factor(doc)
+    loops = []
+    chains = []
+    line_segs = []
+    for e in doc.modelspace():
+        t = e.dxftype()
+        try:
+            if t == 'LWPOLYLINE':
+                pts = _lwpolyline_points(e)
+                if len(pts) >= 3:
+                    if e.closed:
+                        loops.append(pts)
+                    else:
+                        chains.append(pts)
+            elif t == 'POLYLINE':
+                pts = _polyline_points(e)
+                if len(pts) >= 3:
+                    if e.is_closed:
+                        loops.append(pts)
+                    else:
+                        chains.append(pts)
+            elif t == 'CIRCLE':
+                loops.append(_circle_loop(e))
+            elif t == 'ARC':
+                chains.append(_arc_entity_points(e))
+            elif t == 'LINE':
+                s = e.dxf.start
+                en = e.dxf.end
+                line_segs.append(((s.x, s.y), (en.x, en.y)))
+            elif t in ('SPLINE', 'ELLIPSE'):
+                pts = _spline_points(e)
+                if len(pts) >= 2:
+                    chains.append(pts)
+        except Exception:
+            continue  # one bad entity never kills the import
+    if line_segs:
+        chained_loops, chained_chains = _chain_lines(line_segs)
+        loops.extend(chained_loops)
+        chains.extend(chained_chains)
+    if factor != 1.0:
+        loops = [[(x * factor, y * factor) for x, y in l] for l in loops]
+        chains = [[(x * factor, y * factor) for x, y in c] for c in chains]
+    return loops, chains
+
+
+def to_geometry(loops, chains, thickness=10.0, profile='PL10'):
+    """Build the geometry dict consumed by the 2D viewers (same contract as
+    ``core/viewer.parse_geometry``)."""
+    outers, inners = classify_loops(loops)
+    holes = []
+    circles = []
+    for inner in inners:
+        cx, cy, d = _equivalent_hole(inner)
+        if d > 1e-9:
+            holes.append({'face': 'v', 'kind': 'hole', 'x': cx, 'y': cy,
+                          'd': d, 'length': 0.0, 'angle': 0.0})
+            circles.append((cx, cy, d))
+    points = []
+    for ch in chains:
+        if len(ch) >= 2:
+            points.extend(ch)
+    st = {'type': 'B', 'profile': profile, 'thickness': float(thickness),
+          'numbers': [], 'dims': []}
+    contour_meta = [{'face': 'v', 'pts': list(c), 'bevels': {}, 'notches': [],
+                     'x_suffix': None, 'first_x': c[0][0] if c else None,
+                     'first_y': c[0][1] if c else None}
+                    for c in outers]
+    return {
+        'contours': outers,
+        'contour_faces': ['v'] * len(outers),
+        'contour_meta': contour_meta,
+        'points': points,
+        'circles': circles,
+        'slots': [],
+        'holes': holes,
+        'st': st,
+        'dxf': True,
+    }
+
+
+def read_dxf(path=None, text=None, thickness=10.0, profile='PL10'):
+    """Read a DXF (path or ASCII text) and return the geometry dict.
+
+    Returns None when the DXF cannot be read or has no 2D shapes.
+    Raises nothing: every failure mode returns None (the caller shows a
+    friendly message).
+    """
+    import ezdxf
+    try:
+        if path:
+            doc = ezdxf.readfile(path)
+        elif text is not None:
+            doc = ezdxf.read(io.StringIO(text))
+        else:
+            return None
+    except Exception:
+        return None
+    try:
+        loops, chains = read_shapes(doc)
+    except Exception:
+        return None
+    if not loops and not chains:
+        return None
+    return to_geometry(loops, chains, thickness=thickness, profile=profile)
+
+
+def plate_choices():
+    """Standard PLATE thicknesses offered at DXF import (owner picks one)."""
+    return ['PL4', 'PL5', 'PL6', 'PL8', 'PL10', 'PL12', 'PL15',
+            'PL20', 'PL25', 'PL30', 'PL40']
+
+
+def plate_thickness(profile):
+    """mm value for a 'PL12'-style profile token."""
+    try:
+        return float(profile.replace('PL', '').replace('pl', ''))
+    except (ValueError, AttributeError):
+        return 10.0
