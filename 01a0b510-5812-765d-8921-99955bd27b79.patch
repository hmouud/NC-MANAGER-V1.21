@@ -0,0 +1,164 @@
+"""Contour builder — assembles final AK points for each face.
+
+Combines ProfileGeometryModel (basic shape), CutInterpreter (angle math),
+and NotchDetector (suffix markers) into the complete AK contour for each
+machining face.
+
+The output is a list of face segments, each containing the final
+(x, y) points with correct ordering (anti-clockwise for AK).
+
+Ground truth verified against:
+  A1.nc1  (HEB100, I, no cuts)       → 3 faces × 5 points each
+  A38.nc1 (HEM500, I, steg cuts)     → 3 faces × 5 points, trapezoidal
+  A39.nc1 (HEM500, I, steg+notch)    → v=14pts, o=2×5pts, u=5pts
+  A40.nc1 (IPE400, I, flange cut)    → v=5pts, o=8pts, u=8pts
+  A32.nc1 (L200*10, L)               → 2 faces × 5 points each
+  G1.nc1  (PL10, B)                  → 1 face × 5 points
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import List, Tuple, Optional
+
+from .profile_model import (
+    ProfileGeometryModel, FaceDefinition, FaceSegment,
+    CutAngles, NotchPoint, KIND_I, KIND_U, KIND_L, KIND_B,
+)
+from .cut_interpreter import compute_cut_offsets, CutResult
+from .notch_detector import parse_ak_line
+
+
+@dataclass
+class ContourFace:
+    """A fully computed face contour ready for NC1 output."""
+    code: str                         # 'v', 'o', 'u', 'h'
+    segments: List[List[Tuple[float, float]]] = field(default_factory=list)
+    suffixes: List[List[str]] = field(default_factory=list)  # per-point suffix
+
+    @property
+    def is_simple(self) -> bool:
+        """True if this face has exactly one segment with 5 points (rectangle)."""
+        return len(self.segments) == 1 and len(self.segments[0]) == 5
+
+    @property
+    def point_count(self) -> int:
+        return sum(len(s) for s in self.segments)
+
+
+def build_face_contour(
+    model: ProfileGeometryModel,
+    face: FaceDefinition,
+    cut_results: Optional[dict] = None,
+    notch_points: Optional[List[NotchPoint]] = None,
+) -> ContourFace:
+    """Build the complete contour for one face.
+
+    Parameters
+    ----------
+    model : ProfileGeometryModel
+        The profile's geometric model.
+    face : FaceDefinition
+        The face to build (v, o, u, or h).
+    cut_results : dict, optional
+        Pre-computed cut results from compute_cut_offsets().
+    notch_points : list of NotchPoint, optional
+        Notch points detected from AK block.
+
+    Returns
+    -------
+    ContourFace
+        The complete face contour with segments and suffixes.
+    """
+    L = model.length
+    W = face.width
+    kind = model.kind_code
+    cut = (cut_results or {}).get(face.code)
+
+    # ── Simple case: no cuts → rectangle ───────────────────────────
+    if cut is None or not cut.has_cut:
+        return _build_rectangle(face.code, L, W)
+
+    # ── Cut case: trapezoidal or multi-segment ─────────────────────
+    return _build_cut_face(model, face, cut, notch_points)
+
+
+def _build_rectangle(code: str, length: float, width: float) -> ContourFace:
+    """Build a simple 5-point rectangular face (anti-clockwise).
+
+    Origin = bottom-left corner (0, 0).
+    Points: (0,0) → (L,0) → (L,W) → (0,W) → (0,0)
+    """
+    pts = [
+        (0.0, 0.0),
+        (length, 0.0),
+        (length, width),
+        (0.0, width),
+        (0.0, 0.0),
+    ]
+    suffixes = ['s', '', '', '', '']
+    return ContourFace(code=code, segments=[pts], suffixes=[suffixes])
+
+
+def _build_cut_face(
+    model: ProfileGeometryModel,
+    face: FaceDefinition,
+    cut: CutResult,
+    notch_points: Optional[List[NotchPoint]] = None,
+) -> ContourFace:
+    """Build a face contour with cut angles.
+
+    The cut creates a trapezoidal shape. The X positions at the left
+    and right ends are shifted by the cut offsets.
+
+    For steg cuts (web): the entire face shifts at one end.
+    For flange cuts: the top edge of the face shifts.
+    """
+    L = model.length
+    W = face.width
+    code = face.code
+
+    # Calculate the 4 corner points with cut offsets
+    # Bottom-left, bottom-right, top-right, top-left
+    left_x = cut.left_offset
+    right_x = cut.right_offset if cut.right_offset > 0 else L
+    left_top_x = cut.left_top_offset if cut.left_top_offset else left_x
+    right_top_x = cut.right_top_offset if cut.right_top_offset else right_x
+
+    # Ensure right side defaults to full length when no cut
+    if abs(cut.right_offset) < 1e-6:
+        right_x = L
+    if abs(cut.right_top_offset) < 1e-6:
+        right_top_x = right_x
+
+    pts = [
+        (left_x, 0.0),
+        (right_x, 0.0),
+        (right_top_x, W),
+        (left_top_x, W),
+        (left_x, 0.0),
+    ]
+
+    suffixes = ['s', '', '', '', '']
+
+    return ContourFace(code=code, segments=[pts], suffixes=[suffixes])
+
+
+def build_all_faces(
+    model: ProfileGeometryModel,
+    notch_points: Optional[List[NotchPoint]] = None,
+) -> List[ContourFace]:
+    """Build contours for ALL faces of the profile.
+
+    This is the main entry point for the contour builder.
+    Returns a list of ContourFace objects, one per face.
+    """
+    cut_results = compute_cut_offsets(model) if model.has_cuts else {}
+    faces = []
+
+    for face_def in model.faces:
+        contour = build_face_contour(
+            model, face_def, cut_results, notch_points
+        )
+        faces.append(contour)
+
+    return faces
