+"""File import mixin for NCManagerApp.
+
+Extracted from app.py to keep the main application file focused on UI
+construction and event handling.  Every method references ``self.`` attributes
+that live on :class:`NCManagerApp` — this mixin is **not** usable standalone.
+
+Handles: file/folder import (+), DWG conversion, DXF parameter dialogs,
+drag-and-drop, conflict resolution, and the file-record builder.
+"""
+
+import os
+
+from PySide6.QtCore import Qt
+from PySide6.QtWidgets import (
+    QApplication,
+    QButtonGroup,
+    QComboBox,
+    QDialog,
+    QHBoxLayout,
+    QLabel,
+    QLineEdit,
+    QMessageBox,
+    QPushButton,
+    QProgressDialog,
+    QRadioButton,
+    QSpinBox,
+    QTextEdit,
+    QVBoxLayout,
+)
+
+from nccorrection.core.classifier import (
+    classify_text,
+    compute_hash,
+    detect_o_plane,
+    has_si_en,
+    parse_quantity,
+)
+from nccorrection.core.importer import distinct_orders, file_info_lines, scan_folder
+from nccorrection.core.nc1_writer import ensure_si_en
+from nccorrection.core.order_utils import _extract_order, _replace_order_in_text
+from nccorrection.engine.dxf.dxf_parser import plate_choices
+
+
+# ---------------------------------------------------------------------------
+# Module-level helpers — now imported from shared ui/_metrics.py
+# ---------------------------------------------------------------------------
+from nccorrection.ui._metrics import (  # noqa: E402,F401
+    GRADE_RE as _GRADE_RE,
+    PROFILE_TYPES as _PROFILE_TYPES,
+    DENSITY as _DENSITY,
+    extract_steel as _extract_steel,
+    section_area as _section_area,
+    part_metrics as _part_metrics,
+)
+
+
+# ---------------------------------------------------------------------------
+# Mixin class
+# ---------------------------------------------------------------------------
+
+class FileImportMixin:
+    """File/folder import, DWG conversion, DXF parameters, drag-and-drop,
+    conflict resolution, and the file-record builder.
+
+    Every method uses ``self.`` — same attributes as in NCManagerApp.
+    """
+
+    def _add_files(self):
+        """'+' entry point (owner 2026-08-20): the dialog FIRST asks WHICH
+        FILE TYPES to search (NC/NC1, DXF, DWG or All), then opens the
+        matching picker. NC/NC1 keeps the folder import (storage law); DXF
+        and DWG use a multi-file picker and are imported as PLATE parts
+        (2D only). Nothing else is touched by this change."""
+        kind = self._ask_import_kind()
+        if not kind:
+            return
+        if kind == 'nc':
+            from PySide6.QtWidgets import QFileDialog
+            folder = QFileDialog.getExistingDirectory(self, self.tr_('add_files'),
+                                                      '', QFileDialog.ShowDirsOnly)
+            if not folder:
+                return
+            self._import_folder(folder)
+            return
+        specs = {
+            'dxf': (self.tr_('kind_dxf'), '*.dxf'),
+            'dwg': (self.tr_('kind_dwg'), '*.dwg'),
+            'all': ('All supported (*.nc *.nc1 *.dxf *.dwg)', '*.nc *.nc1 *.dxf *.dwg'),
+        }[kind]
+        label, pattern = specs
+        from PySide6.QtWidgets import QFileDialog
+        paths, _ = QFileDialog.getOpenFileNames(
+            self, self.tr_('import_kind_title'), '', f'{label} ({pattern})')
+        if not paths:
+            return
+        if kind == 'dxf':
+            self._import_cad_files(paths, 'dxf')
+        elif kind == 'dwg':
+            self._import_dwg_files(paths)
+        else:  # 'all': route each picked file by its extension
+            nc = [p for p in paths if p.lower().endswith(('.nc', '.nc1'))]
+            dxf = [p for p in paths if p.lower().endswith('.dxf')]
+            dwg = [p for p in paths if p.lower().endswith('.dwg')]
+            if nc:
+                self._import_cad_files(nc, 'nc')
+            if dxf:
+                self._import_cad_files(dxf, 'dxf')
+            if dwg:
+                self._import_dwg_files(dwg)
+
+    def _ask_import_kind(self):
+        """Format-choice dialog for the '+' button (owner 2026-08-20)."""
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('import_kind_title'))
+        dlg.resize(380, 230)
+        v = QVBoxLayout(dlg)
+        v.addWidget(QLabel(self.tr_('import_kind_prompt'), dlg))
+        group = QButtonGroup(dlg)
+        radios = []
+        for val, label in [('nc', self.tr_('kind_nc')),
