+             ((v_.x, v_.y, v_.bulge) for v_ in v.outer_contour.vertices)])
+        # arc from (0,0)->(1000,0) with bulge 1.0 stays above the chord
+        self.assertGreater(max(y for _, y in pts), 250.0)
