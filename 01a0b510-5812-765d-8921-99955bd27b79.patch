+                        p.setFont(QFont('Arial', 6, QFont.Bold))
+                        p.drawText(QRectF(bx - 5, by - 5, 10, 10), Qt.AlignCenter, face.upper())
+                        from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+                        full = DstvRenderer2D.FACE_DESCR.get(face, face)
+                        self._badge_rects.append((QRectF(bx - 12, by - 20, 14, 14), full))
+                    else:
+                        label = self._face_badge_label(face)
+                        p.setFont(QFont('Arial', 7, QFont.Bold))
+                        tw = p.fontMetrics().horizontalAdvance(label) + 10
+                        badge = QRectF(bx - tw - 12, by - 20, tw, 14)
+                        p.setPen(Qt.NoPen)
+                        p.setBrush(QColor(11, 21, 38, 210))
+                        p.drawRoundedRect(badge, 3, 3)
+                        p.setPen(QColor(C.txt))
+                        p.drawText(badge, Qt.AlignCenter, label)
+                        self._badge_rects.append((badge, label))
+        else:
+            pts = geom.get('points', [])
+            if len(pts) >= 2:
+                path = QPainterPath(QPointF(*self._to_screen(*pts[0])))
+                for x, y in pts[1:]:
+                    path.lineTo(QPointF(*self._to_screen(x, y)))
+                p.drawPath(path)
+
+        self._draw_cut_markers(p)
+        if self._fold_state.get('show_line'):
+            self._draw_fold_lines(p)
+
+        self._holes_screen = []
+        hovered = self._hovered_hole
+        p.setFont(QFont('Arial', 8))
+        # Combined 'holes' list so the idx stored here matches the app's hole
+        # index space exactly (circles AND slots are both editable targets).
+        for i, h in enumerate(geom.get('holes', [])):
+            if h.get('fold_hidden'):
