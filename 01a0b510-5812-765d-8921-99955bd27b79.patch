@@ -0,0 +1,147 @@
+import sys, os, unittest
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.core.nc1_writer import (
+    apply_hole_edits, valid_faces, current_face, ensure_si_en)
+
+
+SAMPLE = """ST
+I
+HEA300
+6000.0
+300.0
+150.0
+10.0
+6.0
+BO
+v 100.00 120.00 18.00
+u 300.00 30.00 22.00
+v 2000.00 120.00 22.00 60.00
+EN
+"""
+
+
+class TestNc1Writer(unittest.TestCase):
+    def test_stale_override_index_raises_structured_valueerror(self):
+        """P1 hardening: an override whose index no longer exists in the
+        parsed feature list raises a structured ValueError (the app funnel
+        reports it) instead of crashing on index access or writing silently
+        misaligned output."""
+        with self.assertRaises(ValueError) as cm:
+            apply_hole_edits(SAMPLE, {99: {'x': 1.0}})
+        self.assertIn('out of range', str(cm.exception))
+
+    def test_valid_faces_by_profile(self):
+        # Faces restricted to those that really exist on the section:
+        # L only v/u, flat plates v/h, I/C/U the full set.
+        self.assertEqual(valid_faces('I'), ['v', 'o', 'u', 'h'])
+        self.assertEqual(valid_faces('U'), ['v', 'o', 'u', 'h'])
+        self.assertEqual(valid_faces('C'), ['v', 'o', 'u', 'h'])
+        self.assertEqual(valid_faces('L'), ['v', 'u'])
+        self.assertEqual(valid_faces('B'), ['v', 'h'])
+        self.assertEqual(valid_faces('Z'), ['v', 'h'])
+        self.assertEqual(valid_faces('S'), ['v', 'h'])
+        self.assertEqual(valid_faces(''), ['v', 'h'])
+        self.assertEqual(valid_faces('T'), ['v', 'h'])
+
+    def test_current_face(self):
+        self.assertEqual(current_face(SAMPLE), 'v')
+
+    def test_modify_hole(self):
+        text = apply_hole_edits(SAMPLE, {1: {'x': 500.0, 'y': 25.0, 'd': 20.0}})
+        holes = parse_geometry(text)['holes']
+        self.assertEqual(len(holes), 3)
+        self.assertEqual(holes[1]['x'], 500.0)
+        self.assertEqual(holes[1]['y'], 25.0)
+        self.assertEqual(holes[1]['d'], 20.0)
+        self.assertEqual(holes[0]['d'], 18.0)
+        self.assertIn('U 500.00 25.00 20.00', text)
+
+    def test_change_face(self):
+        text = apply_hole_edits(SAMPLE, {0: {'face': 'o'}})
+        holes = parse_geometry(text)['holes']
+        self.assertEqual(holes[0]['face'], 'o')
+        self.assertIn('O 100.00 120.00 18.00', text)
+
+    def test_delete_hole(self):
+        text = apply_hole_edits(SAMPLE, {0: None})
+        holes = parse_geometry(text)['holes']
+        self.assertEqual(len(holes), 2)
+        self.assertEqual(holes[0]['d'], 22.0)
+        self.assertNotIn('v 100.00 120.00 18.00', text)
+
+    def test_delete_all_removes_block(self):
+        text = apply_hole_edits(SAMPLE, {0: None, 1: None, 2: None})
+        self.assertNotIn('BO', text)
+        self.assertEqual(parse_geometry(text)['holes'], [])
+
+    def test_add_holes(self):
+        text = apply_hole_edits(
+            SAMPLE, {},
+            add_holes=[{'face': 'v', 'x': 3000.0, 'y': 100.0, 'd': 14.0},
+                       {'face': 'u', 'x': 3000.0, 'y': 30.0, 'd': 20.0}])
+        holes = parse_geometry(text)['holes']
+        self.assertEqual(len(holes), 5)
+        self.assertEqual(holes[3]['d'], 14.0)
+        self.assertEqual(holes[4]['face'], 'u')
+        self.assertIn('BO', text)
+        self.assertIn('V 3000.00 100.00 14.00', text)
+
+    def test_preserves_other_content(self):
+        text = apply_hole_edits(SAMPLE, {1: {'d': 19.0}})
+        self.assertIn('HEA300', text)
+        self.assertIn('ST', text)
+        self.assertIn('EN', text)
+
+    def test_slot_edit_keeps_format(self):
+        text = apply_hole_edits(SAMPLE, {2: {'length': 80.0, 'angle': 45.0}})
+        holes = parse_geometry(text)['holes']
+        self.assertEqual(holes[2]['length'], 80.0)
+        self.assertEqual(holes[2]['angle'], 45.0)
+        self.assertIn('V 2000.00 120.00 22.00 0.00 80.00 45.00', text)
+
+    def test_roundtrip_unchanged_when_no_edits(self):
+        self.assertEqual(apply_hole_edits(SAMPLE, {}), SAMPLE)
+
+    def test_si_en_missing_mark_inserted(self):
+        no_si = "ST\nI\nHEA300\nBO\nv 100.00 120.00 18.00\nEN\n"
+        text, changed = ensure_si_en(no_si, 'D12')
+        self.assertTrue(changed)
+        body = [l.strip() for l in text.split('\n')]
+        self.assertIn('SI', body)
+        self.assertEqual(body[body.index('SI') + 1], 'D12')
+        self.assertIn('\nEN\n', text)
+
+    def test_si_en_already_marked_no_dup(self):
+        marked = "ST\nI\nHEA300\nBO\nv 100.00 120.00 18.00\nSI\nD12\nEN\n"
+        text, changed = ensure_si_en(marked, 'D12')
+        self.assertFalse(changed)
+        self.assertEqual(text, marked)
+        self.assertEqual(text.count('\nSI\n'), 1)
+
+    def test_si_en_missing_si_only_en(self):
+        only_en = "ST\nI\nHEA300\nBO\nv 100.00 120.00 18.00\nEN\n"
+        text, changed = ensure_si_en(only_en, 'D12')
+        self.assertTrue(changed)
+        idx = [l.strip() for l in text.split('\n')]
+        self.assertIn('SI', idx)
+        self.assertIn('D12', idx)
+        self.assertTrue(has_si_en(text))
+
+    def test_si_en_empty_block_gets_mark(self):
+        empty = "ST\nI\nHEA300\nBO\nv 100.00 120.00 18.00\nSI\nEN\n"
+        text, changed = ensure_si_en(empty, 'D12')
+        self.assertTrue(changed)
+        body = [l.strip() for l in text.split('\n')]
+        self.assertEqual(body[body.index('SI') + 1], 'D12')
+
+
+def has_si_en(text):
+    import re
+    return bool(re.search(r'(^|\n)\s*SI\s*(\n|$)', text, re.I)) and \
+           bool(re.search(r'(^|\n)\s*EN\s*(\n|$)', text, re.I))
+
+
+if __name__ == '__main__':
+    unittest.main()
