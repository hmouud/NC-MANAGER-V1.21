+"""Part creation / shape-reference mixin for NCManagerApp.
+
+Extracted from app.py to keep the main application file focused on UI
+construction and event handling.  Every method references ``self.``
+attributes that live on :class:`NCManagerApp` — this mixin is **not**
+usable standalone.
+
+The old ProfileBuilderWizard (structural steel profiles) has been removed.
+All part creation now goes through the ShapeReference dialog (parametric
+plate shapes: circular, rectangular, triangular, brackets, arc, special).
+"""
+
+import os
+import time
+
+from PySide6.QtWidgets import (
+    QDialog,
+    QLabel,
+    QVBoxLayout,
+    QTextEdit,
+)
+from PySide6.QtCore import Qt
+
+from nccorrection.core.classifier import (
+    classify_text,
+    compute_hash,
+)
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.ui.qt_viewer import NcViewer
+
+
+class PartCreatorMixin:
+    """Part creation via Shape Reference dialog, table-click editing."""
+
+    def _create_new_file(self):
+        """Open the Shape Reference dialog for parametric plate creation."""
+        if not self._current_project:
+            self._toast(self.tr_('create_no_project'), "warn")
+            return
+        self._open_shape_reference()
+
+    def _add_created_part(self, name, text, save=False, path=''):
+        """Parse the wizard-produced part ``text`` and insert it as a record.
+
+        When ``save`` and no explicit ``path``: the file is written to the
+        configured output directory; if ``output_dir`` is unset/invalid the
+        write falls back inside the app data folder
+        (``projects/<project>/output/``), and when no folder can be resolved
+        the save is quietly aborted - the CWD is NEVER used (CTO 2026-09-12).
+        """
+        if save and not path:
+            folder = (self.settings.get('output_dir', '') or '').strip()
+            if not folder:
+                # Safe fallback: never spray loose files into the CWD.
+                try:
+                    base = self.projects.projects_dir
+                    folder = os.path.join(base, self._current_project or 'default',
+                                          'output')
+                except Exception:
+                    folder = ''
+            if folder:
+                os.makedirs(folder, exist_ok=True)
+                path = os.path.join(folder, name)
+                with open(path, 'w', encoding='latin-1', newline='') as f:
+                    f.write(text)
+        h = compute_hash(text.encode('latin-1'))
+        c = classify_text(text, name)
+        rec = self._make_record(path, text, h, c)
+        rec['name'] = name
+        self.files.append(rec)
+        self._session_added.add(h)
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(f'+1 {name} ' + self.tr_('added'))
+        self.audit.log(f'Created {name} via Shape Reference', 'ok', 'OK-301')
+
+    def _open_shape_reference(self):
+        """Open the Shape Reference dialog for parametric plate creation."""
+        if not self._current_project:
+            self._toast(self.tr_('create_no_project'), "warn")
+            return
+        from nccorrection.engine.part_creator.dialog import ShapeReferenceDialog
+        dlg = ShapeReferenceDialog(self)
+        dlg.part_created.connect(self._on_shape_created)
+        dlg.show()
+
+    def _open_drawing_tools(self):
+        """Open the Drawing Tools dialog for custom plate creation."""
+        if not self._current_project:
+            self._toast(self.tr_('create_no_project'), "warn")
+            return
+        from nccorrection.engine.drawing_tools.dialog import DrawingToolsDialog
+        dlg = DrawingToolsDialog(self)
+        dlg.part_created.connect(self._on_shape_created)
+        dlg.show()
+
+    def _open_structural_profile(self):
+        """Open the Create Part dialog (Profile Creator with canvas) for structural profiles."""
+        if not self._current_project:
+            self._toast(self.tr_('create_no_project'), "warn")
+            return
+        from nccorrection.ui.dialogs.create_part import CreatePartDialog
+        dlg = CreatePartDialog(self)
+        dlg.part_created.connect(self._on_structural_profile_created)
+        dlg.show()
+
+    def _open_advanced_profile(self):
+        """Open the Advanced Profile Creator (CAD-like widget with all engines wired)."""
+        from nccorrection.ui.dialogs.advanced_profile_creator import AdvancedProfileCreator
+        dlg = AdvancedProfileCreator(parent=self)
+        dlg.part_created.connect(self._on_structural_profile_created)
+        dlg.show()
+
+    def _on_structural_profile_created(self, data):
+        """Receiver for CreatePartDialog.part_created signal.
+
+        ``data`` contains: nc1_text, profile_type, length, qt_need,
+        steel_type, angle_steg_front/rear, angle_flange_front/rear, processes.
+        """
+        nc1_text = data.get('nc1_text', '')
+        if not nc1_text:
+            return
+        designation = data.get('profile_type', 'Profile')
+        length = data.get('length', 6000)
+        qty = data.get('qt_need', 1)
+        steel = data.get('steel_type', 'S235JR')
+        name = f"{designation}_{length:.0f}_{steel}.nc1"
+
+        # Write to project output folder
+        folder = ''
+        try:
+            base = self.projects.projects_dir
+            folder = os.path.join(base, self._current_project or 'default',
+                                  'output')
+        except Exception:
+            pass
+        path = ''
+        if folder:
+            os.makedirs(folder, exist_ok=True)
+            path = os.path.join(folder, name)
+            with open(path, 'w', encoding='latin-1', newline='') as f:
+                f.write(nc1_text)
+
+        h = compute_hash(nc1_text.encode('latin-1'))
+        c = classify_text(nc1_text, name)
+        rec = self._make_record(path, nc1_text, h, c)
+        rec['name'] = name
+        rec['qty_override'] = qty if qty > 1 else None
+        self.files.append(rec)
+        self._session_added.add(h)
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(f'+1 {name} ' + self.tr_('added'))
+        self.audit.log(f'Created {name} via Structural Profile', 'ok', 'OK-303')
+
+    def _on_shape_created(self, data):
+        """Receiver for ShapeReferenceDialog.part_created signal.
+
+        ``data`` contains: nc1_text, shape_name, params, thickness,
+        order, quantity, steel_grade, geometry.
+        """
+        nc1_text = data.get('nc1_text', '')
+        if not nc1_text:
+            return
+        shape_name = data.get('shape_name', 'Part')
+        order = data.get('order', shape_name)
+        qty = data.get('quantity', 1)
+        thickness = data.get('thickness', 10.0)
+        steel = data.get('steel_grade', 'S235JR')
+        name = f"{order}_{shape_name}_PL{thickness:.0f}_{steel}.nc1"
+
+        # Write to project output folder
+        folder = ''
+        try:
+            base = self.projects.projects_dir
+            folder = os.path.join(base, self._current_project or 'default',
+                                  'output')
+        except Exception:
+            pass
+        path = ''
+        if folder:
+            os.makedirs(folder, exist_ok=True)
+            path = os.path.join(folder, name)
+            with open(path, 'w', encoding='latin-1', newline='') as f:
+                f.write(nc1_text)
+
+        h = compute_hash(nc1_text.encode('latin-1'))
+        c = classify_text(nc1_text, name)
+        rec = self._make_record(path, nc1_text, h, c)
+        rec['name'] = name
+        rec['qty_override'] = qty if qty > 1 else None
+        self.files.append(rec)
+        self._session_added.add(h)
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(f'+1 {name} ' + self.tr_('added'))
+        self.audit.log(f'Created {name} via Shape Reference', 'ok', 'OK-302')
+
+    def _on_table_double_clicked(self, row, col):
+        """Handle double/triple click on table rows.
+
+        Double-click: Opens edit dialog for the part.
+        Triple-click: Isolates the specific part view in the Viewer.
+        """
+        now = time.time()
+        click_key = (row, col)
+
+        if self._table_last_click is not None:
+            last_row, last_col, last_time, click_count = self._table_last_click
+            if (last_row, last_col) == click_key and (now - last_time) < 0.5:
+                click_count += 1
+            else:
+                click_count = 1
+        else:
+            click_count = 1
+
+        self._table_last_click = (row, col, now, click_count)
+
+        self._table_click_timer.stop()
+        self._table_click_timer.timeout.connect(
+            lambda: self._process_table_click(click_key, click_count))
+        self._table_click_timer.start()
+
+    def _process_table_click(self, click_key, click_count):
+        """Process accumulated clicks after timer expires."""
+        row, col = click_key
+        item = self.table.item(row, 0)
+        if not item:
+            return
+        idx = item.data(Qt.UserRole)
+        f = self.files[idx]
+
+        if click_count >= 3:
+            self._isolate_part_view(f)
+        elif click_count == 2:
+            self._edit_part_properties(f)
+
+        self._table_last_click = None
+
+    def _edit_part_properties(self, f):
+        """Double-click edit — opens Shape Reference pre-filled from record.
+        """
+        self._open_shape_reference()
+
+    def _isolate_part_view(self, f):
+        """Isolate and show only this part in the 2D viewer."""
+        self.view_stack.setCurrentWidget(self.viewer)
+        self.view_toggle_btn.setText(self.tr_('view_3d'))
+        geometry = parse_geometry(f['text'])
+        if geometry:
+            self.viewer.set_geometry(geometry)
+            self.viewer.fit_view()
+            self._set_status(f"Isolated: {f['name']} ({f['profile']})")
+
+    def _preview_file(self, row, col):
+        item = self.table.item(row, 0)
+        if not item:
+            return
+        idx = item.data(Qt.UserRole)
+        f = self.files[idx]
+        dlg = QDialog(self)
+        dlg.setWindowTitle(f['name'])
+        dlg.resize(860, 620)
+        lay = QVBoxLayout(dlg)
+        info = (f"{self.tr_('profile').lower()}: {f['profile']} | "
+                f"{self.tr_('folder').lower()}: {f['folder']} | "
+                f"qty: {self._qty_of(f)} | o: {'yes' if f['o'] else 'no'}")
+        lay.addWidget(QLabel(info, dlg))
+        v = NcViewer(dlg)
+        v.setMinimumHeight(240)
+        v.set_geometry(f['text'])
+        lay.addWidget(v, 1)
+        lay.addWidget(QLabel(self.tr_('raw_content'), dlg))
+        txt = QTextEdit(dlg)
+        txt.setPlainText(f['text'])
+        txt.setFixedHeight(180)
+        lay.addWidget(txt)
+        dlg.exec()
