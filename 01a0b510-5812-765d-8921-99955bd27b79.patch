@@ -0,0 +1,189 @@
+"""NC1/DSTV text generation from parametric shapes.
+
+Converts a PlateShape + params + metadata into a valid NC1 text string
+that can be parsed by our DSTV parser (core.viewer / engine.dstv_parser)
+and read by any CNC machine.
+
+Output format matches Tekla / Lantek / ProNest NC1 convention:
+  ST → header (order, phase, grade, profile PLxx, dims)
+  AK → outer contour (face v, x y [radius])
+  IK → inner contours
+  BO → holes
+  EN → end
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Tuple
+
+from .shapes import PlateShape, ShapeResult, Contour
+from nccorrection.engine._fmt import fmt as _fmt
+
+
+def _face_line(face: str, x: float, y: float, radius: float = 0.0) -> str:
+    """One AK/IK line: '  v  123.45  67.89  10.00'"""
+    parts = [f"  {face}  {_fmt(x)}  {_fmt(y)}"]
+    if abs(radius) > 1e-9:
+        parts.append(f"  {_fmt(radius)}")
+    return "".join(parts)
+
+
+def generate_nc1(
+    shape: PlateShape,
+    params: dict,
+    *,
+    order: str = "PART-CREATOR",
+    phase: str = "1",
+    drawing: str = "",
+    position: str = "",
+    steel_grade: str = "S235JR",
+    quantity: int = 1,
+    thickness: float = 10.0,
+    scale: float = 1.0,
+    count_x: int = 1,
+    count_y: int = 1,
+    spacing: float = 20.0,
+) -> str:
+    """Generate a complete NC1 text string for the given shape + params.
+
+    Parameters
+    ----------
+    shape : PlateShape
+        The parametric shape definition.
+    params : dict
+        Shape parameters (keys match shape.parameters[i].key).
+    order, phase, drawing, position, steel_grade, quantity, thickness
+        NC1 header fields.  ``thickness`` controls the PL profile name
+        (e.g. PL10) and the dimensions block.
+    scale : float
+        Uniform scale multiplier.
+    count_x, count_y : int
+        Grid tiling count.
+
+    Returns
+    -------
+    str
+        Complete NC1 file content (text, not bytes).
+    """
+    p = shape.validate(params)
+    result = shape.generate_transformed(
+        p, scale=scale, count_x=count_x, count_y=count_y, spacing_x=spacing, spacing_y=spacing
+    )
+
+    # ── Compute bounding box for ST dimensions ────────────────────
+    outer = result.outer
+    if outer:
+        xs = [pt[0] for pt in outer]
+        ys = [pt[1] for pt in outer]
+        width = max(xs) - min(xs)
+        height = max(ys) - min(ys)
+    else:
+        width = height = 0.0
+
+    lines: List[str] = []
+
+    # ── ST block ──────────────────────────────────────────────────
+    lines.append("ST")
+    lines.append(f"  ** {drawing or shape.name}")
+    lines.append(f"  {order}")
+    lines.append(f"  {phase}")
+    lines.append(f"  {drawing or shape.name}")
+    lines.append(f"  {position or order}")
+    lines.append(f"  {steel_grade}")
+    lines.append(f"  {quantity}")
+    lines.append(f"  PL{_fmt(thickness)}")
+    lines.append(f"  B")
+    lines.append(f"  {_fmt(width)}  {_fmt(height)}")
+
+    # ── AK block — outer contour ──────────────────────────────────
+    if outer:
+        lines.append("AK")
+        for x, y in outer:
+            lines.append(_face_line("v", x, y))
+
+    # ── IK blocks — inner contours ────────────────────────────────
+    for inner in result.inners:
+        if len(inner) < 3:
+            continue
+        lines.append("IK")
+        for x, y in inner:
+            lines.append(_face_line("v", x, y))
+
+    # ── BO blocks — holes ─────────────────────────────────────────
+    for hole in result.holes:
+        x, y, d = hole.get("x", 0), hole.get("y", 0), hole.get("d", 0)
+        if d > 0:
+            lines.append("BO")
+            lines.append(f"  v  {_fmt(x)}  {_fmt(y)}  {_fmt(d)}")
+
+    # ── EN block ──────────────────────────────────────────────────
+    lines.append("EN")
+
+    return "\n".join(lines) + "\n"
+
+
+def generate_nc1_from_contour(
+    outer: Contour,
+    inners: List[Contour] = None,
+    holes: List[dict] = None,
+    *,
+    order: str = "PART-CREATOR",
+    phase: str = "1",
+    drawing: str = "",
+    position: str = "",
+    steel_grade: str = "S235JR",
+    quantity: int = 1,
+    thickness: float = 10.0,
+    width: float = 0.0,
+    height: float = 0.0,
+) -> str:
+    """Generate NC1 from raw contour data (bypasses shape classes).
+
+    Useful when contours are computed externally (e.g. imported DXF outline).
+    """
+    if not outer:
+        return ""
+
+    if width <= 0 or height <= 0:
+        xs = [pt[0] for pt in outer]
+        ys = [pt[1] for pt in outer]
+        width = max(xs) - min(xs)
+        height = max(ys) - min(ys)
+
+    lines: List[str] = []
+
+    # ST
+    lines.append("ST")
+    lines.append(f"  ** {drawing}")
+    lines.append(f"  {order}")
+    lines.append(f"  {phase}")
+    lines.append(f"  {drawing}")
+    lines.append(f"  {position or order}")
+    lines.append(f"  {steel_grade}")
+    lines.append(f"  {quantity}")
+    lines.append(f"  PL{_fmt(thickness)}")
+    lines.append(f"  B")
+    lines.append(f"  {_fmt(width)}  {_fmt(height)}")
+
+    # AK
+    lines.append("AK")
+    for x, y in outer:
+        lines.append(_face_line("v", x, y))
+
+    # IK
+    for inner in (inners or []):
+        if len(inner) < 3:
+            continue
+        lines.append("IK")
+        for x, y in inner:
+            lines.append(_face_line("v", x, y))
+
+    # BO
+    for hole in (holes or []):
+        x, y, d = hole.get("x", 0), hole.get("y", 0), hole.get("d", 0)
+        if d > 0:
+            lines.append("BO")
+            lines.append(f"  v  {_fmt(x)}  {_fmt(y)}  {_fmt(d)}")
+
+    lines.append("EN")
+    return "\n".join(lines) + "\n"
