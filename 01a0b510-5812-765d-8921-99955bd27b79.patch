+        lay.addLayout(out_row)
+
+        def on_mode():
+            copy = copy_rb.isChecked()
+            name_edit.setEnabled(copy)
+            out_edit.setEnabled(copy)
+            browse.setEnabled(copy)
+
+        orig_rb.toggled.connect(on_mode)
+        copy_rb.toggled.connect(on_mode)
+        on_mode()
+
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        btns.addWidget(cancel)
+        ok = QPushButton(self.tr_('save'), dlg)
+        ok.setObjectName('green')
+        ok.clicked.connect(dlg.accept)
+        btns.addWidget(ok)
+        lay.addLayout(btns)
+        if dlg.exec() != QDialog.Accepted:
+            return
+        try:
+            from nccorrection.core.nc1_writer import apply_hole_edits
+            edits = dict(self.hole_overrides.get(f['hash'], {}))
+            for i in self.hole_deleted.get(f['hash'], set()):
+                edits[i] = None
+            added = self.added_holes.get(f['hash'], [])
+            new_text = apply_hole_edits(f['text'], edits, add_holes=added)
+        except Exception as exc:
+            self._toast(f"{self.tr_('export_fail')}\n{exc}", kind='error',
+                        title=self.tr_('save_edits'))
+            return
+        old_hash = f['hash']
+        if copy_rb.isChecked():
+            out_dir = out_edit.text().strip() or 'output'
+            if not os.path.isdir(out_dir):
+                out_dir = os.path.join(os.path.dirname(os.path.abspath(f['path'])), out_dir)
+            try:
+                os.makedirs(out_dir, exist_ok=True)
+            except OSError:
+                out_dir = os.path.dirname(os.path.abspath(f['path']))
+            dst = os.path.join(out_dir, name_edit.text().strip() + os.path.splitext(f['name'])[1])
+            with open(dst, 'w', encoding='latin-1', newline='') as fh:
+                fh.write(new_text)
+            raw = new_text.encode('latin-1')
+            from nccorrection.core.classifier import compute_hash, classify_text
+            h = compute_hash(raw)
+            c = classify_text(new_text, os.path.basename(dst))
+            self.files.append(self._make_record(dst, new_text, h, c))
+            self._render_table()
