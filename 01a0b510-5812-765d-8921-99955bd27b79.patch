+    def test_ortho_guides_drawn_in_measure(self):
+        """With show_ortho on, a dashed crosshair is painted through the
+        cursor while measuring, adding cyan-ish pixels down the guide column
+        versus the same column with the guide disabled."""
+        from PySide6.QtGui import QImage
+        from nccorrection.engine.parser.dstv_parser import DstvParser
+        from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+        ds = DesignSettings()
+        fb = DstvRenderer2D()
