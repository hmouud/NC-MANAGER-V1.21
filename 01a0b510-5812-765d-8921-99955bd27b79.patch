+        self.assertEqual(v.outer_contour.vertices[0].suffix, 'u')
+        self.assertAlmostEqual(v.outer_contour.vertices[0].x, 0.00)
+        o = self.part.get_face('o')
+        self.assertEqual(o.outer_contour.vertices[0].suffix, 'u')
+        u = self.part.get_face('u')
+        self.assertEqual(u.outer_contour.vertices[0].suffix, 'o')
