+"""Parametric plate shape definitions — pure Python, no Qt.
+
+Each shape class defines:
+  - name / category / parameters (for the dialog + filtering)
+  - generate(params) → ShapeResult with outer contour, inners, holes
+
+Coordinates are in part-mm, origin at (0, 0).  The NC1 generator and
+geometry preview module consume these directly.
+
+Shapes mirror the standard library found in ProNest / Lantek / SigmaNEST
+shape-references (Ring, Tombstone Rectangle, Flat Sided Circle, etc.).
+
+Categories:
+  - Circular      : round / ring / flange shapes
+  - Rectangular   : square / rectangle / plate shapes
+  - Triangular    : triangle / wedge / gusset shapes
+  - Brackets      : L / U / angle / lug shapes
+  - Arc           : arc / sector / curved shapes
+  - Special       : sheave / sprocket / cone / industrial
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import List, Tuple, Optional
+
+
+# ────────────────────────────────────────────────────────────────────
+# Parameter descriptor
+# ────────────────────────────────────────────────────────────────────
+
+@dataclass
+class ShapeParam:
+    """One tunable dimension of a shape."""
+    name: str           # e.g. "Outside radius"
+    key: str            # e.g. "outer_radius"
+    default: float = 100.0
+    min_val: float = 1.0
+    max_val: float = 10000.0
+    step: float = 1.0
+    unit: str = "mm"
+
+
+# ────────────────────────────────────────────────────────────────────
+# Contour = list of (x, y) points.  Inner contours are separate lists.
+# Holes are dicts {x, y, d}.
+# ────────────────────────────────────────────────────────────────────
+
+Contour = List[Tuple[float, float]]
+
+
+@dataclass
+class ShapeResult:
+    """Output of shape generation — outer contour + optional inners + holes."""
+    outer: Contour = field(default_factory=list)
+    inners: List[Contour] = field(default_factory=list)
+    holes: List[dict] = field(default_factory=list)
+
+    def scale(self, factor_x: float, factor_y: Optional[float] = None) -> ShapeResult:
+        """Scale all contours and holes by factor_x and factor_y (or uniform)."""
+        fy = factor_x if factor_y is None else factor_y
+        new_outer = [(round(x * factor_x, 3), round(y * fy, 3)) for x, y in self.outer]
+        new_inners = [[(round(x * factor_x, 3), round(y * fy, 3)) for x, y in inn] for inn in self.inners]
+        new_holes = []
+        avg_factor = (factor_x + fy) / 2.0
+        for h in self.holes:
+            nh = dict(h)
+            nh['x'] = round(float(nh.get('x', 0.0)) * factor_x, 2)
+            nh['y'] = round(float(nh.get('y', 0.0)) * fy, 2)
+            if 'd' in nh:
+                nh['d'] = round(float(nh['d']) * avg_factor, 2)
+            if 'length' in nh:
+                nh['length'] = round(float(nh['length']) * factor_x, 2)
+            new_holes.append(nh)
+        return ShapeResult(outer=new_outer, inners=new_inners, holes=new_holes)
+
+    def array_repeat(self, count_x: int = 1, count_y: int = 1,
+                     spacing_x: float = 20.0, spacing_y: float = 20.0) -> ShapeResult:
+        """Tile the shape into a 2D array of parts on a plate."""
+        if count_x <= 1 and count_y <= 1:
+            return self
+        xs = [pt[0] for pt in self.outer]
+        ys = [pt[1] for pt in self.outer]
+        if not xs or not ys:
+            return self
+        w = max(xs) - min(xs)
+        h = max(ys) - min(ys)
+        pitch_x = w + spacing_x
+        pitch_y = h + spacing_y
+
+        combined_inners = list(self.inners)
+        combined_holes = list(self.holes)
+
+        for ix in range(count_x):
+            for iy in range(count_y):
+                if ix == 0 and iy == 0:
+                    continue
+                dx = ix * pitch_x
+                dy = iy * pitch_y
+                combined_inners.append([(round(x + dx, 3), round(y + dy, 3)) for x, y in self.outer])
+                for inn in self.inners:
+                    combined_inners.append([(round(x + dx, 3), round(y + dy, 3)) for x, y in inn])
+                for hole in self.holes:
+                    nh = dict(hole)
+                    nh['x'] = round(float(nh['x']) + dx, 2)
+                    nh['y'] = round(float(nh['y']) + dy, 2)
+                    combined_holes.append(nh)
+
+        return ShapeResult(outer=list(self.outer), inners=combined_inners, holes=combined_holes)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Base class
+# ────────────────────────────────────────────────────────────────────
+
+class PlateShape:
+    """Abstract base for a parametric plate shape."""
+    name: str = "Unknown"
+    category: str = "Special"
+    icon_name: str = "unknown"
+    parameters: List[ShapeParam] = field(default_factory=list)
+
+    def generate(self, params: dict) -> ShapeResult:
+        """Produce outer contour, inner contours and holes from *params*."""
+        raise NotImplementedError
+
+    def generate_transformed(self, params: dict, scale: float = 1.0,
+                             count_x: int = 1, count_y: int = 1,
+                             spacing_x: float = 20.0, spacing_y: float = 20.0) -> ShapeResult:
+        """Produce shape with scaling and optional multi-part 2D tiling."""
+        res = self.generate(self.validate(params))
+        if scale != 1.0 and scale > 0:
+            res = res.scale(scale)
+        if count_x > 1 or count_y > 1:
+            res = res.array_repeat(count_x, count_y, spacing_x, spacing_y)
+        return res
+
+    def defaults(self) -> dict:
+        """Return a dict of key→default for all parameters."""
+        return {p.key: p.default for p in self.parameters}
+
+    def validate(self, params: dict) -> dict:
+        """Clamp every parameter to its [min, max] range."""
+        out = {}
+        for p in self.parameters:
+            v = float(params.get(p.key, p.default))
+            v = max(p.min_val, min(p.max_val, v))
+            out[p.key] = v
+        return out
+
+
+# ────────────────────────────────────────────────────────────────────
+# Helpers
+# ────────────────────────────────────────────────────────────────────
+
+def _circle_pts(cx: float, cy: float, r: float,
+                n: int = 64, start_deg: float = 0.0) -> Contour:
+    """Return *n* evenly-spaced points on a circle (closed contour)."""
+    pts = []
+    for i in range(n):
+        a = math.radians(start_deg + 360.0 * i / n)
+        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
+    return pts
+
+
+def _arc_pts(cx: float, cy: float, r: float,
+             start_deg: float, end_deg: float,
+             n: int = 32) -> Contour:
+    """Return points along an arc from start_deg to end_deg."""
+    sweep = end_deg - start_deg
+    if sweep < 0:
+        sweep += 360.0
+    pts = []
+    for i in range(n + 1):
+        a = math.radians(start_deg + sweep * i / n)
+        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
+    return pts
+
+
+def _regular_polygon_pts(cx: float, cy: float, r: float,
+                         n_sides: int, start_deg: float = 90.0) -> Contour:
+    """Return vertices of a regular *n*-sided polygon."""
+    pts = []
+    for i in range(n_sides):
+        a = math.radians(start_deg + 360.0 * i / n_sides)
+        pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
+    return pts
+
+
+# ════════════════════════════════════════════════════════════════════
+#  CIRCULAR SHAPES
+# ════════════════════════════════════════════════════════════════════
+
+class CircleShape(PlateShape):
+    """Solid circle."""
+    name = "Circle"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Radius", "radius", 100.0, 5.0, 5000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        return ShapeResult(outer=_circle_pts(0, 0, p["radius"]))
+
+
+class RingShape(PlateShape):
+    """Circle with concentric hole."""
+    name = "Ring"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Outside radius", "outer_radius", 100.0, 5.0, 5000.0),
+        ShapeParam("Inside radius", "inner_radius", 50.0, 0.0, 4999.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["outer_radius"]
+        r = p["inner_radius"]
+        outer = _circle_pts(0, 0, R)
+        inners = [_circle_pts(0, 0, r)] if r > 1.0 else []
+        return ShapeResult(outer=outer, inners=inners)
+
+
+class FlatSidedCircleShape(PlateShape):
+    """Circle with two parallel flats."""
+    name = "Flat Sided Circle"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Radius", "radius", 100.0, 5.0, 5000.0),
+        ShapeParam("Flat distance", "flat_dist", 20.0, 1.0, 4000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["radius"]
+        fd = p["flat_dist"]
+        half_flat_y = fd / 2.0
+        if half_flat_y >= R:
+            return ShapeResult(outer=[
+                (-R, -half_flat_y), (R, -half_flat_y),
+                (R, half_flat_y), (-R, half_flat_y),
+            ])
+        ang = math.asin(half_flat_y / R)
+        right_arc = _arc_pts(0, 0, R, -math.degrees(ang), math.degrees(ang), 20)
+        left_arc = _arc_pts(0, 0, R, 180 - math.degrees(ang),
+                            180 + math.degrees(ang), 20)
+        outer = right_arc + [(R * math.cos(ang), half_flat_y)]
+        outer += [(R * math.cos(math.pi - ang), half_flat_y)]
+        outer += left_arc
+        outer += [(R * math.cos(math.pi + ang), -half_flat_y)]
+        outer += [(R * math.cos(-ang), -half_flat_y)]
+        return ShapeResult(outer=outer)
+
+
+class BoltHoleCircleShape(PlateShape):
+    """Circle with evenly-spaced bolt holes."""
+    name = "Bolt Hole Circle"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Radius", "radius", 100.0, 5.0, 5000.0),
+        ShapeParam("Bolt circle radius", "bolt_radius", 80.0, 5.0, 4999.0),
+        ShapeParam("Hole diameter", "hole_d", 22.0, 1.0, 500.0),
+        ShapeParam("Number of holes", "n_holes", 6.0, 1.0, 72.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["radius"]
+        br = p["bolt_radius"]
+        hd = p["hole_d"]
+        n = int(p["n_holes"])
+        outer = _circle_pts(0, 0, R)
+        holes = []
+        for i in range(n):
+            a = math.radians(90.0 + 360.0 * i / n)
+            holes.append({'x': br * math.cos(a), 'y': br * math.sin(a), 'd': hd})
+        return ShapeResult(outer=outer, holes=holes)
+
+
+class CircularFlangeShape(PlateShape):
+    """Circular flange with bolt circle and central bore."""
+    name = "Circular Flange"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Flange radius", "flange_radius", 120.0, 5.0, 5000.0),
+        ShapeParam("Bore radius", "bore_radius", 30.0, 0.0, 4999.0),
+        ShapeParam("Bolt circle radius", "bolt_radius", 95.0, 5.0, 4999.0),
+        ShapeParam("Hole diameter", "hole_d", 18.0, 1.0, 500.0),
+        ShapeParam("Number of holes", "n_holes", 8.0, 1.0, 72.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        fr = p["flange_radius"]
+        br = p["bore_radius"]
+        bcr = p["bolt_radius"]
+        hd = p["hole_d"]
+        n = int(p["n_holes"])
+        outer = _circle_pts(0, 0, fr)
+        inners = [_circle_pts(0, 0, br)] if br > 1.0 else []
+        holes = []
+        for i in range(n):
+            a = math.radians(90.0 + 360.0 * i / n)
+            holes.append({'x': bcr * math.cos(a), 'y': bcr * math.sin(a), 'd': hd})
+        return ShapeResult(outer=outer, inners=inners, holes=holes)
+
+
+class CircFlangeDiamsShape(PlateShape):
+    """Circular flange with two diametrically opposed bolt holes."""
+    name = "Circ Flange-Diams"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Flange radius", "flange_radius", 100.0, 5.0, 5000.0),
+        ShapeParam("Bore radius", "bore_radius", 25.0, 0.0, 4999.0),
+        ShapeParam("Bolt circle radius", "bolt_radius", 80.0, 5.0, 4999.0),
+        ShapeParam("Hole diameter", "hole_d", 14.0, 1.0, 500.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        fr = p["flange_radius"]
+        br = p["bore_radius"]
+        bcr = p["bolt_radius"]
+        hd = p["hole_d"]
+        outer = _circle_pts(0, 0, fr)
+        inners = [_circle_pts(0, 0, br)] if br > 1.0 else []
+        holes = [
+            {'x': bcr, 'y': 0, 'd': hd},
+            {'x': -bcr, 'y': 0, 'd': hd},
+        ]
+        return ShapeResult(outer=outer, inners=inners, holes=holes)
+
+
+class CircleWithRadialSlotsShape(PlateShape):
+    """Circle with radial slots emanating from the centre."""
+    name = "Circle w Radial Slots"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Radius", "radius", 100.0, 5.0, 5000.0),
+        ShapeParam("Slot length", "slot_length", 40.0, 1.0, 4000.0),
+        ShapeParam("Slot width", "slot_width", 10.0, 1.0, 500.0),
+        ShapeParam("Number of slots", "n_slots", 4.0, 1.0, 24.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["radius"]
+        sl = p["slot_length"]
+        sw = p["slot_width"]
+        n = int(p["n_slots"])
+        outer = _circle_pts(0, 0, R)
+        inners = []
+        for i in range(n):
+            a = math.radians(90.0 + 360.0 * i / n)
+            cos_a, sin_a = math.cos(a), math.sin(a)
+            # Slot as elongated hole (two semicircles connected by lines)
+            slot_pts = []
+            hw = sw / 2.0
+            for j in range(16):
+                t = math.radians(180.0 * j / 16)
+                slot_pts.append((
+                    (sl - hw) * cos_a - hw * sin_a * math.sin(t),
+                    (sl - hw) * sin_a + hw * cos_a * math.sin(t)
+                ))
+            for j in range(16):
+                t = math.radians(180.0 + 180.0 * j / 16)
+                slot_pts.append((
+                    hw * cos_a - hw * sin_a * math.sin(t),
+                    hw * sin_a + hw * cos_a * math.sin(t)
+                ))
+            inners.append(slot_pts)
+        return ShapeResult(outer=outer, inners=inners)
+
+
+class CircFlangeWithRadialSlotsShape(PlateShape):
+    """Flange with central bore and radial slots."""
+    name = "Circ Flange w Radial Slots"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Flange radius", "flange_radius", 120.0, 5.0, 5000.0),
+        ShapeParam("Bore radius", "bore_radius", 25.0, 0.0, 4999.0),
+        ShapeParam("Slot length", "slot_length", 35.0, 1.0, 4000.0),
+        ShapeParam("Slot width", "slot_width", 8.0, 1.0, 500.0),
+        ShapeParam("Number of slots", "n_slots", 4.0, 1.0, 24.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        fr = p["flange_radius"]
+        br = p["bore_radius"]
+        sl = p["slot_length"]
+        sw = p["slot_width"]
+        n = int(p["n_slots"])
+        outer = _circle_pts(0, 0, fr)
+        inners = []
+        if br > 1.0:
+            inners.append(_circle_pts(0, 0, br))
+        for i in range(n):
+            a = math.radians(90.0 + 360.0 * i / n)
+            cos_a, sin_a = math.cos(a), math.sin(a)
+            hw = sw / 2.0
+            slot_pts = []
+            for j in range(16):
+                t = math.radians(180.0 * j / 16)
+                slot_pts.append((
+                    (br + sl - hw) * cos_a - hw * sin_a * math.sin(t),
+                    (br + sl - hw) * sin_a + hw * cos_a * math.sin(t)
+                ))
+            for j in range(16):
+                t = math.radians(180.0 + 180.0 * j / 16)
+                slot_pts.append((
+                    (br + hw) * cos_a - hw * sin_a * math.sin(t),
+                    (br + hw) * sin_a + hw * cos_a * math.sin(t)
+                ))
+            inners.append(slot_pts)
+        return ShapeResult(outer=outer, inners=inners)
+
+
+class CircFlangeWithSlotsShape(PlateShape):
+    """Flange with bolt circle and arc slots at each bolt position."""
+    name = "Circ Flange w Slots"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Flange radius", "flange_radius", 120.0, 5.0, 5000.0),
+        ShapeParam("Bore radius", "bore_radius", 25.0, 0.0, 4999.0),
+        ShapeParam("Bolt circle radius", "bolt_radius", 95.0, 5.0, 4999.0),
+        ShapeParam("Slot arc radius", "slot_r", 10.0, 1.0, 500.0),
+        ShapeParam("Slot span angle", "slot_angle", 30.0, 5.0, 90.0),
+        ShapeParam("Number of slots", "n_slots", 8.0, 1.0, 36.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        fr = p["flange_radius"]
+        br = p["bore_radius"]
+        bcr = p["bolt_radius"]
+        sr = p["slot_r"]
+        sa = p["slot_angle"]
+        n = int(p["n_slots"])
+        outer = _circle_pts(0, 0, fr)
+        inners = []
+        if br > 1.0:
+            inners.append(_circle_pts(0, 0, br))
+        for i in range(n):
+            a = 90.0 + 360.0 * i / n
+            cx = bcr * math.cos(math.radians(a))
+            cy = bcr * math.sin(math.radians(a))
+            slot_pts = _arc_pts(cx, cy, sr, a - sa / 2, a + sa / 2, 12)
+            inners.append(slot_pts)
+        return ShapeResult(outer=outer, inners=inners)
