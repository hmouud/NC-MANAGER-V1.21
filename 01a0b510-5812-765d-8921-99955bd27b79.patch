+"""Format Analyzer demo — run headless:
+
+    PYTHONPATH=src python tools/format_analyzer_demo.py
+
+Writes two temp files (an NC1 plate with holes + a basic DXF), analyzes them
+with engine/format_analyzer.analyze_file and prints the DetailReport JSON.
+"""
+
+import json
+import os
+import tempfile
+
+from nccorrection.engine.format_analyzer import analyze_file
+
+NC1_PLATE = """ST
