@@ -0,0 +1,406 @@
+"""Complete DSTV NC1 parser.
+
+Reads an NC1 file and produces a :class:`~nccorrection.engine.parser.dstv_part.DstvPart`
+with per-face geometry (outer contour AK, inner contours IK, holes BO,
+markings SI/PU/KO and bends KA), splitting every feature into its own face
+coordinate system.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import List, Optional
+
+from nccorrection.engine.parser.dstv_face import DstvFace
+from nccorrection.engine.parser.dstv_part import (DstvBend, DstvContour,
+                                                  DstvHeader, DstvHole,
+                                                  DstvMarking, DstvPart,
+                                                  DstvVertex)
+from nccorrection.core.viewer import (parse_bo_feature, parse_ka_line,
+                                      _estimate_thickness)
+
+_NUM = r'(?:(?<=^)|(?<=\s))[-+]?\d+(?:[\.,]\d+)?(?:[eE][-+]?\d+)?'
+_TOKEN = re.compile(r'(' + _NUM + r')([a-zA-Z]*)')
+_FACE = re.compile(r'^\s*([vuoVUOHh])\s*')
+_GRADE = re.compile(r'^S\d{3}[A-Za-z]*$')
+_PROFILE_TYPES = {'I', 'U', 'L', 'B', 'M', 'RO', 'RU', 'C', 'T', 'SO', 'Z', 'O'}
+BLOCK_CODES = {'ST', 'AK', 'IK', 'BO', 'SI', 'PU', 'KO', 'KA', 'EN', 'UE', 'PR', 'SC'}
+
+
+def _strip_suffix(token):
+    """Split a numeric token like '40.00s' into ('40.00', 's')."""
+    m = _TOKEN.match(token.strip())
+    if not m:
+        return 0.0, ''
+    try:
+        return float(m.group(1).replace(',', '.')), m.group(2)
+    except ValueError:
+        return 0.0, ''
+
+
+def _tokens(line):
+    """Return list of ``(value, suffix)`` tokens for every number in a line."""
+    return [(_strip_suffix(t[0])[0], _strip_suffix(t[0])[1])
+            for t in re.finditer(_TOKEN, line)]
+
+
+def _face_of(line, default='v'):
+    m = _FACE.match(line)
+    if m:
+        return m.group(1).lower()
+    return default
+
+
+def _vertices_from_tokens(toks):
+    """Turn ``(value, suffix)`` tokens into a list of :class:`DstvVertex`.
+
+    Handles both formats found in the wild:
+      * classic triples   -> X Y bulge X Y bulge ...
+      * real 7-column     -> X Y R alpha beta w1 w2  (one vertex per line)
+    """
+    values = [t[0] for t in toks]
+    suffixes = [t[1] for t in toks]
+    if len(values) < 3:
+        return []
+    verts = []
+    if len(values) == 7:
+        verts.append(DstvVertex(x=values[0], y=values[1], bulge=values[2],
+                                alpha=values[3], beta=values[4],
+                                suffix=suffixes[0] or suffixes[1]))
+    elif len(values) % 3 == 0:
+        for i in range(0, len(values), 3):
+            verts.append(DstvVertex(x=values[i], y=values[i + 1],
+                                    bulge=values[i + 2],
+                                    suffix=suffixes[i] or suffixes[i + 1]
+                                    or suffixes[i + 2]))
+    else:
+        verts.append(DstvVertex(x=values[0], y=values[1], bulge=values[2],
+                                suffix=suffixes[0] or suffixes[1]))
+        i = 3
+        while i + 1 < len(values):
+            verts.append(DstvVertex(x=values[i], y=values[i + 1],
+                                    bulge=values[i + 2] if i + 2 < len(values) else 0.0))
+            i += 2
+    return verts
+
+
+def _split_closed(vertices):
+    """Split one accumulated vertex stream into separate closed contours.
+
+    Whenever the running polyline closes back onto its first vertex and more
+    vertices follow, a new contour starts (needed for several IK cutouts on
+    one face).
+    """
+    out = []
+    if not vertices:
+        return out
+    cur = [vertices[0]]
+    for v in vertices[1:]:
+        if len(cur) >= 3:
+            a = cur[0]
+            if abs(v.x - a.x) < 1e-9 and abs(v.y - a.y) < 1e-9:
+                out.append(cur)
+                cur = []
+        cur.append(v)
+    if cur:
+        out.append(cur)
+    return out
+
+
+def _classify_arc_convention(vertices):
+    """Detect whether a contour uses **radius** or **bulge** convention.
+
+    The 3rd column of AK/IK lines is ambiguous in the wild:
+
+    * DSTV standard  → ``bulge = tan(θ/4)`` — always in [−1, +1]
+    * Some CAM tools → ``radius`` in mm     — can exceed 1.0
+
+    Detection rule (matches open-source parsers ``tluijken/dstv`` and
+    ``Baseflow/DSTV.Net`` which both call the field ``radius``):
+
+    If ANY vertex (excluding the closing duplicate) has ``|value| > 1.0``
+    the contour uses the **radius** convention — the value is transferred
+    to ``DstvVertex.radius`` and ``bulge`` is zeroed.  Otherwise the
+    standard bulge convention is kept unchanged.
+
+    Returns ``True`` when the contour was reclassified as radius convention.
+    """
+    # Skip the closing vertex (last = first copy) to avoid false positives
+    check = vertices[:-1] if len(vertices) >= 3 else vertices
+    is_radius = any(abs(v.bulge) > 1.0 for v in check)
+    if is_radius:
+        for v in vertices:
+            v.radius = v.bulge
+            v.bulge = 0.0
+    return is_radius
+
+
+class DstvParser:
+    """Parse a complete NC1/DSTV file into a :class:`DstvPart`."""
+
+    def parse_file(self, filepath: str) -> DstvPart:
+        with open(filepath, 'rb') as fh:
+            text = fh.read().decode('latin-1')
+        return self.parse_text(text)
+
+    def parse_text(self, text: str) -> DstvPart:
+        lines = [ln.rstrip('\n') for ln in (text or '').splitlines()]
+        part = DstvPart(raw_lines=list(lines))
+        block = None
+        ak_stream, ik_stream = {}, {}
+        cur_ak_face = 'v'
+        cur_ik_face = 'v'
+        bo_holes = []
+        bends = []
+        markings = []
+        st_lines = []
+        for line in lines:
+            stripped = line.strip()
+            if not stripped:
+                continue
+            if stripped.startswith(('**', ';', '#', '//')):
+                continue
+            if stripped.upper() in BLOCK_CODES:
+                block = stripped.upper()
+                if block == 'EN':
+                    break
+                continue
+            if block == 'ST':
+                st_lines.append(stripped)
+            elif block == 'AK':
+                m = _FACE.match(stripped)
+                face = m.group(1).lower() if m else cur_ak_face
+                cur_ak_face = face
+                verts = _vertices_from_tokens(_tokens(stripped))
+                if verts:
+                    ak_stream.setdefault(face, []).extend(verts)
+            elif block == 'IK':
+                m = _FACE.match(stripped)
+                face = m.group(1).lower() if m else cur_ik_face
+                cur_ik_face = face
+                verts = _vertices_from_tokens(_tokens(stripped))
+                if verts:
+                    ik_stream.setdefault(face, []).extend(verts)
+            elif block == 'BO':
+                bo_holes.extend(self._parse_bo_line(stripped))
+            elif block == 'KA':
+                bend = self._parse_bend_line(stripped)
+                if bend is not None:
+                    bends.append(bend)
+            elif block in ('SI', 'PU', 'KO'):
+                markings.extend(self._parse_marking_line(stripped, block.lower()))
+
+        header = self._parse_st_block(st_lines)
+        part.header = header
+
+        # 5-column KA dialect: bend thickness is omitted and inherited from
+        # the plate's thickness in the ST header (owner law 2026-09-12).
+        # Fill the fallback: first from a 'PL10'-style profile name (same
+        # pattern the classifier uses), then from the same dimension
+        # estimator the geometry path uses (core.viewer._estimate_thickness)
+        # so engine and viewers agree.
+        plate_t = _plate_thickness_from_name(header.profile_name)
+        if plate_t is None:
+            plate_t = _estimate_thickness({'type': header.profile_type,
+                                           'dims': header.raw_dims})
+        for b in bends:
+            if b.thickness is None:
+                b.thickness = plate_t
+
+        contours = []
+        for face, verts in ak_stream.items():
+            for chunk in _split_closed(verts):
+                _classify_arc_convention(chunk)
+                contours.append(DstvContour(face=face, vertices=chunk,
+                                            kind='outer'))
+        for face, verts in ik_stream.items():
+            for chunk in _split_closed(verts):
+                _classify_arc_convention(chunk)
+                contours.append(DstvContour(face=face, vertices=chunk,
+                                            kind='inner'))
+        part.contours = contours
+        part.holes = bo_holes
+        part.bends = bends
+        part.markings = markings
+
+        faces = {}
+        for code in ('v', 'o', 'u', 'h'):
+            face = DstvFace(face_code=code)
+            face.outer_contour = next((c for c in contours
+                                       if c.face == code and c.kind == 'outer'), None)
+            face.inner_contours = [c for c in contours
+                                   if c.face == code and c.kind == 'inner']
+            face.holes = [h for h in bo_holes if h.face == code]
+            face.markings = [m for m in markings if m.face == code]
+            if (face.outer_contour or face.inner_contours or face.holes
+                    or face.markings):
+                faces[code] = face
+        part.faces = faces
+        return part
+
+    # ------------------------------------------------------------------ ST
+    def _parse_st_block(self, lines: List[str]) -> DstvHeader:
+        """Parse the ST block into a :class:`DstvHeader`.
+
+        Layout of a real NC1 ST block::
+
+            ST
+            ** D-68.nc1          comment
+              23-001             order id
+              1                  phase mark
+              D-68               drawing
+              D-68               position mark
+              S235JR             steel grade
+              1                  quantity (first integer after the grade)
+              IPE360             profile name
+              I                  profile type code
+              650.00             dimensions from here on: length, height,
+              360.00             width, flange_t, web_t, radius, ...
+        """
+        header = DstvHeader()
+        # piece mark (Repère): 2nd line of the ST block (line index 1,
+        # immediately after the ST header) per CTO directive S11-STEP2.
+        if len(lines) > 1:
+            header.position_mark = lines[1].strip()
+        profile_type_idx = None
+        grade_idx = None
+        non_comments = [ln for ln in lines if not ln.startswith('**')]
+        for i, ln in enumerate(lines):
+            if ln in _PROFILE_TYPES:
+                profile_type_idx = i
+                header.profile_type = ln
+        # profile name = nearest preceding word-like line (skips numbers/comments)
+        if profile_type_idx is not None:
+            j = profile_type_idx - 1
+            while j >= 0 and not _looks_like_profile_name(lines[j]):
+                j -= 1
+            if j >= 0:
+                header.profile_name = lines[j]
+        else:
+            for ln in non_comments:
+                if _looks_like_profile_name(ln):
+                    header.profile_name = ln
+                    break
+        for i, ln in enumerate(lines):
+            if _GRADE.match(ln):
+                header.steel_grade = ln
+                grade_idx = i
+        # quantity: first pure integer after the steel grade line
+        if grade_idx is not None:
+            for ln in lines[grade_idx + 1:]:
+                m = re.match(r'^\s*(\d+)\s*$', ln)
+                if m:
+                    header.quantity = int(m.group(1))
+                    break
+        # order id: first non-comment line
+        if non_comments:
+            header.order_id = non_comments[0]
+        # dimensions: numeric tokens after the profile-type line
+        dims = []
+        if profile_type_idx is not None:
+            for ln in lines[profile_type_idx + 1:]:
+                dims.extend(v for v, _ in _tokens(ln))
+        header.raw_dims = dims
+        if dims:
+            header.length = dims[0]
+        if len(dims) >= 2:
+            header.profile_height = dims[1]
+        if len(dims) >= 3:
+            header.flange_width = dims[2]
+        if len(dims) >= 4:
+            header.flange_thickness = dims[3]
+        if len(dims) >= 5:
+            header.web_thickness = dims[4]
+        if len(dims) >= 6:
+            header.fillet_radius = dims[5]
+        return header
+
+    # ------------------------------------------------------------------ BO
+    def _parse_bo_line(self, line: str) -> List[DstvHole]:
+        """Parse one BO line into DstvHole records.
+
+        Delegates to ``core.viewer.parse_bo_feature`` — the single source of
+        truth for DSTV BO feature lines — so the engine always agrees with
+        the 2D/3D viewers on hole/slot geometry, including angular slots and
+        ``l``-suffix slot markers (e.g. ``0.00l``).
+
+        DSTV hole records come in two shapes:
+          * round:    ``face x y d``
+          * slotted:  ``face x y d [l_marker] L ay1 ay2``  (the ``l``-marker
+                      token, e.g. ``0.00l``, is not the length itself — the
+                      slot length ``L`` follows it)
+        """
+        feat = parse_bo_feature(line)
+        if feat is None:
+            return []
+        if feat['kind'] == 'slot':
+            return [DstvHole(face=feat['face'], x=feat['x'], y=feat['y'],
+                             diameter=feat['d'], is_slot=True,
+                             slot_length=feat['length'], slot_width=feat['d'],
+                             angle=feat['angle'])]
+        return [DstvHole(face=feat['face'], x=feat['x'], y=feat['y'],
+                         diameter=feat['d'])]
+
+    # ------------------------------------------------------------------ KA
+    def _parse_bend_line(self, line: str) -> Optional[DstvBend]:
+        """Parse one KA (bend) line into a DstvBend, or None if malformed.
+
+        Delegates to ``core.viewer.parse_ka_line`` — the single source of
+        truth for KA bend lines — so the engine always agrees with the 2D/3D
+        geometries on bend records. A line with fewer than 5 numbers is not
+        a valid bend and is skipped (None); we never fabricate a bend from
+        partial data. The 5-column dialect (no thickness) yields
+        ``DstvBend.thickness=None``; ``parse_text`` fills the fallback from
+        the part thickness once the ST header is known.
+
+        Field 6 is disambiguated: values > 1000 = bend RADIUS; smaller =
+        plate THICKNESS (owner law 2026-09-12, updated). The radius is
+        stored separately in DstvBend.radius.
+        """
+        feat = parse_ka_line(line)
+        if feat is None:
+            return None
+        return DstvBend(x1=feat['x1'], y1=feat['y1'], x2=feat['x2'],
+                        y2=feat['y2'], angle=feat['angle'],
+                        thickness=feat['thickness'],
+                        radius=feat.get('radius'))
+
+    # ------------------------------------------------------- SI / PU / KO
+    def _parse_marking_line(self, line: str, kind: str) -> List[DstvMarking]:
+        face = _face_of(line)
+        values = [t[0] for t in _tokens(line)]
+        text = _TOKEN.sub(' ', line).strip()
+        text = _FACE.sub('', text).strip()
+        if len(values) >= 2:
+            return [DstvMarking(face=face, x=values[0], y=values[1],
+                                text=text, kind=kind)]
+        return []
+
+
+def _looks_like_profile_name(token: str) -> bool:
+    """A profile name is a word containing letters and digits (IPE360,
+    HEA200, PL20, L60*6, ...) that is not a steel grade."""
+    if not re.search(r'[A-Za-z]', token):
+        return False
+    if _GRADE.match(token):
+        return False
+    if token.startswith('**'):
+        return False
+    return True
+
+
+def _plate_thickness_from_name(name: str):
+    """Plate thickness in mm from a 'PL10'-style profile name, else None.
+
+    Reuses the same ``PL<digits>`` pattern the classifier uses
+    (core/classifier.py); 5-column KA bends inherit their thickness from
+    the plate in the ST header (owner law 2026-09-12)."""
+    if not name:
+        return None
+    m = re.search(r'\bPL\s*0*(\d+(?:\.\d+)?)\s*\b', name, re.IGNORECASE)
+    if not m:
+        return None
+    try:
+        return float(m.group(1))
+    except ValueError:
+        return None
