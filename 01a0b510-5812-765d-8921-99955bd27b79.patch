+"""NC Manager Dimensioning Engine.
+
+Professional CAD dimension annotations: radius, diameter, angular, linear,
+leader, center mark, and bolt-circle patterns. Built from scratch following
+ISO/AutoCAD/LibreCAD conventions but integrated directly into the NC Manager
+rendering pipeline.
+
+Architecture::
+
+    types.py     ← Pure data classes (no Qt)
+    style.py     ← DimensionStyle config (no Qt)
+    geometry.py  ← Pure math (no Qt)
+    detector.py  ← Auto-detection of contours + bolt circles (no Qt)
+    renderer.py  ← QPainter rendering engine (Qt only here)
+
+Usage::
+
+    from nccorrection.design.dimensioning import (
+        DimensionRenderer, DEFAULT_STYLE, auto_dimensions,
+        RadiusDimension, AngularDimension, Point2D,
+    )
+
+    # Auto-detect dimensions from geometry dict
+    dims = auto_dimensions(geometry)
+
+    # Render them
+    renderer = DimensionRenderer(painter, style, to_screen_fn)
+    renderer.draw_group(dims)
+"""
+
+from .types import (
+    Point2D,
+    Circle,
+    Arc,
+    RadiusDimension,
+    DiameterDimension,
+    AngularDimension,
+    LinearDimension,
+    LeaderDimension,
+    CenterMark,
+    BoltCirclePattern,
+    DimensionGroup,
+    DimType,
+    ArrowStyle,
+    TextPlacement,
+    LeaderStyle,
+)
+
+from .style import (
+    DimensionStyle,
+    DEFAULT_STYLE,
+    BLUEPRINT_STYLE,
+    style_from_theme,
+)
+
+from .geometry import (
+    circle_from_3_points,
+    arc_points,
+    arc_between_angles,
+    leader_endpoint,
+    text_position_for_radius,
+    text_position_for_diameter,
+    text_position_for_angular,
+    optimal_text_rotation,
+    detect_bolt_circles,
+    angular_spacing,
+)
+
+from .detector import (
+    detect_circular_contours,
+    detect_holes_on_circle,
+    auto_dimensions,
+)
+
+from .renderer import DimensionRenderer
+
+__all__ = [
+    # Types
+    'Point2D', 'Circle', 'Arc',
+    'RadiusDimension', 'DiameterDimension', 'AngularDimension',
+    'LinearDimension', 'LeaderDimension', 'CenterMark',
+    'BoltCirclePattern', 'DimensionGroup',
+    'DimType', 'ArrowStyle', 'TextPlacement', 'LeaderStyle',
+    # Style
+    'DimensionStyle', 'DEFAULT_STYLE', 'BLUEPRINT_STYLE', 'style_from_theme',
+    # Geometry
+    'circle_from_3_points', 'arc_points', 'arc_between_angles',
+    'leader_endpoint', 'text_position_for_radius',
+    'text_position_for_diameter', 'text_position_for_angular',
+    'optimal_text_rotation', 'detect_bolt_circles', 'angular_spacing',
+    # Detector
+    'detect_circular_contours', 'detect_holes_on_circle', 'auto_dimensions',
+    # Renderer
+    'DimensionRenderer',
+]
