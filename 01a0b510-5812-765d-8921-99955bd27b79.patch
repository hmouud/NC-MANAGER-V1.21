index 0000000..d12978d
--- /dev/null
+++ b/src/nccorrection/engine/contour/notch_detector.py
@@ -0,0 +1,117 @@
+"""Notch detector — identifies w/t suffix markers in AK blocks.
+
+DSTV suffix semantics (confirmed by SDS/2 CNC PDF and open-source docs):
+  s = Start point (first point of each AK face)
+  u = Continuation (subsequent points)
+  w = Hole/Notch indicator (NOT "Web intersection")
+  t = Tangential Notch (not yet found in our templates)
+
+The w suffix can appear on EITHER the x or y value:
+  '548.63w' → suffix='w' on x=548.63
+  '262.00w' → suffix='w' on y=262.00
+
+Ground truth from 37 templates:
+  - Only A39.nc1 and A40.nc1 contain 'w' suffix (5 occurrences total)
+  - A39: w on y=262.00 (3 times) — notch corners at web midpoint
+  - A40: w on y=90.00 (2 times) — flange cut transition points
+"""
+from __future__ import annotations
+
+import re
+from typing import List, Tuple, Optional
+
+from .profile_model import NotchPoint
+
+
+def parse_ak_line(line: str) -> Optional[NotchPoint]:
+    """Parse a single AK data line into (x, y, suffix).
+
+    Handles both formats:
+      '  v     132.62s      0.00  ...'  → face='v', x=132.62, suffix='s', y=0.00
+      '       548.63     262.00w ...'  → x=548.63, suffix='w', y=262.00
+
+    The suffix can appear on either x or y value.
+    """
+    parts = line.split()
+    if len(parts) < 2:
+        return None
+
+    # Determine if first token is a face character
+    first = parts[0]
+    if first in ('v', 'o', 'u', 'h'):
+        # Face line: tokens are face, x, y, ...
+        x_idx, y_idx = 1, 2
+    else:
+        # Continuation line: tokens are x, y, ...
+        x_idx, y_idx = 0, 1
+
+    if len(parts) <= y_idx:
+        return None
+
+    x_val, x_suffix = _parse_num_with_suffix(parts[x_idx])
+    y_val, y_suffix = _parse_num_with_suffix(parts[y_idx])
+    suffix = x_suffix or y_suffix
+
+    return NotchPoint(x=x_val, y=y_val, suffix=suffix)
+
+
+def detect_notches(ak_lines: List[str]) -> List[NotchPoint]:
+    """Scan AK data lines and return all points with w or t suffixes.
+
+    Parameters
+    ----------
+    ak_lines : list of str
+        Raw AK data lines (not block headers).
+
+    Returns
+    -------
+    list of NotchPoint
+        Points with suffix markers. Empty list if none found.
+    """
+    notches = []
+    for line in ak_lines:
+        pt = parse_ak_line(line)
+        if pt and pt.suffix in ('w', 't'):
+            notches.append(pt)
+    return notches
+
+
+def count_suffixes(ak_lines: List[str]) -> dict:
+    """Count suffix distribution across all AK lines.
+
+    Returns dict mapping suffix character → count.
+    Useful for ground-truth verification against templates.
+    """
+    counts = {}
+    for line in ak_lines:
+        pt = parse_ak_line(line)
+        if pt:
+            key = pt.suffix or 'none'
+            counts[key] = counts.get(key, 0) + 1
+    return counts
+
+
+# ── Internal helpers ───────────────────────────────────────────────
+
+_SUFFIX_RE = re.compile(r'([a-zA-Z])$')
+
+
+def _parse_num_with_suffix(raw: str) -> Tuple[float, str]:
+    """Parse a number that may have a trailing suffix letter.
+
+    '262.00w' → (262.00, 'w')
+    '132.62s' → (132.62, 's')
+    '548.63'  → (548.63, '')
+    """
+    suffix = ''
+    m = _SUFFIX_RE.search(raw)
+    if m:
+        suffix = m.group(1).lower()
+        raw = raw[:m.start()]
+
+    try:
+        val = float(raw)
+    except ValueError:
+        val = 0.0
+
+    return val, suffix
