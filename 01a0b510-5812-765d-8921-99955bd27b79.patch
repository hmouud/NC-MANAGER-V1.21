+"""profile_model.py — ProfileGeometryModel.
+
+🚨 GUARDIAN LAW: كايستعمل الـ registry للـ mappings. ما كايحتويش على cut logic.
+"""
+from __future__ import annotations
+import math
+from dataclasses import dataclass, field
+from typing import Dict, List
+
+from ..core.enums import ProfileKind, Face
+from ..core.exceptions import InvalidProfileKindError
+from ..geometry.dimensions import ProfileDimensions
+from ..registry.face_registry import get_faces, get_width_rule
+
+
+@dataclass
+class ProfileGeometryModel:
+    """النموذج الهندسي الكامل للبروفيل."""
+    kind: ProfileKind
+    dimensions: ProfileDimensions
+    faces: List[Face] = field(default_factory=list)
+    base_widths: Dict[Face, float] = field(default_factory=dict)
+
+    def __post_init__(self) -> None:
+        if not self.faces:
+            self.faces = get_faces(self.kind)
+        if not self.base_widths:
+            self.base_widths = self._compute_base_widths()
+
+    def _compute_base_widths(self) -> Dict[Face, float]:
+        """كايحسب عرض كل وجه من الـ registry rules."""
+        widths: Dict[Face, float] = {}
+        d = self.dimensions
+        for face in self.faces:
+            rule = get_width_rule(self.kind, face)
+            if rule == "H":
+                widths[face] = d.H
+            elif rule == "b":
+                widths[face] = d.b
+            elif rule == "D":
+                widths[face] = d.D
+            elif rule == "circumference":
+                widths[face] = math.pi * d.D if d.D > 0 else d.H
+            else:
+                widths[face] = 0.0
+        return widths
+
+    @property
+    def length(self) -> float:
+        return self.dimensions.length
+
+    def get_face_width(self, face: Face) -> float:
+        return self.base_widths.get(face, 0.0)
+
+    def has_face(self, face: Face) -> bool:
+        return face in self.faces
+
+
+def create_profile_model(
+    kind_code: str,
+    header_dims: List[float],
+) -> ProfileGeometryModel:
+    """Factory: كاياخد kind_code + dims، كايرجع Model."""
+    if not ProfileKind.is_valid(kind_code):
+        raise InvalidProfileKindError(kind_code)
+    kind = ProfileKind(kind_code.upper())
+    dims = ProfileDimensions.from_header(kind, header_dims)
+    return ProfileGeometryModel(kind=kind, dimensions=dims)
diff --git a/src/nccorrection/engine/contour/nc1_writer_advanced.py b/src/nccorrection/engine/contour/nc1_writer_advanced.py
