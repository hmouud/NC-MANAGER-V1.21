+"""HoleEditService unit tests (P2 monolith split).
+
+Covers the pure override-conversion + application logic extracted from
+app.py's hole editor with REAL UPN200 dimensions (the same fixture values
+parse_geometry produces for the ST block used by the app's own hole flow).
+"""
+import unittest
+
+from nccorrection.services.hole_edit_service import HoleEditService as S
+
+# Real UPN200 ST block (same text the app's part_dims path parses).
+UPN200_ST = ("ST\n** 1-1.nc1\n  CHRGUI ESCALIE BATIMAN-A\n  17\n  1-1\n  1-1\n"
+             "  S235JR\n  1\n  UPN200\n  U\n     645.79\n     200.00\n"
+             "      75.00\n      11.50\n       8.50\n      11.50\n"
+             "     25.200\n      0.660\n     20.486\n      0.000\n")
+UPN200_DIMS = [645.79, 200.0, 75.0, 11.5, 8.5, 11.5, 25.2, 0.66, 20.486, 0.0]
+
+
+class TestNormalizeOverride(unittest.TestCase):
+    def test_none_returns_empty(self):
+        self.assertEqual(S.normalize_override(None), {})
+
+    def test_scalar_becomes_d(self):
+        self.assertEqual(S.normalize_override(18.0), {'d': 18.0})
+
+    def test_tuple_maps_d_length_angle(self):
+        self.assertEqual(S.normalize_override((18.0, 60.0, 90.0)),
+                         {'d': 18.0, 'length': 60.0, 'angle': 90.0})
+
+    def test_short_tuple_length_none(self):
+        self.assertEqual(S.normalize_override((18.0,)),
+                         {'d': 18.0, 'length': None, 'angle': None})
+
+    def test_dict_drops_none_values(self):
+        self.assertEqual(S.normalize_override({'d': 18.0, 'x': None,
+                                               'sym': True}),
+                         {'d': 18.0, 'sym': True})
+
+
+class TestCurrentValues(unittest.TestCase):
+    BASE = {'kind': 'hole', 'd': 18.0, 'x': 10.0, 'y': 20.0,
+            'face': 'v', 'length': None, 'angle': None, 'sym': False,
+            'top': False}
+
+    def test_override_wins_and_base_fills(self):
+        cur = S.current_values({'d': 22.0}, self.BASE)
+        self.assertEqual(cur['d'], 22.0)
+        self.assertEqual(cur['x'], 10.0)   # base
+        self.assertEqual(cur['y'], 20.0)   # base
+        self.assertEqual(cur['face'], 'v')
+        self.assertEqual(cur['ymode'], 'abs')
+
+    def test_sym_derives_ymode(self):
+        cur = S.current_values({'ymode': 'sym'}, self.BASE)
+        self.assertEqual(cur['ymode'], 'sym')
+        # Faithful to the pre-split app: a legacy 'ymode' string drives the
+        # Y display but does NOT set the sym checkbox flag (checkbox only
+        # reads the boolean keys).
+        self.assertFalse(cur['sym'])
+
+    def test_top_legacy_boolean(self):
+        cur = S.current_values({'top': True}, self.BASE)
+        self.assertEqual(cur['ymode'], 'top')
+        self.assertTrue(cur['top'])
+        self.assertFalse(cur['sym'])
+
+
+class TestPartDims(unittest.TestCase):
+    def test_real_upn200_dims(self):
+        dims = S.part_dims(UPN200_ST)
+        self.assertEqual(dims, UPN200_DIMS)
+        self.assertEqual(dims[0], 645.79)
+
+    def test_unparseable_returns_empty(self):
+        self.assertEqual(S.part_dims('not an nc1 file at all'), [])
+
+
+class TestBuildOverride(unittest.TestCase):
+    def test_abs_mode_keeps_y(self):
+        o = S.build_override('U', UPN200_DIMS, 'v', 'abs', 10.0, 18.0, 5.0,
+                             False, 0.0, 0)
+        self.assertEqual(o['y'], 10.0)
+        self.assertEqual(o['d'], 18.0)
+        self.assertEqual(o['x'], 5.0)
+        self.assertEqual(o['face'], 'v')
+        self.assertNotIn('kind', o)
+
+    def test_sym_mode_converts_to_absolute(self):
+        # face height 200 -> centre 100; sym offset 10 -> absolute 110
+        o = S.build_override('U', UPN200_DIMS, 'v', 'sym', 10.0, 18.0, 5.0,
+                             False, 0.0, 0, sym=True)
+        self.assertEqual(o['y'], 110.0)
+        self.assertTrue(o['sym'])
+        self.assertEqual(o['ymode'], 'sym')
+
+    def test_top_mode_converts_to_absolute(self):
+        # top offset 10 -> 200 - 10
+        o = S.build_override('U', UPN200_DIMS, 'v', 'top', 10.0, 18.0, 5.0,
+                             False, 0.0, 0, top=True)
+        self.assertEqual(o['y'], 190.0)
+
+    def test_slot_y_axis_swaps_d_and_length(self):
+        # Width field 8, Length field 60, Y axis -> d=60, length=8, angle 90
+        o = S.build_override('U', UPN200_DIMS, 'v', 'abs', 10.0, 8.0, 5.0,
+                             True, 60.0, 1)
+        self.assertEqual(o['d'], 60.0)
+        self.assertEqual(o['length'], 8.0)
+        self.assertEqual(o['angle'], 90.0)
+        self.assertEqual(o['kind'], 'slot')
+
+    def test_slot_x_axis_keeps_width_and_zero_angle(self):
+        o = S.build_override('U', UPN200_DIMS, 'v', 'abs', 10.0, 8.0, 5.0,
+                             True, 60.0, 0)
+        self.assertEqual(o['d'], 8.0)
+        self.assertEqual(o['length'], 60.0)
+        self.assertEqual(o['angle'], 0.0)
+        self.assertEqual(o['kind'], 'slot')
+
+
+class TestApplyHoleOverride(unittest.TestCase):
+    def test_positive_index_replaces_and_preserves_others(self):
+        store = {'h1': {0: {'d': 18.0}}}
+        added = {}
+        ok = S.apply_hole_override('h1', 1, {'d': 22.0}, store, added)
+        self.assertTrue(ok)
+        self.assertEqual(store['h1'][0], {'d': 18.0})
+        self.assertEqual(store['h1'][1], {'d': 22.0})
+        self.assertEqual(added, {})
+        # original store object must NOT be mutated in place
+        self.assertEqual(store['h1'].get(2), None)
+
+    def test_negative_index_merges_into_added(self):
+        store = {}
+        added = {'h1': [{'d': 18.0, 'kind': 'hole'}]}
+        ok = S.apply_hole_override('h1', -1, {'d': 22.0, 'sym': True},
+                                   store, added)
+        self.assertTrue(ok)
+        self.assertEqual(added['h1'][0]['d'], 22.0)
+        self.assertTrue(added['h1'][0]['sym'])
+        self.assertEqual(added['h1'][0]['kind'], 'hole')
+
+    def test_out_of_range_negative_returns_false_no_write(self):
+        store = {}
+        added = {'h1': [{'d': 18.0}]}
+        ok = S.apply_hole_override('h1', -5, {'d': 22.0}, store, added)
+        self.assertFalse(ok)
+        self.assertEqual(added['h1'], [{'d': 18.0}])
+
+
+if __name__ == '__main__':
+    unittest.main()
