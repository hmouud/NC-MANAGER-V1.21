+        dims = [4500, 524, 306, 40, 21, 27, 270, 2.18, 38.621, 41.05, 0, 0]
+        m = ProfileGeometryModel.from_header(dims, 'I', 'HEM500')
+        results = compute_cut_offsets(m)
+
+        v = results['v']
+        expected_right = 4500.0 - 524.0 * math.tan(math.radians(41.05))
