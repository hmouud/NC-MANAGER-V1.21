+"""exceptions.py — Custom exceptions for the Contour Engine.
+
+هادشي كايسمح بالـ error handling الدقيق. ماشي كلشي Exception عام.
+"""
+from __future__ import annotations
+
+
+class ContourError(Exception):
+    """الأساس ديال كل الأخطاء ديال Contour Engine."""
+    pass
+
+
+class InvalidProfileKindError(ContourError):
+    """كود بروفيل غير مدعوم."""
+    def __init__(self, kind_code: str):
+        self.kind_code = kind_code
+        super().__init__(f"Unsupported profile kind: '{kind_code}'")
+
+
+class InvalidDimensionsError(ContourError):
+    """أبعاد غير صالحة (سلبية، صفر، ...)."""
+    def __init__(self, field: str, value: float):
+        self.field = field
+        self.value = value
+        super().__init__(f"Invalid dimension '{field}': {value}")
+
+
+class InvalidCutAngleError(ContourError):
+    """زاوية قطع خارج النطاق المسموح (-180..180)."""
+    def __init__(self, angle: float):
+        self.angle = angle
+        super().__init__(f"Cut angle out of range: {angle}deg")
