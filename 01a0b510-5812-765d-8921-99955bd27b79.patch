+class ConcaveRightTriangleShape(PlateShape):
+    """Right triangle with concave hypotenuse (inward arc)."""
+    name = "Concave Right Triangle"
+    category = "Triangular"
+    parameters = [
+        ShapeParam("Height", "height", 200.0, 5.0, 10000.0),
+        ShapeParam("Base", "base", 150.0, 5.0, 10000.0),
+        ShapeParam("Concavity", "concavity", 30.0, 0.0, 5000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h = p["base"], p["height"]
+        conc = min(p["concavity"], w / 2, h / 2)
+        # Two straight edges + concave arc on hypotenuse
+        straight = [(0, 0), (w, 0)]
+        # Arc from (w, 0) to (0, h) curving inward
+        n = 20
+        arc_pts = []
+        for i in range(n + 1):
+            t = i / n
+            x = w * (1 - t)
+            y = h * t
+            # Perpendicular offset inward
+            dx, dy = -h, w
+            ln = math.sqrt(dx * dx + dy * dy)
+            nx, ny = -dy / ln, dx / ln  # inward normal
+            offset = conc * math.sin(math.pi * t)
+            arc_pts.append((x + nx * offset, y + ny * offset))
+        return ShapeResult(outer=straight + arc_pts)
