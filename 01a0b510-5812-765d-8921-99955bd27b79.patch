+"""File management mixin for NCManagerApp.
+
+Extracted from app.py: table rendering, cell value computation, Excel-style
+column filters, inline-edit delegates (Qty / TextEdit / ReadOnly), dirty
+tracking, file rename, and note saving.
+
+Every method references ``self.`` attributes that live on
+:class:`NCManagerApp` — this mixin is **not** usable standalone.
+"""
+
+import os
+import time
+from datetime import datetime
+
+from PySide6.QtWidgets import (
+    QHeaderView,
+    QLineEdit,
+    QSpinBox,
+    QStyledItemDelegate,
+    QTableWidget,
+    QTableWidgetItem,
+)
+from PySide6.QtCore import Qt
+from PySide6.QtGui import QColor, QBrush
+
+from nccorrection.ui.styles import shade
+from nccorrection.ui.components.custom_header import ExcelFilterHeader
+
+
+# ------------------------------------------------------------------ delegates
+class QtyDelegate(QStyledItemDelegate):
+    """Spin-box editor installed only on the qty column; double-click to edit."""
+
+    def __init__(self, app, parent=None):
+        super().__init__(parent)
+        self._app = app
+
+    def createEditor(self, parent, option, index):
+        f = self._app._file_for_index(index)
+        if not f:
+            return None
+        sp = QSpinBox(parent)
+        sp.setMinimum(1)
+        sp.setMaximum(99999)
+        sp.setValue(int(self._app._qty_of(f)))
+        sp.editingFinished.connect(lambda: self._commit(sp, index))
+        return sp
+
+    def setEditorData(self, editor, index):
+        f = self._app._file_for_index(index)
+        if f and editor:
+            editor.setValue(int(self._app._qty_of(f)))
+
+    def setModelData(self, editor, model, index):
+        f = self._app._file_for_index(index)
+        if f and editor and editor.value() != self._app._qty_of(f):
+            self._app._push_undo()
+            f['qty_override'] = editor.value()
+            self._app._mark_dirty(f)
+            self._app._update_details()
+            self._app.audit.log(f'Quantity set to {editor.value()} for {f["name"]}', 'ok', 'OK-110')
+
+    def _commit(self, editor, index):
+        editor.clearFocus()
+
+
+class TextEditDelegate(QStyledItemDelegate):
+    """Line-edit editor for name/quality columns; double-click to edit."""
+
+    def __init__(self, app, key, parent=None):
+        super().__init__(parent)
+        self._app = app
+        self._key = key
+
+    def createEditor(self, parent, option, index):
+        if not self._app._file_for_index(index):
+            return None
+        e = QLineEdit(parent)
+        e.setFrame(False)
+        return e
+
+    def setEditorData(self, editor, index):
+        f = self._app._file_for_index(index)
+        if f and editor:
+            editor.setText(self._app._cell_value(f, self._key))
+
+    def setModelData(self, editor, model, index):
+        f = self._app._file_for_index(index)
+        if f and editor:
+            new = editor.text().strip()
+            old = self._app._cell_value(f, self._key)
+            if new and new != old:
+                self._app._commit_text_edit(f, self._key, new)
+
+
+class ReadOnlyDelegate(QStyledItemDelegate):
+    def createEditor(self, parent, option, index):
+        return None
+
+
+# -------------------------------------------------------------------- mixin
+class FileManagementMixin:
+    """Table rendering, cell values, Excel-style filters, inline-edit
+    delegates, dirty tracking, file rename, and note saving."""
+
+    # ---------------------------------------------------------------- render
+    def _cat_key(self, label):
+        for key, trans in [('BEAM', self.tr_('beam')), ('PLATE', self.tr_('plate')),
+                           ('LPROFILE', self.tr_('lprofile')), ('ZPROFILE', self.tr_('zprofile')),
+                           ('TUBE', self.tr_('tube')), ('UNKNOWN', self.tr_('unknown'))]:
+            if label == trans:
+                return key
+        return label
+
+    def _filtered_rows(self):
+        q = (self.search_bar.text() or '').strip().lower()
+        order = self.project_combo.currentText() if hasattr(self, 'project_combo') else self.tr_('filter_all')
+
+        # Get header filters from ExcelFilterHeader
+        header_view = self.table.horizontalHeader()
+        header_filters = header_view.get_filters() if hasattr(header_view, 'get_filters') else {}
+
+        rows = []
+        for i, f in enumerate(self.files):
+            if order != self.tr_('filter_all') and f.get('order', '') != order:
+                continue
+            if q:
+                hay = ' '.join([f['name'], f['path'], f['profile'], f['folder'],
+                                f['category'], f['family'], str(f['qty'])]).lower()
+                if q not in hay:
+                    continue
+
+            # Apply header filters (Excel-style column filters)
+            if header_filters:
+                visible = self._visible_keys()
+                match = True
+                for col_idx, allowed_vals in header_filters.items():
+                    if not allowed_vals:
+                        continue
+                    if col_idx < len(visible):
+                        col_key = visible[col_idx]
+                        file_val = self._cell_value(f, col_key)
+                        if file_val not in allowed_vals:
+                            match = False
+                            break
+                if not match:
+                    continue
+
+            rows.append(i)
+        return rows
+
+    def _qty_of(self, f):
+        return f['qty_override'] if f['qty_override'] is not None else f['qty']
+
+    def _cat_label(self, category):
+        return {'BEAM': self.tr_('beam'), 'PLATE': self.tr_('plate'),
+                'LPROFILE': self.tr_('lprofile'), 'ZPROFILE': self.tr_('zprofile'),
+                'TUBE': self.tr_('tube'), 'UNKNOWN': self.tr_('unknown')}.get(category, category)
+
+    @staticmethod
+    def _fmt_time(ts):
+        try:
+            return datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M')
+        except (OSError, ValueError):
+            return ''
+
+    def _visible_keys(self):
+        return [k for k, _, _ in self.COLUMNS if self.settings.get_column_visible(k)]
+
+    def _render_table(self):
+        visible = self._visible_keys()
+        if not visible:
+            visible = ['name']
+        # Don't use clear() - it destroys the horizontal header.
+        # Instead, reset row count and rebuild items.
+        self.table.setRowCount(0)
+        self.table.setColumnCount(len(visible))
+        header_labels = [self.tr_(k) if k != 'cat' else self.tr_('cat_title')
+                         for k in visible]
+        self.table.setHorizontalHeaderLabels(header_labels)
+
+        # Preserve active filters if any
+        old_filters = {}
+        if hasattr(self, 'filter_header') and hasattr(self.filter_header, 'get_filters'):
+            old_filters = self.filter_header.get_filters()
+
+        # Install ExcelFilterHeader with dropdown filters
+        self.filter_header = ExcelFilterHeader(self.table)
+        self.table.setHorizontalHeader(self.filter_header)
+        # Re-apply header labels to the new header
+        for c, label in enumerate(header_labels):
+            hdr_item = self.table.horizontalHeaderItem(c)
+            if hdr_item is None:
+                hdr_item = QTableWidgetItem(label)
+                self.table.setHorizontalHeaderItem(c, hdr_item)
+            else:
+                hdr_item.setText(label)
+            hdr_item.setData(Qt.UserRole, visible[c])
+
+        # Populate unique values for each visible column from loaded files
+        col_unique = {c: set() for c in range(len(visible))}
+        for f in self.files:
+            for c, key in enumerate(visible):
+                val = self._cell_value(f, key)
+                if val is not None and val != '':
+                    col_unique[c].add(val)
+        for c, vals in col_unique.items():
+            self.filter_header.update_filter_data(c, sorted(list(vals)))
+            if c in old_filters and old_filters[c]:
+                self.filter_header._active_filters[c]['selected'] = old_filters[c]
+
+        # Connect filter changed signal to apply filters
+        self.filter_header.filter_changed.connect(self._apply_excel_filters)
+
+        # Ensure header stays visible
+        self.table.horizontalHeader().setVisible(True)
+
+        rows = self._filtered_rows()
+        self.table.setRowCount(len(rows))
+        for r, i in enumerate(rows):
+            f = self.files[i]
+            dirty = self._file_dirty(f)
+            for c, key in enumerate(visible):
+                item = QTableWidgetItem(self._cell_value(f, key))
+                item.setData(Qt.UserRole, i)
+                item.setTextAlignment(Qt.AlignLeft | Qt.AlignVCenter)
+                if i in self.selected:
+                    item.setBackground(QColor(self._theme['select']))
+                elif f.get('hash', '') in self._session_edited:
+                    item.setBackground(QColor(self._dirty_bg()))
+                if key == 'qty':
+                    item.setTextAlignment(Qt.AlignCenter)
+                if key in self.EDITABLE_COLUMNS:
+                    item.setToolTip(self.tr_(self.EDITABLE_COLUMNS[key]))
+                if key == 'modified' and dirty:
+                    item.setForeground(QColor(self._theme['grn']))
+                    item.setToolTip(self.tr_('modified_dirty'))
+                if key == 'st' and dirty:
+                    item.setToolTip(self.tr_('modified_dirty'))
+                    item.setTextAlignment(Qt.AlignCenter)
+                self.table.setItem(r, c, item)
+        self.table.setSelectionMode(QTableWidget.ExtendedSelection)
+        self._install_editable_delegates(visible)
+        self._autofit_columns(visible)
+
+    def _apply_excel_filters(self, col_index=None, selected_values=None):
+        """Apply filters from the Excel-style filter header.
+
+        Called when the user changes filter selections in the header dropdown.
+        If col_index and selected_values are provided (from signal), apply them.
+        Otherwise, rebuild filters from the header's current state.
+        """
+        header_view = self.table.horizontalHeader()
+        if hasattr(header_view, 'get_filters'):
+            header_filters = header_view.get_filters()
+        else:
+            header_filters = {}
+
+        # Re-run the filtered rows logic with current header filters
+        self._render_table()
+
+    def _cell_value(self, f, key):
+        m = {
+            'st': '\u270e' if self._file_dirty(f) else '',
+            'name': os.path.splitext(f['name'])[0],
+            'cat': self._cat_label(f['category']),
+            'fam': f['family'],
+            'profile': f['profile'],
+            'folder': f['folder'],
+            'qty': str(self._qty_of(f)),
+            'steel': f.get('steel', ''),
+            'quality': f.get('quality', ''),
+            'order': f.get('order', ''),
+            'length_mm': str(f.get('length_mm', '')),
+            'weight': f'{f.get("weight", 0):.2f}',
+            'o': 'o' if f['o'] else '',
+            'si': 'SI/EN' if f['si'] else '',
+            'size': f"{round(f['size'] / 1024)} KB" if f['size'] else '',
+            'modified': self._modified_value(f),
+            'hash': f['hash'][:10] + '\u2026' if f['hash'] else '',
+            'target': f['folder'],
+            'warning': '',
+            'notes': self.settings.get_note(f['hash'])[:40] if self.settings.get_note(f['hash']) else '',
+        }
+        return m.get(key, '')
+
+    def _modified_value(self, f):
+        ts = f.get('dirty_at') if f.get('dirty') else f.get('modified')
+        text = self._fmt_time(ts) if ts else ''
+        return ('\u2022 ' + text) if f.get('dirty') else text
+
+    def _autofit_columns(self, visible):
+        header = self.table.horizontalHeader()
+        header.setSectionResizeMode(QHeaderView.ResizeToContents)
+        header.setMinimumSectionSize(48)
+        header.setMaximumSectionSize(300)
+        header.setStretchLastSection(False)
+        for c, key in enumerate(visible):
+            if key == 'name':
+                header.setSectionResizeMode(c, QHeaderView.Stretch)
+
+    # ---------------------------------------------------------------- inline edit
+    def _install_editable_delegates(self, visible):
+        cols = {}
+        for c, key in enumerate(visible):
+            if key in self.EDITABLE_COLUMNS:
+                cols[key] = c
+        for c in range(len(visible)):
+            self.table.setItemDelegateForColumn(c, ReadOnlyDelegate(self))
+        if 'qty' in cols:
+            self.table.setItemDelegateForColumn(cols['qty'], QtyDelegate(self))
+        if 'name' in cols:
+            self.table.setItemDelegateForColumn(cols['name'], TextEditDelegate(self, 'name'))
+        if 'quality' in cols:
+            self.table.setItemDelegateForColumn(cols['quality'], TextEditDelegate(self, 'quality'))
+        self.table.setEditTriggers(QTableWidget.DoubleClicked |
+                                   QTableWidget.SelectedClicked)
+
+    def _commit_text_edit(self, f, key, new):
+        if key == 'name':
+            self._rename_file(f, new)
+        elif key == 'quality':
+            self._push_undo()
+            f['quality'] = new
+            self._mark_dirty(f)
+            self.audit.log(f'Quality set for {f["name"]}', 'ok', 'OK-110')
+
+    def _dirty_bg(self):
+        """Light tint for rows touched this session (theme-aware)."""
+        return shade(self._theme.get('panel', '#1e293b'), 1.10)
+
+    def _file_dirty(self, f):
+        """True when a file carries uncommitted modifications (persistent
+        across sessions: hole/slot overrides survive in the manifest)."""
+        h = f.get('hash', '')
+        return bool(f.get('dirty')
+                    or self.hole_overrides.get(h)
+                    or self.hole_deleted.get(h)
+                    or self.added_holes.get(h))
+
+    def _mark_dirty(self, f, refresh=True):
+        f['dirty'] = True
+        f['dirty_at'] = time.time()
+        self._session_edited.add(f.get('hash', ''))
+        if refresh:
+            self._refresh_table_row(f)
+
+    def _refresh_table_row(self, f):
+        """Refresh the cells of one row in place (no selection/current-file reset)."""
+        try:
+            idx = self.files.index(f)
+        except ValueError:
+            return
+        visible = self._visible_keys()
+        dirty = self._file_dirty(f)
+        for r in range(self.table.rowCount()):
+            it = self.table.item(r, 0)
+            if it is None or it.data(Qt.UserRole) != idx:
+                continue
+            for c, key in enumerate(visible):
+                cell = self.table.item(r, c)
+                if not cell:
+                    continue
+                cell.setText(self._cell_value(f, key))
+                if idx in self.selected:
+                    cell.setBackground(QColor(self._theme['select']))
+                elif f.get('hash', '') in self._session_edited:
+                    cell.setBackground(QColor(self._dirty_bg()))
+                else:
+                    cell.setBackground(QBrush())
+                if key == 'modified' and dirty:
+                    cell.setForeground(QColor(self._theme['green']))
+                elif key in self.EDITABLE_COLUMNS:
+                    cell.setToolTip(self.tr_(self.EDITABLE_COLUMNS[key]))
+            break
+
+    def _rename_file(self, f, new_name):
+        old_name = f['name']
+        old_path = f.get('path') or ''
+        ext = os.path.splitext(old_name)[1]
+        if ext and not new_name.lower().endswith(ext.lower()):
+            new_name = new_name + ext
+        if os.path.isfile(old_path):
+            new_path = os.path.join(os.path.dirname(os.path.abspath(old_path)), new_name)
+            try:
+                os.rename(old_path, new_path)
+                f['path'] = new_path
+            except OSError as exc:
+                self._set_status(f'{self.tr_("rename_fail")}: {exc}')
+                return
+        f['name'] = new_name
+        self._mark_dirty(f)
+        self._update_details()
+        self.audit.log(f'Renamed {old_name} -> {new_name}', 'ok', 'OK-113')
+
+    def _file_for_index(self, index):
+        item = self.table.item(index.row(), 0)
+        if not item:
+            return None
+        idx = item.data(Qt.UserRole)
+        if 0 <= idx < len(self.files):
+            return self.files[idx]
+        return None
+
+    def _save_note(self):
+        if not getattr(self, '_current_file', None):
+            return
+        self.settings.set_note(self._current_file['hash'], self.notes.toPlainText())
+        self._mark_dirty(self._current_file, refresh=False)
