+    def test_3d_live_hover_glyph_draws_before_first_point(self):
+        """The OSNAP marker is rendered live from hover only, with no _m1 yet
+        (2D/blueprint parity)."""
+        w = self._widget()
+        w.set_mode('measure')
+        w._measure_pt = (3000.0, 0.0, 150.0)
+        w._hover_kind = 'endpoint'
+        self.assertIsNone(w._m1)
+        w.grab()  # renders _draw_measure with only the hover glyph
+        # a one-shot painter path through _snap_badge with a tuple pos
+        from PySide6.QtGui import QImage, QPainter, QColor
+        img = QImage(400, 300, QImage.Format_ARGB32)
+        img.fill(0)
+        p = QPainter(img)
+        w._snap_badge(p, (200, 150), 'centre')
+        p.end()
+        self.assertFalse(img.isNull())
+
+    def test_3d_dim_scale_parity_with_2d(self):
+        """3D measure labels obey the same dimension_scale as blueprint."""
+        from nccorrection.design.settings import DesignSettings
+        w = self._widget()
+        w.set_design_settings(DesignSettings())
+        w._design.set_dimension_scale(1.0)
+        r1, _ = w._3d_label_rect((0, 0, 0), (3000, 0, 150))
+        w._design.set_dimension_scale(1.5)
+        r2, _ = w._3d_label_rect((0, 0, 0), (3000, 0, 150))
+        self.assertAlmostEqual(r1.height(), 20.0, delta=0.5)
+        self.assertAlmostEqual(r2.height(), 30.0, delta=1.0)
+
+    def test_classic_2d_reuses_shared_glyphs(self):
+        """qt_viewer (classic 2D) draws its hover marker through the shared
+        CAD glyph renderer, accepting a plain (x, y) tuple."""
+        from nccorrection.ui.qt_viewer import NcViewer
+        from nccorrection.design.glyphs import draw_snap_glyph
+        from PySide6.QtGui import QImage, QPainter
+        v = NcViewer()
+        v.resize(800, 600)
+        v.set_geometry_object(BEAM)
+        v.mode = 'measure'
+        self.assertIsNone(getattr(v, '_hover_kind', None))
+        v._hover_kind = 'endpoint'
+        v._hover_pt = type('P', (), {'x': lambda s: 100.0, 'y': lambda s: 50.0})()
+        img = QImage(400, 300, QImage.Format_ARGB32)
+        img.fill(0)
+        p = QPainter(img)
+        v._snap_badge(p, (200, 150), 'midpoint')  # tuple -> shared glyph
+        p.end()
+        self.assertFalse(img.isNull())
+        self.assertEqual(v._mp['badges']['centre'], '#f472b6')
+
+    def test_renderer_3d_adapter_shares_core(self):
+        """DstvRenderer3D feeds raw NC1 text into the shared NcViewer3D core
+        and inherits the target-based orbit / pivot behaviour."""
+        from nccorrection.engine.parser.dstv_parser import DstvParser
+        from nccorrection.engine.render_3d.renderer_3d import DstvRenderer3D
+        import tests.test_part3d as tp
+        part = DstvParser().parse_text(tp.BEAM_TEXT)
+        self.assertTrue(part.raw_lines)
+        w = DstvRenderer3D()
+        w.resize(800, 500)
+        w.set_part(part)
+        w.grab()
+        self.assertTrue(w.has_geometry())
+        self.assertIsNone(w._pivot)
+        w.mousePressEvent(_press(400, 250))
+        self.assertIsNone(w._pivot)   # a click never re-anchors the pivot
+        w.mouseMoveEvent(_move(430, 270))
+        w.mouseReleaseEvent(_release(430, 270))
+        w.grab()
+        sx, sy = w._project(w._origin())
+        self.assertAlmostEqual(sx, w._ox + w._pan_ox, delta=1.0)
+        self.assertAlmostEqual(sy, w._oy + w._pan_oy, delta=1.0)
+        w.clear()
+        self.assertFalse(w.has_geometry())
+
+
+class TestForeshortenMeasure(unittest.TestCase):
+    """The measure transform must push raw screen X through map_screen_to_real()
+    so a distance across a hidden cut void reports the true DSTV length."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        from nccorrection.engine.math.foreshorten import build_foreshorten
+        self.w = NcViewer()
+        self.w.resize(900, 640)
+        self.m = build_foreshorten(12000.0, [(0, 1000), (11500, 12000)])
+        self.w.set_foreshorten(self.m)
+
+    def test_transform_round_trip_exact_inverse(self):
+        for x in (0.0, 200.0, 1000.0, 6000.0, 11900.0):
+            sx, sy = self.w._to_screen(x, 50.0)
+            rx, ry = self.w._to_scene(sx, sy)
+            self.assertAlmostEqual(rx, x, delta=1e-6)
+            self.assertAlmostEqual(ry, 50.0, delta=1e-6)
+
+    def test_measure_across_hidden_void_true_distance(self):
+        a = self.w._to_screen(200.0, 10.0)
+        b = self.w._to_screen(11800.0, 10.0)
+        span = math.hypot(b[0] - a[0], b[1] - a[1])
+        self.assertLess(span, 3000.0)               # compressed on screen
+        ra = self.w._to_scene(*a)
+        rb = self.w._to_scene(*b)
+        d = math.hypot(rb[0] - ra[0], rb[1] - ra[1])
+        self.assertAlmostEqual(d, 11600.0, delta=1e-6)   # true physical
+
+    def test_disable_restores_identity(self):
+        self.w.set_foreshorten(None)
+        sx, _ = self.w._to_screen(11900.0, 0.0)
+        self.assertEqual(sx, 11900.0)
+
+
+class Test3DInertia(unittest.TestCase):
+    """Orbit fling (Option A): after a rotate-drag release the view keeps
+    rotating with an exponential decay (OrbitControls feel). A new press,
+    preset switch or geometry change cancels the fling; tiny drags stay put;
+    measure-mode clicks never fling."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        from nccorrection.ui.qt_viewer_3d import NcViewer3D
+        self.w = NcViewer3D()
+        self.w.resize(800, 500)
+        self.w.set_geometry_object(BEAM)
+
+    def test_fling_starts_inertia_timer(self):
+        self.w.mousePressEvent(_press(400, 250))
+        self.w.mouseMoveEvent(_move(430, 270))
+        self.w.mouseReleaseEvent(_release(430, 270))
+        self.assertIsNotNone(self.w._inertia_axis)
+        self.assertGreater(self.w._inertia_angle, 0.0)
+        self.assertIsNotNone(self.w._inertia_timer)
+
+    def test_small_drag_does_not_fling(self):
+        # ~1 px arcball step (~0.004 rad) is below INERTIA_START: no motion
+        self.w.mousePressEvent(_press(400, 250))
+        self.w.mouseMoveEvent(_move(400, 251))
+        self.w.mouseReleaseEvent(_release(400, 251))
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+
+    def test_release_without_drag_no_inertia(self):
+        self.w.mousePressEvent(_press(400, 250))
+        self.w.mouseReleaseEvent(_release(400, 250))
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+
+    def test_measure_clicks_do_not_fling(self):
+        self.w.set_mode('measure')
+        self.w.mousePressEvent(_press(400, 250))
+        self.w.mouseMoveEvent(_move(430, 270))
+        self.w.mouseReleaseEvent(_release(430, 270))
+        self.assertIsNone(self.w._inertia_timer)
+
+    def test_inertia_step_decays_and_stops(self):
+        self.w._inertia_axis = (0.0, 1.0, 0.0)
+        self.w._inertia_angle = 0.05
+        r0 = self.w._R
+        self.w._inertia_step()
+        self.assertNotEqual(self.w._R, r0)
+        self.assertAlmostEqual(self.w._inertia_angle,
+                               0.05 * self.w.INERTIA_DECAY, places=6)
+        # once decayed below the stop threshold the next tick halts entirely
+        self.w._inertia_angle = self.w.INERTIA_STOP / 2.0
+        self.w._inertia_step()
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+
+    def test_start_inertia_threshold(self):
+        # below the start threshold: reset, no timer
+        self.w._inertia_axis = (0.0, 1.0, 0.0)
+        self.w._inertia_angle = self.w.INERTIA_START / 2.0
+        self.w._start_inertia()
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+        # at/above the threshold: timer runs and decays per tick
+        self.w._inertia_axis = (0.0, 1.0, 0.0)
+        self.w._inertia_angle = 0.05
+        self.w._start_inertia()
+        self.assertIsNotNone(self.w._inertia_timer)
+        self.w._inertia_step()
+        self.assertAlmostEqual(self.w._inertia_angle,
+                               0.05 * self.w.INERTIA_DECAY, places=6)
+
+    def test_fling_step_capped(self):
+        # a ~90 degree arcball step is clamped so a violent flick cannot send
+        # the part into an uncontrolled spin
+        self.w.mousePressEvent(_press(400, 250))
+        self.w.mouseMoveEvent(_move(400, 700))
+        self.assertLessEqual(self.w._inertia_angle, self.w.INERTIA_MAX)
+        self.w.mouseReleaseEvent(_release(400, 700))
+
+    def test_press_cancels_inertia(self):
+        self.w._inertia_axis = (0.0, 1.0, 0.0)
+        self.w._inertia_angle = 0.05
+        self.w._start_inertia()
+        self.assertIsNotNone(self.w._inertia_timer)
+        self.w.mousePressEvent(_press(400, 250))
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+
+    def test_set_preset_cancels_inertia(self):
+        self.w._inertia_axis = (0.0, 1.0, 0.0)
+        self.w._inertia_angle = 0.05
+        self.w._start_inertia()
+        self.w.set_preset('top')
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+
+    def test_clear_geometry_cancels_inertia(self):
+        self.w._inertia_axis = (0.0, 1.0, 0.0)
+        self.w._inertia_angle = 0.05
+        self.w._start_inertia()
+        self.w.clear_geometry()
+        self.assertIsNone(self.w._inertia_axis)
+        self.assertIsNone(self.w._inertia_timer)
+
+
