+import sys
+
+
+def main():
+    no_gui = '--no-gui' in sys.argv
+    if no_gui:
+        _smoke_test()
+    else:
+        _run_gui()
+
+
+def _smoke_test():
+    from nccorrection.services.settings_service import SettingsService
+    from nccorrection.services.resource_service import ResourceService
+    from nccorrection.core.classifier import classify_text, detect_o_plane, has_si_en, parse_quantity, detect_holes, compute_hash
+    from nccorrection.ui.translations import t
+    print('=== NC Manager V1.21 Smoke Test ===')
+    ss = SettingsService()
+    print(f'Settings loaded: {ss.get("language")}')
+    rs = ResourceService()
+    missing = rs.validate_icons()
+    print(f'Icon validation: {"PASS" if not missing else f"MISSING: {missing}"}')
+    result = classify_text('HEA200 steel beam', 'test.nc')
+    print(f'Classifier HEA200: {result["profile"]} (expected HEA200)')
+    result = classify_text('', 'PL15.nc')
+    print(f'Classifier PL15: {result["profile"]} (expected PL15)')
+    result = classify_text('', 'L40x4.nc')
+    print(f'Classifier L40: {result["profile"]} (expected L40)')
+    sample_qty = "ST\nS235JR\n5\nCO"
+    print(f'Quantity test: {parse_quantity(sample_qty)} (expected 5)')
+    text = 'BO\no 100 200 300\nu 400 500 600 700 800 900\nAK'
+    holes = detect_holes(text)
+    print(f'Holes round: {holes["round"]} long: {holes["long"]}')
+    sample_o = "\no 100 200"
+    print(f'O-plane detect: {detect_o_plane(sample_o)}')
+    sample_si = "\nSI\ncode\nEN"
+    print(f'SI/EN detect: {has_si_en(sample_si)}')
+    h = compute_hash(b'test content')
+    print(f'SHA256: {h[:16]}...')
+    print(f'Translation EN: {t("app_title", "en")}')
+    print(f'Translation FR: {t("app_title", "fr")}')
+    print('=== Smoke Test PASS ===')
+    return 0
+
+
+def _run_gui():
+    import os
+    os.environ.setdefault('QT_AUTO_SCREEN_SCALE_FACTOR', '1')
+    from PySide6.QtWidgets import QApplication
+    from nccorrection.ui.app import NCManagerApp
+    from nccorrection.ui.components.splash import ModernSplash
+    app = QApplication(sys.argv)
+    app.setApplicationName('NC Manager V1.21')
+    app.setApplicationDisplayName('NC Manager V1.21')
+    # SPRINT 3 (CTO 2026-09-02): Strict Bootloader Architecture. ModernSplash
+    # (ui/components/splash.py) is shown first, then passed into NCManagerApp.__init__
+    # which drives its sequential boot (update_status + processEvents between each
+    # grouped step) and calls finish() only once the UI is fully built.
+    splash = ModernSplash()
+    splash.show()
+    win = NCManagerApp(splash=splash)
+    win.show()
+    sys.exit(app.exec())
+
+
+if __name__ == '__main__':
+    sys.exit(main())
