@@ -0,0 +1,128 @@
+"""DSTV NC1 data model (part level)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+
+@dataclass
+class DstvVertex:
+    """One contour vertex: X, Y plus optional arc data.
+
+    The 3rd column of AK/IK lines is *ambiguous* in the wild:
+      * DSTV standard  → ``bulge = tan(θ/4)``  (always in [−1, +1])
+      * Some CAM tools → ``radius`` in mm      (can exceed 1.0)
+
+    Detection (open-source reference: ``tluijken/dstv`` + ``Baseflow/DSTV.Net``):
+    if ANY vertex in a contour has ``|value| > 1.0`` the contour uses the
+    radius convention; otherwise bulge.  The parser sets exactly one of
+    ``bulge`` or ``radius`` to non-zero; consumers check ``radius`` first.
+    """
+    x: float = 0.0
+    y: float = 0.0
+    bulge: float = 0.0      # DSTV standard: tan(theta/4)
+    radius: float = 0.0     # CAM convention: arc radius in mm
+    # optional numeric bevels found on real 7-column DSTV AK lines
+    alpha: float = 0.0
+    beta: float = 0.0
+    suffix: str = ''  # reference-edge suffix stripped from the coordinate
+
+
+@dataclass
+class DstvContour:
+    """A closed outer/inner contour belonging to one face."""
+    face: str = 'v'
+    vertices: List[DstvVertex] = field(default_factory=list)
+    kind: str = 'outer'  # 'outer' (AK) or 'inner' (IK)
+
+    @property
+    def points(self) -> List[Tuple[float, float]]:
+        return [(v.x, v.y) for v in self.vertices]
+
+    @property
+    def is_closed(self) -> bool:
+        if len(self.vertices) < 2:
+            return False
+        first = self.vertices[0]
+        last = self.vertices[-1]
+        return abs(first.x - last.x) < 1e-9 and abs(first.y - last.y) < 1e-9
+
+
+@dataclass
+class DstvHole:
+    """A hole (BO block): round, slotted or counterbore."""
+    face: str = 'v'
+    x: float = 0.0
+    y: float = 0.0
+    diameter: float = 0.0
+    is_slot: bool = False
+    slot_length: float = 0.0
+    slot_width: float = 0.0
+    angle: float = 0.0  # degrees, for slotted holes
+    counterbore: bool = False
+
+
+@dataclass
+class DstvBend:
+    """A bend line (KA block) on a plate part (press-brake fold).
+
+    KA = Kanten; each line carries the fold segment in the unrolled flat
+    pattern plus the fold angle in degrees.
+    """
+    x1: float = 0.0
+    y1: float = 0.0
+    x2: float = 0.0
+    y2: float = 0.0
+    angle: float = 0.0  # degrees
+    # Field 6 disambiguation (owner law 2026-09-12, updated): values > 1000
+    # are treated as bend RADIUS; smaller values as plate THICKNESS. In the
+    # 5-column KA dialect the field is OMITTED entirely and thickness is
+    # inherited from the ST header (None -> callers fall back to plate_t).
+    thickness: Optional[float] = None
+    radius: Optional[float] = None   # bend die radius (column 6 when > 1000)
+
+
+@dataclass
+class DstvMarking:
+    """A SI/PU/KO marking: text or a punch point on a face."""
+    face: str = 'v'
+    x: float = 0.0
+    y: float = 0.0
+    text: str = ''
+    kind: str = 'si'  # 'si', 'pu', 'ko'
+
+
+@dataclass
+class DstvHeader:
+    """Parsed ST block header."""
+    order_id: str = ''
+    drawing: str = ''
+    phase: str = ''
+    position_mark: str = ''
+    steel_grade: str = ''
+    quantity: int = 1
+    profile_type: str = 'B'
+    profile_name: str = ''
+    length: float = 0.0
+    profile_height: float = 0.0
+    flange_width: float = 0.0
+    flange_thickness: float = 0.0
+    web_thickness: float = 0.0
+    fillet_radius: float = 0.0
+    raw_dims: List[float] = field(default_factory=list)
+
+
+@dataclass
+class DstvPart:
+    """A complete parsed NC1 part."""
+    header: DstvHeader = field(default_factory=DstvHeader)
+    faces: dict = field(default_factory=dict)          # code -> DstvFace
+    contours: List[DstvContour] = field(default_factory=list)
+    holes: List[DstvHole] = field(default_factory=list)
+    bends: List[DstvBend] = field(default_factory=list)
+    markings: List[DstvMarking] = field(default_factory=list)
+    raw_lines: List[str] = field(default_factory=list)
+
+    def get_face(self, code: str) -> Optional['DstvFace']:
+        return self.faces.get(code)
