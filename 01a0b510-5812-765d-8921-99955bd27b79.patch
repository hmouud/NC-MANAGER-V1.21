+import sys, os, tempfile, shutil, unittest
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+from nccorrection.core.organizer import (
+    plan_sort, execute_plan, summarize_results, plan_summary, file_hash, folder_hash_set,
+    plan_conflicts, prune_empty_dirs,
+)
+
+
+def make_file(directory, name, content=b'x'):
+    path = os.path.join(directory, name)
+    with open(path, 'wb') as f:
+        f.write(content)
+    return path
+
+
+class TestOrganizer(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        self.src = os.path.join(self.tmp, 'src')
+        self.out = os.path.join(self.tmp, 'out')
+        os.makedirs(self.src)
+        os.makedirs(self.out)
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def test_l60_flat_folder(self):
+        f1 = make_file(self.src, 'a.nc')
+        f2 = make_file(self.src, 'b.nc')
+        files = [
+            {'path': f1, 'profile': 'L60', 'folder': 'L60', 'hash': 'h1'},
+            {'path': f2, 'profile': 'L60', 'folder': 'L60', 'hash': 'h2'},
+        ]
+        plan = plan_sort(files, self.out)
+        self.assertEqual([p['folder'] for p in plan], ['L60', 'L60'])
+        self.assertTrue(all(p['dest'].startswith(os.path.join(self.out, 'L60')) for p in plan))
+
+    def test_hea_profiles_separate_folders(self):
+        f1 = make_file(self.src, 'a.nc')
+        f2 = make_file(self.src, 'b.nc')
+        files = [
+            {'path': f1, 'profile': 'HEA160', 'folder': 'HEA160', 'hash': 'h1'},
+            {'path': f2, 'profile': 'HEA190', 'folder': 'HEA190', 'hash': 'h2'},
+        ]
+        plan = plan_sort(files, self.out)
+        folders = sorted(p['folder'] for p in plan)
+        self.assertEqual(folders, ['HEA160', 'HEA190'])
+
+    def test_unknown_goes_to_unknown(self):
+        f1 = make_file(self.src, 'a.bin')
+        files = [{'path': f1, 'profile': 'UNKNOWN', 'folder': 'UNKNOWN', 'hash': 'h1'}]
+        plan = plan_sort(files, self.out)
+        self.assertEqual(plan[0]['folder'], 'UNKNOWN')
+
+    def test_move_executes(self):
+        f1 = make_file(self.src, 'beam.nc', b'content-abc')
+        files = [{'path': f1, 'profile': 'HEA200', 'folder': 'HEA200', 'hash': 'h1'}]
+        plan = plan_sort(files, self.out)
+        results = execute_plan(plan)
+        self.assertTrue(results[0]['ok'])
+        self.assertTrue(os.path.exists(os.path.join(self.out, 'HEA200', 'beam.nc')))
+        self.assertFalse(os.path.exists(f1))
+
+    def test_copy_executes(self):
+        f1 = make_file(self.src, 'plate.nc', b'content-xyz')
+        files = [{'path': f1, 'profile': 'PL15', 'folder': 'PL15', 'hash': 'h1'}]
+        plan = plan_sort(files, self.out, delete_original=False)
+        results = execute_plan(plan)
+        self.assertTrue(results[0]['ok'])
+        self.assertTrue(os.path.exists(os.path.join(self.out, 'PL15', 'plate.nc')))
+        self.assertTrue(os.path.exists(f1))
+
+    def test_name_collision_gets_suffix(self):
+        f1 = make_file(self.src, 'part.nc', b'aaa')
+        f2 = make_file(self.src, 'other.nc', b'bbb')
+        files = [
+            {'path': f1, 'profile': 'L40', 'folder': 'L40', 'hash': 'h1'},
+            {'path': f2, 'profile': 'L40', 'folder': 'L40', 'hash': 'h2'},
+        ]
+        plan = plan_sort(files, self.out)
+        names = sorted(os.path.basename(p['dest']) for p in plan)
+        self.assertEqual(names, ['other.nc', 'part.nc'])
+
+    def test_summarize_results(self):
+        results = [
+            {'ok': True, 'folder': 'L60', 'action': 'MOVE'},
+            {'ok': True, 'folder': 'HEA160', 'action': 'COPY'},
+            {'ok': False, 'folder': 'UNKNOWN', 'action': 'MOVE'},
+            {'ok': True, 'folder': 'L60', 'action': 'SKIP_DUPLICATE'},
+        ]
+        text = summarize_results(results)
+        self.assertIn('2 file(s) sorted', text)
+        self.assertIn('1 skipped', text)
+        self.assertIn('1 failed', text)
+
+    def test_duplicate_content_skipped(self):
+        content = b'same content hash'
+        f1 = make_file(self.src, 'first.nc', content)
+        f2 = make_file(self.src, 'second.nc', content)
+        files = [
+            {'path': f1, 'profile': 'L60', 'folder': 'L60', 'hash': file_hash(f1)},
+            {'path': f2, 'profile': 'L60', 'folder': 'L60', 'hash': file_hash(f2)},
+        ]
+        plan = plan_sort(files, self.out)
+        actions = [p['action'] for p in plan]
+        self.assertEqual(actions, ['MOVE', 'SKIP_DUPLICATE'])
+        results = execute_plan(plan)
+        self.assertTrue(results[1]['ok'])
+        self.assertEqual(results[1]['action'], 'SKIP_DUPLICATE')
+
+    def test_already_in_target_folder_skipped(self):
+        folder = os.path.join(self.out, 'HEA200')
+        os.makedirs(folder)
+        f1 = make_file(folder, 'beam.nc', b'content-abc')
+        files = [{'path': f1, 'profile': 'HEA200', 'folder': 'HEA200', 'hash': 'h1'}]
+        plan = plan_sort(files, self.out)
+        self.assertEqual(plan[0]['action'], 'SKIP_ALREADY')
+
+    def test_folder_hash_set(self):
+        folder = os.path.join(self.out, 'X')
+        os.makedirs(folder)
+        make_file(folder, 'a.nc', b'content-1')
+        make_file(folder, 'b.nc', b'content-2')
+        hashes = folder_hash_set(folder)
+        self.assertEqual(len(hashes), 2)
+
+    def test_plan_summary_counts(self):
+        f1 = make_file(self.src, 'a.nc', b'c1')
+        f2 = make_file(self.src, 'b.nc', b'c2')
+        files = [
+            {'path': f1, 'profile': 'L60', 'folder': 'L60', 'hash': 'h1'},
+            {'path': f2, 'profile': 'HEA160', 'folder': 'HEA160', 'hash': 'h2'},
+        ]
+        plan = plan_sort(files, self.out)
+        moved, dup, already, folders = plan_summary(plan)
+        self.assertEqual(moved, 2)
+        self.assertEqual(dup, 0)
+        self.assertEqual(already, 0)
+        self.assertEqual(folders['L60'], 1)
+        self.assertEqual(folders['HEA160'], 1)
+
+    def test_plan_conflicts_none_when_clean(self):
+        f1 = make_file(self.src, 'a.nc', b'c1')
+        files = [{'path': f1, 'profile': 'HEA200', 'folder': 'HEA200', 'hash': file_hash(f1)}]
+        plan = plan_sort(files, self.out)
+        self.assertEqual(plan_conflicts(plan), [])
+
+    def test_plan_conflicts_when_overwrite_risk(self):
+        folder = os.path.join(self.out, 'HEA200')
+        os.makedirs(folder)
+        existing = make_file(folder, 'a.nc', b'different-content')
+        f1 = make_file(self.src, 'a.nc', b'other-content')
+        files = [{'path': f1, 'profile': 'HEA200', 'folder': 'HEA200', 'hash': file_hash(f1)}]
+        plan = plan_sort(files, self.out)
+        self.assertEqual(plan[0]['dest_name'], 'a_2.nc')
+        self.assertEqual(plan_conflicts(plan), [])
+
+    def test_execute_plan_leaves_no_empty_folders(self):
+        f1 = make_file(self.src, 'a.nc', b'c1')
+        f2 = make_file(self.src, 'b.nc', b'c2')
+        files = [
+            {'path': f1, 'profile': 'L60', 'folder': 'L60', 'hash': 'h1'},
+            {'path': f2, 'profile': 'HEA160', 'folder': 'HEA160', 'hash': 'h2'},
+        ]
+        plan = plan_sort(files, self.out)
+        execute_plan(plan)
+        self.assertTrue(os.path.exists(os.path.join(self.out, 'L60', 'a.nc')))
+        self.assertTrue(os.path.exists(os.path.join(self.out, 'HEA160', 'b.nc')))
+
+    def test_prune_empty_dirs(self):
+        empty = os.path.join(self.out, 'L60')
+        os.makedirs(empty)
+        make_file(self.out, 'keep.txt', b'x')
+        prune_empty_dirs(self.out)
+        self.assertFalse(os.path.exists(empty))
+        self.assertTrue(os.path.exists(self.out))
+
+    def test_stored_hash_copy_keeps_display_name(self):
+        # Owner bug report: after P1 the stored copy path is the content
+        # hash (projects/<name>/input/<sha256>.nc1). The organizer must
+        # keep the ORIGINAL display name (e.g. C1.nc1) - the name changes
+        # ONLY by explicit user command inside the app, never automatically.
+        stored = make_file(self.src, '58d14bb21840c7b8f3e207939ced47ae5478dca97ef31bad292c8fab6956e2c9.nc1',
+                           b'c1-content')
+        files = [
+            {'name': 'C1.nc1', 'path': stored, 'profile': 'HEA160',
+             'folder': 'HEA160', 'hash': '58d14bb21840c7b8f3e207939ced47ae5478dca97ef31bad292c8fab6956e2c9'},
+        ]
+        plan = plan_sort(files, self.out)
+        self.assertEqual(plan[0]['name'], 'C1.nc1')
+        self.assertEqual(plan[0]['dest_name'], 'C1.nc1')
+        self.assertEqual(plan[0]['dest'], os.path.join(self.out, 'HEA160', 'C1.nc1'))
+        results = execute_plan(plan)
+        self.assertTrue(results[0]['ok'])
+        self.assertTrue(os.path.exists(os.path.join(self.out, 'HEA160', 'C1.nc1')))
+
+    def test_display_name_takes_precedence_over_path_basename(self):
+        # Even when the stored path basename differs from the record name,
+        # the record name wins (regression lock for the owner traceability
+        # rule: c1.nc1 / CH-1 names are the company paper-trail reference).
+        stored = make_file(self.src, 'aabbcc.nc1', b'beam-content')
+        files = [
+            {'name': 'CH-1.nc1', 'path': stored, 'profile': 'HEA200',
+             'folder': 'HEA200', 'hash': 'aabbcc'},
+        ]
+        plan = plan_sort(files, self.out)
+        self.assertEqual(plan[0]['dest_name'], 'CH-1.nc1')
+        self.assertTrue(plan[0]['dest'].endswith('CH-1.nc1'))
+
+    def test_two_stored_copies_same_display_name_get_suffix(self):
+        # Two different stored copies that share a display name (same name
+        # imported into different orders) must not collide in the folder:
+        # the second one gets the numeric suffix, the name is still derived
+        # from the record, not from the hash path.
+        stored1 = make_file(self.src, '111111.nc1', b'content-one')
+        stored2 = make_file(self.src, '222222.nc1', b'content-two')
+        files = [
+            {'name': 'C1.nc1', 'path': stored1, 'profile': 'L60',
+             'folder': 'L60', 'hash': '111111'},
+            {'name': 'C1.nc1', 'path': stored2, 'profile': 'L60',
+             'folder': 'L60', 'hash': '222222'},
+        ]
+        plan = plan_sort(files, self.out)
+        names = sorted(os.path.basename(p['dest']) for p in plan)
+        self.assertEqual(names, ['C1.nc1', 'C1_2.nc1'])
+
+
+if __name__ == '__main__':
+    unittest.main()
