+    def _attach_beam_contours(self, part):
+        """Give the beam fixture faces real outer contours.
+
+        Production blueprint files carry OP/OC (AK) contours that the
+        fixture text omits; without them the renderer cannot lay the face
+        canvases out or hit-test clicks like a real part. Attaching the
+        contours here keeps the shared ``_load_beam`` text untouched.
+        """
+        from nccorrection.engine.parser.dstv_part import DstvContour, DstvVertex
+
+        def rect(code, w, h):
+            return DstvContour(
+                code, [DstvVertex(0.0, 0.0), DstvVertex(w, 0.0),
+                       DstvVertex(w, h), DstvVertex(0.0, h),
+                       DstvVertex(0.0, 0.0)], 'outer')
+
+        for code, w, h in (('v', 6000.0, 300.0), ('u', 6000.0, 150.0)):
+            face = part.get_face(code)
+            if face is not None:
+                face.outer_contour = rect(code, w, h)
+        return part
+
