@@ -0,0 +1,277 @@
+from __future__ import annotations
+
+from PySide6.QtWidgets import (
+    QMainWindow, QWidget, QVBoxLayout, QLabel, QFrame,
+    QMessageBox, QDialog, QFileDialog,
+)
+from PySide6.QtCore import Qt, QTimer, QEvent
+
+from nccorrection.core.order_utils import _extract_order
+from nccorrection.ui.qt_viewer import NcViewer
+from nccorrection.ui._colors import C
+
+# ── Domain mixins (extracted from this file for readability) ──────────
+from nccorrection.ui.mixins import (
+    UIBuilderMixin, FileImportMixin, FileManagementMixin,
+    Viewer2D3DMixin, HolesEditorMixin, OrderManagerMixin,
+    PartCreatorMixin, OrganizeMixin, ExportMixin,
+    ProjectMixin, SettingsMixin, CloseQuitMixin,
+)
+
+
+# Canonical dark QMenu look for the viewer context menus - same palette as
+# the app's other menus (custom_header) so popups inherit the app's dark
+# scheme regardless of the system palette.
+_VIEWER_MENU_QSS = f"""
+    QMenu {{ background-color: {C.panel}; color: {C.txt}; border: 1px solid {C.line}; }}
+    QMenu::item {{ padding: 4px 24px 4px 8px; color: {C.txt}; }}
+    QMenu::item:selected {{ background: {C.line}; }}
+"""
+
+# Shared NC1 text metrics — single source of truth (ui/_metrics.py)
+from nccorrection.ui._metrics import (  # noqa: E402
+    extract_steel as _extract_steel,
+    section_area as _section_area,
+    part_metrics as _part_metrics,
+    GRADE_RE as _GRADE_RE,
+    PROFILE_TYPES as _PROFILE_TYPES,
+    DENSITY as _DENSITY,
+)
+
+
+class _FacePreviewCard(QFrame):
+    """Clickable mini 2D preview of ONE face for the DXF export dialog.
+
+    Reuses the real NcViewer so the preview shows the exact same lines and
+    colors as the main 2D view (same widget, same drawing code). Clicking a
+    card toggles whether that face is exported: excluded faces disappear
+    live and leave a dimmed red placeholder, so the user sees exactly what
+    the program will produce.
+    """
+
+    def __init__(self, geometry, face, label, parent=None):
+        super().__init__(parent)
+        self._face = face
+        self._label = label
+        self._on = True
+        self.setFixedSize(180, 165)
+        self.setObjectName('facePreview')
+        self._lay = QVBoxLayout(self)
+        self._lay.setContentsMargins(4, 4, 4, 4)
+        self._lay.setSpacing(2)
+        self._viewer = None
+        if geometry is not None:
+            self._viewer = NcViewer(self)
+            self._viewer.setMinimumSize(168, 118)
+            g = self._face_geometry(geometry, face)
+            if g is not None and (g.get('contours') or g.get('holes')):
+                self._viewer.set_geometry_object(g, fit=True)
+            self._viewer.installEventFilter(self)
+            self._lay.addWidget(self._viewer, 1)
+        self._title = QLabel(label, self)
+        self._title.setAlignment(Qt.AlignCenter)
+        self._title.setStyleSheet(f'color: {C.txt}; font-weight: bold;')
+        self._lay.addWidget(self._title)
+        self._title.installEventFilter(self)
+        self._off = QLabel('', self)
+        self._off.setAlignment(Qt.AlignCenter)
+        self._off.setStyleSheet('color: #f87171; font-weight: bold;')
+        self._off.hide()
+        self._lay.addWidget(self._off)
+        self._apply_style()
+
+    @staticmethod
+    def _face_geometry(geometry, face):
+        """Geometry dict reduced to ONE face (contours + face-tagged holes).
+
+        Faceless geometry (plates/DXF imports) belongs entirely to 'v'."""
+        cf = geometry.get('contour_faces')
+        holes = geometry.get('holes') or []
+        hole_faces = any(h.get('face') for h in holes)
+        if not cf and not hole_faces:
+            return geometry if face == 'v' else None
+        contours = geometry.get('contours') or []
+        meta = geometry.get('contour_meta') or []
+        sel_c, sel_f, sel_m = [], [], []
+        for i, c in enumerate(contours):
+            f = (cf[i] if i < len(cf) else
+                 (meta[i].get('face', 'v') if i < len(meta) else 'v'))
+            if f == face:
+                sel_c.append(c)
+                sel_f.append(f)
+                if i < len(meta):
+                    sel_m.append(meta[i])
+        out = dict(geometry)
+        out['contours'] = sel_c
+        out['contour_faces'] = sel_f
+        out['contour_meta'] = sel_m
+        out['holes'] = [h for h in holes if (h.get('face') or 'v') == face]
+        return out
+
+    def is_on(self):
+        return self._on
+
+    def set_on(self, on):
+        self._on = bool(on)
+        if self._viewer is not None:
+            self._viewer.setVisible(self._on)
+        self._off.setVisible(not self._on)
+        if not self._on:
+            self._off.setText('\u2715 ' + self._label)
+        self._apply_style()
+
+    def _apply_style(self):
+        border = C.green if self._on else '#7f1d1d'
+        self.setStyleSheet(
+            'QFrame#facePreview { border: 2px solid %s;'
+            ' border-radius: 6px; background: #0b1526; }' % border)
+
+    def mousePressEvent(self, event):
+        self.set_on(not self._on)
+
+    def eventFilter(self, obj, event):
+        if event.type() == QEvent.MouseButtonPress and \
+                (obj is self._viewer or obj is self._title):
+            self.set_on(not self._on)
+            return True
+        return super().eventFilter(obj, event)
+
+
+_VERSION = '1.v21'
+
+
+class NCManagerApp(UIBuilderMixin, FileImportMixin, FileManagementMixin,
+                   Viewer2D3DMixin, HolesEditorMixin, OrderManagerMixin,
+                   PartCreatorMixin, OrganizeMixin, ExportMixin,
+                   ProjectMixin, SettingsMixin, CloseQuitMixin,
+                   QMainWindow):
+    VIEW_OPTS_2D = [('2d_grid', 'grid'), ('2d_axes', 'axis_opt'),
+                    ('2d_cotation', 'cotation'), ('2d_blueprint', 'blueprint'),
+                    ('2d_foreshorten', 'foreshorten')]
+
+    VIEW_OPTS_3D = [('3d_legend', 'legend'), ('3d_section', 'section'),
+                    ('3d_wire', 'wireframe'), ('3d_spin', 'spin')]
+
+    COLUMNS = [
+        ('st', 'st', True),
+        ('name', 'name', True),
+        ('qty', 'qty', True),
+        ('profile', 'profile', True),
+        ('quality', 'quality', True),
+        ('length_mm', 'length_mm', True),
+        ('weight', 'weight', True),
+        ('order', 'order_id', False),
+        ('modified', 'modified', False),
+        ('cat', 'cat_title', False),
+        ('fam', 'family', False),
+        ('folder', 'folder', False),
+        ('o', 'o_plane', False),
+        ('si', 'si_en', False),
+        ('size', 'size', False),
+        ('hash', 'hash', False),
+        ('target', 'target', False),
+        ('warning', 'warning', False),
+        ('notes', 'notes', False),
+    ]
+
+    EDITABLE_COLUMNS = {'name': 'edit_name', 'qty': 'edit_qty',
+                        'quality': 'edit_quality'}
+
+    def __init__(self, splash=None):
+        super().__init__()
+        # BOOTLOADER (SPRINT 3, CTO 2026-09-02): strict, sequential, grouped init.
+        # Each major subsystem is a named step; future engines (Steel, Nesting)
+        # are added as ONE more line here. finish() runs at the very end.
+        self._splash = splash
+        self._splash_status("Loading Preferences & Services...", 20)
+        self._setup_services()
+        self._splash_status("Booting 2D/3D Render Engines...", 55)
+        self._setup_viewers()
+        self._splash_status("Preparing Workspace...", 85)
+        self._build()
+        self._load_view_opts()
+        self._update_help()
+        self._check_resources()
+        self.audit.log('Application started', 'ok', 'OK-100')
+        self._set_status(f"{self.tr_('ready')} - {self.tr_('app_title')}")
+        last = self.settings.get('last_project', '')
+        if last and self.projects.exists(last):
+            QTimer.singleShot(0, lambda: self._load_project(last))
+        self._splash_status("Ready.", 100)
+        self.parsed_parts = {}  # hash -> parsed part faces dict
+        if self._splash is not None:
+            self._splash.finish(self)
+
+    def _toggle_measure(self, checked):
+        self._set_tool('measure' if checked else 'none')
+
+    def _set_tool(self, tool):
+        # default = rotate (Ctrl+left-drag) + pan (middle-drag); measure is a toggle
+        self.tool_measure_btn.setChecked(tool == 'measure')
+        self.viewer.set_mode(tool)
+        self.viewer3d.set_mode(tool)
+        if hasattr(self, 'face_viewer'):
+            self.face_viewer.set_mode(tool)
+        self.measure_label.setText('')
+        self._update_help()
+
+    def _on_measure_result(self, text):
+        self.measure_label.setText(text)
+
+    def _on_dimension_mode_changed(self, mode):
+        """Handle dimension tool selection from DimensionToolbar."""
+        if mode and mode != 'none':
+            self.viewer.set_mode('measure')
+            if hasattr(self.viewer, 'set_measure_submode'):
+                self.viewer.set_measure_submode(mode)
+            self._set_tool(f'dim_{mode}')
+            self.measure_label.setText(f'Dimension: {mode.title()}')
+        else:
+            self._set_tool('none')
+            self.measure_label.setText('')
+
+    def _cycle_preset(self):
+        order = ['iso', 'top', 'front', 'right']
+        cur = getattr(self, '_preset_idx', 0)
+        self._preset_idx = (cur + 1) % len(order)
+        name = order[self._preset_idx]
+        self._viewer_preset(name)
+        self.preset_btn.setText(self.tr_(f'view_{name}').upper())
+
+    def _viewer_preset(self, name):
+        if self._view_mode != '3d':
+            self._set_view_mode('3d')
+        self.viewer3d.set_preset(name)
+
+    # ---------------------------------------------------------------- selection
+    def _on_escape(self):
+        if self.tool_measure_btn.isChecked():
+            self.tool_measure_btn.setChecked(False)
+            return
+        self._clear_selection()
+
+    def _select_all(self):
+        if len(self.selected) == len(self.files):
+            self.selected.clear()
+            self.table.clearSelection()
+        else:
+            self.selected = set(range(len(self.files)))
+            self.table.selectAll()
+        self._render_table()
+        self._update_details()
+
+    def _clear_selection(self):
+        self.selected.clear()
+        self.table.clearSelection()
+        self._render_table()
+
+    def _clear_list(self):
+        if not self.files:
+            return
+        if QMessageBox.question(self, self.tr_('clear'), self.tr_('clear_confirm')) == QMessageBox.Yes:
+            self.files = []
+            self.selected.clear()
+            self._render_table()
+            self._refresh_order_combo()
+            self._set_status(self.tr_('ready'))
+
