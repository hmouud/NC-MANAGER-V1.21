+"""Dimension style configuration — pure data, theme-aware.
+
+A DimensionStyle controls every visual aspect of a dimension: arrow size,
+text height, colours, line widths, font, etc. Two presets are provided:
+
+- ``DEFAULT_STYLE`` — professional dark-theme (matches NC Manager's
+  industrial dark palette).
+- ``BLUEPRINT_STYLE`` — lighter variant for the blueprint/foreshortened view.
+
+Styles are plain dataclasses — the renderer reads them and configures
+QPainter accordingly. No Qt imports here.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Optional
+
+from .types import ArrowStyle, TextPlacement
+
+
+@dataclass
+class DimensionStyle:
+    """Complete visual configuration for dimension rendering."""
+
+    # ── Arrow ──
+    arrow_size: float = 3.0            # Arrow length (mm)
+    arrow_style: ArrowStyle = ArrowStyle.FILLED
+    arrow_color: str = '#fbbf24'        # Amber
+    arrow_fill: str = '#fbbf24'
+
+    # ── Dimension line ──
+    dim_line_color: str = '#fbbf24'     # Amber
+    dim_line_width: float = 0.7         # Pen width
+    dim_line_dash: Optional[str] = None  # None=solid, 'dash', 'dot', 'dashdot'
+
+    # ── Extension lines ──
+    ext_line_color: str = '#fbbf2480'   # Amber @ 50% alpha
+    ext_line_width: float = 0.5
+    ext_line_offset: float = 1.5        # Gap from measured point (mm)
+    ext_line_extend: float = 3.0        # Extension beyond dimension line (mm)
+
+    # ── Text ──
+    text_height: float = 8.0            # Font size (mm on paper)
+    text_color: str = '#fbbf24'         # Amber
+    text_font: str = 'Arial'
+    text_gap: float = 1.5              # Gap between text and dimension line
+    text_bg_color: str = '#0f172a'      # Dark background behind text
+    text_bg_radius: float = 3.0         # Rounded corner radius
+    text_bg_padding: float = 2.0        # Padding around text
+    text_outside_horizontal: bool = True  # Text horizontal when outside
+
+    # ── Center mark ──
+    center_mark_size: float = 3.0       # Half-size of cross (mm)
+    center_mark_color: str = '#fbbf24'
+    center_mark_width: float = 0.5
+    center_line_extend: float = 5.0     # Extended center line length
+    center_line_dash: str = 'dashdot'
+
+    # ── Leader ──
+    leader_arrow_size: float = 3.0
+    leader_tail_length: float = 8.0     # Horizontal tail length (mm)
+    leader_color: str = '#fbbf24'
+    leader_width: float = 0.7
+
+    # ── Bolt circle ──
+    bolt_circle_radius_color: str = '#fbbf24'
+    bolt_circle_angular_color: str = '#fbbf24'
+    bolt_circle_center_color: str = '#f472b6'
+
+    # ── General ──
+    precision: int = 1                  # Decimal places for values
+    prefix: str = ''                    # Optional prefix before text
+    suffix: str = ''                    # Optional suffix after text
+
+
+# ────────────────────────────────────────────────────────────────────
+# Presets
+# ────────────────────────────────────────────────────────────────────
+
+DEFAULT_STYLE = DimensionStyle(
+    arrow_size=3.0,
+    arrow_style=ArrowStyle.FILLED,
+    arrow_color='#fbbf24',
+    arrow_fill='#fbbf24',
+    dim_line_color='#fbbf24',
+    dim_line_width=0.7,
+    ext_line_color='#fbbf2480',
+    ext_line_width=0.5,
+    ext_line_offset=1.5,
+    ext_line_extend=3.0,
+    text_height=8.0,
+    text_color='#fbbf24',
+    text_font='Arial',
+    text_gap=1.5,
+    text_bg_color='#0f172a',
+    text_bg_radius=3.0,
+    text_bg_padding=2.0,
+    text_outside_horizontal=True,
+    center_mark_size=3.0,
+    center_mark_color='#fbbf24',
+    center_mark_width=0.5,
+    center_line_extend=5.0,
+    center_line_dash='dashdot',
+    leader_arrow_size=3.0,
+    leader_tail_length=8.0,
+    leader_color='#fbbf24',
+    leader_width=0.7,
+    bolt_circle_radius_color='#fbbf24',
+    bolt_circle_angular_color='#fbbf24',
+    bolt_circle_center_color='#f472b6',
+    precision=1,
+)
+
+BLUEPRINT_STYLE = DimensionStyle(
+    arrow_size=2.5,
+    arrow_style=ArrowStyle.FILLED,
+    arrow_color='#2980b9',
+    arrow_fill='#2980b9',
+    dim_line_color='#2980b9',
+    dim_line_width=0.5,
+    ext_line_color='#2980b980',
+    ext_line_width=0.4,
+    ext_line_offset=1.0,
+    ext_line_extend=2.5,
+    text_height=7.0,
+    text_color='#2980b9',
+    text_font='Arial',
+    text_gap=1.0,
+    text_bg_color='#ffffff',
+    text_bg_radius=2.0,
+    text_bg_padding=1.5,
+    text_outside_horizontal=True,
+    center_mark_size=2.5,
+    center_mark_color='#2980b9',
+    center_mark_width=0.4,
+    center_line_extend=4.0,
+    center_line_dash='dashdot',
+    leader_arrow_size=2.5,
+    leader_tail_length=6.0,
+    leader_color='#2980b9',
+    leader_width=0.5,
+    bolt_circle_radius_color='#2980b9',
+    bolt_circle_angular_color='#2980b9',
+    bolt_circle_center_color='#e67e22',
+    precision=1,
+)
+
+
+def style_from_theme(theme: dict) -> DimensionStyle:
+    """Create a DimensionStyle adapted to a viewer theme dict.
+
+    The theme dict uses the same keys as ``design.theme.blueprint_palette``.
+    """
+    if not theme or not isinstance(theme, dict):
+        return DimensionStyle()
+
+    # Detect dark theme
+    bg = theme.get('bg', '#f0f3f4')
+    r = int(bg[1:3], 16)
+    g = int(bg[3:5], 16)
+    b = int(bg[5:7], 16)
+    is_dark = (r + g + b) / 3.0 < 128
+
+    yel = theme.get('yel', theme.get('measure_label', '#fbbf24'))
+    blue = theme.get('blue', theme.get('contour', '#2980b9'))
+    panel = theme.get('panel', '#1e293b')
+
+    if is_dark:
+        return DimensionStyle(
+            arrow_color=yel,
+            arrow_fill=yel,
+            dim_line_color=yel,
+            text_color=yel,
+            text_bg_color=panel,
+            center_mark_color=yel,
+            leader_color=yel,
+            bolt_circle_radius_color=yel,
+            bolt_circle_angular_color=yel,
+            bolt_circle_center_color=theme.get('vio', '#a78bfa'),
+            ext_line_color=yel + '80',
+        )
+    else:
+        return DimensionStyle(
+            arrow_color=blue,
+            arrow_fill=blue,
+            dim_line_color=blue,
+            text_color=blue,
+            text_bg_color='#ffffff',
+            center_mark_color=blue,
+            leader_color=blue,
+            bolt_circle_radius_color=blue,
+            bolt_circle_angular_color=blue,
+            bolt_circle_center_color='#e67e22',
+            ext_line_color=blue + '80',
+        )
