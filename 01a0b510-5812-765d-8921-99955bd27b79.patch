+    QRadioButton,
+    QVBoxLayout,
+)
+
+from nccorrection.core.viewer import parse_geometry
+
+
+# _FacePreviewCard lives in app.py (imported by tests via app.py).
+# Late-imported inside _ask_dxf_export_options to avoid circular imports.
+
+
+# ---------------------------------------------------------------------------
+# ExportMixin — mixed into NCManagerApp
+# ---------------------------------------------------------------------------
+
+class ExportMixin:
+    """NC/CN/DXF/PDF/OBJ/STL export and save-edits functionality."""
+
+    # ------------------------------------------------------------------ export
+    def _export(self):
+        """Clean Export button: pick the format then save the current part.
+
+        Supported: NC/NC1/CN (edited DSTV text), DXF (2D CAD), PDF (current
+        view), OBJ, STL (3D).
+        """
+        f = self._current_file
+        if not f or not getattr(self, '_current_geometry', None):
+            self._toast(self.tr_('export_none'), title=self.tr_('export'))
+            return
+        base = os.path.splitext(os.path.basename(f['name']))[0]
+        default = os.path.join(os.path.expanduser('~'), 'Documents',
+                               f"{base}.nc1")
+        flt = ('NC/NC1 (*.nc1 *.nc);;CN (*.cn);;DXF (*.dxf);;PDF (*.pdf);;'
+               'Wavefront OBJ (*.obj);;STL binaire (*.stl);;Tous fichiers (*)')
+        path, chosen = QFileDialog.getSaveFileName(
+            self, self.tr_('export_save'), default, flt)
+        if not path:
+            return
+        self._do_export(os.path.splitext(path)[1].lower(), path)
+
+    def _export_as(self, fmt):
+        """Export the current part directly in ``fmt`` ('cn','nc1','dxf','pdf')."""
+        f = self._current_file
+        if not f or not getattr(self, '_current_geometry', None):
+            self._toast(self.tr_('export_none'), title=self.tr_('export'))
+            return
+        ext = f'.{fmt}'
+        base = os.path.splitext(os.path.basename(f['name']))[0]
+        default = os.path.join(os.path.expanduser('~'), 'Documents',
+                               f"{base}{ext}")
+        labels = {'cn': 'CN (*.cn)', 'nc1': 'NC1 (*.nc1)',
+                  'dxf': 'DXF (*.dxf)', 'pdf': 'PDF (*.pdf)'}
+        path, _ = QFileDialog.getSaveFileName(
+            self, self.tr_('export_save'), default, labels.get(fmt, 'Tous fichiers (*)'))
+        if not path:
+            return
+        if not os.path.splitext(path)[1].lower():
+            path += ext
+        self._do_export(ext, path)
+
+    def _distinct_faces(self, geometry):
+        """Face letters present in a geometry dict (contours first, holes
+        as a fallback, plates/DXF default to 'v')."""
+        if not geometry:
+            return []
+        faces = geometry.get('contour_faces') or []
+        if not faces:
+            faces = [h.get('face', 'v') for h in geometry.get('holes', [])]
+        if not faces and (geometry.get('contours') or geometry.get('points')):
+            faces = ['v']
+        return list(dict.fromkeys(faces))  # order-preserving unique
+
+    def _ask_dxf_export_options(self, faces, n_files=1, geometry=None):
+        """Face-choice + layout dialog for DXF export (Workshop B).
+
+        One clickable mini 2D preview per face (same widget, lines and
+        colors as the main 2D view). Clicking a preview toggles whether that
