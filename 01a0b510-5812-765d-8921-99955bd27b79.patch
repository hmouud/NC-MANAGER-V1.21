+from __future__ import annotations
+
+import os
+from PySide6.QtWidgets import QSplashScreen
+from PySide6.QtGui import QColor, QFont, QPixmap, QLinearGradient, QPen, QBrush
+from PySide6.QtCore import Qt, QRectF
+
+from nccorrection.ui._colors import C
+
+
+class ModernSplash(QSplashScreen):
+    """Modern engineering CAD splash screen with smooth progress bar."""
+
+    def __init__(self):
+        image_path = "rsc/images/splash_bg.png"
+        if os.path.exists(image_path):
+            pixmap = QPixmap(image_path)
+        else:
+            pixmap = QPixmap(640, 380)
+            pixmap.fill(QColor("#0f172a"))
+        super().__init__(pixmap, Qt.WindowStaysOnTopHint | Qt.FramelessWindowHint)
+        self.current_message = "Initializing NC Manager..."
+        self.progress_value = 10.0
+
+    def update_status(self, message: str, progress: float | None = None):
+        """Update loading status message and optional progress (0..100)."""
+        self.current_message = message
+        if progress is not None:
+            self.progress_value = max(0.0, min(100.0, float(progress)))
+        self.repaint()
+
+    def set_progress(self, progress: float, message: str = ""):
+        if message:
+            self.current_message = message
+        self.progress_value = max(0.0, min(100.0, float(progress)))
+        self.repaint()
+
+    def drawContents(self, painter):
+        super().drawContents(painter)
+        r = self.rect()
+
+        # ── Title & Branding ──
+        painter.setFont(QFont("Segoe UI", 26, QFont.Bold))
+        painter.setPen(QColor(C.accent))
+        painter.drawText(r.adjusted(0, 0, 0, -80), Qt.AlignCenter, "NC MANAGER")
+
+        painter.setFont(QFont("Segoe UI", 11))
+        painter.setPen(QColor("#94a3b8"))
+        painter.drawText(r.adjusted(0, 0, 0, -40), Qt.AlignCenter, "Steel Detailing & DSTV Engine")
+
+        # ── Realistic Progress Bar ──
+        bw = min(460.0, float(r.width()) - 80.0)
+        bh = 7.0
+        bx = (r.width() - bw) / 2.0
+        by = float(r.height()) - 42.0
+
+        # Background track
+        track_rect = QRectF(bx, by, bw, bh)
+        painter.setPen(QPen(QColor(C.line), 1.0))
+        painter.setBrush(QBrush(QColor(15, 23, 42, 220)))
+        painter.drawRoundedRect(track_rect, 3.5, 3.5)
+
+        # Progress fill with gradient
+        fill_w = max(4.0, bw * (self.progress_value / 100.0))
+        fill_rect = QRectF(bx, by, fill_w, bh)
+        grad = QLinearGradient(bx, by, bx + fill_w, by)
+        grad.setColorAt(0.0, QColor("#0284c7"))
+        grad.setColorAt(1.0, QColor("#38bdf8"))
+        painter.setPen(Qt.NoPen)
+        painter.setBrush(QBrush(grad))
+        painter.drawRoundedRect(fill_rect, 3.5, 3.5)
+
+        # Status text & percentage
+        painter.setFont(QFont("Segoe UI", 9))
+        painter.setPen(QColor("#cbd5e1"))
+        msg_rect = QRectF(bx, by - 22.0, bw, 18.0)
+        status_line = f"{self.current_message} ({int(self.progress_value)}%)"
+        painter.drawText(msg_rect, Qt.AlignLeft | Qt.AlignVCenter, status_line)
diff --git a/src/nccorrection/ui/components/svg_icon.py b/src/nccorrection/ui/components/svg_icon.py
new file mode 100644
index 0000000..448724a
--- /dev/null
+++ b/src/nccorrection/ui/components/svg_icon.py
@@ -0,0 +1,122 @@
+"""SVG-first icon loading with PNG fallback.
+
+Icons live in ``<project>/rsc/icons``. This module loads them by *base name*
+(e.g. ``"folder-cyan-open"``) and prefers a vector ``.svg`` file when present,
+falling back to the existing raster ``.png`` — so the app keeps working even
+before every PNG has an SVG twin.
+
+Why SVG: ``QIcon``/``QSvgRenderer`` render vectors at the widget's current
+``devicePixelRatio``, so icons stay crisp on 150%, 200% (4K/8K) displays
+instead of being upscaled pixels. ``rasterize_svg`` is provided for places
+that need an explicit fixed-size ``QPixmap`` (header logos, About dialog).
+
+No colors are hardcoded here: SVGs are static art files (one color per icon,
+chosen to work on both light/dark panels). Theming/recoloring of vectors is a
+separate concern and can be added later via ``QSvgRenderer`` color overrides.
+
+Usage:
+    from nccorrection.ui.components.svg_icon import load_icon, resolve_icon
+    icon = load_icon('folder-cyan-open')          # -> QIcon (svg or png)
+    path = resolve_icon('help-browser-2')         # -> abs path or None
+    pix   = rasterize_svg(path, 48)               # -> QPixmap @ device DPR
+"""
+from __future__ import annotations
+
+import os
+
+from PySide6.QtCore import Qt
+from PySide6.QtGui import QIcon, QPainter, QPixmap
+
+from nccorrection.ui.components.scaling import device_scale
+
+_ICONS_DIR = None
+
+
+def icons_dir():
+    """Absolute path to ``<project>/rsc/icons`` (same resolution as
+    ``ResourceService``, computed lazily and cached)."""
+    global _ICONS_DIR
+    if _ICONS_DIR is None:
+        base = os.path.dirname(os.path.dirname(os.path.dirname(
+            os.path.dirname(os.path.abspath(__file__)))))
+        rsc = os.path.join(base, 'rsc')
+        if not os.path.isdir(rsc):
+            base = os.getcwd()
+        _ICONS_DIR = os.path.join(base, 'rsc', 'icons')
+    return _ICONS_DIR
+
+
+def resolve_icon(name):
+    """Return the absolute path of the best available icon for ``name``.
+
+    ``name`` may be a base name (``'folder-cyan-open'``) or already include an
+    extension (``'folder-cyan-open.png'``). Resolution order:
+    ``.svg`` -> ``.png`` -> other existing file with that base name -> None.
+    """
+    if not name:
+        return None
+    folder = icons_dir()
+    base = os.path.basename(name)
+    stem, ext = os.path.splitext(base)
+    if ext:
+        # explicit file name: prefer the vector twin, then the file itself
+        candidates = (f'{stem}.svg', base, f'{stem}.png')
+    else:
+        # base name only: svg first, then png
+        candidates = (f'{stem}.svg', f'{stem}.png', base)
+    for candidate in candidates:
+        path = os.path.join(folder, candidate)
+        if os.path.isfile(path):
+            return path
+    return None
+
+
+def icon_for_path(path):
+    """Build a ``QIcon`` from a file path (svg or png); empty icon if missing."""
+    if path and os.path.isfile(path):
+        return QIcon(path)
+    return QIcon()
+
+
+def load_icon(name):
+    """``QIcon`` for ``name`` — vector SVG when available, PNG otherwise.
+
+    ``QIcon`` renders the SVG at the current devicePixelRatio, giving crisp
+    results on high-DPI displays.
+    """
+    return icon_for_path(resolve_icon(name))
+
+
+def rasterize_svg(path, size, dpr=None):
+    """Render an SVG file to a fixed-logical-size ``QPixmap``.
+
+    The pixmap is backed at ``size * dpr`` physical pixels (with
+    ``devicePixelRatio`` set) so it never blurs on 4K/8K screens. Falls back to
+    a plain (non-vector) pixmap scaled from a PNG if ``path`` is not an SVG.
+    Returns a null pixmap if nothing renders.
+    """
+    if dpr is None:
+        dpr = max(1.0, device_scale())
+    phys = max(1, int(round(size * dpr)))
+    pix = QPixmap(phys, phys)
+    pix.setDevicePixelRatio(dpr)
+    pix.fill(Qt.transparent)
+    if path and path.lower().endswith('.svg'):
+        try:
+            from PySide6.QtSvg import QSvgRenderer
+            renderer = QSvgRenderer(path)
+        except Exception:
+            renderer = None
+        if renderer is not None and renderer.isValid():
+            painter = QPainter(pix)
+            try:
+                renderer.render(painter)
+            finally:
+                painter.end()
+            return pix
+    # PNG (or unusable SVG) fallback: smooth-scale the source.
+    src = QPixmap(path) if path and os.path.isfile(path) else QPixmap()
+    if not src.isNull():
+        return src.scaled(size, size, Qt.KeepAspectRatio, Qt.SmoothTransformation)
+    return pix
+
diff --git a/src/nccorrection/ui/components/toast.py b/src/nccorrection/ui/components/toast.py
new file mode 100644
index 0000000..8f92a86
--- /dev/null
+++ b/src/nccorrection/ui/components/toast.py
@@ -0,0 +1,278 @@
+"""Non-blocking toast notifications.
+
+``Toast`` — a small frameless, rounded, drop-shadowed popup that fades in,
+stays for a few seconds, then fades out on its own (``QTimer`` +
+``QPropertyAnimation``). It never opens a nested event loop, so the user keeps
+working while a message is shown.
+
+``ToastManager`` — stacks toasts in the bottom-right corner of the anchor
+window and re-flows them on show/close so several simultaneous toasts never
+overlap.
+
+``show_toast`` — the convenience entry point used by the rest of the UI:
+
+    from nccorrection.ui.components.toast import show_toast
+    show_toast(window, 'Export done: 12 / 12', kind='success')
+    show_toast(window, 'No part selected', kind='info')
+    show_toast(window, 'Screenshot failed', kind='error')
+
+Kinds: ``success`` (green), ``info`` (blue), ``warn`` (amber), ``error`` (red).
+
+Structure: the ``Toast`` is a top-level frameless window holding the drop
+shadow; a child ``_ToastCard`` paints the rounded card and carries the fade
+opacity effect (a widget can own only one graphics effect, so the two effects
+live on the two widgets). All sizes/fonts/margins go through ``scaling``.
+Presentation-layer only: nothing here touches the viewers or the parser.
+"""
+from __future__ import annotations
+
+from PySide6.QtCore import Qt, QTimer, QPropertyAnimation, QEasingCurve, QPoint, QRectF
+from PySide6.QtGui import QColor, QPainter, QPainterPath
+from PySide6.QtWidgets import (QWidget, QHBoxLayout, QLabel, QToolButton,
+                               QGraphicsDropShadowEffect, QGraphicsOpacityEffect)
+
+from nccorrection.ui.components.scaling import sp, font_pt
+from nccorrection.ui._colors import C
+
+KIND_COLORS = {
+    'success': '#4ade80',
+    'info': '#38bdf8',
+    'warn': '#fbbf24',
+    'error': C.red,
+}
+_KIND_GLYPH = {
+    'success': '\u2713',   # check
+    'info': 'i',
+    'warn': '!',
+    'error': '\u2715',     # x
+}
+
+_CARD = C.card
+_CARD_BORDER = C.line
+_TEXT = C.txt
+_MUT = C.mut
+
+_SHADOW_MARGIN = 14   # px reserved around the card for the drop shadow
+_AUTO_MS = 3500       # default auto-dismiss
+_FADE_IN_MS = 180
+_FADE_OUT_MS = 220
+
+
+class _ToastCard(QWidget):
+    """Paints the rounded card + accent strip and holds the fade effect."""
+
+    def __init__(self, kind, parent):
+        super().__init__(parent)
+        self._accent = QColor(KIND_COLORS[kind])
+        self.setAttribute(Qt.WA_TranslucentBackground, True)
+
+    def paintEvent(self, event):
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing, True)
+        m = sp(_SHADOW_MARGIN)
+        r = sp(10)
+        card = QRectF(self.rect()).adjusted(m, m, -m, -m)
+        path = QPainterPath()
+        path.addRoundedRect(card, r, r)
+        p.fillPath(path, QColor(_CARD))
+        p.setPen(QColor(_CARD_BORDER))
+        p.drawPath(path)
+        strip = QRectF(card.left() + sp(3), card.top() + sp(8),
+                       sp(4), card.height() - sp(16))
+        spath = QPainterPath()
+        spath.addRoundedRect(strip, sp(2), sp(2))
+        p.fillPath(spath, self._accent)
+        p.end()
+
+
+class Toast(QWidget):
+    """A single animated toast popup (fade-in, auto-dismiss, fade-out)."""
+
+    def __init__(self, text, kind='info', timeout_ms=_AUTO_MS,
+                 title=None, anchor=None):
+        super().__init__(None)  # top-level frameless window
+        self._anchor = anchor
+        self._kind = kind if kind in KIND_COLORS else 'info'
+        self._timeout_ms = int(timeout_ms)
+        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Tool | Qt.WindowStaysOnTopHint)
+        self.setAttribute(Qt.WA_TranslucentBackground, True)
+        self.setAttribute(Qt.WA_ShowWithoutActivating, True)
+        self.setFocusPolicy(Qt.NoFocus)
+
+        shadow = QGraphicsDropShadowEffect(self)
+        shadow.setBlurRadius(sp(18))
+        shadow.setOffset(0, sp(4))
+        shadow.setColor(QColor(0, 0, 0, 170))
+        self.setGraphicsEffect(shadow)
+
+        self._card = _ToastCard(self._kind, self)
+
+        glyph = QLabel(_KIND_GLYPH.get(self._kind, 'i'), self._card)
+        glyph.setFixedSize(sp(18), sp(18))
+        glyph.setAlignment(Qt.AlignCenter)
+        glyph.setStyleSheet(
+            f'color:#fff; background:{KIND_COLORS[self._kind]};'
+            f'border-radius:{sp(9)}px; font-weight:bold;'
+            f'font-size:{font_pt(10)}pt;')
+
+        title_label = QLabel(title or self._kind.title(), self._card)
+        title_label.setStyleSheet(
+            f'color:{KIND_COLORS[self._kind]}; background:transparent;'
+            f'font-weight:bold; font-size:{font_pt(11)}pt;')
+
+        msg = QLabel(str(text), self._card)
+        msg.setWordWrap(True)
+        msg.setTextInteractionFlags(Qt.TextSelectableByMouse)
+        msg.setStyleSheet(f'color:{_TEXT}; background:transparent;'
+                          f'font-size:{font_pt(10)}pt;')
+
+        close_btn = QToolButton(self._card)
+        close_btn.setText('\u2715')
+        close_btn.setCursor(Qt.PointingHandCursor)
+        close_btn.setFixedSize(sp(22), sp(22))
+        close_btn.setStyleSheet(
+            f'QToolButton {{ color:{_MUT}; background:transparent; border:none;'
+            f'font-weight:bold; font-size:{font_pt(10)}pt; }}'
+            f'QToolButton:hover {{ color:{_TEXT}; background:{_CARD_BORDER};'
+            f'border-radius:{sp(4)}px; }}')
+        close_btn.clicked.connect(self.close_now)
+
+        text_col = QWidget(self._card)
+        text_col.setAttribute(Qt.WA_TransparentForMouseEvents, True)
+        tl = QHBoxLayout(text_col)
+        tl.setContentsMargins(0, 0, 0, 0)
+        tl.setSpacing(sp(6))
+        tl.addWidget(title_label)
+        tl.addStretch(1)
+        tl.addWidget(msg, 1)
+
+        row = QHBoxLayout(self._card)
+        row.setContentsMargins(sp(12), sp(4), sp(6), sp(4))
+        row.setSpacing(sp(8))
+        row.addWidget(glyph, 0, Qt.AlignTop)
+        row.addWidget(text_col, 1)
+        row.addWidget(close_btn, 0, Qt.AlignTop)
+
+        outer = QHBoxLayout(self)
+        outer.setContentsMargins(0, 0, 0, 0)
+        outer.addWidget(self._card)
+
+        # fade effect lives on the card (outer owns the drop shadow)
+        self._opacity = QGraphicsOpacityEffect(self._card)
+        self._opacity.setOpacity(0.0)
+        self._card.setGraphicsEffect(self._opacity)
+
+        self._fade_in = QPropertyAnimation(self._opacity, b'opacity', self)
+        self._fade_in.setDuration(_FADE_IN_MS)
+        self._fade_in.setStartValue(0.0)
+        self._fade_in.setEndValue(1.0)
+        self._fade_in.setEasingCurve(QEasingCurve.OutCubic)
+
+        self._fade_out = QPropertyAnimation(self._opacity, b'opacity', self)
+        self._fade_out.setDuration(_FADE_OUT_MS)
+        self._fade_out.setStartValue(1.0)
+        self._fade_out.setEndValue(0.0)
+        self._fade_out.setEasingCurve(QEasingCurve.InCubic)
+        self._fade_out.finished.connect(self._on_faded_out)
+
+        self._timer = QTimer(self)
+        self._timer.setSingleShot(True)
+        self._timer.timeout.connect(self._start_fade_out)
+
+    # ------------------------------------------------------------ sizing
+    def kind(self):
+        return self._kind
+
+    def set_toast_size(self):
+        """Fix a logical width and let the layout compute the height."""
+        self.setFixedWidth(sp(340))
+        self.adjustSize()
+        self.setFixedHeight(self.sizeHint().height())
+
+    # ------------------------------------------------------------ lifecycle
+    def show_toast(self):
+        self.show()
+        self.raise_()
+        self._fade_in.start()
+        self._timer.start(self._timeout_ms)
+
+    def close_now(self):
+        self._timer.stop()
+        self._start_fade_out()
+
+    def _start_fade_out(self):
+        self._timer.stop()
+        if self._fade_out.state() != QPropertyAnimation.Running:
+            self._fade_out.start()
+
+    def _on_faded_out(self):
+        self.hide()
+        mgr = getattr(self, '_manager', None)
+        if mgr is not None:
+            mgr._on_toast_closed(self)
+        self.deleteLater()
+
+    def set_manager(self, mgr):
+        self._manager = mgr
+
+    # ------------------------------------------------------------ hover
+    def enterEvent(self, event):
+        self._timer.stop()
+        super().enterEvent(event)
+
+    def leaveEvent(self, event):
+        self._timer.start(self._timeout_ms)
+        super().leaveEvent(event)
+
+
+class ToastManager:
+    """Owns live toasts, stacking them bottom-right of each anchor window."""
+
+    _instance = None
+
+    @classmethod
+    def instance(cls):
+        if cls._instance is None:
+            cls._instance = cls()
+        return cls._instance
+
+    def __init__(self):
+        self._toasts = []  # list of Toast, oldest first
+
+    def show(self, anchor, text, kind='info', timeout_ms=_AUTO_MS, title=None):
+        toast = Toast(text, kind, timeout_ms, title, anchor)
+        toast.set_manager(self)
+        toast.set_toast_size()
+        self._toasts.append(toast)
+        toast.show_toast()
+        self._reflow()
+        return toast
+
+    def _on_toast_closed(self, toast):
+        if toast in self._toasts:
+            self._toasts.remove(toast)
+        self._reflow()
+
+    def _reflow(self):
+        """Stack all live toasts bottom-right of their anchor's geometry."""
+        for t in self._toasts:
+            anchor = t._anchor
+            if anchor is None or not anchor.isVisible():
+                t.close_now()
+                continue
+            g = anchor.window().geometry()
+            margin = sp(14)
+            x = g.right() - margin - t.width()
+            y = g.bottom() - margin - t.height()
+            # older toasts sit above newer ones; count how many already stack
+            for other in self._toasts:
+                if other is t:
+                    break
+                if other._anchor is anchor and other.isVisible():
+                    y -= other.height() + sp(8)
+            t.move(QPoint(x, y))
+
+
+def show_toast(parent, text, kind='info', timeout_ms=_AUTO_MS, title=None):
+    """Show a non-blocking toast in the bottom-right corner of ``parent``."""
+    return ToastManager.instance().show(parent, text, kind, timeout_ms, title)
diff --git a/src/nccorrection/ui/dialog_manager.py b/src/nccorrection/ui/dialog_manager.py
new file mode 100644
index 0000000..33fd695
--- /dev/null
+++ b/src/nccorrection/ui/dialog_manager.py
@@ -0,0 +1,472 @@
+"""Heavy closure-filled dialogs extracted from NCManagerApp (P2 split).
+
+The manager holds a reference to the owning app and delegates every state
+access back to it (``app.hole_overrides``, ``app._refresh_viewers``, ...).
+app.py only instantiates this manager and calls ``open_hole_editor`` /
+``open_settings``; the thin ``_edit_hole_dialog`` / ``_open_settings``
+delegates are kept on the app for test-compatibility (one test patches the
+former with a lambda to observe ``_edit_hole_by_index``).
+
+No parsers or viewers are touched by this module -- it consumes the core
+APIs (``core.viewer`` / ``core.input_mode``) through the app exactly as the
+extracted methods did.
+"""
+from __future__ import annotations
+
+from PySide6.QtCore import Qt
+from PySide6.QtGui import QDoubleValidator
+from PySide6.QtWidgets import (QButtonGroup, QCheckBox, QComboBox, QDialog,
+                               QGridLayout, QGroupBox, QHBoxLayout, QLabel,
+                               QLineEdit, QListWidget, QPushButton,
+                               QRadioButton, QStackedWidget, QVBoxLayout,
+                               QWidget)
+
+from nccorrection.core.input_mode import absolute_y, relative_y
+from nccorrection.core.viewer import parse_geometry, slot_major_axis
+from nccorrection.services.hole_edit_service import HoleEditService
+
+
+class DialogManager:
+    """Owns the hole editor and the settings dialog (P2 monolith split)."""
+
+    def __init__(self, app):
+        self._app = app
+        self._col_checks = {}
+
+    # ------------------------------------------------------------------ #
+    # Hole editor                                                         #
+    # ------------------------------------------------------------------ #
+    def open_hole_editor(self, index, h=None, pre_state=None):
+        """Open the modal hole/slot editor for ``index`` of the current file.
+
+        ``index >= 0`` edits an original hole (override store); a negative
+        index addresses the added-holes list (``-index - 1``). ``h`` is the
+        base hole record; when omitted it is resolved through the app
+        (``_base_hole``), so callers may pass only the index.
+
+        ``pre_state`` may be supplied by the caller (taken BEFORE inserting
+        a new-hole record) so cancel/undo revert the insertion too; it
+        defaults to a fresh snapshot taken here. Returns True when the
+        dialog was accepted, False when it was cancelled/closed.
+        """
+        app = self._app
+        f = app._current_file
+        if h is None:
+            h = app._base_hole(index)
+        overrides = dict(app.hole_overrides.get(f['hash'], {}))
+        ov = overrides.get(index) if index >= 0 else None
+        ov_dict = HoleEditService.normalize_override(ov)
+
+        cur = HoleEditService.current_values(ov_dict, h)
+        current_d = cur['d']
+        current_x = cur['x']
+        current_y = cur['y']
+        current_len = cur['length']
+        current_ang = cur['angle']
+        is_slot = h['kind'] == 'slot'
+        current_face = cur['face']
+        current_sym = cur['sym']
+        current_top = cur['top']
+        current_ymode = cur['ymode']
+        st_type = app._profile_type()
+        _dims = HoleEditService.part_dims(f['text'])
+        # INJECTION 2: Dynamic Face Resolution -- real faces from the parsed
+        # part, never v/h/o/u blindly. Single source: app._holes_faces(),
+        # the same helper the paste / change-plane flow uses (live AK contour
+        # faces intersected with the profile family's supported faces).
+        faces = app._holes_faces() or ['v', 'o', 'u', 'h']
+        if current_face not in faces:
+            faces = [current_face] + [x for x in faces if x != current_face]
+
+        dlg = QDialog(app)
+        dlg.setWindowTitle(f"{app.tr_('hole_d')} - {f['name']}")
+        if pre_state is None:
+            pre_state = app._snapshot_state()
+        lay = QVBoxLayout(dlg)
+        info = QLabel('\n'.join([
+            f"{app.tr_('name')}: {f['name']}",
+            f"{app.tr_('profile')}: {f['profile']}  "
+            f"({app._cat_label(f['category'])})",
+            f"{app.tr_('folder')}: {f['folder']}",
+            f"{app.tr_('qty')}: {app._qty_of(f)}   "
+            f"{app.tr_('status')}: {f['status']}",
+            f"o: {'yes' if f['o'] else 'no'}   "
+            f"SI/EN: {'yes' if f['si'] else 'no'}",
+        ]), dlg)
+        info.setStyleSheet(f'color:{app._theme["mut"]}; font-size:9px;')
+        info.setWordWrap(True)
+        lay.addWidget(info)
+        lay.addWidget(QLabel(
+            f"{app.tr_('slot') if is_slot else app.tr_('hole')}  "
+            f"| {app.tr_('edit_diameter_hint')}", dlg))
+
+        def _parse(ed, fallback):
+            try:
+                return float(ed.text())
+            except ValueError:
+                return fallback
+
+        def make_edit(val):
+            ed = QLineEdit(dlg)
+            ed.setText(f"{float(val):.2f}")
+            ed.setValidator(QDoubleValidator(-50000.0, 50000.0, 3, ed))
+            ed.textEdited.connect(rebuild_preview)
+            return ed
+
+        def y_mode():
+            return ('sym' if check_sym.isChecked()
+                    else 'top' if check_top.isChecked() else 'abs')
+
+        def collect():
+            return HoleEditService.build_override(
+                st_type, _dims, face_combo.currentText(), y_mode(),
+                _parse(edit_y, current_y), _parse(edit_d, current_d),
+                _parse(edit_x, current_x), is_slot,
+                (_parse(edit_len, current_len) if is_slot else 0.0),
+                (axis_radio.checkedId() if axis_radio is not None else 0),
+                check_sym.isChecked(), check_top.isChecked())
+
+        def rebuild_preview():
+            app._mark_dirty(f, refresh=True)
+            if index >= 0:
+                o = dict(overrides)
+                o[index] = collect()
+                app.hole_overrides[f['hash']] = o
+            else:
+                lst = list(app.added_holes.get(f['hash'], []))
+                i = -index - 1
+                if 0 <= i < len(lst):
+                    lst[i] = collect()
+                    app.added_holes[f['hash']] = lst
+            app._refresh_viewers(f, preserve_view=True)
+
+        grid = QGridLayout()
