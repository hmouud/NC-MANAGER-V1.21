+    def test_2d_label_rect_centered_on_midpoint(self):
+        w = NcViewer()
+        w.resize(800, 500)
+        w.set_geometry_object(MULTI_FACE)
+        w.grab()  # ensure the screen transform is computed
+        a = QPointF(300.0, 325.0)
+        b = QPointF(3300.0, 325.0)
+        rect, label = w._measure_label_rect(a, b)
+        s1 = w._to_screen(a.x(), a.y())
+        s2 = w._to_screen(b.x(), b.y())
