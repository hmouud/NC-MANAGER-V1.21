+class TestEdgeDistance(unittest.TestCase):
+    """Rule 1: e >= 1.2 * d from all edges."""
+
+    def test_hole_at_center_passes(self):
+        """Hole at center of IPE360 face v should pass."""
+        feat = {'x': 1500, 'y': 180, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertTrue(res.is_valid, msg=res.error_message)
+
+    def test_hole_too_close_to_x_start(self):
+        """Hole X too close to start (X=0)."""
+        # IPE360 face v width = 360mm, so y=180 is center
+        # req = 1.2 * 22 = 26.4
+        feat = {'x': 20, 'y': 180, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_X_MIN)
+        self.assertIn('min X = 26.4', res.error_message)
+
+    def test_hole_too_close_to_x_end(self):
+        """Hole X too close to end (X=Length)."""
+        feat = {'x': 2980, 'y': 180, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_X_MAX)
+
+    def test_hole_too_close_to_y_bottom(self):
+        """Hole Y too close to bottom edge (Y=0)."""
+        feat = {'x': 1500, 'y': 20, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_Y_MIN)
+
+    def test_hole_too_close_to_y_top(self):
+        """Hole Y too close to top edge (Y=FaceWidth)."""
+        # IPE360 face v width = 360, req = 26.4, max y = 333.6
+        feat = {'x': 1500, 'y': 340, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_Y_MAX)
+
+    def test_edge_factor_calculation(self):
+        """Verify the 1.2x factor is correct."""
+        d = 20
+        req = EDGE_FACTOR * d  # 24.0
+        # SHS100x5 face v width = 100, so y must be in [24, 76]
+        # Hole at exactly req should PASS (>=)
+        feat = {'x': req, 'y': 50, 'd': d, 'kind': 'hole'}
+        res = validate_feature(feat, 'SHS100x5', 1000, 'v')
+        self.assertTrue(res.is_valid, msg=f"Should pass at boundary: {res.error_message}")
+
+        # Hole at req - epsilon should FAIL
+        feat = {'x': req - 0.1, 'y': 50, 'd': d, 'kind': 'hole'}
+        res = validate_feature(feat, 'SHS100x5', 1000, 'v')
+        self.assertFalse(res.is_valid)
+
+
+class TestFaceBoundaries(unittest.TestCase):
+    """Rule 2: Hole circle fully inside face rectangle.
+
+    Note: Edge distance check (Rule 1) runs first and is stricter,
+    so boundary violations are caught by edge distance first.
+    """
+
+    def test_hole_exceeds_length(self):
+        """Hole exceeds part length in X - caught by edge distance."""
+        feat = {'x': 3010, 'y': 180, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_X_MAX)
+
+    def test_hole_exceeds_width(self):
+        """Hole exceeds face width in Y - caught by edge distance."""
+        feat = {'x': 1500, 'y': 370, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_Y_MAX)
+
+    def test_hole_negative_coordinates(self):
+        """Hole with negative coordinates fails."""
+        feat = {'x': -10, 'y': 180, 'd': 22, 'kind': 'hole'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_X_MIN)
+
+
+class TestSlotBoundaries(unittest.TestCase):
+    """Rule 3: Slots must stay entirely within face boundaries."""
+
+    def test_horizontal_slot_at_center(self):
+        """Horizontal slot (angle=0) at center passes."""
+        feat = {'x': 1500, 'y': 180, 'd': 12, 'length': 60, 'angle': 0, 'kind': 'slot'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertTrue(res.is_valid, msg=res.error_message)
+
+    def test_vertical_slot_at_center(self):
+        """Vertical slot (angle=90) at center passes."""
+        feat = {'x': 1500, 'y': 180, 'd': 12, 'length': 60, 'angle': 90, 'kind': 'slot'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertTrue(res.is_valid, msg=res.error_message)
+
+    def test_slot_exceeds_length(self):
+        """Long horizontal slot exceeds part length."""
+        # Slot length 3100 on 3000 part, centered -> extends beyond
+        feat = {'x': 1500, 'y': 180, 'd': 12, 'length': 3100, 'angle': 0, 'kind': 'slot'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.SLOT_OUT_OF_BOUNDS)
+
+    def test_angled_slot_near_corner(self):
+        """45-degree slot near corner exceeds bounds - caught by edge distance."""
+        # Place very close to corner with long slot
+        feat = {'x': 10, 'y': 10, 'd': 12, 'length': 200, 'angle': 45, 'kind': 'slot'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        # Edge distance catches this first (stricter than slot boundary)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_X_MIN)
+
+    def test_slot_invalid_length(self):
+        """Slot length must be > width."""
+        feat = {'x': 500, 'y': 180, 'd': 12, 'length': 10, 'angle': 0, 'kind': 'slot'}
+        res = validate_feature(feat, 'IPE360', 3000, 'v')
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.INVALID_GEOMETRY)
+
+
+class TestMultiFeatureValidation(unittest.TestCase):
+    """validate_all_features and helpers."""
+
+    def test_collect_all_errors(self):
+        """Multiple features - all validated independently."""
+        feats = [
+            {'x': 20, 'y': 180, 'd': 22, 'kind': 'hole'},      # X-min fail
+            {'x': 1500, 'y': 180, 'd': 22, 'kind': 'hole'},    # OK
+            {'x': 2980, 'y': 180, 'd': 22, 'kind': 'hole'},    # X-max fail
+        ]
+        results = validate_all_features(feats, 'IPE360', 3000, 'v')
+        self.assertEqual(len(results), 3)
+        self.assertFalse(results[0].is_valid)
+        self.assertTrue(results[1].is_valid)
+        self.assertFalse(results[2].is_valid)
+
+    def test_first_error_returns_first_fail(self):
+        """first_error helper returns first failing result."""
+        from nccorrection.core.safety_engine import first_error
+        feats = [
+            {'x': 1500, 'y': 180, 'd': 22, 'kind': 'hole'},    # OK
+            {'x': 20, 'y': 180, 'd': 22, 'kind': 'hole'},      # X-min fail
+            {'x': 2980, 'y': 180, 'd': 22, 'kind': 'hole'},    # X-max fail
+        ]
+        results = validate_all_features(feats, 'IPE360', 3000, 'v')
+        err = first_error(results)
+        self.assertIsNotNone(err)
+        self.assertEqual(err.feature_index, 1)
+        self.assertEqual(err.error_code, ErrorCode.EDGE_DISTANCE_X_MIN)
+
+
+class TestFaceWidths(unittest.TestCase):
+    """Verify face width calculations match file_factory."""
+
+    def test_ipe360_faces(self):
+        """IPE360: v/h=360, o/u=170 (flange width)."""
+        self.assertEqual(get_face_width_mm('IPE360', 'v', 3000), 360)
+        self.assertEqual(get_face_width_mm('IPE360', 'h', 3000), 360)
+        self.assertEqual(get_face_width_mm('IPE360', 'o', 3000), 170)
+        self.assertEqual(get_face_width_mm('IPE360', 'u', 3000), 170)
+
+    def test_shs100x5_faces(self):
+        """SHS100x5: v/h=100 (outer dim)."""
+        self.assertEqual(get_face_width_mm('SHS100x5', 'v', 3000), 100)
+        self.assertEqual(get_face_width_mm('SHS100x5', 'h', 3000), 100)
+
+    def test_plate_faces(self):
+        """PL10: v/h=1250 (plate width)."""
+        self.assertEqual(get_face_width_mm('PL10', 'v', 3000), 1250)
+        self.assertEqual(get_face_width_mm('PL10', 'h', 3000), 1250)
+
+
+class TestValidationResult(unittest.TestCase):
+    """ValidationResult dataclass behavior."""
+
+    def test_ok_factory(self):
+        res = ValidationResult.ok()
+        self.assertTrue(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.OK)
+
+    def test_fail_factory(self):
+        res = ValidationResult.fail(ErrorCode.EDGE_DISTANCE_X_MIN, "test msg", 5)
+        self.assertFalse(res.is_valid)
+        self.assertEqual(res.error_code, ErrorCode.EDGE_DISTANCE_X_MIN)
+        self.assertEqual(res.error_message, "test msg")
+        self.assertEqual(res.feature_index, 5)
+
+
+if __name__ == '__main__':
+    unittest.main()
