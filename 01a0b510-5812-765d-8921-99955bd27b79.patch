+        self.v.set_fold_state({'show_line': False, 'fold': False})
+        self.assertAlmostEqual(self._zmax(), folded - 500.0, delta=10.0)
+
+    def test_shared_show_line_does_not_touch_model(self):
+        model_ref = self.v._model
+        self.v.set_fold_state({'show_line': True, 'fold': False})
+        self.assertIs(self.v._model, model_ref)
+
