@@ -0,0 +1,236 @@
+"""ProjectMixin — project open / save / load logic extracted from NCManagerApp.
+
+Kept as a mixin so that app.py stays manageable while the project
+domain methods remain on the same ``self`` and require zero call-site
+changes.
+"""
+
+import os
+
+from PySide6.QtWidgets import (
+    QApplication,
+    QDialog,
+    QHBoxLayout,
+    QLabel,
+    QLineEdit,
+    QListWidget,
+    QMessageBox,
+    QPushButton,
+    QVBoxLayout,
+    QProgressDialog,
+)
+from PySide6.QtCore import Qt
+
+from nccorrection.core.classifier import classify_text
+from nccorrection.core.order_utils import _extract_order
+
+
+class ProjectMixin:
+    """Project-management helpers mixed into NCManagerApp."""
+
+    # ---------------------------------------------------------------- project
+    def _project_name_from_files(self):
+        for f in self.files:
+            d = os.path.basename(os.path.dirname(os.path.abspath(f['path'])))
+            if d and d not in ('input', 'projects', 'sorted'):
+                return d
+        return ''
+
+    def _save_project_dialog(self):
+        if not self.files:
+            self._set_status(self.tr_('add_first'))
+            return
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('save_project'))
+        dlg.resize(440, 200)
+        v = QVBoxLayout(dlg)
+        v.addWidget(QLabel(self.tr_('project_name') + ':', dlg))
+        name_edit = QLineEdit(self._current_project or self._project_name_from_files(), dlg)
+        v.addWidget(name_edit)
+        hint = QLabel(self.tr_('project_default_hint'), dlg)
+        hint.setStyleSheet(f'color:{self._theme["mut"]};')
+        v.addWidget(hint)
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        btns.addWidget(cancel)
+        save = QPushButton(self.tr_('save'), dlg)
+        save.setObjectName('green')
+        save.clicked.connect(dlg.accept)
+        btns.addWidget(save)
+        v.addLayout(btns)
+        if dlg.exec() != QDialog.Accepted:
+            return
+        pname = (name_edit.text() or '').strip()
+        if not pname:
+            pname = self._project_name_from_files() or 'project'
+        source = self._project_source_folder()
+        self.projects.save_project(
+            pname, self.files,
+            settings={k: self.settings.get(k) for k in
+                      ('language', 'theme', 'outputName', 'themeCustom')},
+            notes=dict(self.settings.get_all_notes() or {}),
+            hole_overrides=self.hole_overrides,
+            hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+            added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+            qty_overrides={h: f.get('qty_override') for f in self.files
+                           for h in [f['hash']] if f.get('qty_override') is not None},
+            source_folder=source,
+            orders=self.orders)
+        self._current_project = pname
+        self.settings.set('last_project', pname)
+        self.settings.save()
+        self._saved_hashes = {f['hash'] for f in self.files}
+        self._session_added.clear()
+        self._settings_dirty = False
+        self._set_status(self.tr_('project_saved') + ': ' + pname)
+        self.audit.log(f'Project saved: {pname}', 'ok', 'OK-500')
+
+    def _project_source_folder(self):
+        if self._current_project:
+            m = self.projects.load_project(self._current_project)
+            if m and m.get('source_folder'):
+                return m['source_folder']
+        return self._project_name_from_files()
+
+    def _open_project_dialog(self):
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('open_project'))
+        dlg.resize(620, 400)
+        v = QVBoxLayout(dlg)
+        lst = QListWidget(dlg)
+        projects = self.projects.list_projects()
+        if not projects:
+            lst.addItem(self.tr_('project_none'))
+            lst.setEnabled(False)
+        else:
+            for p in projects:
+                label = (f"{p['name']}  ({p['file_count']} "
+                         f"{self.tr_('total').lower()})  {p['updated']}")
+                lst.addItem(label)
+                lst.item(lst.count() - 1).setData(Qt.UserRole, p['name'])
+        v.addWidget(lst, 1)
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        if self.files:
+            clear_info = QLabel(self.tr_('project_confirm_clear'), dlg)
+            clear_info.setStyleSheet(f'color:{self._theme["mut"]};')
+            v.insertWidget(0, clear_info)
+        open_btn = QPushButton(self.tr_('project_open'), dlg)
+        open_btn.setObjectName('green')
+        open_btn.setEnabled(bool(projects))
+        btns.addWidget(open_btn)
+        del_btn = QPushButton(self.tr_('project_delete'), dlg)
+        del_btn.setObjectName('red')
+        del_btn.setEnabled(bool(projects))
+        btns.addWidget(del_btn)
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        btns.addWidget(cancel)
+        v.addLayout(btns)
+
+        def do_open():
+            if self.files and QMessageBox.question(
+                    self, self.tr_('open_project'), self.tr_('project_confirm_clear')) != QMessageBox.Yes:
+                return
+            item = lst.currentItem()
+            if not item or item.data(Qt.UserRole) is None:
+                return
+            pname = item.data(Qt.UserRole)
+            self._load_project(pname)
+            dlg.accept()
+
+        def do_delete():
+            item = lst.currentItem()
+            if not item or item.data(Qt.UserRole) is None:
+                return
+            pname = item.data(Qt.UserRole)
+            if QMessageBox.question(self, self.tr_('project_delete'),
+                                    f"{self.tr_('project_delete')} '{pname}'?") != QMessageBox.Yes:
+                return
+            self.projects.delete_project(pname)
+            dlg.reject()
+            self._open_project_dialog()
+
+        open_btn.clicked.connect(do_open)
+        del_btn.clicked.connect(do_delete)
+        dlg.exec()
+
+    def _load_project(self, pname):
+        # Late imports to avoid circular dependency.
+        from nccorrection.ui._metrics import extract_steel as _extract_steel, part_metrics as _part_metrics
+
+        manifest, records = self.projects.load_files(pname)
+        if manifest is None:
+            return
+        self.files = []
+        existing_hashes = set()
+        total = len(records)
+        progress = None
+        if total > 40:
+            progress = QProgressDialog(self.tr_('loading'), self.tr_('cancel'),
+                                       0, total, self)
+            progress.setWindowModality(Qt.WindowModal)
+            progress.setMinimumDuration(400)
+            progress.setValue(0)
+        for i, rec in enumerate(records):
+            if progress is not None:
+                progress.setValue(i)
+                QApplication.processEvents()
+                if progress.wasCanceled():
+                    break
+            text = rec.get('text', '')
+            c = classify_text(text, rec.get('name') or '')
+            self.files.append({
+                'name': rec.get('name') or os.path.basename(rec.get('path', '')),
+                'path': rec['path'], 'text': text, 'hash': rec.get('hash', ''),
+                'category': rec.get('category') or c['category'],
+                'family': rec.get('family') or c['family'],
+                'profile': rec.get('profile') or c['profile'],
+                'folder': rec.get('folder') or c['folder'],
+                'status': self.tr_('ready'),
+                'qty': rec.get('qty'), 'qty_override': rec.get('qty_override'),
+                'o': rec.get('o'), 'si': rec.get('si'),
+                'size': os.path.getsize(rec['path']) if os.path.isfile(rec['path']) else 0,
+                'modified': os.path.getmtime(rec['path']) if os.path.isfile(rec['path']) else 0,
+                'steel': rec.get('steel') or _extract_steel(text),
+                'quality': rec.get('quality') or _extract_steel(text),
+                'order': rec.get('order') or _extract_order(text), 'dirty': bool(rec.get('dirty')),
+                'length_mm': rec.get('length_mm') or _part_metrics(text)[0],
+                'weight': rec.get('weight') or round(_part_metrics(text)[1], 2),
+            })
+            existing_hashes.add(rec.get('hash', ''))
+        if progress is not None:
+            progress.setValue(total)
+            progress.close()
+        self.selected.clear()
+        self.hole_overrides = {h: dict(o) for h, o in
+                               (manifest.get('hole_overrides') or {}).items()}
+        self.hole_deleted = {h: set(s) for h, s in
+                             (manifest.get('hole_deleted') or {}).items()}
+        self.added_holes = {h: list(lst) for h, lst in
+                            (manifest.get('added_holes') or {}).items()}
+        self._undo_stack.clear()
+        self._redo_stack.clear()
+        self._current_project = pname
+        # P5: restore empty orders (order names with zero files) alongside the
+        # orders found in the loaded file records.
+        self.orders = list(manifest.get('orders') or [])
+        self.settings.set('last_project', pname)
+        # P2: this session starts clean (no tint); committed baseline = loaded
+        # hashes; persistent dirty recomputed from the restored overrides.
+        self._session_edited = set()
+        self._saved_hashes = {f['hash'] for f in self.files}
+        self._settings_dirty = False
+        for f in self.files:
+            f['dirty'] = self._file_dirty(f)
+        notes = manifest.get('notes') or {}
+        for h, note in notes.items():
+            self.settings.set_note(h, note)
+        self._render_table()
+        self._refresh_order_combo()
+        self._update_details()
+        self._set_status(self.tr_('project_loaded') + ': ' + pname)
+        self.audit.log(f'Project opened: {pname}', 'ok', 'OK-501')
+        self._prompt_assign_orders()
