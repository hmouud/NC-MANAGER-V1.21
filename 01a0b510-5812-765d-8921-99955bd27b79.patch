+"""face_builder.py — Build points for one face.
+
+🚨 GUARDIAN LAW: Single responsibility — face points فقط.
+ما كايحتويش على cuts (هادشي ف interpreters).
+ما كايحتويش على notches (هادشي ف detectors).
+"""
+from __future__ import annotations
+from typing import List
+
+from ..core.enums import Face, PointSuffix
+from ..geometry.dimensions import ProfileDimensions
+from ..models.contour_point import ContourPoint
+from .base_builder import BaseBuilder
+
+
+class FaceBuilder(BaseBuilder):
+    """كايبني نقاط وجه واحد من الـ Base Geometry (بلا cuts و لا notches)."""
+
+    def __init__(self, face: Face, dims: ProfileDimensions):
+        super().__init__()
+        self.face = face
+        self.d = dims
+
+    def _build_impl(self) -> List[ContourPoint]:
+        """كايبني النقاط الأساسية للوجه (مستطيل بسيط)."""
+        length = self.d.length
+        width = self._get_width()
+
+        first = ContourPoint(x=0.0, y=0.0, face=self.face, suffix=PointSuffix.S)
+        second = ContourPoint(x=length, y=0.0, face=self.face, suffix=PointSuffix.U)
+        third = ContourPoint(x=length, y=width, face=self.face, suffix=PointSuffix.U)
+        fourth = ContourPoint(x=0.0, y=width, face=self.face, suffix=PointSuffix.U)
+
+        return [first, second, third, fourth]
+
+    def _get_width(self) -> float:
+        """كايرجع عرض الوجه من الأبعاد."""
+        if self.face == Face.V:
+            return self.d.H
+        if self.face in (Face.O, Face.U):
+            return self.d.b
+        if self.face == Face.H:
+            return self.d.H
+        return 0.0
+
+    def _validate(self) -> bool:
+        return bool(self._result) and len(self._result) >= 4
