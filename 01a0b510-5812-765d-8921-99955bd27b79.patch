+class TestGlobalSettings(unittest.TestCase):
+    """F2 -- face-name display mode is a GLOBAL setting on every viewer."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_2d_badge_label_modes(self):
