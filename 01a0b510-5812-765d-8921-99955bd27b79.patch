@@ -0,0 +1,272 @@
+"""OrganizeMixin — extracted organize-folder UI logic from NCManagerApp.
+
+Provides the popup, preview, and run methods that let users sort imported
+NC files into a project folder tree (move / copy / delete originals).
+"""
+
+import os
+
+from PySide6.QtWidgets import (
+    QButtonGroup,
+    QFileDialog,
+    QDialog,
+    QGroupBox,
+    QHBoxLayout,
+    QLabel,
+    QLineEdit,
+    QMessageBox,
+    QPushButton,
+    QRadioButton,
+    QTextEdit,
+    QVBoxLayout,
+)
+
+from nccorrection.core.organizer import (
+    execute_plan,
+    plan_conflicts,
+    plan_sort,
+    plan_summary,
+    summarize_results,
+)
+
+
+class OrganizeMixin:
+    """Mixin that supplies the organize-folder feature for NCManagerApp."""
+
+    # ------------------------------------------------------------------
+    # Popup entry point
+    # ------------------------------------------------------------------
+
+    def _show_organize_popup(self):
+        if not self.files:
+            self._set_status(self.tr_('organize_blocked_none'))
+            self._toast(self.tr_('organize_blocked_none'), title=self.tr_('organize'))
+            return
+        targets = ([self.files[i] for i in sorted(self.selected)] if self.selected
+                   else list(self.files))
+        dlg = self._build_organize_popup(targets)
+        self._organize_plan_preview_lines(dlg, targets)
+        dlg.exec()
+
+    # ------------------------------------------------------------------
+    # Dialog construction
+    # ------------------------------------------------------------------
+
+    def _build_organize_popup(self, targets):
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('sort_into_folders'))
+        dlg.resize(560, 480)
+        v = QVBoxLayout(dlg)
+        v.setContentsMargins(10, 10, 10, 10)
+        v.setSpacing(8)
+
+        scope = QLabel(
+            f"{len(targets)}/{len(self.files)} {self.tr_('organize_scope')}", dlg)
+        scope.setObjectName('mut')
+        v.addWidget(scope)
+
+        dest_box = QGroupBox(self.tr_('destination'), dlg)
+        dv = QVBoxLayout(dest_box)
+        self.organize_dest_output = QRadioButton(
+            self.tr_('dest_docs_output'), dlg)
+        self.organize_dest_output.setChecked(True)
+        self.organize_dest_same = QRadioButton(
+            self.tr_('dest_same_folder'), dlg)
+        self.organize_dest_custom = QRadioButton(
+            self.tr_('dest_custom'), dlg)
+        for rb in (self.organize_dest_output, self.organize_dest_same,
+                   self.organize_dest_custom):
+            dv.addWidget(rb)
+        self.organize_dest_group = QButtonGroup(dlg)
+        self.organize_dest_group.addButton(self.organize_dest_output, 1)
+        self.organize_dest_group.addButton(self.organize_dest_same, 2)
+        self.organize_dest_group.addButton(self.organize_dest_custom, 3)
+        custom_row = QHBoxLayout()
+        self.organize_custom_path = QLineEdit(
+            self.settings.get('outputPath', '') or '', dlg)
+        custom_row.addWidget(self.organize_custom_path, 1)
+        browse = QPushButton('...', dlg)
+        browse.setFixedWidth(32)
+        browse.clicked.connect(
+            lambda: self._pick_organize_path(self.organize_custom_path))
+        custom_row.addWidget(browse)
+        dv.addLayout(custom_row)
+        self.organize_custom_path.setEnabled(False)
+        browse.setEnabled(False)
+
+        def on_dest(btn_id):
+            custom = btn_id == 3
+            self.organize_custom_path.setEnabled(custom)
+            browse.setEnabled(custom)
+
+        self.organize_dest_group.idClicked.connect(on_dest)
+        v.addWidget(dest_box)
+
+        name_row = QHBoxLayout()
+        name_row.addWidget(QLabel(self.tr_('project_name') + ':', dlg))
+        self.organize_project_edit = QLineEdit('', dlg)
+        self.organize_project_edit.setPlaceholderText(self.tr_('organize_project_hint'))
+        name_row.addWidget(self.organize_project_edit, 1)
+        v.addLayout(name_row)
+
+        orig_box = QGroupBox(self.tr_('original_files'), dlg)
+        ov = QVBoxLayout(orig_box)
+        self.organize_delete_rb = QRadioButton(self.tr_('delete_sources'), dlg)
+        self.organize_keep_rb = QRadioButton(self.tr_('keep_sources'), dlg)
+        self.organize_keep_rb.setChecked(True)
+        self.organize_orig_group = QButtonGroup(dlg)
+        self.organize_orig_group.addButton(self.organize_delete_rb, 1)
+        self.organize_orig_group.addButton(self.organize_keep_rb, 2)
+        ov.addWidget(self.organize_keep_rb)
+        ov.addWidget(self.organize_delete_rb)
+        v.addWidget(orig_box)
+
+        self.organize_plan = QTextEdit(dlg)
+        self.organize_plan.setReadOnly(True)
+        self.organize_plan.setMinimumHeight(90)
+        v.addWidget(self.organize_plan)
+
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        preview = QPushButton(self.tr_('preview_plan'), dlg)
+        preview.clicked.connect(lambda: self._organize_preview(dlg, targets))
+        btns.addWidget(preview)
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        btns.addWidget(cancel)
+        run = QPushButton(self.tr_('organize'), dlg)
+        run.setObjectName('green')
+        run.clicked.connect(lambda: self._organize_run(dlg, targets))
+        btns.addWidget(run)
+        v.addLayout(btns)
+
+        return dlg
+
+    # ------------------------------------------------------------------
+    # Destination helpers
+    # ------------------------------------------------------------------
+
+    def _pick_organize_path(self, edit):
+        start = edit.text().strip() or os.path.expanduser('~')
+        d = QFileDialog.getExistingDirectory(self, self.tr_('output_name'), start)
+        if d:
+            edit.setText(os.path.normpath(d))
+
+    def _organize_destination(self, targets):
+        """Return the resolved destination base folder for the current popup
+        state, or None when the user picked a custom path that is empty."""
+        if self.organize_dest_group.checkedId() == 2:
+            base = self._common_parent(targets)
+        elif self.organize_dest_group.checkedId() == 3:
+            base = self.organize_custom_path.text().strip()
+            if not base:
+                return None
+        else:
+            base = os.path.join(os.path.expanduser('~'), 'Documents',
+                                'NC MANAGER 1.V21', 'OUTPUT')
+        project = self.organize_project_edit.text().strip()
+        if project:
+            base = os.path.join(base, project)
+        return base
+
+    def _organize_delete_original(self):
+        return self.organize_orig_group.checkedId() == 1
+
+    # ------------------------------------------------------------------
+    # Preview / plan
+    # ------------------------------------------------------------------
+
+    def _organize_plan_preview_lines(self, dlg, targets):
+        """Fill the popup plan area based on current controls (non destructive)."""
+        destination = self._organize_destination(targets)
+        if not destination:
+            self.organize_plan.setPlainText('')
+            return
+        delete_original = self._organize_delete_original()
+        plan = plan_sort(targets, destination, delete_original=delete_original)
+        conflicts = plan_conflicts(plan)
+        if conflicts:
+            self.organize_plan.setPlainText(
+                '\n'.join('\u26a0 ' + c for c in conflicts))
+            return
+        lines = []
+        for p in plan:
+            if p['action'] == 'SKIP_ALREADY':
+                lines.append(f"\u2714 {p['name']} -> already in target folder")
+            elif p['action'] == 'SKIP_DUPLICATE':
+                lines.append(f"\u21bb {p['name']} -> duplicate in destination")
+            else:
+                verb = self.tr_('opt_move') if p['action'] == 'MOVE' else self.tr_('opt_copy')
+                lines.append(f"{'->' if p['action'] == 'MOVE' else '+'} {p['name']} "
+                             f"-> {p['folder']}/{p['dest_name']}  ({verb})")
+        self.organize_plan.setPlainText('\n'.join(lines) if lines
+                                        else self.tr_('organize_plan_empty'))
+
+    def _organize_preview(self, dlg, targets):
+        self._organize_plan_preview_lines(dlg, targets)
+
+    # ------------------------------------------------------------------
+    # Execute
+    # ------------------------------------------------------------------
+
+    def _organize_run(self, dlg, targets):
+        destination = self._organize_destination(targets)
+        if not destination:
+            self._set_status(self.tr_('organize_conflict'))
+            self._toast(self.tr_('organize_conflict'), kind='warn',
+                        title=self.tr_('organize'))
+            return
+        delete_original = self._organize_delete_original()
+        plan = plan_sort(targets, destination, delete_original=delete_original)
+        conflicts = plan_conflicts(plan)
+        if conflicts:
+            detail = '\n'.join('\u26a0 ' + c for c in conflicts)
+            self._set_status(self.tr_('organize_conflict'))
+            self.audit.log(f'Organize blocked: {len(conflicts)} conflict(s)', 'error', 'ERR-320')
+            self._toast(f"{self.tr_('organize_conflict')}\n\n{detail}", kind='error',
+                        title=self.tr_('organize'))
+            return
+        moved, dup, already, _ = plan_summary(plan)
+        if moved == 0:
+            self.organize_plan.setPlainText(self.tr_('organize_plan_empty'))
+            self._set_status(self.tr_('organize_plan_empty'))
+            return
+        if delete_original:
+            ret = QMessageBox.question(
+                self, self.tr_('organize'), self.tr_('organize_confirm_delete'),
+                QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
+            if ret != QMessageBox.Yes:
+                return
+        self.settings.set('outputName', self.organize_project_edit.text().strip() or 'output')
+        self.settings.set('organizeOriginalAction',
+                          'DELETE' if delete_original else 'KEEP')
+        if self.organize_dest_group.checkedId() == 3:
+            self.settings.set('outputPath', self.organize_custom_path.text().strip())
+        results = execute_plan(plan)
+        errors = [r for r in results if not r['ok']]
+        summary = summarize_results(results)
+        self._set_status(summary)
+        if errors:
+            self.audit.log(f'Organize: {len(results) - len(errors)} ok, '
+                           f'{len(errors)} failed', 'error', 'ERR-320')
+        else:
+            self.audit.log(f'Organize: {summary}', 'ok', 'OK-320')
+        if delete_original:
+            self.files = [f for f in self.files if f not in targets]
+            self.selected.clear()
+        self._render_table()
+        self._update_details()
+        self._toast(summary, kind='success', title=self.tr_('organize_done'))
+
+    # ------------------------------------------------------------------
+    # Utility
+    # ------------------------------------------------------------------
+
+    def _common_parent(self, files):
+        dirs = {os.path.dirname(os.path.abspath(f['path'])) for f in files}
+        if len(dirs) == 1:
+            return next(iter(dirs))
+        try:
+            return os.path.dirname(os.path.commonpath(list(dirs)))
+        except ValueError:
+            return os.path.expanduser('~')
