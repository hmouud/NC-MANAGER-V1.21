+class DualFlatSidedCircleShape(PlateShape):
+    """Circle with two pairs of flats (cross flats)."""
+    name = "Dual Flat Sided Circle"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Radius", "radius", 100.0, 5.0, 5000.0),
+        ShapeParam("H1 distance", "h1_dist", 160.0, 1.0, 10000.0),
+        ShapeParam("H2 distance", "h2_dist", 160.0, 1.0, 10000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["radius"]
+        h1 = min(p["h1_dist"], R * 2)
+        h2 = min(p["h2_dist"], R * 2)
+        # Start with circle, clip horizontal flats at ±h1/2 and vertical flats at ±h2/2
+        # Use polygon approximation and clip
+        n = 128
+        raw = []
+        for i in range(n):
+            a = 2 * math.pi * i / n
+            x, y = R * math.cos(a), R * math.sin(a)
+            # Clamp to flats
+            y = max(-h1 / 2, min(h1 / 2, y))
+            x = max(-h2 / 2, min(h2 / 2, x))
+            raw.append((x, y))
+        # Remove near-duplicate consecutive points
+        outer = [raw[0]]
+        for pt in raw[1:]:
+            dx = pt[0] - outer[-1][0]
+            dy = pt[1] - outer[-1][1]
+            if dx * dx + dy * dy > 0.01:
+                outer.append(pt)
+        return ShapeResult(outer=outer)
+
