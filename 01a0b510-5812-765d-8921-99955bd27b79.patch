+
+    # ---------------------------------------------------------------- modes
+    def set_mode(self, mode):
+        self.mode = mode
+        if mode != 'measure':
+            self._m1 = self._m2 = None
+            self._corner_pts = []
+            self.measure_result.emit('')
+        self.setCursor(Qt.CrossCursor if mode == 'measure' else Qt.ArrowCursor)
+        self.update()
+
+    def set_corner_mode(self, on):
+        """Corner-angle measure: click a point on one edge, the vertex, then a
+        point on the other edge; the tool reports the angle (<= 90 / > 90)."""
+        self._corner_mode = bool(on)
+        self._corner_pts = []
+        self.update()
+
+    # ---------------------------------------------------------------- transform
+    def _to_screen(self, x, y):
+        if self._foreshorten is not None:
+            x = self._foreshorten.map_real_to_screen(x)
+        return self._ox + self._pan_ox + x * self._scale * self._zoom, \
+               self._oy + self._pan_oy - y * self._scale * self._zoom
+
+    def _to_scene(self, sx, sy):
+        x = (sx - self._ox - self._pan_ox) / (self._scale * self._zoom)
+        if self._foreshorten is not None:
+            x = self._foreshorten.map_screen_to_real(x)
+        return x, (self._oy + self._pan_oy - sy) / (self._scale * self._zoom)
+
+    def set_foreshorten(self, mapping):
+        """Attach a Smart Foreshortening mapping (or ``None`` to disable).
+
+        While a mapping is attached every raw screen X is pushed through
+        ``map_screen_to_real()`` inside :meth:`_to_scene` -- which is the
+        single transform feeding the measure tool -- BEFORE any OSNAP or
+        distance calculation, so measuring across a cut void returns the
+        true DSTV distance. Rendering mirrors it through
+        ``map_real_to_screen()`` in :meth:`_to_screen`.
+        """
+        self._foreshorten = mapping
+        self._snap_targets = self._build_snap_targets()
+        self.update()
+
+    def _scene_pt(self, pos):
+        return self._to_scene(pos.x(), pos.y())
+
+    # ---------------------------------------------------------------- paint
+    # PySide6 C++ trampolines only dispatch virtual methods found in the
+    # immediate class dict, so paintEvent must live here.  The real painting
+    # logic resides in _ViewerPaintMixin._paint_impl.
+    def paintEvent(self, event):
+        return self._paint_impl(event)
+
+    # ---------------------------------------------------------------- events
+    def wheelEvent(self, event):
+        # AutoCAD-style adaptive zoom: coarse steps while zoomed out, very
+        # fine steps when deep in (2% at the top) for precise framing.
+        z = self._zoom
+        if z < 8.0:
+            step = 0.12
+        elif z < 40.0:
+            step = 0.06
+        else:
+            step = 0.02
+        factor = 1.0 + step if event.angleDelta().y() > 0 else 1.0 - step
+        pos = event.position()
+        anchor_scene = self._to_scene(pos.x(), pos.y())
+        self._zoom = max(0.02, min(self._zoom * factor, 200.0))
+        # keep the scene point under the cursor anchored after zoom
+        sx, sy = self._to_screen(*anchor_scene)
+        self._pan_ox += pos.x() - sx
+        self._pan_oy += pos.y() - sy
+        self.update()
+        event.accept()
+
+    def mousePressEvent(self, event):
+        if self.mode == 'measure':
+            if event.button() == Qt.RightButton:
+                if self._m1 is not None:
+                    self._m1 = None # Interruption/Cancel current measure point
+                    self._hover_pt = None
+                    self.update()
+                return # Consume the event
+            if event.button() == Qt.LeftButton:
+                # drag an existing measurement label (Tekla-style repositioning)
+                for i, (a, bpt, off, dim_off) in enumerate(self._measurements):
+                    if self._measure_label_rect(a, bpt, off, dim_off)[0].contains(event.position()):
+                        self._label_drag = i
+                        self._drag_pos = event.position()
+                        return
+                # press ON the dimension line itself -> parallel drag
+                # (Tekla/AutoCAD style: the whole dimension moves, keeping the
+                # measured points and value; long extension lines appear)
+                hit = self._measure_line_at(event.position())
+                if hit is not None:
+                    self._dim_drag = hit
+                    self._drag_pos = event.position()
+                    return
+                pt, kind = self._snap_detail(event.position())
+                if pt is None:
+                    return
+
+                # Circle diameter dimension mode (AutoCAD-style two-click)
+                if getattr(self, '_measure_submode', 'aligned') == 'diameter':
+                    if self._circle_first_click is None:
+                        circ = self._detect_circle_at(pt.x(), pt.y())
+                        if circ is not None:
+                            self._circle_first_click = circ
+                            self.measure_result.emit(f"Circle detected: \u00d8{circ[3]:.1f} mm. Click position to place dimension.")
+                        else:
+                            self.measure_result.emit("No circle detected under cursor. Click near hole rim.")
+                    else:
+                        cx, cy, r, d = self._circle_first_click
+                        self._diameter_measures.append((cx, cy, r, d, pt.x(), pt.y()))
+                        self.measure_result.emit(f"\u00d8{d:.1f} mm placed.")
+                        self._circle_first_click = None
+                    self.update()
+                    return
+
+                # Corner / angle dimension mode
+                if self._corner_mode or getattr(self, '_measure_submode', 'aligned') == 'angle':
+                    self._corner_pts.append((pt.x(), pt.y()))
+                    if len(self._corner_pts) == 3:
+                        a, vertex, b = self._corner_pts
+                        ang = corner_angle(a, vertex, b)
+                        self._corner_measures.append((a, vertex, b, ang))
+                        self.measure_result.emit(corner_label(ang))
+                        self._corner_pts = []
+                    self.update()
+                    return
+
+                # Linear modes: aligned, horizontal, vertical
+                if self._m1 is None:
+                    self._m1 = pt
+                    self._m2 = None
+                else:
+                    self._m2 = pt
+                    submode = getattr(self, '_measure_submode', 'aligned')
+                    self._measurements.append((self._m1, self._m2, (0.0, 0.0), 0.0, submode))
+                    if submode == 'horizontal':
+                        dx = abs(pt.x() - self._m1.x())
+                        label = f"H: {dx:.1f} mm"
+                    elif submode == 'vertical':
+                        dy = abs(pt.y() - self._m1.y())
+                        label = f"V: {dy:.1f} mm"
+                    else:
