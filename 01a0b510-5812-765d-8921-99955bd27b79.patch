+"""nc1_formatter.py — Format tokens with suffixes.
+
+🚨 GUARDIAN LAW: Single responsibility — formatting فقط.
+"""
+from __future__ import annotations
+from typing import Optional
+
+from ..core.enums import PointSuffix, Face
+from ..models.contour_point import ContourPoint
+
+
+_SUFFIX_TO_CHAR = {
+    PointSuffix.S: "s",
+    PointSuffix.U: "u",
+    PointSuffix.W: "w",
+    PointSuffix.T: "t",
+}
+
+
+def format_point(point: ContourPoint, precision: int = 2) -> str:
+    """كايفورماتي نقطة وحدة لسطر AK."""
+    face_char = point.face.value
+    x_str = _format_value(point.x, point.suffix, precision)
+    y_str = _format_value(point.y, None, precision)
+
+    cols = [point.bulge, point.angle, point.thickness, 0.0, 0.0]
+
+    parts = [
+        f"  {face_char}",
+        f"  {x_str}",
+        f"  {y_str}",
+    ] + [f"  {c:.{precision}f}" for c in cols]
+
+    return " ".join(parts)
+
+
+def _format_value(value: float, suffix: Optional[PointSuffix], precision: int) -> str:
+    """كايفورماتي قيمة مع الـ suffix (إلا كان)."""
+    num = f"{value:.{precision}f}"
+    if suffix is None:
+        return num
+    suffix_char = _SUFFIX_TO_CHAR.get(suffix, "")
+    return f"{num}{suffix_char}"
+
+
+def face_to_bo_op(face: Face) -> str:
+    """كايحوّل Face لـ op char ف BO block."""
+    mapping = {
+        Face.V: "v",
+        Face.O: "v",
+        Face.U: "v",
+        Face.H: "h",
+    }
+    return mapping.get(face, "v")
