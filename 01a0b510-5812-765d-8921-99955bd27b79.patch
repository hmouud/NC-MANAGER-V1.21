+        self.assertAlmostEqual(p.x, 3.0)
+        self.assertAlmostEqual(p.y, 4.0)
+
+    def test_distance(self):
+        a = Point2D(0, 0)
+        b = Point2D(3, 4)
+        self.assertAlmostEqual(a.distance_to(b), 5.0)
+
+    def test_angle_to(self):
+        a = Point2D(0, 0)
+        b = Point2D(10, 0)
+        self.assertAlmostEqual(a.angle_to(b), 0.0)
+        c = Point2D(0, 10)
+        self.assertAlmostEqual(a.angle_to(c), 90.0)
+
+    def test_offset(self):
+        p = Point2D(10, 20)
+        o = p.offset(5, -3)
+        self.assertAlmostEqual(o.x, 15.0)
+        self.assertAlmostEqual(o.y, 17.0)
+
+    def test_lerp(self):
+        a = Point2D(0, 0)
+        b = Point2D(10, 10)
+        m = a.lerp(b, 0.5)
