index 0000000..348ab55
--- /dev/null
+++ b/src/nccorrection/engine/drawing_tools/canvas/snap.py
@@ -0,0 +1,91 @@
+"""Snap logic — grid, endpoint, and circle snap for the drawing canvas.
+
+Extracted from DrawingCanvas so snap rules can be tested and tuned
+independently of the QGraphicsView widget.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Tuple
+
+from PySide6.QtCore import QPointF
+
+from .entities import DrawEntity, CircleEntity
+
+
+def snap_point(
+    pos: QPointF,
+    entities: List[DrawEntity],
+    *,
+    enabled: bool = True,
+    grid_snap: bool = True,
+    endpoint_snap: bool = True,
+    circle_snap: bool = True,
+    grid_spacing: float = 10.0,
+    snap_distance: float = 5.0,
+) -> QPointF:
+    """Return the snapped position for *pos* given the current entities.
+
+    Priority: closest candidate wins (grid / endpoint / circle centre /
+    circle edge / circle quadrant).  If nothing is within *snap_distance*
+    the original *pos* is returned unchanged.
+    """
+    if not enabled:
+        return pos
+
+    x, y = pos.x(), pos.y()
+    best = QPointF(x, y)
+    best_dist = snap_distance
+
+    # ── Grid snap ──────────────────────────────────────────────────
+    if grid_snap:
+        gx = round(x / grid_spacing) * grid_spacing
+        gy = round(y / grid_spacing) * grid_spacing
+        gd = math.hypot(x - gx, y - gy)
+        if gd < best_dist:
+            best = QPointF(gx, gy)
+            best_dist = gd
+
+    # ── Endpoint snap (lines + arcs) ───────────────────────────────
+    if endpoint_snap:
+        for ent in entities:
+            for pt in (ent.start_point(), ent.end_point()):
+                if pt is not None:
+                    d = math.hypot(x - pt[0], y - pt[1])
+                    if d < best_dist:
+                        best = QPointF(pt[0], pt[1])
+                        best_dist = d
+
+    # ── Circle snap: centre / edge / quadrant ──────────────────────
+    if circle_snap:
+        for ent in entities:
+            if not isinstance(ent, CircleEntity):
+                continue
+            cx, cy = ent.center
+            r = ent.radius
+
+            # Centre
+            d_center = math.hypot(x - cx, y - cy)
+            if d_center < best_dist:
+                best = QPointF(cx, cy)
+                best_dist = d_center
+
+            # Edge (nearest point on circumference)
+            d_edge = abs(d_center - r)
+            if d_edge < best_dist and d_center > 0.01:
+                angle = math.atan2(y - cy, x - cx)
+                best = QPointF(cx + r * math.cos(angle),
+                               cy + r * math.sin(angle))
+                best_dist = d_edge
+
+            # Quadrants (0, 90, 180, 270)
+            if d_center > 0.01:
+                for qa in (0, math.pi / 2, math.pi, 3 * math.pi / 2):
+                    qx = cx + r * math.cos(qa)
+                    qy = cy + r * math.sin(qa)
+                    dq = math.hypot(x - qx, y - qy)
+                    if dq < best_dist:
+                        best = QPointF(qx, qy)
+                        best_dist = dq
+
+    return best
diff --git a/src/nccorrection/engine/drawing_tools/canvas/widget.py b/src/nccorrection/engine/drawing_tools/canvas/widget.py
new file mode 100644
index 0000000..75bb8af
--- /dev/null
+++ b/src/nccorrection/engine/drawing_tools/canvas/widget.py
@@ -0,0 +1,739 @@
+"""Drawing canvas — QGraphicsView-based 2D editor for custom plate shapes.
+
+Provides Line, Arc, Hole, Rectangle, Circle tools with grid snap,
+zoom, pan, and undo/redo.  The drawn contour is exported as a list of
+points that ``generate_nc1_from_contour`` can consume directly.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Optional, Tuple
+
+from PySide6.QtCore import Qt, QPointF, QRectF, QLineF, Signal
+from PySide6.QtGui import (
+    QPen, QColor, QPainter, QPainterPath, QBrush,
+    QMouseEvent, QWheelEvent, QKeyEvent,
+    QPolygonF,
+)
+from PySide6.QtWidgets import (
+    QGraphicsView, QGraphicsScene, QGraphicsItem,
+    QDoubleSpinBox,
+)
+
+from .entities import (
+    Contour, Tool, DrawEntity,
+    LineEntity, ArcEntity, HoleEntity, RectEntity, CircleEntity,
+)
+from .snap import snap_point
+
+# Cotation engine (lazy import to avoid circular)
+_dim_builder = None
+_dim_renderer = None
+
+
+def _get_dim_builders():
+    global _dim_builder, _dim_renderer
+    if _dim_builder is None:
+        from nccorrection.engine.cotation.linear import horizontal, vertical, orthogonal
+        from nccorrection.engine.cotation.renderer import render_dimension_set
+        from nccorrection.engine.cotation.models import DimensionSet
+        _dim_builder = {'horizontal': horizontal, 'vertical': vertical,
+                        'orthogonal': orthogonal}
+        _dim_renderer = render_dimension_set
+    return _dim_builder, _dim_renderer
+
+
+# ────────────────────────────────────────────────────────────────────
+# Drawing canvas
+# ────────────────────────────────────────────────────────────────────
+
+class DrawingCanvas(QGraphicsView):
+    """QGraphicsView-based 2D drawing canvas."""
+
+    # Emitted when entities change (for NC1 preview update)
+    entities_changed = Signal()
+
+    # Emitted with status text
+    status_changed = Signal(str)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._scene = QGraphicsScene(self)
+        self.setScene(self._scene)
+
+        # Render settings
+        self.setRenderHint(QPainter.Antialiasing)
+        self.setRenderHint(QPainter.SmoothPixmapTransform)
+        self.setDragMode(QGraphicsView.NoDrag)
+        self.setTransformationAnchor(QGraphicsView.AnchorUnderMouse)
+        self.setResizeAnchor(QGraphicsView.AnchorUnderMouse)
+        self.setViewportUpdateMode(QGraphicsView.FullViewportUpdate)
+
+        # Background
+        self._bg_color = QColor("#0f172a")
+        self._grid_color = QColor("#1e3a5f")
+        self._grid_color_major = QColor("#334155")
+        self._grid_spacing = 10.0  # mm
+        self._grid_major = 50.0    # mm
+
+        # State
+        self._tool = Tool.SELECT
+        self._entities: List[DrawEntity] = []
+        self._holes: List[HoleEntity] = []
+        self._undo_stack: List[List[DrawEntity]] = []
+        self._redo_stack: List[List[DrawEntity]] = []
+
+        # Snap settings
+        self._snap_enabled = True
+        self._snap_grid = True
+        self._snap_endpoint = True
+        self._snap_circle = True
+        self._snap_distance = 5.0  # mm
+
+        # Drawing state
+        self._drawing = False
+        self._start_pos: Optional[Tuple[float, float]] = None
+        self._preview_item: Optional[QGraphicsItem] = None
+        self._arc_points: List[QPointF] = []  # for 3-point arc
+
+        # Circle diameter input
+        self._diameter_input = QDoubleSpinBox(self)
+        self._diameter_input.setRange(1.0, 100000.0)
+        self._diameter_input.setDecimals(1)
+        self._diameter_input.setSuffix(" mm")
+        self._diameter_input.setFixedWidth(110)
+        self._diameter_input.setFixedHeight(24)
+        self._diameter_input.setStyleSheet(
+            "QDoubleSpinBox{background:#1e293b;color:#e2e8f0;border:1px solid #007acc;"
+            "border-radius:3px;padding:2px 4px;font-size:11px;}"
+            "QDoubleSpinBox:focus{border:2px solid #007acc;}"
+        )
+        self._diameter_input.hide()
+        self._diameter_input.returnPressed.connect(self._on_diameter_confirmed)
+        self._pending_circle_center: Optional[Tuple[float, float]] = None
+
+        # Pan state
+        self._panning = False
+        self._pan_start = QPointF()
+
+        # Dimension state
+        self._dim_points: List[Tuple[float, float]] = []
+        self._dim_sets: List = []  # List[DimensionSet]
+        self._dim_kind: str = "orthogonal"  # horizontal | vertical | orthogonal
+
+        # Fit view
+        self.fitInView(-500, -500, 1000, 1000, Qt.KeepAspectRatio)
+        self.centerOn(0, 0)
+
+    # ── Tool selection ────────────────────────────────────────────
+
+    def set_tool(self, tool: Tool):
+        self._tool = tool
+        self._hide_diameter_input()
+        self._drawing = False
+        self._start_pos = None
+        self._arc_points.clear()
+        self._dim_points.clear()
+        self._clear_preview()
+        self.setDragMode(QGraphicsView.NoDrag)
+        self.status_changed.emit(f"Tool: {tool.name}")
+
+    def set_dim_kind(self, kind: str):
+        """Set dimension mode: 'horizontal', 'vertical', or 'orthogonal'."""
+        self._dim_kind = kind
+
+    def tool(self) -> Tool:
+        return self._tool
+
+    # ── Snap (delegates to snap.py) ──────────────────────────────
+
+    def _snap(self, pos: QPointF) -> QPointF:
+        return snap_point(
+            pos, self._entities,
+            enabled=self._snap_enabled,
+            grid_snap=self._snap_grid,
+            endpoint_snap=self._snap_endpoint,
+            circle_snap=self._snap_circle,
+            grid_spacing=self._grid_spacing,
+            snap_distance=self._snap_distance,
+        )
+
+    # ── Coordinate transforms ─────────────────────────────────────
+
+    def _scene_to_mm(self, pos: QPointF) -> Tuple[float, float]:
+        return (pos.x(), pos.y())
+
+    def _mm_to_scene(self, x: float, y: float) -> QPointF:
+        return QPointF(x, y)
+
+    # ── Mouse events ──────────────────────────────────────────────
+
+    def mousePressEvent(self, event: QMouseEvent):
+        if event.button() == Qt.MiddleButton:
+            self._panning = True
+            self._pan_start = event.pos()
+            self.setCursor(Qt.ClosedHandCursor)
+            return
+
+        if event.button() == Qt.RightButton:
+            if self._tool == Tool.DIMENSION and len(self._dim_points) >= 2:
+                self._finish_dimension()
+                return
+            self._drawing = False
+            self._start_pos = None
+            self._arc_points.clear()
+            self._clear_preview()
+            return
+
+        if event.button() != Qt.LeftButton:
+            return
+
+        scene_pos = self.mapToScene(event.pos())
+        snapped = self._snap(scene_pos)
+        mm = self._scene_to_mm(snapped)
+
+        if self._tool == Tool.SELECT:
+            super().mousePressEvent(event)
+            return
+
+        if self._tool == Tool.LINE:
+            if not self._drawing:
+                self._start_pos = mm
+                self._drawing = True
+                self.status_changed.emit("Line: click end point")
+            else:
+                self._finish_line(mm)
+            return
+
+        if self._tool == Tool.ARC:
+            self._arc_points.append(mm)
+            if len(self._arc_points) == 3:
+                self._finish_arc()
+            else:
+                n = len(self._arc_points)
+                self.status_changed.emit(f"Arc: click point {n}/3")
+            return
+
+        if self._tool == Tool.HOLE:
+            self._start_pos = mm
+            self._drawing = True
+            self.status_changed.emit("Hole: click for center, drag to set diameter")
+            return
+
+        if self._tool == Tool.RECTANGLE:
+            if not self._drawing:
+                self._start_pos = mm
+                self._drawing = True
+                self.status_changed.emit("Rectangle: click opposite corner")
+            else:
+                self._finish_rectangle(mm)
+            return
+
+        if self._tool == Tool.CIRCLE:
+            if not self._drawing:
+                self._start_pos = mm
+                self._pending_circle_center = mm
+                self._drawing = True
+                self._show_diameter_input(event.pos(), 0.0)
+                self.status_changed.emit("Circle: type diameter and press Enter, or click edge point")
+            else:
+                self._hide_diameter_input()
+                self._finish_circle(mm)
+            return
+
+        if self._tool == Tool.DIMENSION:
+            self._dim_points.append(mm)
+            n = len(self._dim_points)
+            if n == 1:
+                self.status_changed.emit("Dimension: click second point, then right-click to place")
+            elif n == 2:
+                self.status_changed.emit("Dimension: click more points or right-click to finish chain")
+            self._refresh_scene()
+            return
+
+    def mouseMoveEvent(self, event: QMouseEvent):
+        if self._panning:
+            delta = event.pos() - self._pan_start
+            self._pan_start = event.pos()
+            self.horizontalScrollBar().setValue(
+                self.horizontalScrollBar().value() - int(delta.x()))
+            self.verticalScrollBar().setValue(
+                self.verticalScrollBar().value() - int(delta.y()))
+            return
+
+        scene_pos = self.mapToScene(event.pos())
+        snapped = self._snap(scene_pos)
+        mm = self._scene_to_mm(snapped)
+
+        self.status_changed.emit(
+            f"X={mm[0]:.1f}  Y={mm[1]:.1f}  Tool={self._tool.name}")
+
+        # Preview
+        if self._drawing and self._start_pos:
+            self._clear_preview()
+            if self._tool == Tool.LINE:
+                self._preview_line(mm)
+            elif self._tool == Tool.HOLE:
+                self._preview_hole(mm)
+            elif self._tool == Tool.RECTANGLE:
+                self._preview_rectangle(mm)
+            elif self._tool == Tool.CIRCLE:
+                typed_d = (self._diameter_input.value()
+                           if self._diameter_input.isVisible() else 0.0)
+                if typed_d > 0:
+                    self._preview_circle_diameter(mm, typed_d)
+                else:
+                    self._preview_circle(mm)
+
+        super().mouseMoveEvent(event)
+
+    def mouseReleaseEvent(self, event: QMouseEvent):
+        if event.button() == Qt.MiddleButton:
+            self._panning = False
+            self.setCursor(Qt.ArrowCursor)
+            return
+        super().mouseReleaseEvent(event)
+
+    def wheelEvent(self, event: QWheelEvent):
+        factor = 1.15 if event.angleDelta().y() > 0 else 1.0 / 1.15
+        self.scale(factor, factor)
+
+    def keyPressEvent(self, event: QKeyEvent):
+        if event.key() == Qt.Key_Z and event.modifiers() & Qt.ControlModifier:
+            if event.modifiers() & Qt.ShiftModifier:
+                self.redo()
+            else:
+                self.undo()
+            return
+        if event.key() == Qt.Key_Escape:
+            self._hide_diameter_input()
+            self._drawing = False
+            self._start_pos = None
+            self._arc_points.clear()
+            self._dim_points.clear()
+            self._clear_preview()
+            self.set_tool(Tool.SELECT)
+            return
+        if event.key() == Qt.Key_Delete:
+            self._delete_selected()
+            return
+        super().keyPressEvent(event)
+
+    # ── Drawing operations ────────────────────────────────────────
+
+    def _finish_line(self, end: Tuple[float, float]):
+        if self._start_pos is None:
+            return
+        ent = LineEntity(self._start_pos, end)
+        self._add_entity(ent)
+        self._drawing = False
+        self._start_pos = end  # chain lines
+        self._drawing = True
+        self.status_changed.emit("Line: click next point (Esc to stop)")
+
+    def _finish_arc(self):
+        if len(self._arc_points) < 3:
+            return
+        p1 = (self._arc_points[0].x(), self._arc_points[0].y())
+        p2 = (self._arc_points[1].x(), self._arc_points[1].y())
+        p3 = (self._arc_points[2].x(), self._arc_points[2].y())
+
+        ax, ay = p1
+        bx, by = p2
+        cx, cy = p3
+        D = 2 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by))
+        if abs(D) < 1e-10:
+            self.status_changed.emit("Arc: points collinear, using line")
+            ent = LineEntity(p1, p3)
+            self._add_entity(ent)
+            self._arc_points.clear()
+            return
+
+        ux = ((ax * ax + ay * ay) * (by - cy) +
+              (bx * bx + by * by) * (cy - ay) +
+              (cx * cx + cy * cy) * (ay - by)) / D
+        uy = ((ax * ax + ay * ay) * (cx - bx) +
+              (bx * bx + by * by) * (ax - cx) +
+              (cx * cx + cy * cy) * (bx - ax)) / D
+        r = math.hypot(ax - ux, ay - uy)
+
+        a1 = math.degrees(math.atan2(ay - uy, ax - ux))
+        a2 = math.degrees(math.atan2(by - uy, bx - ux))
+        a3 = math.degrees(math.atan2(cy - uy, cx - ux))
+
+        def norm(a):
+            while a < 0:
+                a += 360
+            while a >= 360:
+                a -= 360
+            return a
+
+        a1n, a2n, a3n = norm(a1), norm(a2), norm(a3)
+        diff_12 = (a2n - a1n) % 360
+        diff_13 = (a3n - a1n) % 360
+
+        if diff_12 < diff_13:
+            start_a, end_a = a1, a3
+        else:
+            start_a, end_a = a3, a1
+
+        ent = ArcEntity((ux, uy), r, start_a, end_a)
+        self._add_entity(ent)
+        self._arc_points.clear()
+        self.status_changed.emit("Arc added")
+
+    def _finish_rectangle(self, corner: Tuple[float, float]):
+        if self._start_pos is None:
+            return
+        ent = RectEntity(self._start_pos, corner)
+        contour = ent.contour()
+        for i in range(len(contour) - 1):
+            line_ent = LineEntity(contour[i], contour[i + 1])
+            self._add_entity(line_ent)
+        self._drawing = False
+        self._start_pos = None
+
+    def _finish_circle(self, edge: Tuple[float, float]):
+        """Finish circle by clicking edge point (drag mode)."""
+        if self._start_pos is None:
+            return
+        cx, cy = self._start_pos
+        r = math.hypot(edge[0] - cx, edge[1] - cy)
+        if r < 1.0:
+            self.status_changed.emit("Circle: too small, ignored")
+            self._drawing = False
+            self._start_pos = None
+            return
+        ent = CircleEntity((cx, cy), r)
+        self._add_entity(ent)
+        self._drawing = False
+        self._start_pos = None
+        self.status_changed.emit(f"Circle: r={r:.1f} mm")
+
+    def _finish_dimension(self):
+        """Create a DimensionSet from collected points and add to scene."""
+        if len(self._dim_points) < 2:
+            return
+        builders, _ = _get_dim_builders()
+        builder = builders.get(self._dim_kind, builders['orthogonal'])
+        dim_set = builder(list(self._dim_points), offset=30.0)
+        self._dim_sets.append(dim_set)
+        self._dim_points.clear()
+        self._refresh_scene()
+        self.entities_changed.emit()
+        self.status_changed.emit(f"Dimension: {len(self._dim_sets)} set(s)")
+
+    # ── Entity management ─────────────────────────────────────────
+
+    def _add_entity(self, ent: DrawEntity):
+        self._save_undo()
+        self._entities.append(ent)
+        self._render_entity(ent)
+        self.entities_changed.emit()
+
+    def _render_entity(self, ent: DrawEntity):
+        """Create QGraphicsItem for an entity and add to scene."""
+        pen = QPen(QColor("#38bdf8"), 1.5)
+        pen.setCosmetic(True)
+
+        if isinstance(ent, LineEntity):
+            p1 = QPointF(ent.points[0][0], ent.points[0][1])
+            p2 = QPointF(ent.points[1][0], ent.points[1][1])
+            item = self._scene.addLine(QLineF(p1, p2), pen)
+            ent.item = item
+
+        elif isinstance(ent, ArcEntity):
+            path = QPainterPath()
+            pts = ent.arc_points(32)
+            if pts:
+                path.moveTo(pts[0][0], pts[0][1])
+                for x, y in pts[1:]:
+                    path.lineTo(x, y)
+            item = self._scene.addPath(path, pen)
+            ent.item = item
+
+        elif isinstance(ent, HoleEntity):
+            cx, cy = ent.center
+            d = ent.diameter
+            hole_pen = QPen(QColor("#ef4444"), 1.5)
+            hole_pen.setCosmetic(True)
+            item = self._scene.addEllipse(cx - d / 2, cy - d / 2, d, d, hole_pen)
+            ent.item = item
+
+        elif isinstance(ent, CircleEntity):
+            cx, cy = ent.center
+            r = ent.radius
+            item = self._scene.addEllipse(cx - r, cy - r, r * 2, r * 2, pen)
+            ent.item = item
+            # Center crosshair
+            cross_len = min(r * 0.3, 12.0)
+            cross_pen = QPen(QColor("#60a5fa"), 0.8, Qt.DotLine)
+            cross_pen.setCosmetic(True)
+            self._scene.addLine(cx - cross_len, cy, cx + cross_len, cy, cross_pen)
+            self._scene.addLine(cx, cy - cross_len, cx, cy + cross_len, cross_pen)
+
+    def _clear_preview(self):
+        if self._preview_item:
+            self._scene.removeItem(self._preview_item)
+            self._preview_item = None
+
+    def _preview_line(self, end: Tuple[float, float]):
+        if self._start_pos is None:
+            return
+        pen = QPen(QColor("#f97316"), 1.0, Qt.DashLine)
+        pen.setCosmetic(True)
+        p1 = QPointF(self._start_pos[0], self._start_pos[1])
+        p2 = QPointF(end[0], end[1])
+        self._preview_item = self._scene.addLine(QLineF(p1, p2), pen)
+
+    def _preview_hole(self, current: Tuple[float, float]):
+        if self._start_pos is None:
+            return
+        cx, cy = self._start_pos
+        r = math.hypot(current[0] - cx, current[1] - cy)
+        pen = QPen(QColor("#ef4444"), 1.0, Qt.DashLine)
+        pen.setCosmetic(True)
+        self._preview_item = self._scene.addEllipse(
+            cx - r, cy - r, r * 2, r * 2, pen)
+
+    def _preview_rectangle(self, corner: Tuple[float, float]):
+        if self._start_pos is None:
+            return
+        x1, y1 = self._start_pos
+        x2, y2 = corner
+        r = QRectF(min(x1, x2), min(y1, y2),
+                   abs(x2 - x1), abs(y2 - y1))
+        pen = QPen(QColor("#f97316"), 1.0, Qt.DashLine)
+        pen.setCosmetic(True)
+        self._preview_item = self._scene.addRect(r, pen)
+
+    def _preview_circle(self, edge: Tuple[float, float]):
+        if self._start_pos is None:
+            return
+        cx, cy = self._start_pos
+        r = math.hypot(edge[0] - cx, edge[1] - cy)
+        pen = QPen(QColor("#f97316"), 1.0, Qt.DashLine)
+        pen.setCosmetic(True)
+        self._preview_item = self._scene.addEllipse(
+            cx - r, cy - r, r * 2, r * 2, pen)
+
+    def _preview_circle_diameter(self, current: Tuple[float, float],
+                                  diameter: float):
+        """Preview circle with a typed diameter value."""
+        if self._start_pos is None or diameter <= 0:
+            return
+        cx, cy = self._start_pos
+        r = diameter / 2.0
+        pen = QPen(QColor("#f97316"), 1.0, Qt.DashLine)
+        pen.setCosmetic(True)
+        self._preview_item = self._scene.addEllipse(
+            cx - r, cy - r, r * 2, r * 2, pen)
+
+    # ── Diameter input widget ───────────────────────────────────
+
+    def _show_diameter_input(self, viewport_pos, initial_diameter: float):
+        """Show floating diameter spinbox at cursor position."""
+        self._diameter_input.setValue(initial_diameter)
+        x = viewport_pos.x() + 15
+        y = viewport_pos.y() - 12
+        self._diameter_input.move(x, y)
+        self._diameter_input.show()
+        self._diameter_input.setFocus()
+        self._diameter_input.selectAll()
+
+    def _hide_diameter_input(self):
+        """Hide the floating diameter spinbox."""
+        self._diameter_input.hide()
+        self._pending_circle_center = None
+
+    def _on_diameter_confirmed(self):
+        """Called when user presses Enter in the diameter spinbox."""
+        diameter = self._diameter_input.value()
+        self._hide_diameter_input()
+        if self._pending_circle_center is not None and diameter > 0:
+            cx, cy = self._pending_circle_center
+            r = diameter / 2.0
+            ent = CircleEntity((cx, cy), r)
+            self._add_entity(ent)
+            self._drawing = False
+            self._start_pos = None
+            self._pending_circle_center = None
+            self.status_changed.emit(f"Circle: d={diameter:.1f} mm")
+
+    # ── Undo/Redo ─────────────────────────────────────────────────
+
+    def _save_undo(self):
+        self._undo_stack.append(list(self._entities))
+        self._redo_stack.clear()
+
+    def undo(self):
+        if not self._undo_stack:
+            return
+        self._redo_stack.append(list(self._entities))
+        self._entities = self._undo_stack.pop()
+        self._refresh_scene()
+        self.entities_changed.emit()
+
+    def redo(self):
+        if not self._redo_stack:
+            return
+        self._undo_stack.append(list(self._entities))
+        self._entities = self._redo_stack.pop()
+        self._refresh_scene()
+        self.entities_changed.emit()
+
+    def _refresh_scene(self):
+        self._scene.clear()
+        self._preview_item = None
+        for ent in self._entities:
+            self._render_entity(ent)
+
+    def _delete_selected(self):
+        if self._entities:
+            self._save_undo()
+            self._entities.pop()
+            self._refresh_scene()
+            self.entities_changed.emit()
+
+    # ── Export ─────────────────────────────────────────────────────
+
+    def get_outer_contour(self) -> Contour:
+        """Export all entities as a closed contour (outer boundary).
+
+        Circles are flattened to 64-sided polygons (closed).
+        Lines and arcs are collected in entity order.
+        """
+        if not self._entities:
+            return []
+
+        points: List[Tuple[float, float]] = []
+        for ent in self._entities:
+            if isinstance(ent, LineEntity):
+                points.append(ent.points[0])
+                points.append(ent.points[1])
+            elif isinstance(ent, ArcEntity):
+                points.extend(ent.arc_points(16))
+            elif isinstance(ent, CircleEntity):
+                points.extend(ent.contour(64))
+
+        cleaned: List[Tuple[float, float]] = []
+        for pt in points:
+            if not cleaned or cleaned[-1] != pt:
+                cleaned.append(pt)
+
+        if len(cleaned) >= 3 and cleaned[0] != cleaned[-1]:
+            cleaned.append(cleaned[0])
+
+        return cleaned
+
+    def get_holes(self) -> List[dict]:
+        """Export hole entities as dicts {x, y, d}."""
+        return [{'x': h.center[0], 'y': h.center[1], 'd': h.diameter}
+                for h in self._holes]
+
+    def get_dimension_sets(self) -> list:
+        """Export all dimension sets."""
+        return list(self._dim_sets)
+
+    def get_entity_count(self) -> int:
+        return len(self._entities)
+
+    def get_hole_count(self) -> int:
+        return len(self._holes)
+
+    # ── Clear all ─────────────────────────────────────────────────
+
+    def clear_all(self):
+        self._save_undo()
+        self._entities.clear()
+        self._holes.clear()
+        self._refresh_scene()
+        self.entities_changed.emit()
+
+    # ── Grid drawing ──────────────────────────────────────────────
+
+    def drawBackground(self, painter, rect):
+        painter.fillRect(rect, self._bg_color)
+
+        left = int(rect.left()) - (int(rect.left()) % int(self._grid_spacing))
+        top = int(rect.top()) - (int(rect.top()) % int(self._grid_spacing))
+
+        x = left
+        while x < rect.right():
+            if x % self._grid_major == 0:
+                painter.setPen(QPen(self._grid_color_major, 0.5))
+            else:
+                painter.setPen(QPen(self._grid_color, 0.2))
+            painter.drawLine(int(x), int(rect.top()), int(x), int(rect.bottom()))
+            x += self._grid_spacing
+
+        y = top
+        while y < rect.bottom():
+            if y % self._grid_major == 0:
+                painter.setPen(QPen(self._grid_color_major, 0.5))
+            else:
+                painter.setPen(QPen(self._grid_color, 0.2))
+            painter.drawLine(int(rect.left()), int(y), int(rect.right()), int(y))
+            y += self._grid_spacing
+
+    # ── X/Y axis indicator (fixed position, bottom-left) ────────
+
+    def drawForeground(self, painter, rect):
+        """Draw X/Y axis arrows and dimension sets."""
+        # Dimension sets
+        if self._dim_sets:
+            painter.save()
+            _, renderer = _get_dim_builders()
+            for dim_set in self._dim_sets:
+                renderer(painter, dim_set)
+            painter.restore()
+
+        # X/Y axis arrows (fixed position, bottom-left)
+        painter.save()
+        painter.resetTransform()
+
+        vp = self.viewport()
+        ox = 50
+        oy = vp.height() - 50
+        arrow_len = 30
+        head_len = 7
+        head_w = 4
+
+        font = painter.font()
+        font.setPointSize(8)
+        font.setBold(True)
+        painter.setFont(font)
+
+        # X axis — red, pointing right
+        painter.setPen(QPen(QColor("#ef4444"), 2))
+        painter.drawLine(ox, oy, ox + arrow_len, oy)
+        painter.setBrush(QBrush(QColor("#ef4444")))
+        painter.drawPolygon(QPolygonF([
+            QPointF(ox + arrow_len, oy),
+            QPointF(ox + arrow_len - head_len, oy - head_w),
+            QPointF(ox + arrow_len - head_len, oy + head_w),
+        ]))
+        painter.drawText(ox + arrow_len + 6, oy + 4, "X")
+
+        # Y axis — green, pointing up
+        painter.setPen(QPen(QColor("#22c55e"), 2))
+        painter.drawLine(ox, oy, ox, oy - arrow_len)
+        painter.setBrush(QBrush(QColor("#22c55e")))
+        painter.drawPolygon(QPolygonF([
+            QPointF(ox, oy - arrow_len),
+            QPointF(ox - head_w, oy - arrow_len + head_len),
+            QPointF(ox + head_w, oy - arrow_len + head_len),
+        ]))
+        painter.drawText(ox + 6, oy - arrow_len + 4, "Y")
+
+        painter.restore()
+
+    # ── Hole entity management ────────────────────────────────────
+
+    def add_hole(self, center: Tuple[float, float], diameter: float):
+        """Add a hole entity (separate from line/arc entities)."""
+        self._save_undo()
+        ent = HoleEntity(center, diameter)
+        self._holes.append(ent)
+        self._render_entity(ent)
+        self.entities_changed.emit()
