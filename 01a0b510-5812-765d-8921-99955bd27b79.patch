+        self.assertTrue(os.path.exists(f0['path']))   # new stored copy exists
+        self.assertTrue(os.path.isfile(f0['path']))
+        self.assertFalse(os.path.exists(old_stored))  # old copy removed
+        self.assertIn(f0['hash'], self.w.hole_overrides)  # overrides migrated
+        self.assertNotIn(old_hash, self.w.hole_overrides)
+        # manifest carries the new hash + new order
+        manifest = self.w.projects.load_project('p3proj')
+        rec = next(r for r in manifest['files'] if r['name'] == f0['name'])
+        self.assertEqual(rec['hash'], f0['hash'])
