+"""Export a viewer widget rendering to a PDF page (vector output)."""
+
+from PySide6.QtCore import QSizeF
+from PySide6.QtGui import QPageSize, QPdfWriter
+
+
+def export_widget_pdf(widget, path, dpi=150, max_w_mm=420.0, max_h_mm=297.0):
+    """Paint ``widget`` into a PDF at ``path``.
+
+    The page keeps the widget aspect ratio and is fitted into a max page of
+    ``max_w_mm`` x ``max_h_mm``. Returns 1 on success, 0 if the widget has no
+    size (e.g. never shown).
+    """
+    w, h = widget.width(), widget.height()
+    if w <= 0 or h <= 0:
+        return 0
+    ratio = min(max_w_mm / w, max_h_mm / h)
+    wmm, hmm = w * ratio, h * ratio
+    writer = QPdfWriter(path)
+    writer.setResolution(dpi)
+    writer.setPageSize(QPageSize(QSizeF(wmm, hmm), QPageSize.Millimeter))
+    widget.render(writer)
+    return 1
