+"""OrderManagerMixin — extracted order-management UI logic from NCManagerApp.
+
+Provides undo/redo snapshots, order combo/context-menu CRUD, move/copy
+between orders (P6), clipboard cut/paste, and the SI/EN insert action.
+Every method references ``self`` attributes and helpers that live on the
+host ``NCManagerApp`` class.
+"""
+
+import os
+
+from PySide6.QtCore import Qt
+from PySide6.QtWidgets import (
+    QAbstractItemView,
+    QInputDialog,
+    QMenu,
+    QMessageBox,
+)
+
+from nccorrection.core.classifier import compute_hash
+from nccorrection.core.order_utils import _replace_order_in_text
+from nccorrection.core.nc1_writer import ensure_si_en
+
+
+class OrderManagerMixin:
+    """Mixin that supplies order-management features for NCManagerApp."""
+
+    # ---------------------------------------------------------------- undo / redo
+    def _snapshot_state(self):
+        qty = {f['hash']: f['qty_override'] for f in self.files
+               if f.get('qty_override') is not None}
+        quality = {f['hash']: f.get('quality') for f in self.files if f.get('quality')}
+        holes = {h: dict(o) for h, o in self.hole_overrides.items()}
+        deleted = {h: set(s) for h, s in self.hole_deleted.items()}
+        added = {h: [dict(x) for x in lst] for h, lst in self.added_holes.items()}
+        return {'qty': qty, 'holes': holes, 'deleted': deleted, 'added': added,
+                'quality': quality}
+
+    def _apply_state(self, state):
+        if not state:
+            return
+        qty = state.get('qty', {})
+        quality = state.get('quality', {})
+        holes = state.get('holes', {})
+        for f in self.files:
+            f['qty_override'] = qty.get(f['hash'])
+            if f['hash'] in quality:
+                f['quality'] = quality[f['hash']]
+        self.hole_overrides = {h: dict(o) for h, o in holes.items()}
+        self.hole_deleted = {h: set(s) for h, s in state.get('deleted', {}).items()}
+        self.added_holes = {h: [dict(x) for x in lst]
+                            for h, lst in state.get('added', {}).items()}
+
+    def _push_undo(self):
+        self._undo_stack.append(self._snapshot_state())
+        if len(self._undo_stack) > 200:
+            self._undo_stack.pop(0)
+        self._redo_stack.clear()
+
+    def _undo(self):
+        if not self._undo_stack:
+            return
+        state = self._undo_stack.pop()
+        self._redo_stack.append(self._snapshot_state())
+        self._apply_state(state)
+        self._sync_after_state()
+
+    def _redo(self):
+        if not self._redo_stack:
+            return
+        state = self._redo_stack.pop()
+        self._undo_stack.append(self._snapshot_state())
+        self._apply_state(state)
+        self._sync_after_state()
+
+    def _undo_all(self):
+        """Revert every recorded change to the oldest snapshot.
+
+        The current state is pushed onto the redo stack so Redo All can bring
+        it back; the undo stack collapses to that single oldest state (edits
+        made before it no longer exist to undo).
+        """
+        if len(self._undo_stack) <= 1:
+            return
+        self._redo_stack.append(self._snapshot_state())
+        oldest_state = self._undo_stack[0]
+        self._undo_stack = [oldest_state]
+        self._apply_state(oldest_state)
+        self._sync_after_state()
+
+    def _redo_all(self):
+        """Re-apply every change since Undo All (the newest redo snapshot)."""
+        if not self._redo_stack:
+            return
+        self._undo_stack.append(self._snapshot_state())
+        newest_state = self._redo_stack[-1]
+        self._redo_stack.clear()
+        self._apply_state(newest_state)
+        self._sync_after_state()
+
+    def _sync_after_state(self):
+        self._render_table()
+        self._update_details()
+        self._set_status(self.tr_('ready'))
+
+    # ---------------------------------------------------------------- orders
+    def _order_context_menu(self, pos):
+        """Right-click menu on the order combo (P3+: rename, later delete/new)."""
+        menu = QMenu(self)
+        act = menu.addAction(self.tr_('rename_order'))
+        if menu.exec_(self.project_combo.mapToGlobal(pos)) == act:
+            self._rename_order()
+        # P4: Delete order action (kept in the same menu; more actions can be
+        # appended here without changing the flow).
+        act_del = menu.addAction(self.tr_('delete_order'))
+        if menu.exec_(self.project_combo.mapToGlobal(pos)) == act_del:
+            self._delete_order()
+        # P5: New order - creates an EMPTY order (default name "new order -N",
+        # editable) that survives restarts even with zero files.
+        act_new = menu.addAction(self.tr_('new_order'))
+        if menu.exec_(self.project_combo.mapToGlobal(pos)) == act_new:
+            self._new_order()
+
+    def _delete_order(self):
+        """P4: delete the currently selected order from the project.
+
+        Isolation rule (owner, Lantek/ProNest style): the program only ever
+        touches ITS OWN data - the imported copies under
+        ``projects/<name>/input/`` and the manifest records. The ORIGINAL
+        source files (``src_path``) are NEVER deleted. All rows of the order
+        leave the table, their stored copies are removed from disk (when no
+        other row still uses the same hash), and the manifest is refreshed.
+        """
+        old = self.project_combo.currentText() if hasattr(self, 'project_combo') else ''
+        if not old or old == self.tr_('filter_all'):
+            self._set_status(self.tr_('delete_no_order'))
+            return
+        targets = [f for f in self.files if f.get('order') == old]
+        if not targets:
+            self._set_status(self.tr_('delete_no_order'))
+            return
+        dirty_n = sum(1 for f in targets if self._file_dirty(f))
+        msg = self.tr_('delete_order_confirm').format(
+            order=old, n=len(targets),
+            dirty=('\n' + self.tr_('delete_order_dirty').format(n=dirty_n)
+                   if dirty_n else ''))
+        if QMessageBox.question(self, self.tr_('delete_order'),
+                                msg) != QMessageBox.Yes:
+            return
+        gone_hashes = {f['hash'] for f in targets}
+        base = (self.projects.project_path(self._current_project)
+                if self._current_project else '')
+        if base:
+            for f in targets:
+                p = f.get('path')
+                if (p and os.path.isfile(p)
+                        and not any(g is not f and g.get('path') == p
+                                    for g in self.files)):
+                    try:
+                        os.remove(p)
+                    except OSError:
+                        pass
+        self.files = [f for f in self.files if f.get('order') != old]
+        self.selected.difference_update(gone_hashes)
+        # P6: same hash may now exist in ANOTHER order - only purge state for
+        # hashes that no remaining row uses.
+        remaining = {f['hash'] for f in self.files}
+        for h in gone_hashes - remaining:
+            self.hole_overrides.pop(h, None)
+            self.hole_deleted.pop(h, None)
+            self.added_holes.pop(h, None)
+            self._session_edited.discard(h)
+        # P5: keep the empty-orders list in sync when an order is deleted.
+        if getattr(self, 'orders', None) and old in self.orders:
+            self.orders = [o for o in self.orders if o != old]
+        if self._current_project:
+            self.projects.save_project(
+                self._current_project, self.files,
+                settings={k: self.settings.get(k) for k in
+                          ('language', 'theme', 'outputName', 'themeCustom')},
+                notes=dict(self.settings.get_all_notes() or {}),
+                hole_overrides=self.hole_overrides,
+                hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+                added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+                qty_overrides={h: f.get('qty_override') for f in self.files
+                               for h in [f['hash']] if f.get('qty_override') is not None},
+                source_folder=self._project_source_folder(),
+                orders=self.orders)
+            self._saved_hashes = {f['hash'] for f in self.files}
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(self.tr_('delete_order_done') + f': {old} '
+                         + self.tr_('delete_order_files').format(n=len(targets)))
+        self.audit.log(f'Order deleted: {old} ({len(targets)} file(s), '
+                       f'stored copies removed: {base != ""})', 'ok', 'OK-111')
+
+    def _rename_order(self):
+        """P3: rename the currently selected order (pencil button / context menu).
+
+        Asks whether the new order must ALSO be applied INSIDE the NC1 files
+        (the stored copies under ``projects/<name>/input/``): the order line in
+        the ST header is replaced (``23-001`` -> ``ouahbi 123``) and the stored
+        copy is rewritten under the new content hash. The display file name
+        (e.g. ``C1.nc1``) never changes - only the order content inside.
+        """
+        from PySide6.QtWidgets import QInputDialog
+        old = self.project_combo.currentText() if hasattr(self, 'project_combo') else ''
+        if not old or old == self.tr_('filter_all'):
+            self._set_status(self.tr_('rename_no_order'))
+            return
+        new, ok = QInputDialog.getText(self, self.tr_('rename_order'),
+                                       self.tr_('rename_order_prompt'), text=old)
+        if not ok or not new.strip() or new.strip() == old:
+            return
+        new = new.strip()
+        targets = [f for f in self.files if f.get('order') == old]
+        if not targets:
+            self._set_status(self.tr_('rename_no_order'))
+            return
+        apply_inside = (QMessageBox.question(
+            self, self.tr_('rename_order'),
+            self.tr_('rename_order_apply').format(old=old, new=new))
+            == QMessageBox.Yes)
+        base = (self.projects.project_path(self._current_project)
+                if self._current_project else '')
+        legacy = bool(self._current_project and base
+                      and os.path.isdir(os.path.join(base, 'input')))
+        for f in targets:
+            f['order'] = new
+            if apply_inside:
+                new_text = _replace_order_in_text(f.get('text', ''), new)
+                if new_text != f.get('text'):
+                    old_hash = f['hash']
+                    h = compute_hash(new_text.encode('latin-1'))
+                    if self._current_project and base:
+                        old_stored = f.get('path')
+                        if legacy:
+                            # legacy project (pre-law storage): keep input/<hash>
+                            ext = (os.path.splitext(
+                                os.path.basename(old_stored or ''))[1]
+                                or '.nc1')
+                            new_path = os.path.join(base, f'input/{h}{ext}')
+                            with open(new_path, 'w', encoding='latin-1',
+                                      newline='') as fh:
+                                fh.write(new_text)
+                            if (old_stored and os.path.isfile(old_stored)
+                                    and old_stored != new_path
+                                    and not any(g is not f
+                                                and g.get('path') == old_stored
+                                                for g in self.files)):
+                                try:
+                                    os.remove(old_stored)
+                                except OSError:
+                                    pass
+                            f['path'] = new_path
+                            f['stored'] = f'input/{h}{ext}'
+                        else:
+                            # FLAT storage (owner law): the stored copy is
+                            # rewritten IN PLACE - same file, same display
+                            # name, only the order content inside changes.
+                            with open(f['path'], 'w', encoding='latin-1',
+                                      newline='') as fh:
+                                fh.write(new_text)
+                            f['stored'] = None
+                    f['text'] = new_text
+                    f['hash'] = h
+                    # keep hole overrides attached to the file across the
+                    # content-hash change (geometry itself is untouched)
+                    if old_hash != h:
+                        if old_hash in self.hole_overrides:
+                            self.hole_overrides[h] = self.hole_overrides.pop(old_hash)
+                        if old_hash in self.hole_deleted:
+                            self.hole_deleted[h] = self.hole_deleted.pop(old_hash)
+                        if old_hash in self.added_holes:
+                            self.added_holes[h] = self.added_holes.pop(old_hash)
+            f['dirty'] = self._file_dirty(f)
+        # P5: keep the empty-orders list in sync when an order is renamed.
+        if getattr(self, 'orders', None) and old in self.orders:
+            self.orders = [new if o == old else o for o in self.orders]
+        if self._current_project:
+            self.projects.save_project(
+                self._current_project, self.files,
+                settings={k: self.settings.get(k) for k in
+                          ('language', 'theme', 'outputName', 'themeCustom')},
+                notes=dict(self.settings.get_all_notes() or {}),
+                hole_overrides=self.hole_overrides,
+                hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+                added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+                qty_overrides={h: f.get('qty_override') for f in self.files
+                               for h in [f['hash']] if f.get('qty_override') is not None},
+                source_folder=self._project_source_folder(),
+                orders=self.orders)
+            self._saved_hashes = {f['hash'] for f in self.files}
+        self._session_edited.update(f['hash'] for f in targets)
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(self.tr_('rename_order_done') + f': {old} -> {new}')
+        self.audit.log(f'Order renamed: {old} -> {new} '
+                       f'(apply inside: {apply_inside})', 'ok', 'OK-110')
+
+    def _next_new_order_default(self):
+        """Owner law 2026-08-19: default new-order name ``new order-1`` (NO
+        space) and the numbering continues from how many ``new order-N``
+        names were already made (count + 1, then skip any taken number)."""
+        taken = ({f.get('order') for f in self.files if f.get('order')}
+                 | set(getattr(self, 'orders', []) or []))
+        count = 0
+        for t in taken:
+            if (t or '').startswith('new order-'):
+                rest = (t or '')[len('new order-'):]
+                if rest.isdigit():
+                    count += 1
+        n = count + 1
+        while f'new order-{n}' in taken:
+            n += 1
+        return f'new order-{n}'
+
+    def _new_order(self):
+        """P5: create a NEW EMPTY order inside the current project.
+
+        Default name auto-increments (``new order-1``, ``new order-2``, ... -
+        owner law: no space, numbering follows the count of existing names)
+        and is pre-filled in the dialog so the owner can edit it. The order
+        stays empty, is saved automatically (it must survive restarts even
+        with zero files - manifest ``orders`` list), and files can later be
+        Moved/Copied into it (P6) or loaded from the computer.
+        """
+        from PySide6.QtWidgets import QInputDialog
+        taken = ({f.get('order') for f in self.files if f.get('order')}
+                 | set(getattr(self, 'orders', []) or []))
+        default = self._next_new_order_default()
+        name, ok = QInputDialog.getText(self, self.tr_('new_order'),
+                                        self.tr_('new_order_prompt'), text=default)
+        if not ok or not name.strip():
+            return
+        name = name.strip()
+        if name in taken:
+            self._set_status(self.tr_('new_order_exists'))
+            return
+        self.orders = list(getattr(self, 'orders', []) or []) + [name]
+        if self._current_project:
+            self.projects.save_project(
+                self._current_project, self.files,
+                settings={k: self.settings.get(k) for k in
+                          ('language', 'theme', 'outputName', 'themeCustom')},
+                notes=dict(self.settings.get_all_notes() or {}),
+                hole_overrides=self.hole_overrides,
+                hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+                added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+                qty_overrides={h: f.get('qty_override') for f in self.files
+                               for h in [f['hash']] if f.get('qty_override') is not None},
+                source_folder=self._project_source_folder(),
+                orders=self.orders)
+            self._saved_hashes = {f['hash'] for f in self.files}
+        self._refresh_order_combo()
+        self.project_combo.setCurrentIndex(
+            self.project_combo.findText(name))
+        self._set_status(self.tr_('new_order_done') + ': ' + name)
+        self.audit.log(f'New order created: {name} (empty, '
+                       f'persisted: {bool(self._current_project)})', 'ok', 'OK-112')
+
+    def _refresh_order_combo(self):
+        """Rebuild the order dropdown from the distinct orders of the list
+        plus the persisted empty orders (``self.orders``)."""
+        if not hasattr(self, 'project_combo'):
+            return
+        current = self.project_combo.currentText()
+        file_orders = {f.get('order', '') for f in self.files if f.get('order')}
+        orders = sorted(file_orders | set(getattr(self, 'orders', []) or []))
+        self.project_combo.blockSignals(True)
+        self.project_combo.clear()
+        self.project_combo.addItem(self.tr_('filter_all'))
+        self.project_combo.addItems(orders)
+        idx = self.project_combo.findText(current)
+        self.project_combo.setCurrentIndex(idx if idx >= 0 else 0)
+        self.project_combo.blockSignals(False)
+
+    def _prompt_assign_orders(self):
+        """Phase E: ask the user how to organise the current orders.
+
+        ``order_prompt`` setting: ``auto`` (default) shows nothing and keeps
+        the per-file order extracted from the NC1 header; ``ask`` pops a
+        confirmation once the list contains parts from several distinct orders.
+        """
+        if self.settings.get('order_prompt', 'auto') != 'ask':
+            return
+        orders = sorted({f.get('order', '') for f in self.files if f.get('order')})
+        if len(orders) < 2:
+            return
+        msg = (self.tr_('assign_orders_found').format(n=len(orders)) + '\n'
+               + ', '.join(orders))
+        if QMessageBox.question(self, self.tr_('assign_order_title'),
+                                msg) == QMessageBox.Yes:
+            self._refresh_order_combo()
+            self._render_table()
+
+    # ---------------------------------------------------------------- preview
+    def _files_context_menu(self, pos):
+        item = self.table.itemAt(pos)
+        if not item:
+            return
+        idx = item.data(Qt.UserRole)
+        targets = self._selection_targets(idx)
+        self.table.setCurrentCell(item.row(), 0)
+        menu = self._build_files_menu(targets)
+        menu.exec(self.table.viewport().mapToGlobal(pos))
+
+    def _build_files_menu(self, targets):
+        menu = QMenu(self)
+        # Export formats in ONE dropdown submenu (same pattern as the viewer
+        # context menu), not five separate top-level items.
+        export_menu = menu.addMenu(self.tr_('export'))
+        for fmt, label in [('nc1', 'NC/NC1'), ('cn', 'CN'), ('dxf', 'DXF'),
+                           ('obj', 'OBJ'), ('stl', 'STL')]:
+            act = export_menu.addAction(label)
+            act.triggered.connect(lambda _=False, f=fmt: self._export_selected(f, targets))
+        menu.addSeparator()
+        # P6: Move to / Copy to - dropdown of the existing orders + create one.
+        move_menu = menu.addMenu(self.tr_('move_to'))
+        copy_menu = menu.addMenu(self.tr_('copy_to'))
+        orders = sorted({f.get('order') for f in self.files if f.get('order')}
+                        | set(getattr(self, 'orders', []) or []))
+        for o in orders:
+            a = move_menu.addAction(o)
+            a.triggered.connect(lambda _=False, ord=o: self._move_to_order(targets, ord))
+            b = copy_menu.addAction(o)
+            b.triggered.connect(lambda _=False, ord=o: self._copy_to_order(targets, ord))
+        a_new = move_menu.addAction(self.tr_('new_order_ellipsis'))
+        a_new.triggered.connect(lambda _=False: self._move_to_new_order(targets))
+        b_new = copy_menu.addAction(self.tr_('new_order_ellipsis'))
+        b_new.triggered.connect(lambda _=False: self._copy_to_new_order(targets))
+        menu.addSeparator()
+        act_edit = menu.addAction(self.tr_('edit'))
+        act_edit.triggered.connect(lambda _=False: self._edit_files(targets))
+        act_del = menu.addAction(self.tr_('delete'))
+        act_del.triggered.connect(lambda _=False: self._delete_from_list(targets))
+        act_restore = menu.addAction(self.tr_('restore_original'))
+        act_restore.triggered.connect(lambda _=False: self._restore_original(targets))
+        act_restore.setEnabled(any(self._file_dirty(t) for t in targets))
+        return menu
+
+    # ------------------------------------------------------------ P6 move/copy
+    def _move_to_order(self, targets, order):
+        """P6: move the selected rows to another order.
+
+        Owner rule: the order INSIDE the NC1 file changes too - the header
+        order line is rewritten (``CHRGUI BATIMAN F1 REV B`` ->
+        ``OUAHBI123``) via ``_replace_order_in_text`` (same scanning rules as
+        extraction), a new stored copy is written under the new content hash,
+        the old stored copy is removed when unused, and hole overrides are
+        migrated to the new hash. The ORIGINAL source file never moves.
+        """
+        if not targets:
+            return
+        base = (self.projects.project_path(self._current_project)
+                if self._current_project else '')
+        legacy = bool(self._current_project and base
+                      and os.path.isdir(os.path.join(base, 'input')))
+        moved = 0
+        for f in targets:
+            if f.get('order') == order:
+                continue
+            old_order = f['order']
+            f['order'] = order
+            new_text = _replace_order_in_text(f.get('text', ''), order)
+            if new_text != f.get('text'):
+                old_hash = f['hash']
+                h = compute_hash(new_text.encode('latin-1'))
+                if self._current_project and base:
+                    old_stored = f.get('path')
+                    if legacy:
+                        # legacy project (pre-law storage): keep input/<hash>
+                        ext = (os.path.splitext(
+                            os.path.basename(old_stored or ''))[1] or '.nc1')
+                        new_path = os.path.join(base, f'input/{h}{ext}')
+                        with open(new_path, 'w', encoding='latin-1',
+                                  newline='') as fh:
+                            fh.write(new_text)
+                        if (old_stored and os.path.isfile(old_stored)
+                                and old_stored != new_path
+                                and not any(g is not f
+                                            and g.get('path') == old_stored
+                                            for g in self.files)):
+                            try:
+                                os.remove(old_stored)
+                            except OSError:
+                                pass
+                        f['path'] = new_path
+                        f['stored'] = f'input/{h}{ext}'
+                    else:
+                        # FLAT storage (owner law): the moved file keeps its
+                        # ORIGINAL display name. Same-name row already in the
+                        # target order? identical content -> the moved row
+                        # MERGES into it (one row per name+order); different
+                        # content -> the conflict dialog ALWAYS appears
+                        # (Replace / Ignore / Compare).
+                        same_rows = [g for g in self.files
+                                     if g is not f
+                                     and g.get('order') == order
+                                     and g.get('name') == f.get('name')]
+                        dup = next((g for g in same_rows
+                                    if g.get('hash') == h), None)
+                        conflict = next((g for g in same_rows
+                                         if g.get('hash') != h), None)
+                        if dup is not None:
+                            # identical content already there: the moved file
+                            # is represented by the existing row
+                            self.files.remove(f)
+                            self._session_edited.add(dup['hash'])
+                            moved += 1
+                            self.audit.log(
+                                f'Move to order: {f["name"]} '
+                                f'({old_order} -> {order}, merged duplicate)',
+                                'ok', 'OK-113')
+                            continue
+                        if conflict is not None:
+                            rec = {**f, 'text': new_text, 'hash': h}
+                            action = self._ask_folder_conflict(
+                                rec, existing=conflict)
+                            if action == 'ignore':
+                                f['order'] = old_order
+                                continue
+                            # replace: the incoming file wins the name - its
+                            # text overwrites the stored copy and the target
+                            # row is swapped for the moved one
+                            with open(conflict['path'], 'w', encoding='latin-1',
+                                      newline='') as fh:
+                                fh.write(new_text)
+                            f['path'] = conflict['path']
+                            f['stored'] = None
+                            self.files.remove(conflict)
+                        else:
+                            safe = self.projects._sanitize_file(
+                                f.get('name') or '')
+                            own_dst = os.path.join(base, safe)
+                            if not os.path.exists(own_dst):
+                                new_path = own_dst
+                            elif os.path.abspath(own_dst) == \
+                                    os.path.abspath(old_stored or ''):
+                                new_path = own_dst  # in place
+                            else:
+                                new_path = self._flat_suffixed_dst(base, safe)
+                            with open(new_path, 'w', encoding='latin-1',
+                                      newline='') as fh:
+                                fh.write(new_text)
+                            if (old_stored and os.path.isfile(old_stored)
+                                    and os.path.abspath(old_stored) !=
+                                    os.path.abspath(new_path)
+                                    and not any(g is not f
+                                                and g.get('path') == old_stored
+                                                for g in self.files)):
+                                try:
+                                    os.remove(old_stored)
+                                except OSError:
+                                    pass
+                            f['path'] = new_path
+                            f['stored'] = None
+                f['text'] = new_text
+                f['hash'] = h
+                # migrate hole overrides to the new hash (geometry untouched)
+                if old_hash != h:
+                    if old_hash in self.hole_overrides:
+                        self.hole_overrides[h] = self.hole_overrides.pop(old_hash)
+                    if old_hash in self.hole_deleted:
+                        self.hole_deleted[h] = self.hole_deleted.pop(old_hash)
+                    if old_hash in self.added_holes:
+                        self.added_holes[h] = self.added_holes.pop(old_hash)
+            f['dirty'] = self._file_dirty(f)
+            self._session_edited.add(f['hash'])
+            moved += 1
+            self.audit.log(f'Move to order: {f["name"]} '
+                           f'({old_order} -> {order})', 'ok', 'OK-113')
+        if not moved:
+            return
+        self._persist_order_state()
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(self.tr_('move_to_done').format(
+            n=moved, order=order))
+
+    def _copy_to_order(self, targets, order):
+        """P6: copy the selected rows into another order.
+
+        Owner rule: the copy's own header order line is rewritten to the new
+        order (the ORIGINAL row keeps its old header). The copy gets its own
+        content hash and stored copy; hole overrides are NOT shared - each
+        copy starts clean (identical geometry, independent edits).
+        """
+        if not targets:
+            return
+        base = (self.projects.project_path(self._current_project)
+                if self._current_project else '')
+        legacy = bool(self._current_project and base
+                      and os.path.isdir(os.path.join(base, 'input')))
+        copied = 0
+        for f in targets:
+            clone = {**f, 'order': order}
+            new_text = _replace_order_in_text(f.get('text', ''), order)
+            if new_text == f.get('text'):
+                # no header line to rewrite: the copy is content-identical
+                # and shares the original row's stored file (as before)
+                if any(g is not f and g.get('order') == order
+                       and g.get('name') == f.get('name') for g in self.files):
+                    continue
+            else:
+                h = compute_hash(new_text.encode('latin-1'))
+                clone['text'] = new_text
+                clone['hash'] = h
+                if self._current_project and base:
+                    if legacy:
+                        # legacy project (pre-law storage): keep input/<hash>;
+                        # same-name row already in the target order -> skip
+                        if any(g is not f and g.get('order') == order
+                               and g.get('name') == f.get('name')
+                               for g in self.files):
+                            continue
+                        ext = (os.path.splitext(
+                            os.path.basename(f.get('path', '')))[1] or '.nc1')
+                        new_path = os.path.join(base, f'input/{h}{ext}')
+                        with open(new_path, 'w', encoding='latin-1',
+                                  newline='') as fh:
+                            fh.write(new_text)
+                        clone['path'] = new_path
+                        clone['stored'] = f'input/{h}{ext}'
+                    else:
+                        # FLAT storage (owner law): same-name row already in
+                        # the target order? identical -> skip; different ->
+                        # the conflict dialog ALWAYS appears (Replace /
+                        # Ignore / Compare); fresh -> the copy is stored under
+                        # the ORIGINAL display name (numeric suffix when the
+                        # flat name is already owned inside this project).
+                        same_rows = [g for g in self.files
+                                     if g is not f
+                                     and g.get('order') == order
+                                     and g.get('name') == f.get('name')]
+                        dup = next((g for g in same_rows
+                                    if g.get('hash') == h), None)
+                        conflict = next((g for g in same_rows
+                                         if g.get('hash') != h), None)
+                        if dup is not None:
+                            continue  # identical copy already there
+                        if conflict is not None:
+                            rec = {**clone}
+                            action = self._ask_folder_conflict(
+                                rec, existing=conflict)
+                            if action == 'ignore':
+                                continue
+                            # replace: the copy overwrites the stored file and
+                            # takes over the target row (one row per name)
+                            with open(conflict['path'], 'w', encoding='latin-1',
+                                      newline='') as fh:
+                                fh.write(new_text)
+                            clone['path'] = conflict['path']
+                            clone['stored'] = None
+                            self.files.remove(conflict)
+                        else:
+                            safe = self.projects._sanitize_file(
+                                f.get('name') or '')
+                            own_dst = os.path.join(base, safe)
+                            new_path = (self._flat_suffixed_dst(base, safe)
+                                        if os.path.exists(own_dst)
+                                        else own_dst)
+                            with open(new_path, 'w', encoding='latin-1',
+                                      newline='') as fh:
+                                fh.write(new_text)
+                            clone['path'] = new_path
+                            clone['stored'] = None
+            self.files.append(clone)
+            self._session_edited.add(clone['hash'])
+            copied += 1
+        if not copied:
+            self._set_status(self.tr_('copy_to_skip'))
+            return
+        self._persist_order_state()
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(self.tr_('copy_to_done').format(
+            n=copied, order=order))
+        self.audit.log(f'Copy to order: {copied} file(s) -> {order} '
+                       '(header rewritten)', 'ok', 'OK-114')
+
+    def _move_to_new_order(self, targets):
+        name = self._prompt_new_order_name()
+        if name:
+            self._move_to_order(targets, name)
+
+    def _copy_to_new_order(self, targets):
+        name = self._prompt_new_order_name()
+        if name:
+            self._copy_to_order(targets, name)
+
+    def _prompt_new_order_name(self):
+        """Create an empty order (P5 default-name flow) and return its name."""
+        from PySide6.QtWidgets import QInputDialog
+        taken = ({f.get('order') for f in self.files if f.get('order')}
+                 | set(getattr(self, 'orders', []) or []))
+        default = self._next_new_order_default()
+        name, ok = QInputDialog.getText(self, self.tr_('new_order'),
+                                        self.tr_('new_order_prompt'), text=default)
+        if not ok or not name.strip():
+            return None
+        name = name.strip()
+        if name in taken:
+            self._set_status(self.tr_('new_order_exists'))
+            return None
+        self.orders = list(getattr(self, 'orders', []) or []) + [name]
+        if self._current_project:
+            self._persist_order_state()
+        return name
+
+    def _persist_order_state(self):
+        """Save files + overrides + the empty-orders list into the current
+        project manifest (no-op when no project is selected)."""
+        if not self._current_project:
+            return
+        self.projects.save_project(
+            self._current_project, self.files,
+            settings={k: self.settings.get(k) for k in
+                      ('language', 'theme', 'outputName', 'themeCustom')},
+            notes=dict(self.settings.get_all_notes() or {}),
+            hole_overrides=self.hole_overrides,
+            hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+            added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+            qty_overrides={h: f.get('qty_override') for f in self.files
+                           for h in [f['hash']] if f.get('qty_override') is not None},
+            source_folder=self._project_source_folder(),
+            orders=self.orders)
+        self._saved_hashes = {f['hash'] for f in self.files}
+
+    # ------------------------------------------------------------ P6 clipboard
+    def _copy_selected_rows(self):
+        """Ctrl+C: file-row clipboard (main table) OR hole clipboard (holes
+        panel has focus)."""
+        if self.table.state() == QAbstractItemView.EditingState:
+            return
+        if self.holes_table.hasFocus():
+            self._copy_holes()
+            return
+        targets = self._current_row_selection()
+        if not targets:
+            self._set_status(self.tr_('no_files_selected'))
+            return
+        self._clipboard = [dict(f) for f in targets]
+        self._clip_cut = False
+        self._set_status(self.tr_('clipboard_copy').format(n=len(self._clipboard)))
+
+    def _cut_selected_rows(self):
+        """Ctrl+X: cut = remember the rows AND remove them from the list; they
+        re-enter when pasted into another order (Ctrl+V)."""
+        if self.table.state() == QAbstractItemView.EditingState:
+            return
+        targets = self._current_row_selection()
+        if not targets:
+            self._set_status(self.tr_('no_files_selected'))
+            return
+        doomed = {id(t) for t in targets}
+        self._clipboard = [dict(t) for t in targets]
+        self._clip_cut = True
+        self.files = [f for f in self.files if id(f) not in doomed]
+        self.selected.clear()
+        self._render_table()
+        self._set_status(self.tr_('clipboard_cut').format(n=len(self._clipboard)))
+
+    def _current_row_selection(self):
+        """Return the file rows currently selected in the table."""
+        items = [self.table.item(r, 0) for r in range(self.table.rowCount())]
+        inds = sorted({it.data(Qt.UserRole) for it in items
+                       if it is not None and it.isSelected()})
+        return [self.files[i] for i in inds if 0 <= i < len(self.files)]
+
+    def _paste_clipboard(self):
+        """Ctrl+V: paste holes when the holes panel has focus, otherwise paste
+        the file-row clipboard into the CURRENT order (combo selection)."""
+        if self.table.state() == QAbstractItemView.EditingState:
+            return
+        if self.holes_table.hasFocus():
+            self._paste_holes()
+            return
+        if not self._clipboard:
+            self._set_status(self.tr_('clipboard_empty'))
+            return
+        order = (self.project_combo.currentText()
+                 if hasattr(self, 'project_combo') else '')
+        if not order or order == self.tr_('filter_all'):
+            self._set_status(self.tr_('paste_need_order'))
+            return
+        pasted = 0
+        for rec in self._clipboard:
+            if self._clip_cut:
+                self.files.append({**rec, 'order': order})
+                self._session_edited.add(rec['hash'])
+                pasted += 1
+            else:
+                if any(g.get('order') == order and g.get('hash') == rec['hash']
+                       for g in self.files):
+                    continue
+                self.files.append({**rec, 'order': order})
+                self._session_edited.add(rec['hash'])
+                pasted += 1
+        self._clipboard = []
+        self._clip_cut = False
+        self._persist_order_state()
+        self._render_table()
+        self._refresh_order_combo()
+        self._set_status(self.tr_('clipboard_paste').format(
+            n=pasted, order=order))
+        self.audit.log(f'Paste into order {order}: {pasted} file(s)', 'ok', 'OK-115')
+
+    def _selection_targets(self, idx):
+        sel = [self.table.item(r, 0) for r in range(self.table.rowCount())]
+        sel_inds = {it.data(Qt.UserRole) for it in sel
+                    if it is not None and it.isSelected()}
+        if sel_inds:
+            inds = sorted(sel_inds)
+        else:
+            inds = [idx]
+        return [self.files[i] for i in inds if 0 <= i < len(self.files)]
+
+    def _edit_files(self, targets):
+        if not targets:
+            return
+        self.selected = {self.files.index(t) for t in targets}
+        self._render_table()
+        for r in range(self.table.rowCount()):
+            it = self.table.item(r, 0)
+            if it is not None and it.data(Qt.UserRole) in self.selected:
+                self.table.selectRow(r)
+        self._update_details()
+        self._set_view_mode('2d')
+
+    def _delete_from_list(self, targets):
+        if not targets:
+            return
+        doomed = {id(t) for t in targets}
+        self.files = [f for f in self.files if id(f) not in doomed]
+        self.selected.clear()
+        self._render_table()
+        self._update_details()
+        self.audit.log(f'Removed {len(targets)} file(s) from list', 'ok', 'OK-104')
+
+    def _restore_original(self, targets):
+        """Discard pending hole/slot edits (overrides, deletions, additions)
+        and the persistent dirty flag; the stored copy keeps the original
+        NC1 text, so the file returns to its original content."""
+        if not targets:
+            return
+        restored = 0
+        for f in targets:
+            h = f.get('hash', '')
+            if not (self._file_dirty(f) or self.hole_overrides.get(h)
+                    or self.hole_deleted.get(h) or self.added_holes.get(h)):
+                continue
+            self.hole_overrides.pop(h, None)
+            self.hole_deleted.pop(h, None)
+            self.added_holes.pop(h, None)
+            f['qty_override'] = None
+            f['dirty'] = False
+            f.pop('dirty_at', None)
+            self._session_edited.discard(h)
+            restored += 1
+        if restored:
+            if self._current_project:
+                self.projects.update_manifest(
+                    self._current_project,
+                    hole_overrides=self.hole_overrides,
+                    hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+                    added_holes={h: list(lst) for h, lst in self.added_holes.items()})
+            self._render_table()
+            if self._current_file in targets:
+                self._refresh_viewers(self._current_file, preserve_view=True)
+            self._set_status(self.tr_('restore_original_done'))
+            self.audit.log(f'Restored original settings for {restored} file(s)',
+                           'ok', 'OK-111')
+
+    def _insert_si_en(self):
+        """Insert an SI / <repère> / EN block into the selected files that lack one."""
+        if self.settings.get_si_en_mode() == 'none':
+            self._set_status(self.tr_('si_disabled'))
+            return
+        targets = ([self.files[i] for i in sorted(self.selected)] if self.selected
+                   else ([self.files[0]] if self.files else []))
+        if not targets:
+            self._set_status(self.tr_('add_first'))
+            return
+        done = skipped = 0
+        for f in targets:
+            new_text, changed = ensure_si_en(
+                f['text'], os.path.splitext(f['name'])[0])
+            if not changed:
+                skipped += 1
+                continue
+            ret = QMessageBox.question(
+                self, self.tr_('si_en'),
+                self.tr_('si_en_ask').format(name=f['name'],
+                                             mark=os.path.splitext(f['name'])[0]),
+                QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
+            if ret != QMessageBox.Yes:
+                skipped += 1
+                continue
+            try:
+                with open(f['path'], 'w', encoding='latin-1', newline='') as fh:
+                    fh.write(new_text)
+            except OSError as exc:
+                self._toast(f"{self.tr_('export_fail')}\n{exc}", kind='error',
+                            title=self.tr_('si_en'))
+                return
+            f['text'] = new_text
+            f['si'] = True
+            self._mark_dirty(f, refresh=False)
+            self.audit.log(f"Inserted SI/EN into {f['name']}", 'ok', 'OK-112')
+            done += 1
+            if f is self._current_file:
+                self._update_details()
+        self._set_status(
+            f"{done} {self.tr_('si_en')}" +
+            (f" / {skipped} {self.tr_('skipped')}" if skipped else ''))
+        if done:
+            self._render_table()
