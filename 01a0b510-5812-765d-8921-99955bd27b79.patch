--- /dev/null
+++ b/src/nccorrection/engine/math/arc_interpolation.py
@@ -0,0 +1,282 @@
+"""DSTV bulge (arc) interpolation + radius-based arc interpolation.
+
+In the DSTV NC1 format an AK/IK contour is a list of vertices; between two
+vertices an arc value describes the arc segment:
+
+**Bulge convention** (DSTV standard)::
+
+    bulge = tan(theta / 4)
+
+where ``theta`` is the included angle of the arc from ``p1`` to ``p2``.
+
+* ``bulge == 0``   -> straight segment
+* ``bulge > 0``    -> the arc curves to the LEFT of the line p1 -> p2
+* ``bulge < 0``    -> the arc curves to the RIGHT
+
+A ``bulge`` of 1.0 therefore describes a semicircle.
+
+**Radius convention** (some CAM post-processors, e.g. Lantek / ProNest)::
+
+    radius = arc radius in mm
+
+* ``radius == 0``  -> straight segment
+* ``radius > 0``   -> arc curves to the LEFT (same side as positive bulge)
+* ``radius < 0``   -> arc curves to the RIGHT
+
+Reference: ``tluijken/dstv`` (Rust) and ``Baseflow/DSTV.Net`` (C#)
+both call the 3rd column ``radius`` and render via SVG arc commands.
+"""
+
+import math
+
+
+def _arc_geometry(x1, y1, x2, y2, bulge):
+    """Return ``(center_x, center_y, radius, start_angle, end_angle, sweep)``
+    for the arc described by p1 -> p2 with the given bulge."""
+    dx, dy = x2 - x1, y2 - y1
+    chord = math.hypot(dx, dy)
+    if chord < 1e-12:
+        return None
+    theta = 4.0 * math.atan(bulge)
+    if abs(theta) < 1e-9:
+        return None
+    mx, my = (x1 + x2) / 2.0, (y1 + y2) / 2.0
+    radius = chord / (2.0 * abs(math.sin(theta / 2.0)))
+    # distance from chord midpoint to the arc centre (positive along normal)
+    dist = radius * abs(math.cos(theta / 2.0))
+    # left unit normal of the direction p1 -> p2
+    nx, ny = -dy / chord, dx / chord
+    # centre sits on the opposite side of the arc bulge
+    sign = -1.0 if bulge > 0 else 1.0
+    cx, cy = mx + sign * nx * dist, my + sign * ny * dist
+    a1 = math.atan2(y1 - cy, x1 - cx)
+    a2 = math.atan2(y2 - cy, x2 - cx)
+    return cx, cy, radius, a1, a2
+
+
+def bulge_to_arc_points(x1, y1, x2, y2, bulge, num_segments=16):
+    """Convert a DSTV ``bulge`` value into a list of (x, y) polyline points
+    from ``(x1, y1)`` to ``(x2, y2)`` inclusive.
+
+    With ``bulge == 0`` only the two endpoints are returned (a straight
+    line). Otherwise ``num_segments`` arc points are generated, always walking
+    from ``p1`` to ``p2`` on the correct side of the chord.
+    """
+    if abs(bulge) < 1e-12:
+        return [(x1, y1), (x2, y2)]
+    geo = _arc_geometry(x1, y1, x2, y2, bulge)
+    if geo is None:
+        return [(x1, y1), (x2, y2)]
+    cx, cy, radius, a1, a2 = geo
+    n = max(int(num_segments), 2)
+
+    def points_for(sign):
+        pts = []
+        for i in range(n + 1):
+            a = a1 + sign * (a2 - a1) * (i / n)
+            pts.append((cx + radius * math.cos(a), cy + radius * math.sin(a)))
+        return pts
+
+    fwd = points_for(1.0)
+    rev = points_for(-1.0)
+    dx = x2 - x1
+    dy = y2 - y1
+
+    def side(pts):
+        # sign of cross((p2-p1), (apex-p1)) -> positive means left of p1->p2
+        ax, ay = pts[n // 2]
+        cross = dx * (ay - y1) - dy * (ax - x1)
+        return cross
+
+    target = math.copysign(1.0, bulge)
+    fwd_ok = side(fwd) * target > 0.0
+    rev_ok = side(rev) * target > 0.0
+    if rev_ok and not fwd_ok:
+        return rev
+    return fwd
+
+
+def radius_to_arc_points(x1, y1, x2, y2, radius, num_segments=16):
+    """Convert a **radius**-based arc into a list of (x, y) polyline points
+    from ``(x1, y1)`` to ``(x2, y2)`` inclusive.
+
+    This handles the CAM-convention 3rd column where the value is the arc
+    radius in mm (not ``tan(θ/4)``).
+
+    * ``radius == 0``  -> straight segment (two endpoints only)
+    * ``radius > 0``   -> arc curves LEFT of p1→p2  (same sign convention as bulge)
+    * ``radius < 0``   -> arc curves RIGHT of p1→p2
+
+    When ``|radius|`` is too small for the chord the segment degenerates
+    to a straight line (safety fallback).
+
+    Reference: ``tluijken/dstv`` ``contour_to_svg`` uses ``A |r| |r| 0 0 0``
+    for the general case; ``Baseflow/DSTV.Net`` ``Contour.ToSvg`` uses the
+    same logic.
+    """
+    r = abs(radius)
+    if r < 1e-12:
+        return [(x1, y1), (x2, y2)]
+
+    dx, dy = x2 - x1, y2 - y1
+    chord = math.hypot(dx, dy)
+    if chord < 1e-12:
+        return [(x1, y1)]
+
+    # Radius too small for the chord → straight line fallback
+    # (relaxed tolerance for floating-point: real NC1 files can have chord
+    # values that exceed 2*r by a fraction of a mm due to rounding in the
+    # CAM post-processor — clamp h to 0 rather than discarding the arc)
+    if r < chord / 2.0 * 0.999:
+        return [(x1, y1), (x2, y2)]
+
+    # Distance from chord midpoint to arc centre
+    half_c = chord / 2.0
+    h = math.sqrt(max(0.0, r * r - half_c * half_c))
+
+    # Chord midpoint
+    mx, my = (x1 + x2) / 2.0, (y1 + y2) / 2.0
+
+    # Left unit normal of p1→p2
+    nx, ny = -dy / chord, dx / chord
+
+    # Centre on the appropriate side (positive radius = left = same as bulge)
+    sign = 1.0 if radius > 0 else -1.0
+    cx = mx + sign * nx * h
+    cy = my + sign * ny * h
+
+    # Start / end angles from centre
+    a1 = math.atan2(y1 - cy, x1 - cx)
+    a2 = math.atan2(y2 - cy, x2 - cx)
+
+    # Short-arc sweep (large-arc-flag = 0 in SVG → always the shorter path)
+    da = a2 - a1
+    while da > math.pi:
+        da -= 2.0 * math.pi
+    while da < -math.pi:
+        da += 2.0 * math.pi
+
+    n = max(int(num_segments), 2)
+    return [(cx + r * math.cos(a1 + i * da / n),
+             cy + r * math.sin(a1 + i * da / n)) for i in range(n + 1)]
+
+
+def polyline_for_vertices(vertices, num_segments=16):
+    """Expand a contour (list of ``(x, y, bulge)`` triples **or**
+    ``(x, y, bulge, radius)`` 4-tuples) into a polyline list of
+    ``(x, y)`` points, interpolating every non-zero arc segment.
+
+    **Priority**: if a 4th element (``radius``) is present and non-zero it
+    is used via :func:`radius_to_arc_points`; otherwise the 3rd element
+    (``bulge``) drives :func:`bulge_to_arc_points`.  This lets the same
+    rendering path handle both DSTV-standard bulge files and
+    CAM-convention radius files transparently.
+
+    **Optimisation**: when ALL vertices carry the same non-zero radius
+    (circular contour — e.g. a circular plate), the circle centre is
+    computed once from all points via perpendicular-bisector intersection
+    and the full circle is tessellated directly, avoiding the per-segment
+    centre degeneration that occurs when chord ≈ 2r.
+    """
+    n = len(vertices)
+    if n < 2:
+        return [(v[0], v[1]) for v in vertices]
+
+    # --- Detect single-radius (circular contour) optimisation ---
+    radii = [v[3] if len(v) > 3 else 0.0 for v in vertices]
+    unique_radii = set()
+    for r in radii:
+        if abs(r) > 1e-12:
+            unique_radii.add(round(r, 6))
+    if len(unique_radii) == 1:
+        # All non-zero radii are the same → circular contour
+        r_val = radii[0]
+        pts_xy = [(v[0], v[1]) for v in vertices]
+        circle_pts = _circle_from_points(pts_xy, r_val, num_segments)
+        if circle_pts is not None:
+            return circle_pts
+
+    # --- General case: per-segment arc interpolation ---
+    out = []
+    for i in range(n):
+        v = vertices[i]
+        x1, y1 = v[0], v[1]
+        b = v[2] if len(v) > 2 else 0.0
+        rad = v[3] if len(v) > 3 else 0.0
+        x2, y2 = vertices[(i + 1) % n][0], vertices[(i + 1) % n][1]
+        if not out:
+            out.append((x1, y1))
+        if abs(rad) > 1e-12:
+            seg = radius_to_arc_points(x1, y1, x2, y2, rad, num_segments)
+        else:
+            seg = bulge_to_arc_points(x1, y1, x2, y2, b, num_segments)
+        out.extend(seg[1:])
+    return out
+
+
+def _circle_from_points(points, radius, num_segments=16):
+    """Compute the circle centre from ≥ 2 contour points with the same
+    radius and return tessellated ``(x, y)`` points walking the full circle
+    in angular order.
+
+    The centre is found by perpendicular-bisector intersection of the
+    first two chords, then validated against all points.  Returns ``None``
+    when the geometry is degenerate (collinear points, etc.).
+    """
+    if len(points) < 2:
+        return None
+
+    r = abs(radius)
+    if r < 1e-12:
+        return None
+
+    # --- Centre from perpendicular bisectors ---
+    def _bisector(p1, p2):
+        mx, my = (p1[0] + p2[0]) / 2.0, (p1[1] + p2[1]) / 2.0
+        dx, dy = p2[0] - p1[0], p2[1] - p1[1]
+        return mx, my, -dy, dx   # midpoint + direction
+
+    mx0, my0, dx0, dy0 = _bisector(points[0], points[1])
+    if len(points) >= 3:
+        mx1, my1, dx1, dy1 = _bisector(points[1], points[2])
+    else:
+        mx1, my1, dx1, dy1 = _bisector(points[0], points[-1])
+
+    det = dx0 * dy1 - dy0 * dx1
+    if abs(det) < 1e-12:
+        return None   # collinear
+
+    t = ((mx1 - mx0) * dy1 - (my1 - my0) * dx1) / det
+    cx = mx0 + t * dx0
+    cy = my0 + t * dy0
+
+    # --- Validate against all points (within tolerance) ---
+    for p in points:
+        d = math.hypot(p[0] - cx, p[1] - cy)
+        if abs(d - r) > max(0.5, r * 0.01):   # 0.5 mm or 1% tolerance
+            return None   # not a single circle
+
+    # --- Tessellate in angular order ---
+    angles = [math.atan2(p[1] - cy, p[0] - cx) for p in points]
+    # Sort points by angle so we walk the circle correctly
+    order = sorted(range(len(points)), key=lambda i: angles[i])
+    sorted_angles = [angles[i] for i in order]
+
+    # For each consecutive pair in angular order, tessellate the arc
+    total_pts = []
+    segs = len(points)
+    for si in range(segs):
+        a_start = sorted_angles[si]
+        a_end = sorted_angles[(si + 1) % segs]
+        da = a_end - a_start
+        if si == segs - 1:
+            # Last segment wraps around
+            da = da if da > 0 else da + 2.0 * math.pi
+        elif da < 0:
+            da += 2.0 * math.pi
+        n_seg = max(int(num_segments), 2)
+        for j in range(n_seg):
+            a = a_start + da * (j / n_seg)
+            total_pts.append((cx + r * math.cos(a), cy + r * math.sin(a)))
+
+    return total_pts if total_pts else None
