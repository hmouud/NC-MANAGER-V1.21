+"""Global measure/label features -- NCV121 (owner request, all views).
+
+Covers, for the 2D viewer, the 3D viewer AND the blueprint renderer:
+- F1: 3D orientation triad rotates with the model (Tekla-style arrowheads).
+- F2: global face-name display mode (full / letters + tooltip / hidden).
+- F3: right-click in measure mode: FIRST press cancels the pending points,
+      the NEXT press opens the full context menu (Refresh + settings).
+- F4: measure label sits on the LINE MIDPOINT without any frame.
+- F5: the dimension LINE is draggable in parallel (Tekla/AutoCAD style) and
+      long extension lines appear while it is shifted.
+"""
+
+import math
+import os
+import unittest
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+from PySide6.QtCore import QPointF, QEvent, Qt
+from PySide6.QtGui import QMouseEvent
+from PySide6.QtWidgets import QApplication
+
+from nccorrection.ui.qt_viewer import NcViewer
+from nccorrection.ui.qt_viewer_3d import NcViewer3D
+from nccorrection.engine.parser.dstv_parser import DstvParser
+from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+
+# HEA-like part with three face contours (v web + o/u flanges) and holes.
+MULTI_FACE = {
+    'st': {'profile': 'HEA300', 'type': 'I', 'dims': [6000, 300, 150, 10.0, 6.0],
+           'thickness': 10.0},
+    'contours': [
+        [(0, 0), (6000, 0), (6000, 300), (0, 300)],        # v web
+        [(200, 0), (5800, 0), (5800, 150), (200, 150)],    # o flange
+        [(100, 0), (5900, 0), (5900, 150), (100, 150)],    # u flange
+    ],
+    'contour_faces': ['v', 'o', 'u'],
+    'contour_meta': [
+        {'face': 'v', 'pts': [(0, 0), (6000, 0), (6000, 300), (0, 300)]},
+        {'face': 'o', 'pts': [(200, 0), (5800, 0), (5800, 150), (200, 150)]},
+        {'face': 'u', 'pts': [(100, 0), (5900, 0), (5900, 150), (100, 150)]},
+    ],
+    'circles': [(300, 150, 18), (3000, 75, 18)],
+    'holes': [
+        {'x': 300, 'y': 150, 'd': 18, 'face': 'v', 'kind': 'hole'},
+        {'x': 3000, 'y': 75, 'd': 18, 'face': 'o', 'kind': 'hole'},
+    ],
+}
+
+# Blueprint part: HEA200 with v/o/u faces and two web holes.
+LONG_BEAM = """ST
+** beam.nc1
+  1
+  1
+  BEAM
+  BEAM
+  S235JR
+  1
+  HEA300
+  I
