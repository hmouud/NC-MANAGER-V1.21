+class TestAppStateControllerCRUD(unittest.TestCase):
+    """Test AppStateController feature CRUD, transitions, and signals."""
+
+    def setUp(self):
+        from nccorrection.ui.dialogs.advanced_profile_creator.state import AppStateController
+        self.ctrl = AppStateController()
+
+    def test_add_hole_and_slot(self):
+        h_signal_count = 0
+        s_signal_count = 0
+
+        def on_proc_changed(kind):
+            nonlocal h_signal_count, s_signal_count
+            if kind == 'holes':
+                h_signal_count += 1
+            elif kind == 'slots':
+                s_signal_count += 1
+
+        self.ctrl.processes_changed.connect(on_proc_changed)
+
+        self.ctrl.add_hole({'face': 'v', 'kind': 'hole', 'x': 100.0, 'y': 50.0, 'd': 18.0})
+        self.ctrl.add_slot({'face': 'o', 'kind': 'slot', 'x': 200.0, 'y': 60.0, 'd': 22.0, 'length': 40.0})
+
+        feats = self.ctrl.get_all_features()
+        self.assertEqual(len(feats), 2)
+        self.assertEqual(feats[0]['kind'], 'hole')
+        self.assertEqual(feats[0]['d'], 18.0)
+        self.assertEqual(feats[1]['kind'], 'slot')
+        self.assertEqual(feats[1]['length'], 40.0)
+
+        self.assertEqual(h_signal_count, 1)
+        self.assertEqual(s_signal_count, 1)
+        self.assertTrue(self.ctrl.state.is_dirty)
+
+    def test_update_feature_in_place(self):
+        self.ctrl.add_hole({'face': 'v', 'kind': 'hole', 'x': 100.0, 'y': 50.0, 'd': 18.0})
+        self.ctrl.add_slot({'face': 'o', 'kind': 'slot', 'x': 200.0, 'y': 60.0, 'd': 22.0, 'length': 40.0})
+
+        # Update first feature (hole)
+        res = self.ctrl.update_feature(0, {'face': 'v', 'kind': 'hole', 'x': 150.0, 'y': 55.0, 'd': 20.0})
+        self.assertTrue(res)
+        f0 = self.ctrl.get_feature(0)
+        self.assertEqual(f0['x'], 150.0)
+        self.assertEqual(f0['d'], 20.0)
+
+        # Update second feature (slot)
+        res2 = self.ctrl.update_feature(1, {'face': 'u', 'kind': 'slot', 'x': 250.0, 'y': 70.0, 'd': 24.0, 'length': 50.0})
+        self.assertTrue(res2)
+        f1 = self.ctrl.get_feature(1)
+        self.assertEqual(f1['face'], 'u')
+        self.assertEqual(f1['length'], 50.0)
+
+    def test_update_hole_to_slot_transition(self):
+        # Starts as a hole at index 0
+        self.ctrl.add_hole({'face': 'v', 'kind': 'hole', 'x': 100.0, 'y': 50.0, 'd': 18.0})
+        self.assertEqual(len(self.ctrl.state.processes.holes), 1)
+        self.assertEqual(len(self.ctrl.state.processes.slots), 0)
+
+        # Update to a slot (length > 0)
+        self.ctrl.update_feature(0, {'face': 'v', 'kind': 'slot', 'x': 100.0, 'y': 50.0, 'd': 18.0, 'length': 45.0})
+        self.assertEqual(len(self.ctrl.state.processes.holes), 0)
+        self.assertEqual(len(self.ctrl.state.processes.slots), 1)
+
+        f = self.ctrl.get_feature(0)
+        self.assertEqual(f['kind'], 'slot')
+        self.assertEqual(f['length'], 45.0)
+
+    def test_duplicate_feature(self):
+        self.ctrl.add_hole({'face': 'v', 'kind': 'hole', 'x': 100.0, 'y': 50.0, 'd': 18.0})
+        dup = self.ctrl.duplicate_feature(0, dx=60.0, dy=10.0)
+        self.assertIsNotNone(dup)
+        self.assertEqual(dup['x'], 160.0)
+        self.assertEqual(dup['y'], 60.0)
+
+        feats = self.ctrl.get_all_features()
+        self.assertEqual(len(feats), 2)
+        self.assertEqual(feats[1]['x'], 160.0)
+
+    def test_remove_feature(self):
+        self.ctrl.add_hole({'face': 'v', 'kind': 'hole', 'x': 100.0, 'y': 50.0, 'd': 18.0})
+        self.ctrl.add_slot({'face': 'o', 'kind': 'slot', 'x': 200.0, 'y': 60.0, 'd': 22.0, 'length': 40.0})
+        self.assertEqual(len(self.ctrl.get_all_features()), 2)
+
+        # Remove first (hole)
+        self.assertTrue(self.ctrl.remove_feature(0))
+        feats = self.ctrl.get_all_features()
+        self.assertEqual(len(feats), 1)
+        self.assertEqual(feats[0]['kind'], 'slot')
+
+        # Remove remaining
+        self.assertTrue(self.ctrl.remove_feature(0))
+        self.assertEqual(len(self.ctrl.get_all_features()), 0)
+
+        # Removing out of bounds returns False
+        self.assertFalse(self.ctrl.remove_feature(0))
+
