+        t = get_template('HEA1000')
+        self.assertIsNotNone(t)
+        self.assertTrue(t.has_ik)
+
+    def test_ipe100_has_ka(self):
+        t = get_template('IPE100')
+        self.assertIsNotNone(t)
+        self.assertTrue(t.has_ka)
+
+
+class TestTemplateNC1Generation(unittest.TestCase):
+    """Test NC1 generation from templates."""
+
+    def test_basic_generation(self):
+        t = get_template('HEB100')
+        nc1 = generate_nc1_from_template(t, 6000, order='TEST')
+        self.assertIn('ST', nc1)
+        self.assertIn('EN', nc1)
+        self.assertIn('HEB100', nc1)
+        self.assertIn('AK', nc1)
+
+    def test_length_scaling(self):
+        t = get_template('HEB100')
+        nc1 = generate_nc1_from_template(t, 3000, order='TEST')
+        # Face should be scaled to 3000
+        self.assertIn('3000', nc1)
+        # Original 4500 should NOT appear in face geometry
+        lines = nc1.split('\n')
+        in_ak = False
+        for line in lines:
+            if line.strip() == 'AK':
+                in_ak = True
+            elif line.strip() in ('AK', 'BO', 'KA', 'EN', ''):
+                in_ak = False
+            elif in_ak and '4500' in line:
+                self.fail(f'Original length 4500 found in scaled face: {line}')
+
+    def test_header_fields(self):
+        t = get_template('HEB100')
+        nc1 = generate_nc1_from_template(
+            t, 5000, order='MY-ORDER', phase='3',
+            drawing='DWG-001', steel_grade='S355JR', quantity=10,
+        )
+        self.assertIn('MY-ORDER', nc1)
+        self.assertIn('S355JR', nc1)
+        self.assertIn('DWG-001', nc1)
+
+    def test_holes_inserted(self):
+        t = get_template('PL10')
+        nc1 = generate_nc1_from_template(t, 500, holes=[
+            {'face': 'v', 'x': 100, 'y': 50, 'd': 22},
+            {'face': 'v', 'x': 200, 'y': 50, 'd': 18},
+        ])
+        self.assertIn('BO', nc1)
+        self.assertIn('22', nc1)
+        self.assertIn('18', nc1)
+
+    def test_no_holes_no_bo(self):
+        t = get_template('HEB100')
+        nc1 = generate_nc1_from_template(t, 6000)
+        self.assertNotIn('BO', nc1)
+
+    def test_plate_preserves_dims(self):
+        t = get_template('PL10')
+        nc1 = generate_nc1_from_template(t, 800, quantity=3)
+        # Width and height should be preserved from template
+        self.assertIn('300', nc1)  # original width
+        self.assertIn('10', nc1)   # thickness
+
+    def test_counter_bore_hole(self):
+        t = get_template('PL10')
+        nc1 = generate_nc1_from_template(t, 500, holes=[
+            {'face': 'v', 'x': 100, 'y': 50, 'd': 22, 'counter_bore': 40},
+        ])
+        self.assertIn('0.000', nc1)  # counter-bore depth
+        self.assertIn('40', nc1)     # counter-bore diameter
+
+
+class TestTemplateEdgeCases(unittest.TestCase):
+    """Test edge cases and robustness."""
+
+    def test_parse_empty_text(self):
+        result = _parse_nc1_template('')
+        self.assertIsNone(result)
+
+    def test_parse_invalid_text(self):
+        result = _parse_nc1_template('not an NC1 file')
+        self.assertIsNone(result)
+
+    def test_parse_no_faces(self):
+        text = 'ST\n** test\ntest\n1\ntest\ntest\nS235JR\n1\nHEB100\nI\n' + '\n'.join(
+            f'      {i}.000' for i in range(12)
+        ) + '\n\n\n\nEN'
+        result = _parse_nc1_template(text)
+        # May or may not parse depending on face detection
+        # Should not crash
+
+    def test_zero_length(self):
+        t = get_template('HEB100')
+        nc1 = generate_nc1_from_template(t, 0)
+        # Should not crash
+        self.assertIn('ST', nc1)
+        self.assertIn('EN', nc1)
+
+
+if __name__ == '__main__':
+    unittest.main()
