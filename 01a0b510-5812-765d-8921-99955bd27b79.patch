+"""Part Creator Engine — parametric plate shape library.
+
+Generates NC1/DSTV geometry from parametric shape definitions.
+Each shape produces: outer contour (AK), inner contours (IK), holes (BO).
+
+Architecture:
+    shapes.py            ← Shape definitions (pure Python, no Qt)
+    nc1_generator.py     ← NC1/DSTV text generation from shapes
+    geometry_preview.py  ← Geometry dict for viewer preview
+    dialog.py            ← Qt dialog (shape selector + params + preview)
+"""
+from .shapes import SHAPE_LIBRARY, get_shape, list_shapes
+
+__all__ = ['SHAPE_LIBRARY', 'get_shape', 'list_shapes']
