+"""Tests for AppState / AppStateController — State Layer.
+
+15 tests covering:
+    - dataclass init + defaults
+    - profile setters + signals
+    - process setters + signals
+    - dirty tracking
+    - save/load round-trip
+    - JSON schema validation
+    - legacy format backward compat
+    - snapshot (deep copy)
+"""
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import unittest
+
+from PySide6.QtWidgets import QApplication
+
+import sys
+if not QApplication.instance():
+    app = QApplication(sys.argv)
+
+from nccorrection.ui.dialogs.advanced_profile_creator.state import (
+    ProfileState,
+    ProcessState,
+    AppState,
+    AppStateController,
+)
+
+
+class TestProfileState(unittest.TestCase):
+    """ProfileState dataclass basics."""
+
+    def test_default_values(self):
+        """ProfileState defaults match IPE240 convention."""
+        ps = ProfileState()
+        self.assertEqual(ps.profile_name, "IPE240")
+        self.assertEqual(ps.material, "S235JR")
+        self.assertEqual(ps.length, 6000.0)
+        self.assertEqual(ps.angle_steg_front, 0.0)
+
+    def test_to_dict_roundtrip(self):
+        """to_dict → from_dict preserves all fields."""
+        ps = ProfileState(
+            profile_name="HEB300", material="S355JR",
+            length=12000.0, width=300.0, height=300.0,
+            web=11.0, flange=19.0,
+            angle_steg_front=15.0, angle_steg_rear=-5.0,
+            angle_flange_front=0.0, angle_flange_rear=0.0,
+        )
+        d = ps.to_dict()
+        ps2 = ProfileState.from_dict(d)
+        self.assertEqual(ps2.profile_name, "HEB300")
+        self.assertAlmostEqual(ps2.length, 12000.0)
+        self.assertAlmostEqual(ps2.angle_steg_front, 15.0)
+
+
+class TestProcessState(unittest.TestCase):
+    """ProcessState dataclass basics."""
+
+    def test_default_empty(self):
+        """ProcessState starts with empty lists."""
+        ps = ProcessState()
+        self.assertEqual(ps.holes, [])
+        self.assertEqual(ps.slots, [])
+        self.assertEqual(ps.dimensions, [])
+
+    def test_to_dict_roundtrip(self):
+        """to_dict → from_dict preserves holes and slots."""
+        ps = ProcessState(
+            holes=[{'face': 'v', 'x': 100.0, 'y': 200.0, 'd': 16.0}],
+            slots=[{'face': 'o', 'x': 50.0, 'y': 60.0, 'd': 12.0, 'length': 80.0}],
+        )
+        d = ps.to_dict()
+        ps2 = ProcessState.from_dict(d)
+        self.assertEqual(len(ps2.holes), 1)
+        self.assertEqual(len(ps2.slots), 1)
+        self.assertAlmostEqual(ps2.holes[0]['x'], 100.0)
+
+
+class TestAppState(unittest.TestCase):
+    """AppState combination + JSON schema."""
+
+    def test_to_dict_has_version(self):
+        """AppState.to_dict() includes version 1.0."""
+        s = AppState()
+        d = s.to_dict()
+        self.assertEqual(d['version'], '1.0')
+        self.assertIn('profile', d)
+        self.assertIn('processes', d)
+        self.assertIn('metadata', d)
+
+    def test_from_dict_roundtrip(self):
+        """AppState.from_dict → to_dict round-trip."""
+        s = AppState()
+        s.profile.profile_name = "IPE400"
+        s.profile.length = 9000.0
+        s.processes.holes.append({'face': 'v', 'x': 50.0, 'y': 60.0, 'd': 20.0})
+        d = s.to_dict()
+        s2 = AppState.from_dict(d)
+        self.assertEqual(s2.profile.profile_name, "IPE400")
+        self.assertAlmostEqual(s2.profile.length, 9000.0)
+        self.assertEqual(len(s2.processes.holes), 1)
+
+    def test_snapshot_creates_deep_copy(self):
+        """snapshot() returns an independent copy."""
+        s = AppState()
+        s.profile.length = 5000.0
+        snap = s.snapshot()
+        s.profile.length = 8000.0
+        self.assertAlmostEqual(snap.profile.length, 5000.0)
+        self.assertAlmostEqual(s.profile.length, 8000.0)
+
+
+class TestAppStateController(unittest.TestCase):
+    """AppStateController signals + setters."""
+
+    def test_profile_changed_signal(self):
+        """set_profile_name emits profile_changed."""
+        ctrl = AppStateController()
+        received = []
+        ctrl.profile_changed.connect(lambda f: received.append(f))
+        ctrl.set_profile_name("HEB200")
+        self.assertEqual(received, ['profile_name'])
+
+    def test_process_changed_signal(self):
+        """add_hole emits processes_changed with 'holes'."""
+        ctrl = AppStateController()
+        received = []
+        ctrl.processes_changed.connect(lambda f: received.append(f))
+        ctrl.add_hole({'face': 'v', 'x': 10.0, 'y': 20.0, 'd': 16.0})
+        self.assertEqual(received, ['holes'])
+        self.assertEqual(len(ctrl.state.processes.holes), 1)
+
+    def test_dirty_tracking(self):
+        """Setting a value marks dirty; mark_clean clears it."""
+        ctrl = AppStateController()
+        self.assertFalse(ctrl.state.is_dirty)
+        dirty_states = []
+        ctrl.dirty_changed.connect(lambda v: dirty_states.append(v))
+        ctrl.set_profile_length(9999.0)
+        self.assertTrue(ctrl.state.is_dirty)
+        self.assertIn(True, dirty_states)
+        ctrl.mark_clean()
+        self.assertFalse(ctrl.state.is_dirty)
+        self.assertIn(False, dirty_states)
+
+    def test_no_signal_when_same_value(self):
+        """Setting same value does NOT emit signal."""
+        ctrl = AppStateController()
+        received = []
+        ctrl.profile_changed.connect(lambda f: received.append(f))
+        ctrl.set_profile_name("IPE240")  # same as default
+        self.assertEqual(received, [])
+
+    def test_save_load_roundtrip(self):
+        """save_to_file → load_from_file preserves all state."""
+        ctrl = AppStateController()
+        ctrl.set_profile_name("HEA300")
+        ctrl.set_profile_length(15000.0)
+        ctrl.set_profile_material("S355J2")
+        ctrl.add_hole({'face': 'v', 'x': 100.0, 'y': 200.0, 'd': 22.0})
+        ctrl.add_slot({'face': 'o', 'x': 300.0, 'y': 400.0, 'd': 14.0, 'length': 60.0})
+
+        tmp = os.path.join(tempfile.gettempdir(), 'test_state.ncp')
+        ctrl.save_to_file(tmp)
+        self.assertFalse(ctrl.state.is_dirty)  # save marks clean
+
+        ctrl2 = AppStateController()
+        ctrl2.load_from_file(tmp)
+        self.assertEqual(ctrl2.state.profile.profile_name, "HEA300")
+        self.assertAlmostEqual(ctrl2.state.profile.length, 15000.0)
+        self.assertEqual(ctrl2.state.profile.material, "S355J2")
+        self.assertEqual(len(ctrl2.state.processes.holes), 1)
+        self.assertEqual(len(ctrl2.state.processes.slots), 1)
+        self.assertAlmostEqual(ctrl2.state.processes.holes[0]['x'], 100.0)
+        self.assertAlmostEqual(ctrl2.state.processes.slots[0]['length'], 60.0)
+        os.unlink(tmp)
+
+    def test_load_from_dict_legacy_format(self):
+        """load_from_dict handles old format (profile.name + top-level holes)."""
+        ctrl = AppStateController()
+        legacy = {
+            'version': '1.0',
+            'profile': {
+                'name': 'IPE300',
+                'material': 'S275JR',
+                'length': 7500.0,
+                'angles': {
+                    'steg_front': 10.0,
+                    'steg_rear': 0.0,
+                    'flange_front': 0.0,
+                    'flange_rear': 0.0,
+                },
+            },
+            'holes': [
+                {'face': 'v', 'kind': 'BO', 'x': 50.0, 'y': 60.0, 'diameter': 18.0},
+            ],
+        }
+        ctrl.load_from_dict(legacy)
+        self.assertEqual(ctrl.state.profile.profile_name, "IPE300")
+        self.assertAlmostEqual(ctrl.state.profile.length, 7500.0)
+        self.assertAlmostEqual(ctrl.state.profile.angle_steg_front, 10.0)
+
+
+if __name__ == '__main__':
+    unittest.main()
