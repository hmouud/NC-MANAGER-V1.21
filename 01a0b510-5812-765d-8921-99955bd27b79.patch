+"""nc1_writer_advanced.py — Write full NC1 file.
+
+🚨 GUARDIAN LAW: Single responsibility — writing فقط.
+ما كايحتويش على geometry (هادشي ف builders).
+ما كايحتويش على parsing (هادشي ف detectors).
+"""
+from __future__ import annotations
+from typing import Dict, List
+
+from ..core.enums import Face
+from ..models.contour import Contour
+from .nc1_formatter import format_point, face_to_bo_op
+
+
+class NC1WriterAdvanced:
+    """كايكتب NC1 file كامل من Contours + Holes.
+
+    الاستعمال:
+        writer = NC1WriterAdvanced(header_lines, contours, holes)
+        content = writer.build()
+    """
+
+    def __init__(
+        self,
+        header_lines: List[str],
+        contours: Dict[Face, Contour],
+        holes: list = None,
+    ):
+        self.header_lines = list(header_lines)
+        self.contours = contours
+        self.holes = list(holes) if holes else []
+
+    def build(self) -> str:
+        """كايبني محتوى NC1 كامل."""
+        lines: List[str] = []
+
+        lines.extend(self.header_lines)
+
+        for face in self._ordered_faces():
+            contour = self.contours.get(face)
+            if contour is None:
+                continue
+            lines.append("AK")
+            for point in contour.points:
+                lines.append(format_point(point))
+
+        if self.holes:
+            lines.append("BO")
+            for hole in self.holes:
+                lines.append(self._format_hole(hole))
+
+        lines.append("EN")
+
+        return "\n".join(lines) + "\n"
+
+    def _ordered_faces(self) -> List[Face]:
+        """الترتيب الرسمي للوجوه ف DSTV: v, o, u, h."""
+        order = [Face.V, Face.O, Face.U, Face.H]
+        return [f for f in order if f in self.contours]
+
+    def _format_hole(self, hole) -> str:
+        """كايفورماتي hole لسطر BO."""
+        if hasattr(hole, 'face'):
+            op = face_to_bo_op(hole.face)
+            x = hole.x
+            y = hole.y
+        else:
+            op = "v"
+            x = hole[0] if isinstance(hole, (list, tuple)) else 0.0
+            y = hole[1] if isinstance(hole, (list, tuple)) else 0.0
+        return f"  {op}      {x:.2f}s     {y:.2f}      0.00"
