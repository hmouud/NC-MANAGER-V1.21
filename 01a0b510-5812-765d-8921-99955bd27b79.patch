+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h = p["width"], p["height"]
+        cr = min(p["corner_radius"], w / 2, h / 2)
+        if cr < 0.5:
+            return RectangleShape().generate(params)
+        corners = [
+            (w / 2 - cr, -(h / 2 - cr), 0, -90),
+            (-(w / 2 - cr), -(h / 2 - cr), -90, -180),
+            (-(w / 2 - cr), h / 2 - cr, 180, 90),
+            (w / 2 - cr, h / 2 - cr, 90, 0),
+        ]
+        outer = []
+        for cx, cy, a_start, a_end in corners:
+            outer.extend(_arc_pts(cx, cy, cr, a_start, a_end, 12))
+        return ShapeResult(outer=outer)
