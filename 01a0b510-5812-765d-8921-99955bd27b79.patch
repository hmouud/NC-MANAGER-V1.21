+class TestFaceClickDetection(unittest.TestCase):
+    def test_face_unexplode_logic(self):
+        # Bands layout: (face, offset, ymin, ymax)
+        # flange 'u': off=0, h=50 -> [0..50]
+        # web 'v': off=70, h=200 -> [70..270]
+        # flange 'o': off=290, h=50 -> [290..340]
+        bands = [
+            ('u', 0.0, 0.0, 50.0),
+            ('v', 70.0, 0.0, 200.0),
+            ('o', 290.0, 0.0, 50.0),
+        ]
+
+        def unexplode(y_disp):
+            for face, off, ymin, ymax in bands:
+                h = ymax - ymin
+                if off <= y_disp <= off + h + 20.0:
+                    local_y = ymin + (y_disp - off)
+                    return face, max(ymin, min(ymax, local_y))
+            return 'v', y_disp
+
+        # Click at y=25 -> should hit bottom flange 'u'
+        face, y = unexplode(25.0)
+        self.assertEqual(face, 'u')
+        self.assertAlmostEqual(y, 25.0)
+
+        # Click at y=150 -> should hit web 'v'
+        face, y = unexplode(150.0)
+        self.assertEqual(face, 'v')
+        self.assertAlmostEqual(y, 80.0)
+
+        # Click at y=310 -> should hit top flange 'o'
+        face, y = unexplode(310.0)
+        self.assertEqual(face, 'o')
+        self.assertAlmostEqual(y, 20.0)
+
