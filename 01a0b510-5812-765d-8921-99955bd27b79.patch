+    def test_90_deg_fold_projects_flap_onto_line(self):
+        # a 90-deg fold: perpendicular distance x-400 -> (x-400)*cos90 = 0
+        fx, fy = fold_point_2d(BEND_90, 500.0, 75.0, 90.0)
