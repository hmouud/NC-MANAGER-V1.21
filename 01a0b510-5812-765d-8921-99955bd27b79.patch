+class TestSnaps(unittest.TestCase):
+    def _rect(self):
+        # 100x50 rectangle with one corner at the origin + a hole
+        return SnapTargets(
+            points=[(0, 0), (100, 0), (100, 50), (0, 50)],
+            segments=[((0, 0), (100, 0)), ((100, 0), (100, 50)),
+                      ((100, 50), (0, 50)), ((0, 50), (0, 0))],
+            circles=[(50, 25, 10)],
+            insertion=(0, 0),
+        )
+
+    def test_endpoint(self):
+        t = self._rect()
+        pt, kind, d = resolve_snap(t, (3, 4), (ENDPOINT,), tol=12)
+        self.assertEqual(kind, ENDPOINT)
+        self.assertEqual(pt, (0, 0))
+        self.assertLess(d, 6)
+
+    def test_midpoint(self):
+        t = self._rect()
+        pt, kind, _ = resolve_snap(t, (50, 5), (MIDPOINT,), tol=12)
+        self.assertEqual(kind, MIDPOINT)
+        self.assertEqual(pt, (50, 0))
+
+    def test_nearest_on_edge(self):
+        t = self._rect()
+        pt, kind, _ = resolve_snap(t, (60, 6), (NEAREST,), tol=12)
+        self.assertEqual(kind, NEAREST)
+        self.assertEqual(pt, (60, 0))  # foot on the bottom edge
+
+    def test_intersection(self):
+        t = SnapTargets(segments=[((0, 0), (100, 0)), ((50, -10), (50, 60))])
+        pt, kind, _ = resolve_snap(t, (52, 3), (INTERSECTION,), tol=12)
+        self.assertEqual(kind, INTERSECTION)
+        # the two lines cross at (50, 0)
+        self.assertEqual(pt, (50, 0))
+
+    def test_centre_and_tangent(self):
+        t = self._rect()
+        pt, kind, _ = resolve_snap(t, (50, 25), (CENTRE,), tol=12)
+        self.assertEqual(kind, CENTRE)
+        self.assertEqual(pt, (50, 25))
+        # a real tangent point sits exactly on the circle
+        pt2, kind2, _ = resolve_snap(t, (37, 25), (TANGENT,), tol=12)
+        self.assertEqual(kind2, TANGENT)
+        self.assertAlmostEqual((pt2[0] - 50) ** 2 + (pt2[1] - 25) ** 2, 100.0,
+                               places=3)
+
+    def test_extension(self):
+        t = self._rect()
+        pt, kind, _ = resolve_snap(t, (125, 8), (EXTENSION,), tol=12)
+        self.assertEqual(kind, EXTENSION)
+        self.assertEqual(pt, (125, 0))  # extension of the bottom edge
+
+    def test_insertion(self):
+        t = self._rect()
+        pt, kind, _ = resolve_snap(t, (3, 3), (INSERTION,), tol=12)
+        self.assertEqual(kind, INSERTION)
+        self.assertEqual(pt, (0, 0))
+
+    def test_resolver_picks_closest_among_enabled(self):
+        t = self._rect()
+        # exactly on the corner: endpoint at distance 0 wins
+        pt, kind, _ = resolve_snap(t, (0, 0), (ENDPOINT, MIDPOINT, NEAREST))
+        self.assertEqual(kind, ENDPOINT)
+        self.assertEqual(pt, (0, 0))
+        # off the edge but closer to it: nearest wins over endpoint
+        pt2, kind2, _ = resolve_snap(t, (3, 1), (ENDPOINT, MIDPOINT, NEAREST))
+        self.assertEqual(kind2, NEAREST)
+
+    def test_disabled_snap_not_used(self):
+        t = self._rect()
+        res = resolve_snap(t, (2, 2), (MIDPOINT,), tol=12)
+        self.assertIsNone(res)
+
+    def test_none_when_outside_tolerance(self):
+        t = self._rect()
+        res = resolve_snap(t, (500, 500), (ENDPOINT,), tol=12)
+        self.assertIsNone(res)
+
