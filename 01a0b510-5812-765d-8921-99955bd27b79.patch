+"""math_utils.py — Pure math helpers.
+
+🚨 GUARDIAN LAW: No duplicate math functions. كل حساب رياضي هنا، مرة وحدة.
+"""
+from __future__ import annotations
+import math
+from ..core.constants import DEG_TO_RAD, RAD_TO_DEG, EPSILON
+
+
+def tan_deg(angle_deg: float) -> float:
+    """tan() بالدرجات. كايحمي من الزوايا الحرجة (90, -90)."""
+    if abs(abs(angle_deg) - 90.0) < 0.001:
+        return float("inf")
+    return math.tan(angle_deg * DEG_TO_RAD)
+
+
+def deg_to_rad(angle_deg: float) -> float:
+    """تحويل من درجات لراديان."""
+    return angle_deg * DEG_TO_RAD
+
+
+def rad_to_deg(angle_rad: float) -> float:
+    """تحويل من راديان لدرجات."""
+    return angle_rad * RAD_TO_DEG
+
+
+def safe_div(numerator: float, denominator: float, default: float = 0.0) -> float:
+    """قسمة آمنة (كتفادي القسمة على صفر)."""
+    if abs(denominator) < EPSILON:
+        return default
+    return numerator / denominator
+
+
+def is_zero(value: float, tol: float = EPSILON) -> bool:
+    """واش القيمة قريبة من الصفر؟"""
+    return abs(value) < tol
+
+
+def is_close(a: float, b: float, tol: float = EPSILON) -> bool:
+    """مقارنة آمنة بين float و float."""
+    return abs(a - b) < tol
