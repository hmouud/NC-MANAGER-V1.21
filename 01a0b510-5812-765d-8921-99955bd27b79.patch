+"""Settings Tab — profile, length, angles, steel grade form."""
+
+from PySide6.QtWidgets import (
+    QWidget, QFormLayout, QLineEdit, QDoubleSpinBox,
+    QSpinBox, QLabel, QPushButton, QMenu, QHBoxLayout,
+)
+from PySide6.QtCore import Qt, Signal
+
+from nccorrection.ui._colors import C
+from nccorrection.ui.translations import t as tr
+
+
+class SettingsTab(QWidget):
+    """Left-panel form: order, profile, length, angles, steel type."""
+
+    profile_changed = Signal()
+    canvas_update_requested = Signal()
+
+    def __init__(self, cot_toggle_btn, parent=None, lang_getter=None):
+        super().__init__(parent)
+        self._cot_toggle_btn = cot_toggle_btn
+        self._lang_getter = lang_getter or (lambda: 'en')
+        self._build_form()
+
+    def _build_form(self):
+        form = QFormLayout(self)
+        form.setLabelAlignment(Qt.AlignLeft)
+        form.setSpacing(15)
+
+        # Order
+        self.order_edit = QLineEdit("CHRGUI-BATIMAN H RVE - 2")
+        form.addRow(tr('cp_order', self._lang_getter()), self.order_edit)
+
+        # Profile Type
+        self.btn_profile = QPushButton("IPE240 \u25bc")
+        self.btn_profile.setStyleSheet(
+            f"background-color: {C.accent}; color: white; padding: 6px; "
+            "border-radius: 3px; font-weight: bold; text-align: left;"
+        )
+        self.btn_profile.clicked.connect(self.profile_changed.emit)
+        form.addRow(tr('cp_profile_type', self._lang_getter()), self.btn_profile)
+
+        # Length
+        self.length_spin = QDoubleSpinBox()
+        self.length_spin.setRange(0, 50000)
+        self.length_spin.setSuffix(" mm")
+        self.length_spin.valueChanged.connect(lambda: self.canvas_update_requested.emit())
+        form.addRow(tr('cp_length', self._lang_getter()), self.length_spin)
+
+        # Qty
+        self.qty_spin = QSpinBox()
+        self.qty_spin.setRange(0, 99999)
+        form.addRow(tr('cp_qty', self._lang_getter()), self.qty_spin)
+
+        # Orientation
+        self.orientation_spin = QSpinBox()
+        self.orientation_spin.setRange(0, 360)
+        form.addRow(tr('cp_orientation', self._lang_getter()), self.orientation_spin)
+
+        # Cut angles
+        self.angle_steg_front = QDoubleSpinBox()
+        self.angle_steg_front.setRange(-180, 180)
+        self.angle_steg_front.valueChanged.connect(lambda: self.canvas_update_requested.emit())
+        form.addRow(tr('cp_angle_steg_front', self._lang_getter()), self.angle_steg_front)
+
+        self.angle_steg_rear = QDoubleSpinBox()
+        self.angle_steg_rear.setRange(-180, 180)
+        self.angle_steg_rear.valueChanged.connect(lambda: self.canvas_update_requested.emit())
+        form.addRow(tr('cp_angle_steg_rear', self._lang_getter()), self.angle_steg_rear)
+
+        self.angle_flange_front = QDoubleSpinBox()
+        self.angle_flange_front.setRange(-180, 180)
+        self.angle_flange_front.valueChanged.connect(lambda: self.canvas_update_requested.emit())
+        form.addRow(tr('cp_angle_flange_front', self._lang_getter()), self.angle_flange_front)
+
+        self.angle_flange_rear = QDoubleSpinBox()
+        self.angle_flange_rear.setRange(-180, 180)
+        self.angle_flange_rear.valueChanged.connect(lambda: self.canvas_update_requested.emit())
+        form.addRow(tr('cp_angle_flange_rear', self._lang_getter()), self.angle_flange_rear)
+
+        # Steel Type
+        self.btn_steel = QPushButton("S235JR \u25bc")
+        self.btn_steel.setStyleSheet(
+            f"background-color: {C.green}; color: white; padding: 6px; "
+            "border-radius: 3px; font-weight: bold; text-align: left;"
+        )
+        steel_menu = QMenu(self.btn_steel)
+        steel_menu.setStyleSheet(
+            f"QMenu {{ background-color: {C.panel}; color: white; "
+            f"border: 1px solid {C.line}; }} "
+            f"QMenu::item:selected {{ background-color: {C.green}; }}"
+        )
+        for st in ['S235JR', 'S275JR', 'S355JR', 'S460']:
+            act = steel_menu.addAction(st)
+            act.triggered.connect(lambda checked, s=st: self.btn_steel.setText(f"{s} \u25bc"))
+        self.btn_steel.setMenu(steel_menu)
+        form.addRow(tr('cp_steel_type', self._lang_getter()), self.btn_steel)
+
+        # Cotation toggle
+        cot_row = QHBoxLayout()
+        cot_row.addWidget(self._cot_toggle_btn)
+        cot_lbl = QLabel(tr('cp_cotation', self._lang_getter()))
+        cot_lbl.setStyleSheet(f"color: {C.mut}; font-weight: normal; font-size: 11px;")
+        cot_row.addWidget(cot_lbl)
+        cot_row.addStretch()
+        form.addRow("", cot_row)
