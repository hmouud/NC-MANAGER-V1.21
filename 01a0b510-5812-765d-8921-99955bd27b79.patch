@@ -0,0 +1,302 @@
+"""Tests for :mod:`nccorrection.core.file_factory` — the Create-New NC1 writer.
+
+Step 2 fix: ``build_nc1`` now reads the Steel Engine catalogue so a created
+part carries the correct DSTV ST type letter and the profile's real
+cross-section dimensions — making the 2D/3D renderers draw the chosen profile
+instead of a generic I-beam. Profiles not in the catalogue keep the historic
+fallback (byte-for-byte identical ST output).
+"""
+
+import unittest
+
+from nccorrection.core.file_factory import build_nc1
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.core.part3d import cross_section, profile_kind
+
+
+class BuildNc1CatalogTest(unittest.TestCase):
+    """Catalogue-backed creation: correct type letter + real dimensions."""
+
+    def test_ipe_writes_correct_type_and_real_dims(self):
+        text = build_nc1('B1', 'IPE360', 3700)
+        g = parse_geometry(text)
+        st = g['st']
+        self.assertEqual(st['type'], 'I')
+        dims = st['dims']
+        # IPE360: h=360, b=170, tf=12.7, tw=8.0, r=18.0  (matches the catalogue).
+        self.assertEqual(dims[0], 3700.0)   # length
+        self.assertEqual(dims[1], 360.0)    # depth H
+        self.assertEqual(dims[2], 170.0)    # width b
+        self.assertEqual(dims[3], 12.7)     # flange thickness
+        self.assertEqual(dims[4], 8.0)      # web thickness
+        self.assertEqual(dims[5], 18.0)     # root radius
+
+    def test_square_tube_writes_section_letter(self):
+        # Catalogue kind 'T' (SHS/RHS) maps to the renderer's hollow 'S' section.
+        text = build_nc1('T1', 'SHS100x5', 3000)
+        g = parse_geometry(text)
+        self.assertEqual(g['st']['type'], 'S')
+        dims = g['st']['dims']
+        self.assertEqual(dims[1], 100.0)   # height
+        self.assertEqual(dims[2], 100.0)   # width
+        self.assertEqual(dims[3], 5.0)     # wall
+        cs = cross_section(g['st']['type'], dims)
+        self.assertEqual(len(cs), 4)       # hollow square outline
+        xs = {p[0] for p in cs}
+        ys = {p[1] for p in cs}
+        self.assertEqual(xs, {-50.0, 50.0})
+        self.assertEqual(ys, {-50.0, 50.0})
+
+    def test_rect_tube_writes_width_and_height(self):
+        text = build_nc1('R2', 'RHS200x100x8', 2800)
+        g = parse_geometry(text)
+        self.assertEqual(g['st']['type'], 'S')
+        dims = g['st']['dims']
+        self.assertEqual(dims[1], 200.0)   # height (deep side)
+        self.assertEqual(dims[2], 100.0)   # width
+        self.assertEqual(dims[3], 8.0)     # wall
+
+    def test_round_tube_writes_round_section(self):
+        text = build_nc1('R1', 'CHS60x3', 2500)
+        g = parse_geometry(text)
+        self.assertEqual(g['st']['type'], 'O')
+        dims = g['st']['dims']
+        self.assertEqual(dims[1], 60.0)
+        self.assertEqual(dims[2], 60.0)
+        self.assertEqual(dims[3], 3.0)
+        self.assertEqual(profile_kind('O'), 'prism')
+        self.assertEqual(len(cross_section('O', dims)), 24)
+
+    def test_plate_writes_plate_letter(self):
+        text = build_nc1('P1', 'PL10', 2000)
+        g = parse_geometry(text)
+        self.assertEqual(g['st']['type'], 'B')
+        dims = g['st']['dims']
+        # dims[2] is the plate thickness the parser reads for a 'B' profile.
+        self.assertEqual(dims[2], 10.0)
+        self.assertEqual(profile_kind('B'), 'plate')
+
+    def test_catalog_round_trip_through_cross_section(self):
+        # The whole point of Step 2: the produced ST block feeds the renderer a
+        # real profile, not a generic I-beam.
+        for name, exp_type in [('IPE360', 'I'), ('SHS100x5', 'S'),
+                               ('CHS60x3', 'O'), ('PL10', 'B')]:
+            text = build_nc1('X', name, 1000)
+            g = parse_geometry(text)
+            self.assertEqual(g['st']['type'], exp_type, name)
+
+
+class BuildNc1FallbackTest(unittest.TestCase):
+    """Non-catalogue profiles keep the historic heuristic unchanged."""
+
+    def test_alpha_bearing_unknown_is_ibeam(self):
+        # HEA9999 is NOT in the catalogue: historic alpha-bearing fallback ->
+        # 'I' with the old generic dims (h=0, b=thickness or 8).
+        text = build_nc1('H1', 'HEA9999', 2000)
+        g = parse_geometry(text)
+        self.assertEqual(g['st']['type'], 'I')
+        dims = g['st']['dims']
+        self.assertEqual(dims[0], 2000.0)
+        self.assertEqual(dims[1], 0.0)
+        self.assertEqual(dims[2], 0.0)
+        self.assertEqual(dims[3], 8.0)
+        self.assertEqual(dims[4], 8.0)
+        self.assertEqual(dims[5], 8.0)
+
+    def test_thickness_argument_still_used_in_fallback(self):
+        # The optional ``thickness`` parameter drives the fallback width,
+        # exactly as before the Step 2 change. HEA9999 is non-catalogue and
+        # alpha-bearing (never pure 'X'), so it hits the historic 'I' branch.
+        text = build_nc1('W1', 'HEA9999', 1500, thickness=12.5)
+        g = parse_geometry(text)
+        dims = g['st']['dims']
+        self.assertEqual(dims[3], 12.5)
+        self.assertEqual(dims[4], 12.5)
+
+    def test_structure_has_expected_blocks(self):
+        for name in ('IPE360', 'HEA9999', 'SHS100x5', 'PL10'):
+            text = build_nc1('M', name, 1200)
+            self.assertIn('ST', text)
+            self.assertIn('AK', text)
+            self.assertIn('EN', text)
+            self.assertTrue(text.rstrip().endswith('EN'))
+
+
+class BuildNc1FaceTest(unittest.TestCase):
+    """Step 3: the AK block carries the real machining faces per family, so
+    the 2D/blueprint shows the chosen profile instead of a single web."""
+
+    def _faces(self, mark, profile, length):
+        from nccorrection.engine.parser.dstv_parser import DstvParser
+        text = build_nc1(mark, profile, length)
+        part = DstvParser().parse_text(text)
+        return {code: face for code, face in part.faces.items()}
+
+    def test_ipe_writes_all_four_faces(self):
+        faces = self._faces('B2', 'IPE360', 3700)
+        # I-beam: web v + flanges o/u + rear web h.
+        self.assertEqual(set(faces), {'v', 'o', 'u', 'h'})
+        # Web height = depth 360, flange width = b 170.
+        self.assertEqual(len(faces['v'].outer_contour.vertices), 4)
+        ys = {round(v.y, 2) for v in faces['v'].outer_contour.vertices}
+        self.assertEqual(ys, {0.0, 360.0})
+        os_ys = {round(v.y, 2) for v in faces['o'].outer_contour.vertices}
+        self.assertEqual(os_ys, {0.0, 170.0})
+        us_ys = {round(v.y, 2) for v in faces['u'].outer_contour.vertices}
+        self.assertEqual(us_ys, {0.0, 170.0})
+
+    def test_square_tube_writes_front_and_rear(self):
+        faces = self._faces('T2', 'SHS100x5', 3000)
+        self.assertEqual(set(faces), {'v', 'h'})
+        ys = {round(v.y, 2) for v in faces['v'].outer_contour.vertices}
+        self.assertEqual(ys, {0.0, 100.0})
+
+    def test_round_tube_writes_front_and_rear(self):
+        faces = self._faces('R3', 'CHS60x3', 2500)
+        self.assertEqual(set(faces), {'v', 'h'})
+        ys = {round(v.y, 2) for v in faces['v'].outer_contour.vertices}
+        self.assertEqual(ys, {0.0, 60.0})
+
+    def test_plate_writes_front_and_rear(self):
+        faces = self._faces('P2', 'PL10', 2000)
+        self.assertEqual(set(faces), {'v', 'h'})
+        xs = {round(v.x, 2) for v in faces['v'].outer_contour.vertices}
+        self.assertEqual(xs, {0.0, 2000.0})
+
+    def test_fallback_ibeam_still_gets_all_faces(self):
+        # Non-catalogue HEA9999 -> I fallback must no longer show a single
+        # degenerate web; it gets the full v/o/u/h set (default 100 heights).
+        faces = self._faces('H2', 'HEA9999', 2000)
+        self.assertEqual(set(faces), {'v', 'o', 'u', 'h'})
+
+    def test_hea_catalog_writes_real_dims(self):
+        # HEA300 IS in the catalogue since Step 1: real type letter + dims.
+        text = build_nc1('H9', 'HEA300', 2000)
+        g = parse_geometry(text)
+        st = g['st']
+        self.assertEqual(st['type'], 'I')
+        dims = st['dims']
+        # HEA300: h=290, b=300, tf=14, tw=8.5, r=27 (matches the catalogue).
+        self.assertEqual(dims[1], 290.0)
+        self.assertEqual(dims[2], 300.0)
+        self.assertEqual(dims[3], 14.0)   # flange thickness
+        self.assertEqual(dims[4], 8.5)    # web thickness
+        self.assertEqual(dims[5], 27.0)   # root radius
+
+    def test_upn_channel_writes_channel_type_and_real_dims(self):
+        # Step 1: UPN200 -> DSTV 'U' with the same flange-first dims order the
+        # app's real UPN200 ST fixture uses ([L, H, b, tf, tw, r, ...]).
+        text = build_nc1('U1', 'UPN200', 3000)
+        g = parse_geometry(text)
+        st = g['st']
+        self.assertEqual(st['type'], 'U')
+        dims = st['dims']
+        self.assertEqual(dims[0], 3000.0)  # length
+        self.assertEqual(dims[1], 200.0)   # depth H
+        self.assertEqual(dims[2], 75.0)    # width b
+        self.assertEqual(dims[3], 11.5)    # flange thickness
+        self.assertEqual(dims[4], 8.5)     # web thickness
+        self.assertEqual(dims[5], 11.5)    # root radius
+        # cross_section resolves the channel section (prism family)
+        self.assertEqual(profile_kind('U'), 'prism')
+        self.assertTrue(cross_section('U', dims))
+
+    def test_catalog_round_trip_through_cross_section(self):
+        # The whole point of Step 2: the produced ST block feeds the renderer a
+        # real profile, not a generic I-beam.
+        for name, exp_type in [('IPE360', 'I'), ('SHS100x5', 'S'),
+                               ('CHS60x3', 'O'), ('PL10', 'B'),
+                               ('HEA300', 'I'), ('UPN200', 'U'),
+                               ('L80x8', 'L')]:
+            text = build_nc1('X', name, 1000)
+            g = parse_geometry(text)
+            self.assertEqual(g['st']['type'], exp_type, name)
+
+    def test_l_angle_writes_two_legs(self):
+        # Step 1: L80x8 -> DSTV 'L'; the AK block carries the two angle legs
+        # v/u with the leg size as the contour height (equal-leg 80).
+        faces = self._faces('A1', 'L80x8', 2500)
+        self.assertEqual(set(faces), {'v', 'u'})
+        ys = {round(v.y, 2) for v in faces['v'].outer_contour.vertices}
+        self.assertEqual(ys, {0.0, 80.0})
+        us_ys = {round(v.y, 2) for v in faces['u'].outer_contour.vertices}
+        self.assertEqual(us_ys, {0.0, 80.0})
+
+    def test_upn_channel_writes_all_four_faces(self):
+        # Step 1: a channel exposes the same four machining faces as an
