+                    p.setPen(QPen(QColor('#38bdf8'), 1.0))
+                    p.setBrush(QColor(15, 23, 42, 230))
+                    p.drawRoundedRect(hud_rect, 4, 4)
+                    p.setPen(QColor('#fbbf24'))
+                    p.drawText(hud_rect, Qt.AlignCenter, slot_hud)
+                continue
+            col = QColor('#fbbf24') if active else hole_col
+            p.setPen(QPen(col, 1.2 if active else 0.9))
+            p.setBrush(QColor(0, 0, 0, 60) if not active else QColor(251, 191, 36, 70))
+            p.drawEllipse(QPointF(sx, sy), r, r)
+            if not active:
