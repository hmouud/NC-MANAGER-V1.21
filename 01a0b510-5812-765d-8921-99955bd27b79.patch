+"""Profile Library popup — filterable catalog browser."""
+
+from PySide6.QtWidgets import (
+    QDialog, QVBoxLayout, QHBoxLayout, QLineEdit,
+    QPushButton, QListWidget,
+)
+import nccorrection.engine.steel_engine.catalog as catalog
+from nccorrection.ui._colors import C
+from nccorrection.ui.translations import t as tr
+
+
+class ProfileLibraryDialog(QDialog):
+    """Standalone popup listing all steel profiles with search filter."""
+
+    def __init__(self, parent=None, lang_getter=None):
+        super().__init__(parent)
+        self._lang_getter = lang_getter or (lambda: 'en')
+        self.setWindowTitle(tr('cp_select_profile', self._lang_getter()))
+        self.setFixedSize(400, 300)
+        self.setStyleSheet(f"background-color: {C.panel}; color: {C.txt};")
+        self._selected: str | None = None
+
+        layout = QVBoxLayout(self)
+
+        # Search
+        self._search = QLineEdit()
+        self._search.setPlaceholderText(tr('cp_filter', self._lang_getter()))
+        self._search.setStyleSheet(
+            f"background-color: {C.bg}; color: {C.txt}; "
+            f"border: 1px solid {C.line}; padding: 4px; border-radius: 2px;"
+        )
+        self._search.textChanged.connect(self._filter)
+        layout.addWidget(self._search)
+
+        # List
+        self._list = QListWidget()
+        self._list.setStyleSheet(
+            f"QListWidget {{ background-color: {C.bg}; color: {C.txt}; "
+            f"border: 1px solid {C.line}; outline: none; }}"
+            "QListWidget::item { padding: 4px 8px; }"
+            f"QListWidget::item:selected {{ background-color: {C.accent}; color: white; }}"
+            "QListWidget::item:hover { background-color: #1e3a5f; }"
+        )
+        for name in sorted(catalog._CATALOG.keys()):
+            self._list.addItem(name)
+        self._list.itemDoubleClicked.connect(lambda item: self._pick(item.text()))
+        layout.addWidget(self._list)
+
+        # Select button
+        btn_row = QHBoxLayout()
+        btn_row.addStretch()
+        self._btn_select = QPushButton(tr('cp_select', self._lang_getter()))
+        self._btn_select.setStyleSheet(
+            f"QPushButton {{ background-color: {C.accent}; color: white; "
+            f"padding: 6px 16px; border-radius: 3px; font-weight: bold; }}"
+            "QPushButton:hover { background-color: #005f9e; }"
+        )
+        self._btn_select.clicked.connect(self._on_select)
+        btn_row.addWidget(self._btn_select)
+        layout.addLayout(btn_row)
+
+    # -- helpers --
+
+    def _filter(self, text: str):
+        low = text.lower()
+        for i in range(self._list.count()):
+            item = self._list.item(i)
+            item.setHidden(low not in item.text().lower())
+
+    def _on_select(self):
+        item = self._list.currentItem()
+        if item:
+            self._pick(item.text())
+
+    def _pick(self, name: str):
+        self._selected = name
+        self.accept()
+
+    def selected_name(self) -> str | None:
+        return self._selected
