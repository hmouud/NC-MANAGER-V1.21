+class SprocketShape(PlateShape):
+    """Simple sprocket (circle with teeth)."""
+    name = "Sprocket"
+    category = "Special"
+    parameters = [
+        ShapeParam("Pitch radius", "pitch_radius", 80.0, 5.0, 5000.0),
+        ShapeParam("Tooth height", "tooth_height", 10.0, 1.0, 2000.0),
+        ShapeParam("Number of teeth", "n_teeth", 12.0, 3.0, 120.0),
+        ShapeParam("Bore radius", "bore_radius", 15.0, 0.0, 4999.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["pitch_radius"]
+        th = p["tooth_height"]
+        n = int(p["n_teeth"])
+        br = p["bore_radius"]
+        r_base = R - th / 2
+        r_tip = R + th / 2
+        tooth_half = 180.0 / n * 0.6
+        outer = []
+        for i in range(n):
+            a = 90.0 + 360.0 * i / n
+            # Base left
+            a1 = a - tooth_half
+            a2 = a + tooth_half
+            outer.append((r_base * math.cos(math.radians(a1)),
+                          r_base * math.sin(math.radians(a1))))
+            outer.append((r_tip * math.cos(math.radians(a1)),
+                          r_tip * math.sin(math.radians(a1))))
+            outer.append((r_tip * math.cos(math.radians(a2)),
+                          r_tip * math.sin(math.radians(a2))))
+            outer.append((r_base * math.cos(math.radians(a2)),
+                          r_base * math.sin(math.radians(a2))))
+        inners = [_circle_pts(0, 0, br)] if br > 1.0 else []
+        return ShapeResult(outer=outer, inners=inners)
