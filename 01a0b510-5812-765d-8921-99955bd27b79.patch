+"""Tests for the Steel Engine profile catalogue (Phase 1 + CTO Option A)."""
+import unittest
+
+
+class SteelCatalogTest(unittest.TestCase):
+    def setUp(self):
+        from nccorrection.engine.steel_engine.catalog import (
+            get_profile, iter_profiles, profile_names, catalogue_stats,
+            has_profile)
+        self.get = get_profile
+        self.iter = iter_profiles
+        self.names = profile_names
+        self.stats = catalogue_stats
+        self.has = has_profile
+
+    def test_ipe_range_complete(self):
+        # IPE entries are the stable leading family; the unified catalogue
+        # also carries tubes (kind T/O) and plates (B) appended after them.
+        all_names = self.names()
+        expected_ipe = [f'IPE{n}' for n in (
+            80, 100, 120, 140, 160, 180, 200, 220, 240,
+            270, 300, 330, 360, 400, 450, 500, 550, 600)]
+        expected_ipe += ['IPE750x134', 'IPE750x137']
+        self.assertEqual(all_names[:len(expected_ipe)], expected_ipe)
+        # tubes + plates present after the IPE block
+        for extra in ('SHS100x5', 'RHS200x100x8', 'CHS60x3', 'PL10'):
+            self.assertIn(extra, all_names)
+
+    def test_ipe300_reference_values(self):
+        p = self.get('IPE300')
+        self.assertIsNotNone(p)
+        # EN 10365 published section properties
+        self.assertEqual(p.area, 5380.0)   # mm²
+        self.assertEqual(p.depth, 300.0)   # h mm
+        self.assertEqual(p.width, 150.0)   # b mm
+        self.assertEqual(p.ix, 8360.0)     # cm⁴
+        self.assertEqual(p.iy, 604.0)      # cm⁴
+
+    def test_lenient_lookup(self):
+        self.assertIs(self.get('ipe 300'), self.get('IPE300'))
+        self.assertIs(self.get('IPE-300'), self.get('IPE300'))
+        # HEA500 IS in the catalogue since the Step-1 completion; an unknown
+        # designation must still return None (never an invented row).
+        self.assertIs(self.get('hea 500'), self.get('HEA500'))
+        self.assertIsNone(self.get('HEA9999'))
+        self.assertFalse(self.has('W14x22'))
+
+    def test_derived_weight(self):
+        # IPE300: A=5380 mm² -> 5380*7.85e-6 kg/mm per metre
+        p = self.get('IPE300')
+        self.assertAlmostEqual(p.weight_per_m, 5380.0 * 7850e-9 * 1000.0, places=6)
+        self.assertAlmostEqual(p.weight_per_m, 42.23, places=2)
+
+    _BENDING_FIELDS = ('area', 'depth', 'width', 'ix', 'iy', 'web_thick',
+                       'flange_thick', 'root_radius', 'wpl_x', 'wpl_y')
+
+    def test_all_rows_have_fields(self):
+        for p in self.iter():
+            for field in ('name', 'kind', 'depth', 'width', 'web_thick'):
+                self.assertTrue(getattr(p, field), f'{p.name} field {field}')
+            if p.kind == 'B':
+                # plates carry no bending props (ix/iy/wpl/r = 0 by design)
+                self.assertEqual(p.ix, 0.0)
+                self.assertEqual(p.iy, 0.0)
+            else:
+                for field in ('area', 'ix', 'iy', 'flange_thick'):
+                    self.assertGreater(getattr(p, field), 0.0,
+                                       f'{p.name} field {field}')
+
+    def test_stats(self):
+        s = self.stats()
+        # 20 IPE + 24 HEA + 24 HEB + 14 HEM + 16 UPN + 14 UPE + 20 L
+        # + 30 SHS + 25 RHS + 23 CHS + 12 RB + 16 FB + 16 plates = 254
+        self.assertEqual(s['count'], 254)
+        self.assertEqual(s['first'], 'IPE80')
+        self.assertEqual(s['last'], 'PL100')
+        # family counts
+        self.assertEqual(s['families']['I'], 82)   # 20 IPE + 24 HEA + 24 HEB + 14 HEM
+        self.assertEqual(s['families']['T'], 55)   # SHS + RHS
+        self.assertEqual(s['families']['O'], 35)   # 23 CHS + 12 RB
+        self.assertEqual(s['families']['U'], 30)   # 16 UPN + 14 UPE
+        self.assertEqual(s['families']['L'], 20)
+        self.assertEqual(s['families']['FB'], 16)  # flat bars
+        # depth/weight ranges ignore plates (rolled only)
+        # min rolled depth = RB10 (10 mm); max = HEB1000 (1000 mm)
+        self.assertEqual(s['depth_range_mm'], (10.0, 1000.0))
+        # lightest rolled section is RB10 (0.62 kg/m)
+        self.assertLess(s['weight_range_kg_per_m'][0], 0.65)
+
+    # ---- New families: tubes (T / O) and plates (B) ----
+    def test_shs_square_tube(self):
+        p = self.get('SHS100x5')
+        self.assertIsNotNone(p)
+        self.assertEqual(p.kind, 'T')
+        self.assertEqual(p.depth, 100.0)   # B
+        self.assertEqual(p.width, 100.0)   # b = B for square
+        self.assertEqual(p.web_thick, 5.0)  # wall t
+        self.assertEqual(p.flange_thick, 5.0)
+        self.assertEqual(p.area, 1860.0)   # mm²
+        self.assertAlmostEqual(p.weight_per_m, 1860.0 * 7850e-9 * 1000.0,
+                               places=6)
+
+    def test_rhs_rectangular_tube(self):
+        p = self.get('RHS200x100x8')
+        self.assertIsNotNone(p)
+        self.assertEqual(p.kind, 'T')
+        self.assertEqual(p.depth, 200.0)   # h
+        self.assertEqual(p.width, 100.0)   # b
+        self.assertEqual(p.web_thick, 8.0)
+        self.assertEqual(p.ix, 1829.0)     # major (cm⁴)
+        self.assertEqual(p.iy, 547.0)      # minor (cm⁴)
+
+    def test_round_tube(self):
+        p = self.get('CHS60x3')
+        self.assertIsNotNone(p)
+        self.assertEqual(p.kind, 'O')       # round selectable by part3d
+        self.assertEqual(p.depth, 60.0)     # OD
+        self.assertEqual(p.width, 60.0)
+        self.assertEqual(p.web_thick, 3.0)  # WT
+        self.assertEqual(p.area, 537.0)
+
+    def test_plate_lookup(self):
+        p = self.get('PL10')
+        self.assertIsNotNone(p)
+        self.assertEqual(p.kind, 'B')
+        self.assertTrue(p.is_plate)
+        self.assertEqual(p.flange_thick, 10.0)  # plate thickness
+        self.assertEqual(p.width, 1250.0)
+        self.assertEqual(p.depth, 2500.0)
