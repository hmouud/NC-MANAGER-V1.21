+    name = "Rectangular Ref Plate"
+    category = "Special"
+    parameters = [
+        ShapeParam("Height", "height", 200.0, 5.0, 10000.0),
+        ShapeParam("Width", "width", 150.0, 5.0, 10000.0),
+        ShapeParam("Hole diameter", "hole_d", 10.0, 1.0, 500.0),
+        ShapeParam("Edge distance", "edge_dist", 20.0, 1.0, 5000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h = p["width"], p["height"]
+        hd = p["hole_d"]
+        ed = min(p["edge_dist"], w / 2 - hd / 2, h / 2 - hd / 2)
+        outer = [(-w / 2, -h / 2), (w / 2, -h / 2),
+                 (w / 2, h / 2), (-w / 2, h / 2)]
+        holes = [
+            {'x': -w / 2 + ed, 'y': -h / 2 + ed, 'd': hd},
+            {'x': w / 2 - ed, 'y': -h / 2 + ed, 'd': hd},
+            {'x': w / 2 - ed, 'y': h / 2 - ed, 'd': hd},
+            {'x': -w / 2 + ed, 'y': h / 2 - ed, 'd': hd},
+            {'x': 0, 'y': 0, 'd': hd},
+        ]
+        return ShapeResult(outer=outer, holes=holes)
+
+
+# ════════════════════════════════════════════════════════════════════
+#  NEW SHAPES — Phase 2 additions
+# ════════════════════════════════════════════════════════════════════
+
+class EllipseShape(PlateShape):
+    """Ellipse plate (stretched circle)."""
+    name = "Ellipse"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Major axis (X)", "rx", 100.0, 5.0, 10000.0),
+        ShapeParam("Minor axis (Y)", "ry", 60.0, 5.0, 10000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        rx, ry = p["rx"], p["ry"]
+        n = 64
+        outer = [(rx * math.cos(2 * math.pi * i / n),
+                  ry * math.sin(2 * math.pi * i / n)) for i in range(n)]
+        return ShapeResult(outer=outer)
+
+
+class HexagonShape(PlateShape):
+    """Regular hexagon plate."""
+    name = "Hexagon"
+    category = "Special"
+    parameters = [
+        ShapeParam("Across flats", "af", 100.0, 5.0, 10000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        af = p["af"]
+        r = af / 2.0  # radius across flats
+        # Hexagon points: 30° offset for flat-top
+        outer = [(r * math.cos(math.radians(60 * i + 30)),
+                  r * math.sin(math.radians(60 * i + 30))) for i in range(6)]
+        return ShapeResult(outer=outer)
+
+
+class OctagonShape(PlateShape):
+    """Regular octagon plate."""
+    name = "Octagon"
+    category = "Special"
+    parameters = [
+        ShapeParam("Across flats", "af", 100.0, 5.0, 10000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        af = p["af"]
+        r = af / 2.0
+        outer = [(r * math.cos(math.radians(45 * i + 22.5)),
+                  r * math.sin(math.radians(45 * i + 22.5))) for i in range(8)]
+        return ShapeResult(outer=outer)
+
+
+class DiamondShape(PlateShape):
+    """Diamond / rhombus plate."""
+    name = "Diamond"
+    category = "Triangular"
+    parameters = [
+        ShapeParam("Width", "width", 120.0, 5.0, 10000.0),
+        ShapeParam("Height", "height", 80.0, 5.0, 10000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h = p["width"], p["height"]
+        outer = [(0, -h / 2), (w / 2, 0), (0, h / 2), (-w / 2, 0)]
+        return ShapeResult(outer=outer)
+
+
+class CrossShape(PlateShape):
+    """Cross / plus-sign plate."""
+    name = "Cross"
+    category = "Special"
+    parameters = [
+        ShapeParam("Arm length", "arm", 100.0, 5.0, 10000.0),
+        ShapeParam("Arm width", "w", 40.0, 5.0, 10000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        arm, w = p["arm"], p["w"]
+        h = arm / 2.0
+        hw = w / 2.0
+        # Plus shape: 12 vertices
+        outer = [
+            (-hw, -h), (hw, -h), (hw, -hw), (h, -hw),
+            (h, hw), (hw, hw), (hw, h), (-hw, h),
+            (-hw, hw), (-h, hw), (-h, -hw), (-hw, -hw),
+        ]
+        return ShapeResult(outer=outer)
+
+
+class TShape(PlateShape):
+    """T-shaped plate."""
+    name = "T-Plate"
+    category = "Special"
+    parameters = [
+        ShapeParam("Flange width", "flange_w", 120.0, 5.0, 10000.0),
+        ShapeParam("Flange thickness", "flange_t", 20.0, 1.0, 500.0),
+        ShapeParam("Web height", "web_h", 100.0, 5.0, 10000.0),
+        ShapeParam("Web thickness", "web_t", 15.0, 1.0, 500.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        fw, ft = p["flange_w"], p["flange_t"]
+        wh, wt = p["web_h"], p["web_t"]
+        hw = fw / 2.0
+        hwt = wt / 2.0
+        # T shape: flange top, web bottom
+        outer = [
+            (-hw, 0), (hw, 0), (hw, ft), (hwt, ft),
+            (hwt, ft + wh), (-hwt, ft + wh), (-hwt, ft), (-hw, ft),
+        ]
+        return ShapeResult(outer=outer)
+
+
+class UShape(PlateShape):
+    """U-shaped plate (channel cross-section as plate)."""
+    name = "U-Plate"
+    category = "Special"
+    parameters = [
+        ShapeParam("Width", "width", 120.0, 5.0, 10000.0),
+        ShapeParam("Height", "height", 100.0, 5.0, 10000.0),
+        ShapeParam("Thickness", "t", 15.0, 1.0, 500.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h, t = p["width"], p["height"], p["t"]
+        hw = w / 2.0
+        # U shape: open at top
+        outer = [
+            (-hw, 0), (hw, 0), (hw, h), (hw - t, h),
+            (hw - t, t), (-hw + t, t), (-hw + t, h), (-hw, h),
+        ]
+        return ShapeResult(outer=outer)
+
+
+# ════════════════════════════════════════════════════════════════════
+#  LIBRARY  (registry of all shapes)
+# ════════════════════════════════════════════════════════════════════
+
+SHAPE_LIBRARY: List[PlateShape] = [
+    # --- Circular ---
+    CircleShape(),
+    RingShape(),
+    FlatSidedCircleShape(),
+    BoltHoleCircleShape(),
+    CircularFlangeShape(),
+    CircFlangeDiamsShape(),
+    CircleWithRadialSlotsShape(),
+    CircFlangeWithRadialSlotsShape(),
+    CircFlangeWithSlotsShape(),
+    CircFlangeWithKeyholesShape(),
+    DualFlatSidedCircleShape(),
+    # --- Rectangular ---
+    RectangleShape(),
+    RoundedRectangleShape(),
+    TombstoneShape(),
+    ClippedRectangleShape(),
+    NotchedRectangleShape(),
+    NotchedCornerRectangleShape(),
+    BoltHoleRectangleShape(),
+    SlottedRectangleShape(),
+    RectangularFlangeShape(),
+    RectangularRectFlangeShape(),
+    CenterPointRoundedRectShape(),
+    # --- Triangular ---
+    RightTriangleShape(),
+    ClippedRightTriangleShape(),
+    ConcaveRightTriangleShape(),
+    GeneralTriangleShape(),
+    GeneralPolygonShape(),
+    WedgeShape(),
+    ArcSectionShape(),
+    GussetShape(),
+    # --- Brackets ---
+    LBracketShape(),
+    LBracketDistinctRadiiShape(),
+    UBracketShape(),
+    RoundedLBracketShape(),
+    QuadrilateralShape(),
+    LugShape(),
+    TopBearingGussetShape(),
+    BottomBearingGussetShape(),
+    # --- Arc ---
+    ArcTrapezoidShape(),
+    ArcTrapezoidWithHoleShape(),
+    # --- Special ---
+    SheaveShape(),
+    PaddleShape(),
+    RightCircularConeShape(),
+    SingleCogShape(),
+    SprocketShape(),
+    RoundRefPlateShape(),
+    SideEjectorPlateShape(),
+    RazorBladeShape(),
+    BeltGuardShape(),
+    MultiTabbedPaddleShape(),
+    RectangularRefPlateShape(),
+    # --- New Phase 2 shapes ---
+    EllipseShape(),
+    HexagonShape(),
+    OctagonShape(),
+    DiamondShape(),
+    CrossShape(),
+    TShape(),
+    UShape(),
+]
+
+# Deduplicate by name (keep first occurrence)
+_seen_names = set()
+_SHAPE_LIBRARY: List[PlateShape] = []
+for _s in SHAPE_LIBRARY:
+    if _s.name not in _seen_names:
+        _seen_names.add(_s.name)
+        _SHAPE_LIBRARY.append(_s)
+SHAPE_LIBRARY = _SHAPE_LIBRARY
+
+_SHAPE_MAP = {s.name: s for s in SHAPE_LIBRARY}
+
+# Category index for the filter UI
+CATEGORIES = sorted(set(s.category for s in SHAPE_LIBRARY))
+
+
+def get_shape(name: str) -> Optional[PlateShape]:
+    """Look up a shape by display name."""
+    return _SHAPE_MAP.get(name)
+
+
+def list_shapes() -> List[str]:
+    """Return all registered shape names (in library order)."""
+    return [s.name for s in SHAPE_LIBRARY]
+
+
+def shapes_by_category(category: str) -> List[PlateShape]:
+    """Return shapes filtered by category name."""
+    if category == "All":
+        return list(SHAPE_LIBRARY)
+    return [s for s in SHAPE_LIBRARY if s.category == category]
