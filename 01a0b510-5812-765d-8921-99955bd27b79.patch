+        self.assertAlmostEqual(h.angle, 45.00)
+        self.assertAlmostEqual(h.slot_width, 20.00)
+        self.assertAlmostEqual(h.diameter, 20.00)
+
+    def test_angular_slot_with_l_marker_and_suffixes(self):
+        # l-marker (0.00l) on the 4th token + suffix letters on other tokens.
+        h = self._parse_slot_line('v 40.00o 50.00h 20.00s 0.00l 100.00u 45.00')
+        self.assertTrue(h.is_slot)
+        self.assertAlmostEqual(h.slot_length, 100.00)
+        self.assertAlmostEqual(h.angle, 45.00)
+        self.assertAlmostEqual(h.slot_width, 20.00)
