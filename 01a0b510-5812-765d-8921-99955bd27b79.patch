+class TestFoldFaceParts(unittest.TestCase):
+    """Face splitting at the bend boundary -- the skewed-triangle fix
+    (Owner bug report 2026-09-13): a face that straddles a bend line must
+    be cut before the rigid rotation, or it becomes non-planar."""
+
+    # A 1000x200 flat top face (z=0) crossing the vertical bend at x=400.
+    RECT = [(0.0, 0.0, 0.0), (1000.0, 0.0, 0.0),
+            (1000.0, 200.0, 0.0), (0.0, 200.0, 0.0)]
+
+    # A 6-vertex face with an interior notch: on the flap side the vertices
+    # sit at DIFFERENT distances from the bend line (1000mm vs 600mm), which
+    # is what the real 22-point plate face does -- folding it unsplit cannot
+    # stay planar.
+    NOTCHED = [(0.0, 0.0, 0.0), (1000.0, 0.0, 0.0), (1000.0, 100.0, 0.0),
+               (600.0, 100.0, 0.0), (600.0, 200.0, 0.0), (0.0, 200.0, 0.0)]
+
+    def test_unsplit_face_becomes_non_planar(self):
+        """Regression witness: folding the straddling NOTCHED face WITHOUT
+        splitting produces a non-planar (skewed) face -- the reported
+        artefact. (A plain rectangle stays planar by coincidence: every
+        flap vertex is the same distance from the line.)"""
+        folded = fold_mesh_vertices([BEND_90], list(self.NOTCHED))
+        self.assertFalse(_coplanar(folded))
+
+    def test_split_face_parts_all_planar(self):
+        parts = fold_face_parts([BEND_90], list(self.RECT))
+        self.assertGreaterEqual(len(parts), 2)
+        for part in parts:
+            self.assertTrue(_coplanar(part))
+
+    def test_split_notched_face_parts_all_planar(self):
+        parts = fold_face_parts([BEND_90], list(self.NOTCHED))
+        self.assertGreaterEqual(len(parts), 2)
+        for part in parts:
+            self.assertTrue(_coplanar(part))
+
+    def test_vertical_90_flap_becomes_wall(self):
+        parts = fold_face_parts([BEND_90], list(self.RECT))
+        # exactly one part folds: it must lie on the wall plane x = 400
+        wall = [p for p in parts if any(abs(pt[2]) > 1e-3 for pt in p)]
+        self.assertEqual(len(wall), 1)
+        for pt in wall[0]:
+            self.assertAlmostEqual(pt[0], 400.0)
+            self.assertGreaterEqual(pt[2], -1e-9)
+
+    def test_horizontal_bend_parts_planar(self):
+        parts = fold_face_parts([BEND_H], list(self.RECT))
+        for part in parts:
+            self.assertTrue(_coplanar(part))
+
+    def test_hole_wall_face_stays_planar(self):
+        """A face already lying on the z=thickness plane of the SAME flap
+        side only (e.g. a rim square) keeps its planarity."""
+        rim = [(420.0, 40.0, 10.0), (480.0, 40.0, 10.0),
+               (480.0, 60.0, 10.0), (420.0, 60.0, 10.0)]
+        parts = fold_face_parts([BEND_90], rim)
+        for part in parts:
+            self.assertTrue(_coplanar(part))
+
+    def test_face_normal_orients_with_wall(self):
+        """After a 90-deg fold the on-flap sub-face normal rotates with the
+        material: the original +Z becomes -X (pointing back at the base) --
+        a rigid rotation, no winding flip (Newell on the folded CCW vertex
+        order gives exactly (-1, 0, 0) for this geometry)."""
+        parts = fold_face_parts([BEND_90], list(self.RECT))
+        wall = [p for p in parts if any(abs(pt[2]) > 1e-3 for pt in p)]
+        self.assertEqual(len(wall), 1)
+        n = face_normal(wall[0])
+        self.assertAlmostEqual(n[0], -1.0)   # rotated +Z -> -X
+        self.assertAlmostEqual(n[1], 0.0)
+        self.assertAlmostEqual(n[2], 0.0)    # no longer +Z
+
+    def test_face_normal_unit_length(self):
+        n = face_normal(self.RECT)
+        self.assertAlmostEqual(math.sqrt(n[0] ** 2 + n[1] ** 2 + n[2] ** 2),
+                               1.0)
+        self.assertAlmostEqual(n[2], 1.0)  # flat CCW top face -> +Z
+
+
+if __name__ == '__main__':
+    unittest.main()
