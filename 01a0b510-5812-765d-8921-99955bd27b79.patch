+        fb.set_part(part)
+        fb.set_mode('measure')
+        canvas = {code: tc for code, _f, _s, tc, _fc in fb._snap_canvases()}
+        tc = canvas.get('v')
+        sx, sy = tc(500.0, 145.0)
+        fb.mousePressEvent(_press(sx, sy))
+        self.assertIsNotNone(fb._m1)
+        fb.mousePressEvent(_press(sx, sy, Qt.RightButton))
+        self.assertIsNone(fb._m1)  # cancelled, NO small cancel-menu popup
+        fb.mousePressEvent(_press(sx, sy, Qt.RightButton))
+        self.assertIsNone(fb._m1)  # falls through to the app menu, no crash
