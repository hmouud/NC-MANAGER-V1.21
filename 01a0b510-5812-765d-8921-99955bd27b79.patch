+"""Tests for the Y input modes (abs / sym / top)."""
+
+import unittest
+
+from nccorrection.core.input_mode import (
+    absolute_y, relative_y, y_span, y_centre)
+
+
+class TestYInputModes(unittest.TestCase):
+
+    HEA = ['6000', '300', '150', '10', '6']   # [L, H, b, tf, tw]
+    UPN = ['6000', '300', '100', '8', '12']   # [L, H, b, tw, tf]
+    L    = ['6000', '100', '60', '6']         # [L, a, b, t]
+    PL   = ['6000', '200', '12']              # [L, width, thickness]
+
+    # ----------------------------------------------------------- spans
+    def test_spans_follow_face_geometry(self):
+        self.assertEqual(y_span('I', self.HEA, 'v'), 300.0)   # web H
+        self.assertEqual(y_span('I', self.HEA, 'h'), 300.0)
+        self.assertEqual(y_span('I', self.HEA, 'o'), 150.0)   # flange b
+        self.assertEqual(y_span('I', self.HEA, 'u'), 150.0)
+        self.assertEqual(y_span('U', self.UPN, 'v'), 300.0)
+        self.assertEqual(y_span('U', self.UPN, 'u'), 100.0)
+        self.assertEqual(y_span('L', self.L, 'v'), 60.0)      # vertical leg b
+        self.assertEqual(y_span('L', self.L, 'u'), 100.0)     # horizontal leg a
+        self.assertEqual(y_span('B', self.PL, 'v'), 200.0)    # width
+        self.assertEqual(y_centre('I', self.HEA, 'v'), 150.0)
+        self.assertEqual(y_centre('I', self.HEA, 'u'), 75.0)
+
+    def test_unknown_family_falls_back_to_abs(self):
+        self.assertEqual(y_span('NOPE', self.HEA, 'v'), 0.0)
+        self.assertEqual(absolute_y('NOPE', self.HEA, 'v', 'sym', 10.0), 10.0)
+
+    # ----------------------------------------------------------- conversions
+    def test_abs_is_identity(self):
+        self.assertEqual(absolute_y('I', self.HEA, 'v', 'abs', 120.0), 120.0)
+        self.assertEqual(absolute_y('I', self.HEA, 'u', 'abs', 40.0), 40.0)
+
+    def test_sym_centres_on_the_face(self):
+        # web centre H/2 = 150 : +10 up, -10 down
+        self.assertEqual(absolute_y('I', self.HEA, 'v', 'sym', 10.0), 160.0)
+        self.assertEqual(absolute_y('I', self.HEA, 'v', 'sym', -10.0), 140.0)
+        self.assertEqual(absolute_y('I', self.HEA, 'v', 'sym', 0.0), 150.0)
+        # flange centre b/2 = 75 (the IPE/HEA flange case)
+        self.assertEqual(absolute_y('I', self.HEA, 'u', 'sym', 10.0), 85.0)
+        self.assertEqual(absolute_y('I', self.HEA, 'u', 'sym', -10.0), 65.0)
+
+    def test_top_measures_from_the_max_end(self):
+        self.assertEqual(absolute_y('I', self.HEA, 'v', 'top', 20.0), 280.0)
+        self.assertEqual(absolute_y('I', self.HEA, 'u', 'top', 20.0), 130.0)
+
+    def test_round_trip_relative_abs(self):
+        for mode, val, face in [('sym', 25.0, 'v'), ('sym', -8.0, 'u'),
+                                ('top', 15.0, 'v'), ('top', 0.0, 'u'),
+                                ('abs', 73.0, 'h')]:
+            abs_ = absolute_y('I', self.HEA, face, mode, val)
+            back = relative_y('I', self.HEA, face, mode, abs_)
+            self.assertAlmostEqual(back, val, places=6)
+
+
+if __name__ == '__main__':
+    unittest.main()
