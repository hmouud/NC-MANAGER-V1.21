+"""Advanced Profile Creator — main QMainWindow with full engine wiring.
+
+Wires all existing engines into one CAD-like UI:
+- Ribbon toolbar with SVG icons (File, Edit, Draw, Modify, Dim, Annotate, Tools)
+- Left panel: Profile catalog (254 profiles) + parameters + live section properties
+- Center: NcViewer canvas (existing 2D render engine)
+- Right panel: Interactive Hole/Slot editor table + toolbar ([+ Hole], [+ Slot], [Edit], [Dup], [Del])
+- Context menu: Add Hole, Add Slot, Zoom Fit, Toggle Grid
+- Full template engine wiring: engine/profile_catalog/nc1_template.py + fallback to contour engine
+- Real-time hole and slot synchronization with canvas 2D preview and NC1 export
+
+Engines wired:
+    engine/steel_engine/catalog.py — 254 profiles (via left_panel.py)
+    engine/profile_catalog/nc1_template.py — exact NC1 templates
+    engine/contour/ — generate_nc1() for parametric NC1 generation
+    core/nc1_writer.py — apply_hole_edits for injecting BO blocks
+    ui/qt_viewer.py — NcViewer for 2D rendering
+    design/dimensioning/ — auto_dimensions() for smart dimensioning
+"""
+from __future__ import annotations
+
+import json
+import os
+from typing import Optional, Dict
+
+from PySide6.QtCore import Qt, Signal, QEvent
+from PySide6.QtGui import QKeySequence
+from PySide6.QtWidgets import (
+    QMainWindow, QWidget, QVBoxLayout, QSplitter,
+    QFrame, QMenu, QLabel, QFileDialog, QMessageBox,
+)
+
+from nccorrection.ui._colors import C
+from nccorrection.ui.dialogs.advanced_profile_creator.state import (
+    AppStateController,
+    _normalize_legacy_format,
+)
+from nccorrection.ui.dialogs.advanced_profile_creator.hole_slot_dialog import HoleSlotDialog
+from nccorrection.ui.components.cad_hud import CadHudPrompt
+from nccorrection.engine.contour.interactive_cut import RectCut, apply_cuts_to_nc1
+
+
+class AdvancedProfileCreator(QMainWindow):
+    """CAD-like profile creation widget.
+
+    QMainWindow (not QWidget) so QMenuBar works correctly on Windows.
+    Uses QSplitter for resizable panels: Left (params) | Center (canvas) | Right (data).
+
+    Signals:
+        hole_added(str, float, float, float): face, x, y, diameter
+        slot_added(str, float, float, float, float): face, x, y, diameter, length
+        dimension_mode_changed(str): mode string
+        part_created(dict): emitted when user adds the profile to active project
+    """
+
+    hole_added = Signal(str, float, float, float)
+    slot_added = Signal(str, float, float, float, float)
+    dimension_mode_changed = Signal(str)
+    part_created = Signal(dict)
+
+    def __init__(self, parent: Optional[QWidget] = None):
+        super().__init__(parent)
+        self.setWindowTitle("Advanced Profile Creator — NC Manager V1.21")
+        self.setMinimumSize(1200, 700)
+        self.resize(1400, 800)
+
+        # ── State controller (single source of truth) ──
+        self.state_ctrl = AppStateController(self)
+
+        # ── Track last click position for Add Hole/Slot ──
+        self._last_click_pos = None
+        self._last_snap_kind = None
+
+        # ── Active drawing tool (None, 'hole', 'slot', 'cut') ──
+        self._active_tool = None
+        self._cut_step = 0
+        self._cut_data = {}
+
+        # ── Current NC1 text (stored for export) ──
+        self._current_nc1_text = None
+
+        # ── Current project file path (None = unsaved) ──
+        self._current_project_path = None
+
+        # ── Design settings for snap engine (reuses existing osnap.py) ──
+        from nccorrection.design.settings import DesignSettings
+        self._design_settings = DesignSettings()
+
+        # ── Apply dark theme ──
+        self.setStyleSheet(f"""
+            QMainWindow {{ background-color: {C.bg}; }}
+            QWidget {{ font-family: 'Arial'; font-size: 10px; color: {C.txt}; }}
+            QSplitter::handle {{ background: {C.line}; }}
+            QSplitter::handle:horizontal {{ width: 2px; }}
+            QSplitter::handle:hover {{ background: {C.accent}; }}
+        """)
+
+        # ── Build UI ──
+        self._build_menubar()
+        self._build_central()
+        self.canvas.set_design_settings(self._design_settings)
+        self._build_statusbar()
+        self._bind_shortcuts()
+        self._wire_signals()
+
+        # Initialize profile preview
+        self._update_canvas_preview()
+
+    # ────────────────────────────────────────────────────────────────
+    # Menu Bar
+    # ────────────────────────────────────────────────────────────────
+
+    def _build_menubar(self) -> None:
+        """Standard CAD menu bar: File, Edit, View, Draw, Modify, Dim, Annotate, Tools, Help."""
+        menubar = self.menuBar()
+        menubar.setStyleSheet(f"""
+            QMenuBar {{
+                background-color: {C.panel};
+                color: {C.txt};
+                border-bottom: 1px solid {C.line};
+                padding: 2px;
+            }}
+            QMenuBar::item:selected {{
+                background-color: {C.accent};
+                color: white;
+            }}
+            QMenu {{
+                background-color: {C.panel};
+                color: {C.txt};
+                border: 1px solid {C.line};
+            }}
+            QMenu::item:selected {{
+                background-color: {C.accent};
+                color: white;
+            }}
+        """)
+
+        # File menu
+        file_menu = menubar.addMenu("&File")
+        file_menu.addAction("New Profile", self._on_new_profile, QKeySequence("Ctrl+N"))
+        file_menu.addAction("Open...", self._on_open, QKeySequence("Ctrl+O"))
+        file_menu.addSeparator()
+        file_menu.addAction("Save", self._on_save, QKeySequence("Ctrl+S"))
+        file_menu.addAction("Save As...", self._on_save_as, QKeySequence("Ctrl+Shift+S"))
+        file_menu.addSeparator()
+        file_menu.addAction("Export DXF...", self._on_export_dxf)
+        file_menu.addAction("Export NC1...", self._on_export_nc1)
+        file_menu.addSeparator()
+        file_menu.addAction("Add to Project", self._on_add_to_project, QKeySequence("Ctrl+P"))
+        file_menu.addSeparator()
+        file_menu.addAction("Close", self.close, QKeySequence("Ctrl+W"))
+
+        # Edit menu
+        edit_menu = menubar.addMenu("&Edit")
+        edit_menu.addAction("Undo", self._on_undo, QKeySequence("Ctrl+Z"))
+        edit_menu.addAction("Redo", self._on_redo, QKeySequence("Ctrl+Y"))
+        edit_menu.addSeparator()
+        edit_menu.addAction("Cut", self._on_cut, QKeySequence("Ctrl+X"))
+        edit_menu.addAction("Copy", self._on_copy, QKeySequence("Ctrl+C"))
+        edit_menu.addAction("Paste", self._on_paste, QKeySequence("Ctrl+V"))
+        edit_menu.addSeparator()
+        edit_menu.addAction("Select All", self._on_select_all, QKeySequence("Ctrl+A"))
+
+        # View menu
+        view_menu = menubar.addMenu("&View")
+        view_menu.addAction("Zoom Fit", self._on_zoom_fit, QKeySequence("F"))
+        view_menu.addAction("Zoom In", self._on_zoom_in, QKeySequence("+"))
