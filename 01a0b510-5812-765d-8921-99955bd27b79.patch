+    def _splash_status(self, message, progress=None):
+        """Push a live boot status to the splash (no-op without one)."""
+        if self._splash is None:
+            return
+        if hasattr(self._splash, 'update_status'):
+            self._splash.update_status(message, progress=progress)
+        QApplication.processEvents()
