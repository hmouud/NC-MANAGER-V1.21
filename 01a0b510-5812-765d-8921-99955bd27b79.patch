+         'bevels': {}, 'notches': [], 'x_suffix': None,
+         'first_x': 100.0, 'first_y': 0.0},
+    ],
+    'points': [],
+    'circles': [(300, 150, 18), (3000, 75, 18)],
+    'slots': [],
+    'holes': [
+        {'face': 'v', 'kind': 'hole', 'x': 300, 'y': 150, 'd': 18,
+         'length': 0.0, 'angle': 0.0},
+        {'face': 'o', 'kind': 'hole', 'x': 3000, 'y': 75, 'd': 18,
+         'length': 0.0, 'angle': 0.0},
