+    def _make_clone_different(self, f0, order='66-777'):
+        """Copy f0 to order (flat, suffixed stored file) then MUTATE the
+        clone's content so it differs from the original's rewritten text."""
+        from nccorrection.core.classifier import compute_hash
+        self.w.orders.append(order)
+        self.w._copy_to_order([f0], order)
+        clone = next(f for f in self.w.files
+                     if f['order'] == order and f['name'] == f0['name'])
+        clone['text'] = clone['text'] + 'v 999.00 999.00 18.00\n'
+        clone['hash'] = compute_hash(clone['text'].encode('latin-1'))
+        with open(clone['path'], 'w', encoding='latin-1', newline='') as fh:
+            fh.write(clone['text'])
+        return clone
