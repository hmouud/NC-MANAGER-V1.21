@@ -0,0 +1,1138 @@
+"""Build a real 3D solid model from parsed NC1 geometry.
+
+For standard profiles (I-beam, angle L, channel U/C, T, tubes O/S, Z) the
+real prismatic cross-section is reconstructed from the ST dimension block and
+extruded along the beam length. Plates (B) and unknown parts are extruded from
+their contour outlines. Holes and slots are placed on the faces they pierce
+based on the DSTV face letter.
+
+The output model is a flat list of facets - each a polygon in 3D space with a
+color. Rendering sorts them with the painter's algorithm.
+"""
+
+import math
+import os
+
+# Colour per profile family, used by both the 2D and 3D viewers so every
+# piece of the same section type renders with the same tint.
+PROFILE_COLORS = {
+    'I': (96, 165, 250),      # HEA/HEB/HEM/IPE beams
+    'L': (74, 222, 128),      # cornières
+    'C': (167, 139, 250),     # UPN/UAP
+    'U': (167, 139, 250),
+    'T': (251, 191, 36),      # tés
+    'O': (45, 212, 191),      # tubes ronds
+    'S': (45, 212, 191),      # tubes carrés/rectangles
+    'Z': (248, 113, 113),     # lisses Z
+    'B': (56, 189, 248),      # plats / tôles
+}
+
+#: human-readable label (French) for the legend.
+PROFILE_LABELS = {
+    'I': 'I / HEA·HEB·IPE',
+    'L': 'L cornière',
+    'C': 'U / UPN',
+    'U': 'U / UPN',
+    'T': 'T té',
+    'O': 'O tube rond',
+    'S': 'S tube carré',
+    'Z': 'Z lisse',
+    'B': 'B plat',
+}
+
+
+def profile_color(st_type):
+    """Return the RGB colour for a profile family."""
+    return PROFILE_COLORS.get((st_type or '').upper(), (56, 189, 248))
+
+
+def profile_label(st_type):
+    """Return the French label of a profile family for the legend."""
+    return PROFILE_LABELS.get((st_type or '').upper(), 'autre')
+
+
+def profile_info(st, geometry=None):
+    """Return an English human-readable description of the profile dimensions.
+
+    e.g. "HEA300 (I): h=300 mm · b=150 mm · flange=10.0 mm · web=6.0 mm · L=6000 mm"
+    """
+    st = st or {}
+    t = (st.get('type') or 'B').upper()
+    dims = st.get('dims') or []
+    name = st.get('profile') or profile_label(t)
+    L = _dim(dims, 0, 0.0)
+    if not L and geometry:
+        L = _contour_length(geometry)
+    if t == 'I':
+        H = _dim(dims, 1, 300.0)
+        b = _dim(dims, 2, 150.0)
+        tf = _dim(dims, 3, H * 0.035)
+        tw = _dim(dims, 4, tf * 0.6)
+        s = f"{name} (I): h={H:.0f} mm \u00b7 b={b:.0f} mm \u00b7 flange={tf:.1f} mm \u00b7 web={tw:.1f} mm"
+    elif t == 'L':
+        a = _dim(dims, 1, 60.0)
+        b = _dim(dims, 2, 60.0)
+        th = _dim(dims, 3, 6.0)
+        s = f"{name} (L): a={a:.0f} x {b:.0f} mm \u00b7 th={th:.1f} mm"
+    elif t in ('C', 'U'):
+        H = _dim(dims, 1, 300.0)
+        b = _dim(dims, 2, 100.0)
+        tw = _dim(dims, 3, 8.0)
+        tf = _dim(dims, 4, 12.0)
+        s = f"{name} (U): h={H:.0f} mm \u00b7 b={b:.0f} mm \u00b7 web={tw:.1f} mm \u00b7 flange={tf:.1f} mm"
+    elif t == 'T':
+        H = _dim(dims, 1, 200.0)
+        b = _dim(dims, 2, 150.0)
+        th = _dim(dims, 3, 10.0)
+        s = f"{name} (T): h={H:.0f} mm \u00b7 b={b:.0f} mm \u00b7 th={th:.1f} mm"
+    elif t == 'O':
+        D = _dim(dims, 1, 100.0)
+        s = f"{name} (O): D={D:.0f} mm"
+    elif t == 'S':
+        a = _dim(dims, 1, 100.0)
+        b = _dim(dims, 2, a)
+        s = f"{name} (S): {a:.0f} x {b:.0f} mm"
+    elif t == 'Z':
+        H = _dim(dims, 1, 200.0)
+        b = _dim(dims, 2, 100.0)
+        th = _dim(dims, 3, 10.0)
+        s = f"{name} (Z): h={H:.0f} mm \u00b7 b={b:.0f} mm \u00b7 th={th:.1f} mm"
+    else:
+        th = st.get('thickness') or 10.0
+        s = f"{name} (B): th={float(th):.1f} mm"
+    if L:
+        s += f" \u00b7 L={L:.0f} mm"
+    return s
+
+
+def _cross(a, b):
+    return (a[1] * b[2] - a[2] * b[1],
+            a[2] * b[0] - a[0] * b[2],
+            a[0] * b[1] - a[1] * b[0])
+
+
+def _sub(a, b):
+    return (a[0] - b[0], a[1] - b[1], a[2] - b[2])
+
+
+def _norm(v):
+    l = math.sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]) or 1e-12
+    return (v[0] / l, v[1] / l, v[2] / l)
+
+
+def _normal(p0, p1, p2):
+    return _norm(_cross(_sub(p1, p0), _sub(p2, p0)))
+
+
+from nccorrection.core._dim import dim as _dim  # noqa: E402
+
+
+# ---------------------------------------------------------------- cross sections
+def _cs_i(dims):
+    H = _dim(dims, 1, 300.0)
+    b = _dim(dims, 2, 150.0)
+    tf = _dim(dims, 3, H * 0.035)
+    tw = _dim(dims, 4, tf * 0.6)
+    hb = b / 2.0
+    hw = tw / 2.0
+    return [(-hb, 0.0), (hb, 0.0), (hb, tf), (hw, tf), (hw, H - tf),
+            (hb, H - tf), (hb, H), (-hb, H), (-hb, H - tf), (-hw, H - tf),
+            (-hw, tf), (-hb, tf)]
+
+
+def _fillet_arc(cx, cy, r, a0, a1, n):
+    """Interior points of a quarter fillet arc from angle ``a0``..``a1`` (deg).
+
+    The two tangent endpoints are supplied by the caller; this helper returns
+    only the ``n - 1`` intermediate vertices so the corner blends smoothly.
+    """
+    return [(cx + r * math.cos(math.radians(a0 + (a1 - a0) * i / n)),
+             cy + r * math.sin(math.radians(a0 + (a1 - a0) * i / n)))
+            for i in range(1, n)]
+
+
+def _cs_i_rounded(dims):
+    """Hot-rolled I cross-section with the real web-flange fillet radius.
+
+    The ST dimension block carries the manufacturer fillet radius in
+    ``dims[5]`` (e.g. 18 for IPE360, 24 for HEA260, 17 for IPE750). Each of the
+    four inner web-flange corners is blended with a quarter arc of that radius
+    (the fillet *adds* material into the corner gap, exactly like a rolled
+    profile). Returns ``None`` when the radius is missing or invalid, so the
+    plain sharp polygon stays the fallback.
+    """
+    H = _dim(dims, 1, 300.0)
+    b = _dim(dims, 2, 150.0)
+    tf = _dim(dims, 3, H * 0.035)
+    tw = _dim(dims, 4, tf * 0.6)
+    r = float(_dim(dims, 5, 0.0))
+    hb, hw = b / 2.0, tw / 2.0
+    if r <= 0 or hb - hw <= 1e-9 or H - 2 * tf <= 1e-9:
+        return None
+    r = min(r, hb - hw, (H - 2 * tf) / 2.0)
+    n = 4  # interior vertices per quarter arc
+    pts = [(-hb, 0.0), (hb, 0.0), (hb, tf), (hw + r, tf)]
+    pts += _fillet_arc(hw + r, tf + r, r, 270.0, 180.0, n)
+    pts.append((hw, tf + r))
+    pts.append((hw, H - tf - r))
+    pts += _fillet_arc(hw + r, H - tf - r, r, 180.0, 90.0, n)
+    pts.append((hw + r, H - tf))
+    pts.append((hb, H - tf))
+    pts.append((hb, H))
+    pts.append((-hb, H))
+    pts.append((-hb, H - tf))
+    pts.append((-hw - r, H - tf))
+    pts += _fillet_arc(-hw - r, H - tf - r, r, 90.0, 0.0, n)
+    pts.append((-hw, H - tf - r))
+    pts.append((-hw, tf + r))
+    pts += _fillet_arc(-hw - r, tf + r, r, 0.0, -90.0, n)
+    pts.append((-hw - r, tf))
+    pts.append((-hb, tf))
+    return pts
+
+
+def _cs_l(dims):
+    a = _dim(dims, 1, 60.0)
+    b = _dim(dims, 2, 60.0)
+    t = _dim(dims, 3, 6.0)
+    return [(0.0, 0.0), (a, 0.0), (a, t), (t, t), (t, b), (0.0, b)]
+
+
+def _cs_u(dims):
+    H = _dim(dims, 1, 300.0)
+    b = _dim(dims, 2, 100.0)
+    tw = _dim(dims, 3, 8.0)
+    tf = _dim(dims, 4, 12.0)
+    return [(-b, 0.0), (0.0, 0.0), (0.0, tf), (-tw, tf), (-tw, H - tf),
+            (0.0, H - tf), (0.0, H), (-b, H), (-b, H - tf),
+            (tw - b, H - tf), (tw - b, tf), (-b, tf)]
+
+
+def _cs_t(dims):
+    H = _dim(dims, 1, 200.0)
+    b = _dim(dims, 2, 150.0)
+    t = _dim(dims, 3, 10.0)
+    hb = b / 2.0
+    return [(-hb, 0.0), (hb, 0.0), (hb, t), (-hb, t),
+            (-hb, H), (hb, H), (hb, H - t), (-hb, H - t)]
+
+
+def _cs_o(dims):
+    D = _dim(dims, 1, 100.0)
+    n = 24
+    pts = []
+    for i in range(n):
+        a = 2 * math.pi * i / n
+        pts.append((math.sin(a) * D / 2, math.cos(a) * D / 2))
+    return pts
+
+
+def _cs_s(dims):
+    a = _dim(dims, 1, 100.0)
+    b = _dim(dims, 2, a)
+    return [(-b / 2, -a / 2), (b / 2, -a / 2), (b / 2, a / 2), (-b / 2, a / 2)]
+
+
+def _cs_z(dims):
+    H = _dim(dims, 1, 200.0)
+    b = _dim(dims, 2, 100.0)
+    t = _dim(dims, 3, 10.0)
+    return [(-b, 0.0), (0.0, 0.0), (0.0, H), (b, H), (b, H - t),
+            (t, H - t), (t, t), (-b, t)]
+
+
+def cross_section(st_type, dims):
+    t = (st_type or 'B').upper()
+    if t == 'I':
+        return _cs_i(dims)
+    if t == 'L':
+        return _cs_l(dims)
+    if t in ('C', 'U'):
+        return _cs_u(dims)
+    if t == 'T':
+        return _cs_t(dims)
+    if t == 'O':
+        return _cs_o(dims)
+    if t == 'S':
+        return _cs_s(dims)
+    if t == 'Z':
+        return _cs_z(dims)
+    return None
+
+
+def cross_section_rounded(st_type, dims):
+    """Hot-rolled cross-section with the fillet radius blended in.
+
+    Falls back to the sharp ``cross_section`` when the profile family has no
+    fillet defined (only I-sections carry ``dims[5]`` in the DSTV convention).
+    """
+    t = (st_type or 'B').upper()
+    if t == 'I':
+        return _cs_i_rounded(dims)
+    return None
+
+
+def profile_kind(st_type):
+    t = (st_type or 'B').upper()
+    if t in ('I', 'L', 'C', 'U', 'T', 'O', 'S', 'Z'):
+        return 'prism'
+    return 'plate'
+
+
+# ---------------------------------------------------------------- model
+def _quad_facet(p0, p1, p2, p3, base_color):
+    n = _normal(p0, p1, p2)
+    return {'pts': [p0, p1, p2, p3], 'normal': n, 'color': base_color}
+
+
+def _poly_facet(pts, base_color):
+    n = _normal(pts[0], pts[1], pts[2])
+    return {'pts': list(pts), 'normal': n, 'color': base_color}
+
+
+def _disc_facet(center, normal, radius, base_color, n=22):
+    ref = (1.0, 0.0, 0.0) if abs(normal[0]) < 0.9 else (0.0, 1.0, 0.0)
+    u = _norm(_cross(normal, ref))
+    v = _cross(normal, u)
+    pts = []
+    for i in range(n):
+        a = 2 * math.pi * i / n
+        pts.append((center[0] + radius * (math.cos(a) * u[0] + math.sin(a) * v[0]),
+                    center[1] + radius * (math.cos(a) * u[1] + math.sin(a) * v[1]),
+                    center[2] + radius * (math.cos(a) * u[2] + math.sin(a) * v[2])))
+    return {'pts': pts, 'normal': _norm(normal), 'color': base_color, 'is_hole': True}
+
+
+def _bore_facets(center, normal, radius, depth, seg=28):
+    """Cylindrical wall of a through-hole (the drilled bore interior).
+
+    ``center`` is the bore midpoint, ``normal`` the drill axis, ``depth`` the
+    material thickness the drill passes through. Returns dark wall quads so the
+    hole is visible from the sides during rotation, not just as flat discs.
+    """
+    nrm = _norm(normal)
+    c0 = (center[0] - nrm[0] * depth / 2.0,
+          center[1] - nrm[1] * depth / 2.0,
+          center[2] - nrm[2] * depth / 2.0)
+    c1 = (center[0] + nrm[0] * depth / 2.0,
+          center[1] + nrm[1] * depth / 2.0,
+          center[2] + nrm[2] * depth / 2.0)
+    ref = (1.0, 0.0, 0.0) if abs(nrm[0]) < 0.9 else (0.0, 1.0, 0.0)
+    u = _norm(_cross(nrm, ref))
+    v = _cross(nrm, u)
+    facets = []
+    for i in range(seg):
+        a0 = 2 * math.pi * i / seg
+        a1 = 2 * math.pi * ((i + 1) % seg) / seg
+        p0 = (c0[0] + radius * (math.cos(a0) * u[0] + math.sin(a0) * v[0]),
+              c0[1] + radius * (math.cos(a0) * u[1] + math.sin(a0) * v[1]),
+              c0[2] + radius * (math.cos(a0) * u[2] + math.sin(a0) * v[2]))
+        p1 = (c0[0] + radius * (math.cos(a1) * u[0] + math.sin(a1) * v[0]),
+              c0[1] + radius * (math.cos(a1) * u[1] + math.sin(a1) * v[1]),
+              c0[2] + radius * (math.cos(a1) * u[2] + math.sin(a1) * v[2]))
+        p2 = (c1[0] + radius * (math.cos(a1) * u[0] + math.sin(a1) * v[0]),
+              c1[1] + radius * (math.cos(a1) * u[1] + math.sin(a1) * v[1]),
+              c1[2] + radius * (math.cos(a1) * u[2] + math.sin(a1) * v[2]))
+        p3 = (c1[0] + radius * (math.cos(a0) * u[0] + math.sin(a0) * v[0]),
+              c1[1] + radius * (math.cos(a0) * u[1] + math.sin(a0) * v[1]),
+              c1[2] + radius * (math.cos(a0) * u[2] + math.sin(a0) * v[2]))
+        facets.append({'pts': [p0, p1, p2, p3], 'normal': _norm(nrm),
+                       'color': (12, 14, 20), 'is_hole_wall': True})
+    return facets
+
+
+def _add_hole(facets, center, normal, radius, depth, hole_color):
+    """Append entry disc, exit disc and the drilled bore walls."""
+    nrm = _norm(normal)
+    ct = (center[0] + nrm[0] * depth / 2.0,
+          center[1] + nrm[1] * depth / 2.0,
+          center[2] + nrm[2] * depth / 2.0)
+    cb = (center[0] - nrm[0] * depth / 2.0,
+          center[1] - nrm[1] * depth / 2.0,
+          center[2] - nrm[2] * depth / 2.0)
+    facets.append(_disc_facet(ct, nrm, radius, hole_color))
+    facets.append(_disc_facet(cb, (-nrm[0], -nrm[1], -nrm[2]), radius, hole_color))
+    facets.extend(_bore_facets(center, nrm, radius, depth))
+    return facets
+
+
+def _slot_loop(center, normal, axis_dir, radius, half_len, seg=20):
+    """Boundary of an oblong slot (stadium) as 3D points in the mid plane.
+
+    Two semicircular end caps of ``radius`` joined by straight sides. The slot
+    axis runs along ``axis_dir`` (unit, in the face plane) for ``2*half_len``
+    between the cap centers, so the total slot length is 2*half_len + 2*radius.
+    """
+    nrm = _norm(normal)
+    u = _norm(axis_dir)
+    v = _norm(_cross(nrm, u))
+
+    def pt(a, b):
+        return (center[0] + a * u[0] + b * v[0],
+                center[1] + a * u[1] + b * v[1],
+                center[2] + a * u[2] + b * v[2])
+
+    loop = []
+    for i in range(seg + 1):
+        ang = math.pi / 2.0 - math.pi * i / seg
+        loop.append(pt(half_len + radius * math.cos(ang), radius * math.sin(ang)))
+    for i in range(seg + 1):
+        ang = -math.pi / 2.0 + math.pi * i / seg
+        loop.append(pt(-half_len - radius * math.cos(ang), radius * math.sin(ang)))
+    return loop
+
+
+def _slot_facets(center, normal, axis_dir, radius, half_len, depth,
+                 hole_color, seg=10):
+    """Append the real oblong cutout (entry/exit faces + side walls) of a slot."""
+    nrm = _norm(normal)
+    loop = _slot_loop(center, normal, axis_dir, radius, half_len, seg)
+    d2 = depth / 2.0
+    entry = [(p[0] + nrm[0] * d2, p[1] + nrm[1] * d2, p[2] + nrm[2] * d2)
+             for p in loop]
+    exit_ = [(p[0] - nrm[0] * d2, p[1] - nrm[1] * d2, p[2] - nrm[2] * d2)
+             for p in loop]
+    wall = (12, 14, 20)
+    facets = [
+        {'pts': entry, 'normal': tuple(nrm), 'color': hole_color, 'is_hole': True},
+        {'pts': exit_, 'normal': (-nrm[0], -nrm[1], -nrm[2]),
+         'color': hole_color, 'is_hole': True},
+    ]
+    for i in range(len(loop) - 1):
+        a0, a1 = entry[i], entry[i + 1]
+        b1, b0 = exit_[i + 1], exit_[i]
+        facets.append({'pts': [a0, a1, b1, b0],
+                       'normal': _normal(a0, a1, b1),
+                       'color': wall, 'is_hole_wall': True})
+    return facets
+
+
+def _add_slot(facets, center, normal, axis_dir, radius, half_len, depth, hole_color):
+    facets.extend(_slot_facets(center, normal, axis_dir, radius, half_len, depth,
+                               hole_color))
+    return facets
+
+
+def build_model(geometry, hole_color=(239, 68, 68)):
+    """Return a list of facet dicts describing the solid in 3D space."""
+    st = geometry.get('st') or {}
+    st_type = (st.get('type') or 'B').upper()
+    dims = st.get('dims') or []
+    thickness = float(st.get('thickness') or 10.0)
+    length = _dim(dims, 0, 0.0) or _contour_length(geometry)
+    base = _steel_color(st_type)
+
+    facets = []
+    if profile_kind(st_type) == 'prism':
+        cs = cross_section(st_type, dims)
+        if cs:
+            facets = _extrude_prism(cs, length, base, geometry, st_type, dims)
+            slots = _slot_placements(geometry, st_type, dims, thickness)
+            for c, n, ax, r, hl, depth in slots:
+                _add_slot(facets, c, n, ax, r, hl, depth, hole_color)
+            placements = _hole_placements(geometry, st_type, dims, length, thickness)
+            for c, n, r, depth in placements:
+                _add_hole(facets, c, n, r, depth, hole_color)
+            return facets
+
+    facets = _extrude_contours(geometry, thickness, base)
+    slots = _slot_placements(geometry, st_type, dims, thickness)
+    for c, n, ax, r, hl, depth in slots:
+        _add_slot(facets, c, n, ax, r, hl, depth, hole_color)
+    placements = _hole_placements(geometry, st_type, dims, length, thickness)
+    for c, n, r, depth in placements:
+        _add_hole(facets, c, n, r, depth, hole_color)
+    return facets
+
+
+def _contour_length(geometry):
+    x = 0.0
+    for c in geometry.get('contours', []):
+        for p in c:
+            x = max(x, p[0])
+    return x or 1000.0
+
+
+def _steel_color(st_type):
+    return profile_color(st_type)
+
+
+def _web_notch_z(cs, geometry, dims, H, tf):
+    """Return (nl_start, nl_end, z_start, z_end) applying web grougage cuts.
+
+    The web ('v') contour carries notch lines (points with x positions where
+    the web is cut back). A grougage shortens the web at the beam ends: its
+    height there is reduced from the flange-to-flange height down to the
+    height actually drawn in the contour. ``z_start`` / ``z_end`` are the
+    per-vertex web heights at the two beam ends, ``nl_start`` / ``nl_end`` the
+    x-length of each notch zone. Only web vertices (|y| == web half thickness)
+    are modified; the flanges are left to the miter logic.
+    """
+    tw = _dim(dims, 4, tf * 0.6) or 1e-6
+    hw = tw / 2.0
+    zs = [c[1] for c in cs]
+    metas = geometry.get('contour_meta') or []
+    m = next((x for x in metas if x.get('face') == 'v'), None)
+    if m is None:
+        return 0.0, 0.0, list(zs), list(zs)
+    pts = m.get('pts') or []
+    if len(pts) < 4:
+        return 0.0, 0.0, list(zs), list(zs)
+    xs = [p[0] for p in pts]
+    ys = [p[1] for p in pts]
+    v_min, v_max = min(xs), max(xs)
+    if v_max - v_min < 1e-9:
+        return 0.0, 0.0, list(zs), list(zs)
+    c_bot, c_top = min(ys), max(ys)
+    if c_top - c_bot < 1e-9:
+        return 0.0, 0.0, list(zs), list(zs)
+    nxs = sorted({pts[i][0] for i in (m.get('notches') or []) if i < len(pts)})
+    if not nxs:
+        return 0.0, 0.0, list(zs), list(zs)
+    nl_s = max(nxs[0] - v_min, 0.0)
+    nl_e = max(v_max - nxs[-1], 0.0)
+    if nl_s < 1e-6 and nl_e < 1e-6:
+        return 0.0, 0.0, list(zs), list(zs)
+    s_ys = [p[1] for p in pts if abs(p[0] - v_min) < 1e-6]
+    e_ys = [p[1] for p in pts if abs(p[0] - v_max) < 1e-6]
+    s_bot, s_top = (min(s_ys), max(s_ys)) if s_ys else (c_bot, c_top)
+    e_bot, e_top = (min(e_ys), max(e_ys)) if e_ys else (c_bot, c_top)
+    k = (H - 2 * tf) / (c_top - c_bot)
+    z_s = list(zs)
+    z_e = list(zs)
+    for i, (y, z) in enumerate(cs):
+        if abs(abs(y) - hw) > 1e-6:
+            continue
+        if nl_s > 1e-6 and z <= tf:
+            z_s[i] = min(max(tf + (s_bot - c_bot) * k, tf), H - tf)
+        elif nl_s > 1e-6:
+            z_s[i] = min(max(z - (c_top - s_top) * k, tf), H - tf)
+        if nl_e > 1e-6 and z <= tf:
+            z_e[i] = min(max(tf + (e_bot - c_bot) * k, tf), H - tf)
+        elif nl_e > 1e-6:
+            z_e[i] = min(max(z - (c_top - e_top) * k, tf), H - tf)
+    return nl_s, nl_e, z_s, z_e
+
+
+def _extrude_prism(cs, length, base, geometry=None, st_type=None, dims=None,
+                   cut_color=(249, 115, 22)):
+    """Extrude a prismatic cross-section along the beam length.
+
+    Sloped flange ends (miter) and web grougage notches are real cuts, so the
+    solid is built from a chain of cross-sections (``planes``): at each end the
+    flange is pulled back along a slope and the web height is reduced, then the
+    prism is subdivided into segments so every cut step is an actual facet.
+    Side quads spanning a distorted step are tinted with ``cut_color``.
+    """
+    n = len(cs)
+    ys = [c[0] for c in cs]
+    zs = [c[1] for c in cs]
+    H = max(zs) or 1e-6
+    tf = (_dim(dims, 3, H * 0.035) or 1e-6)
+    tw = _dim(dims, 4, tf * 0.6) or 1e-6
+    hw = tw / 2.0
+    off_start = {}
+    off_end = {}
+    miter_s = miter_e = None
+    mv_min = 0.0
+    mv_max = length
+    cut = False
+    if geometry and (st_type or '').upper() == 'I':
+        off_start, off_end = _end_cut_offsets(geometry)
+        miter_s, miter_e, mv_min, mv_max = _v_end_cuts(geometry, H)
+        cut = bool(off_start or off_end) or miter_s is not None or miter_e is not None
+
+    def flange_x(i, offs):
+        # A grougage cuts a flange back as a *square* step: every vertex of a
+        # flange (both its inner and outer face) is pulled back by the same
+        # amount, while the web is never pulled back (the web is only trimmed
+        # by _web_notch_z). A diagonal across the flange thickness would turn
+        # a square-ended flange into a sloped/miter-like parallelogram.
+        z = zs[i]
+        if hw > 1e-9 and abs(abs(ys[i]) - hw) <= 1e-6:
+            return 0.0
+        if z <= tf and tf > 1e-9:
+            return offs.get('u', 0.0)
+        if z >= H - tf:
+            return offs.get('o', 0.0)
+        return 0.0
+
+    start_x = [miter_s(zs[i]) if miter_s is not None else flange_x(i, off_start)
+               for i in range(n)]
+    end_x = [(mv_max - miter_e(zs[i])) if miter_e is not None
+             else (length - flange_x(i, off_end))
+             for i in range(n)]
+
+    # Defective files can carry end-cut angles whose cut-back is larger than
+    # the beam itself, degenerating an end to a point or inverting it. Keep a
+    # minimum sliver so the solid stays valid instead of folding over itself.
+    if miter_s is not None or miter_e is not None:
+        gap = max(float(_dim(dims, 4, 0.0) or 0.0), 1.0)
+        for i in range(n):
+            if end_x[i] - start_x[i] < gap:
+                end_x[i] = start_x[i] + gap
+
+    nl_s = nl_e = 0.0
+    z_s = list(zs)
+    z_e = list(zs)
+    if geometry and (st_type or '').upper() == 'I':
+        nl_s, nl_e, z_s, z_e = _web_notch_z(cs, geometry, dims, H, tf)
+        if nl_s > 1e-6 or nl_e > 1e-6:
+            cut = True
+
+    # A square-ended beam (no miter / grougage / flange cut) renders with the
+    # hot-rolled fillet radius from dims[5] blended into the cross-section.
+    # The miter/grouge path keeps the sharp polygon so cut geometry is exactly
+    # as before.
+    if not cut and (st_type or '').upper() == 'I':
+        rcs = _cs_i_rounded(dims)
+        if rcs is not None:
+            cs = rcs
+            n = len(cs)
+            ys = [c[0] for c in cs]
+            zs = [c[1] for c in cs]
+            H = max(zs) or 1e-6
+
+    if not cut:
+        facets = [_poly_facet([(length, y, z) for y, z in cs], base),
+                  _poly_facet([(0.0, y, z) for y, z in reversed(cs)], base)]
+        for i in range(n):
+            y1, z1 = cs[i]
+            y2, z2 = cs[(i + 1) % n]
+            facets.append(_quad_facet((0.0, y1, z1), (length, y1, z1),
+                                      (length, y2, z2), (0.0, y2, z2), base))
+        return facets
+
+    def is_web(i):
+        return hw > 1e-6 and abs(abs(ys[i]) - hw) <= 1e-6
+
+    web_bot = [i for i in range(n) if is_web(i) and zs[i] <= tf + 1e-6]
+    web_top = [i for i in range(n) if is_web(i) and zs[i] >= H - tf - 1e-6]
+    s_bot = min(max(max(z_s[i] for i in web_bot), tf), H - tf) if web_bot else tf
+    s_top = min(max(min(z_s[i] for i in web_top), tf), H - tf) if web_top else H - tf
+    e_bot = min(max(max(z_e[i] for i in web_bot), tf), H - tf) if web_bot else tf
+    e_top = min(max(min(z_e[i] for i in web_top), tf), H - tf) if web_top else H - tf
+
+    x0 = 0.0
+    xs = nl_s if 1e-6 < nl_s < length else None
+    xe = (length - nl_e) if 1e-6 < nl_e < length else None
+    x1 = length
+
+    facets = []
+
+    def add(p0, p1, p2, p3, col):
+        facets.append(_quad_facet(p0, p1, p2, p3, col))
+
+    # flange side faces (both endpoints are flange vertices), slanted by miter
+    for i in range(n):
+        j = (i + 1) % n
+        if is_web(i) or is_web(j):
+            continue
+        col = base
+        if cut_color and (abs(start_x[i] - start_x[j]) > 1e-6 or
+                          abs(end_x[i] - end_x[j]) > 1e-6):
+            col = cut_color
+        add((start_x[i], ys[i], zs[i]), (end_x[i], ys[i], zs[i]),
+            (end_x[j], ys[j], zs[j]), (start_x[j], ys[j], zs[j]), col)
+
+    # web side faces: a proper square grouge step (shelf + vertical wall),
+    # never a diagonal ramp through the web thickness
+    for i in range(n):
+        j = (i + 1) % n
+        if not (is_web(i) and is_web(j)):
+            continue
+        yw = ys[i]
+        if xs is not None and xs > 1e-6:
+            if s_top - s_bot > 1e-6:
+                add((x0, yw, s_bot), (xs, yw, s_bot), (xs, yw, s_top),
+                    (x0, yw, s_top), base)
+        m0 = xs if xs is not None else x0
+        m1 = xe if xe is not None else x1
+        if m1 - m0 > 1e-6:
+            if miter_s is not None or miter_e is not None:
+                add((start_x[i], ys[i], zs[i]), (end_x[i], ys[i], zs[i]),
+                    (end_x[j], ys[j], zs[j]), (start_x[j], ys[j], zs[j]), base)
+            else:
+                add((m0, yw, tf), (m1, yw, tf), (m1, yw, H - tf),
+                    (m0, yw, H - tf), base)
+        if xe is not None and x1 - xe > 1e-6:
+            if e_top - e_bot > 1e-6:
+                add((xe, yw, e_bot), (x1, yw, e_bot), (x1, yw, e_top),
+                    (xe, yw, e_top), base)
+
+    # flange-to-web junction strips (slanted only inside a grouge zone)
+    for i in range(n):
+        j = (i + 1) % n
+        if is_web(i) == is_web(j):
+            continue
+        wi = i if is_web(i) else j
+        wf = j if is_web(i) else i
+        yw, zt = ys[wi], zs[wi]
+        yf = ys[wf]
+        m0 = xs if xs is not None else x0
+        m1 = xe if xe is not None else x1
+        if m1 - m0 > 1e-6:
+            if miter_s is not None or miter_e is not None:
+                add((start_x[wf], yf, zt), (end_x[wf], yf, zt),
+                    (end_x[wi], yw, zt), (start_x[wi], yw, zt), base)
+            else:
+                add((m0, yf, zt), (m1, yf, zt), (m1, yw, zt), (m0, yw, zt), base)
+
+    # grouge shelves + step walls + exposed flange faces under the cut web
+    for zx0, zx1, zbot, ztop, at_end in (
+            (x0, xs, s_bot, s_top, False),
+            (xe, x1, e_bot, e_top, True)):
+        if zx0 is None or zx1 is None or zx1 - zx0 <= 1e-6:
+            continue
+        if zbot - tf > 1e-6:
+            add((zx0, hw, zbot), (zx1, hw, zbot), (zx1, -hw, zbot),
+                (zx0, -hw, zbot), base)
+            if at_end:
+                add((zx0, hw, tf), (zx0, hw, zbot), (zx0, -hw, zbot),
+                    (zx0, -hw, tf), base)
+            else:
+                add((zx1, hw, tf), (zx1, hw, zbot), (zx1, -hw, zbot),
+                    (zx1, -hw, tf), base)
+        if (H - tf) - ztop > 1e-6:
+            add((zx0, hw, ztop), (zx1, hw, ztop), (zx1, -hw, ztop),
+                (zx0, -hw, ztop), base)
+            if at_end:
+                add((zx0, hw, ztop), (zx0, hw, H - tf), (zx0, -hw, H - tf),
+                    (zx0, -hw, ztop), base)
+            else:
+                add((zx1, hw, ztop), (zx1, hw, H - tf), (zx1, -hw, H - tf),
+                    (zx1, -hw, ztop), base)
+
+    # end caps: the web end is the reduced rectangle (the notch mouth above/
+    # below it stays open), the flange ends are the slanted miter surfaces.
+    # When the v contour shows a diagonal end (miter) the web cap follows the
+    # per-vertex cut-back so the whole section ends on the same cut plane.
+    web_idx = [i for i in range(n) if is_web(i)]
+
+    def web_cap(xx, cap_color):
+        br = next(i for i in web_idx if abs(zs[i] - tf) < 1e-6 and ys[i] > 0)
+        tr = next(i for i in web_idx if abs(zs[i] - (H - tf)) < 1e-6 and ys[i] > 0)
+        tl = next(i for i in web_idx if abs(zs[i] - (H - tf)) < 1e-6 and ys[i] < 0)
+        bl = next(i for i in web_idx if abs(zs[i] - tf) < 1e-6 and ys[i] < 0)
+        return [_tri_facet((xx[br], ys[br], zs[br]), (xx[tr], ys[tr], zs[tr]),
+                           (xx[bl], ys[bl], zs[bl]), cap_color),
+                _tri_facet((xx[tr], ys[tr], zs[tr]), (xx[tl], ys[tl], zs[tl]),
+                           (xx[bl], ys[bl], zs[bl]), cap_color)]
+
+    if miter_s is not None:
+        facets.extend(web_cap(start_x, cut_color))
+    else:
+        facets.append(_quad_facet((x0, -hw, s_bot), (x0, hw, s_bot),
+                                  (x0, hw, s_top), (x0, -hw, s_top), base))
+    if miter_e is not None:
+        facets.extend(web_cap(end_x, cut_color))
+    else:
+        facets.append(_quad_facet((x1, -hw, e_bot), (x1, hw, e_bot),
+                                  (x1, hw, e_top), (x1, -hw, e_top), base))
+    for xx in (start_x, end_x):
+        bfl = ((xx[0], ys[0], zs[0]), (xx[1], ys[1], zs[1]),
+               (xx[2], ys[2], zs[2]), (xx[11], ys[11], zs[11]))
+        tfl = ((xx[6], ys[6], zs[6]), (xx[7], ys[7], zs[7]),
+               (xx[8], ys[8], zs[8]), (xx[5], ys[5], zs[5]))
+        for quad in (bfl, tfl):
+            mitered = (abs(quad[0][0] - quad[2][0]) > 1e-6 or
+                       abs(quad[1][0] - quad[3][0]) > 1e-6)
+            col = cut_color if mitered else base
+            facets.append(_tri_facet(quad[0], quad[1], quad[2], col))
+            facets.append(_tri_facet(quad[0], quad[2], quad[3], col))
+    return facets
+
+
+def _end_cut_offsets(geometry):
+    """Return (start, end) offset dicts for I-beam flange end cuts.
+
+    The web ('v' face) defines the full beam length; any flange face ('o'/'u')
+    drawn shorter than the web means that flange is sloped-cut at the end.
+    """
+    start = {}
+    end = {}
+    metas = geometry.get('contour_meta') or []
+    v_min = v_max = None
+    fmin = {'o': None, 'u': None}
+    fmax = {'o': None, 'u': None}
+    for m in metas:
+        face = m.get('face')
+        xs = [p[0] for p in m.get('pts', [])]
+        if not xs:
+            continue
+        mn, mx = min(xs), max(xs)
+        if face == 'v':
+            v_min, v_max = mn, mx
+        elif face in ('o', 'u'):
+            fmin[face] = mn if fmin[face] is None else min(fmin[face], mn)
+            fmax[face] = mx if fmax[face] is None else max(fmax[face], mx)
+    if v_min is None:
+        return start, end
+    for f in ('o', 'u'):
+        if fmin[f] is not None and fmin[f] - v_min > 1e-6:
+            start[f] = fmin[f] - v_min
+        if fmax[f] is not None and v_max - fmax[f] > 1e-6:
+            end[f] = v_max - fmax[f]
+    return start, end
+
+
+def _v_end_cuts(geometry, H):
+    """Return (start_fn, end_fn, v_min, v_max) miter planes / v extents.
+
+    A real miter shows up as a *diagonal* edge on the 'v' face (both x and y
+    change), e.g. the trapezoid of a 45-degree cut end. Each returned function
+    maps a height z (0..H) to the cut-back in mm, or None when that end of the
+    beam is square. ``v_min`` / ``v_max`` are the v-contour extents the cut-backs
+    are measured from (the ST Length can be the saw over-length and is *not* a
+    valid miter reference). Grougage files only contain vertical/horizontal
+    step edges (no diagonal), so they fall back to ``_end_cut_offsets`` +
+    ``_web_notch_z``.
+    """
+    metas = geometry.get('contour_meta') or []
+    m = next((x for x in metas if x.get('face') == 'v'), None)
+    if m is None:
+        return None, None, 0.0, 0.0
+    pts = [(float(p[0]), float(p[1])) for p in m.get('pts', [])]
+    if len(pts) < 3:
+        return None, None
+    v_min = min(p[0] for p in pts)
+    v_max = max(p[0] for p in pts)
+    c_min = min(p[1] for p in pts)
+    c_max = max(p[1] for p in pts)
+    if v_max - v_min < 1e-9 or c_max - c_min < 1e-9:
+        return None, None, v_min, v_max
+    Hm = max(float(H), 1e-9)
+
+    # a miter exists on a side only when the v contour has a real diagonal
+    # edge there (grougage steps are strictly vertical/horizontal)
+    has_s = has_e = False
+    n = len(pts)
+    for i in range(n):
+        x1, y1 = pts[i]
+        x2, y2 = pts[(i + 1) % n]
+        if abs(x2 - x1) < 1e-6 or abs(y2 - y1) < 1e-6:
+            continue
+        if max(x1, x2) >= v_max - 1e-3:
+            has_e = True
+        if min(x1, x2) <= v_min + 1e-3:
+            has_s = True
+
+    def extent_at_y(y):
+        vals = []
+        for i in range(n):
+            x1, y1 = pts[i]
+            x2, y2 = pts[(i + 1) % n]
+            if abs(y2 - y1) < 1e-9:
+                continue
+            t = (y - y1) / (y2 - y1)
+            if -1e-9 <= t <= 1 + 1e-9:
+                vals.append(x1 + t * (x2 - x1))
+        if not vals:
+            return None, None
+        return min(vals), max(vals)
+
+    def plane(side_far):
+        span = max(v_max - v_min, 1e-9)
+
+        def cut(z):
+            y = c_min + (c_max - c_min) * (float(z) / Hm)
+            xn, xf = extent_at_y(y)
+            if xn is None or xf is None:
+                return 0.0
+            c = (v_max - xf) if side_far else (xn - v_min)
+            return min(max(c, 0.0), span)
+        return cut
+
+    return (plane(False) if has_s else None,
+            plane(True) if has_e else None,
+            v_min, v_max)
+
+
+def _tri_facet(p0, p1, p2, base_color):
+    nrm = _normal(p0, p1, p2)
+    return {'pts': [p0, p1, p2], 'normal': nrm, 'color': base_color}
+
+def _extrude_contours(geometry, thickness, base):
+    facets = []
+    metas = geometry.get('contour_meta') or []
+    for ci, contour in enumerate(geometry.get('contours', [])):
+        if len(contour) < 3:
+            continue
+        # Arc interpolation: when contour_meta carries arc data (radius or
+        # bulge), interpolate arcs into a smooth polyline so circular plates
+        # extrude as cylinders, not faceted polygons.
+        meta = metas[ci] if ci < len(metas) else None
+        arc_vals = meta.get('arc_values', []) if meta else []
+        has_arcs = any(abs(v) > 1e-12 for v in arc_vals)
+        if has_arcs:
+            from nccorrection.engine.math.arc_interpolation import (
+                polyline_for_vertices)
+            conv = meta.get('arc_convention', 'bulge') if meta else 'bulge'
+            verts_4d = []
+            for j, pt in enumerate(contour):
+                av = arc_vals[j] if j < len(arc_vals) else 0.0
+                if conv == 'radius':
+                    verts_4d.append((pt[0], pt[1], 0.0, av))
+                else:
+                    verts_4d.append((pt[0], pt[1], av, 0.0))
+            pts = polyline_for_vertices(verts_4d)
+        else:
+            pts = [(float(x), float(y)) for x, y in contour]
+        n = len(pts)
+        for i in range(n):
+            x1, y1 = pts[i]
+            x2, y2 = pts[(i + 1) % n]
+            facets.append(_quad_facet((x1, y1, thickness), (x2, y2, thickness),
+                                      (x2, y2, 0.0), (x1, y1, 0.0), base))
+        # Inner contours (IK = holes/cutouts) get walls only — no caps.
+        # Caps on inner contours would seal the cutout and make the plate
+        # appear solid.  The `kind` key is set by core.viewer.parse_geometry.
+        contour_kind = (meta.get('kind', 'outer') if meta else 'outer')
+        if contour_kind != 'inner':
+            facets.append(_poly_facet([(x, y, thickness) for x, y in pts], base))
+            facets.append(_poly_facet([(x, y, 0.0) for x, y in reversed(pts)], base))
+    if not facets:
+        for x, y in geometry.get('points', []):
+            facets.append(_disc_facet((x, y, thickness / 2.0), (0, 0, 1),
+                                      max(thickness, 4.0) / 2.0, base))
+    return facets
+
+
+def indexed_hole_placements(geometry, st_type, dims, length, thickness):
+    """Like _hole_placements but each entry carries the source hole index.
+
+    Returns list of (center, outward_normal, radius, hole_index) so viewers can
+    map a clicked hole back to geometry['holes'][i] for editing. Every hole
+    (round and slot) yields exactly one reference placed at its centre.
+    """
+    holes = geometry.get('holes', [])
+    out = []
+    pl = _hole_placements(geometry, st_type, dims, length, thickness)
+    sl = _slot_placements(geometry, st_type, dims, thickness)
+    i = 0
+    si = 0
+    for idx, h in enumerate(holes):
+        if h.get('kind') == 'slot':
+            if si < len(sl):
+                c, nrm, ax, r, hl, depth = sl[si]
+                out.append((c, nrm, r, idx))
+            si += 1
+            continue
+        if i < len(pl):
+            c, nrm, r, depth = pl[i]
+            out.append((c, nrm, r, idx))
+        i += 1
+    return out
+
+
+def _slot_placements(geometry, st_type, dims, thickness):
+    """Placement of every oblong slot: (center, normal, axis_dir, radius,
+    half_len, depth). ``axis_dir`` is the unit slot axis in the face plane."""
+    holes = geometry.get('holes', [])
+    t = st_type.upper()
+    out = []
+    for h in holes:
+        if h.get('kind') != 'slot':
+            continue
+        r = h['d'] / 2.0
+        L = h.get('length') or 0.0
+        ang = math.radians(h.get('angle') or 0.0)
+        ca, sa = math.cos(ang), math.sin(ang)
+        # DSTV slot 'length' is the centre-to-centre distance of the two end
+        # radii (verified against every real 01-CN file: length < diameter).
+        # The straight part occupies that full length, so half_len = L / 2.
+        half_len = max(L / 2.0, 0.0)
+        if t == 'I':
+            b = _dim(dims, 2, 150.0)
+            tf = _dim(dims, 3, 12.0)
+            tw = _dim(dims, 4, 8.0)
+            face = h.get('face', '')
+            if face in ('v', 'h'):
+                # Web face: face-local X = world X, face-local Y = world Z.
+                # A slot at DSTV angle 0 therefore runs along world X.
+                out.append(((h['x'], 0.0, h['y']), (0, 1, 0),
+                            (ca, 0.0, sa), r, half_len, tw))
+            else:
+                # Flange faces (o / u): face-local X = world X, face-local
+                # Y = world Y.  Slot at angle 0 runs along world X.
+                y3 = h['y'] - b / 2.0
+                out.append(((h['x'], y3, tf / 2.0), (0, 0, 1),
+                            (ca, sa, 0.0), r, half_len, tf))
+        elif t == 'L':
+            # Angle: face v is the vertical leg (b) whose DSTV Y maps to world
+            # Z; face u is the horizontal leg (a) whose DSTV Y maps to world Y
+            # (mirrors face_planes._l_frame and part3d._cs_l).
+            t0 = _dim(dims, 3, 6.0)
+            face = h.get('face', '')
+            if face == 'v':
+                # Vertical leg: face-local X = world X, face-local Y = world Z.
+                # A slot at DSTV angle 0 therefore runs along world X.
+                out.append(((h['x'], t0 / 2.0, h['y']), (0, 1, 0),
+                            (ca, 0.0, sa), r, half_len, t0))
+            else:
+                # Horizontal leg (u): face-local X = world X, face-local Y =
+                # world Y.  Slot at angle 0 runs along world X.
+                out.append(((h['x'], h['y'], t0 / 2.0), (0, 0, -1),
+                            (ca, sa, 0.0), r, half_len, t0))
+        else:
+            out.append(((h['x'], h['y'], thickness / 2.0), (0, 0, 1),
+                        (ca, sa, 0.0), r, half_len, thickness))
+    return out
+
+
+def slot_rims(geometry, st_type, dims, thickness, seg=10):
+    """Return [(hole_index, [3D points])] with the boundary rim of every slot.
+
+    Used by the 3D viewer to draw the oblong outline (instead of a plain
+    circle) for slotted holes, so they are clearly visible as slots.
+    """
+    holes = geometry.get('holes', [])
+    slot_idx = [idx for idx, h in enumerate(holes) if h.get('kind') == 'slot']
+    out = []
+    for idx, sp in zip(slot_idx,
+                       _slot_placements(geometry, st_type, dims, thickness)):
+        c, n, ax, r, hl, depth = sp
+        out.append((idx, _slot_loop(c, n, ax, r, hl, seg)))
+    return out
+
+
+def _hole_placements(geometry, st_type, dims, length, thickness):
+    """Return list of (center, outward_normal, radius, depth) per round hole.
+
+    ``center`` is the bore midpoint, ``depth`` the material thickness the hole
+    passes through (web, flange or plate thickness). Slots are handled by
+    ``_slot_placements`` and are skipped here.
+    """
+    holes = geometry.get('holes', [])
+    out = []
+    t = st_type.upper()
+
+    if t == 'I':
+        b = _dim(dims, 2, 150.0)
+        tf = _dim(dims, 3, 12.0)
+        tw = _dim(dims, 4, 8.0)
+        for h in holes:
+            if h.get('kind') == 'slot':
+                continue
+            r = h['d'] / 2.0
+            face = h.get('face', '')
+            if face in ('v', 'h'):
+                out.append(((h['x'], 0.0, h['y']), (0, 1, 0), r, tw))
+            elif face == 'o':
+                # top flange: bore at z = H - tf/2
+                H = _dim(dims, 1, 300.0)
+                y3 = h['y'] - b / 2.0
+                out.append(((h['x'], y3, H - tf / 2.0), (0, 0, 1), r, tf))
+            elif face == 'u':
+                y3 = h['y'] - b / 2.0
+                out.append(((h['x'], y3, tf / 2.0), (0, 0, 1), r, tf))
+            else:
+                out.append(((h['x'], h['y'] - b / 2.0, tf / 2.0), (0, 0, 1), r, tf))
+        return out
+
+    if t == 'L':
+        # Angle: face v sits on the vertical leg (b, dims[2]) and its DSTV
+        # Y runs up the leg -> world Z; face u sits on the horizontal leg
+        # (a, dims[1]) and its DSTV Y runs across the leg -> world Y.
+        # Both bores pass through the leg thickness t0 (verified against
+        # real Lantek DSTV files and the 3D section in part3d._cs_l).
+        t0 = _dim(dims, 3, 6.0)
+        for h in holes:
+            if h.get('kind') == 'slot':
+                continue
+            r = h['d'] / 2.0
+            face = h.get('face', '')
+            if face == 'v':
+                # vertical leg: bore at mid-leg-thickness, drilled from +y
+                out.append(((h['x'], t0 / 2.0, h['y']), (0, 1, 0), r, t0))
+            else:
+                # horizontal leg: bore at mid-leg-thickness, drilled from -z
+                out.append(((h['x'], h['y'], t0 / 2.0), (0, 0, -1), r, t0))
+        return out
+
+    for h in holes:
+        if h.get('kind') == 'slot':
+            continue
+        r = h['d'] / 2.0
+        out.append(((h['x'], h['y'], thickness / 2.0), (0, 0, 1), r, thickness))
+    return out
+
+
+# ---------------------------------------------------------------- export
+def _triangulate(pts):
+    """Fan-triangulate a convex polygon into triangles."""
+    n = len(pts)
+    return [[pts[0], pts[i], pts[(i + 1) % n]] for i in range(1, n - 1)]
+
+
+def _face_normal(pts):
+    return _norm(_cross(_sub(pts[1], pts[0]), _sub(pts[2], pts[0])))
+
+def export_obj(geometry, path):
+    """Write the 3D solid as a Wavefront OBJ + companion .mtl file."""
+    model = build_model(geometry)
+    mtl_path = os.path.splitext(path)[0] + '.mtl'
+    mat_name = os.path.basename(os.path.splitext(path)[0])
+    mats = {}
+    order = []
+    for fac in model:
+        c = fac.get('color')
+        if c not in mats:
+            mats[c] = len(order)
+            order.append(c)
+    vertices = []
+    faces = []  # (mat_index, [v0, v1, v2])
+    normals = []
+    for fac in model:
+        if len(fac['pts']) < 3:
+            continue
+        nrm = fac.get('normal') or _face_normal(fac['pts'])
+        base = len(vertices)
+        for pt in fac['pts']:
+            vertices.append(pt)
+            normals.append(nrm)
+        for tri in _triangulate(fac['pts']):
+            idx = [base + fac['pts'].index(pt) for pt in tri]
+            faces.append((mats[fac.get('color')], idx))
+    with open(path, 'w', encoding='utf-8') as fh:
+        fh.write('# NCCORECTION export\n')
+        fh.write(f'mtllib {os.path.basename(mtl_path)}\n')
+        fh.write(f'o {mat_name}\n')
+        for v in vertices:
+            fh.write(f'v {v[0]:.4f} {v[1]:.4f} {v[2]:.4f}\n')
+        for nrm in normals:
+            fh.write(f'vn {nrm[0]:.4f} {nrm[1]:.4f} {nrm[2]:.4f}\n')
+        usemtl = None
+        for mat, idx in faces:
+            if mat != usemtl:
+                fh.write(f'usemtl {mat_name}_m{mat}\n')
+                usemtl = mat
+            fh.write('f ' + ' '.join(f'{i + 1}//{i + 1}' for i in idx) + '\n')
+    with open(mtl_path, 'w', encoding='utf-8') as fh:
+        for mi, c in enumerate(order):
+            fh.write(f'newmtl {mat_name}_m{mi}\n')
+            fh.write(f'Kd {c[0] / 255.0:.4f} {c[1] / 255.0:.4f} {c[2] / 255.0:.4f}\n')
+            fh.write(f'Ka 0.1 0.1 0.1\nKs 0.4 0.4 0.4\nNs 24.0\nd 1.0\n\n')
+    return len(faces)
+
+
+def export_stl(geometry, path):
+    """Write the 3D solid as a binary STL (solid for 3D printing/CAO)."""
+    import struct
+    model = build_model(geometry)
+    tris = []
+    for fac in model:
+        if len(fac['pts']) < 3:
+            continue
+        nrm = fac.get('normal') or _face_normal(fac['pts'])
+        for tri in _triangulate(fac['pts']):
+            tris.append((nrm, tri))
+    buf = bytearray(80)
+    buf += struct.pack('<I', len(tris))
+    for nrm, tri in tris:
+        for v in (nrm, *tri):
+            buf.extend(struct.pack('<3f', *v))
+        buf += struct.pack('<H', 0)
+    with open(path, 'wb') as fh:
+        fh.write(bytes(buf))
+    return len(tris)
