+    """
+
+    part_created = Signal(dict)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._lang = 'en'
+        self._current_category = 'All'
+        self._shape: PlateShape = SHAPE_LIBRARY[0]
+        self._params: dict = self._shape.defaults()
+        self._shape_buttons: dict = {}   # name → ShapeButton
+        self._build_ui()
+        self._select_shape(self._shape.name)
+
+    # ── i18n ──────────────────────────────────────────────────────
+
+    def _t(self, key: str) -> str:
+        """Translate a key using the current language."""
+        return _I18N.get(self._lang, _I18N['en']).get(key, key)
+
+    def _toggle_lang(self):
+        """Switch between English and French."""
+        self._lang = 'fr' if self._lang == 'en' else 'en'
+        self._retranslate_ui()
+
+    def _retranslate_ui(self):
+        """Update all translatable labels."""
+        t = self._t
+        self.setWindowTitle(t('dialog_title'))
+        self._left_label.setText(t('shapes_label'))
+        self._search_box.setPlaceholderText(t('search_placeholder'))
+        self._lbl_name.setText(t('part_name'))
+        self._lbl_qty.setText(t('qty'))
+        self._lbl_thk.setText(t('thk'))
+        self._lbl_steel.setText(t('steel'))
+        self._btn_cancel.setText(t('cancel'))
+        self._btn_ok.setText(t('ok'))
+        self._lang_btn.setText(t('lang_btn'))
+        # Category combo — update "All" label
+        self._cat_combo.setItemText(0, t('all'))
+        self._refresh_preview()
+
+    # ── Build UI ──────────────────────────────────────────────────
+
+    def _build_ui(self):
+        t = self._t
+        self.setStyleSheet("""
+            QDialog { background-color: #0f172a; }
+            QLabel { color: #94a3b8; font-weight: bold; }
+            QDoubleSpinBox, QSpinBox, QLineEdit {
+                background-color: #1e293b; color: #f8fafc;
