+"""closure_builder.py — Close contours.
+
+🚨 GUARDIAN LAW: Single responsibility — closure فقط.
+
+الهدف: ضمان بلي كل face contour مسدود (آخر نقطة = أول نقطة).
+"""
+from __future__ import annotations
+from typing import List
+
+from ..core.enums import Face
+from ..models.contour_point import ContourPoint
+from ..models.contour import Contour
+from .base_builder import BaseBuilder
+
+
+class ClosureBuilder(BaseBuilder):
+    """كايسد المحيط (Contour)."""
+
+    def __init__(self, face: Face, points: List[ContourPoint]):
+        super().__init__()
+        self.face = face
+        self.points = list(points)
+
+    def _build_impl(self) -> Contour:
+        contour = Contour(face=self.face)
+        contour.add_points(self.points)
+        contour.close()
+        return contour
+
+    def _validate(self) -> bool:
+        return (
+            self._result is not None
+            and self._result.is_closed
+            and self._result.point_count >= 5
+        )
