+            self.audit.log(f'Saved original {dst}', 'ok', 'OK-110')
+            self._set_status(f"{self.tr_('saved_to')} {dst}")
+            self._toast(f"{self.tr_('saved_to')} {dst}", kind='success',
+                        title=self.tr_('save_edits'))
+
+    # --------------------------------------------------- batch / single export
+    def _export_selected(self, fmt, targets=None):
+        targets = targets or self._selection_targets(
+            self.table.currentRow())
+        if not targets:
+            self._toast(self.tr_('export_none'), title=self.tr_('export'))
+            return
+        if len(targets) > 1:
+            out = QFileDialog.getExistingDirectory(self, self.tr_('export_folder'))
+            if not out:
+                return
+            dxf_opts = None
+            if fmt == 'dxf':
+                # Workshop B: ONE face/layout choice applied to the whole
+                # batch (only when at least one part has several faces)
+                all_faces = []
+                for f in targets:
+                    all_faces += self._distinct_faces(self._geometry_for(f))
+                all_faces = list(dict.fromkeys(all_faces))
+                if len(all_faces) > 1:
+                    dxf_opts = self._ask_dxf_export_options(
+                        all_faces, n_files=len(targets),
+                        geometry=self._geometry_for(targets[0]))
+                    if dxf_opts is None:
+                        return
+            ok = err = 0
+            for f in targets:
+                base = os.path.splitext(os.path.basename(f['name']))[0]
+                path = os.path.join(out, f'{base}.{fmt}')
+                if self._export_one(f, f'.{fmt}', path, dxf_opts=dxf_opts):
+                    ok += 1
+                else:
+                    err += 1
+            self.status_label.setText(
+                f'{self.tr_("export_ok")} {ok} / {len(targets)}'
+                + (f' ({err} ' + self.tr_('export_fail') + ')' if err else ''))
+            return
+        f = targets[0]
+        self.selected = {self.files.index(f)}
+        self._render_table()
+        ext = f'.{fmt}'
+        base = os.path.splitext(os.path.basename(f['name']))[0]
+        default = os.path.join(os.path.expanduser('~'), 'Documents', f'{base}{ext}')
+        labels = {'nc1': 'NC/NC1 (*.nc1 *.nc)', 'cn': 'CN (*.cn)',
+                  'dxf': 'DXF (*.dxf)', 'obj': 'OBJ (*.obj)', 'stl': 'STL (*.stl)'}
+        path, _ = QFileDialog.getSaveFileName(
+            self, self.tr_('export_save'), default, labels.get(fmt, 'Tous fichiers (*)'))
+        if not path:
+            return
+        if not os.path.splitext(path)[1].lower():
+            path += ext
+        if self._export_one(f, ext, path):
+            self.status_label.setText(f'{self.tr_("export_ok")} {path}')
+
+    def _export_one(self, f, ext, path, dxf_opts=None):
+        try:
+            if ext == '.dxf':
+                from nccorrection.core.dxf_writer import export_dxf
+                geometry = self._geometry_for(f)
+                opts = dxf_opts
+                if opts is None:
+                    faces = self._distinct_faces(geometry)
+                    if len(faces) > 1:
+                        opts = self._ask_dxf_export_options(
+                            faces, geometry=geometry)
+                        if opts is None:
+                            return False
+                if opts:
+                    export_dxf(geometry, path,
+                               faces=opts[0], layout=opts[1])
+                else:
+                    export_dxf(geometry, path)
+                return True
+            if ext in ('.nc', '.nc1', '.cn'):
+                from nccorrection.core.nc1_writer import apply_hole_edits
+                edits = dict(self.hole_overrides.get(f['hash'], {}))
+                for i in self.hole_deleted.get(f['hash'], set()):
+                    edits[i] = None
+                new_text = apply_hole_edits(
+                    f['text'], edits,
+                    add_holes=self.added_holes.get(f['hash'], []))
+                with open(path, 'w', encoding='latin-1', newline='') as fh:
+                    fh.write(new_text)
+                return True
+            from nccorrection.core.part3d import export_obj, export_stl
+            g = self._geometry_for(f)
+            if ext == '.stl':
+                export_stl(g, path)
+            else:
+                if ext != '.obj':
+                    path += '.obj'
+                export_obj(g, path)
+            return True
+        except Exception as exc:
+            self._toast(f"{self.tr_('export_fail')}\n{exc}", kind='error',
+                        title=self.tr_('export'))
+            return False
+
+    def _geometry_for(self, f):
+        try:
+            from nccorrection.core.hole_ops import apply_edits
+            geometry = parse_geometry(f['text'])
+            overrides = self.hole_overrides.get(f['hash'], {})
+            deleted = self.hole_deleted.get(f['hash'], set())
+            added = self.added_holes.get(f['hash'], [])
+            return apply_edits(geometry, overrides, deleted, added)[0]
+        except Exception as e:
+            self._report_error('geometry-for', e)
+            return parse_geometry(f['text'])
