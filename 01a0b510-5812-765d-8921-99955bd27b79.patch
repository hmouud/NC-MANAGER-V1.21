+
+        # Params
+        params = QGridLayout()
+
+        params.addWidget(QLabel("Thickness (mm):"), 0, 0)
+        self._thickness = QDoubleSpinBox()
+        self._thickness.setRange(1.0, 200.0)
+        self._thickness.setValue(10.0)
+        self._thickness.setSuffix(" mm")
+        params.addWidget(self._thickness, 0, 1)
+
+        params.addWidget(QLabel("Length (mm):"), 1, 0)
+        self._length_spin = QDoubleSpinBox()
+        self._length_spin.setRange(50.0, 20000.0)
+        self._length_spin.setValue(1000.0)
+        self._length_spin.setSuffix(" mm")
+        params.addWidget(self._length_spin, 1, 1)
+
+        params.addWidget(QLabel("Qty:"), 2, 0)
+        self._qty = QDoubleSpinBox()
+        self._qty.setRange(1, 9999)
+        self._qty.setValue(1)
+        params.addWidget(self._qty, 2, 1)
+
+        params.addWidget(QLabel("Steel:"), 3, 0)
+        self._steel = QComboBox()
+        self._steel.addItems(["S235JR", "S275JR", "S355JR", "S460ML"])
+        params.addWidget(self._steel, 3, 1)
+
+        right_layout.addLayout(params)
+
+        # Separator
+        sep2 = QFrame()
+        sep2.setFrameShape(QFrame.HLine)
+        sep2.setStyleSheet("color:#334155;")
+        right_layout.addWidget(sep2)
+
+        # Status
+        self._status_label = QLabel("Entities: 0  |  Holes: 0")
+        self._status_label.setStyleSheet("color:#94a3b8; font-size:11px;")
+        right_layout.addWidget(self._status_label)
+
+        self._coord_label = QLabel("X=0.0  Y=0.0")
+        self._coord_label.setStyleSheet("color:#60a5fa; font-size:11px;")
+        right_layout.addWidget(self._coord_label)
+
+        right_layout.addStretch()
+
+        # Buttons
+        btn_layout = QHBoxLayout()
+        self._cancel_btn = QPushButton("Cancel")
+        self._cancel_btn.clicked.connect(self.reject)
+        btn_layout.addWidget(self._cancel_btn)
+
+        self._ok_btn = QPushButton("Generate NC1")
+        self._ok_btn.clicked.connect(self._generate)
+        btn_layout.addWidget(self._ok_btn)
+        right_layout.addLayout(btn_layout)
+
+        splitter.addWidget(right)
+        splitter.setStretchFactor(0, 4)
+        splitter.setStretchFactor(1, 1)
+
+        root.addWidget(splitter)
+
+    # ── Tool handling ─────────────────────────────────────────────
+
+    def _set_tool(self, tool: Tool):
+        self._canvas.set_tool(tool)
+
+    def _set_dim(self, kind: str):
+        self._canvas.set_dim_kind(kind)
+        self._canvas.set_tool(Tool.DIMENSION)
+
+    def _undo(self):
+        self._canvas.undo()
+
+    def _redo(self):
+        self._canvas.redo()
+
+    def _clear(self):
+        reply = QMessageBox.question(
+            self, "Clear All",
+            "Remove all entities?",
+            QMessageBox.Yes | QMessageBox.No,
+            QMessageBox.No,
+        )
+        if reply == QMessageBox.Yes:
+            self._canvas.clear_all()
+
+    # ── Status ────────────────────────────────────────────────────
+
+    def _update_status(self):
+        ne = self._canvas.get_entity_count()
+        nh = self._canvas.get_hole_count()
+        nd = len(self._canvas.get_dimension_sets())
+        self._status_label.setText(f"Entities: {ne}  |  Holes: {nh}  |  Dims: {nd}")
+
+    def _on_status(self, text: str):
+        if "X=" in text:
+            self._coord_label.setText(text)
+        else:
+            self._status_label.setText(text)
+
+    # ── Language ──────────────────────────────────────────────────
+
+    def _toggle_lang(self):
+        self._lang = 'fr' if self._lang == 'en' else 'en'
+        t = _I18N[self._lang]
+        self.setWindowTitle(t['title'])
+        self._btn_select.setText(t['select'])
+        self._btn_line.setText(t['line'])
+        self._btn_arc.setText(t['arc'])
+        self._btn_hole.setText(t['hole'])
+        self._btn_rect.setText(t['rect'])
+        self._btn_circle.setText(t['circle'])
+        self._btn_dim_h.setText(t['dim_h'])
+        self._btn_dim_v.setText(t['dim_v'])
+        self._btn_dim_auto.setText(t['dim_auto'])
+        self._btn_undo.setText(t['undo'])
+        self._btn_redo.setText(t['redo'])
+        self._btn_clear.setText(t['clear'])
+        self._cancel_btn.setText(t['cancel'])
+        self._ok_btn.setText(t['ok'])
+        self._lang_btn.setText(t['lang_btn'])
+
+    # ── Generate NC1 ──────────────────────────────────────────────
+
+    def _generate(self):
+        outer = self._canvas.get_outer_contour()
+        if len(outer) < 3:
+            QMessageBox.warning(
+                self, "Error",
+                "Draw at least 3 points (a closed shape) before generating NC1.")
+            return
+
+        from nccorrection.engine.part_creator.nc1_generator import (
+            generate_nc1_from_contour,
+        )
+
+        nc1_text = generate_nc1_from_contour(
+            outer,
+            holes=self._canvas.get_holes(),
+            order="DRAWING-TOOL",
+            steel_grade=self._steel.currentText(),
+            quantity=int(self._qty.value()),
+            thickness=self._thickness.value(),
+        )
+
+        self.part_created.emit({
+            'nc1_text': nc1_text,
+            'shape_name': 'Custom Drawing',
+            'thickness': self._thickness.value(),
+            'steel_grade': self._steel.currentText(),
+            'quantity': int(self._qty.value()),
+            'outer_contour': outer,
+            'holes': self._canvas.get_holes(),
+        })
+
+        self.accept()
