+class TestForeshorten(unittest.TestCase):
+    """Smart Foreshortening in the unfolded blueprint + measure integration."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        self.w = DstvRenderer2D()
+        self.w.resize(900, 640)
+
+    def test_build_foreshorten_cuts_long_middle_void(self):
+        part = DstvParser().parse_text(LONG_BEAM)
+        self.w.set_part(part)
+        self.w.set_foreshorten(True)
+        self.assertTrue(self.w.foreshorten_enabled())
+        m = self.w._foreshorten
+        self.assertIsNotNone(m)
+        self.assertEqual(m.void_count, 1)
+        self.assertLess(m.display_length, m.total_length)
+        # The compression ratio is DERIVED from the widget width (900 px here):
+        # the ends (490 + 20 + 20 + 490 = 1020 mm of 1:1 content) get breathing
+        # room and the 10 980 mm void is clamped to the 5% floor -> display
+        # 1020 + 0.05*10980 = 1569 mm (the old hardcoded 0.10 gave 2118 mm).
+        self.assertAlmostEqual(m.display_length, 1569.0, delta=1e-6)
+        # the ends keep breathing room: with 1:1 content already wider than
+        # the 80% target the void compression clamps to the 5% floor
+        self.assertEqual(m.display_length, 1020.0 + 0.05 * 10980.0)
+        for x in (0.0, 200.0, 6000.0, 11900.0, 12000.0):
+            s = m.map_real_to_screen(x)
+            self.assertAlmostEqual(m.map_screen_to_real(s), x, delta=1e-6)
+
+    def test_toggle_off_restores_identity(self):
+        part = DstvParser().parse_text(SAMPLE)
+        self.w.set_part(part)
+        self.w.set_foreshorten(False)
+        self.assertFalse(self.w.foreshorten_enabled())
+        self.assertIsNone(self.w._foreshorten)
+        _, bounds, mapping = self.w._unfold_scene(part)
+        self.assertIsNone(mapping)
+        _, real_bounds = self.w._unfold_layout(part)
+        self.assertEqual(bounds, real_bounds)
+
+    def test_rear_web_h_compressed_identically(self):
+        """The rear web 'h' shares the beam-length axis with v/o/u, so Smart
+        Foreshortening compresses its LOCAL X with the very same mapping and
+        break marks; only its display translation differs (it is laid out to
+        the right of the web)."""
+        part = DstvParser().parse_text(LONG_BEAM)
+        self.w.set_part(part)
+        self.w.set_foreshorten(True)
+        m = self.w._foreshorten
+        vb = self.w._face_box(part.get_face('v'))
+        hb = self.w._face_box(part.get_face('h'))
+        # same physical length -> same compressed display length
+        self.assertAlmostEqual(hb[2] - hb[0], vb[2] - vb[0])
+        d = m.map_real_to_screen(vb[2] - vb[0])
+        self.assertLess(d, (vb[2] - vb[0]) * 0.5)
+        # the real offsets still lay h out past the beam axis (to the right)
+        offs, bounds, mapping = self.w._unfold_scene(part)
+        self.assertIsNotNone(mapping)
+        self.assertGreater(offs['h'][0], m.total_length)
+        # display envelope = web copy [0, D] + rear web copy [D, 2D]
+        self.assertAlmostEqual(bounds[2], 2.0 * mapping.display_length,
+                               delta=1e-6)
+
+    def test_render_foreshortened_to_pixmap_with_break_lines(self):
