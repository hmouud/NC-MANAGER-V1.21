+        menu.addSeparator()
+        del_act = menu.addAction("Delete")
+        del_act.triggered.connect(lambda: self.delete_requested.emit(row))
+
+        menu.exec(self.holes_table.viewport().mapToGlobal(pos))
+
+    def _on_table_item_changed(self, item) -> None:
+        """Handle inline editing of hole/slot cells."""
+        if not item or self._populating:
