+# ────────────────────────────────────────────────────────────────────
+# Preview widgets
+# ────────────────────────────────────────────────────────────────────
+
+class SectionPreview(QWidget):
+    """Cross-section view: I-shape / C-shape / L-shape / circle / rect."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._points = []
+        self._inners = []
+        self._profile_kind = 'I'
+        self._web_thick = 0.0
+        self._flange_thick = 0.0
+        self._width = 0.0
+        self._depth = 0.0
+        self.setMinimumSize(200, 200)
+
+    def set_geometry(self, outer, inners=None, profile_kind='I',
+                     web_thick=0.0, flange_thick=0.0, width=0.0, depth=0.0):
+        self._points = outer or []
+        self._inners = inners or []
+        self._profile_kind = profile_kind
+        self._web_thick = web_thick
+        self._flange_thick = flange_thick
+        self._width = width
+        self._depth = depth
+        self.update()
+
+    def paintEvent(self, event):
+        if not self._points:
+            return
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), QColor("#0f172a"))
+
+        xs = [pt[0] for pt in self._points]
+        ys = [pt[1] for pt in self._points]
+        min_x, max_x = min(xs), max(xs)
+        min_y, max_y = min(ys), max(ys)
+        dw = max_x - min_x
+        dh = max_y - min_y
+        if dw <= 0 or dh <= 0:
+            return
+
+        pad = 20
+        ww = self.width() - 2 * pad
+        wh = self.height() - 2 * pad
+        scale = min(ww / dw, wh / dh)
+        ox = pad + (ww - dw * scale) / 2
+        oy = pad + (wh - dh * scale) / 2
+
+        def tx(x):
+            return ox + (x - min_x) * scale
+
+        def ty(y):
+            return oy + (dh - (y - min_y)) * scale
+
+        # Outer
+        path = QPainterPath()
+        path.moveTo(tx(self._points[0][0]), ty(self._points[0][1]))
+        for x, y in self._points[1:]:
+            path.lineTo(tx(x), ty(y))
+        path.closeSubpath()
+        p.setPen(QPen(QColor("#38bdf8"), 1.5))
+        p.setBrush(QBrush(QColor("#1e3a5f")))
+        p.drawPath(path)
+
+        # Draw internal structure lines based on profile kind
+        if self._profile_kind == 'I' and self._web_thick > 0 and self._flange_thick > 0:
+            # Web line (vertical center)
+            cx = (min_x + max_x) / 2.0
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(cx), ty(min_y), tx(cx), ty(max_y))
+            # Top flange line
+            tf_y = max_y - self._flange_thick
+            p.drawLine(tx(min_x), ty(tf_y), tx(max_x), ty(tf_y))
+            # Bottom flange line
+            bf_y = min_y + self._flange_thick
+            p.drawLine(tx(min_x), ty(bf_y), tx(max_x), ty(bf_y))
+
+        elif self._profile_kind == 'U' and self._web_thick > 0:
+            # Channel: web line at left side
+            wx = min_x + self._web_thick
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(wx), ty(min_y), tx(wx), ty(max_y))
+
+        elif self._profile_kind == 'L' and self._web_thick > 0:
+            # Angle: horizontal leg line
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(min_x), ty(min_y + self._web_thick),
+                       tx(max_x), ty(min_y + self._web_thick))
+
+        elif self._profile_kind == 'O':
+            # Round: center crosshair
+            cx = (min_x + max_x) / 2.0
+            cy = (min_y + max_y) / 2.0
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(cx), ty(min_y), tx(cx), ty(max_y))
+            p.drawLine(tx(min_x), ty(cy), tx(max_x), ty(cy))
+
+        # Inners
+        for inner in self._inners:
+            if len(inner) < 3:
+                continue
+            ip = QPainterPath()
+            ip.moveTo(tx(inner[0][0]), ty(inner[0][1]))
+            for x, y in inner[1:]:
+                ip.lineTo(tx(x), ty(y))
+            ip.closeSubpath()
+            p.setPen(QPen(QColor("#f97316"), 1.0))
+            p.setBrush(QBrush(QColor("#0f172a")))
+            p.drawPath(ip)
+
+        # Dimension labels
+        p.setPen(QPen(QColor("#94a3b8"), 1.0))
+        font = p.font()
+        font.setPointSize(8)
+        p.setFont(font)
+        # Height label on right
+        h_text = f"h={self._depth:.0f}"
+        p.drawText(tx(max_x) + 5, ty(max_y / 2.0), h_text)
+        # Width label on bottom
+        w_text = f"b={self._width:.0f}"
+        p.drawText(tx(min_x + dw / 2.0 - 15), ty(min_y) + 15, w_text)
+
+        p.end()
+
+
+class SideViewPreview(QWidget):
+    """Side view: beam length (x) x profile height (y) with hole positions."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._length = 0.0
+        self._height = 0.0
+        self._holes = []       # [(x, y, dia), ...]
+        self._cut_angle = 0.0
+        self._profile_kind = 'I'
+        self._web_thick = 0.0
+        self._flange_thick = 0.0
+        self._width = 0.0
+        self.setMinimumSize(200, 200)
+
+    def set_data(self, length, height, holes=None, cut_angle=0.0,
+                 profile_kind='I', web_thick=0.0, flange_thick=0.0, width=0.0):
+        self._length = length
+        self._height = height
+        self._holes = holes or []
+        self._cut_angle = cut_angle
+        self._profile_kind = profile_kind
+        self._web_thick = web_thick
+        self._flange_thick = flange_thick
+        self._width = width
+        self.update()
+
+    def paintEvent(self, event):
+        if self._length <= 0 or self._height <= 0:
+            return
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), QColor("#0f172a"))
+
+        pad = 20
+        ww = self.width() - 2 * pad
+        wh = self.height() - 2 * pad
+        scale = min(ww / self._length, wh / self._height)
+        ox = pad + (ww - self._length * scale) / 2
+        oy = pad + (wh - self._height * scale) / 2
+
+        def tx(x):
+            return ox + x * scale
+
+        def ty(y):
+            return oy + (self._height - y) * scale
+
+        # Beam outline
+        p.setPen(QPen(QColor("#38bdf8"), 1.5))
+        p.setBrush(QBrush(QColor("#1e3a5f")))
+        p.drawRect(tx(0), ty(self._height),
+                   tx(self._length) - tx(0),
+                   ty(0) - ty(self._height))
+
+        # Internal structure lines based on profile kind
+        if self._profile_kind == 'I' and self._web_thick > 0:
+            # Web line (center vertical)
+            web_x = self._width / 2.0 if self._width > 0 else self._web_thick / 2.0
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(0), ty(self._height / 2.0), tx(self._length), ty(self._height / 2.0))
+            # Flange lines (horizontal)
+            if self._flange_thick > 0:
+                p.drawLine(tx(0), ty(self._flange_thick), tx(self._length), ty(self._flange_thick))
+                p.drawLine(tx(0), ty(self._height - self._flange_thick),
+                           tx(self._length), ty(self._height - self._flange_thick))
+        elif self._profile_kind == 'U' and self._web_thick > 0:
+            # Channel: web line at left side
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(0), ty(self._height / 2.0), tx(self._length), ty(self._height / 2.0))
+        elif self._profile_kind == 'L' and self._web_thick > 0:
+            # Angle: two lines meeting at corner
+            p.setPen(QPen(QColor("#60a5fa"), 0.8, Qt.DotLine))
+            p.drawLine(tx(0), ty(self._web_thick), tx(self._length), ty(self._web_thick))
+
+        # Cut angle indicator
+        if abs(self._cut_angle) > 0.01:
+            p.setPen(QPen(QColor("#f97316"), 1.0, Qt.DashLine))
+            rad = math.radians(self._cut_angle)
+            dx = self._height * math.tan(rad) / 2.0
+            p.drawLine(tx(0), ty(0), tx(dx), ty(self._height))
+            p.drawLine(tx(self._length), ty(0),
+                       tx(self._length - dx), ty(self._height))
+
+        # Holes
+        if self._holes:
+            p.setPen(QPen(QColor("#ef4444"), 1.0))
+            p.setBrush(QBrush(QColor("#7f1d1d")))
+            for hx, hy, hd in self._holes:
+                r = hd * scale / 2.0
+                cx = tx(hx)
+                cy = ty(hy)
+                if r < 2:
+                    r = 2
+                p.drawEllipse(cx - r, cy - r, r * 2, r * 2)
+
+        p.end()
+
