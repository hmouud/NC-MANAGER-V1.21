+++ b/src/nccorrection/ui/components/scaling.py
@@ -0,0 +1,98 @@
+"""Scalable sizing helpers for the presentation layer.
+
+Qt6 already applies automatic high-DPI scaling to QSS pixel sizes and widget
+geometry (widget coordinates are device-independent pixels). These helpers
+centralize every size decision so nothing hardcodes raw px around the app:
+
+    font_pt(px)  -> physical points for QSS ``font-size`` (recommended). Points
+                    are physical units (1pt = 1/72 inch) so typography stays
+                    crisp and consistent on 100%, 150%, 200% ... screens.
+    sp(px)       -> device-independent logical px (Qt scales it for DPI).
+                    Optionally multiplied by a user UI density factor so the
+                    whole interface can be enlarged without touching QSS.
+    dp(px)       -> physical device pixels = sp(px) * devicePixelRatio.
+                    Use for rasterizing SVG/PNG pixmaps (4K/8K crispness).
+
+Import as a pure module so both styles.py and future components can use it:
+
+    from nccorrection.ui.components.scaling import sp, dp, font_pt, configure
+
+``configure()`` is safe to call before any QApplication exists (all lookups are
+guarded); call it again after the app + settings are loaded to set density.
+"""
+from __future__ import annotations
+
+_QT_APP = None
+_DENSITY = 1.0   # user UI density preference (default 1.0)
+_DPI = 96.0      # logical dots per inch of the primary screen
+_DPR = 1.0       # device pixel ratio (physical = logical * DPR)
+
+_MIN_DENSITY = 0.85
+_MAX_DENSITY = 1.4
+
+
+def configure(qapp=None, density=None):
+    """Refresh screen metrics and (optionally) set a UI density factor.
+
+    ``density`` in [0.85, 1.4]; 1.0 is the default look. 1.2 enlarges every
+    control/font proportionally without any QSS rewrite.
+    """
+    global _QT_APP, _DPI, _DPR, _DENSITY
+    _QT_APP = qapp
+    if _QT_APP is None:
+        try:
+            from PySide6.QtWidgets import QApplication
+            _QT_APP = QApplication.instance()
+        except Exception:
+            _QT_APP = None
+    screen = None
+    if _QT_APP is not None:
+        try:
+            screen = _QT_APP.primaryScreen()
+        except Exception:
+            screen = None
+    if screen is not None:
+        try:
+            _DPI = float(screen.logicalDotsPerInch() or 96.0)
+        except Exception:
+            _DPI = 96.0
+        try:
+            _DPR = float(screen.devicePixelRatio() or 1.0)
+        except Exception:
+            _DPR = 1.0
+    if density is not None:
+        _DENSITY = max(_MIN_DENSITY, min(_MAX_DENSITY, float(density)))
+    return _DENSITY
+
+
+def refresh(qapp=None):
+    """Re-read screen metrics only (keeps the current density)."""
+    return configure(qapp)
+
+
+def device_scale():
+    """Physical pixels per logical pixel (1.0, 2.0, 3.0 ...)."""
+    return _DPR
+
+def sp(px):
+    """Device-independent logical px (Qt scales it for the screen DPI)."""
+    return int(round(px * _DENSITY))
+
+
+def dp(px):
+    """Physical device px = sp(px) * devicePixelRatio (for pixmaps)."""
+    return int(round(px * _DENSITY * _DPR))
+
+
+def font_pt(px):
+    """Convert a logical px size to physical points for QSS font-size.
+
+    >>> font_pt(10)
+    7
+    """
+    return max(6, int(round(px * 72.0 / 96.0)))
+
+
+def font_px_str(px):
+    """QSS-safe font size as a physical point string: ``font-size:7pt``."""
+    return f'font-size:{font_pt(px)}pt'
