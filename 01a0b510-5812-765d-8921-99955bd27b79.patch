+    def _fold_bends(self, part=None):
+        """Bend dicts for ``part`` (single source: used by ``_fold_pt`` and
+        the Folded View hole filter). 5-column KA dialect: bend thickness
+        may be None — fall back to the part thickness via the SAME estimator
+        the geometry path uses (core.viewer._estimate_thickness, single
+        source of truth, owner law 2026-09-12). Consumers must never
+        receive a None thickness."""
+        from nccorrection.core.viewer import _estimate_thickness
+        part = part or self._part
+        part_t = _estimate_thickness({'type': part.header.profile_type,
+                                      'dims': part.header.raw_dims})
+        return [{'x1': b.x1, 'y1': b.y1, 'x2': b.x2, 'y2': b.y2,
+                 'angle': b.angle,
+                 'thickness': b.thickness if b.thickness is not None
+                 else part_t}
+                for b in part.bends]
+
+    def _fold_pt(self, part, x, y):
+        """Fold one flat-pattern point with the part's KA bends
+        (plan projection, see core/fold.py)."""
+        from nccorrection.core.fold import fold_points_2d
+        bends = self._fold_bends(part)
+        fx, fy = fold_points_2d(bends, [(x, y)])[0]
+        return fx, fy
+
+    def set_foreshorten(self, on):
+        """Toggle Smart Foreshortening (view-break compression) for the
+        Unfolded Blueprint view.
+
+        The beam-length X axis is compressed across the featureless middle
+        voids (engine threshold: a void must exceed 10% of the total length
+        to be cut) and CAD break lines are drawn at each cut. Every
+        measurement keeps reporting the TRUE physical DSTV distance because
+        the measure tool maps each screen X back through
+        ``map_screen_to_real()`` before any OSNAP or distance calculation.
+        """
+        self._foreshorten_enabled = bool(on)
+        self._foreshorten = (self._build_foreshorten(self._part)
+                             if self._foreshorten_enabled and self._part
+                             else None)
+        self._clear_measure()
+        self.update()
+
+    def foreshorten_enabled(self):
+        return self._foreshorten_enabled
+
+    def set_auto_dims(self, on):
+        """Toggle the automatic dimension columns on the Unfolded Blueprint.
+
+        When on, a horizontal chain under the web records every feature X
+        position plus the total length L, and a vertical column carries the
+        profile height H (Phase C: colonnes de cotes automatiques).
+        """
+        self._auto_dims = bool(on)
+        self.update()
+
+    def _build_foreshorten(self, part):
+        """Build the view-break mapping over the part's beam-length X axis.
+
+        Populated zones are the X-extents of the real features on every face
+        that shares the beam-length axis (web + flanges + rear web ``h``):
+        holes, slots, copes / cut-outs and markings, plus the interior corners
+        of the outer contours (angled ends / notches expressed in the AK
+        profile). The ``h`` face is a full-length copy laid out past ``L``, so
+        its features are folded back onto the beam axis (local X measured from
+        its own box start) to produce the identical compression and break
+        marks. The long featureless middle between the detailed ends becomes
+        a cuttable void that the engine compresses on screen while
+        ``map_screen_to_real()`` keeps every measurement at its true DSTV
+        distance.
+        """
+        from nccorrection.engine.math.foreshorten import build_foreshorten
+        if part is None:
+            return None
+        offsets, bounds = self._unfold_layout(part)
+        if not offsets:
+            return None
+        boxes = {c: self._face_box(part.get_face(c)) for c in offsets}
+        vbox = boxes.get('v')
+        L = (vbox[2] - vbox[0]) if vbox else (bounds[2] - bounds[0])
+        if L <= 1e-9:
+            return None
+        zones = []
+        for code, (tx, _ty, _flip) in offsets.items():
+            face = part.get_face(code)
+            if face is None:
+                continue
+            bx0, _by0, bx1, _by1 = boxes[code]
+            # Faces on the beam-length axis (web + flanges) already sit at
+            # beam coordinates after the layout translation; the rear web 'h'
+            # is a full-length copy pushed past ``L``, so its local X is
+            # measured from its own box start (x - bx0) to land on the same
+            # beam axis and produce the identical compression + break marks.
+            on_axis = (tx + bx1 >= 0.0) and (tx + bx0 <= L)
+
+            def bz(x):
+                return (tx + x) if on_axis else (x - bx0)
+
+            outer = face.outer_contour
+            if outer and len(outer.vertices) >= 2:
+                xs = sorted({round(v.x, 6) for v in outer.vertices})
+                for vx in xs[1:-1]:            # interior corners = end detail
+                    zones.append((bz(vx) - 10.0, bz(vx) + 10.0))
+            for hole in face.holes:
+                ext = max(hole.diameter, hole.slot_length or 0.0) / 2.0
+                zones.append((bz(hole.x) - ext, bz(hole.x) + ext))
+            for ic in face.inner_contours:
+                if not ic.vertices:
+                    continue
+                cxs = [bz(v.x) for v in ic.vertices]
+                zones.append((min(cxs), max(cxs)))
+            for mk in face.markings:
+                zones.append((bz(mk.x) - 10.0, bz(mk.x) + 10.0))
+        return build_foreshorten(L, zones, compress=0.25)
+
+    def _unfold_scene(self, part=None):
+        """Blueprint positions + the display envelope (post-foreshorten).
+
+        Returns ``(offsets, display_bounds, mapping)``. ``offsets`` and the
+        Y half of ``display_bounds`` come from the plain unfolded layout;
+        when Smart Foreshortening is active the X half is the mapped
+        (compressed) display extent and ``mapping`` is the Foreshorten
+        instance, otherwise ``mapping`` is ``None`` and the bounds are the
+        real scene bounds.
+        """
+        part = part or self._part
+        offsets, bounds = self._unfold_layout(part)
+        mapping = self._foreshorten if (self._foreshorten_enabled
+                                        and self._foreshorten is not None) \
+            else None
+        if mapping is None:
+            return offsets, bounds, None
+        L = mapping.total_length
+        boxes = {c: self._face_box(part.get_face(c)) for c in offsets
+                 if part.get_face(c) is not None}
+        xs = []
+        ys = []
+        for code, (tx, ty, _flip) in offsets.items():
+            if code not in boxes:
+                continue
+            bx0, by0, bx1, by1 = boxes[code]
+            if (tx + bx1 >= 0.0) and (tx + bx0 <= L):
+                d0 = mapping.map_real_to_screen(tx + bx0)
+                d1 = mapping.map_real_to_screen(tx + bx1)
+            else:
+                # rear web 'h': a full-length copy pushed past the beam axis,
+                # so its display position is the mapped offset of its left
+                # edge plus the identically compressed local length.
+                d0 = mapping.map_real_to_screen(tx + bx0)
+                d1 = d0 + mapping.map_real_to_screen(bx1 - bx0)
+            xs.extend((d0, d1))
+            ys.extend((ty + by0, ty + by1))
+        return offsets, (min(xs), min(ys), max(xs), max(ys)), mapping
+
+
+    def set_grid_visible(self, on):
+        self._show_grid = bool(on)
+        self.update()
+
+    def set_mode(self, mode):
+        """'pan' (default) or 'measure' (cotation: edges + hole diameters)."""
+        self.mode = mode
+        if mode != 'measure':
