+    # ────────────────────────────────────────────────────────────────
+    # Event Filter (canvas click coordinates)
+    # ────────────────────────────────────────────────────────────────
+
+    def eventFilter(self, obj, event):
+        """Capture DSTV coordinates (with snap resolution) when user clicks on canvas."""
+        if obj is self.canvas and event.type() == QEvent.MouseButtonPress:
+            if event.button() in (Qt.LeftButton, Qt.RightButton):
+                sx, sy = event.position().x(), event.position().y()
+                dstv_x, dstv_y = self.canvas._to_scene(sx, sy)
+
+                snap_pt, snap_kind = self.canvas._snap_detail(event.position())
+                if snap_pt is not None:
+                    dstv_x, dstv_y = snap_pt.x(), snap_pt.y()
+                self._last_click_pos = (dstv_x, dstv_y)
+                self._last_snap_kind = snap_kind
+
+                if self._active_tool == 'cut' and event.button() == Qt.LeftButton:
+                    self._handle_cut_click(dstv_x, dstv_y)
+                elif self._active_tool and event.button() == Qt.LeftButton:
+                    self._place_active_tool(dstv_x, dstv_y)
+        return super().eventFilter(obj, event)
