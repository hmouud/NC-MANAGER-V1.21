+import unittest
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.core.plane_switcher import (
+    switch_face_in_text, copy_feature_to_face,
+)
+
+I_BEAM = (
+    'ST\nI\nHEA300\n'
+    '6000.0\n300.0\n150.0\n10.0\n6.0\n'
+    'BO\n'
+    'v 100.00 120.00 18.00\n'
+    'u 300.00 30.00 22.00\n'
+    'v 2000.00 120.00 22.00 0.00 60.00 60.00\n'
+    'EN\n'
+)
+
+U_CHANNEL = (
+    'ST\nU\nUPN200\n'
+    '6000.0\n200.0\n75.0\n8.0\n12.0\n'
+    'BO\n'
+    'v 100.00 120.00 18.00\n'
+    'u 300.00 30.00 22.00\n'
+    'EN\n'
+)
+
+
+def holes(text):
+    return parse_geometry(text)['holes']
+
+
+class TestSwitchFaceInText(unittest.TestCase):
+    def test_moves_web_hole_to_top_flange_i(self):
+        new = switch_face_in_text(I_BEAM, 0, 'o')
+        hs = holes(new)
+        self.assertEqual(hs[0]['face'], 'o')
+        self.assertAlmostEqual(hs[0]['x'], 100.0)
+        self.assertAlmostEqual(hs[0]['y'], 75.0)   # b/2 -> flange centre
+        self.assertTrue(new.endswith('EN\n'))
+
+    def test_leaves_other_lines_untouched(self):
+        new = switch_face_in_text(I_BEAM, 0, 'h')
+        self.assertIn('u 300.00 30.00 22.00', new)
+        self.assertIn('v 2000.00 120.00 22.00 0.00 60.00 60.00', new)
+        self.assertIn('ST\nI\nHEA300', new)
+        self.assertIn('6000.0\n300.0\n150.0\n10.0\n6.0\n', new)
+
+    def test_rethreads_slot_angle(self):
+        # slot index 2 on v, angle 60 -> rear web mirrors to 300.
+        new = switch_face_in_text(I_BEAM, 2, 'h')
+        hs = holes(new)
+        self.assertEqual(hs[2]['face'], 'h')
+        self.assertAlmostEqual(hs[2]['angle'], 300.0)
+        self.assertAlmostEqual(hs[2]['y'], 300.0 - 120.0)
+
+    def test_u_channel_move(self):
+        new = switch_face_in_text(U_CHANNEL, 0, 'o')
+        hs = holes(new)
+        self.assertEqual(hs[0]['face'], 'o')
+        self.assertAlmostEqual(hs[0]['x'], 100.0)
+        self.assertAlmostEqual(hs[0]['y'], 0.0)    # web edge of the flange
+        # the other feature is untouched
+        self.assertEqual(hs[1]['face'], 'u')
+        self.assertAlmostEqual(hs[1]['y'], 30.0)
+
+    def test_same_face_returns_text(self):
+        self.assertEqual(switch_face_in_text(I_BEAM, 0, 'v'), I_BEAM)
+
+    def test_invalid_feature_raises(self):
+        with self.assertRaises(ValueError):
+            switch_face_in_text(I_BEAM, 99, 'o')
+
+    def test_invalid_face_raises(self):
+        with self.assertRaises(ValueError):
+            switch_face_in_text(I_BEAM, 0, 'q')
+
+
+class TestCopyFeatureToFace(unittest.TestCase):
+    def test_appends_copy_on_target_face(self):
+        new = copy_feature_to_face(I_BEAM, 0, 'o')
+        hs = holes(new)
+        self.assertEqual(len(hs), 4)
+        self.assertEqual(hs[0]['face'], 'v')       # original kept
+        self.assertEqual(hs[3]['face'], 'o')       # copy appended
+        self.assertAlmostEqual(hs[3]['x'], 100.0)
+        self.assertAlmostEqual(hs[3]['y'], 75.0)
+        self.assertAlmostEqual(hs[3]['d'], 18.0)
+
