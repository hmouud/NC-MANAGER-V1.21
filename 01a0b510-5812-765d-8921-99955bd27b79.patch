+"""Cotation engine — dimension set creation and rendering.
+
+Usage::
+
+    from nccorrection.engine.cotation import (
+        # Models
+        DimensionStyle, DimensionPoint, DimensionSet,
+        # Phase 1: Linear
+        horizontal, vertical, orthogonal,
+        # Phase 2: Aligned
+        perpendicular, parallel, free,
+        # Phase 3: Angular + Arc
+        angular, arc_dim,
+        AngularDimension, ArcDimension,
+        # Phase 3: Chain management
+        add_point, remove_point, remove_point_at, find_nearest_point,
+        # Phase 4: Auto-dimensioning
+        auto_grid_x, auto_grid_y, auto_bounding_box, auto_grid_from_spacing,
+        # Phase 4: Presets
+        get_preset, list_presets,
+        # Rendering
+        render_dimension_set, render_angular_dimension, render_arc_dimension,
+    )
+"""
+
+from .models import DimensionStyle, DimensionPoint, DimensionSet
+from .linear import horizontal, vertical, orthogonal
+from .aligned import perpendicular, parallel, free
+from .angular import angular, arc_dim, AngularDimension, ArcDimension
+from .chain import (
+    add_point, remove_point, remove_point_at,
+    find_nearest_point, link_chains, unlink_chains,
+)
+from .auto_dim import (
+    auto_grid_x, auto_grid_y, auto_bounding_box, auto_grid_from_spacing,
+)
+from .presets import get_preset, list_presets
+from .renderer import (
+    render_dimension_set, render_angular_dimension, render_arc_dimension,
+)
+
+__all__ = [
+    # Models
+    "DimensionStyle", "DimensionPoint", "DimensionSet",
+    # Phase 1
+    "horizontal", "vertical", "orthogonal",
+    # Phase 2
+    "perpendicular", "parallel", "free",
+    # Phase 3
+    "angular", "arc_dim", "AngularDimension", "ArcDimension",
+    "add_point", "remove_point", "remove_point_at", "find_nearest_point",
+    "link_chains", "unlink_chains",
+    # Phase 4
+    "auto_grid_x", "auto_grid_y", "auto_bounding_box", "auto_grid_from_spacing",
+    "get_preset", "list_presets",
+    # Rendering
+    "render_dimension_set", "render_angular_dimension", "render_arc_dimension",
+]
diff --git a/src/nccorrection/engine/cotation/aligned.py b/src/nccorrection/engine/cotation/aligned.py
new file mode 100644
index 0000000..ac50497
--- /dev/null
+++ b/src/nccorrection/engine/cotation/aligned.py
@@ -0,0 +1,151 @@
+"""Cotation engine — aligned dimension builders (Perpendicular, Parallel, Free).
+
+These dimensions require a reference line defined by 2 points, then
+measurement points are projected onto that line (parallel) or onto
+its normal (perpendicular).
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Tuple
+
+from .models import DimensionPoint, DimensionSet, DimensionStyle
+
+
+def _project_on_line(
+    point: Tuple[float, float],
+    line_p1: Tuple[float, float],
+    line_p2: Tuple[float, float],
+) -> float:
+    """Project *point* onto the line defined by *line_p1* → *line_p2*.
+    Returns the signed distance along the line from *line_p1*.
+    """
+    dx = line_p2[0] - line_p1[0]
+    dy = line_p2[1] - line_p1[1]
+    length_sq = dx * dx + dy * dy
+    if length_sq < 1e-18:
+        return 0.0
+    t = ((point[0] - line_p1[0]) * dx + (point[1] - line_p1[1]) * dy) / length_sq
+    return t * math.sqrt(length_sq)
+
+
+def _project_on_normal(
+    point: Tuple[float, float],
+    line_p1: Tuple[float, float],
+    line_p2: Tuple[float, float],
+) -> float:
+    """Signed distance of *point* from the line (positive = left side)."""
+    dx = line_p2[0] - line_p1[0]
+    dy = line_p2[1] - line_p1[1]
+    length = math.hypot(dx, dy)
+    if length < 1e-12:
+        return 0.0
+    # Normal = (-dy, dx) / length
+    nx = -dy / length
+    ny = dx / length
+    return (point[0] - line_p1[0]) * nx + (point[1] - line_p1[1]) * ny
+
+
+def perpendicular(
+    ref_p1: Tuple[float, float],
+    ref_p2: Tuple[float, float],
+    points: List[Tuple[float, float]],
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Dimension perpendicular to a reference line.
+
+    The reference line defines the measurement direction. Points are
+    projected onto the normal of this line. The dimension line is
+    placed at *offset* mm from the reference line.
+
+    Use case: dimensioning holes along a beam web.
+    """
+    if len(points) < 2:
+        return DimensionSet(kind="perpendicular", offset=offset,
+                            style=style or DimensionStyle())
+
+    dim_points = [
+        DimensionPoint(world=p, projected=_project_on_normal(p, ref_p1, ref_p2))
+        for p in points
+    ]
+
+    return DimensionSet(
+        ref_p1=ref_p1,
+        ref_p2=ref_p2,
+        points=dim_points,
+        offset=offset,
+        kind="perpendicular",
+        style=style or DimensionStyle(),
+    )
+
+
+def parallel(
+    ref_p1: Tuple[float, float],
+    ref_p2: Tuple[float, float],
+    points: List[Tuple[float, float]],
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Dimension parallel to a reference line.
+
+    The reference line defines the measurement direction. Points are
+    projected onto this line. The dimension line is placed at
+    *offset* mm from the reference line.
+
+    Use case: dimensioning hole spacing along a beam flange.
+    """
+    if len(points) < 2:
+        return DimensionSet(kind="parallel", offset=offset,
+                            style=style or DimensionStyle())
+
+    dim_points = [
+        DimensionPoint(world=p, projected=_project_on_line(p, ref_p1, ref_p2))
+        for p in points
+    ]
+
+    return DimensionSet(
+        ref_p1=ref_p1,
+        ref_p2=ref_p2,
+        points=dim_points,
+        offset=offset,
+        kind="parallel",
+        style=style or DimensionStyle(),
+    )
+
+
+def free(
+    ref_p1: Tuple[float, float],
+    ref_p2: Tuple[float, float],
+    points: List[Tuple[float, float]],
+    *,
+    offset: float = 30.0,
+    style: DimensionStyle | None = None,
+) -> DimensionSet:
+    """Free dimension parallel to a line between two points.
+
+    Same as parallel, but the dimension line is offset from the
+    reference line itself (not from a separate part geometry).
+    The dimension text is rotated to align with the line.
+
+    Use case: dimensioning angled connections, bracing, diagonals.
+    """
+    if len(points) < 2:
+        return DimensionSet(kind="free", offset=offset,
+                            style=style or DimensionStyle())
+
+    dim_points = [
+        DimensionPoint(world=p, projected=_project_on_line(p, ref_p1, ref_p2))
+        for p in points
+    ]
+
+    return DimensionSet(
+        ref_p1=ref_p1,
+        ref_p2=ref_p2,
+        points=dim_points,
+        offset=offset,
+        kind="free",
+        style=style or DimensionStyle(),
+    )
diff --git a/src/nccorrection/engine/cotation/angular.py b/src/nccorrection/engine/cotation/angular.py
new file mode 100644
index 0000000..79810bd
--- /dev/null
+++ b/src/nccorrection/engine/cotation/angular.py
@@ -0,0 +1,117 @@
+"""Cotation engine — angular and arc dimension builders.
+
+Angular: measures the angle at a vertex between two arm points.
+Arc: measures arc length or angle for a 3-point arc definition.
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+from .models import DimensionStyle
+
+
+@dataclass
+class AngularDimension:
+    """An angular dimension between two arms at a vertex."""
+    vertex: Tuple[float, float]
+    arm1_end: Tuple[float, float]
+    arm2_end: Tuple[float, float]
+    angle: float = 0.0           # degrees (0..360)
+    radius: float = 20.0         # display arc radius (mm)
+    offset: float = 0.0          # additional offset from vertex
+    style: DimensionStyle = field(default_factory=DimensionStyle)
+
+    def __post_init__(self):
+        self.angle = self._compute_angle()
+
+    def _compute_angle(self) -> float:
+        v1 = (self.arm1_end[0] - self.vertex[0],
+              self.arm1_end[1] - self.vertex[1])
+        v2 = (self.arm2_end[0] - self.vertex[0],
+              self.arm2_end[1] - self.vertex[1])
+        n1 = math.hypot(*v1)
+        n2 = math.hypot(*v2)
+        if n1 < 1e-9 or n2 < 1e-9:
+            return 0.0
+        dot = v1[0] * v2[0] + v1[1] * v2[1]
+        cosv = max(-1.0, min(1.0, dot / (n1 * n2)))
+        return math.degrees(math.acos(cosv))
+
+    def label(self) -> str:
+        return f"{self.angle:.1f}\u00b0"
+
+
+def angular(
+    vertex: Tuple[float, float],
+    arm1: Tuple[float, float],
+    arm2: Tuple[float, float],
+    *,
+    radius: float = 20.0,
+    style: DimensionStyle | None = None,
+) -> AngularDimension:
+    """Create an angular dimension at *vertex* between arms to *arm1* and *arm2*."""
+    return AngularDimension(
+        vertex=vertex, arm1_end=arm1, arm2_end=arm2,
+        radius=radius, style=style or DimensionStyle(),
+    )
+
+
+@dataclass
+class ArcDimension:
+    """An arc dimension defined by 3 points on the arc."""
+    p1: Tuple[float, float]      # arc start
+    p2: Tuple[float, float]      # arc mid (defines curvature)
+    p3: Tuple[float, float]      # arc end
+    center: Tuple[float, float] = (0.0, 0.0)
+    radius: float = 0.0
+    start_angle: float = 0.0     # degrees
+    end_angle: float = 0.0       # degrees
+    arc_length: float = 0.0      # mm
+    style: DimensionStyle = field(default_factory=DimensionStyle)
+
+    def __post_init__(self):
+        self._compute_geometry()
+
+    def _compute_geometry(self):
+        ax, ay = self.p1
+        bx, by = self.p2
+        cx, cy = self.p3
+        D = 2 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by))
+        if abs(D) < 1e-10:
+            return
+        ux = ((ax * ax + ay * ay) * (by - cy) +
+              (bx * bx + by * by) * (cy - ay) +
+              (cx * cx + cy * cy) * (ay - by)) / D
+        uy = ((ax * ax + ay * ay) * (cx - bx) +
+              (bx * bx + by * by) * (ax - cx) +
+              (cx * cx + cy * cy) * (bx - ax)) / D
+        self.center = (ux, uy)
+        self.radius = math.hypot(ax - ux, ay - uy)
+        self.start_angle = math.degrees(math.atan2(ay - uy, ax - ux))
+        self.end_angle = math.degrees(math.atan2(cy - uy, cx - ux))
+        # Arc length
+        a1 = math.radians(self.start_angle)
+        a2 = math.radians(self.end_angle)
+        da = a2 - a1
+        # Normalize to shortest arc
+        if da > math.pi:
+            da -= 2 * math.pi
+        elif da < -math.pi:
+            da += 2 * math.pi
+        self.arc_length = abs(self.radius * da)
+
+    def label(self) -> str:
+        return f"{self.arc_length:.1f}"
+
+
+def arc_dim(
+    p1: Tuple[float, float],
+    p2: Tuple[float, float],
+    p3: Tuple[float, float],
+    *,
+    style: DimensionStyle | None = None,
+) -> ArcDimension:
+    """Create an arc dimension from 3 points on the arc."""
+    return ArcDimension(p1=p1, p2=p2, p3=p3, style=style or DimensionStyle())
diff --git a/src/nccorrection/engine/cotation/auto_dim.py b/src/nccorrection/engine/cotation/auto_dim.py
