+# Plate: single contour, no face info at all (DXF import style).
+PLATE = {
+    'st': {'profile': 'PL10', 'type': 'B', 'thickness': 10.0},
+    'contours': [[(0, 0), (1000, 0), (1000, 400), (0, 400)]],
+    'contour_faces': ['v'],
+    'contour_meta': [
+        {'face': 'v', 'pts': [(0, 0), (1000, 0), (1000, 400), (0, 400)],
+         'bevels': {}, 'notches': [], 'x_suffix': None,
+         'first_x': 0.0, 'first_y': 0.0},
+    ],
+    'points': [],
+    'circles': [(500, 200, 40)],
+    'slots': [],
+    'holes': [
