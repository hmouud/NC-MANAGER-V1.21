+class TestBackfaceCulling3D(unittest.TestCase):
+    def test_camera_normal_culling(self):
+        # Matrix R: looking straight down Z (identity)
+        # Normal pointing towards camera (0, 0, 1): visible
+        # Normal pointing away (0, 0, -1): culled
+        R = ((1, 0, 0), (0, 1, 0), (0, 0, 1))
+
+        def mapply(R, v):
+            return (R[0][0]*v[0] + R[0][1]*v[1] + R[0][2]*v[2],
+                    R[1][0]*v[0] + R[1][1]*v[1] + R[1][2]*v[2],
+                    R[2][0]*v[0] + R[2][1]*v[1] + R[2][2]*v[2])
+
+        front_normal = (0.0, 0.0, 1.0)
+        back_normal = (0.0, 0.0, -1.0)
+
+        n_front = mapply(R, front_normal)
+        n_back = mapply(R, back_normal)
+
+        self.assertTrue(n_front[2] > 0.02)   # visible!
+        self.assertFalse(n_back[2] > 0.02)  # culled!
+
