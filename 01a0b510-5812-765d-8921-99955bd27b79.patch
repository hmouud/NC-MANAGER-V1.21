+++ b/src/nccorrection/engine/format_analyzer.py
@@ -0,0 +1,297 @@
+"""Universal CNC file format intelligence layer (Format Analyzer).
+
+Inspects ANY CNC file, definitively identifies its format and extracts a
+standardized industrial :class:`DetailReport`:
+
+* NC1/DSTV  -> full detail extraction reusing the existing tested
+               ``DstvParser`` (ST header + BO holes) and the application's
+               own import classifier (``core/classifier.classify_text`` — the
+               same classification the app uses when importing files, so the
+               PL17 strict-regex fix applies here automatically).
+* DXF       -> signature detection (ASCII header ``0 SECTION 2 HEADER`` or
+               the binary ``AutoCAD Binary DXF`` magic) + a lightweight
+               entity-count scanner (CIRCLE / LWPOLYLINE / POLYLINE / LINE /
+               ARC / SPLINE / ELLIPSE).  This is an intentional sniffer-only
+               scan — holes/slots/dimensions for DXF require the full geometry
+               parser (``engine.dxf.dxf_parser.read_dxf``) and are reported
+               as unknown here (warning flag set).
+* UNKNOWN   -> anything outside the industrial scope; never raises.
+
+Public API:
+    detect_format(filepath) -> 'NC1' | 'DXF' | 'UNKNOWN'
+    analyze_file(filepath)  -> DetailReport
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from dataclasses import dataclass, field
+from typing import Dict, List
+
+from nccorrection.core.classifier import classify_text
+from nccorrection.engine.parser.dstv_parser import DstvParser
+
+# ---------------------------------------------------------------------------
+# Format signatures (the Sniffer)
+# ---------------------------------------------------------------------------
+
+_BINARY_DXF_MAGIC = b'AutoCAD Binary DXF'
+
+# ASCII DXF header signature — CTO contract: "0 \\n SECTION \\n 2 \\n HEADER".
+# ``\\s`` spans the newlines, ^ anchors per line (re.M).
+_DXF_HEADER = re.compile(r'^\s*0\s*SECTION\s*2\s*HEADER\b', re.M | re.I)
+
+# Secondary DXF marker for headerless R12 exports: a 0 / ENTITIES table.
+_DXF_ENTITIES = re.compile(r'^\s*0\s*ENTITIES\b', re.M | re.I)
+
+# NC1/DSTV: a standalone ST block header PLUS at least one DSTV data block
+# code (AK/IK/BO/SI/PU/KO/EN) — ST alone is not enough (weak signature).
+_NC1_ST = re.compile(r'^\s*ST\s*$', re.M | re.I)
+_NC1_BLOCK = re.compile(r'^\s*(?:AK|IK|BO|SI|PU|KO|EN)\s*$', re.M | re.I)
+
+# DXF entity names this sniffer counts (group-code-0 values). Mirrors the
+# shape scope of engine/dxf/dxf_parser.py.
+_DXF_ENTITY_NAMES = ('CIRCLE', 'LWPOLYLINE', 'POLYLINE', 'LINE', 'ARC',
+                     'SPLINE', 'ELLIPSE')
+_DXF_ENTITY_PATTERNS = {
+    name: re.compile(r'^\s*%s\s*$' % name, re.M | re.I)
+    for name in _DXF_ENTITY_NAMES
+}
+
+_SNIFF_BYTES = 262144  # headers live at the top of every file
+
+
+def detect_format(filepath: str) -> str:
+    """Sniff the raw bytes/text of a file and return its format.
+
+    Returns ``'NC1'``, ``'DXF'`` or ``'UNKNOWN'``.  Content-based detection
+    first; file extension is only a fallback hint once content markers are
+    seen (never a proof by itself).
+    """
+    try:
+        with open(filepath, 'rb') as fh:
+            raw = fh.read(_SNIFF_BYTES)
+        head = raw.decode('latin-1', 'replace')
+    except (OSError, ValueError):
+        return 'UNKNOWN'
+
+    # DXF first — the header signature is unambiguous.
+    if raw.startswith(_BINARY_DXF_MAGIC):
+        return 'DXF'
+    if _DXF_HEADER.search(head) or _DXF_ENTITIES.search(head):
+        return 'DXF'
+
+    # NC1/DSTV — ST block + a data block code.
+    if _NC1_ST.search(head) and _NC1_BLOCK.search(head):
+        return 'NC1'
+
+    # Extension fallback (weak content): give the file the benefit of the
+    # doubt only when at least one content marker is present.
+    ext = os.path.splitext(filepath)[1].lower()
+    if ext == '.dxf' and _DXF_ENTITY_PATTERNS['LINE'].search(head):
+        return 'DXF'
+    if ext in ('.nc1', '.nc') and _NC1_ST.search(head):
+        return 'NC1'
+
+    return 'UNKNOWN'
+
+
+# ---------------------------------------------------------------------------
+# DetailReport
+# ---------------------------------------------------------------------------
+
+@dataclass
+class DetailReport:
+    """Standardized detail report for any CNC file (format-agnostic)."""
+
+    format: str = 'UNKNOWN'                    # 'NC1' | 'DXF' | 'UNKNOWN'
+    source: str = ''                           # filepath analyzed
+    profile_type: str = ''                     # IPE / PL / TUBC / … (family)
+    profile_name: str = ''                     # IPE360 / PL8 / …
+    material: str = ''                         # S235JR / '' when unknown
+    thickness: float = 0.0                     # mm (plate t, I-beam web t, …)
+    width: float = 0.0                         # mm
+    length: float = 0.0                        # mm
+    holes_count: int = 0                       # round holes (NC1 BO)
+    slots_count: int = 0                       # slotted holes (NC1 BO l-mark)
+    faces_used: List[str] = field(default_factory=list)   # ['v', 'u', …]
+    entity_counts: Dict[str, int] = field(default_factory=dict)  # DXF sniffer
+    total_entities: int = 0                    # DXF sniffer total
+    warning: str = ''                          # scope/parsing note, '' = clean
+    summary: str = ''                          # one-line human summary
+
+    def to_dict(self) -> dict:
+        return {
+            'format': self.format,
+            'source': self.source,
+            'profile_type': self.profile_type,
+            'profile_name': self.profile_name,
+            'material': self.material,
+            'thickness': self.thickness,
+            'width': self.width,
+            'length': self.length,
+            'holes_count': self.holes_count,
+            'slots_count': self.slots_count,
+            'faces_used': list(self.faces_used),
+            'entity_counts': dict(self.entity_counts),
+            'total_entities': self.total_entities,
+            'warning': self.warning,
+            'summary': self.summary,
+        }
+
+
+# ---------------------------------------------------------------------------
+# Detail extraction (the Detailing)
+# ---------------------------------------------------------------------------
+
+def _r3(value: float) -> float:
+    """Round a dimension to 3 decimals (0 stays 0)."""
+    try:
+        v = float(value)
+    except (TypeError, ValueError):
+        return 0.0
+    return round(v, 3) if v else 0.0
+
+
+def _nc1_dimensions(header):
+    """Map DSTV ST raw dims -> (length, width, thickness) per profile type.
+
+    Matches the conventions already enforced by ``core/face_planes.py`` and
+    ``core/viewer._estimate_thickness``:
+
+        B   [length, width, thickness]
+        I   [length, H, b, tf, tw]      -> thickness = tw
+        L   [length, a, b, t]           -> thickness = t
+        U   [length, H, b, tw, tf]      -> thickness = tw
+    """
+    dims = header.raw_dims or []
+    t = (header.profile_type or 'B').upper()
+    length = dims[0] if len(dims) > 0 else (header.length or 0.0)
+    width = thickness = 0.0
+    if t == 'B':
+        width = dims[1] if len(dims) > 1 else 0.0
+        thickness = dims[2] if len(dims) > 2 else 0.0
+    elif t == 'I':
+        width = dims[2] if len(dims) > 2 else 0.0
+        thickness = dims[4] if len(dims) > 4 else (dims[3] if len(dims) > 3 else 0.0)
+    elif t == 'L':
+        width = dims[2] if len(dims) > 2 else 0.0
+        thickness = dims[3] if len(dims) > 3 else 0.0
+    elif t == 'U':
+        width = dims[2] if len(dims) > 2 else 0.0
+        thickness = dims[3] if len(dims) > 3 else 0.0
+    else:
+        width = dims[1] if len(dims) > 1 else 0.0
+        thickness = dims[2] if len(dims) > 2 else 0.0
+    return _r3(length), _r3(width), _r3(thickness)
+
+
+def _analyze_nc1(filepath: str) -> DetailReport:
+    """Deep extraction for NC1/DSTV — reuses DstvParser + import classifier."""
+    part = DstvParser().parse_file(filepath)
+    header = part.header
+    length, width, thickness = _nc1_dimensions(header)
+
+    holes = [h for h in part.holes if not h.is_slot]
+    slots = [h for h in part.holes if h.is_slot]
+    faces = sorted(part.faces.keys())
+
+    # Classification through the app's own import path (post-PL17 strict fix:
+    # bare P can never hijack a plate).  Fall back to the raw ST values when
+    # the classifier cannot decide.
+    text = '\n'.join(part.raw_lines)
+    cls = classify_text(text, '')
+    if cls.get('category') != 'UNKNOWN':
+        profile_type = cls.get('family', '')
+        profile_name = cls.get('profile', '') or header.profile_name
+    else:
+        profile_type = header.profile_type or ''
+        profile_name = header.profile_name or ''
+
+    material = header.steel_grade or ''
+    summary = ('NC1 {name} {grade} {l}x{w}x{t}mm '
+               '{holes}H/{slots}S faces={faces}').format(
+        name=profile_name or '?', grade=material or '-',
+        l=int(length) if length == int(length) else length,
+        w=int(width) if width == int(width) else width,
+        t=int(thickness) if thickness == int(thickness) else thickness,
+        holes=len(holes), slots=len(slots),
+        faces=','.join(faces) if faces else '-')
+
+    return DetailReport(
+        format='NC1', source=filepath,
+        profile_type=profile_type, profile_name=profile_name,
+        material=material,
+        thickness=thickness, width=width, length=length,
+        holes_count=len(holes), slots_count=len(slots),
+        faces_used=faces, summary=summary,
+    )
+
+
+def _dxf_entity_counts(raw: bytes) -> Dict[str, int]:
+    """Count DXF entities by name (sniffer-level, no geometry parse)."""
+    if raw.startswith(_BINARY_DXF_MAGIC):
+        # Binary DXF stores string values prefixed with the 0x03 type byte;
+        # entity-type names are such strings.  Best-effort counting.
+        return {name: raw.count(b'\x03' + name.encode('ascii', 'replace'))
+                for name in _DXF_ENTITY_NAMES}
+    text = raw.decode('latin-1', 'replace')
+    return {name: len(pattern.findall(text))
+            for name, pattern in _DXF_ENTITY_PATTERNS.items()}
+
+
+def _analyze_dxf(filepath: str) -> DetailReport:
+    """DXF — profile conventions of the import flow (always PLATE, face v)."""
+    with open(filepath, 'rb') as fh:
+        raw = fh.read()
+    counts = _dxf_entity_counts(raw)
+    total = sum(counts.values())
+    warning = ('entity-level scan only: holes/slots/dimensions need the full '
+               'geometry parser (engine.dxf.dxf_parser.read_dxf)') if total else \
+        'no renderable shape entities found'
+    if total:
+        summary = ('DXF {total} entities (CIRCLE {c}, LWPOLYLINE {lw}, '
+                   'LINE {l})').format(
+            total=total, c=counts.get('CIRCLE', 0),
+            lw=counts.get('LWPOLYLINE', 0), l=counts.get('LINE', 0))
+    else:
+        summary = 'DXF: no entity data'
+    return DetailReport(
+        format='DXF', source=filepath,
+        profile_type='PL',
+        entity_counts=counts, total_entities=total,
+        faces_used=['v'],
+        warning=warning, summary=summary,
+    )
+
+
+def analyze_file(filepath: str) -> DetailReport:
+    """Unified entry point: sniff the format and extract all details.
+
+    Never raises for a readable file; any unexpected failure becomes an
+    UNKNOWN report with the error described in ``warning``.
+    """
+    try:
+        fmt = detect_format(filepath)
+        if fmt == 'NC1':
+            return _analyze_nc1(filepath)
+        if fmt == 'DXF':
+            return _analyze_dxf(filepath)
+        if not os.path.exists(filepath):
+            return DetailReport(
+                format='UNKNOWN', source=filepath,
+                warning='file not found: %s' % filepath,
+                summary='UNKNOWN: file not found',
+            )
+        return DetailReport(
+            format='UNKNOWN', source=filepath,
+            warning='format outside the industrial scope (NC1/DSTV, DXF)',
+            summary='UNKNOWN: not an NC1 or DXF file',
+        )
+    except Exception as exc:  # never raise — the caller always gets a report
+        return DetailReport(
+            format='UNKNOWN', source=filepath,
+            warning='analysis failed: %r' % (exc,),
+            summary='UNKNOWN: analysis error',
+        )
