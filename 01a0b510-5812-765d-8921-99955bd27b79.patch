+"""Structural Profile dialog — select IPE/HEA/HEB/UPN + machining params.
+
+Professional layout matching ProNest/Lantek dialog standards:
+  - Left: profile list with dropdown family filter + search
+  - Right: tabbed view (Section / Side) + params + angle cuts + holes
+
+Uses the CANONICAL catalog from engine.steel_engine.catalog.
+"""
+from __future__ import annotations
+
+import math
+from PySide6.QtWidgets import (
+    QDialog, QVBoxLayout, QHBoxLayout, QFormLayout, QWidget,
+    QLabel, QPushButton, QDoubleSpinBox, QComboBox,
+    QSpinBox, QLineEdit, QTableWidget, QTableWidgetItem,
+    QHeaderView, QAbstractItemView, QFrame, QStackedWidget,
+)
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtGui import QPainter, QPen, QBrush, QColor, QPainterPath
+
+from nccorrection.engine.steel_engine.catalog import (
+    get_profile, iter_profiles, family_label,
+)
+from nccorrection.engine.profile_catalog.geometry import generate_section
+from nccorrection.engine.profile_catalog.nc1_writer import (
+    generate_beam_nc1, Hole,
+)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Translations
+# ────────────────────────────────────────────────────────────────────
+
+_I18N = {
+    'en': {
+        'title': "Structural Profile Creator",
