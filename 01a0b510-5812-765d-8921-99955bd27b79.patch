+"""Tests for the Part Creator Engine."""
+import unittest
+import math
+
+from nccorrection.engine.part_creator.shapes import (
+    RingShape, CircleShape, FlatSidedCircleShape, RectangleShape,
+    RoundedRectangleShape, TombstoneShape, RightTriangleShape,
+    WedgeShape, ArcSectionShape, NotchedRectangleShape,
+    ClippedRectangleShape, GussetShape,
+    SHAPE_LIBRARY, get_shape, list_shapes,
+)
+from nccorrection.engine.part_creator.nc1_generator import generate_nc1
+from nccorrection.engine.part_creator.geometry_preview import shape_to_geometry
+
+
+class TestShapeLibrary(unittest.TestCase):
+    """Shape registry basics."""
+
+    def test_library_has_shapes(self):
+        self.assertGreaterEqual(len(SHAPE_LIBRARY), 10)
+
+    def test_get_shape(self):
+        self.assertIsNotNone(get_shape("Ring"))
+        self.assertIsNotNone(get_shape("Circle"))
+        self.assertIsNone(get_shape("Nonexistent"))
+
+    def test_list_shapes(self):
+        names = list_shapes()
+        self.assertIn("Ring", names)
+        self.assertIn("Tombstone Rectangle", names)
+
+    def test_all_shapes_generate(self):
+        for shape in SHAPE_LIBRARY:
+            result = shape.generate(shape.defaults())
+            self.assertGreaterEqual(len(result.outer), 3,
+                                    f"{shape.name} needs ≥3 contour pts")
+
+
+class TestRingShape(unittest.TestCase):
+    """Ring = circle with hole."""
+
+    def test_defaults(self):
+        r = RingShape()
+        self.assertEqual(r.defaults()["outer_radius"], 100.0)
+        self.assertEqual(r.defaults()["inner_radius"], 50.0)
+
+    def test_outer_contour_is_circle(self):
+        r = RingShape()
+        result = r.generate({"outer_radius": 100, "inner_radius": 50})
+        self.assertEqual(len(result.outer), 64)
+        # All points at distance ≈ 100 from centre
+        for x, y in result.outer:
+            dist = math.hypot(x, y)
+            self.assertAlmostEqual(dist, 100.0, delta=0.5)
+
+    def test_inner_contour(self):
+        r = RingShape()
+        result = r.generate({"outer_radius": 100, "inner_radius": 50})
+        self.assertEqual(len(result.inners), 1)
+        for x, y in result.inners[0]:
+            dist = math.hypot(x, y)
+            self.assertAlmostEqual(dist, 50.0, delta=0.5)
+
+    def test_inner_zero_radius_no_hole(self):
+        r = RingShape()
+        result = r.generate({"outer_radius": 100, "inner_radius": 0})
+        self.assertEqual(len(result.inners), 0)
+
+
+class TestCircleShape(unittest.TestCase):
+    def test_outer_is_circle(self):
+        c = CircleShape()
+        result = c.generate({"radius": 80})
+        self.assertEqual(len(result.outer), 64)
+        for x, y in result.outer:
+            self.assertAlmostEqual(math.hypot(x, y), 80.0, delta=0.5)
+
+
+class TestRectangleShape(unittest.TestCase):
+    def test_four_corners(self):
+        r = RectangleShape()
+        result = r.generate({"width": 200, "height": 100})
+        self.assertEqual(len(result.outer), 4)
+
+    def test_bounding_box(self):
+        r = RectangleShape()
+        result = r.generate({"width": 200, "height": 100})
+        xs = [pt[0] for pt in result.outer]
+        ys = [pt[1] for pt in result.outer]
+        self.assertAlmostEqual(max(xs) - min(xs), 200.0, delta=0.1)
+        self.assertAlmostEqual(max(ys) - min(ys), 100.0, delta=0.1)
+
+
+class TestTombstoneShape(unittest.TestCase):
+    def test_has_points(self):
+        t = TombstoneShape()
+        result = t.generate({"height": 254, "width": 127, "corner_radius": 31.75})
+        self.assertGreater(len(result.outer), 4)
+
+    def test_bounding_box(self):
+        t = TombstoneShape()
+        result = t.generate({"height": 200, "width": 100, "corner_radius": 0})
+        xs = [pt[0] for pt in result.outer]
+        ys = [pt[1] for pt in result.outer]
+        self.assertAlmostEqual(max(xs) - min(xs), 100.0, delta=1.0)
+        self.assertAlmostEqual(max(ys) - min(ys), 200.0, delta=1.0)
+
+
+class TestRightTriangleShape(unittest.TestCase):
+    def test_three_points(self):
+        t = RightTriangleShape()
+        result = t.generate({"height": 200, "base": 150})
+        self.assertEqual(len(result.outer), 3)
+
+
+class TestWedgeShape(unittest.TestCase):
+    def test_four_points(self):
+        w = WedgeShape()
+        result = w.generate({"height": 200, "base": 150, "angle": 45})
+        self.assertEqual(len(result.outer), 4)
+
+
+class TestNC1Generator(unittest.TestCase):
+    """NC1 text generation."""
+
+    def test_ring_nc1_has_blocks(self):
+        r = RingShape()
+        nc1 = generate_nc1(r, {"outer_radius": 100, "inner_radius": 50},
+                           order="TEST-001", thickness=12)
+        self.assertIn("ST", nc1)
+        self.assertIn("AK", nc1)
+        self.assertIn("IK", nc1)
+        self.assertIn("EN", nc1)
+        self.assertIn("PL12", nc1)
+        self.assertIn("TEST-001", nc1)
+
+    def test_rectangle_nc1_no_ik(self):
+        r = RectangleShape()
+        nc1 = generate_nc1(r, {"width": 200, "height": 100})
+        self.assertIn("AK", nc1)
+        self.assertNotIn("IK", nc1)
+        self.assertIn("EN", nc1)
+
+    def test_circle_nc1_contour_count(self):
+        c = CircleShape()
+        nc1 = generate_nc1(c, {"radius": 100})
+        ak_lines = [l for l in nc1.splitlines() if l.strip().startswith("v ")]
+        self.assertEqual(len(ak_lines), 64)
+
+
+class TestGeometryPreview(unittest.TestCase):
+    """Geometry dict for viewers."""
+
+    def test_ring_geometry_has_inner(self):
+        r = RingShape()
+        geo = shape_to_geometry(r, {"outer_radius": 100, "inner_radius": 50})
+        self.assertEqual(len(geo['contours']), 2)  # outer + inner
+        self.assertEqual(geo['contour_meta'][0]['kind'], 'outer')
+        self.assertEqual(geo['contour_meta'][1]['kind'], 'inner')
+
+    def test_rectangle_geometry(self):
+        r = RectangleShape()
+        geo = shape_to_geometry(r, {"width": 200, "height": 100})
+        self.assertEqual(len(geo['contours']), 1)
+        self.assertEqual(geo['contour_meta'][0]['kind'], 'outer')
+
+    def test_st_dims(self):
+        r = RectangleShape()
+        geo = shape_to_geometry(r, {"width": 200, "height": 100})
+        dims = geo['st']['dims']
+        self.assertAlmostEqual(dims[0], 200.0, delta=0.1)
+        self.assertAlmostEqual(dims[1], 100.0, delta=0.1)
+
+    def test_ring_geometry_viewer_contract(self):
+        """Verify the geometry dict has all keys expected by viewers."""
+        r = RingShape()
+        geo = shape_to_geometry(r, {"outer_radius": 100, "inner_radius": 50})
+        for key in ('contours', 'contour_faces', 'contour_meta',
+                     'points', 'circles', 'slots', 'holes', 'bends', 'st'):
+            self.assertIn(key, geo, f"Missing key: {key}")
+
+
+class TestValidation(unittest.TestCase):
+    """Parameter validation / clamping."""
+
+    def test_clamp_too_large(self):
+        r = RingShape()
+        result = r.generate({"outer_radius": 99999, "inner_radius": 0})
+        # Should be clamped to max_val=5000
+        self.assertIsNotNone(result)
+
+    def test_clamp_negative(self):
+        r = RectangleShape()
+        result = r.generate({"width": -10, "height": -20})
+        self.assertIsNotNone(result)
+
+
+if __name__ == '__main__':
+    unittest.main()
