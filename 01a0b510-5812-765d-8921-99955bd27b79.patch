+class TestMeasureRightClickFlow(unittest.TestCase):
+    """F3 -- right-click: first press cancels pending, next opens the menu."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_2d_first_right_click_cancels_pending(self):
+        w = NcViewer()
+        w.resize(800, 500)
+        w.set_geometry_object(MULTI_FACE)
+        w.set_mode('measure')
+        sx, sy = w._to_screen(300.0, 325.0)
+        w.mousePressEvent(_press(sx, sy))
+        self.assertIsNotNone(w._m1)
+        w.mousePressEvent(_press(sx, sy, Qt.RightButton))
+        self.assertIsNone(w._m1)  # pending point cancelled, no menu
+        # second right-click (nothing pending) must not crash and must not
+        # cancel anything (the app-level menu opens instead)
+        w.mousePressEvent(_press(sx, sy, Qt.RightButton))
+        self.assertIsNone(w._m1)
+
+    def test_blueprint_first_right_click_cancels_pending(self):
+        fb = DstvRenderer2D()
