+    def test_blueprint_palette_reaches_painter_pixels(self):
+        """Prove the engineering palette is baked into QPainter output.
+
+        Renders the unfolded blueprint to a real image and counts exact pixels
+        for the metallic face fills, the crisp cyan contour and the amber
+        machined features. Any fallback the renderer could silently fall into
+        would produce different colours and fail these thresholds.
+        """
+        from collections import Counter
+        from PySide6.QtGui import QImage
+        from nccorrection.engine.parser.dstv_parser import DstvParser
+        from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+
+        fb = DstvRenderer2D()
+        fb.resize(1200, 800)
+        fb.set_part(DstvParser().parse_text(SAMPLE_BEAM))
+        fb.set_design_settings(DesignSettings())
+        fb.set_unfold_mode(True)
+        fb._show_grid = False
+        img = fb.grab().toImage().convertToFormat(QImage.Format_RGB32)
+
+        cnt = Counter()
+        w, h = img.width(), img.height()
+        for y in range(3, h - 3, 3):
+            for x in range(3, w - 3, 3):
+                cnt[img.pixelColor(x, y).name()] += 1
+
+        self.assertGreater(cnt['#bdc3c7'], 200, 'web face fill absent')
+        self.assertGreater(cnt['#a7b1b8'], 200, 'flange face fill absent')
+        self.assertGreater(cnt['#2980b9'], 50, 'steel-blue contours absent')
+        self.assertGreater(cnt['#e67e22'], 4, 'amber machined features absent')
+
