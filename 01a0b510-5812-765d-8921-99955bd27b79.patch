+"""DXF export dialog tests (Workshop B v2: clickable face previews).
+
+Covers the face-filtering used by the dialog previews, the clickable
+preview-card toggle behaviour, and the dialog result contract (accepted /
+cancelled / excluded faces). Never touches the real projects/ database.
+"""
+import sys, os, types, unittest
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+
+from PySide6.QtWidgets import QApplication, QDialog, QRadioButton, QWidget
+from nccorrection.ui.app import NCManagerApp, _FacePreviewCard
+
+
+TWO_FACE = {
+    'contours': [[(0, 0), (100, 0), (100, 300), (0, 300), (0, 0)],
+                 [(50, 0), (100, 0), (100, 50), (50, 50), (50, 0)]],
+    'contour_faces': ['v', 'o'],
+    'contour_meta': [
+        {'face': 'v', 'pts': [(0, 0), (100, 0), (100, 300), (0, 300), (0, 0)],
+         'bevels': {}, 'notches': []},
+        {'face': 'o', 'pts': [(50, 0), (100, 0), (100, 50), (50, 50), (50, 0)],
+         'bevels': {}, 'notches': []}],
+    'holes': [{'face': 'v', 'kind': 'circle', 'x': 50, 'y': 150, 'd': 20},
+              {'face': 'o', 'kind': 'circle', 'x': 75, 'y': 25, 'd': 10}],
+}
+
+FACELESS = {  # plate / DXF import: no face info at all
+    'contours': [[(0, 0), (50, 0), (50, 20), (0, 20), (0, 0)]],
+    'holes': [{'kind': 'circle', 'x': 25, 'y': 10, 'd': 8}],
+}
+
+
+class TestFaceGeometry(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_filter_keeps_only_requested_face(self):
+        v = _FacePreviewCard._face_geometry(TWO_FACE, 'v')
+        o = _FacePreviewCard._face_geometry(TWO_FACE, 'o')
+        self.assertEqual(len(v['contours']), 1)
+        self.assertEqual(v['contour_faces'], ['v'])
+        self.assertEqual(len(v['holes']), 1)
+        self.assertEqual(v['holes'][0]['x'], 50)  # the v hole, not the o hole
+        self.assertEqual(len(o['contours']), 1)
+        self.assertEqual(o['contour_faces'], ['o'])
+        self.assertEqual(len(o['holes']), 1)
+        self.assertEqual(o['holes'][0]['x'], 75)
+
+    def test_faceless_geometry_belongs_to_v(self):
+        v = _FacePreviewCard._face_geometry(FACELESS, 'v')
+        self.assertIs(v, FACELESS)  # whole geometry kept, nothing dropped
+        u = _FacePreviewCard._face_geometry(FACELESS, 'u')
+        self.assertIsNone(u)
+
+    def test_missing_face_yields_empty_dict(self):
+        o = _FacePreviewCard._face_geometry(TWO_FACE, 'u')
+        self.assertEqual(o['contours'], [])
+        self.assertEqual(o['holes'], [])
+
+
+class TestFacePreviewCard(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def test_toggle_hides_viewer_and_restores(self):
+        card = _FacePreviewCard(TWO_FACE, 'v', 'v - Web')
+        card.show()
+        self.app.processEvents()
+        self.assertTrue(card._viewer.isVisible())
+        card.set_on(False)
+        self.app.processEvents()
+        self.assertFalse(card._viewer.isVisible())
+        self.assertTrue(card._off.isVisible())
+        card.set_on(True)
+        self.app.processEvents()
+        self.assertTrue(card._viewer.isVisible())
+        self.assertFalse(card._off.isVisible())
+
+    def test_renders_without_crash(self):
+        card = _FacePreviewCard(TWO_FACE, 'o', 'o - Flange')
+        card.show()
+        self.app.processEvents()
+        pm = card.grab()
+        self.assertGreater(pm.width(), 0)
+        self.assertGreater(pm.height(), 0)
+
+
+class TestDialog(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def _make_w(self):
+        """Lightweight stand-in for the app: real QWidget parent + the real
+        dialog method bound to it (avoids instantiating the whole app)."""
+        w = QWidget()
+        w.lang = 'en'
+        w.tr_ = types.MethodType(NCManagerApp.tr_, w)
+        w._ask_dxf_export_options = types.MethodType(
+            NCManagerApp._ask_dxf_export_options, w)
+        return w
+
+    def _open(self, w, faces, geometry, click_cb, code):
+        """Run _ask_dxf_export_options with a fake QDialog.exec that lets
+        the callback interact with the dialog before accepting/rejecting."""
+        real_exec = QDialog.exec
+
+        def fake_exec(self_):
+            click_cb(self_)
+            return code
+
+        QDialog.exec = fake_exec
+        try:
+            return w._ask_dxf_export_options(faces, geometry=geometry)
+        finally:
+            QDialog.exec = real_exec
+
+    def test_accepted_returns_all_faces_and_real_layout(self):
+        w = self._make_w()
+        out = self._open(w, ['v', 'o'], TWO_FACE,
+                         lambda dlg: None, QDialog.DialogCode.Accepted)
+        self.assertEqual(out, (['v', 'o'], 'real'))
+
+    def test_blueprint_layout_when_selected(self):
+        w = self._make_w()
+
+        def click(dlg):
+            for rb in dlg.findChildren(QRadioButton):
+                if rb.text().lower().startswith('blueprint'):
+                    rb.setChecked(True)
+
+        out = self._open(w, ['v', 'o'], TWO_FACE, click,
+                         QDialog.DialogCode.Accepted)
+        self.assertEqual(out, (['v', 'o'], 'blueprint'))
+
+    def test_cancelled_returns_none(self):
+        w = self._make_w()
+        out = self._open(w, ['v', 'o'], TWO_FACE, lambda dlg: None,
+                         QDialog.DialogCode.Rejected)
+        self.assertIsNone(out)
+
+    def test_excluded_face_is_removed_from_export(self):
+        w = self._make_w()
+
+        def click(dlg):
+            for card in dlg.findChildren(_FacePreviewCard):
+                if card._face == 'o':
+                    card.set_on(False)
+
+        out = self._open(w, ['v', 'o'], TWO_FACE, click,
+                         QDialog.DialogCode.Accepted)
+        self.assertEqual(out, (['v'], 'real'))
+
+
+if __name__ == '__main__':
+    unittest.main()
