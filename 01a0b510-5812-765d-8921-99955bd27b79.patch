+                    face_str = (h.get('face') or 'v').upper()
+                    slot_hud = f"Slot {d:g}\u00d7{length:g} mm   X: {x:.1f}   Y: {y:.1f}   \u2220{angle:g}\u00b0   [{face_str}]"
+                    p.setFont(QFont('Segoe UI', 9, QFont.Bold))
+                    fm = p.fontMetrics()
+                    tw = fm.horizontalAdvance(slot_hud) + 16
+                    th = fm.height() + 8
