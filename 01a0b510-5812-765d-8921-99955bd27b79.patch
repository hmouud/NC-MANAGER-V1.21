@@ -0,0 +1,214 @@
+"""Workshop C -- 2D faces layout (NCV121_PLAN_LIBREDWG_NC1DXF_2DFACES).
+
+The classic 2D viewer draws multi-face parts (IPE/HEA/L ...) with every face
+in its own horizontal band (like the blueprint) instead of overlapping them
+at raw coordinates. Colours/sizes/hole colours are untouched -- only the
+layout. Single-face parts (plates, DXF) keep the exact historical behaviour.
+"""
+
+import math
+import os
+import unittest
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+from PySide6.QtCore import QPointF, QEvent, Qt
+from PySide6.QtGui import QMouseEvent
+from PySide6.QtWidgets import QApplication
+
+from nccorrection.ui.qt_viewer import NcViewer
+
+# HEA-like part with THREE face contours (v web + o/u flanges) and holes on
+# v and o -- the overlap case the owner reported for IPE/HEA/L profiles.
+MULTI_FACE = {
+    'st': {'profile': 'HEA300', 'type': 'I', 'dims': [6000, 300, 150, 10.0, 6.0],
+           'thickness': 10.0},
+    'contours': [
+        [(0, 0), (6000, 0), (6000, 300), (0, 300)],        # v web
+        [(200, 0), (5800, 0), (5800, 150), (200, 150)],    # o flange
+        [(100, 0), (5900, 0), (5900, 150), (100, 150)],    # u flange
+    ],
+    'contour_faces': ['v', 'o', 'u'],
+    'contour_meta': [
+        {'face': 'v', 'pts': [(0, 0), (6000, 0), (6000, 300), (0, 300)]},
+        {'face': 'o', 'pts': [(200, 0), (5800, 0), (5800, 150), (200, 150)]},
+        {'face': 'u', 'pts': [(100, 0), (5900, 0), (5900, 150), (100, 150)]},
+    ],
+    'circles': [(300, 150, 18), (3000, 75, 18)],
+    'holes': [
+        {'x': 300, 'y': 150, 'd': 18, 'face': 'v', 'kind': 'hole'},
+        {'x': 3000, 'y': 75, 'd': 18, 'face': 'o', 'kind': 'hole'},
+    ],
+}
+
+# Single-face part -- must keep the exact historical behaviour.
+SINGLE_FACE = {
+    'st': {'profile': 'HEA300', 'type': 'I', 'dims': [6000, 300, 150, 10.0, 6.0],
+           'thickness': 10.0},
+    'contours': [[(0, 0), (6000, 0), (6000, 300), (0, 300)]],
+    'contour_faces': ['v'],
+    'contour_meta': [{'face': 'v', 'pts': [(0, 0), (6000, 0), (6000, 300),
+                                           (0, 300)]}],
+    'circles': [(300, 150, 18)],
+    'holes': [{'x': 300, 'y': 150, 'd': 18, 'face': 'v', 'kind': 'hole'}],
+}
+
+
+def _press(x, y):
+    return QMouseEvent(QEvent.MouseButtonPress, QPointF(x, y),
+                       Qt.LeftButton, Qt.LeftButton, Qt.NoModifier)
+
+
+def _dbl(x, y):
+    return QMouseEvent(QEvent.MouseButtonDblClick, QPointF(x, y),
+                       Qt.LeftButton, Qt.LeftButton, Qt.NoModifier)
+
+
+class TestFacesLayout(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        self.w = NcViewer()
+        self.w.resize(800, 500)
+
+    # ------------------------------------------------------------- bands
+    def test_multi_face_activates_layout(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        bands = self.w._ensure_face_bands()
+        # Blueprint vertical order (o top / v middle / u bottom) mapped to
+        # the stack bottom->top: u first (offset 0), then v, then o.
+        self.assertEqual([b[0] for b in bands], ['u', 'v', 'o'])
+        self.assertEqual(bands[0][1], 0.0)           # u offset = 0
+        self.assertEqual(bands[1][1], 150.0 + 25.0)  # v = u height + gap
+        self.assertEqual(bands[2][1], 175.0 + 300.0 + 25.0)  # o band
+
+    def test_single_face_no_layout(self):
+        self.w.set_geometry_object(SINGLE_FACE)
+        self.assertEqual(self.w._ensure_face_bands(), [])
+        # identity mapping preserved for single-face parts
+        self.assertEqual(self.w._explode_y('v', 50.0), 50.0)
+
+    def test_badge_names_match_blueprint(self):
+        """The 2D faces-layout badges use the SAME face names as the
+        blueprint renderer (FACE_DESCR)."""
+        from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+        self.w.set_geometry_object(MULTI_FACE)
+        self.w.grab()  # renders the blueprint-style badges without crashing
+        self.assertEqual(DstvRenderer2D.FACE_DESCR['v'], 'v \u00b7 Web')
+        self.assertEqual(DstvRenderer2D.FACE_DESCR['o'], 'o \u00b7 Top Flange')
+        self.assertEqual(DstvRenderer2D.FACE_DESCR['u'], 'u \u00b7 Bottom Flange')
+
+    def test_clear_geometry_resets_layout(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        self.assertTrue(self.w._ensure_face_bands())
+        self.w.clear_geometry()
+        self.assertEqual(self.w._ensure_face_bands(), [])
+
+    # ----------------------------------------------------------- drawing
+    def test_holes_screen_shifted_into_bands(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        self.w.grab()  # paintEvent side-effect: builds _holes_screen
+        found = {}
+        for sx, sy, _r, idx, _slen, _ang in self.w._holes_screen:
+            found[idx] = (sx, sy)
+        self.assertIn(0, found)
+        self.assertIn(1, found)
+        # row 0 = v hole (300,150) -> display (300, 175+150=325): the v band
+        # sits above the u band (u offset 0, height 150, gap 25 -> v 175)
+        rx, ry = self.w._to_scene(*found[0])
+        self.assertAlmostEqual(rx, 300.0, delta=1e-6)
+        self.assertAlmostEqual(ry, 325.0, delta=1e-6)
+        # row 1 = o hole (3000,75) -> display (3000, 500+75=575): o band
+        # sits above v (175 + 300 + 25 = 500)
+        rx, ry = self.w._to_scene(*found[1])
+        self.assertAlmostEqual(rx, 3000.0, delta=1e-6)
+        self.assertAlmostEqual(ry, 575.0, delta=1e-6)
+
+    def test_single_face_holes_unchanged(self):
+        self.w.set_geometry_object(SINGLE_FACE)
+        self.w.grab()
+        for sx, sy, _r, idx, _slen, _ang in self.w._holes_screen:
+            rx, ry = self.w._to_scene(sx, sy)
+            self.assertAlmostEqual(ry, 150.0, delta=1e-6)
+
+    def test_exploded_bounds_stack_height(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        self.w.grab()
+        b = self.w._bounds
+        self.assertIsNotNone(b)
+        # total height = 300 + 150 + 150 + 2 gaps of 25
+        self.assertAlmostEqual(b[3] - b[1], 650.0, delta=1e-6)
+
+    # --------------------------------------------------------- interaction
+    def test_snap_hits_display_positions(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        # v hole centre snaps at its DISPLAY position (v band offset 175:
+        # u 150 + gap 25) -> (300, 150+175=325)
+        sx, sy = self.w._to_screen(300.0, 325.0)
+        _, kind = self.w._snap_detail(QPointF(sx, sy))
+        self.assertEqual(kind, 'centre')
+        # o hole centre snaps at its DISPLAY position (o band offset 500:
+        # 175 + 300 + 25) -> (3000, 500+75=575)
+        sx, sy = self.w._to_screen(3000.0, 575.0)
+        _, kind = self.w._snap_detail(QPointF(sx, sy))
+        self.assertEqual(kind, 'centre')
+        # ... and the same hole does NOT snap at its raw overlapped position
+        # (3000,75) now lies inside the u band where no hole exists
+        sx, sy = self.w._to_screen(3000.0, 75.0)
+        _, kind = self.w._snap_detail(QPointF(sx, sy))
+        self.assertNotEqual(kind, 'centre')
+
+    def test_measure_distance_within_band(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        results = []
+        self.w.measure_result.connect(results.append)
+        self.w.set_mode('measure')
+        # two clicks on the v band (display y 325 = offset 175 + raw 150)
+        # -> true raw distance
+        self.w.mousePressEvent(_press(*self.w._to_screen(300.0, 325.0)))
+        self.w.mousePressEvent(_press(*self.w._to_screen(3300.0, 325.0)))
+        self.assertEqual(results[-1], '3000.0 mm')
+
+    def test_hole_double_click_in_o_band(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        emitted = []
+        self.w.hole_clicked.connect(emitted.append)
+        self.w.grab()
+        pos = None
+        for sx, sy, _r, idx, _slen, _ang in self.w._holes_screen:
+            if idx == 1:  # o-face hole
+                pos = QPointF(sx, sy)
+                break
+        self.assertIsNotNone(pos)
+        self.w.mouseDoubleClickEvent(_dbl(pos.x(), pos.y()))
+        self.assertEqual(emitted, [1])
+
+    def test_cotation_renders_per_band(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        self.w.set_cotation(True)
+        self.w.grab()  # must not crash; per-band chains render
+        self.assertTrue(self.w._bounds)
+
+    def test_unfold_mode_untouched(self):
+        self.w.set_geometry_object(MULTI_FACE)
+        self.w.set_unfold(True)
+        self.w.grab()  # the unfold band view keeps working
+        self.assertTrue(self.w._unfold)
+
+    def test_foreshorten_round_trip_still_exact(self):
+        from nccorrection.engine.math.foreshorten import build_foreshorten
+        self.w.set_geometry_object(MULTI_FACE)
+        self.w.resize(900, 640)
+        m = build_foreshorten(12000.0, [(0, 1000), (11500, 12000)])
+        self.w.set_foreshorten(m)
+        # v-face row: raw y=150 -> display y = 325 (v band offset 175)
+        for x in (0.0, 200.0, 6000.0):
+            sx, sy = self.w._to_screen(x, 325.0)
+            rx, ry = self.w._to_scene(sx, sy)
+            self.assertAlmostEqual(rx, x, delta=1e-6)
+            self.assertAlmostEqual(ry, 325.0, delta=1e-6)
+
+
+if __name__ == '__main__':
+    unittest.main()
