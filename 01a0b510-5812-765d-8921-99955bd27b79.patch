@@ -0,0 +1,99 @@
+"""Engine-level plane switching against the raw NC1 text.
+
+The UI edits holes through live override dictionaries; this module is the
+professional counterpart that operates on the file itself. ``switch_face_in_text``
+reads an NC1 with the same parser the viewers use ("from the inside"), locates
+one feature, re-expresses it on another DSTV face — its 3D position preserved by
+``core.face_planes`` — and rewrites the feature line, leaving every other line
+exactly as it was. ``copy_feature_to_face`` is the non-destructive variant that
+appends a copy of the feature on the target face instead of moving the original.
+
+Both return the new text (or raise :class:`ValueError` for an unknown feature or
+face), so callers can save it over the original or as a copy without touching
+the live override state.
+"""
+
+from nccorrection.core.face_planes import (
+    convert, convert_angle, faces_for,
+)
+from nccorrection.core.nc1_writer import apply_hole_edits
+from nccorrection.core.viewer import parse_geometry
+
+
+def _profile(nc1_text):
+    """Return ``(st_type, dims, thickness)`` read from the file itself."""
+    geo = parse_geometry(nc1_text)
+    st = geo.get('st') or {}
+    st_type = (st.get('type') or 'B').upper()
+    dims = st.get('dims') or []
+    try:
+        thickness = float(st.get('thickness') or 10.0)
+    except (TypeError, ValueError):
+        thickness = 10.0
+    return st_type, dims, thickness
+
+
+def _feature(nc1_text, orig):
+    """Return the feature dict at parsed index ``orig`` (holes, DSTV order)."""
+    geo = parse_geometry(nc1_text)
+    holes = geo.get('holes') or []
+    if not (0 <= orig < len(holes)):
+        raise ValueError(f'no hole at index {orig}')
+    return holes[orig]
+
+
+def switch_face_in_text(nc1_text, orig, to_face):
+    """Move the feature at ``orig`` onto ``to_face`` and return the new text.
+
+    The feature keeps its 3D position: ``(x, y)`` is projected from the source
+    face plane onto the target face (``core.face_planes.convert``) and a slot
+    angle is re-targeted with ``convert_angle``. All other lines are unchanged.
+    """
+    st_type, dims, thickness = _profile(nc1_text)
+    to = to_face.lower()
+    if to not in faces_for(st_type):
+        raise ValueError(f'face {to} not valid for {st_type}')
+    h = _feature(nc1_text, orig)
+    from_face = (h.get('face') or 'v').lower()
+    if from_face == to:
+        return nc1_text
+    nx, ny = convert(st_type, dims, 0.0, thickness, from_face, to,
+                     float(h.get('x', 0.0)), float(h.get('y', 0.0)))
+    ov = {'face': to, 'x': round(nx, 2), 'y': round(ny, 2)}
+    if h.get('kind') == 'slot' or h.get('length'):
+        ov['kind'] = 'slot'
+        ov['angle'] = round(convert_angle(st_type, dims, 0.0, thickness,
+                                          from_face, to,
+                                          float(h.get('angle') or 0.0)), 2)
+    return apply_hole_edits(nc1_text, {orig: ov})
+
+
+def copy_feature_to_face(nc1_text, orig, to_face):
+    """Return new text with a copy of ``orig`` placed on ``to_face``.
+
+    The original feature is left untouched; a second feature is appended in a
+    new BO block, expressed on the target face at the projectile of the
+    original's 3D position.
+    """
+    st_type, dims, thickness = _profile(nc1_text)
+    to = to_face.lower()
+    if to not in faces_for(st_type):
+        raise ValueError(f'face {to} not valid for {st_type}')
+    h = _feature(nc1_text, orig)
+    from_face = (h.get('face') or 'v').lower()
+    nx, ny = convert(st_type, dims, 0.0, thickness, from_face, to,
+                     float(h.get('x', 0.0)), float(h.get('y', 0.0)))
+    copy = {
+        'face': to,
+        'x': round(nx, 2),
+        'y': round(ny, 2),
+        'd': float(h.get('d', 14.0)),
+        'length': float(h.get('length') or 0.0),
+        'angle': float(h.get('angle') or 0.0),
+    }
+    if h.get('kind') == 'slot' or h.get('length'):
+        copy['kind'] = 'slot'
+        copy['angle'] = round(convert_angle(st_type, dims, 0.0, thickness,
+                                            from_face, to,
+                                            float(h.get('angle') or 0.0)), 2)
+    return apply_hole_edits(nc1_text, {}, add_holes=[copy])
