+    def test_identity(self):
+        ca = CutAngles()
+        self.assertTrue(ca.is_identity)
+
+    def test_non_identity(self):
+        ca = CutAngles(steg_front=38.621)
+        self.assertFalse(ca.is_identity)
+
+    def test_out_of_range(self):
+        with self.assertRaises(InvalidCutAngleError):
+            CutAngles(steg_front=200.0)
+
