+    def test_measure_commits_multiple(self):
+        self.w.set_mode('measure')
+        self.w.mousePressEvent(_press(400, 250))
+        self.assertIsNotNone(self.w._m1)
+        self.w.mousePressEvent(_press(420, 260))
+        self.assertEqual(len(self.w._measurements), 1)
