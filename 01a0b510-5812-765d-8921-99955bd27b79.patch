+        'dim': '#9aa0a6', 'grid_minor': '#1c1e22', 'grid_major': '#282b30',
+    },
+    'steel-blue': {
+        'name': 'Steel Blue',
+        'bg': '#0e1729', 'panel': '#16233a', 'panel2': '#1d2d47',
+        'card': '#223457', 'line': '#3b5077', 'txt': '#eef4ff',
+        'mut': '#94a8c9', 'blue': '#0284c7', 'green': '#10b981',
+        'red': '#ef4444', 'yel': '#f59e0b', 'vio': '#c084fc',
+        'accent': '#0284c7', 'barA': '#0e1729', 'barB': '#1e3a8a',
+        'contrast': 1.05, 'select': '#0d3c66',
+        'canvas': '#0b1121', 'contour': '#ffffff', 'hole': '#ef4444',
+        'slot': '#f59e0b', 'bend': '#fbbf24', 'notch': '#c4b5fd',
+        'dim': '#94a8c9', 'grid_minor': '#141e33', 'grid_major': '#1e2b48',
+    },
+    'high-contrast': {
+        'name': 'High Contrast',
+        'bg': '#000000', 'panel': '#0a0a0a', 'panel2': '#1a1a1a',
+        'card': '#1f2937', 'line': '#4b5563', 'txt': '#ffffff',
+        'mut': '#d1d5db', 'blue': '#facc15', 'green': '#34d399',
+        'red': '#fca5a5', 'yel': '#fde68a', 'vio': '#e879f9',
+        'accent': '#facc15', 'barA': '#000000', 'barB': '#1f2937',
+        'contrast': 1.22, 'select': '#2d3748',
+        'canvas': '#000000', 'contour': '#ffffff', 'hole': '#ef4444',
+        'slot': '#fde68a', 'bend': '#fde68a', 'notch': '#e879f9',
+        'dim': '#d1d5db', 'grid_minor': '#181818', 'grid_major': '#282828',
+    }
+}
+
+
+def apply_theme(theme_name, theme_custom=None):
+    base = dict(THEMES.get(theme_name, THEMES['industrial-dark']))
+    if theme_custom:
+        for key in ('accent', 'blue', 'green', 'red', 'yel', 'barA', 'barB', 'contour'):
+            if theme_custom.get(key):
+                base[key] = theme_custom[key]
+        if theme_custom.get('contrast'):
+            base['contrast'] = theme_custom['contrast']
+    return base
+
+
+def shade(hex_color, factor):
+    """Lighten (>1) or darken (<1) a #rrggbb color without random choices."""
+    try:
+        if hex_color.startswith('#'):
+            hex_color = hex_color[1:]
+        r = int(hex_color[0:2], 16)
+        g = int(hex_color[2:4], 16)
+        b = int(hex_color[4:6], 16)
+    except (ValueError, IndexError):
+        return '#%s' % hex_color
+    if factor >= 1:
+        f = factor - 1
+        r = int(r + (255 - r) * f)
+        g = int(g + (255 - g) * f)
+        b = int(b + (255 - b) * f)
+    else:
+        r = int(r * factor)
+        g = int(g * factor)
+        b = int(b * factor)
+    return '#%02x%02x%02x' % (r, g, b)
