@@ -0,0 +1,160 @@
+"""Isolated Measure toolbar.
+
+Owns the Measure toggle button, its right-click OSNAP context menu (one
+checkable entry per snap kind plus the corner-angle mode and the current snap
+tolerance) and a placeholder "Drafting Settings" animated button. The toolbar
+knows nothing about viewers or files: it talks to the design settings for the
+snap toggles and emits signals the app wires to the actual tools.
+
+Signals:
+    measure_toggled(bool)     user toggled the Measure button
+    corner_mode_changed(bool) corner-angle measure enabled/disabled
+    osnap_changed()           a snap kind was toggled (app should persist)
+    drafting_requested()      Drafting Settings placeholder clicked
+"""
+
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtGui import QAction
+from PySide6.QtWidgets import QWidget, QHBoxLayout, QMenu
+
+from nccorrection.design.theme import snap_label
+from nccorrection.ui.components.modern_button import AnimatedButton
+
+_BTN_H = 24
+
+
+class MeasureToolbar(QWidget):
+    """Measure + Drafting Settings toolbar with the OSNAP right-click menu."""
+
+    measure_toggled = Signal(bool)
+    corner_mode_changed = Signal(bool)
+    submode_changed = Signal(str)  # 'aligned', 'horizontal', 'vertical', 'angle', 'diameter'
+    osnap_changed = Signal()
+    drafting_requested = Signal()
+
+    def __init__(self, design_settings, tr_=None, theme=None, parent=None):
+        super().__init__(parent)
+        self._design = design_settings
+        self._tr = tr_ or (lambda key: key)
+        self._corner_mode = False
+        self._current_submode = 'aligned'
+
+        lay = QHBoxLayout(self)
+        lay.setContentsMargins(0, 0, 0, 0)
+        lay.setSpacing(4)
+
+        self.button = AnimatedButton(self._tr('tool_measure'), theme=theme,
+                                     parent=self, height=_BTN_H)
+        self.button.setCheckable(True)
+        self.button.setContextMenuPolicy(Qt.CustomContextMenu)
+        self.button.customContextMenuRequested.connect(self._menu_at)
+        self.button.toggled.connect(self.measure_toggled)
+        lay.addWidget(self.button)
+
+        self.draft_button = AnimatedButton(self._tr('drafting_settings'),
+                                           variant='ghost', theme=theme,
+                                           parent=self, height=_BTN_H)
+        self.draft_button.setToolTip(self._tr('drafting_settings_hint'))
+        self.draft_button.clicked.connect(self.drafting_requested)
+        lay.addWidget(self.draft_button)
+
+        self.refresh_tooltip()
+
+    # -------------------------------------------------------------- osnap
+    def snap_actions(self):
+        """Fresh checkable QAction per snap kind, bound to the design settings.
+
+        A new list is returned on every call because a QAction can only live in
+        one menu; the viewer context menu and the Measure right-click menu each
+        get their own set.
+        """
+        actions = []
+        osnap = self._design.osnap_enabled()
+        for kind in self._design.ordered_kinds():
+            act = QAction(snap_label(kind), self)
+            act.setCheckable(True)
+            act.setChecked(self._design.snap_enabled(kind))
+            act.setEnabled(osnap)
+            act.toggled.connect(
+                lambda on, k=kind: (self._design.set_snap(k, on),
+                                    self.osnap_changed.emit(),
+                                    self.refresh_tooltip()))
+            actions.append(act)
+        return actions
+
+    def _menu_at(self, pos):
+        menu = QMenu(self)
+        
+        # Dimension Modes
+        m_aligned = menu.addAction("Linear Aligned (Free)")
+        m_aligned.setCheckable(True)
+        m_aligned.setChecked(self._current_submode == 'aligned')
+        m_aligned.triggered.connect(lambda: self._set_submode('aligned'))
+
+        m_horiz = menu.addAction("Strict Horizontal (H)")
+        m_horiz.setCheckable(True)
+        m_horiz.setChecked(self._current_submode == 'horizontal')
+        m_horiz.triggered.connect(lambda: self._set_submode('horizontal'))
+
+        m_vert = menu.addAction("Strict Vertical (V)")
+        m_vert.setCheckable(True)
+        m_vert.setChecked(self._current_submode == 'vertical')
+        m_vert.triggered.connect(lambda: self._set_submode('vertical'))
+
+        m_diam = menu.addAction("Circle Diameter (\u00d8)")
+        m_diam.setCheckable(True)
+        m_diam.setChecked(self._current_submode == 'diameter')
+        m_diam.triggered.connect(lambda: self._set_submode('diameter'))
+
+        m_angle = menu.addAction("Angle Dimension (\u2220)")
+        m_angle.setCheckable(True)
+        m_angle.setChecked(self._current_submode == 'angle')
+        m_angle.triggered.connect(lambda: self._set_submode('angle'))
+
+        menu.addSeparator()
+        for act in self.snap_actions():
+            menu.addAction(act)
+        menu.addSeparator()
+        tol = menu.addAction(self._tr('measure_tol'))
+        tol.setEnabled(False)
+        menu.addAction(f'{self._design.snap_tol():.0f} px')
+        menu.exec(self.button.mapToGlobal(pos))
+
+    def _set_submode(self, mode_name):
+        self._current_submode = mode_name
+        self._corner_mode = (mode_name == 'angle')
+        self.submode_changed.emit(mode_name)
+        self.refresh_tooltip()
+
+    # ------------------------------------------------------------- corner
+    def _set_corner_mode(self, on):
+        self._corner_mode = bool(on)
+        self.refresh_tooltip()
+        self.corner_mode_changed.emit(self._corner_mode)
+
+    def set_corner_mode(self, on):
+        """Sync the corner-mode state without emitting (app-driven reset)."""
+        self._corner_mode = bool(on)
+        self.refresh_tooltip()
+
+    def corner_mode(self):
+        return self._corner_mode
+    # ------------------------------------------------------------- tooltip
+    def refresh_tooltip(self):
+        if not self._design.osnap_enabled():
+            tip = f'{self._tr("tool_measure")} \u2014 {self._tr("osnap_off")}\n'
+            tip += self._tr('snap_right_click')
+        else:
+            kinds = self._design.enabled_snaps()
+            if kinds:
+                names = ', '.join(snap_label(k) for k in
+                                  self._design.ordered_kinds() if k in kinds)
+                tip = (f'{self._tr("tool_measure")} \u2014 '
+                       f'{self._tr("snaps")}: {names}\n')
+                tip += self._tr('snap_right_click')
+            else:
+                tip = self._tr('snap_none')
+        tip += '\n' + (self._tr('corner_mode_on') if self._corner_mode
+                       else self._tr('corner_mode_off'))
+        tip += '\n' + self._tr('corner_mode_hint')
+        self.button.setToolTip(tip)
