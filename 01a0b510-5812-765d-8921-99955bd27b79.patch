+"""Steel Engine catalogue page — the Phase 1 data rendered in the 2026 UI.
+
+A read-only, filterable table of every profile in :mod:`catalog`, plus a
+stats strip (count, depth span, weight span). This is the destination of the
+``[Steel Engine]`` sidebar button and will feed the Nesting engine next.
+"""
+
+from __future__ import annotations
+
+from PySide6.QtCore import Qt
+from PySide6.QtWidgets import (QFrame, QHBoxLayout, QHeaderView, QLabel,
+                               QLineEdit, QPushButton, QTableWidget,
+                               QTableWidgetItem, QVBoxLayout)
+
+from nccorrection.engine.steel_engine.catalog import (
+    iter_profiles, catalogue_stats, family_label)
+from nccorrection.ui.components.scaling import font_px_str, sp
+from nccorrection.ui._colors import C
+
+_COLUMNS = ['Profile', 'Family', 'A (mm²)', 'h (mm)', 'b (mm)', 't (mm)',
+            'kg/m']
+
+# Family filter buttons: key None means "show all".
+_FILTERS = [
+    (None, 'All'),
+    ('B', 'B \u2014 Plate'),
+    ('I', 'I \u2014 Beam'),
+    ('L', 'L \u2014 Angle'),
+    ('O', 'O \u2014 Round'),
+    ('T', 'T \u2014 Tube'),
+    ('U', 'U \u2014 Channel'),
+]
+
+
+class SteelEngineView(QFrame):
+    """Catalogue browser for the Steel Engine (native, read-only table)."""
+
+    def __init__(self, theme=None, tr=lambda s: s, parent=None):
+        super().__init__(parent)
+        self._theme = dict(theme) if theme else {}
+        self._tr = tr
+        self._all_rows = []
+        self.setAttribute(Qt.WA_StyledBackground, True)
+
+        lay = QVBoxLayout(self)
+        lay.setContentsMargins(sp(16), sp(12), sp(16), sp(12))
+        lay.setSpacing(sp(8))
+
+        title = QLabel(self._tr('steel_engine'), self)
+        title.setStyleSheet(self._css('txt', 'bold', 14))
+        lay.addWidget(title)
+        sub = QLabel(self._tr('steel_engine_sub'), self)
+        sub.setStyleSheet(self._css('mut', 'normal', 9))
+        lay.addWidget(sub)
+
+        # stats strip ----------------------------------------------------
+        stats = catalogue_stats()
+        stats_row = QHBoxLayout()
+        stats_row.setSpacing(sp(8))
+        pieces = [
+            (self._tr('steel_count'), str(stats.get('count', 0))),
+            (self._tr('steel_depth_span'),
+             f"{stats['depth_range_mm'][0]:.0f}–{stats['depth_range_mm'][1]:.0f} mm"
+             if stats.get('depth_range_mm') else '—'),
+            (self._tr('steel_weight_span'),
+             f"{stats['weight_range_kg_per_m'][0]:.1f}–{stats['weight_range_kg_per_m'][1]:.1f}"
+             if stats.get('weight_range_kg_per_m') else '—'),
+        ]
+        for label, value in pieces:
+            chip = QLabel(f'{label}:  {value}', self)
+            chip.setStyleSheet(
+                f'background:{C.card}; '
+                f'color:{C.txt}; '
+                f'border:1px solid {C.line}; '
+                f'border-radius:{sp(6)}px; padding:{sp(3)}px {sp(8)}px; '
+                f'{font_px_str(9)};')
+            stats_row.addWidget(chip)
+        stats_row.addStretch(1)
+        lay.addLayout(stats_row)
+
+        # search ----------------------------------------------------------
+        search_row = QHBoxLayout()
+        self.search = QLineEdit(self)
+        self.search.setPlaceholderText(self._tr('steel_search'))
+        self.search.setClearButtonEnabled(True)
+        self.search.textChanged.connect(self._apply_filter)
+        self.search.setStyleSheet(
+            f'background:{C.panel2}; '
+            f'color:{C.txt}; '
+            f'border:1px solid {C.line}; '
+            f'border-radius:{sp(6)}px; padding:{sp(4)}px {sp(8)}px; '
+            f'{font_px_str(10)};')
+        search_row.addWidget(self.search)
+        search_row.addStretch(1)
+        lay.addLayout(search_row)
+
+        # family filter ------------------------------------------------------
+        self._filter_kind = None
+        self._filter_buttons = {}
+        filter_row = QHBoxLayout()
+        filter_row.setSpacing(sp(6))
+        for key, label in _FILTERS:
+            btn = QPushButton(label, self)
+            btn.setCheckable(True)
+            btn.setProperty('kind', key if key else '')
+            btn.setStyleSheet(
+                f'background:{C.panel2}; '
+                f'color:{C.txt}; '
+                f'border:1px solid {C.line}; '
+                f'border-radius:{sp(6)}px; padding:{sp(3)}px {sp(8)}px; '
+                f'{font_px_str(9)};')
+            btn.clicked.connect(lambda _=False, k=key: self._set_filter(k))
+            self._filter_buttons[key] = btn
+            filter_row.addWidget(btn)
+            if key is None:
+                btn.setChecked(True)
+        filter_row.addStretch(1)
+        lay.addLayout(filter_row)
+
+        # table ------------------------------------------------------------
+        self.table = QTableWidget(self)
+        self.table.setColumnCount(len(_COLUMNS))
+        self.table.setHorizontalHeaderLabels(_COLUMNS)
+        self.table.verticalHeader().setVisible(False)
+        self.table.setShowGrid(False)
+        self.table.setAlternatingRowColors(True)
+        self.table.setEditTriggers(QTableWidget.NoEditTriggers)
+        self.table.setSelectionBehavior(QTableWidget.SelectRows)
+        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
+        lay.addWidget(self.table, 1)
+
+        self._load_rows()
+
+    # ------------------------------------------------------------------
+    def _css(self, key, weight, pt):
+        return (f'color:{self._theme.get(key, C.txt)}; background:transparent; '
+                f'font-weight:{weight}; font-size:{pt}pt;')
+
+    def set_theme(self, theme):
+        self._theme = dict(theme) if theme else {}
+        self.update()
+
+    def _set_filter(self, kind):
+        """Select a family filter button (only one active at a time)."""
+        self._filter_kind = kind
+        for key, btn in self._filter_buttons.items():
+            btn.setChecked(key == kind)
+        self._apply_filter(self.search.text())
+
+    def _load_rows(self):
+        self._all_rows = []
+        for p in iter_profiles():
+            row = {
+                'name': p.name,
+                'kind': p.kind,
+                'vals': (p.name, family_label(p.kind), f'{p.area:.0f}',
+                         f'{p.depth:.0f}', f'{p.width:.0f}',
+                         f'{p.flange_thick:.1f}', f'{p.weight_per_m:.2f}'),
+            }
+            self._all_rows.append(row)
+        self._apply_filter(self.search.text())
+
+    def _apply_filter(self, needle: str):
+        needle = (needle or '').strip().upper()
+        rows = self._all_rows
+        if self._filter_kind is not None:
+            rows = [r for r in rows if r['kind'] == self._filter_kind]
+        if needle:
+            rows = [r for r in rows if needle in r['name'].upper()]
+        self.table.setRowCount(len(rows))
+        for ri, row in enumerate(rows):
+            for ci, value in enumerate(row['vals']):
+                item = QTableWidgetItem(value)
+                if ci >= 2:  # numeric columns right-aligned
+                    item.setTextAlignment(Qt.AlignRight | Qt.AlignVCenter)
+                self.table.setItem(ri, ci, item)
