+"""Geometry preview dict from parametric shapes.
+
+Produces a dict matching the contract of ``core.viewer.parse_geometry()``
+so the existing 2D / 3D / blueprint viewers render it with ZERO engine
+changes.
+"""
+from __future__ import annotations
+
+import math
+from typing import List
+
+from .shapes import PlateShape, ShapeResult
+
+
+def shape_to_geometry(
+    shape: PlateShape,
+    params: dict,
+    thickness: float = 10.0,
+    scale: float = 1.0,
+    count_x: int = 1,
+    count_y: int = 1,
+    spacing: float = 20.0,
+) -> dict:
+    """Convert a shape result into a geometry dict for the viewers.
+
+    Returns a dict with keys matching ``core.viewer.parse_geometry()``:
+    contours, contour_faces, contour_meta, points, circles, slots,
+    holes, bends, st.
+    """
+    p = shape.validate(params)
+    result = shape.generate_transformed(
+        p, scale=scale, count_x=count_x, count_y=count_y, spacing_x=spacing, spacing_y=spacing
+    )
+
+    contours = []
+    contour_faces = []
+    contour_meta = []
+
+    # Outer contour → AK on face 'v'
+    if result.outer and len(result.outer) >= 3:
+        contours.append(result.outer)
+        contour_faces.append('v')
+        contour_meta.append({
+            'face': 'v',
+            'pts': list(result.outer),
+            'bevels': {},
+            'notches': [],
+            'x_suffix': None,
+            'first_x': result.outer[0][0],
+            'first_y': result.outer[0][1],
+            'arc_values': [0.0] * len(result.outer),
+            'arc_convention': 'bulge',
+            'kind': 'outer',
+        })
+
+    # Inner contours → IK on face 'v'
+    for inner in result.inners:
+        if len(inner) < 3:
+            continue
+        contours.append(inner)
+        contour_faces.append('v')
+        contour_meta.append({
+            'face': 'v',
+            'pts': list(inner),
+            'bevels': {},
+            'notches': [],
+            'x_suffix': None,
+            'first_x': inner[0][0],
+            'first_y': inner[0][1],
+            'arc_values': [0.0] * len(inner),
+            'arc_convention': 'bulge',
+            'kind': 'inner',
+        })
+
+    # Holes
+    circles = []
+    holes = []
+    for hole in result.holes:
+        x, y, d = hole.get('x', 0), hole.get('y', 0), hole.get('d', 0)
+        if d > 0:
+            circles.append((x, y, d))
+            holes.append({
+                'face': 'v', 'kind': 'hole',
+                'x': x, 'y': y, 'd': d,
+                'length': 0.0, 'angle': 0.0,
+            })
+
+    # Bounding box → st dims
+    if result.outer:
+        xs = [pt[0] for pt in result.outer]
+        ys = [pt[1] for pt in result.outer]
+        width = max(xs) - min(xs)
+        height = max(ys) - min(ys)
+    else:
+        width = height = 0.0
+
+    st = {
+        'type': 'B',
+        'profile': f'PL{thickness:.0f}',
+        'thickness': thickness,
+        'dims': [width, height],
+        'numbers': [],
+    }
+
+    return {
+        'contours': contours,
+        'contour_faces': contour_faces,
+        'contour_meta': contour_meta,
+        'points': [],
+        'circles': circles,
+        'slots': [],
+        'holes': holes,
+        'bends': [],
+        'st': st,
+    }
