+class TestRendererSmoke(unittest.TestCase):
+    """Smoke test: create a QPainter on a QImage and draw all dimension types."""
+
+    def test_draw_all(self):
+        from PySide6.QtGui import QImage, QPainter, QColor
+        img = QImage(400, 400, QImage.Format_ARGB32)
+        img.fill(QColor(11, 21, 38))
+        p = QPainter(img)
+
+        def to_screen(x, y):
+            return (x + 200, 200 - y)
+
+        renderer = DimensionRenderer(p, DEFAULT_STYLE, to_screen)
+
+        # Radius
+        rd = RadiusDimension(
+            center=Point2D(0, 0),
+            point_on_circle=Point2D(100, 0),
+            radius=100.0,
+        )
+        renderer.draw_radius(rd)
+
+        # Diameter
+        dd = DiameterDimension(
+            center=Point2D(-100, 0),
+            point_on_circle=Point2D(-60, 0),
+            diameter=80.0,
+        )
+        renderer.draw_diameter(dd)
+
+        # Angular
+        ad = AngularDimension(
+            vertex=Point2D(0, -50),
+            line1_end=Point2D(50, -50),
+            line2_end=Point2D(25, -50 + 43.3),
+        )
+        renderer.draw_angular(ad)
+
+        # Center mark
+        cm = CenterMark(center=Point2D(0, 0), mark_size=5.0)
+        renderer.draw_center_mark(cm)
+
+        # Bolt circle
+        bc = BoltCirclePattern(
+            center=Point2D(0, 0),
+            bolt_radius=200.0,
+            hole_positions=[
+                Point2D(200, 0),
+                Point2D(-100, 173.2),
+                Point2D(-100, -173.2),
+            ],
+            hole_diameter=26.0,
+        )
+        renderer.draw_bolt_circle(bc)
+
+        # Leader
+        ld = LeaderDimension(
+            start=Point2D(150, 150),
+            tail=Point2D(200, 180),
+            text='Note',
+        )
+        renderer.draw_leader(ld)
+
+        # Linear
+        lnd = LinearDimension(
+            point1=Point2D(-80, -80),
+            point2=Point2D(80, -80),
+            offset=20.0,
+        )
+        renderer.draw_linear(lnd)
+
+        # Group draw
+        group = DimensionGroup()
+        group.radii.append(rd)
+        group.diameters.append(dd)
+        group.angulars.append(ad)
+        group.center_marks.append(cm)
+        group.bolt_circles.append(bc)
+        group.leaders.append(ld)
+        group.linears.append(lnd)
+        renderer.draw_group(group)
+
+        p.end()
+        # If we got here without crash, it passes
+        self.assertTrue(True)
+
+
