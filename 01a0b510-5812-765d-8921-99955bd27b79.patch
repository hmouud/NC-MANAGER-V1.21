@@ -0,0 +1,58 @@
+"""web_interpreter.py — Web cuts (v/h faces).
+
+🚨 GUARDIAN LAW: Single responsibility — غير الويب.
+الفلانج عندو ملفو الخاص.
+"""
+from __future__ import annotations
+from typing import List
+
+from ..core.enums import Face, CutSide
+from ..core.constants import TOLERANCE_DEG
+from ..geometry.math_utils import tan_deg
+from ..geometry.dimensions import ProfileDimensions
+from ..models.cut_angles import CutAngles
+from ..models.intersection import IntersectionPoint
+
+
+class WebInterpreter:
+    """كايحسب نقاط التقاطع على الويب (v/h faces).
+
+    المعادلة الأساسية: web_offset = H × tan(angle)
+    موثقة من DSTV الرسمية: الزوايا (Phi) كايتحسبو من العمودي.
+    """
+
+    def __init__(self, dims: ProfileDimensions, angles: CutAngles):
+        self.d = dims
+        self.angles = angles
+
+    def offset(self, angle_deg: float) -> float:
+        """cut_offset = H * tan(angle)."""
+        if abs(angle_deg) < TOLERANCE_DEG:
+            return 0.0
+        return self.d.H * tan_deg(angle_deg)
+
+    def compute(self, face: Face) -> List[IntersectionPoint]:
+        """نقاط التقاطع على الويب، مرتبة من فوق لتحت."""
+        if not self.angles.has_web_cut:
+            return []
+
+        points: List[IntersectionPoint] = []
+        y_mid = self.d.H / 2.0
+
+        if abs(self.angles.steg_front) > TOLERANCE_DEG:
+            points.append(IntersectionPoint(
+                x=self.offset(self.angles.steg_front),
+                y=y_mid, face=face, side=CutSide.FRONT,
+                source_angle=self.angles.steg_front,
+                description="steg_front cut at H/2",
+            ))
+
+        if abs(self.angles.steg_rear) > TOLERANCE_DEG:
+            points.append(IntersectionPoint(
+                x=-self.offset(self.angles.steg_rear),
+                y=y_mid, face=face, side=CutSide.REAR,
+                source_angle=self.angles.steg_rear,
+                description="steg_rear cut at H/2",
+            ))
+
+        return sorted(points, key=lambda p: -p.y)
