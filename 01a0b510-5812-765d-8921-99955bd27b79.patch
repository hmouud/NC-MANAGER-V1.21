+            prompt += '  ' + self.tr_('export_dxf_batch_note').format(n=n_files)
+        v.addWidget(QLabel(prompt, dlg))
+        try:
+            from nccorrection.engine.render_2d.renderer_2d import (
+                DstvRenderer2D)
+            names = DstvRenderer2D.FACE_DESCR
+        except Exception as e:
+            self._report_error('dxf-export-face-descr', e)
+            names = {}
+        cards = []
+        row = QHBoxLayout()
+        row.setSpacing(8)
+        # Late import to avoid circular dependency (export → app → export)
+        from nccorrection.ui.app import _FacePreviewCard
+        for code in faces:
+            card = _FacePreviewCard(geometry, code,
+                                    names.get(code, code.upper()), dlg)
+            row.addWidget(card)
+            cards.append((code, card))
+        v.addLayout(row)
+        v.addSpacing(4)
+        v.addWidget(QLabel(self.tr_('export_dxf_layout'), dlg))
+        lay_group = QButtonGroup(dlg)
+        rb_real = QRadioButton(self.tr_('export_dxf_layout_real'), dlg)
+        rb_real.setChecked(True)
+        rb_bp = QRadioButton(self.tr_('export_dxf_layout_blueprint'), dlg)
+        lay_group.addButton(rb_real)
+        lay_group.addButton(rb_bp)
+        v.addWidget(rb_real)
+        v.addWidget(rb_bp)
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        ok = QPushButton('OK', dlg)
+        ok.setObjectName('green')
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        ok.clicked.connect(dlg.accept)
+        btns.addWidget(ok)
+        btns.addWidget(cancel)
+        v.addLayout(btns)
+        dlg.resize(24 + len(faces) * 188, 350)
+        if dlg.exec() != QDialog.Accepted:
+            return None
+        chosen = [code for code, card in cards if card.is_on()]
+        if not chosen:
+            chosen = [code for code, _card in cards]
+        layout = 'blueprint' if rb_bp.isChecked() else 'real'
+        return (chosen, layout)
+
+    def _do_export(self, ext, path):
+        f = self._current_file
+        try:
+            if ext == '.dxf':
+                from nccorrection.core.dxf_writer import export_dxf
+                faces = self._distinct_faces(self._current_geometry)
+                if len(faces) > 1:
+                    opts = self._ask_dxf_export_options(
+                        faces, geometry=self._current_geometry)
+                    if opts is None:
+                        return
+                    export_dxf(self._current_geometry, path,
+                               faces=opts[0], layout=opts[1])
+                else:
+                    export_dxf(self._current_geometry, path)
+                self.status_label.setText(f'{self.tr_("export_ok")} {path}')
+                return
+            if ext == '.pdf':
+                from nccorrection.ui.pdf_export import export_widget_pdf
+                n = export_widget_pdf(self._current_view_widget(), path)
+                if n:
+                    self.status_label.setText(f'{self.tr_("export_ok")} {path}')
+                else:
+                    self._toast(self.tr_('export_fail'), kind='warn', title=self.tr_('export'))
+                return
+            if ext in ('.nc', '.nc1', '.cn'):
+                from nccorrection.core.nc1_writer import apply_hole_edits
+                edits = dict(self.hole_overrides.get(f['hash'], {}))
+                for i in self.hole_deleted.get(f['hash'], set()):
+                    edits[i] = None
+                new_text = apply_hole_edits(
+                    f['text'], edits,
+                    add_holes=self.added_holes.get(f['hash'], []))
+                with open(path, 'w', encoding='latin-1', newline='') as fh:
+                    fh.write(new_text)
+                self.status_label.setText(f'{self.tr_("export_ok")} {path}')
+                return
+            from nccorrection.core.part3d import export_obj, export_stl
+            if ext == '.stl':
+                n = export_stl(self._current_geometry, path)
+            else:
+                if ext != '.obj':
+                    path += '.obj'
+                n = export_obj(self._current_geometry, path)
+            self.status_label.setText(
+                f"{self.tr_('export_ok')} {path}  ({n} {self.tr_('export_faces')})")
+        except Exception as exc:
+            self._toast(f"{self.tr_('export_fail')}\n{exc}", kind='error',
+                        title=self.tr_('export'))
+
+    # --------------------------------------------------------- save edits dialog
+    def _ask_save_edits(self, f):
+        """Ask original vs copy, rename and output folder, then write the NC1
