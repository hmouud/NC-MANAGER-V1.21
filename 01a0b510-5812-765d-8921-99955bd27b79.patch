@@ -0,0 +1,998 @@
+"""UI Builder mixin for NCManagerApp.
+
+Extracted from app.py to keep the main application file focused.  Contains
+the full UI construction pipeline: bootloader steps (services, viewers),
+the main ``_build`` tree (header / toolbar / central / statusbar), keyboard
+shortcuts, geometry persistence, and small UI helpers.
+
+Every method references ``self.`` attributes that live on
+:class:`NCManagerApp` -- this mixin is **not** usable standalone.
+"""
+
+from __future__ import annotations
+
+import os
+import ctypes
+
+from PySide6.QtWidgets import (
+    QApplication,
+    QAbstractItemView,
+    QComboBox,
+    QFrame,
+    QGridLayout,
+    QHBoxLayout,
+    QHeaderView,
+    QLabel,
+    QLineEdit,
+    QMenu,
+    QPushButton,
+    QSizePolicy,
+    QSlider,
+    QSplitter,
+    QStackedWidget,
+    QTableWidget,
+    QTextEdit,
+    QToolButton,
+    QVBoxLayout,
+    QWidget,
+)
+from PySide6.QtCore import Qt, QSize, QTimer
+from PySide6.QtGui import QIcon, QPixmap, QKeySequence, QShortcut
+
+from nccorrection.services.settings_service import SettingsService
+from nccorrection.services.resource_service import ResourceService
+from nccorrection.services.audit_service import AuditService
+from nccorrection.services.project_service import ProjectService
+from nccorrection.ui.styles import apply_theme, shade
+from nccorrection.ui.components.history_button import HistoryButton
+from nccorrection.ui.components.sidebar import AppSidebar
+from nccorrection.ui.components.scaling import sp
+from nccorrection.ui.qt_viewer import NcViewer
+from nccorrection.ui.qt_viewer_3d import NcViewer3D
+from nccorrection.ui.views.steel_engine_view import SteelEngineView
+from nccorrection.ui.toolbars.measure_toolbar import MeasureToolbar
+from nccorrection.ui.toolbars.dimension_toolbar import DimensionToolbar
+from nccorrection.ui.translations import t as tr
+from nccorrection.ui.dialog_manager import DialogManager
+from nccorrection.design.settings import DesignSettings
+from nccorrection.design.theme import blueprint_palette, measure_palette
+from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+from nccorrection.ui._colors import C
+
+
+# Version constant used by the header bar.
+_VERSION = '1.v21'
+
+
+# --------------------------------------------------------------------------- #
+#  Module-level helper (was top-level in app.py)
+# --------------------------------------------------------------------------- #
+
+def _icon(name, path):
+    from nccorrection.ui.components.svg_icon import resolve_icon
+    p = resolve_icon(name) or resolve_icon(os.path.basename(path))
+    if not p or not os.path.isfile(p):
+        return QIcon()
+    if p.lower().endswith('.svg'):
+        return QIcon(p)
+    pm = QPixmap(p)
+    if pm.isNull():
+        return QIcon()
+    pm = pm.scaled(QSize(16, 16), Qt.KeepAspectRatio, Qt.SmoothTransformation)
+    return QIcon(pm)
+
+
+# --------------------------------------------------------------------------- #
+#  Mixin
+# --------------------------------------------------------------------------- #
+
+class UIBuilderMixin:
+    """Full UI construction pipeline -- header, toolbar, central workspace,
+    statusbar, shortcuts, geometry save/restore, and small UI helpers."""
+
+    # ------------------------------------------------------------------ events
+
+    def showEvent(self, event):
+        super().showEvent(event)
+        # Force Dark Titlebar ONLY when window is actually shown (CTO directive)
+        try:
+            import ctypes
+            hwnd = self.winId()
+            # 20 is DWMWA_USE_IMMERSIVE_DARK_MODE in Win 11
+            ctypes.windll.dwmapi.DwmSetWindowAttribute(int(hwnd), 20, ctypes.byref(ctypes.c_int(1)), 4)
+        except Exception as e:
+            self._report_error('showevent-titlebar-dark', e)
+
+    # ------------------------------------------------------------ bootloader
+
+    def _setup_services(self):
+        """BOOTLOADER STEP 1 -- Preferences & Services."""
+        self.settings = SettingsService()
+        self.design_settings = DesignSettings(self.settings)
+        self.resources = ResourceService()
+        self.audit = AuditService(self.settings)
+        self.projects = ProjectService()
+        self.files = []
+        self.selected = set()
+        # P5/P6: empty orders that must survive restarts + internal clipboard
