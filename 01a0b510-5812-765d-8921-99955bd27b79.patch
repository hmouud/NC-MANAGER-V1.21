+class TestAdvancedProfileCreatorState(unittest.TestCase):
+    """Test state management for holes, slots, and profiles without GUI dependency."""
+
+    def setUp(self):
+        # We can test AppState, ProfileState, ProcessState directly
+        from nccorrection.ui.dialogs.advanced_profile_creator.state import (
+            AppState, ProfileState, ProcessState, _normalize_legacy_format,
+        )
+        self.AppState = AppState
+        self.ProfileState = ProfileState
+        self.ProcessState = ProcessState
+        self.normalize = _normalize_legacy_format
+
+    def test_state_defaults(self):
+        state = self.AppState()
+        self.assertEqual(state.profile.profile_name, "IPE240")
+        self.assertEqual(state.profile.length, 6000.0)
+        self.assertEqual(len(state.processes.holes), 0)
+        self.assertEqual(len(state.processes.slots), 0)
+
+    def test_serialization_round_trip(self):
+        state = self.AppState()
+        state.profile.profile_name = "HEA200"
+        state.profile.length = 3500.0
+        state.processes.holes.append({'face': 'v', 'kind': 'hole', 'x': 250.0, 'y': 95.0, 'd': 22.0})
+        state.processes.slots.append({'face': 'o', 'kind': 'slot', 'x': 500.0, 'y': 100.0, 'd': 18.0, 'length': 40.0, 'angle': 90.0})
+
+        data = state.to_dict()
+        loaded = self.AppState.from_dict(data)
+
+        self.assertEqual(loaded.profile.profile_name, "HEA200")
+        self.assertEqual(loaded.profile.length, 3500.0)
+        self.assertEqual(len(loaded.processes.holes), 1)
+        self.assertEqual(loaded.processes.holes[0]['d'], 22.0)
+        self.assertEqual(len(loaded.processes.slots), 1)
+        self.assertEqual(loaded.processes.slots[0]['length'], 40.0)
+        self.assertEqual(loaded.processes.slots[0]['angle'], 90.0)
+
+    def test_legacy_format_normalization(self):
+        legacy = {
+            'profile': {'name': 'HEB100', 'material': 'S355JR', 'length': 4000.0},
+            'holes': [{'face': 'v', 'x': 100.0, 'y': 50.0, 'd': 14.0}],
+            'slots': [{'face': 'o', 'x': 200.0, 'y': 50.0, 'd': 14.0, 'length': 30.0}],
+        }
+        normalized = self.normalize(legacy)
+        state = self.AppState.from_dict(normalized)
+        self.assertEqual(state.profile.profile_name, "HEB100")
