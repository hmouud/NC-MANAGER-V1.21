+class RoundedRectangleShape(PlateShape):
+    """Rectangle with rounded corners."""
+    name = "Rounded Rectangle"
+    category = "Rectangular"
+    parameters = [
+        ShapeParam("Height", "height", 200.0, 5.0, 10000.0),
+        ShapeParam("Width", "width", 100.0, 5.0, 10000.0),
+        ShapeParam("Corner radius", "corner_radius", 20.0, 0.0, 5000.0),
