+        return compute_bounds(self._geometry, margin=2.0)
+
+    # ---------------------------------------------------------------- view
+    def fit_view(self):
+        self._pan_ox = 0.0
+        self._pan_oy = 0.0
+        self._zoom = 1.0
+        self.update()
+
+    def scale(self, fx, fy):
+        self._zoom = max(0.02, min(self._zoom * fx, 200.0))
+        self.update()
+
+    # ---------------------------------------------------------------- toggles
+    def set_grid_visible(self, visible):
+        self._show_grid = visible
+        self.update()
+
+    def set_section(self, on, axis=0):
+        self._section = bool(on)
