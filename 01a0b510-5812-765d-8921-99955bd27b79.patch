+import tkinter as tk
+
+from nccorrection.ui._colors import C
+
+
+def _render_img(img, data, size, color=None):
+    if color is None:
+        color = C.txt
+    off = '#010203'
+    buf = ' '.join(color if v else off for row in data for v in row)
+    img.put(buf, to=(0, 0, size, size))
+    for y, row in enumerate(data):
+        for x, v in enumerate(row):
+            if not v:
+                try:
+                    img.transparency_set(x, y, True)
+                except tk.TclError:
+                    pass
+    return img
+
+
+def create_settings_icon(size=18):
+    img = tk.PhotoImage(width=size, height=size)
+    data = []
+    for y in range(size):
+        row = []
+        for x in range(size):
+            cx, cy = x - size // 2, y - size // 2
+            d = (cx * cx + cy * cy) ** 0.5
+            r = size * 0.35
+            if abs(d - r) < 2.5 or (abs(d - r * 1.6) < 2.0 and abs(cx) > 1 and abs(cy) > 1):
+                row.append(1)
+            else:
+                row.append(0)
+        data.append(row)
+    return _render_img(img, data, size)
+
+
+def create_close_icon(size=18):
+    img = tk.PhotoImage(width=size, height=size)
+    data = [[0] * size for _ in range(size)]
+    for i in range(size):
+        data[i][i] = 1
+        data[i][size - 1 - i] = 1
+    return _render_img(img, data, size)
+
+
+def create_plus_icon(size=16):
+    img = tk.PhotoImage(width=size, height=size)
+    c = size // 2
+    data = [[0] * size for _ in range(size)]
+    for i in range(2, size - 2):
+        data[c][i] = 1
+        data[i][c] = 1
+    return _render_img(img, data, size)
+
+
+def create_minus_icon(size=16):
+    img = tk.PhotoImage(width=size, height=size)
+    c = size // 2
+    data = [[0] * size for _ in range(size)]
+    for i in range(2, size - 2):
+        data[c][i] = 1
+    return _render_img(img, data, size)
+
+
+def create_fit_icon(size=16):
+    img = tk.PhotoImage(width=size, height=size)
+    data = [[0] * size for _ in range(size)]
+    for i in range(2, size - 2):
+        data[2][i] = 1
+        data[size - 3][i] = 1
+        data[i][2] = 1
+        data[i][size - 3] = 1
+    return _render_img(img, data, size)
