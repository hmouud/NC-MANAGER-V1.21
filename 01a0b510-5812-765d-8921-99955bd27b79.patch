@@ -0,0 +1,287 @@
+"""Profile geometry model — data layer for the Contour Engine.
+
+Defines the internal representation of a steel profile's geometry,
+including face definitions, dimensions, and cut angles. This is the
+foundation that cut_interpreter, notch_detector, and contour_builder
+all consume.
+
+Ground truth: 37 NC1 template files in engine/profile_catalog/templates/
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import List, Tuple, Optional
+
+
+# ── DSTV kind codes ────────────────────────────────────────────────
+# I = I-beam (IPE/HEA/HEB/HEM/IPN)
+# U = Channel (UPN/UPE)
+# L = Angle
+# B = Plate
+# O = Round tube (CHS)
+# T = Square/rect tube (SHS/RHS)
+KIND_I = 'I'
+KIND_U = 'U'
+KIND_L = 'L'
+KIND_B = 'B'
+KIND_O = 'O'
+KIND_T = 'T'
+
+
+@dataclass
+class CutAngles:
+    """Saw cut angles from the ST header (dims[8:12]).
+
+    Convention: angle in degrees from vertical (per DSTV standard).
+    Positive = cut toward +X direction. Negative = cut toward -X.
+
+    WARNING: Header column order varies by profile kind. The factory
+    method ``from_header`` uses kind_code to interpret correctly.
+    """
+    steg_front: float = 0.0    # dims[8] for I/U profiles
+    steg_rear: float = 0.0     # dims[9] for I/U profiles
+    flange_front: float = 0.0  # dims[10] for I/U profiles
+    flange_rear: float = 0.0   # dims[11] for I/U profiles
+
+    @property
+    def has_any(self) -> bool:
+        """True if any cut angle is non-zero."""
+        return any(abs(v) > 1e-6 for v in [
+            self.steg_front, self.steg_rear,
+            self.flange_front, self.flange_rear,
+        ])
+
+    @classmethod
+    def from_header(cls, dims: List[float], kind_code: str) -> 'CutAngles':
+        """Extract cut angles from ST header dims, respecting profile kind.
+
+        For I/U profiles: dims[8:12] = steg_front, steg_rear, flange_front, flange_rear.
+        For L/B/O/T profiles: cut angles are not standard in the header;
+        they may appear in different positions or not at all.
+        """
+        if len(dims) < 12:
+            return cls()
+
+        kind = (kind_code or '').upper()
+
+        if kind in (KIND_I, KIND_U):
+            # Standard I/U order: steg_front, steg_rear, flange_front, flange_rear
+            return cls(
+                steg_front=float(dims[8]),
+                steg_rear=float(dims[9]),
+                flange_front=float(dims[10]),
+                flange_rear=float(dims[11]),
+            )
+
+        if kind == KIND_L:
+            # L-angles: no standard cut angle positions in header
+            # Some software may write angles, but positions vary
+            return cls()
+
+        if kind == KIND_B:
+            # Plates: no cut angles in header
+            return cls()
+
+        # O/T (tubes): no standard cut angles
+        return cls()
+
+
+@dataclass
+class NotchPoint:
+    """A point with a DSTV suffix marker."""
+    x: float
+    y: float
+    suffix: str = ''  # 's'=start, 'u'=continuation, 'w'=hole/notch, 't'=tangential notch
+
+    @property
+    def is_notch(self) -> bool:
+        return self.suffix == 'w'
+
+    @property
+    def is_tangential_notch(self) -> bool:
+        return self.suffix == 't'
+
+    @property
+    def is_start(self) -> bool:
+        return self.suffix == 's'
+
+
+@dataclass
+class FaceSegment:
+    """A contiguous segment of a face contour.
+
+    Most faces have 1 segment (a simple rectangle). Complex cuts
+    (A39.nc1) can split a face into multiple segments.
+    """
+    points: List[Tuple[float, float]]
+    has_notches: bool = False
+
+
+@dataclass
+class FaceDefinition:
+    """Complete definition of one machining face (v, o, u, h).
+
+    The face width comes from the profile dimensions:
+    - I/U: v=H(web), o=b(flange), u=b(flange), h=H(web)
+    - L: v=leg1(H), u=leg2(b)
+    - B: v=b(width)
+    """
+    code: str                         # 'v', 'o', 'u', 'h'
+    width: float                      # face width in mm (Y dimension)
+    segments: List[FaceSegment] = field(default_factory=list)
+    is_rectangular: bool = True       # True if all segments are simple 5-point rects
+    cut_angles: Optional[CutAngles] = None  # non-None if this face has saw cuts
+
+    @property
+    def segment_count(self) -> int:
+        return len(self.segments)
+
+
+@dataclass
+class BendsData:
+    """Bend lines from KA block.
+
+    Per DSTV: 5 or 6 columns per line.
+    Col 0: X1, Col 1: Y1, Col 2: X2, Col 3: Y2,
+    Col 4: Angle (degrees), Col 5: Radius/K-Factor (optional, NOT thickness).
+    Thickness comes from the ST header.
+    """
+    lines: List[Tuple[float, float, float, float, float, Optional[float]]] = field(
+        default_factory=list
+    )
+
+    @property
+    def count(self) -> int:
+        return len(self.lines)
+
+    @property
+    def has_bends(self) -> bool:
+        return self.count > 0
+
+
+@dataclass
+class ProfileGeometryModel:
+    """Complete geometric model of a steel profile.
+
+    This is the single source of truth for the Contour Engine.
+    It is built from ST header dimensions and does NOT depend on
+    any specific NC1 file.
+    """
+    kind_code: str                    # DSTV letter: I, U, L, B, O, T
+    profile_name: str                 # e.g. 'HEM500', 'UPN200'
+    length: float                     # part length in mm
+    depth: float                      # H — profile height/depth
+    width: float                      # b — flange width (or leg for L, plate width)
+    flange_thick: float               # tf — flange thickness (or leg thickness for L)
+    web_thick: float                  # tw — web thickness
+    root_radius: float                # r — root radius
+    cut_angles: CutAngles = field(default_factory=CutAngles)
+    faces: List[FaceDefinition] = field(default_factory=list)
+    bends: BendsData = field(default_factory=BendsData)
+
+    @classmethod
+    def from_header(cls, dims: List[float], kind_code: str,
+                    profile_name: str = '') -> 'ProfileGeometryModel':
+        """Build a ProfileGeometryModel from ST header dimensions.
+
+        Dim order (DSTV standard, confirmed by real files):
+          dims[0] = length
+          dims[1] = H (depth)
+          dims[2] = b (width)
+          dims[3] = tf (flange thickness)
+          dims[4] = tw (web thickness)
+          dims[5] = r (root radius)
+          dims[6..12] = weight, other, cut_angles(4)
+        """
+        kind = (kind_code or '').upper()
+
+        length = float(dims[0]) if len(dims) > 0 else 0.0
+        depth = float(dims[1]) if len(dims) > 1 else 0.0
+        width = float(dims[2]) if len(dims) > 2 else 0.0
+        tf = float(dims[3]) if len(dims) > 3 else 0.0
+        tw = float(dims[4]) if len(dims) > 4 else 0.0
+        r = float(dims[5]) if len(dims) > 5 else 0.0
+
+        cut_angles = CutAngles.from_header(dims, kind_code)
+
+        model = cls(
+            kind_code=kind,
+            profile_name=profile_name,
+            length=length,
+            depth=depth,
+            width=width,
+            flange_thick=tf,
+            web_thick=tw,
+            root_radius=r,
+            cut_angles=cut_angles,
+        )
+
+        model.faces = _build_faces(model)
+        return model
+
+    @property
+    def is_plate(self) -> bool:
+        return self.kind_code == KIND_B
+
+    @property
+    def is_beam(self) -> bool:
+        return self.kind_code in (KIND_I, KIND_U)
+
+    @property
+    def has_cuts(self) -> bool:
+        return self.cut_angles.has_any
+
+    def face_by_code(self, code: str) -> Optional[FaceDefinition]:
+        """Look up a face by its code ('v', 'o', 'u', 'h')."""
+        code = (code or '').lower()
+        for f in self.faces:
+            if f.code == code:
+                return f
+        return None
+
+
+# ── Face building ──────────────────────────────────────────────────
+
+def _build_faces(model: ProfileGeometryModel) -> List[FaceDefinition]:
+    """Build face definitions based on profile kind.
+
+    Ground truth from 37 NC1 templates:
+    - I-beam: v(web=H), o(flange=b), u(flange=b) — no 'h' in any template
+    - U-channel: v(web=H), o(flange=b), u(flange=b)
+    - L-angle: v(leg1=H), u(leg2=b) — no 'o' or 'h'
+    - Plate: v(width=b) — single face only
+    - SHS/RHS (T): v(width=b)
+    - CHS (O): v(width=OD)
+    """
+    kind = model.kind_code
+    L = model.length
+
+    if kind in (KIND_I, KIND_U):
+        return [
+            FaceDefinition(code='v', width=model.depth),   # web
+            FaceDefinition(code='o', width=model.width),   # top flange
+            FaceDefinition(code='u', width=model.width),   # bottom flange
+        ]
+
+    if kind == KIND_L:
+        return [
+            FaceDefinition(code='v', width=model.depth),   # vertical leg
+            FaceDefinition(code='u', width=model.width),   # horizontal leg
+        ]
+
+    if kind == KIND_B:
+        # Plate: dims[1] = stocked width, dims[2] = thickness
+        # Face width = stocked width (stored as model.depth for plates)
+        return [
+            FaceDefinition(code='v', width=model.depth),   # plate face width
+        ]
+
+    if kind in (KIND_T, KIND_O):
+        return [
+            FaceDefinition(code='v', width=model.depth),   # outer face
+        ]
+
+    # Unknown kind: single v face with depth
+    return [
+        FaceDefinition(code='v', width=model.depth),
+    ]
