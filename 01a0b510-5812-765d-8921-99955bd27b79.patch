index 0000000..7699f56
--- /dev/null
+++ b/src/nccorrection/core/organizer.py
@@ -0,0 +1,212 @@
+import os
+import shutil
+import hashlib
+from collections import Counter
+
+
+def file_hash(path, chunk=65536):
+    h = hashlib.sha256()
+    try:
+        with open(path, 'rb') as f:
+            while True:
+                b = f.read(chunk)
+                if not b:
+                    break
+                h.update(b)
+    except OSError:
+        return ''
+    return h.hexdigest()
+
+
+def folder_hash_set(directory):
+    """Return a set of hashes for all files currently in `directory`."""
+    result = set()
+    try:
+        for name in os.listdir(directory):
+            p = os.path.join(directory, name)
+            if os.path.isfile(p):
+                result.add(file_hash(p))
+    except OSError:
+        pass
+    return result
+
+
+def plan_sort(files, output_dir, delete_original=True, known_dest_hashes=None):
+    """Build a sort plan. Each file -> output_dir/<folder>/<name>.
+
+    - A file whose content already exists in the destination folder is
+      marked SKIP_DUPLICATE (not moved/copied).
+    - A file already located inside its target folder is marked SKIP_ALREADY.
+    - folder is the flat profile name (e.g. L60, HEA160, PL15) or UNKNOWN.
+
+    Returns a list of dicts with keys: src, name, dest_name, folder, dest,
+    hash, action (MOVE/COPY/SKIP_DUPLICATE/SKIP_ALREADY), reason.
+    """
+    plan = []
+    used_names = set()
+    planned_hashes = set()
+    dest_hash_cache = {}
+    for f in files:
+        folder = f.get('folder') or f.get('profile') or 'UNKNOWN'
+        if not folder or folder == 'UNKNOWN':
+            folder = 'UNKNOWN'
+        dest_dir = os.path.join(output_dir, folder)
+        # The output file keeps the ORIGINAL display name (e.g. C1.nc1).
+        # Since P1 (Project Import) the stored copy path is the content
+        # hash (projects/<name>/input/<sha256>.nc1) - the name must come
+        # from the record, NEVER from the stored path. Owner rule: the NC
+        # file name changes ONLY by explicit user command inside the app.
+        name = f.get('name') or os.path.basename(f['path'])
+        src_hash = f.get('hash') or file_hash(f['path'])
+
+        # Already in the target folder -> nothing to do.
+        src_dir = os.path.dirname(os.path.abspath(f['path']))
+        if os.path.abspath(dest_dir) == src_dir:
+            plan.append({
+                'src': f['path'], 'name': name, 'dest_name': name,
+                'folder': folder, 'dest': os.path.join(dest_dir, name),
+                'hash': src_hash, 'action': 'SKIP_ALREADY',
+                'reason': 'already in target folder',
+            })
+            continue
+
+        # Duplicate content already in the destination folder.
+        if dest_dir not in dest_hash_cache:
+            dest_hash_cache[dest_dir] = (
+                known_dest_hashes.get(dest_dir)
+                if known_dest_hashes and dest_dir in known_dest_hashes
+                else folder_hash_set(dest_dir)
+            )
+        if src_hash and (src_hash in dest_hash_cache[dest_dir] or src_hash in planned_hashes):
+            plan.append({
+                'src': f['path'], 'name': name, 'dest_name': name,
+                'folder': folder, 'dest': os.path.join(dest_dir, name),
+                'hash': src_hash, 'action': 'SKIP_DUPLICATE',
+                'reason': 'duplicate already in destination',
+            })
+            continue
+        planned_hashes.add(src_hash)
+
+        base, ext = os.path.splitext(name)
+        candidate = name
+        n = 1
+        while candidate.lower() in used_names or os.path.exists(os.path.join(dest_dir, candidate)):
+            n += 1
+            candidate = f'{base}_{n}{ext}'
+        used_names.add(candidate.lower())
+        plan.append({
+            'src': f['path'],
+            'name': name,
+            'dest_name': candidate,
+            'folder': folder,
+            'dest': os.path.join(dest_dir, candidate),
+            'hash': src_hash,
+            'action': 'MOVE' if delete_original else 'COPY',
+            'reason': '',
+        })
+    return plan
+
+
+def execute_plan(plan):
+    """Execute a sort plan. Returns results; each result includes ok + reason.
+
+    Empty directories created along the way are removed afterwards, so a plan
+    never leaves empty profile folders behind.
+    """
+    results = []
+    roots = set()
+    for item in plan:
+        if item['action'] in ('SKIP_DUPLICATE', 'SKIP_ALREADY'):
+            results.append({**item, 'ok': True})
+            continue
+        try:
+            os.makedirs(os.path.dirname(item['dest']), exist_ok=True)
+            if item['action'] == 'MOVE':
+                shutil.move(item['src'], item['dest'])
+            else:
+                shutil.copy2(item['src'], item['dest'])
+            results.append({**item, 'ok': True, 'reason': ''})
+        except (OSError, shutil.Error) as e:
+            results.append({**item, 'ok': False, 'reason': str(e)})
+    for item in plan:
+        if item['action'] in ('MOVE', 'COPY'):
+            roots.add(os.path.normpath(os.path.dirname(item['dest'])))
+    for root in roots:
+        prune_empty_dirs(root)
+    return results
+
+
+def plan_summary(plan):
+    """Return (moved, skipped_dup, skipped_already, failed_placeholder) counts
+    and a Counter of folders for moved/copied items."""
+    counts = Counter()
+    moved = 0
+    dup = 0
+    already = 0
+    for p in plan:
+        if p['action'] == 'MOVE' or p['action'] == 'COPY':
+            counts[p['folder']] += 1
+            moved += 1
+        elif p['action'] == 'SKIP_DUPLICATE':
+            dup += 1
+        elif p['action'] == 'SKIP_ALREADY':
+            already += 1
+    return moved, dup, already, counts
+
+
+def plan_conflicts(plan):
+    """Return a list of human-readable conflicts that block organizing.
+
+    A conflict is a planned MOVE/COPY whose destination already holds a file
+    with different content (overwrite risk) or whose target name collides with
+    another planned destination. SKIP items are not conflicts.
+    """
+    conflicts = []
+    seen_dest = {}
+    for item in plan:
+        if item['action'] not in ('MOVE', 'COPY'):
+            continue
+        dest = os.path.normcase(os.path.normpath(item['dest']))
+        if dest in seen_dest:
+            conflicts.append(
+                f"Two files map to the same destination: "
+                f"{os.path.basename(seen_dest[dest])} and {os.path.basename(item['src'])} "
+                f"-> {item['dest']}")
+            continue
+        seen_dest[dest] = item['src']
+        if os.path.exists(item['dest']):
+            existing = file_hash(item['dest'])
+            if existing and existing != item.get('hash'):
+                conflicts.append(
+                    f"{item['name']} would overwrite a different file: {item['dest']}")
+    return conflicts
+
+
+def prune_empty_dirs(root):
+    """Remove empty directories below ``root`` (never create empty folders)."""
+    try:
+        for dirpath, dirnames, filenames in os.walk(root, topdown=False):
+            try:
+                os.rmdir(dirpath)
+            except OSError:
+                pass
+    except OSError:
+        pass
+
+
+def summarize_results(results):
+    """Summarize results for a status message."""
+    ok = [r for r in results if r['ok']]
+    fail = [r for r in results if not r['ok']]
+    moved = [r for r in ok if r['action'] in ('MOVE', 'COPY')]
+    skipped = [r for r in ok if r['action'] in ('SKIP_DUPLICATE', 'SKIP_ALREADY')]
+    folders = Counter(r['folder'] for r in moved)
+    parts = [f"{name} ({count})" for name, count in folders.most_common()]
+    text = f"{len(moved)} file(s) sorted"
+    if parts:
+        text += f" | " + ' -> '.join(parts)
+    if skipped:
+        text += f" | {len(skipped)} skipped"
+    if fail:
+        text += f" | {len(fail)} failed"
+    return text
diff --git a/src/nccorrection/core/part3d.py b/src/nccorrection/core/part3d.py
