+"""Sliding Cotation Bar — animated toolbar for dimension controls.
+
+Expands/collapses with a smooth animation. Contains toggles for
+e (edge distance) and ga (gauge) visibility, plus style presets.
+"""
+from __future__ import annotations
+
+from PySide6.QtWidgets import (
+    QWidget, QHBoxLayout, QPushButton, QLabel, QDoubleSpinBox, QFrame,
+)
+from PySide6.QtCore import (
+    QPropertyAnimation, QEasingCurve, Property, Signal,
+)
+from nccorrection.ui._colors import C
+
+
+class SlidingCotationBar(QWidget):
+    """Animated sliding bar for cotation controls.
+
+    Contains:
+      - Toggle buttons for e / ga visibility
+      - Edge distance spinner
+      - Gauge distance spinner
+      - Style preset selector
+    """
+
+    cotation_params_changed = Signal(float, float)  # (edge_dist, gauge)
+    cotation_toggled = Signal(bool)  # show/hide
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setStyleSheet(
+            f"background-color: {C.panel}; border: 1px solid {C.line}; border-radius: 4px;"
+        )
+        self.setMaximumWidth(0)
+        self.setMinimumHeight(36)
+        self.setContentsMargins(0, 0, 0, 0)
+
+        layout = QHBoxLayout(self)
+        layout.setContentsMargins(8, 2, 8, 2)
+        layout.setSpacing(8)
+
+        # ── Toggle cotation visibility ────────────────────────────
+        self._btn_toggle = QPushButton("Cot")
+        self._btn_toggle.setCheckable(True)
+        self._btn_toggle.setChecked(True)
+        self._btn_toggle.setFixedWidth(40)
+        self._btn_toggle.setStyleSheet(
+            f"QPushButton {{ color: #00cec9; background: transparent; "
+            f"border: 1px solid {C.line}; border-radius: 3px; font-weight: bold; }}"
+            f"QPushButton:checked {{ background-color: #00cec920; border-color: #00cec9; }}"
+        )
+        self._btn_toggle.toggled.connect(self.cotation_toggled.emit)
+        layout.addWidget(self._btn_toggle)
+
+        # ── Separator ─────────────────────────────────────────────
+        sep = QFrame()
+        sep.setFrameShape(QFrame.VLine)
+        sep.setStyleSheet(f"color: {C.line};")
+        layout.addWidget(sep)
+
+        # ── e (edge distance) ─────────────────────────────────────
+        lbl_e = QLabel("e:")
+        lbl_e.setStyleSheet("color: #e67e22; font-weight: bold; font-size: 11px;")
+        layout.addWidget(lbl_e)
+
+        self._spin_e = QDoubleSpinBox()
+        self._spin_e.setRange(5.0, 200.0)
+        self._spin_e.setValue(20.0)
+        self._spin_e.setSuffix(" mm")
+        self._spin_e.setFixedWidth(80)
+        self._spin_e.setFixedHeight(24)
+        self._spin_e.setStyleSheet(
+            f"QDoubleSpinBox {{ background: {C.bg}; color: #e67e22; "
+            f"border: 1px solid {C.line}; border-radius: 2px; padding: 2px; "
+            f"font-size: 11px; }}"
+        )
+        self._spin_e.valueChanged.connect(self._emit_params)
+        layout.addWidget(self._spin_e)
+
+        # ── ga (gauge) ────────────────────────────────────────────
+        lbl_ga = QLabel("ga:")
+        lbl_ga.setStyleSheet("color: #00cec9; font-weight: bold; font-size: 11px;")
+        layout.addWidget(lbl_ga)
+
+        self._spin_ga = QDoubleSpinBox()
+        self._spin_ga.setRange(10.0, 500.0)
+        self._spin_ga.setValue(40.0)
+        self._spin_ga.setSuffix(" mm")
+        self._spin_ga.setFixedWidth(80)
+        self._spin_ga.setFixedHeight(24)
+        self._spin_ga.setStyleSheet(
+            f"QDoubleSpinBox {{ background: {C.bg}; color: #00cec9; "
+            f"border: 1px solid {C.line}; border-radius: 2px; padding: 2px; "
+            f"font-size: 11px; }}"
+        )
+        self._spin_ga.valueChanged.connect(self._emit_params)
+        layout.addWidget(self._spin_ga)
+
+        layout.addStretch()
+
+        # ── Animation ─────────────────────────────────────────────
+        self._anim = QPropertyAnimation(self, b"maximumWidth")
+        self._anim.setDuration(250)
+        self._anim.setEasingCurve(QEasingCurve.InOutQuad)
+        self._is_open = False
+
+    # ── Animation property ────────────────────────────────────────
+
+    def _get_max_width(self):
+        return self.maximumWidth()
+
+    def _set_max_width(self, val):
+        self.setMaximumWidth(int(val))
+
+    maximumWidth = Property(int, _get_max_width, _set_max_width)
+
+    # ── Public API ────────────────────────────────────────────────
+
+    def toggle(self):
+        """Expand or collapse the bar with animation."""
+        target = 280 if not self._is_open else 0
+        self._anim.setStartValue(self.width())
+        self._anim.setEndValue(target)
+        self._anim.start()
+        self._is_open = not self._is_open
+
+    def is_open(self) -> bool:
+        return self._is_open
+
+    def get_params(self) -> tuple:
+        """Return (edge_distance, gauge) values."""
+        return (self._spin_e.value(), self._spin_ga.value())
+
+    # ── Internal ──────────────────────────────────────────────────
+
+    def _emit_params(self):
+        self.cotation_params_changed.emit(self._spin_e.value(), self._spin_ga.value())
