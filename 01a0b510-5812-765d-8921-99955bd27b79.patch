+"""Viewer2D3DMixin — 2D / 3D / Blueprint viewer logic extracted from NCManagerApp.
+
+Kept as a mixin so that app.py stays manageable while the viewer
+domain methods remain on the same ``self`` and require zero call-site
+changes.
+
+Extracted methods:
+    _toggle_section_shortcut, _toggle_wireframe_shortcut,
+    _update_details, _refresh_viewers, _refresh_dxf_viewer,
+    _set_view_mode, _toggle_view_mode, _viewer_fit, _viewer_zoom,
+    _apply_view_opt, _load_view_opts, _toggle_grid, _toggle_cotation,
+    _toggle_blueprint, _toggle_foreshorten, _toggle_section,
+    _toggle_wireframe, _toggle_spin, _on_spin_speed, _toggle_legend,
+    _push_fold_state, _toggle_fold_show_line, _toggle_fold_view,
+    _toggle_holes_table, _viewer_menu, _measuring, _has_measurements,
+    _clear_all_measurements, _apply_face_labels, _hole_row_at,
+    _blueprint_hit_row, _build_viewer_menu, _design_snap_actions,
+    _apply_corner_mode, _drafting_placeholder, _on_drafting_changed,
+    _help_text, _update_help, _screenshot, _current_view_widget.
+"""
+
+import os
+import math
+from datetime import datetime
+
+from PySide6.QtWidgets import QFileDialog, QMenu
+from PySide6.QtCore import Qt
+from PySide6.QtGui import QColor
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.engine.parser.dstv_parser import DstvParser
+from nccorrection.engine.dxf.dxf_parser import read_dxf, plate_thickness
+
+
+# Canonical dark QMenu look for the viewer context menus - same palette as
+# the app's other menus (custom_header) so popups inherit the app's dark
+# scheme regardless of the system palette.
+_VIEWER_MENU_QSS = """
+    QMenu { background-color: #1e293b; color: #f8fafc; border: 1px solid #334155; }
+    QMenu::item { padding: 4px 24px 4px 8px; color: #f8fafc; }
+    QMenu::item:selected { background: #334155; }
+"""
+
+
+class Viewer2D3DMixin:
+    """2D / 3D / Blueprint viewer helpers mixed into NCManagerApp."""
+
+    def _toggle_section_shortcut(self):
+        if getattr(self, 'section_btn', None):
+            self.section_btn.setChecked(not self.section_btn.isChecked())
+
+    def _toggle_wireframe_shortcut(self):
+        if getattr(self, 'wire_btn', None):
+            self.wire_btn.setChecked(not self.wire_btn.isChecked())
+
+    def _update_details(self):
+        sel_rows = self.table.selectionModel().selectedRows()
+        if not sel_rows:
+            self.viewer.clear_geometry()
+            self.viewer3d.clear_geometry()
+            self.face_viewer.clear()
+            self.details.setText('')
+            self.profile_bar.setText('')
+            self._current_geometry = None
+            self._current_active = []
+            self.holes_table.setRowCount(0)
+            self.notes.blockSignals(True)
+            self.notes.clear()
+            self.notes.blockSignals(False)
+            self._current_file = None
+            return
+        r = sel_rows[0].row()
+        item = self.table.item(r, 0)
+        if not item:
+            return
+        idx = item.data(Qt.UserRole)
+        f = self.files[idx]
+        self.details.setText('')
+        self.notes.blockSignals(True)
+        self.notes.setPlainText(self.settings.get_note(f['hash']))
+        self.notes.blockSignals(False)
+        self._current_file = f
+        self._refresh_viewers(f)
+        self._populate_holes_table(f)
+        for rr in range(self.table.rowCount()):
+            it = self.table.item(rr, 0)
+            if not it:
+                continue
+            ii = it.data(Qt.UserRole)
+            bg = QColor(self._theme['select']) if ii in self.selected else QColor(self._theme['panel'])
+            for cc in range(self.table.columnCount()):
+                cell = self.table.item(rr, cc)
+                if cell:
+                    cell.setBackground(bg)
+
+    def _refresh_viewers(self, f, preserve_view=False):
