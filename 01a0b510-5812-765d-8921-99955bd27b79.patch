+  magic), UNKNOWN (text/bytes outside the industrial scope)
+* NC1 detailing    — plate profile PL8 with S235JR, dims 8000x200x8,
+  1 round hole + 1 slot, faces [u, v]; I-beam dims mapped to tw
+* DXF detailing    — entity-count scanner (CIRCLE / LWPOLYLINE / LINE),
+  plate convention (PL + face v), warning for entity-only scan
+* robustness       — missing file / garbage bytes never raise
+"""
+
+import os
+import tempfile
+import unittest
+
+from nccorrection.engine.format_analyzer import (DetailReport, analyze_file,
+                                                 detect_format)
