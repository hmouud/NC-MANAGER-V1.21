+
+    def _reset_bands(self):
+        self._pan = (0.0, 0.0)
+        self._zoom = 1.0
+        self._band_zoom = {}
+        self._band_pan = {}
+        self._band_rects = {}
+
+    def _all_mode(self):
+        return self._face == 'all'
+
+    # ---------------------------------------------------------------- paint
+    def paintEvent(self, event):
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), QColor(self._bp['bg']))
+        self._badge_rects = []
+        if not self._part:
+            p.setPen(QColor('#94a3b8'))
+            p.setFont(QFont('Arial', 10))
+            p.drawText(self.rect(), Qt.AlignCenter, 'Select a file to view its faces')
+            p.end()
+            return
+        if self._unfold:
+            self.render_unfolded(p)
+            self._draw_measure(p)
+        elif self._face == 'all':
+            self._draw_all_faces_grid(p)
+            self._draw_measure(p)
+        else:
+            face = self._part.get_face(self._face)
+            if not face:
+                p.setPen(QColor('#94a3b8'))
+                p.setFont(QFont('Arial', 10))
+                p.drawText(self.rect(), Qt.AlignCenter,
+                           f'No geometry for face "{self._face}"')
+                p.end()
+                return
+            self._draw_face(p, self._face, self.rect(),
+                            self.FACE_DESCR.get(self._face, self._face))
+            self._draw_measure(p)
+        p.end()
+
+    def _draw_all_faces_grid(self, p):
+        codes = [c for c in FaceCoordinateSystem.FACE_ORDER
+                 if c in self._part.faces]
+        if not codes:
+            p.setPen(QColor('#94a3b8'))
+            p.setFont(QFont('Arial', 10))
+            p.drawText(self.rect(), Qt.AlignCenter, 'No faces to display')
+            return
+        margin, header, gap = 8.0, 22.0, 8.0
+        avail_w = max(self.width() - 2 * margin, 10.0)
+        avail_h = max(self.height() - 2 * margin, 10.0)
+        # each face keeps its own aspect ratio (beam length along X) so the
+        # development reads as a clean vertical stack of full-width bands
+        bands = []
+        for code in codes:
+            span = self._face_span(self._part.get_face(code))
+            bands.append(max(avail_w * span[1] / max(span[0], 1e-9), 46.0))
+        total = sum(bands) + gap * (len(bands) - 1) + header * len(bands)
+        k = min(1.0, avail_h / max(total, 1e-9))
+        y = margin
+        self._band_rects = {}
+        for i, code in enumerate(codes):
+            bh = bands[i] * k
+            rect = QRectF(margin, y, avail_w, bh + header)
+            self._band_rects[code] = rect
+            self._draw_face(p, code, rect,
+                            self.FACE_DESCR.get(code, code),
+                            self._band_zoom.get(code, 1.0),
+                            self._band_pan.get(code, (0.0, 0.0)))
+            y += bh + header + gap
+
+    def _face_span(self, face):
+        outer = face.outer_contour
+        if outer and outer.vertices:
+            xs = [v.x for v in outer.vertices]
+            ys = [v.y for v in outer.vertices]
+            return (max(xs) - min(xs), max(ys) - min(ys))
+        return (1.0, 1.0)
+
+    # -------------------------------------------------------------- face
+    def _face_geometry(self, face):
+        """Return (polylines, inner_polys, holes, markings) for one face."""
+        outer = face.outer_contour
+        polylines = []
+        if outer and len(outer.vertices) >= 2:
+            pts = polyline_for_vertices(
+                [(v.x, v.y, v.bulge, v.radius) for v in outer.vertices])
+            if pts:
+                polylines.append(pts)
+        inner_polys = []
+        for ic in face.inner_contours:
+            if len(ic.vertices) >= 2:
+                pts = polyline_for_vertices(
+                    [(v.x, v.y, v.bulge, v.radius) for v in ic.vertices])
+                if pts:
+                    inner_polys.append(pts)
+        return polylines, inner_polys, face.holes, face.markings
+
+    def _auto_scale(self, face, rect, zoom=1.0, pan=(0.0, 0.0)):
+        outer = face.outer_contour
+        if outer and outer.vertices:
+            xs = [v.x for v in outer.vertices]
+            ys = [v.y for v in outer.vertices]
+            x0, x1 = min(xs), max(xs)
+            y0, y1 = min(ys), max(ys)
+        else:
+            x0, y0, x1, y1 = 0.0, 0.0, 1.0, 1.0
+        w = max(x1 - x0, 1e-6)
+        h = max(y1 - y0, 1e-6)
+        # shrink the vertical padding for short bands so narrow faces stay big
+        pad_x = 30.0
+        pad_y = min(46.0, rect.height() * 0.30)
+        scale = min(max(rect.width() - 2 * pad_x, 10) / w,
+                    max(rect.height() - 2 * pad_y, 10) / h) * zoom
+        scale = max(scale, 1e-9)
+        ox = rect.center().x() - (x0 + x1) / 2.0 * scale + pan[0]
+        oy = rect.center().y() + (y0 + y1) / 2.0 * scale + pan[1]
+        return scale, ox, oy
+
+    def _draw_face(self, p, face_code, rect, title, zoom=None, pan=None):
+        face = self._part.get_face(face_code)
+        if face is None:
+            p.setPen(QColor('#64748b'))
+            p.setFont(QFont('Arial', 9))
+            p.drawText(rect, Qt.AlignCenter, 'no data')
+            return
+        if zoom is None:
+            zoom = self._zoom
+        if pan is None:
+            pan = self._pan
+        scale, ox, oy = self._auto_scale(face, rect, zoom, pan)
+
+        def to_canvas(x, y):
+            return ox + x * scale, rect.bottom() - y * scale
+
+        # Folded View (plate, single-face path): fold every mapped point
+        # through the part's KA bend lines (plan projection).
+        if (self._fold_state.get('fold') and face_code == 'v'
+                and self._part_foldable()):
+            _base = to_canvas
+
+            def to_canvas(x, y):
+                fx, fy = self._fold_pt(self._part, x, y)
+                return _base(fx, fy)
+
+        # background quad + label (face-name mode is a GLOBAL setting shared
+        # by every view: full names / letters + tooltip / hidden)
+        p.fillRect(rect, QColor(self._bp['paper']))
+        p.setPen(QPen(QColor(self._bp['contour_dim']), 1.0))
+        p.drawRect(rect)
+        title_text = self._face_title(face_code)
+        if title_text is not None:
+            p.setPen(QColor(self._bp['text']))
+            p.setFont(QFont('Arial', 10, QFont.Bold))
+            title_rect = QRectF(rect.left() + 6, rect.top() + 4,
+                                rect.width() - 12, 18)
+            p.drawText(title_rect, Qt.AlignLeft, f'{title_text}')
+            if self._face_labels == 'letters':
+                full = self.FACE_DESCR.get(face_code, face_code)
+                self._badge_rects.append((title_rect, full))
+
+        if self._show_grid:
+            self._draw_grid(p, rect, scale, ox, oy)
+
+        self._draw_face_geometry(p, face, to_canvas, scale, face_code)
+
+        # Folded View -- 'Show Folded Line' (single-face path): the DSTV KA
+        # bend lines dashed #e67e22 with their fold angle on the web face.
+        if (self._fold_state.get('show_line') and face_code == 'v'
+                and getattr(self._part, 'bends', None)):
+            fold_pen = QPen(QColor('#e67e22'), 1.2, Qt.DashLine)
+            fold_pen.setDashPattern([6, 4])
+            p.setPen(fold_pen)
+            p.setFont(QFont('Arial', 7, QFont.Bold))
+            for b in self._part.bends:
+                s1 = to_canvas(b.x1, b.y1)
+                s2 = to_canvas(b.x2, b.y2)
+                p.drawLine(QPointF(s1[0], s1[1]), QPointF(s2[0], s2[1]))
+                if b.angle:
+                    mx, my = (s1[0] + s2[0]) / 2.0, (s1[1] + s2[1]) / 2.0
+                    p.setPen(QColor('#e67e22'))
+                    p.drawText(QPointF(mx + 4, my - 4), f'{b.angle:g}\u00b0')
+                    p.setPen(fold_pen)
+
+        # bounds readout
+        polylines = self._face_geometry(face)[0]
+        if polylines:
+            xs = [pt[0] for pt in polylines[0]]
+            ys = [pt[1] for pt in polylines[0]]
+            p.setPen(QColor(self._bp['text']))
+            p.setFont(QFont('Arial', 8))
+            p.drawText(QRectF(rect.left() + 6, rect.bottom() - 16, rect.width() - 12, 14),
+                       Qt.AlignLeft, f'X {min(xs):.0f}..{max(xs):.0f}  Y {min(ys):.0f}..{max(ys):.0f}')
+    def _draw_face_geometry(self, p, face, to_canvas, scale, face_code, bp=None):
+        """Draw contours, inner cut-outs, holes and markings with a to_canvas.
+
+        The palette is applied unconditionally: ``bp`` defaults to the engine's
+        current :attr:`_bp` so every rendering path (single face, all-face grid
+        and unfolded blueprint) produces the exact same engineering palette.
+
+        Engineering blueprint colours (verified by pixel test):
+            web face (v)        fill  #2c3e50
+            flange faces o/u/h  fill  #34495e
+            outer contours (AK) pen   #00a8ff  width sp(1)
+            holes / copes       pen+fill #f39c12
+        """
+        polylines, inner_polys, holes, markings = self._face_geometry(face)
+        bp = bp or self._bp
+
+        # Folded View (plate, single-face path): holes whose centre sits on
+        # the flap of a near-90-deg bend are not visible in the top
+        # orthographic projection -- drop them from the grouped/ labelled
+        # hole pass (owner mandate 2026-09-13, shared rule in core/fold.py).
+        if (self._fold_state.get('fold') and face_code == 'v'
+                and self._part_foldable() and holes):
+            from nccorrection.core.fold import hole_hidden_by_fold
+            bends = self._fold_bends()
+            holes = [h for h in holes
+                     if not hole_hidden_by_fold(bends, h.x, h.y)]
+
+        face_fill = QColor(bp['fill_web'] if face_code == 'v' else bp['fill_flange'])
+        face_col = QColor(bp['contour'])
+        bg_col = QColor(bp['paper'])
+        cut_col = QColor(bp['cut'])
+        cut_width = sp(1)
+
+        # Outer contour + inner contours combined into a single QPainterPath
+        # using OddEvenFill so inner contours create visible holes (cutouts)
+        # in the outer plate fill.  Without this, drawing inner contours
+        # separately and then drawing the outer fill on top would cover them.
+        for pts in polylines:
+            path = QPainterPath(QPointF(*to_canvas(*pts[0])))
+            path.setFillRule(Qt.OddEvenFill)
+            for x, y in pts[1:]:
+                path.lineTo(QPointF(*to_canvas(x, y)))
+            path.closeSubpath()
+            # add inner contour subpaths — the winding rule punches holes
+            for ipt in inner_polys:
+                if not ipt:
+                    continue
+                inner = QPainterPath(QPointF(*to_canvas(*ipt[0])))
+                for x, y in ipt[1:]:
+                    inner.lineTo(QPointF(*to_canvas(x, y)))
+                inner.closeSubpath()
+                path.addPath(inner)
+            p.setBrush(QBrush(face_fill))
+            p.setPen(QPen(face_col, cut_width, Qt.SolidLine))
+            p.drawPath(path)
+        # draw inner contour outlines only (amber pen, no fill) for clarity
+        for ipt in inner_polys:
+            if not ipt:
+                continue
+            opath = QPainterPath(QPointF(*to_canvas(*ipt[0])))
+            for x, y in ipt[1:]:
+                opath.lineTo(QPointF(*to_canvas(x, y)))
+            opath.closeSubpath()
+            p.setBrush(Qt.NoBrush)
+            p.setPen(QPen(cut_col, cut_width))
+            p.drawPath(opath)
+
+        # holes -- CTO INJECTION 1 (Hole Grouping / Precision Metrology).
+        # Group by 0.5mm-bucketed Y and Diameter (true CNC float-noise
+        # tolerance per CTO approval): collinear holes on the same row share
+        # ONE modern label (e.g. 4xØ16) plus a slate hairline through the
+        # row, instead of N cluttered labels.
+        grouped_holes = defaultdict(list)
+        for h in holes:
+            key = (round(h.y / 0.5) * 0.5, round(h.diameter / 0.5) * 0.5)
+            grouped_holes[key].append(h)
+
+        for (y_key, d_key), group in grouped_holes.items():
+            group.sort(key=lambda h: h.x)
+            count = len(group)
+            if count > 1:
+                # glyphs first -- never lose a hole
+                for h in group:
+                    self._draw_hole(p, h, to_canvas, scale, bp, label=False)
+                # continuous hairline extending through all grouped holes
+                p.setPen(QPen(QColor('#64748B'), 0.5, Qt.DashLine))
+                p.drawLine(QPointF(*to_canvas(group[0].x, y_key)),
+                           QPointF(*to_canvas(group[-1].x, y_key)))
+                # single modern label above the center of the group
+                center_x = (group[0].x + group[-1].x) / 2.0
+                p.setFont(QFont('Segoe UI', 8, QFont.Bold))
+                p.setPen(QColor('#e67e22'))
+                p.drawText(QPointF(*to_canvas(center_x, y_key + d_key / 2.0 + 5)),
+                           f'{count}x\u00d8{d_key:g}')
+            else:
+                # normal single hole label
+                self._draw_hole(p, group[0], to_canvas, scale, bp, label=True)
+
+        # markings
+        for mk in markings:
+            sx, sy = to_canvas(mk.x, mk.y)
+            p.setPen(QPen(QColor(bp['miter']), 0.9))
+            p.setBrush(Qt.NoBrush)
+            p.drawRect(QRectF(sx - 2.5, sy - 2.5, 5, 5))
+            if mk.text:
+                p.setFont(QFont('Arial', 8))
+                p.drawText(QPointF(sx + 5, sy - 3), mk.text)
+
+    # ------------------------------------------------------------- unfold
+    def dstv_point_at(self, sx, sy, tol=1.0):
+        """DSTV (face, x, y) of a raw click in the blueprint viewport.
+
+        Iterates the visible face canvases (same source the design snaps
+        use). With a single face visible (single-face mode) the whole
+        widget is that face, so any click maps to it -- the 2D convention.
+        With several faces (ALL grid / unfold) the click must land inside
+        the face's screen region first: the canvas the user is actually
+        under, not just the first canvas whose affine inverse happens to
+        land inside its DSTV box (extrapolated band rows would otherwise
+        shadow each other). Returns None when the click misses every face
+        (padding between/around the canvases). The face code is the DSTV
+        letter used by ``FaceCoordinateSystem`` -- exactly what an added
+        hole record stores.
+        """
+        canvases = list(self._snap_canvases())
+        if not canvases:
+            return None
+        if len(canvases) == 1:
+            code, _face, _scale, _tc, fc = canvases[0]
+            x, y = fc(sx, sy)
+            return code, float(x), float(y)
+        for code, face, _scale, tc, fc in canvases:
+            bx0, by0, bx1, by1 = self._face_box(face)
+            p1 = tc(bx0, by0)
+            p2 = tc(bx1, by1)
+            sx0 = min(p1[0], p2[0]) - 2.0
+            sx1 = max(p1[0], p2[0]) + 2.0
+            sy0 = min(p1[1], p2[1]) - 2.0
+            sy1 = max(p1[1], p2[1]) + 2.0
+            if not (sx0 <= sx <= sx1 and sy0 <= sy <= sy1):
+                continue
+            x, y = fc(sx, sy)
+            outer = getattr(face, 'outer_contour', None)
+            if outer is None or not outer.vertices:
+                return code, float(x), float(y)
+            xs = [v.x for v in outer.vertices]
+            ys = [v.y for v in outer.vertices]
+            if (min(xs) - tol <= x <= max(xs) + tol and
+                    min(ys) - tol <= y <= max(ys) + tol):
+                return code, float(x), float(y)
+        return None
+
+    def _face_box(self, face):
+        """(x0, y0, x1, y1) bounding box of a face's outer contour in DSTV units."""
+        outer = face.outer_contour
+        if outer and outer.vertices:
+            xs = [v.x for v in outer.vertices]
+            ys = [v.y for v in outer.vertices]
+            return (min(xs), min(ys), max(xs), max(ys))
+        return (0.0, 0.0, 1.0, 1.0)
+
+    def _unfold_layout(self, part):
+        """Blueprint positions.
+
+        Returns ``(offsets, bounds)`` where ``offsets[code]`` is the
+        ``(tx, ty, flip_x)`` translation/flag that moves a face's local
+        coordinates into the shared unfolded scene, and ``bounds`` is the
+        scene ``(x0, y0, x1, y1)``.
+
+        Layout (Tekla-style profile development):
+            v  web face, anchored at the origin (its bottom-left corner);
+            o  top flange, above ``v``, its inner edge aligned with ``v``'s top;
+            u  bottom flange, below ``v``, its inner edge aligned with ``v``'s
+               bottom;
+            h  rear face, right of ``v`` with a distinct margin.
+
+        All faces of an I-section share the same beam-length X axis, so the
+        flanges are placed with no X shift: their end cuts line up with the
+        web's corner copes. ``flip_x`` is auto-detected (when a flange's cuts
+        only align after reversing its X axis) and defaults to no flip.
+        Faces missing from the part are skipped; if ``v`` is absent the
+        remaining faces are laid out in a simple horizontal row.
+        """
+        codes = [c for c in FaceCoordinateSystem.FACE_ORDER if c in part.faces]
+        boxes = {c: self._face_box(part.get_face(c)) for c in codes}
+        if not boxes:
+            return {}, (0.0, 0.0, 0.0, 0.0)
+        offsets = {}
+        # Absolute DSTV-unit gap between the unfolded plates (physical mm).
+        gap = 100.0
+
+        if 'v' in boxes:
+            vx0, vy0, vx1, vy1 = boxes['v']
+            h_v = vy1 - vy0
+            l_v = vx1 - vx0
+            gap = 100.0 # Absolute DSTV units
+
+            offsets['v'] = (-vx0, -vy0, False)
+            for code in ('o', 'u'):
+                if code not in boxes: continue
+                fx0, fy0, fx1, fy1 = boxes[code]
+                flip = self._needs_x_mirror(part, code, vx0, vx1)
+                tx = -vx0 if self._shares_x_axis(fx0, fx1, vx0, vx1) else -fx0
+
+                if code == 'o':
+                    offsets[code] = (tx, h_v - fy0 + gap, flip) # Top flange pushed up
+                else:
+                    offsets[code] = (tx, -fy1 - gap, flip) # Bottom flange pushed down
+
+            if 'h' in boxes:
+                hx0, hy0, _, _ = boxes['h']
+                offsets['h'] = (l_v + gap - hx0, -hy0, False)
+        else:
+            margin = gap
+            x = 0.0
+            for c in codes:
+                bx0, by0, bx1, by1 = boxes[c]
+                offsets[c] = (x - bx0, -by0, False)
+                x += (bx1 - bx0) + margin
+        x0 = min(offsets[c][0] + boxes[c][0] for c in offsets)
+        y0 = min(offsets[c][1] + boxes[c][1] for c in offsets)
+        x1 = max(offsets[c][0] + boxes[c][2] for c in offsets)
+        y1 = max(offsets[c][1] + boxes[c][3] for c in offsets)
+        return offsets, (x0, y0, x1, y1)
+    @staticmethod
+    def _shares_x_axis(fx0, fx1, vx0, vx1):
+        """True when a face's X span falls inside the web's beam-length axis."""
+        tol = 1e-3
+        return (fx1 >= vx0 - tol and fx0 <= vx1 + tol)
+
+    def _web_end_copes(self, web, top=True):
+        """X-intervals cut away at the web's top/bottom extreme edge (copes)."""
+        box = self._face_box(web)
+        x0, y0, x1, y1 = box
+        edge_y = y1 if top else y0
+        verts = [(v.x, v.y) for v in web.outer_contour.vertices]
+        edge_xs = [x for x, y in verts if abs(y - edge_y) < 1e-6]
+        if not edge_xs:
+            return []
+        ex0, ex1 = min(edge_xs), max(edge_xs)
+        copes = []
+        if ex0 > x0 + 1e-6:
+            copes.append((x0, ex0))
+        if ex1 < x1 - 1e-6:
+            copes.append((ex1, x1))
+        return copes
+
+    def _needs_x_mirror(self, part, face_code, vx0, vx1):
+        """Auto-detect whether a flange's X axis must be reversed so its end
+        cuts line up with the web's copes. Defaults to no mirror when the
+        geometry is symmetric or undecidable."""
+        web = part.get_face('v')
+        face = part.get_face(face_code)
+        if face is None or web is None:
+            return False
+        fx0, _, fx1, _ = self._face_box(face)
+        copes = self._web_end_copes(web, top=(face_code == 'o'))
+        if not copes:
+            return False
+        ends = (fx0, fx1)
+
+        def score(flipped):
+            pts = ((fx0 + fx1) - e if flipped else e for e in ends)
+            s = 0
+            for c in pts:
+                for cx0, cx1 in copes:
+                    if cx0 - 20.0 <= c <= cx1 + 20.0:
+                        s += 1
+                        break
+            return s
+
+            return score(True) > score(False)
+
+    def _paper_rect(self, widget_rect):
+        """STEP 3: virtual ISO paper sheet centred in the widget rect.
+
+        Returns a QRertF (widget space) that strictly respects the configured
+        paper format's aspect ratio (A4/A3/A2 -> width:height = 1:1.414,
+        landscape per the CTO mapping), with ``_paper_margin`` px of gap to the
+        widget edge. This is the "paper" the blueprint geometry and the
+        Fabrication Title Block now anchor to -- independent of widget shape.
+        """
+        pw, ph = self._paper_sizes.get(self._paper_format,
+                                       self._paper_sizes['A4'])
+        ar = pw / ph                     # landscape, > 1 (e.g. 297/210)
+        m = self._paper_margin
+        avail_w = max(float(widget_rect.width()) - 2 * m, 1.0)
+        avail_h = max(float(widget_rect.height()) - 2 * m, 1.0)
+        # fit the paper keeping its aspect ratio inside the available area
+        if avail_w / avail_h > ar:
+            h = avail_h
+            w = h * ar
+        else:
+            w = avail_w
+            h = w / ar
+        cx = float(widget_rect.center().x())
+        cy = float(widget_rect.center().y())
+        return QRectF(cx - w / 2.0, cy - h / 2.0, w, h)
+
+    def _unfold_fit(self, rect, bounds):
+        """(scale, ox, oy) so canvas maps scene pt (sx, sy) -> (ox+sx*scale,
+        oy-sy*scale) with the whole blueprint centred in rect."""
+        x0, y0, x1, y1 = bounds
+        w = max(x1 - x0, 1e-6)
+        h = max(y1 - y0, 1e-6)
+        pad_x = 40.0
+        pad_y = 50.0
+        scale = min(max(rect.width() - 2 * pad_x, 10) / w,
+                    max(rect.height() - 2 * pad_y, 10) / h) * self._zoom
+        scale = max(scale, 1e-9)
+        ox = rect.center().x() - (x0 + x1) / 2.0 * scale + self._pan[0]
+        oy = rect.center().y() + (y0 + y1) / 2.0 * scale + self._pan[1]
+        return scale, ox, oy
+
+    def _draw_local_grid(self, p, scale, x0, y0, x1, y1, color=None,
+                         x_map=None):
+        """Adaptive grid drawn in a face's local (unscaled painter) space.
+
+        ``x_map`` (optional) maps a real X to its display X so the grid
+        follows the foreshortened axis instead of the raw real one.
+        """
+        raw = 60.0 / max(scale, 1e-9)
+        step = next((s for s in self.GRID_STEPS if s >= raw), self.GRID_STEPS[-1])
+        if color is None:
+            color = QColor(30, 41, 59, 120)
+        else:
+            color = QColor(color)
+            color.setAlpha(120)
+        pen = QPen(color)
+        pen.setWidthF(1.0)
+        top = -y1 * scale
+        bottom = -y0 * scale
+        x = math.floor(x0 / step) * step
+        while x <= x1:
+            sx = (x_map(x) if x_map is not None else x) * scale
+            p.setPen(pen)
+            p.drawLine(QPointF(sx, top), QPointF(sx, bottom))
+            x += step
+        y = math.floor(y0 / step) * step
+        if x_map is not None:
+            gx0 = x_map(x0) * scale
+            gx1 = x_map(x1) * scale
+        else:
+            gx0, gx1 = x0 * scale, x1 * scale
+        while y <= y1:
+            sy = -y * scale
+            p.setPen(pen)
+            p.drawLine(QPointF(gx0, sy), QPointF(gx1, sy))
+            y += step
+
+    def render_unfolded(self, p, part=None, scale=None, offset_x=None,
+                        offset_y=None, rect=None):
+        """Draw the full profile unfolded as a single blueprint.
+
+        ``part`` defaults to the current part. When ``scale``/``offset_x``/
+        ``offset_y`` are omitted the layout is auto-fitted (with zoom/pan)
+        into ``rect`` (default: the widget rect). Each face is drawn under
+        ``painter.translate()`` inside ``save()``/``restore()`` so contours,
+        holes and cuts keep their DSTV coordinates.
+
+        With Smart Foreshortening active the beam-length X axis is pushed
+        through ``map_real_to_screen()`` (the long featureless middle voids
+        are compressed) and CAD break zig-zags are drawn at every cut void.
+        The auto-fit centres the compressed display envelope, so the detailed
+        ends stay legible and the break lines mark where the length was cut.
+        """
+        part = part or self._part
+        if part is None:
+            return
+        if rect is None:
+            rect = self.rect()
+        offsets, bounds, mapping = self._unfold_scene(part)
+
+        # OWNER ORDER (2026-09-01, Darija): remove the cartouche and the white
+        # ISO paper sheet from the interactive blueprint. The geometry now fits
+        # the full widget rect (no reserved 150px band, no white sheet, no
+        # cartouche drawn). The `_draw_title_block`/_draw_scene_cartouche`
+        # methods and the `_paper_rect` infra are RETAINED untouched for the
+        # future Paper/Print export path (not deleted -- only the interactive
+        # blueprint stops drawing them, per the owner's explicit request).
+        if None in (scale, offset_x, offset_y):
+            scale, offset_x, offset_y = self._unfold_fit(rect, bounds)
+        x0, y0, x1, y1 = bounds
+
+        # Bending/fold lines: the web 'v' is anchored at the origin, so its
+        # local bounding box is (0,0)-(L,H). Its bottom edge (scene Y=0) and
+        # top edge (scene Y=H) are the fold positions the flanges bend around.
+        if 'v' in offsets:
+            vb = self._face_box(part.get_face('v'))
+            L = vb[2] - vb[0]   # web length
+            H = vb[3] - vb[1]   # web height
+            if mapping is not None:
+                fx0 = offset_x + mapping.map_real_to_screen(0.0) * scale
+                fx1 = offset_x + mapping.map_real_to_screen(L) * scale
+            else:
+                fx0 = offset_x + 0.0 * scale
+                fx1 = offset_x + L * scale
+            fold_pen = QPen(QColor('#7f8c8d'), 1.0, Qt.DashLine)
+            for scene_y in (0.0, H):
+                sy = offset_y - scene_y * scale
+                p.setPen(fold_pen)
+                p.drawLine(QPointF(fx0, sy), QPointF(fx1, sy))
+
+        for code, (tx, ty, flip) in offsets.items():
+            face = part.get_face(code)
+            if face is None:
+                continue
+            bx0, by0, bx1, by1 = self._face_box(face)
+            on_axis = (mapping is not None
+                       and (tx + bx1 >= 0.0 and tx + bx0 <= mapping.total_length))
+            mapped_tx = None
+            if mapping is not None and not on_axis:
+                mapped_tx = mapping.map_real_to_screen(tx + bx0)
+            p.save()
+            p.translate(offset_x, offset_y - ty * scale)
+
+            def to_canvas(x, y):
+                if flip:
+                    x = (bx0 + bx1) - x
+                if mapping is not None and on_axis:
+                    sx = mapping.map_real_to_screen(tx + x)
+                elif mapping is not None:
+                    sx = mapped_tx + mapping.map_real_to_screen(x - bx0)
+                else:
+                    sx = tx + x
+                return sx * scale, -y * scale
+
+            # Folded View (plate): physically fold every mapped point through
+            # the part's KA bend lines (plan projection). Multi-bend plates
+            # fold sequentially in KA file order (see core/fold.py).
+            if (self._fold_state.get('fold') and code == 'v'
+                    and self._part_foldable(part)):
+                _base = to_canvas
+
+                def to_canvas(x, y):
+                    fx, fy = self._fold_pt(part, x, y)
+                    return _base(fx, fy)
+
+            if self._show_grid:
+                if mapping is not None and on_axis:
+                    gx_map = mapping.map_real_to_screen
+                elif mapping is not None:
+                    gx_map = (lambda x, _mt=mapped_tx, _bx0=bx0:
+                              _mt + mapping.map_real_to_screen(x - _bx0))
+                else:
+                    gx_map = None
+                self._draw_local_grid(
+                    p, scale, bx0, by0, bx1, by1, color=self._bp['grid'],
+                    x_map=gx_map)
+
+            # delineation band so each face reads as a distinct plate
+            c1 = to_canvas(bx0, by1)
+            c2 = to_canvas(bx1, by0)
+            rl = min(c1[0], c2[0])
+            rt = min(c1[1], c2[1])
+            p.setPen(QPen(QColor(self._bp['contour_dim']), 1.0))
+            p.setBrush(Qt.NoBrush)
+            p.drawRect(QRectF(rl, rt, abs(c2[0] - c1[0]), abs(c2[1] - c1[1])))
+
+            self._draw_face_geometry(p, face, to_canvas, scale, code, bp=self._bp)
+
+            # Folded View -- 'Show Folded Line': the DSTV KA bend lines dashed
+            # #e67e22 with their fold angle, on the web face (the only face a
+            # plate has). Points ON a bend line map through the fold unchanged
+            # (v == 0), so the line stays glued to the folded geometry too.
+            if (self._fold_state.get('show_line') and code == 'v'
+                    and getattr(part, 'bends', None)):
+                fold_pen = QPen(QColor('#e67e22'), 1.2, Qt.DashLine)
+                fold_pen.setDashPattern([6, 4])
+                p.setPen(fold_pen)
+                p.setFont(QFont('Arial', 7, QFont.Bold))
+                for b in part.bends:
+                    s1 = to_canvas(b.x1, b.y1)
+                    s2 = to_canvas(b.x2, b.y2)
+                    p.drawLine(QPointF(s1[0], s1[1]), QPointF(s2[0], s2[1]))
+                    if b.angle:
+                        mx, my = (s1[0] + s2[0]) / 2.0, (s1[1] + s2[1]) / 2.0
+                        p.setPen(QColor('#e67e22'))
+                        p.drawText(QPointF(mx + 4, my - 4),
+                                   f'{b.angle:g}\u00b0')
+                        p.setPen(fold_pen)
+
+            # STEP 2: auto-detected miter cut callouts on the web's (v) outer
+            # contour ends, drawn in the face's local space (respects Smart
+            # Foreshortening because `to_canvas` already maps through it).
+            if self._show_cut_angles and code == 'v':
+                self._draw_miter_angles(p, face, to_canvas)
+
+            # face title (global face-name mode: full / letters / hidden)
+            tl = to_canvas(bx0, by1)
+            title_text = self._face_title(code)
+            if title_text is not None:
+                p.setPen(QColor(self._bp['contour']))
+                p.setFont(QFont('Arial', 10, QFont.Bold))
+                p.drawText(QPointF(tl[0] + 4, tl[1] - 6), title_text)
+                if self._face_labels == 'letters':
+                    full = self.FACE_DESCR.get(code, code)
+                    tw = p.fontMetrics().horizontalAdvance(title_text)
+                    self._badge_rects.append(
+                        (QRectF(tl[0] + 2, tl[1] - 16, tw + 6, 14), full))
+            p.restore()
+
+        if mapping is not None:
+            self._draw_break_lines(p, scale, offset_x, offset_y, bounds,
+                                   mapping, offsets, part)
+
+        # bounds readout: always the TRUE physical extent, not the display one
+        if mapping is not None:
+            info = (f'X 0..{mapping.total_length:.0f}  '
+                    f'Y {y0:.0f}..{y1:.0f}  [foreshortened]')
+        else:
+            info = f'X {x0:.0f}..{x1:.0f}  Y {y0:.0f}..{y1:.0f}'
+        p.setPen(QColor(self._bp.get('text', '#2c3e50')))
+        p.setFont(QFont('Arial', 8))
+        p.drawText(QRectF(rect.left() + 6, rect.bottom() - 16,
+                          rect.width() - 12, 14), Qt.AlignLeft, info)
+
+        if self._auto_dims:
+            self._draw_auto_dims(p, part, scale, offset_x, offset_y,
+                                 bounds, mapping, offsets)
+
+        # OWNER ORDER (2026-09-01): no cartouche is drawn in the interactive
+        # blueprint (the paper-anchored `_draw_title_block` AND the S13 scene
+        # cartouche are both removed from the display). The methods themselves
+        # are retained below for the future Paper/Print export path.
+        # (previously: `if self._show_title_block: ...` dual-state dispatch)
+
+    # ------------------------------------------------------- STEP 1 / STEP 2
+    def _draw_title_block(self, p, rect):
+        """Tekla-style Fabrication Title Block (Plan de D\u00e9bit cartouche).
+
+        A tabular strip anchored to the bottom of the widget rect (widget
+        space, independent of the blueprint scene's zoom/pan). It reads the
+        part header fields verbatim and renders them in a strict grid of cells
+        (QPainter.drawRect) so it stands out against the dark workspace.
+
+        Header fields -> labels (French fabrication convention):
+            order_id        -> Affaire
+            position_mark   -> R\u00e9p\u00e8re
+            profile_name    -> Profil
+            length (mm)     -> Longueur
+            quantity        -> Quantit\u00e9
+            steel_grade     -> Qualit\u00e9
+        """
+        part = getattr(self, '_part', None)
+        if part is None:
+            return
+        hdr = getattr(part, 'header', None)
+
+        left = int(rect.left())
+        right = int(rect.right())
+        top = int(rect.bottom()) - 150
+        bottom = int(rect.bottom()) - 2
+
+        # title band across the very bottom (reserved strip)
+        strip = QRectF(left, bottom - 40, max(right - left, 0), 40)
+        p.fillRect(strip, QColor('#1b2631'))
+        p.setPen(QPen(QColor('#5d6d7e'), 1.0))
+        p.drawRect(strip)
+        p.setFont(QFont('Arial', 8))
+        p.setPen(QColor('#94a3b8'))
+        p.drawText(strip.adjusted(8, 6, -8, -6), Qt.AlignLeft | Qt.AlignVCenter,
+                   'PLAN DE D\u00c9BIT')
+
+        # guard: only draw the table when the strip fits in the widget height
+        if top < 0:
+            return
+
+        # two header rows of cells (label row + value row) per field column
+        fields = [
+            ('Affaire', _hdr(hdr, 'order_id')),
+            ('Pi\u00e8ce / R\u00e9p\u00e8re', _hdr(hdr, 'position_mark', 'PROFILE')),
+            ('Profil', _hdr(hdr, 'profile_name', 'PROFILE')),
+            ('Longueur (mm)', _mm(hdr)),
+            ('Quantit\u00e9', _hdr(hdr, 'quantity', 1)),
+            ('Qualit\u00e9', _hdr(hdr, 'steel_grade', 'S235JR')),
+        ]
+        ncol = len(fields)
+        pad = 6
+        label_h = 22
+        val_h = 24
+        table_top = bottom - 40 - label_h - val_h
+        table_h = label_h + val_h
+        gap = 4
+        usable = max((right - left) - 2 * pad, 1)
+        cell_w = usable / ncol
+
+        table = QColor(255, 255, 255)
+        p.setFont(QFont('Arial', 7))
+        for i, (label, value) in enumerate(fields):
+            cx = left + pad + i * cell_w
+            cell = QRectF(cx, table_top, cell_w, table_h)
+            p.setPen(QPen(QColor('#b0bec5'), 1.0))
+            p.setBrush(QBrush(table))
+            p.drawRect(cell)
+            label_r = QRectF(cx, table_top, cell_w, label_h)
+            p.setPen(QColor('#546e7a'))
+            p.setFont(QFont('Arial', 7))
+            p.drawText(label_r.adjusted(gap, 2, -gap, -2),
+                       Qt.AlignLeft | Qt.AlignVCenter, str(label))
+            val_r = QRectF(cx, table_top + label_h, cell_w, val_h)
+            p.setPen(QColor('#1b2631'))
+            p.setFont(QFont('Arial', 8, QFont.Bold))
+            p.drawText(val_r.adjusted(gap, 0, -gap, 0),
+                       Qt.AlignLeft | Qt.AlignVCenter, str(value))
+        # render the thin centre divider between label and value rows
+        p.setPen(QPen(QColor('#90a4ae'), 1.0))
+        p.drawLine(QPointF(left + pad, table_top + label_h),
+                   QPointF(right - pad, table_top + label_h))
+
+    # ------------------------------------------------- CTO INJECTION 2 (2026)
+    def _draw_scene_cartouche(self, p, part, bounds, mapping, scale,
+                              offset_x, offset_y):
+        """Dual-State 2026 Fabrication Cartouche, anchored in SCENE space.
+
+        In Blueprint View the cartouche lives inside the scene coordinate
+        system, attached to the BOTTOM of the physical beam's true bounding
+        box (50mm of virtual space below it), and is drawn under the same
+        world transform as the faces -- so it zooms and pans WITH the part.
+
+        Math (matches the face transform in ``render_unfolded``):
+            canvas = (offset_x + sx*scale, offset_y - sy*scale)   # Y flipped
+        ``p.translate(offset_x, offset_y - anchor_y*scale)`` then
+        ``p.scale(scale, scale)`` puts local (0,0) on the scene point
+        (0, anchor_y); local +y grows DOWNWARD (scene -y), so the table hangs
+        50mm below the beam and scales proportionally when the user zooms.
+
+        2026 aesthetic (CTO spec):
+            grid lines  QPen(#334155, 1.0)   (slate, not pure black)
+            headers    Segoe UI 8pt  #94A3B8
+            values     Segoe UI 10pt Bold  #F8FAFC
+            panel      #1e293b + cyan #008080 left accent (Piece Mark strip)
+        """
+        if part is None:
+            return
+        hdr = getattr(part, 'header', None)
+        x0, y0, x1, y1 = bounds
+        total_length = (mapping.total_length if mapping is not None
+                        else (x1 - x0))
+        if total_length <= 0:
+            total_length = 1.0
+
+        # anchor BELOW the beam's lower edge (bounds y0 = scene bottom)
+        anchor_scene_y = y0 - 50.0   # 50mm virtual space below the beam
+        table_h = 120.0              # virtual mm -> scales with the part
+        header_h = 34.0
+        accent = 6.0                 # cyan Piece-Mark strip width
+
+        cols = [
+            ('R\u00e9p\u00e8re', _hdr(hdr, 'position_mark', 'PROFILE'), 0.12),
+            ('Qt\u00e9', _hdr(hdr, 'quantity', 1), 0.08),
+            ('Nom', _nom_style(_hdr(hdr, 'profile_type', '')), 0.12),
+            ('Profil', _hdr(hdr, 'profile_name', 'PROFILE'), 0.18),
+            ('Longueur (mm)', _mm(hdr), 0.16),
+            ('Qualit\u00e9', _hdr(hdr, 'steel_grade', 'S235JR'), 0.18),
+            ('Poids U', _poids_u_text(part), 0.16),
+        ]
+
+        p.save()
+        # THE SECRET TO ZOOMING WITH THE PART: same transform as the faces
+        p.translate(offset_x, offset_y - anchor_scene_y * scale)
+        p.scale(scale, scale)
+
+        # dark 2026 panel + slate grid
+        p.setBrush(QBrush(QColor('#1e293b')))
+        p.setPen(QPen(QColor('#334155'), 1.0))
+        p.drawRect(QRectF(0.0, 0.0, total_length, table_h))
+        p.fillRect(QRectF(0.0, 0.0, accent, table_h), QColor('#008080'))
+
+        x = accent
+        for label, value, frac in cols:
+            w = total_length * frac
+            p.setPen(QPen(QColor('#334155'), 1.0))
+            p.drawLine(QPointF(x, 0.0), QPointF(x, table_h))
+            header_r = QRectF(x + 6, 0.0, w - 12, header_h)
+            p.setFont(QFont('Segoe UI', 8))
+            p.setPen(QColor('#94A3B8'))
+            p.drawText(header_r, Qt.AlignLeft | Qt.AlignVCenter, str(label))
+            val_r = QRectF(x + 6, header_h, w - 12, table_h - header_h)
+            p.setFont(QFont('Segoe UI', 10, QFont.Bold))
+            p.setPen(QColor('#F8FAFC'))
+            p.drawText(val_r, Qt.AlignLeft | Qt.AlignVCenter, str(value))
+            x += w
+
+        # header/value divider + closing right edge
+        p.setPen(QPen(QColor('#334155'), 1.0))
+        p.drawLine(QPointF(accent, header_h), QPointF(total_length, header_h))
+        p.drawLine(QPointF(total_length, 0.0), QPointF(total_length, table_h))
+        p.restore()
+
+    def _draw_miter_angles(self, p, face, to_canvas):
+        """STEP 2: Auto-detect non-90\u00b0 end cuts (coupes biaises / miter cuts)
+        on the web face's (v) outer contour and draw a small angle arc + text.
+
+        The web's outer contour is treated as a closed ring. Each consecutive
+        vertex pair that spans (nearly) the full web height is an END run
+        (the vertical member end); if that run is not perfectly vertical the
+        deviation from the Y axis (in degrees) is reported and a callout arc +
+        \"<angle>\u00b0\" is drawn at that end's top corner, clipped inside the web
+        boundary.
+
+        The angle is computed in the part's local DSTV frame with
+        ``math.degrees(math.atan2(dx, dy))`` (0\u00b0 = perfectly vertical cut).
+        """
+        outer = getattr(face, 'outer_contour', None)
+        if outer is None or not getattr(outer, 'vertices', None):
+            return
+        verts = outer.vertices
+        n = len(verts)
+        if n < 2:
+            return
+        xs = [v.x for v in verts]
+        ys = [v.y for v in verts]
+        y0, y1 = min(ys), max(ys)
+        span = max(y1 - y0, 1e-9)
+
+        def end_run(pair):
+            """True when a consecutive vertex pair is an end run (spans the
+            web height) rather than a top/bottom horizontal edge."""
+            (ax, ay), (bx, by) = pair
+            return abs(ay - by) >= 0.9 * span
+
+        def angle_of(pair):
+            (ax, ay), (bx, by) = pair
+            dx = ax - bx
+            dy = ay - by
+            if abs(dy) < 1e-6:
+                return None
+            # deviation-from-vertical magnitude, direction-agnostic: use the
+            # absolute deltas so an upward or downward traversal of the same
+            # end run reports the same acute angle (0 deg = vertical cut).
+            return math.degrees(math.atan2(abs(dx), abs(dy)))
+
+        for i in range(n):
+            a = verts[i]
+            b = verts[(i + 1) % n]  # closed ring (wraps last -> first)
+            pair = ((a.x, a.y), (b.x, b.y))
+            if not end_run(pair):
+                continue
+            ang = angle_of(pair)
+            if ang is None or abs(ang) < 0.1:
+                continue  # perfectly vertical, no miter
+            # anchor the callout at the top corner of this end
+            top_v = b if b.y > a.y else a
+            cx, cy = to_canvas(top_v.x, top_v.y)
+            r = 12.0
+            p.setPen(QPen(QColor('#e67e22'), 1.4))
+            p.setBrush(Qt.NoBrush)
+            p.setFont(QFont('Arial', 8, QFont.Bold))
+            p.drawArc(QRectF(cx - r, cy - r, 2 * r, 2 * r), 0 * 16, 90 * 16)
+            label = f'{abs(ang):.1f}\u00b0'
+            p.setPen(QColor('#e67e22'))
+            p.drawText(QPointF(cx + 6, cy - 6), label)
+            # punch reference: a short witness line from the corner end
+            p.setPen(QPen(QColor('#f39c12'), 1.0))
+            p.drawLine(QPointF(cx, cy),
+                       QPointF(cx + r * 1.6, cy - r * 1.6))
+
+    def _draw_auto_dims(self, p, part, scale, offset_x, offset_y, bounds,
+                        mapping, offsets):
+        """Draw the automatic dimension columns (Phase C).
+
+        X chain: every hole/slot feature position on the web ``v`` (and the
+        flange ``o`` when the web is empty), the interior corners of the web
+        contour, and the total length L -- laid out on a dimension line under
+        the web. H column: the profile height on the right of the web. Values
+        always use the TRUE physical coordinates (foreshortening is remapped
+        back to real mm before text is written).
+        """
+        if 'v' not in offsets:
+            return
+        vb = self._face_box(part.get_face('v'))
+        L = vb[2] - vb[0]
+        H = vb[3] - vb[1]
+        line_col = QColor(self._mp.get('measure_line', '#2980b9'))
+        label_col = QColor(self._mp.get('measure_label', '#e67e22'))
+        paper = QColor(self._bp.get('paper', '#ffffff'))
+
+        x_lab = []
+        y_vals = [H]
+
+        def real_to_canvas(x):
+            if mapping is not None:
+                sx = offset_x + mapping.map_real_to_screen(x) * scale
+            else:
+                sx = offset_x + x * scale
+            return sx
+
+        # feature X positions from the web and the top flange
+        def face_feature_x(face):
+            xs = []
+            for h in (face.holes or []):
+                xs.append(float(getattr(h, 'x', 0.0)))
+            for m in (face.markings or []):
+                xs.append(float(getattr(m, 'x', 0.0)))
+            for cont in ([face.outer_contour] if face.outer_contour else []) \
+                    + list(face.inner_contours or []):
+                for pt in cont.points:
+                    xs.append(float(pt[0]))
+            return xs
+
+        for code in ('v', 'o'):
+            face = part.get_face(code)
+            if face is None:
+                continue
+            x_lab.extend(face_feature_x(face))
+        if not x_lab:
+            x_lab = [0.0, L]
+        x_lab = sorted(set(round(x, 1) for x in x_lab if 0.0 <= x <= L))
+        x_lab.append(L)
+
+        # horizontal chain under the web
+        dim_y = offset_y - 0.0 * scale + 18
+        pen = QPen(line_col, 1.0, Qt.SolidLine)
+        p.setPen(pen)
+        p.drawLine(QPointF(offset_x, dim_y),
+                   QPointF(real_to_canvas(L), dim_y))
+        p.setBrush(paper)
+        p.setFont(QFont('Arial', 7))
+        p.setBackgroundMode(Qt.OpaqueMode)
+        p.setBackground(QBrush(paper))
+        for x in x_lab:
+            sx = real_to_canvas(x)
+            self._dim_arrows(p, QPointF(sx, dim_y), 4, line_col,
+                             along=(-1.0, 0.0))
+            p.setPen(label_col)
+            p.drawText(QRectF(sx - 30, dim_y + 3, 60, 12), Qt.AlignCenter,
+                       f'{x:.0f}')
+        # total length on a second line
+        ly = dim_y + 16
+        p.setPen(pen)
+        p.drawLine(QPointF(offset_x, ly), QPointF(real_to_canvas(L), ly))
+        self._dim_arrows(p, QPointF(offset_x, ly), 4, line_col,
+                         along=(1.0, 0.0))
+        self._dim_arrows(p, QPointF(real_to_canvas(L), ly), 4, line_col,
+                         along=(-1.0, 0.0))
+        p.setPen(label_col)
+        p.drawText(QRectF(offset_x, ly + 3, real_to_canvas(L) - offset_x, 12),
+                   Qt.AlignCenter, f'L = {L:.0f}')
+
+        # vertical H column on the right of the web
+        hx = real_to_canvas(L) + 24
+        p.setPen(pen)
+        p.drawLine(QPointF(hx, offset_y), QPointF(hx, offset_y - H * scale))
+        self._dim_arrows(p, QPointF(hx, offset_y), 4, line_col,
+                         along=(0.0, -1.0))
+        self._dim_arrows(p, QPointF(hx, offset_y - H * scale), 4, line_col,
+                         along=(0.0, 1.0))
+        p.setPen(label_col)
+        p.drawText(QRectF(hx + 3, offset_y - H * scale, 80, 12),
+                   Qt.AlignLeft, f'H = {H:.0f}')
+        p.setBackgroundMode(Qt.TransparentMode)
+
+    @staticmethod
+    def _dim_arrows(p, pt, size, color, along=(1.0, 0.0)):
+        """AutoCAD-style dimension arrow: a solid filled arrowhead pointing
+        along the dimension axis ``along`` (inwards for the end of a dim line).
+
+        The tick drawings are replaced by taper-arrowheads so the dimension
+        line reads like a professional sheet-metal/steel drawing.
+        """
+        import math as _math
+        ang = _math.atan2(along[1], along[0])
+        cos_a, sin_a = _math.cos(ang), _math.sin(ang)
+        x, y = pt.x(), pt.y()
+        # tip at the point, tail one ``size`` behind along ``along``; the two
+        # barbs splay at 24 degrees off the tail direction
+        base = (x - size * cos_a, y - size * sin_a)
+        splay = 0.45
+        p.setPen(QPen(color, 0.2))
+        p.setBrush(QBrush(color))
+        t = QPolygonF([
+            QPointF(x, y),
+            QPointF(base[0] - size * splay * sin_a,
+                    base[1] + size * splay * cos_a),
+            QPointF(base[0] + size * splay * sin_a,
+                    base[1] - size * splay * cos_a),
+        ])
+        p.drawPolygon(t)
+        p.setBrush(Qt.NoBrush)
+
+    def _draw_break_lines(self, p, scale, offset_x, offset_y, bounds, mapping,
+                          offsets, part):
+        col = QColor(self._bp.get('break', '#95a5a6'))
+        pen = QPen(col, 1.6, Qt.SolidLine, Qt.RoundCap)
+        for code, (tx, ty, _flip) in offsets.items():
+            face = part.get_face(code)
+            if face is None:
+                continue
+            bx0, by0, bx1, by1 = self._face_box(face)
+            # Local face screen bounds
+            y_top = offset_y - (ty + by1) * scale
+            y_bot = offset_y - (ty + by0) * scale
+
+            p.save()
+            # CRITICAL: Clip strictly to this face's geometric band + 5px bleed
+            p.setClipRect(QRectF(0, y_top - 5, 99999, (y_bot - y_top) + 10))
+
+            for m in mapping.break_marks():
+                cx = offset_x + (m['sx0'] + m['sx1']) / 2.0 * scale
+                p.setPen(pen)
+                p.drawPolyline(self._zigzag_points(cx, y_top - 20, y_bot + 20, 6.0))
+            p.restore()
+
+    @staticmethod
+    def _zigzag_points(cx, y_top, y_bot, amp):
+        pts = [QPointF(cx, y_top)]
+        step = 14.0
+        y = y_top
+        left = True
+        while y < y_bot:
+            y = min(y + step, y_bot)
+            x = cx - amp if left else cx + amp
+            pts.append(QPointF(x, y))
+            left = not left
+        pts.append(QPointF(cx, y_bot))
+        return pts
+
+    def _draw_grid(self, p, rect, scale, ox, oy):
+        # adaptive step: ~60 px spacing in scene units
+        raw = 60.0 / max(scale, 1e-9)
+        step = next((s for s in self.GRID_STEPS if s >= raw), self.GRID_STEPS[-1])
+        pen = QPen(QColor(30, 41, 59, 120))
+        pen.setWidthF(1.0)
+        # x lines in DSTV coords
+        x = 0.0
+        while x * scale + ox < rect.right():
+            sx = x * scale + ox
+            if sx >= rect.left():
+                p.setPen(pen)
+                p.drawLine(QPointF(sx, rect.top()), QPointF(sx, rect.bottom()))
+            x += step
+        x = -step
+        while x * scale + ox > rect.left():
+            sx = x * scale + ox
+            if sx <= rect.right():
+                p.setPen(pen)
+                p.drawLine(QPointF(sx, rect.top()), QPointF(sx, rect.bottom()))
+            x -= step
+        y = 0.0
+        while rect.bottom() - y * scale > rect.top():
+            sy = rect.bottom() - y * scale
+            if sy >= rect.top():
+                p.setPen(pen)
+                p.drawLine(QPointF(rect.left(), sy), QPointF(rect.right(), sy))
+            y += step
+
+    def _build_slot_path(self, cx, cy, diameter, slot_length, angle_deg, scale):
+        """
+        Max-Level CAD implementation (explicit B-Rep).
+        Constructs a slot strictly using explicit arcs and tangent lines.
+        This ensures future Nesting collision-detection algorithms can parse
+        the exact geometry.
+
+        ``slot_length`` is the OVERALL slot length (the NC centre-to-centre
+        straight part PLUS one diameter), so the straight part between the two
+        drill centres is ``slot_length - diameter``, and the two semicircular
+        end caps add exactly one ``diameter`` to the overall extent. Real DSTV
+        slots (e.g. ``d=22``, NC ``L=18``) therefore pass ``L + d = 40`` and
+        produce a stadium of exactly ``40 x 22`` mm.
+        """
+        from PySide6.QtGui import QPainterPath, QTransform
+
+        path = QPainterPath()
+
+        r = (diameter / 2.0) * scale
+        # The straight part between the two drill centers
+        straight_len = max(0, (slot_length - diameter) * scale)
+        half_straight = straight_len / 2.0
+
+        # Start at top tangent of the left semicircle
+        path.moveTo(-half_straight, -r)
+
+        # Top straight line
+        path.lineTo(half_straight, -r)
+
+        # Right semicircle (sweep 180 degrees from 90 to -90)
+        path.arcTo(half_straight - r, -r, r * 2, r * 2, 90, -180)
+
+        # Bottom straight line
+        path.lineTo(-half_straight, r)
+
+        # Left semicircle (sweep 180 degrees from 270 to 90)
+        path.arcTo(-half_straight - r, -r, r * 2, r * 2, 270, -180)
+
+        path.closeSubpath()
+
+        # Apply True Spatial Transformation
+        transform = QTransform()
+        transform.translate(cx, cy)
+        transform.rotate(-angle_deg)  # Account for inverted Canvas Y
+
+        return transform.map(path)
+
+    def _draw_hole(self, p, hole, to_canvas, scale, bp=None, label=True):
+        """Draw one hole glyph (circle/slot + crosshair) and, when ``label`` is
+        True, its diameter annotation. Grouped holes are rendered with
+        ``label=False`` so the row draws a single ``NxØD`` callout instead."""
+        sx, sy = to_canvas(hole.x, hole.y)
+        bp = bp or self._bp
+        hole_col = QColor(bp['hole'])
+        slot_col = QColor(bp['cut'])
+        if hole.is_slot:
+            overall = hole.slot_length + hole.diameter
+            path = self._build_slot_path(sx, sy, hole.diameter,
+                                         overall,
+                                         hole.angle or 0.0, scale)
+            p.fillPath(path, QBrush(QColor(self._bp['bg'])))
+            # SLOTS MUST BE RED IN 2D
+            p.strokePath(path, QPen(QColor('#ef4444'), 1.0))
+
+            # SINGLE CENTER AXIS
+            r_cross = max(hole.diameter / 2.0 * scale, 3.0)
+            p.setPen(QPen(QColor('#ef4444'), 0.9))
+            p.drawLine(QPointF(sx - r_cross, sy), QPointF(sx + r_cross, sy))
+            p.drawLine(QPointF(sx, sy - r_cross), QPointF(sx, sy + r_cross))
+            # the NC length token is centre-to-centre; the physical cut length
+            # is overall = length + diameter (e.g. 22+18 -> a 40 x 22 stadium)
+            if hole.diameter > 0 and overall > 0:
+                if label:
+                    p.setFont(QFont('Arial', 8))
+                    p.drawText(QPointF(sx + r_cross + 3, sy - 3),
+                               f'\u00d8{hole.diameter:g}\u00d7{overall:g}')
+        else:
+            r = max(hole.diameter / 2.0 * scale, 3.0)
+            p.setPen(QPen(hole_col, sp(1)))
+            p.setBrush(QBrush(hole_col))
+            p.drawEllipse(QPointF(sx, sy), r, r)
+            # crosshair
+            p.setPen(QPen(hole_col, 0.9))
+            p.drawLine(QPointF(sx - r, sy), QPointF(sx + r, sy))
+            p.drawLine(QPointF(sx, sy - r), QPointF(sx, sy + r))
+            if hole.diameter > 0:
+                if label:
+                    p.setFont(QFont('Arial', 8))
+                    p.drawText(QPointF(sx + r + 3, sy - 3),
+                               f'\u00d8{hole.diameter:g}')
+
+    # ---------------------------------------------------------------- measure
+    def _face_canvas(self):
+        """(face, rect, scale, ox, oy) for the single-face view or None in ALL."""
+        if self._all_mode() or self._unfold:
+            return None
+        face = self._part.get_face(self._face)
+        if face is None:
+            return None
+        rect = self.rect()
+        scale, ox, oy = self._auto_scale(face, rect, self._zoom, self._pan)
+        return face, rect, scale, ox, oy
+
+    def _scene_pt(self, sx, sy):
+        cv = self._face_canvas()
+        if cv is None:
+            return None
+        _, rect, scale, ox, oy = cv
+        x = (sx - ox) / scale
+        y = (rect.bottom() - sy) / scale
+        return x, y
+
+    def _snap_canvases(self):
+        """[(code, face, scale, to_canvas, from_canvas)] for visible faces.
+
+        Works in single-face, ALL-grid and unfold/blueprint modes so the same
+        design snap engine applies everywhere the geometry is drawn.
+        """
+        out = []
+        if self._part is None:
+            return out
+        codes = [c for c in FaceCoordinateSystem.FACE_ORDER
+                 if c in self._part.faces]
+        if not codes:
+            return out
+        if self._unfold:
+            offsets, bounds, mapping = self._unfold_scene(self._part)
+            rect = self.rect()
+            scale, ox, oy = self._unfold_fit(rect, bounds)
+            for code, (tx, ty, flip) in offsets.items():
+                face = self._part.get_face(code)
+                if face is None:
+                    continue
+                bx0, by0, bx1, by1 = self._face_box(face)
+                base_x = ox
+                base_y = oy - ty * scale
+                xflip = (bx0 + bx1) if flip else 0.0
+                on_axis = (mapping is not None
+                           and (tx + bx1 >= 0.0 and tx + bx0 <= mapping.total_length))
+                mapped_tx = None
+                if mapping is not None and not on_axis:
+                    mapped_tx = mapping.map_real_to_screen(tx + bx0)
+
+                def to_canvas(x, y, bax=base_x, bay=base_y, sc=scale, xf=xflip,
+                              mp=mapping, ax=on_axis, txx=tx, mt=mapped_tx,
+                              bx0=bx0):
+                    if xf:
+                        x = xf - x
+                    if mp is not None and ax:
+                        sx = mp.map_real_to_screen(txx + x)
+                    elif mp is not None:
+                        sx = mt + mp.map_real_to_screen(x - bx0)
+                    else:
+                        sx = txx + x
+                    return bax + sx * sc, bay - y * sc
+
+                def from_canvas(sx, sy, bax=base_x, bay=base_y, sc=scale,
+                                xf=xflip, mp=mapping, ax=on_axis, txx=tx,
+                                mt=mapped_tx, bx0=bx0):
+                    dsx = (sx - bax) / sc
+                    if mp is not None and ax:
+                        rx = mp.map_screen_to_real(dsx)
+                        x = rx - txx
+                    elif mp is not None:
+                        x = bx0 + mp.map_screen_to_real(dsx - mt)
+                    else:
+                        x = dsx - txx
+                    if xf:
+                        x = xf - x
+                    return x, (bay - sy) / sc
+
+                out.append((code, face, scale, to_canvas, from_canvas))
+        elif self._all_mode():
+            margin, header, gap = 8.0, 22.0, 8.0
+            avail_w = max(self.width() - 2 * margin, 10.0)
+            avail_h = max(self.height() - 2 * margin, 10.0)
+            bands = []
+            for code in codes:
+                span = self._face_span(self._part.get_face(code))
+                bands.append(max(avail_w * span[1] / max(span[0], 1e-9), 46.0))
+            total = sum(bands) + gap * (len(bands) - 1) + header * len(bands)
+            k = min(1.0, avail_h / max(total, 1e-9))
+            y = margin
+            for i, code in enumerate(codes):
+                face = self._part.get_face(code)
+                if face is None:
+                    continue
+                bh = bands[i] * k
+                rect = QRectF(margin, y, avail_w, bh + header)
+                scale, ox, oy = self._auto_scale(
+                    face, rect, self._band_zoom.get(code, 1.0),
+                    self._band_pan.get(code, (0.0, 0.0)))
+
+                def to_canvas(x, y, ox=ox, oy=oy, sc=scale, r=rect):
+                    return ox + x * sc, r.bottom() - y * sc
+
+                def from_canvas(sx, sy, ox=ox, oy=oy, sc=scale, r=rect):
+                    return (sx - ox) / sc, (r.bottom() - sy) / sc
+
+                out.append((code, face, scale, to_canvas, from_canvas))
+                y += bh + header + gap
+        else:
+            face = self._part.get_face(self._face)
+            if face is None:
+                return out
+            rect = self.rect()
+            scale, ox, oy = self._auto_scale(face, rect, self._zoom, self._pan)
+
+            def to_canvas(x, y, ox=ox, oy=oy, sc=scale, r=rect):
+                return ox + x * sc, r.bottom() - y * sc
+
+            def from_canvas(sx, sy, ox=ox, oy=oy, sc=scale, r=rect):
+                return (sx - ox) / sc, (r.bottom() - sy) / sc
+
+            out.append((self._face, face, scale, to_canvas, from_canvas))
+        return out
+
+    def _snap_detail(self, pos):
+        """(face_code, scene_pt, kind, diameter_or_None) via the design engine.
+
+        Snap targets are built from each visible face's contour and holes in
+        widget-pixel space, resolved with the shared engine, and the winning
+        point is mapped back to the face's DSTV coordinates. Slots expose their
+        true B-Rep rim (two tangent walls + two semicircular caps) so nearest /
+        tangent / intersection snap exactly onto the drawn stadium.
+        """
+        enabled, tol = self.snap_config()
+        exact_band = self._design.snap_exact_band() if self._design else 0.0
+        best, best_d, kind, dia = None, None, None, None
+        for code, face, scale, tc, fc in self._snap_canvases():
+            pts = []
+            segs = []
+            circles = []
+            arcs = []
+            outer = face.outer_contour
+            verts = ([(v.x, v.y) for v in outer.vertices]
+                     if outer and outer.vertices else [])
+            n = len(verts)
+            for i in range(n):
+                x, y = verts[i]
+                x2, y2 = verts[(i + 1) % n]
+                p1 = tc(x, y)
+                p2 = tc(x2, y2)
+                pts.append(p1)
+                segs.append((p1, p2))
+            for hole in face.holes:
+                hsx, hsy = tc(hole.x, hole.y)
+                r = max(hole.diameter / 2.0 * scale, 1e-9)
+                if getattr(hole, 'is_slot', False):
+                    overall = (hole.slot_length or 0.0) + hole.diameter
+                    cx, cy = hsx, hsy
+                    cs = scale
+                    ssegs, s_arcs = stadium_rim(
+                        cx, cy, hole.diameter * cs, overall * cs,
+                        getattr(hole, 'angle', 0.0))
+                    segs.extend(ssegs)
+                    arcs.extend(s_arcs)
+                    circles.append((hsx, hsy, max(r * 0.25, 1e-9)))
+                else:
+                    circles.append((hsx, hsy, r))
+                    arcs.append((hsx, hsy, r, 0.0, 360.0))
+            targets = SnapTargets(points=pts, segments=segs, circles=circles,
+                                  arcs=arcs)
+            res = resolve_snap(targets, (pos.x(), pos.y()),
+                               enabled=enabled, tol=tol, exact_band=exact_band)
+            if not res:
+                continue
+            spt, k, d = res
+            prio = SNAP_PRIORITY.get(k, 99)
+            if (best_d is None or d < best_d - 1e-9
+                    or (abs(d - best_d) <= 1e-9 and
+                        prio < SNAP_PRIORITY.get(kind, 99))):
+                best_d = d
+                best_code = code
+                best = fc(*spt)
+                kind = k
+                dia = None
+                if k == 'centre':
+                    bd = None
+                    for hole in face.holes:
+                        hsx, hsy = tc(hole.x, hole.y)
+                        hd = math.hypot(hsx - spt[0], hsy - spt[1])
+                        if bd is None or hd < bd:
+                            bd = hd
+                            dia = hole.diameter if not hole.is_slot else None
+        if best is None:
+            return None, None, None, None
+        return best_code, best, kind, dia
+
+    def hole_at(self, pos):
+        """Blueprint hit-test: nearest hole/slot centre on any visible face.
+
+        Returns ``(face_code, x, y, d, is_slot, slot_length, angle)`` in DSTV
+        coordinates for the closest hole under the cursor (slots use a capsule
+        radius that respects their overall length), or None. The app maps the
+        result back to its edited-hole index by face + coordinates.
+        """
+        best, best_d = None, None
+        for code, face, scale, tc, fc in self._snap_canvases():
+            for hole in (face.holes or []):
+                hsx, hsy = tc(hole.x, hole.y)
+                r = max(hole.diameter / 2.0 * scale, 1e-9)
+                if getattr(hole, 'is_slot', False):
+                    overall = (getattr(hole, 'slot_length', 0.0) or 0.0) \
+                        + hole.diameter
+                    hit_r = max((overall / 2.0) * scale, r) + 3
+                else:
+                    hit_r = r + 3
+                d = math.hypot(hsx - pos.x(), hsy - pos.y())
+                if d <= max(hit_r, 6) and (best_d is None or d < best_d):
+                    best_d = d
+                    best = (code, hole.x, hole.y, hole.diameter,
+                            bool(getattr(hole, 'is_slot', False)),
+                            getattr(hole, 'slot_length', 0.0) or 0.0,
+                            getattr(hole, 'angle', 0.0) or 0.0)
+        return best
+
+    def _draw_measure(self, p):
+        c1 = QColor(self._bp['measure_line']) if self._unfold \
+            else QColor(self._mp['line'])
+        c2 = QColor(self._bp['measure_label']) if self._unfold \
+            else QColor(self._mp['label_text'])
+        canvas = {code: tc for code, _f, _s, tc, _fc in self._snap_canvases()}
+        if not canvas:
+            return
+        if self.show_ortho() and self._cursor_pos:
+            r = self.rect()
+            gx, gy = self._cursor_pos
+            p.setPen(QPen(QColor(self._bp['contour']), 1.0,
+                          Qt.DashLine, Qt.RoundCap))
+            p.drawLine(QPointF(r.left(), gy), QPointF(r.right(), gy))
+            p.drawLine(QPointF(gx, r.top()), QPointF(gx, r.bottom()))
+        for a, bpt, dim_off in self._measurements:
+            self._draw_one_measure(p, a, bpt, canvas, c1, c2, dim_off)
+        for a, vertex, b, ang in self._corner_measures:
+            self._draw_corner_measure(p, a, vertex, b, ang, canvas, c1, c2)
+        if self._corner_mode and self._corner_pts:
+            p.setPen(QPen(c1, 1.1, Qt.DashLine, Qt.RoundCap))
+            p.setBrush(QBrush(c1))
+            for pt in self._corner_pts:
+                tc = canvas.get(pt[0])
+                if tc is not None:
+                    p.drawEllipse(QPointF(*tc(*pt[1:])), 3, 3)
+            if len(self._corner_pts) == 2 and self._hover_pt is not None:
+                tc1 = canvas.get(self._corner_pts[0][0])
+                tc2 = canvas.get(self._hover_pt[0])
+                if tc1 is not None and tc2 is not None:
+                    s1 = tc1(*self._corner_pts[0][1:])
+                    s2 = tc2(*self._hover_pt[1:])
+                    p.drawLine(QPointF(*s1), QPointF(*s2))
+        # Live hover: the OSNAP glyph is drawn at the snapped point on every
+        # mouse move, whether or not a first measure point has been placed.
+        s2 = None
+        if self._hover_pt is not None:
+            tc2 = canvas.get(self._hover_pt[0])
+            if tc2 is not None:
+                s2 = tc2(*self._hover_pt[1:])
+                self._snap_badge(p, QPointF(*s2), self._hover_kind)
+        if self._m1 is None:
+            return
+        tc1 = canvas.get(self._m1[0])
+        if tc1 is None:
+            return
+        s1 = tc1(*self._m1[1:3])
+        p.setPen(QPen(c1, 1.3, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(QBrush(c1))
+        p.drawEllipse(QPointF(*s1), 4, 4)
+        if s2 is not None:
+            # AutoCAD-style polar tracking: when no object snap is active and
+            # both points live on the same face, lock the preview onto the
+            # nearest configured polar ray instead of the raw cursor.
+            s2p = s2
+            if (self._hover_kind is None and self._hover_pt[0] == self._m1[0]
+                    and self._design is not None
+                    and self._design.polar_enabled()):
+                res = polar_snap((s1.x(), s1.y()), (s2.x(), s2.y()),
+                                 self._design.polar_angle(),
+                                 self._design.polar_tol())
+                if res is not None:
+                    s2p = QPointF(*res[0])
+            dashed = self._m1[3] in ('intersection', 'centre')
+            p.setPen(QPen(c1, 1.1,
+                          Qt.DashLine if dashed else Qt.SolidLine,
+                          Qt.RoundCap))
+            p.setBrush(Qt.NoBrush)
+            p.drawLine(QPointF(*s1), QPointF(*s2p))
+            self._arrow(p, QLineF(QPointF(*s1), QPointF(*s2p)), c1)
+
+    def _halo_text(self, p, rect, label, color):
+        """Draw a label with a stencil halo (no frame hiding the view).
+
+        The text is drawn four times in the paper colour around the final
+        position, then once in the label colour -- the CAD-standard readable
+        text over a line without any box.
+        """
+        p.setFont(QFont('Arial', max(6, round(9 * self.dim_scale())),
+                        QFont.Bold))
+        halo = QColor(self._bp.get('paper', '#f8fafc'))
+        p.setPen(halo)
+        for hx, hy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            p.drawText(rect.translated(hx, hy), Qt.AlignCenter, label)
+        p.setPen(color)
+        p.drawText(rect, Qt.AlignCenter, label)
+
+    def _draw_measure_label(self, p, label, anchor, c2, ds=1.0):
+        """2026 measure label: dynamic metrics box WITHOUT any background.
+
+        The label is rendered at the line midpoint with a stencil halo so it
+        stays readable over the dimension line but never hides the drawing
+        behind a panel (owner rule: no frame covering the view).
+        """
+        font = QFont('Arial', max(6, round(9 * ds)), QFont.Bold)
+        p.setFont(font)
+        fm = p.fontMetrics()
+        text_w = fm.horizontalAdvance(label)
+        text_h = fm.height()
+
+        # Dynamic Box with Padding (hit zone only, no fill)
+        padding_x, padding_y = 12, 6
+        rect = QRectF(anchor.x() - text_w / 2 - padding_x,
+                      anchor.y() - text_h / 2 - padding_y,
+                      text_w + padding_x * 2, text_h + padding_y * 2)
+        # keep the dynamic label fully on-screen (no text clipping)
+        if rect.right() > self.width() - 2:
+            rect.moveLeft(max(2.0, anchor.x() - rect.width() - 14))
+        if rect.left() < 2.0:
+            rect.moveLeft(2.0)
+        if rect.bottom() > self.height() - 2:
+            rect.moveBottom(self.height() - 2)
+
+        self._halo_text(p, rect, label, c2)
+
+    def _draw_one_measure(self, p, a, bpt, canvas, c1, c2, dim_off=0.0):
+        tc = canvas.get(a[0])
+        if tc is None:
+            return
+        s1 = QPointF(*tc(*a[1:3]))
+        s2 = QPointF(*tc(*bpt[1:3]))
+        ln = math.hypot(s2.x() - s1.x(), s2.y() - s1.y())
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2.y() - s1.y()) / ln, (s2.x() - s1.x()) / ln)
+        shift = perp * dim_off
+        p1, p2 = s1 + shift, s2 + shift
+        dashed = a[3] in ('intersection', 'centre') or \
+            bpt[3] in ('intersection', 'centre')
+        if abs(dim_off) > 1e-6:
+            # long extension (witness) lines: show exactly which two points
+            # this dimension belongs to (AutoCAD/Tekla style)
+            p.setPen(QPen(c1, 0.7, Qt.SolidLine, Qt.RoundCap))
+            p.drawLine(s1, p1)
+            p.drawLine(s2, p2)
+        line = QLineF(p1, p2)
+        p.setPen(QPen(c1, 1.3,
+                      Qt.DashLine if dashed else Qt.SolidLine,
+                      Qt.RoundCap))
+        p.setBrush(QBrush(c1))
+        p.drawLine(line)
+        self._arrow(p, line, c1)
+        p.setBrush(QBrush(c2))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(s2, 3, 3)
+        p.setBrush(QBrush(c1))
+        p.drawEllipse(s1, 3, 3)
+        dist = math.hypot(bpt[1] - a[1], bpt[2] - a[2])
+        dx = bpt[1] - a[1]
+        dy = bpt[2] - a[2]
+        ang = abs(math.degrees(math.atan2(dy, dx)) % 180.0)
+        label = f'{dist:.1f} mm  \u2220{angle_label(ang)}  [{angle_verdict(ang)}]'
+        ds = self.dim_scale()
+        # label anchored at the LINE MIDPOINT (owner rule), no frame
+        mid = QPointF((p1.x() + p2.x()) / 2, (p1.y() + p2.y()) / 2)
+        self._draw_measure_label(p, label, mid, c2, ds)
+
+    def _draw_corner_measure(self, p, a, vertex, b, ang, canvas, c1, c2):
+        tc = canvas.get(a[0])
+        tcv = canvas.get(vertex[0])
+        tcb = canvas.get(b[0])
+        if tc is None or tcv is None or tcb is None:
+            return
+        s1 = tc(*a[1:])
+        sv = tcv(*vertex[1:])
+        s2 = tcb(*b[1:])
+        p.setPen(QPen(c1, 1.3, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(Qt.NoBrush)
+        p.drawLine(QPointF(*sv), QPointF(*s1))
+        p.drawLine(QPointF(*sv), QPointF(*s2))
+        p.setBrush(QBrush(c1))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(QPointF(*sv), 4, 4)
+        p.drawEllipse(QPointF(*s1), 3, 3)
+        p.drawEllipse(QPointF(*s2), 3, 3)
+        label = corner_label(ang)
+        ds = self.dim_scale()
+        self._draw_measure_label(p, label, QPointF(*sv), c2, ds)
+
+    def _snap_badge(self, p, pos, kind):
+        """Draw the OSNAP marker for a hovered snap point.
+
+        The marker colour and overall scale come from the design settings
+        (``snap_badge_color`` / ``snap_badge_size``); the glyph geometry
+        (box/triangle/cross/ring) comes from the single shared CAD glyph
+        renderer so all viewers agree pixel-for-pixel.
+        """
+        from nccorrection.design.glyphs import draw_snap_glyph
+        from nccorrection.design.theme import snap_label
+        scale = self._design.snap_badge_size() if self._design else 1.0
+        color = QColor(self._design.snap_badge_color()
+                       if self._design else '#3cb371')
+        draw_snap_glyph(p, pos, kind, color, scale)
+        x, y = pos.x(), pos.y()
+        r = 6.0 * scale
+        p.setFont(QFont('Arial', max(7, round(8 * scale)), QFont.Bold))
+        p.setPen(color)
+        p.drawText(QPointF(x + r * 1.6, y + r * 2.0), snap_label(kind))
+
+    def _arrow(self, p, line, color):
+        ang = math.atan2(-(line.y2() - line.y1()), line.x2() - line.x1())
+        a = math.radians(20)
+        l = 9.0
+        for x, y, direction in ((line.x1(), line.y1(), 1), (line.x2(), line.y2(), -1)):
+            p.setBrush(QBrush(color))
+            p.setPen(Qt.NoPen)
+            poly = QPolygonF([
+                QPointF(x, y),
+                QPointF(x - direction * l * math.cos(ang + a),
+                        y + direction * l * math.sin(ang + a)),
+                QPointF(x - direction * l * math.cos(ang - a),
+                        y + direction * l * math.sin(ang - a)),
+            ])
+            p.drawPolygon(poly)
+
+    # ---------------------------------------------------------------- events
+    def _band_at(self, pos):
+        """Return the face code whose band contains the position (ALL mode)."""
+        for code, rect in self._band_rects.items():
+            if rect.contains(pos):
+                return code
+        return None
+
+    def wheelEvent(self, event):
+        # AutoCAD-style adaptive zoom: coarse while zoomed out, fine when deep.
+        ref_z = self._band_zoom.get(self._band_at(event.position()),
+                                    0.0) if self._all_mode() else self._zoom
+        if ref_z < 8.0:
+            step = 0.12
+        elif ref_z < 40.0:
+            step = 0.06
+        else:
+            step = 0.02
+        factor = 1.0 + step if event.angleDelta().y() > 0 else 1.0 - step
+        pos = event.position()
+        code = self._band_at(event.position()) if self._all_mode() else None
+        if code is not None:
+            # Zoom-to-cursor inside one ALL-grid band (its own zoom/pan state).
+            rect = self._band_rects.get(code)
+            face = self._part.get_face(code) if self._part else None
+            if rect is not None and face is not None:
+                pan0 = self._band_pan.get(code, (0.0, 0.0))
+                scale0, ox0, oy0 = self._auto_scale(
+                    face, rect, self._band_zoom.get(code, 1.0), pan0)
+                # real scene coords BEFORE zoom
+                rx = (pos.x() - ox0) / max(scale0, 1e-9)
+                ry = (rect.bottom() - pos.y()) / max(scale0, 1e-9)
+                z1 = max(0.02, min(self._band_zoom.get(code, 1.0) * factor, 200.0))
+                self._band_zoom[code] = z1
+                scale1, ox1, oy1 = self._auto_scale(face, rect, z1, pan0)
+                # screen coords of the same scene point after zoom
+                sx = ox1 + rx * scale1
+                sy = rect.bottom() - ry * scale1
+                self._band_pan[code] = (pan0[0] - (sx - pos.x()),
+                                        pan0[1] - (sy - pos.y()))
+            else:
+                self._band_zoom[code] = max(0.02, min(
+                    self._band_zoom.get(code, 1.0) * factor, 200.0))
+        elif self._unfold and self._part is not None:
+            # Blueprint mode: keep the real scene point under the cursor pinned.
+            rect = self.rect()
+            offsets, bounds, _map = self._unfold_scene(self._part)
+            scale0, ox0, oy0 = self._unfold_fit(rect, bounds)
+            rx = (pos.x() - ox0) / max(scale0, 1e-9)
+            ry = (oy0 - pos.y()) / max(scale0, 1e-9)
+            self._zoom = max(0.02, min(self._zoom * factor, 200.0))
+            scale1, ox1, oy1 = self._unfold_fit(rect, bounds)
+            sx = ox1 + rx * scale1
+            sy = oy1 - ry * scale1
+            self._pan = (self._pan[0] - (sx - pos.x()),
+                         self._pan[1] - (sy - pos.y()))
+        else:
+            # Single-face / default: anchor to the scene point under the cursor.
+            cv = self._face_canvas()
+            if cv is not None:
+                face, rect, scale0, ox0, oy0 = cv
+                rx = (pos.x() - ox0) / max(scale0, 1e-9)
+                ry = (rect.bottom() - pos.y()) / max(scale0, 1e-9)
+                self._zoom = max(0.02, min(self._zoom * factor, 200.0))
+                scale1, ox1, oy1 = self._auto_scale(face, rect, self._zoom,
+                                                    self._pan)
+                sx = ox1 + rx * scale1
+                sy = rect.bottom() - ry * scale1
+                self._pan = (self._pan[0] - (sx - pos.x()),
+                             self._pan[1] - (sy - pos.y()))
+            else:
+                self._zoom = max(0.02, min(self._zoom * factor, 200.0))
+        self.update()
+        event.accept()
+
+    def mousePressEvent(self, event):
+        if self.mode == 'measure':
+            if event.button() == Qt.RightButton:
+                # FIRST right-click interrupts the measurement in progress
+                # (no menu). A second right-click (nothing pending) falls
+                # through to the app's full context menu: Refresh on top
+                # (delete all measurements + exit measure) + all the other
+                # settings.
+                if self._m1 is not None or self._corner_pts:
+                    self._measure_cancel()
+                    return
+            if event.button() == Qt.LeftButton:
+                # press ON an existing dimension line -> parallel drag
+                # (Tekla/AutoCAD style: keeps points + value, long extension
+                # lines appear during the drag)
+                hit = self._measure_line_at(event.position())
+                if hit is not None:
+                    self._dim_drag = hit
+                    self._drag_pos = event.position()
+                    return
+                code, pt, kind, dia = self._snap_detail(event.position())
+                if pt is None:
+                    return
+                if self._corner_mode:
+                    self._corner_pts.append((code, pt[0], pt[1]))
+                    if len(self._corner_pts) == 3:
+                        a, vertex, b = self._corner_pts
+                        ang = corner_angle((a[1], a[2]), (vertex[1], vertex[2]),
+                                           (b[1], b[2]))
+                        self._corner_measures.append((a, vertex, b, ang))
+                        self.measure_result.emit(corner_label(ang))
+                        self._corner_pts = []
+                    self.update()
+                    return
+                if self._m1 is None:
+                    self._m1 = (code, pt[0], pt[1], kind)
+                else:
+                    self._m2 = (code, pt[0], pt[1], kind)
+                    self._measurements.append((self._m1, self._m2, 0.0))
+                    self._m1 = None
+                    self._m2 = None
+                self.update()
+                return
+        if event.button() == Qt.MiddleButton:
+            self._dragging = True
+            self._drag_pos = event.position()
+            self._drag_band = self._band_at(event.position()) if self._all_mode() else None
+            self.setCursor(Qt.ClosedHandCursor)
+        super().mousePressEvent(event)
+
+    def mouseMoveEvent(self, event):
+        self._cursor_pos = (event.position().x(), event.position().y())
+        if self._dim_drag is not None and self._drag_pos is not None:
+            # parallel move: only the perpendicular component of the cursor
+            # delta is applied to the dimension line (Tekla/AutoCAD style)
+            d = event.position() - self._drag_pos
+            self._drag_pos = event.position()
+            i = self._dim_drag
+            a, bpt, dim_off = self._measurements[i]
+            g = self._measure_line_geometry(i)
+            if g is not None:
+                perp = g[4]
+                self._measurements[i] = (
+                    a, bpt, dim_off + d.x() * perp.x() + d.y() * perp.y())
+            self.update()
+        if self.mode == 'measure':
+            code, pt, kind, dia = self._snap_detail(event.position())
+            self._hover_pt = (code, pt[0], pt[1]) if pt is not None else None
+            self._hover_kind = kind
+            self.update()
+        else:
+            # face-name tooltip (letters mode): hovering the title shows the
+            # full blueprint face name
+            from PySide6.QtWidgets import QToolTip
+            if self._badge_rects:
+                for rect, full in self._badge_rects:
+                    if rect.contains(event.position()):
+                        QToolTip.showText(self.mapToGlobal(
+                            event.position().toPoint()), full, self)
+                        break
+                else:
+                    QToolTip.hideText()
+            else:
+                QToolTip.hideText()
+        if self._dragging and self._drag_pos is not None:
+            d = event.position() - self._drag_pos
+            self._drag_pos = event.position()
+            if self._drag_band is not None:
+                px, py = self._band_pan.get(self._drag_band, (0.0, 0.0))
+                self._band_pan[self._drag_band] = (px + d.x(), py + d.y())
+            else:
+                self._pan = (self._pan[0] + d.x(), self._pan[1] + d.y())
+            self.update()
+        super().mouseMoveEvent(event)
+
+    def mouseReleaseEvent(self, event):
+        if event.button() == Qt.LeftButton:
+            self._dim_drag = None
+        if event.button() == Qt.MiddleButton:
+            self._dragging = False
+            self._drag_pos = None
+            self._drag_band = None
+            self.setCursor(Qt.ArrowCursor)
+        super().mouseReleaseEvent(event)
