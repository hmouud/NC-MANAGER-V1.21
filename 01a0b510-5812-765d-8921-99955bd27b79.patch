+        fb.mode = 'measure'
+        fb._cursor_pos = (400.0, 300.0)
+        img = fb.grab().toImage().convertToFormat(QImage.Format_RGB32)
+        on = self._cyan_along(img, 400)
+        ds.set_show_ortho(False)
+        img = fb.grab().toImage().convertToFormat(QImage.Format_RGB32)
+        off = self._cyan_along(img, 400)
+        self.assertGreater(on, off)  # the guide adds cyan pixels
+
+    @staticmethod
+    def _cyan_along(img, x):
+        """Count blue-steel guide/contour pixels on a column.
+
+        The guide (a thin anti-aliased dash of ``#2980b9``) blends with the
+        near-white paper into a pale pastel blue whose green channel sits
+        roughly level with its blue. The solid contours are the deep
+        ``#2980b9``. Both keep blue noticeably above red; the light-grey metal
+        faces (``#bdc3c7`` / ``#a7b1b8``) and white paper have blue ~ red, so a
+        ``blue > red + 40`` probe is specific to the guide/contour ink and
+        ignores the metal faces it crosses.
+        """
+        n = 0
+        for y in range(img.height()):
+            c = img.pixelColor(x, y)
+            if c.blue() > c.red() + 40:
+                n += 1
+        return n
