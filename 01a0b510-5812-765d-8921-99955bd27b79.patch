@@ -0,0 +1,55 @@
+import os
+
+MANDATORY_ICONS = ['artsbuilderexecute.png', 'folder-cyan-open.png', 'help-browser-2.png']
+
+
+class ResourceService:
+    def __init__(self):
+        self._base_dir = self._find_base_dir()
+        self._icons = {}
+
+    def _find_base_dir(self):
+        d = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
+        rsc = os.path.join(d, 'rsc')
+        if os.path.isdir(rsc):
+            return d
+        return os.getcwd()
+
+    def validate_icons(self):
+        missing = []
+        for name in MANDATORY_ICONS:
+            if not self.icon_exists(name):
+                missing.append(name)
+        return missing
+
+    def icon_path(self, name):
+        """Resolve an icon, preferring the vector (.svg) twin when present."""
+        try:
+            from nccorrection.ui.components.svg_icon import resolve_icon
+        except Exception:
+            resolve_icon = None
+        if resolve_icon is not None:
+            path = resolve_icon(name)
+            if path:
+                return path
+        return os.path.join(self._base_dir, 'rsc', 'icons', name)
+
+    def icon_exists(self, name):
+        return os.path.isfile(self.icon_path(name))
+
+    def load_icon(self, name):
+        path = self.icon_path(name)
+        if os.path.isfile(path):
+            return path
+        return None
+
+    def all_icons_valid(self):
+        return len(self.validate_icons()) == 0
+
+    @property
+    def base_dir(self):
+        return self._base_dir
+
+    @property
+    def icons_dir(self):
+        return os.path.join(self._base_dir, 'rsc', 'icons')
