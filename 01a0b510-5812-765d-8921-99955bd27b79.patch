+"""High-level hole/slot edit model shared by the UI.
+
+A part is edited through three parallel structures, all keyed by the hash of
+the NC1 file:
+
+* ``overrides`` : ``{orig_index: {x, y, d, face, length, angle}}``  changes
+* ``deleted``   : iterable of ``orig_index`` removed
+* ``added``     : list of hole dicts appended (assigned negative indices)
+
+``apply_edits`` merges them into a viewable geometry (so both viewers render
+the live result) and reports the mapping from display order back to original
+hole indices.
+"""
+
+from nccorrection.core.viewer import apply_hole_overrides
+
+
+def apply_edits(geometry, overrides=None, deleted=(), added=()):
+    """Return ``(geometry', active_indices)``.
+
+    ``geometry'`` is a copy of ``geometry`` with modifications applied, deleted
+    holes removed and new holes appended, so the 2D/3D viewers can render it.
+    ``active_indices[i]`` is the original hole index shown at row ``i`` (or a
+    negative marker for an added hole).
+    """
+    geo = dict(geometry)
+    if overrides:
+        geo = apply_hole_overrides(geo, overrides)
+    holes = list(geo.get('holes', []))
+    circles = list(geo.get('circles', []))
+    slots = list(geo.get('slots', []))
+    deleted = set(deleted)
+
+    kept_holes = []
+    kept_circles = []
+    kept_slots = []
+    active = []
+    ci = si = 0
+    for i, h in enumerate(holes):
+        if h['kind'] == 'hole':
+            circ = circles[ci] if ci < len(circles) else None
+            ci += 1
+            if i in deleted:
+                continue
+            kept_holes.append(h)
+            if circ is not None:
+                kept_circles.append(circ)
+        else:
+            slot = slots[si] if si < len(slots) else None
+            si += 1
+            if i in deleted:
+                continue
+            kept_holes.append(h)
+            if slot is not None:
+                kept_slots.append(slot)
+        active.append(i)
+
+    n = -1
+    for h in added:
+        nh = dict(h)
+        nh.setdefault('kind', 'slot' if h.get('length') else 'hole')
+        kept_holes.append(nh)
+        if nh['kind'] == 'slot':
+            kept_slots.append((nh.get('x', 0.0), nh.get('y', 0.0),
+                               nh.get('x', 0.0), nh.get('y', 0.0),
+                               nh.get('d', 10.0), nh.get('length', 0.0),
+                               nh.get('angle', 0.0)))
+        else:
+            kept_circles.append((nh.get('x', 0.0), nh.get('y', 0.0),
+                                 nh.get('d', 10.0)))
+        active.append(n)
+        n -= 1
+
+    geo['holes'] = kept_holes
+    geo['circles'] = kept_circles
+    geo['slots'] = kept_slots
+    return geo, active
+
+
+def row_index(active, row):
+    """Return the original hole index for a table row."""
+    if 0 <= row < len(active):
+        return active[row]
+    return None
