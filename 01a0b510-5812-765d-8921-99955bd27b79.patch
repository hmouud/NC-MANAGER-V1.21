+"""Painting mixin for NcViewer3D — facets, holes, axes, measure, legend, etc."""
+
+import math
+import sys
+
+from PySide6.QtCore import Qt, QPointF, QRectF, QLineF
+from PySide6.QtGui import (QPainter, QColor, QPen, QBrush, QFont,
+                           QFontMetrics, QPolygonF)
+
+from nccorrection.ui._colors import C
+from nccorrection.design.measure import (corner_label, angle_label,
+                                         angle_verdict)
+
+
+def _cross(a, b):
+    return (a[1] * b[2] - a[2] * b[1],
+            a[2] * b[0] - a[0] * b[2],
+            a[0] * b[1] - a[1] * b[0])
+
+
+def _norm(v):
+    l = math.sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]) or 1e-12
+    return (v[0] / l, v[1] / l, v[2] / l)
+
+
+def _mapply(R, p):
+    return (R[0][0] * p[0] + R[0][1] * p[1] + R[0][2] * p[2],
+            R[1][0] * p[0] + R[1][1] * p[1] + R[1][2] * p[2],
+            R[2][0] * p[0] + R[2][1] * p[1] + R[2][2] * p[2])
+
+
+class _Viewer3DPaintMixin:
+    """Mixin that holds all painting/drawing methods for NcViewer3D.
+
+    This is a plain class (NOT QWidget).  All methods access ``self`` which
+    is the actual :class:`NcViewer3D` instance at runtime.
+    """
+
+    @staticmethod
+    def _hole_position_suffix(geometry, idx):
+        """DSTV face position suffix ('  X=..  Y=..') for the hovered hole,
+        matching the web viewer's hover readout. Empty when the hole record
+        is missing or incomplete."""
+        try:
+            h = geometry['holes'][idx]
+            return f"  X={h['x']:g}  Y={h['y']:g}"
+        except (KeyError, IndexError, TypeError):
+            return ''
+
+    # ---------------------------------------------------------------- face labels
+    def _face_label_points(self):
+        """World-space anchor of every face-name badge.
+
+        Contours from ``contour_meta`` (the same source as the 2D faces
+        layout): for prism profiles the contour Y IS the section coordinate
+        (extrusion along X), so the face centre is (x_mean, 0, y_mean); for
+        plate profiles the contour extrudes along Z and the centre is
+        (x_mean, y_mean, thickness).
+        """
+        from nccorrection.core.part3d import profile_kind
+        if not self._geometry:
+            return []
+        st = self._geometry.get('st') or {}
+        prism = profile_kind((st.get('type') or 'B').upper()) == 'prism'
+        thickness = float(st.get('thickness') or 10.0)
+        out = []
+        for meta in self._geometry.get('contour_meta', []):
+            face = (meta.get('face') or '').lower()
+            pts = meta.get('pts') or []
+            if not face or len(pts) < 2:
+                continue
+            xs = [p[0] for p in pts]
+            ys = [p[1] for p in pts]
+            cx = sum(xs) / len(xs)
+            cy = sum(ys) / len(ys)
+            if prism:
+                out.append((face, (cx, 0.0, cy)))
+            else:
+                out.append((face, (cx, cy, thickness)))
+        return out
+
+    def _draw_face_labels(self, p):
+        from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+        self._badge_pts = []
+        if self._face_labels == 'off':
+            return
+        for face, pt3 in self._face_label_points():
+            sx, sy = self._project(pt3)
+            if self._face_labels == 'letters':
+                label = face.upper()
+            else:
+                label = DstvRenderer2D.FACE_DESCR.get(face, face)
+            p.setFont(QFont('Arial', 8, QFont.Bold))
+            fm = QFontMetrics(QFont('Arial', 8, QFont.Bold))
+            tw = fm.horizontalAdvance(label) + 8
+            rect = QRectF(sx - tw / 2, sy - 8, tw, 14)
+            p.setPen(QColor(15, 23, 42, 200))
+            for hx, hy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                p.drawText(rect.translated(hx, hy), Qt.AlignCenter, label)
+            p.setPen(QColor(C.txt))
+            p.drawText(rect, Qt.AlignCenter, label)
+            self._badge_pts.append(((sx, sy), face.upper(), label))
+
+    # ---------------------------------------------------------------- paint
+    def _paint_impl(self, event):
+        """Core paint logic -- called from NcViewer3D.paintEvent.
+
+        PySide6 C++ trampolines only dispatch virtual methods found in the
+        immediate class dict, so paintEvent must live on NcViewer3D itself.
+        This method holds the actual implementation so the painting code
+        stays in the mixin file.
+        """
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), self._bg)
+        if not self._model:
+            p.setPen(QColor(C.mut))
+            p.setFont(QFont('Arial', 10))
+            p.drawText(self.rect(), Qt.AlignCenter, 'No geometry to display')
+            p.end()
+            return
+
+        b = self._bounds
+        w = max(b[2] - b[0], 1e-6)
+        h = max(b[3] - b[1], 1e-6)
+        d = max(self._zmax - self._zmin, 1e-6)
+        ext = max(w, h, d)
+        avail = min(max(self.width() - 70, 10), max(self.height() - 70, 10))
+        self._scale = avail / ext
+        self._ox = self.width() / 2.0
+        self._oy = self.height() / 2.0
+
+        self._draw_axes(p)
+        self._draw_facets(p)
+        self._draw_cut_markers(p)
+        self._draw_holes(p)
+        self._draw_pivot(p)
+        self._draw_face_labels(p)
+        self._draw_measure(p)
+        self._draw_cotation(p)
+        if self._legend:
+            self._draw_legend(p)
+        self._draw_hint(p)
+        p.end()
+
+    def _shade(self, base, normal):
+        light = _norm((0.35, 0.6, 0.72))
+        d = max(0.0, normal[0] * light[0] + normal[1] * light[1] + normal[2] * light[2])
+        fill = 0.16 * max(0.0, -(normal[0] * light[0] + normal[1] * light[1] + normal[2] * light[2]))
+        d = min(1.0, 0.30 + 0.70 * d + fill)
+        r = min(255, int(base[0] * d))
+        g = min(255, int(base[1] * d))
+        bl = min(255, int(base[2] * d))
+        return QColor(r, g, bl)
+
+    def _draw_facets(self, p):
+        R = self._R
+        drawn = []
+        section = self._section
+        axis = self._section_axis % 3
+        for fac in self._model:
+            zsum = 0.0
+            for pt in fac['pts']:
+                zsum += _mapply(R, pt)[2]
+            drawn.append((zsum / len(fac['pts']), fac))
+        if section:
+            cmin = min(d[0] for d in drawn)
+            cmax = max(d[0] for d in drawn)
+            cut = (cmin + cmax) / 2.0
+            drawn = [d for d in drawn if d[0] >= cut]
+        drawn.sort(key=lambda t: t[0], reverse=True)
+        if self._wireframe:
+            for _, fac in drawn:
+                poly = QPolygonF([QPointF(*self._project(pp)) for pp in fac['pts']])
+                if fac.get('is_hole') or fac.get('is_hole_wall'):
+                    p.setPen(QPen(QColor(C.hole), 0.9))
+                    p.setBrush(Qt.NoBrush)
+                else:
+                    col = self._shade(fac['color'], fac['normal'])
+                    p.setPen(QPen(col.lighter(140), 0.9))
+                    p.setBrush(Qt.NoBrush)
+                p.drawPolygon(poly)
+            return
+        for _, fac in drawn:
+            poly = QPolygonF([QPointF(*self._project(pp)) for pp in fac['pts']])
+            if fac.get('is_hole') or fac.get('is_hole_wall'):
+                c = QColor(C.hole)
+                c.setAlpha(190)
+                p.setPen(QPen(c, 0.9))
+                p.setBrush(QBrush(QColor(24, 28, 38)))
+            else:
+                col = self._shade(fac['color'], fac['normal'])
+                p.setPen(Qt.NoPen)
+                p.setBrush(QBrush(col))
+            p.drawPolygon(poly)
+
+    def _draw_holes(self, p):
+        hovered = self._hovered_hole
+        R = self._R
+        for c, n, r, idx in self._hole_refs:
+            # Backface culling: holes on hidden faces turned away from view must not show
+            n_rot = _mapply(R, n)
+            if n_rot[2] <= 0.02:
+                continue
+
+            sx, sy = self._project(c)
+            if sx < -40 or sy < -40 or sx > self.width() + 40 or sy > self.height() + 40:
+                continue
+            # Smooth proportional scaling on zoom out without artificial ballooning
+            rr = max(r * self._scale * self._zoom, 0.75)
+            active = (hovered == idx)
+            col = QColor(C.slot) if active else QColor(C.hole)
+            slot = self._slot_rims.get(idx)
+            if slot is not None:
+                pts = [self._project(pt) for pt in slot]
+            else:
+                nseg = max(8, min(64, int(6.0 + rr * 2.0)))
+                pts = [self._project(self._rim_point(c, n, r, a))
+                       for a in (i * math.pi * 2.0 / nseg for i in range(nseg))]
+            poly = QPolygonF([QPointF(*pt) for pt in pts])
+            p.setPen(QPen(col, 1.3 if active else 1.2))
+            p.setBrush(QBrush(QColor(0, 0, 0, 70) if not active else QColor(251, 191, 36, 60)))
+            p.drawPolygon(poly)
+            if slot is not None:
+                cr = max(rr * 0.42, 1.5)
+                p.setPen(QPen(col, 1.3 if active else 1.0))
+                p.drawLine(QPointF(sx - cr, sy), QPointF(sx + cr, sy))
+                p.drawLine(QPointF(sx, sy - cr), QPointF(sx, sy + cr))
+            if active:
+                p.setPen(QPen(col, 1.4))
+                p.drawLine(QPointF(sx - rr + 2, sy), QPointF(sx + rr - 2, sy))
+                p.drawLine(QPointF(sx, sy - rr + 2), QPointF(sx, sy + rr - 2))
+            if slot is not None:
+                try:
+                    h = self._geometry['holes'][idx]
+                    overall = h["d"] + (h.get("length") or 0.0)
+                    label = f'\u00d8{h["d"]:g} \u00d7 {overall:g} mm'
+                except (KeyError, IndexError, TypeError):
+                    label = f'\u00d8{2 * r:g} mm'
+            else:
+                label = f'\u00d8{2 * r:g} mm'
+            if active:
+                label += self._hole_position_suffix(self._geometry, idx)
+                p.setFont(QFont('Arial', 9, QFont.Bold))
+                p.setPen(QColor('#fde047'))
+                fm = p.fontMetrics()
+                tx = min(sx + rr + 6, max(2, self.width() - fm.horizontalAdvance(label) - 4))
+                p.drawText(QPointF(tx, sy - rr - 4), label)
+            else:
+                p.setFont(QFont('Arial', 8))
+                p.setPen(QColor('#fb7185'))
+                p.drawText(QPointF(sx + rr + 4, sy - rr - 3), label)
+
+    @staticmethod
+    def _rim_point(c, n, r, a):
+        """Point on the hole rim: center + r*(cos a * u + sin a * v), with
+        (u, v) an orthonormal basis perpendicular to the hole normal."""
+        ax = abs(n[0])
+        axv = (1.0, 0.0, 0.0) if ax < 0.9 else (0.0, 1.0, 0.0)
+        u = _norm(_cross(n, axv))
+        v = _cross(n, u)
+        ca, sa = math.cos(a), math.sin(a)
+        return (c[0] + r * (ca * u[0] + sa * v[0]),
+                c[1] + r * (ca * u[1] + sa * v[1]),
+                c[2] + r * (ca * u[2] + sa * v[2]))
+
+    def _axis_triad(self):
+        """Screen-space directions of the WORLD axes under the current
+        rotation, as ``{'X': (dx, dy), 'Y': ..., 'Z': ...}``."""
+        out = {}
+        R = self._R
+        for name, vec in (('X', (1.0, 0.0, 0.0)),
+                          ('Y', (0.0, 1.0, 0.0)),
+                          ('Z', (0.0, 0.0, 1.0))):
+            v = _mapply(R, vec)
+            out[name] = (v[0], -v[1])
+        return out
+
+    def _draw_axes(self, p):
+        cx, cy = 30.0, self.height() - 46.0
+        L, arr = 26.0, 6.0
+        self._axes_base = (cx, cy)
+        for name, col in (('X', '#ef4444'), ('Y', '#22c55e'),
+                          ('Z', '#38bdf8')):
+            ux, uy = self._axis_triad()[name]
+            dx, dy = ux * L, uy * L
+            tip = QPointF(cx + dx, cy + dy)
+            p.setPen(QPen(QColor(col), 1.2))
+            p.drawLine(QPointF(cx, cy), tip)
+            ang = math.atan2(-(dy), dx)
+            a = math.radians(18)
+            for sa in (a, -a):
+                p.drawLine(tip,
+                           QPointF(tip.x() - arr * math.cos(ang + sa),
+                                   tip.y() + arr * math.sin(ang + sa)))
+            p.setPen(QColor(col))
+            p.setFont(QFont('Arial', 8, QFont.Bold))
+            p.drawText(QPointF(tip.x() + 2, tip.y() - 2), name)
+
+    def _part_screen_box(self):
+        """Bounding box (screen px) of the whole part model."""
+        xs, ys = [], []
+        for fac in self._model:
+            for pt in fac['pts']:
+                sx, sy = self._project(pt)
+                xs.append(sx)
+                ys.append(sy)
+        if not xs:
+            return (0.0, 0.0, float(self.width()), float(self.height()))
+        return (min(xs), min(ys), max(xs), max(ys))
+
+    def _draw_cotation(self, p):
+        if not self._cotation or not self._hole_refs:
+            return
+        refs = [(self._project(c), idx)
+                for c, _n, _r, idx in self._hole_refs if idx is not None]
+        if len(refs) < 2:
+            return
+        xs = sorted({round(sx, 1) for (sx, sy), _ in refs})
+        ys = sorted({round(sy, 1) for (sx, sy), _ in refs})
+        bx0, by0, bx1, by1 = self._part_screen_box()
+        gap = 22.0
+        if len(xs) >= 2:
+            self._dim_chain(p, xs, axis='x', base=by0 - gap, edge=by0)
+        if len(ys) >= 2:
+            self._dim_chain(p, ys, axis='y', base=bx1 + gap, edge=bx1)
+
+    def _dim_arrow(self, p, a, b):
+        ang = math.atan2(b.y() - a.y(), b.x() - a.x())
+        for tip, tip_ang in ((b, ang), (a, ang + math.pi)):
+            cos_a, sin_a = math.cos(tip_ang), math.sin(tip_ang)
+            size = 7.0
+            base = (tip.x() - size * cos_a, tip.y() - size * sin_a)
+            splay = 0.2
+            p.setPen(QPen(QColor(C.yel), 0.2))
+            p.setBrush(QBrush(QColor(C.yel)))
+            tri = QPolygonF([
+                QPointF(tip.x(), tip.y()),
+                QPointF(base[0] - size * splay * sin_a,
+                        base[1] + size * splay * cos_a),
+                QPointF(base[0] + size * splay * sin_a,
+                        base[1] - size * splay * cos_a),
+            ])
+            p.drawPolygon(tri)
+            p.setBrush(Qt.NoBrush)
+
+    def _dim_chain(self, p, refs, axis, base, edge):
+        dim_pen = QPen(QColor(C.yel), 0.7)
+        ext_pen = QPen(QColor(245, 158, 11, 150), 0.5, Qt.DashLine)
+        txt_col = QColor(C.yel)
+        p.setFont(QFont('Arial', 8))
+        for i in range(len(refs) - 1):
+            v1, v2 = refs[i], refs[i + 1]
+            if v2 - v1 < 1e-3:
+                continue
+            if axis == 'x':
+                a1 = QPointF(v1, base); a2 = QPointF(v2, base)
+                t1 = QPointF(v1, edge); t2 = QPointF(v2, edge)
+            else:
+                a1 = QPointF(base, v1); a2 = QPointF(base, v2)
+                t1 = QPointF(edge, v1); t2 = QPointF(edge, v2)
+            p.setPen(ext_pen)
+            p.drawLine(t1, a1)
+            p.drawLine(t2, a2)
+            p.setPen(dim_pen)
+            p.drawLine(a1, a2)
+            self._dim_arrow(p, a1, a2)
+            label = f"{abs(v2 - v1):.0f}"
+            fm = p.fontMetrics()
+            tw = fm.horizontalAdvance(label) + 10
+            rect = QRectF((a1.x() + a2.x()) / 2 - tw / 2,
+                          (a1.y() + a2.y()) / 2 - 9, tw, 16)
+            p.setPen(Qt.NoPen)
+            p.setBrush(QBrush(QColor(11, 21, 38, 210)))
+            p.drawRoundedRect(rect, 4, 4)
+            p.setPen(txt_col)
+            p.drawText(rect, Qt.AlignCenter, label)
+
+    def _draw_legend(self, p):
+        from nccorrection.core.part3d import PROFILE_LABELS, PROFILE_COLORS, profile_info
+        st = (self._geometry or {}).get('st') or {}
+        t = (st.get('type') or 'B').upper()
+        col = PROFILE_COLORS.get(t, (120, 120, 120))
+        name = st.get('profile') or PROFILE_LABELS.get(t, t)
+        lines = [name]
+        try:
+            info = profile_info(self._geometry)
+            lines += [seg.strip() for seg in info.split('\u00b7')][1:5]
+        except Exception as e:
+            print(f'[qt_viewer_3d.legend_profile_info] {repr(e)}', file=sys.stderr)
+            pass
+        w = 200
+        entry = 15
+        box_h = 22 + entry * len(lines) + 16
+        x, y = self.width() - w - 8, 30
+        p.setPen(QColor(148, 163, 184, 200))
+        p.setBrush(QColor(15, 23, 42, 220))
+        p.drawRoundedRect(QRectF(x, y, w, box_h), 6, 6)
+        p.setFont(QFont('Arial', 8, QFont.Bold))
+        p.setPen(QColor(C.txt))
+        p.drawText(QRectF(x + 8, y + 4, w - 16, entry), Qt.AlignLeft, 'L\u00e9gende')
+        p.setBrush(QColor(*col))
+        p.setPen(Qt.NoPen)
+        p.drawRect(QRectF(x + 8, y + 20, 12, 12))
+        p.setPen(QColor(C.txt))
+        p.setFont(QFont('Arial', 8, QFont.Bold))
+        p.drawText(x + 26, y + 30, name)
+        p.setFont(QFont('Arial', 7))
+        p.setPen(QColor(C.mut))
+        ty = y + 40
+        for line in lines[1:]:
+            p.drawText(x + 8, ty, line)
+            ty += entry
+        p.setPen(QColor(C.mut))
+        p.drawText(x + 8, ty + 4, '\u00d8 = per\u00e7ages   = coupes')
+
+    def _draw_cut_markers(self, p):
+        cuts = getattr(self, '_cuts_cache', []) or []
+        if not cuts:
+            return
+        st = (self._geometry or {}).get('st') or {}
+        dims = st.get('dims') or []
+        if not dims:
+            return
+        H = dims[1] if len(dims) > 1 else 0.0
+        tf = dims[3] if len(dims) > 3 else (H * 0.035 if H else 0.0)
+        p.setFont(QFont('Arial', 8, QFont.Bold))
+        gpen = QPen(QColor(C.mut), 0.9)
+        apen = QPen(QColor('#fb7185'), 0.9)
+        seen = set()
+        for c in cuts:
+            if c.get('x') is None:
+                continue
+            face = c.get('face') or 'v'
+            if face == 'o':
+                pt = (c['x'], c.get('y') or 0.0, max(H - tf / 2.0, 0.0))
+            elif face == 'u':
+                pt = (c['x'], c.get('y') or 0.0, tf / 2.0)
+            else:
+                pt = (c['x'], 0.0, c.get('y') or 0.0)
+            sx, sy = self._project(pt)
+            if sx < -30 or sy < -30 or sx > self.width() + 30 or sy > self.height() + 30:
+                continue
+            key = (c['kind'], round(c['x'], 1))
+            if key in seen:
+                continue
+            seen.add(key)
+            if c['kind'] == 'grougage':
+                p.setPen(gpen)
+                p.setBrush(Qt.NoBrush)
+                p.drawRect(QRectF(sx - 4, sy - 4, 8, 8))
+                p.setPen(QColor(C.mut))
+                p.drawText(QPointF(sx + 8, sy + 8), c['label'])
+            else:
+                p.setPen(apen)
+                p.setBrush(Qt.NoBrush)
+                p.drawEllipse(QPointF(sx, sy), 4, 4)
+                ang = abs(c['angle']) if c.get('angle') is not None else 0.0
+                label = c['label']
+                if ang > 1e-9:
+                    label += f' {ang:.1f}\u00b0'
+                p.setPen(QColor('#fb7185'))
+                p.drawText(QPointF(sx + 8, sy + 8), label)
+
+    def _draw_hint(self, p):
+        hint = {'rotate': 'Click hole = edit | Drag = rotate 360\u00b0 | Ctrl+R = set pivot | Middle-drag = pan',
+                'pan': 'Click hole = edit | Middle-drag = pan | Drag = rotate',
+                'measure': 'Click two points to measure (snaps to holes) | Esc = clear'}.get(self.mode, '')
+        if self._pivot_mode:
+            hint = 'Pivot: click = place | Esc / Ctrl+R = cancel'
+        if self._section and hint:
+            hint += ' | S = section view'
+        p.setPen(QColor(C.mut))
+        p.drawText(8, 14, hint)
+
+    def _draw_pivot(self, p):
+        if self._pivot_mode and self._pivot_cursor_pt is not None:
+            sx, sy = self._project(self._pivot_cursor_pt)
+            p.setPen(QPen(QColor('#38bdf8'), 1.0, Qt.DashLine))
+            p.drawEllipse(QPointF(sx, sy), 5, 5)
+            p.drawLine(QPointF(sx - 9, sy), QPointF(sx + 9, sy))
+            p.drawLine(QPointF(sx, sy - 9), QPointF(sx, sy + 9))
+        if self._pivot is None:
+            return
+        sx, sy = self._project(self._pivot)
+        p.setPen(QPen(QColor(C.yel), 0.9))
+        p.drawLine(QPointF(sx - 6, sy), QPointF(sx + 6, sy))
+        p.drawLine(QPointF(sx, sy - 6), QPointF(sx, sy + 6))
+
+    def _draw_measure(self, p):
+        if self._measure_pt is not None and self._hover_kind:
+            sx, sy = self._project(self._measure_pt)
+            self._snap_badge(p, (sx, sy), self._hover_kind)
+        for a, bpt, off, dim_off in self._measurements3d:
+            self._draw_one_3d_measure(p, a, bpt, off, dim_off)
+        c_line = QColor(self._mp['line'])
+        for a, vertex, b, ang in self._corner_measures3d:
+            self._draw_corner_measure(p, a, vertex, b, ang, c_line)
+        if self._corner_mode and self._corner_pts:
+            p.setPen(QPen(c_line, 0.8, Qt.DashLine, Qt.RoundCap))
+            p.setBrush(QBrush(c_line))
+            for pt in self._corner_pts:
+                sx, sy = self._project(pt)
+                p.drawEllipse(QPointF(sx, sy), 3, 3)
+        if not self._m1:
+            return
+        s1 = self._project(self._m1)
+        p.setPen(QPen(QColor(self._mp['point']), 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(QBrush(QColor(self._mp['point'])))
+        p.drawEllipse(QPointF(*s1), 4, 4)
+        p.setPen(QPen(QColor(self._mp['point']), 0.8))
+        p.setBrush(Qt.NoBrush)
+        p.drawLine(QPointF(s1[0] - 7, s1[1]), QPointF(s1[0] + 7, s1[1]))
+        p.drawLine(QPointF(s1[0], s1[1] - 7), QPointF(s1[0], s1[1] + 7))
+
+    def _draw_corner_measure(self, p, a, vertex, b, ang, c_line):
+        ds = self.dim_scale()
+        sv = self._project(vertex)
+        s1 = self._project(a)
+        s2 = self._project(b)
+        p.setPen(QPen(c_line, 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(Qt.NoBrush)
+        p.drawLine(QPointF(*sv), QPointF(*s1))
+        p.drawLine(QPointF(*sv), QPointF(*s2))
+        p.setBrush(QBrush(c_line))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(QPointF(*sv), 4, 4)
+        p.drawEllipse(QPointF(*s1), 3, 3)
+        p.drawEllipse(QPointF(*s2), 3, 3)
+        label = corner_label(ang)
+        fm = QFontMetrics(QFont('Arial', max(6, round(9 * ds)), QFont.Bold))
+        tw = fm.horizontalAdvance(label) + 16
+        rect = QRectF(sv[0] - tw / 2, sv[1] - 40 * ds, tw, 20 * ds)
+        self._halo_text(p, rect, label, QColor(self._mp['label_text']), ds)
+
+    def _snap_badge(self, p, pos, kind):
+        from nccorrection.design.glyphs import draw_snap_glyph
+        from nccorrection.design.theme import SNAP_BADGE_COLORS, snap_label
+        color = self._mp['badges'].get(kind, SNAP_BADGE_COLORS.get(kind, '#94a3b8'))
+        scale = self._design.snap_badge_size() if self._design else 1.0
+        draw_snap_glyph(p, pos, kind, QColor(color), scale)
+        x, y = (pos.x(), pos.y()) if hasattr(pos, 'x') else pos
+        r = 6.0 * scale
+        p.setFont(QFont('Arial', max(7, round(8 * scale)), QFont.Bold))
+        p.setPen(QColor(color))
+        p.drawText(QPointF(x + r * 1.6, y + r * 2.0), snap_label(kind))
+
+    def _3d_label_rect(self, a, bpt, off=(0.0, 0.0), dim_off=0.0):
+        ds = self.dim_scale()
+        s1 = self._project(a)
+        s2 = self._project(bpt)
+        dist = math.dist(a, bpt)
+        dx = abs(bpt[0] - a[0])
+        dy = abs(bpt[1] - a[1])
+        dz = abs(bpt[2] - a[2])
+        ang = math.degrees(math.atan2(dy, dx)) % 180.0
+        ang_label = angle_label(ang)
+        verdict = angle_verdict(ang)
+        label = f"{dist:.1f} mm  (dx={dx:.1f} dy={dy:.1f} dz={dz:.1f})  \u2220{ang_label} [{verdict}]"
+        fm = QFontMetrics(QFont('Arial', max(6, round(9 * ds)), QFont.Bold))
+        tw = fm.horizontalAdvance(label) + 16
+        ln = math.hypot(s2[0] - s1[0], s2[1] - s1[1])
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2[1] - s1[1]) / ln, (s2[0] - s1[0]) / ln)
+        mid = ((s1[0] + s2[0]) / 2 + perp.x() * dim_off,
+               (s1[1] + s2[1]) / 2 - 24 * ds + perp.y() * dim_off)
+        return QRectF(mid[0] - tw / 2 + off[0], mid[1] + off[1],
+                      tw, 20 * ds), label
+
+    def _halo_text(self, p, rect, label, color, ds=1.0):
+        """Draw a label with a stencil halo (no frame hiding the view)."""
+        p.setFont(QFont('Arial', max(6, round(9 * ds)), QFont.Bold))
+        halo = QColor(15, 23, 42, 200)
+        p.setPen(halo)
+        for hx, hy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            p.drawText(rect.translated(hx, hy), Qt.AlignCenter, label)
+        p.setPen(color)
+        p.drawText(rect, Qt.AlignCenter, label)
+
+    def _draw_one_3d_measure(self, p, a, bpt, off=(0.0, 0.0), dim_off=0.0):
+        ds = self.dim_scale()
+        s1 = QPointF(*self._project(a))
+        s2 = QPointF(*self._project(bpt))
+        ln = math.hypot(s2.x() - s1.x(), s2.y() - s1.y())
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2.y() - s1.y()) / ln, (s2.x() - s1.x()) / ln)
+        shift = perp * dim_off
+        p1, p2 = s1 + shift, s2 + shift
+        c_line = QColor(self._mp['line'])
+        c_text = QColor(self._mp['label_text'])
+        if abs(dim_off) > 1e-6:
+            p.setPen(QPen(c_line, 0.7, Qt.SolidLine, Qt.RoundCap))
+            p.drawLine(s1, p1)
+            p.drawLine(s2, p2)
+        line = QLineF(p1, p2)
+        p.setPen(QPen(c_line, 1.0, Qt.SolidLine, Qt.RoundCap))
+        p.setBrush(Qt.NoBrush)
+        p.drawLine(line)
+        self._draw_arrow(p, line, c_line)
+        p.setBrush(QBrush(c_line))
+        p.setPen(Qt.NoPen)
+        p.drawEllipse(s1, 3, 3)
+        p.setBrush(QBrush(c_text))
+        p.drawEllipse(s2, 3, 3)
+        rect, label = self._3d_label_rect(a, bpt, off, dim_off)
+        self._halo_text(p, rect, label, c_text, ds)
+        self.measure_result.emit(label)
+
+    def _draw_arrow(self, p, line, color):
+        ang = math.atan2(-(line.y2() - line.y1()), line.x2() - line.x1())
+        a = math.radians(20)
+        l = 9.0
+        for x, y, direction in ((line.x1(), line.y1(), 1), (line.x2(), line.y2(), -1)):
+            p.setBrush(QBrush(color))
+            p.setPen(Qt.NoPen)
+            poly = QPolygonF([
+                QPointF(x, y),
+                QPointF(x - direction * l * math.cos(ang + a),
+                        y + direction * l * math.sin(ang + a)),
+                QPointF(x - direction * l * math.cos(ang - a),
+                        y + direction * l * math.sin(ang - a)),
+            ])
+            p.drawPolygon(poly)
