+"""Tests for models/contour_point.py."""
+import unittest
+from nccorrection.engine.contour.models.contour_point import ContourPoint
+from nccorrection.engine.contour.core.enums import Face, PointSuffix
+
+
+class TestContourPointFlags(unittest.TestCase):
+    def test_notch_w_sets_flag(self):
+        pt = ContourPoint(x=100, y=50, face=Face.V, suffix=PointSuffix.W)
+        self.assertTrue(pt.is_notch)
+        self.assertFalse(pt.is_tangential)
+        self.assertFalse(pt.is_start)
+
+    def test_tangential_t_sets_flag(self):
+        pt = ContourPoint(x=100, y=50, face=Face.V, suffix=PointSuffix.T)
+        self.assertTrue(pt.is_tangential)
+        self.assertFalse(pt.is_notch)
+
+    def test_start_s_sets_flag(self):
+        pt = ContourPoint(x=0, y=0, face=Face.V, suffix=PointSuffix.S)
+        self.assertTrue(pt.is_start)
+
+    def test_no_suffix_all_false(self):
+        pt = ContourPoint(x=100, y=50, face=Face.V)
+        self.assertFalse(pt.is_notch)
+        self.assertFalse(pt.is_tangential)
+        self.assertFalse(pt.is_start)
+
+
+class TestContourPointHelpers(unittest.TestCase):
+    def test_has_special_suffix_for_w(self):
+        pt = ContourPoint(x=0, y=0, face=Face.V, suffix=PointSuffix.W)
+        self.assertTrue(pt.has_special_suffix)
+
+    def test_has_special_suffix_for_s(self):
+        pt = ContourPoint(x=0, y=0, face=Face.V, suffix=PointSuffix.S)
+        self.assertFalse(pt.has_special_suffix)
+
+    def test_str_representation(self):
+        pt = ContourPoint(x=100, y=50, face=Face.V, suffix=PointSuffix.W)
+        s = str(pt)
+        self.assertIn("100.00", s)
+        self.assertIn("v", s)
+        self.assertIn("w", s)
