+"""Auto-detection of circular contours and bolt-circle patterns.
+
+Reads a geometry dict (the same format produced by :func:`core.viewer.parse_geometry`)
+and automatically identifies:
+- Circular contours (radius-convention AK/IK arcs)
+- Bolt circle patterns (3+ holes on the same radius)
+- Which dimensions to auto-generate
+
+Pure Python — no Qt, no rendering.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Optional, Tuple
+
+from .types import (
+    Point2D, RadiusDimension, DiameterDimension, AngularDimension,
+    CenterMark, BoltCirclePattern, DimensionGroup,
+)
+from .geometry import (
+    circle_center_from_contour, circle_radius_from_contour,
+    detect_bolt_circles, angular_spacing,
+)
+
+
+def detect_circular_contours(geometry: dict) -> List[dict]:
+    """Find contours that represent full circles (radius convention).
+
+    Returns list of dicts with keys: ``center``, ``radius``, ``face``,
+    ``is_outer`` (True if radius > inner cutout).
+    """
+    contours = geometry.get('contours', [])
+    metas = geometry.get('contour_meta') or []
+    results = []
+
+    for i, (contour, meta) in enumerate(zip(contours, metas)):
+        if meta.get('arc_convention') != 'radius':
+            continue
+        arc_vals = meta.get('arc_values', [])
+        if not arc_vals or not any(abs(v) > 1e-12 for v in arc_vals):
+            continue
+
+        pts = [(float(x), float(y)) for x, y in contour]
+        if len(pts) < 2:
+            continue
+
+        center = circle_center_from_contour(pts)
+        if center is None:
+            continue
+        radius = circle_radius_from_contour(pts, center)
+
+        # Determine if outer or inner based on radius
+        # (larger = outer contour, smaller = inner cutout)
+        results.append({
+            'center': center,
+            'radius': radius,
+            'face': meta.get('face', 'v'),
+            'is_outer': True,  # Will be corrected after all contours found
+            'contour_index': i,
+        })
+
+    # Mark largest as outer, rest as inner
+    if results:
+        max_r = max(c['radius'] for c in results)
+        for c in results:
+            c['is_outer'] = (c['radius'] == max_r)
+
+    return results
+
+
+def detect_holes_on_circle(holes: List[dict],
+                            tolerance: float = 2.0) -> List[BoltCirclePattern]:
+    """Detect bolt circle patterns from the holes list.
+
+    Each hole dict has keys: ``x``, ``y``, ``d``, ``kind``, ``face``.
+    Only ``kind == 'hole'`` (round holes, not slots) are considered.
+    """
+    # Extract round hole positions
+    hole_pts = []
+    hole_diameters = []
+    for h in holes:
+        if h.get('kind') != 'hole':
+            continue
+        pt = Point2D(h['x'], h['y'])
+        hole_pts.append(pt)
+        hole_diameters.append(h.get('d', 0.0))
+
+    if len(hole_pts) < 3:
+        return []
+
+    # Detect bolt circles
+    patterns = detect_bolt_circles(hole_pts, tolerance=tolerance, min_holes=3)
+
+    results = []
+    for centre, radius, pts_on_circle in patterns:
+        # Average hole diameter for the bolt circle
+        avg_d = 0.0
+        count = 0
+        for hp, hd in zip(hole_pts, hole_diameters):
+            if hp in pts_on_circle:
+                avg_d += hd
+                count += 1
+        if count > 0:
+            avg_d /= count
+
+        results.append(BoltCirclePattern(
+            center=centre,
+            bolt_radius=radius,
+            hole_positions=pts_on_circle,
+            hole_diameter=avg_d,
+        ))
+
+    return results
+
+
+def auto_dimensions(geometry: dict) -> DimensionGroup:
+    """Generate automatic dimensions for a geometry dict.
+
+    Analyzes contours + holes and produces a DimensionGroup with:
+    - Radius leader for each circular contour
+    - Center mark for each circular contour
+    - Bolt circle annotations for detected patterns
+
+    This is the main entry point for the auto-dimensioning feature.
+    """
+    group = DimensionGroup()
+
+    # 1. Detect circular contours
+    circles = detect_circular_contours(geometry)
+
+    for circ in circles:
+        # Center mark
+        group.center_marks.append(CenterMark(
+            center=circ['center'],
+            mark_size=3.0,
+            extended=True,
+            radius=circ['radius'],
+            face=circ['face'],
+        ))
+
+        # Radius leader (at 45° offset from horizontal for readability)
+        leader_angle = 45.0
+        leader_pt = Point2D(
+            circ['center'].x + circ['radius'] * math.cos(math.radians(leader_angle)),
+            circ['center'].y + circ['radius'] * math.sin(math.radians(leader_angle)),
+        )
+
+        if circ['is_outer']:
+            group.radii.append(RadiusDimension(
+                center=circ['center'],
+                point_on_circle=leader_pt,
+                radius=circ['radius'],
+                angle_deg=leader_angle,
+                face=circ['face'],
+            ))
+        else:
+            # Inner contour → diameter dimension
+            group.diameters.append(DiameterDimension(
+                center=circ['center'],
+                point_on_circle=leader_pt,
+                diameter=circ['radius'] * 2.0,
+                angle_deg=leader_angle,
+                face=circ['face'],
+            ))
+
+    # 2. Detect bolt circle patterns
+    holes = geometry.get('holes', [])
+    bolt_circles = detect_holes_on_circle(holes)
+
+    for bc in bolt_circles:
+        # Find the face from the first hole
+        for h in holes:
+            if h.get('kind') == 'hole':
+                pt = Point2D(h['x'], h['y'])
+                if any(pt.distance_to(bp) < 0.1 for bp in bc.hole_positions):
+                    bc.face = h.get('face', 'v')
+                    break
+        group.bolt_circles.append(bc)
+
+    return group
