+import json, os, datetime
+
+AUDIT_CODES = {
+    'ok': {'scan': 'OK-101', 'select': 'OK-120', 'column': 'OK-130', 'layout': 'OK-150',
+           'layout_user': 'OK-151', 'undo': 'OK-020', 'redo': 'OK-021', 'theme': 'OK-610',
+           'organize': 'OK-320', 'preview': 'OK-321', 'rename': 'OK-332', 'plane': 'OK-220',
+           'sien': 'OK-250', 'project_save': 'OK-500', 'report': 'OK-502', 'clear_audit': 'OK-400'},
+    'warn': {'duplicate': 'WRN-210', 'nofiles': 'WRN-120', 'plane_same': 'WRN-230',
+             'sien_clear': 'WRN-251', 'sien_add': 'WRN-252', 'holes': 'WRN-261',
+             'close': 'WRN-002', 'undo_empty': 'WRN-010', 'redo_empty': 'WRN-011'},
+    'error': {'conflict': 'ERR-320'}
+}
+
+
+class AuditService:
+    def __init__(self, settings_service=None):
+        self._settings = settings_service
+        self._history = []
+        self._enabled = True
+        self._path = None
+        if settings_service:
+            d = os.path.dirname(settings_service.settings_path)
+            self._path = os.path.join(d, 'audit_history.json')
+            self._enabled = settings_service.get('auditEnabled', True)
+            self._load()
+
+    def _load(self):
+        if self._path and os.path.exists(self._path):
+            try:
+                with open(self._path, 'r', encoding='utf-8') as f:
+                    self._history = json.load(f)
+            except (json.JSONDecodeError, OSError):
+                self._history = []
+
+    def _save(self):
+        if self._path:
+            try:
+                with open(self._path, 'w', encoding='utf-8') as f:
+                    json.dump(self._history[:400], f, indent=2, ensure_ascii=False)
+            except OSError:
+                pass
+
+    def log(self, message, level='ok', code=None):
+        if not self._enabled and level not in ('warn', 'error'):
+            return
+        if not code:
+            code = AUDIT_CODES.get(level, {}).get('ok' if level == 'ok' else 'warn', 'OK-000')
+        entry = {
+            'time': datetime.datetime.now().isoformat(),
+            'level': level,
+            'code': code,
+            'message': message
+        }
+        self._history.insert(0, entry)
+        self._history = self._history[:400]
+        self._save()
+
+    def clear(self):
+        self._history = []
+        self._save()
+
+    @property
+    def enabled(self):
+        return self._enabled
+
+    @enabled.setter
+    def enabled(self, value):
+        self._enabled = value
+        if self._settings:
+            self._settings.set('auditEnabled', value)
+
+    @property
+    def history(self):
+        return list(self._history)
+
+    @property
+    def is_empty(self):
+        return len(self._history) == 0
