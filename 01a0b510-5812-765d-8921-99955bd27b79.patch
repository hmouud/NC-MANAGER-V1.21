+"""contour_point.py — ContourPoint data class.
+
+🚨 GUARDIAN LAW: pure data + validation. No business logic.
+
+هاد الكلاس كايمثل نقطة وحدة من بلوك AK ولا IK، مع:
+    - الإحداثيات (x, y)
+    - الـ suffix (s, u, w, t, ...)
+    - flag is_notch (باش الـ ContourBuilder يعرف)
+    - الحقول الإضافية (bulge, angle, thickness)
+"""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import Optional
+
+from ..core.enums import Face, PointSuffix
+
+
+@dataclass(frozen=True)
+class ContourPoint:
+    """نقطة وحدة من محيط (AK ولا IK)."""
+    x: float
+    y: float
+    face: Face
+    suffix: Optional[PointSuffix] = None
+    is_notch: bool = False
+    is_tangential: bool = False
+    is_start: bool = False
+    bulge: float = 0.0
+    angle: float = 0.0
+    thickness: float = 0.0
+
+    def __post_init__(self) -> None:
+        """كايضبط الـ flags أوتوماتيكيا من الـ suffix إلا ما كانوش مضبوطين."""
+        if self.suffix is None:
+            return
+        object.__setattr__(
+            self, "is_notch", self.suffix == PointSuffix.W
+        )
+        object.__setattr__(
+            self, "is_tangential", self.suffix == PointSuffix.T
+        )
+        object.__setattr__(
+            self, "is_start", self.suffix == PointSuffix.S
+        )
+
+    @property
+    def has_special_suffix(self) -> bool:
+        """واش عندو suffix خاص (w ولا t)؟"""
+        return self.is_notch or self.is_tangential
+
+    def __str__(self) -> str:
+        marker = ""
+        if self.suffix:
+            marker = f" [{self.suffix.value}]"
+        return f"({self.x:.2f}, {self.y:.2f}) on {self.face.value}{marker}"
