@@ -0,0 +1,210 @@
+"""Dimension Tools toolbar for NC MANAGER V1.21.
+
+Single responsibility: dimension tool selection UI.
+- Provides a dropdown for dimension mode selection (Smart/Linear/Angular/Radius/Diameter/Leader).
+- Emits dimension_mode_changed signal when user selects a tool.
+- Does NOT handle rendering (that stays in design/dimensioning).
+- Does NOT handle click-to-place (that stays in the canvas/viewer).
+
+Design reference:
+    - SolidWorks: Smart Dimension primary + dropdown
+    - Fusion 360: Single button with dropdown
+    - AutoCAD: "Annotate" tab with "Dimensions" panel
+    - QCAD: Menu + toolbar with separate icons
+
+Signals:
+    dimension_mode_changed(str): Emitted when user selects a dimension tool.
+        Payload is the mode string: 'smart', 'linear', 'angular', 'radius', 'diameter', 'leader', 'none'.
+
+Usage::
+
+    toolbar = DimensionToolbar()
+    toolbar.dimension_mode_changed.connect(canvas.set_dimension_tool)
+"""
+from __future__ import annotations
+
+from enum import Enum
+from typing import Optional
+
+from PySide6.QtCore import Signal
+from PySide6.QtWidgets import QWidget, QHBoxLayout, QToolButton, QMenu, QFrame
+
+from nccorrection.ui._colors import C
+
+
+# ────────────────────────────────────────────────────────────────────
+# Dimension modes — mirrors design/dimensioning/types.py DimType
+# ────────────────────────────────────────────────────────────────────
+
+class DimensionMode(str, Enum):
+    """Available dimension tool modes."""
+    SMART = "smart"
+    LINEAR = "linear"
+    ANGULAR = "angular"
+    RADIUS = "radius"
+    DIAMETER = "diameter"
+    LEADER = "leader"
+    NONE = "none"
+
+
+# ────────────────────────────────────────────────────────────────────
+# Tool definitions — registry pattern with individual tools
+# ────────────────────────────────────────────────────────────────────
+
+_DIMENSION_TOOLS = [
+    # (mode, label, shortcut, tooltip)
+    (DimensionMode.SMART,     "Smart",     "Ctrl+D",   "Auto-detect dimension type"),
+    (DimensionMode.LINEAR,    "Linear",    "D L",      "Linear dimension (horizontal/vertical)"),
+    (DimensionMode.ANGULAR,   "Angular",   "D A",      "Angular dimension (between 2 lines)"),
+    (DimensionMode.RADIUS,    "Radius",    "D R",      "Radius dimension"),
+    (DimensionMode.DIAMETER,  "Diameter",  "D D",      "Diameter dimension (+ center mark & leader)"),
+    (DimensionMode.LEADER,    "Leader",    "D E",      "Leader (text note with arrow)"),
+]
+
+
+class DimensionToolbar(QWidget):
+    """Dimension Tools toolbar.
+
+    Provides a primary "Smart" button with a dropdown for all dimension modes.
+    Individual mode buttons are also shown for power users.
+
+    Signals:
+        dimension_mode_changed(str): Emitted when user selects a dimension tool.
+    """
+
+    dimension_mode_changed = Signal(str)
+
+    def __init__(self, parent: Optional[QWidget] = None):
+        super().__init__(parent)
+        self._current_mode = DimensionMode.NONE
+        self._buttons: dict[DimensionMode, QToolButton] = {}
+
+        self._build_ui()
+
+    # ────────────────────────────────────────────────────────────────
+    # UI Construction
+    # ────────────────────────────────────────────────────────────────
+
+    def _build_ui(self) -> None:
+        layout = QHBoxLayout(self)
+        layout.setContentsMargins(4, 2, 4, 2)
+        layout.setSpacing(2)
+
+        # ── Primary Button (Smart) + Dropdown ──
+        self._primary_btn = QToolButton()
+        self._primary_btn.setText("Smart")
+        self._primary_btn.setPopupMode(
+            QToolButton.ToolButtonPopupMode.MenuButtonPopup
+        )
+        self._primary_btn.setToolTip("Smart Dimension (Ctrl+D)\nAuto-detect dimension type")
+        self._primary_btn.setCheckable(True)
+        self._primary_btn.clicked.connect(
+            lambda: self._on_mode_selected(DimensionMode.SMART)
+        )
+
+        # ── Dropdown Menu ──
+        menu = QMenu(self)
+        menu.setStyleSheet(
+            f"QMenu {{ background-color: {C.panel}; color: {C.txt}; "
+            f"border: 1px solid {C.line}; }} "
+            f"QMenu::item:selected {{ background-color: {C.accent}; }}"
+        )
+        for mode, label, shortcut, tooltip in _DIMENSION_TOOLS:
+            if mode == DimensionMode.SMART:
+                continue  # Smart is the primary button
+            action = menu.addAction(f"{label}\t{shortcut}")
+            action.setToolTip(tooltip)
+            action.triggered.connect(
+                lambda checked=False, m=mode: self._on_mode_selected(m)
+            )
+        self._primary_btn.setMenu(menu)
+
+        layout.addWidget(self._primary_btn)
+
+        # ── Separator ──
+        sep = QFrame()
+        sep.setFrameShape(QFrame.Shape.VLine)
+        sep.setStyleSheet(f"color: {C.line};")
+        layout.addWidget(sep)
+
+        # ── Individual Mode Buttons (for power users) ──
+        for mode, label, shortcut, tooltip in _DIMENSION_TOOLS:
+            if mode == DimensionMode.SMART:
+                continue
+            btn = QToolButton()
+            btn.setText(label)
+            btn.setToolTip(f"{label} ({shortcut})\n{tooltip}")
+            btn.setCheckable(True)
+            btn.clicked.connect(
+                lambda checked=False, m=mode: self._on_mode_selected(m)
+            )
+            self._buttons[mode] = btn
+            layout.addWidget(btn)
+
+        # ── Style ──
+        self.setStyleSheet(f"""
+            QToolButton {{
+                background-color: transparent;
+                border: 1px solid transparent;
+                color: {C.txt};
+                padding: 4px 8px;
+                border-radius: 3px;
+                font-family: 'Arial';
+                font-size: 10px;
+            }}
+            QToolButton:hover {{
+                background-color: {C.panel};
+                border: 1px solid {C.line};
+            }}
+            QToolButton:checked {{
+                background-color: {C.accent};
+                color: white;
+            }}
+        """)
+
+    # ────────────────────────────────────────────────────────────────
+    # Mode selection
+    # ────────────────────────────────────────────────────────────────
+
+    def _on_mode_selected(self, mode: DimensionMode) -> None:
+        """Handle dimension mode selection."""
+        if self._current_mode == mode:
+            # Toggle off — clicking active tool deactivates it
+            self._current_mode = DimensionMode.NONE
+        else:
+            self._current_mode = mode
+
+        self._update_button_states()
+        self.dimension_mode_changed.emit(self._current_mode.value)
+
+    def _update_button_states(self) -> None:
+        """Sync button checked states with current mode."""
+        # Primary button
+        self._primary_btn.setChecked(
+            self._current_mode == DimensionMode.SMART
+        )
+        # Individual buttons
+        for mode, btn in self._buttons.items():
+            btn.setChecked(self._current_mode == mode)
+
+    # ────────────────────────────────────────────────────────────────
+    # Public API
+    # ────────────────────────────────────────────────────────────────
+
+    def current_mode(self) -> str:
+        """Return the current dimension mode as a string."""
+        return self._current_mode.value
+
+    def set_mode(self, mode: str) -> None:
+        """Set the dimension mode programmatically (e.g. from app state restore)."""
+        try:
+            self._current_mode = DimensionMode(mode)
+        except ValueError:
+            self._current_mode = DimensionMode.NONE
+        self._update_button_states()
+
+    def reset(self) -> None:
+        """Reset to no tool selected."""
+        self._current_mode = DimensionMode.NONE
+        self._update_button_states()
+        self.dimension_mode_changed.emit(DimensionMode.NONE.value)
diff --git a/src/nccorrection/ui/toolbars/measure_toolbar.py b/src/nccorrection/ui/toolbars/measure_toolbar.py
