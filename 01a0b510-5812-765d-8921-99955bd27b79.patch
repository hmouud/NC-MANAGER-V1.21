+"""Workshop B (NCV121): per-face DXF export.
+
+Covers the backward-compatible extension of ``core/dxf_writer.py``:
+- legacy call (``faces=None``) stays byte-identical in behaviour (OUTLINE
+  + HOLES layers only);
+- ``faces=[...]`` writes each face on its own ``FACE_<LETTER>`` layer;
+- ``layout='blueprint'`` arranges the faces like the blueprint unfold
+  (v at the origin, o above, u below, h right, 100-unit gap);
+- geometry without face info (DXF plates, legacy dicts) assigns everything
+  to the first requested face.
+"""
+
+import os
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(
+    os.path.abspath(__file__))), 'src'))
+
+from nccorrection.core.dxf_writer import (export_dxf, _blueprint_offsets,
+                                          FACE_ORDER)
+
+# HEA300-like geometry: v web + o/u flanges, one hole on v and one on o.
+GEO = {
+    'st': {'profile': 'HEA300', 'type': 'I', 'dims': [6000, 300, 150],
+           'thickness': 10.0},
+    'contours': [
+        [(0, 0), (6000, 0), (6000, 300), (0, 300)],        # v
+        [(200, 0), (5800, 0), (5800, 150), (200, 150)],    # o
+        [(100, 0), (5900, 0), (5900, 150), (100, 150)],    # u
+    ],
+    'contour_faces': ['v', 'o', 'u'],
+    'contour_meta': [
+        {'face': 'v', 'pts': [(0, 0), (6000, 0), (6000, 300), (0, 300)],
+         'bevels': {}, 'notches': [], 'x_suffix': None,
+         'first_x': 0.0, 'first_y': 0.0},
