+            length = float(feat.get('length', 0.0) or 0.0)
+            angle = float(feat.get('angle', 0.0) or 0.0)
+            kind = "Slot" if (length > 0 or feat.get('kind') == 'slot') else "Hole"
+            x = float(feat.get('x', 0.0))
