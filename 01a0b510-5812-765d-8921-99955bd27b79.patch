+"""cut_interpreter.py — Facade for web + flange interpreters.
+
+هاد الملف هو الواجهة اللي كايستعملها الـ Contour Builder.
+كايوجّه الطلبات للـ WebInterpreter ولا FlangeInterpreter حسب الوجه.
+"""
+from __future__ import annotations
+from typing import Dict, List
+
+from ..core.enums import Face
+from ..models.cut_angles import CutAngles
+from ..models.intersection import IntersectionPoint
+from ..models.profile_model import ProfileGeometryModel
+from .web_interpreter import WebInterpreter
+from .flange_interpreter import FlangeInterpreter
+
+
+class CutInterpreter:
+    """Facade: كايوجّه الحسابات للـ web/flange interpreters.
+
+    هاد التصميم كايسمح بالـ:
+      - فصل المسؤوليات (Web != Flange)
+      - الاختبار المستقل لكل جزء
+      - إضافة منطق جديد بلا ما نلمسو الكود القديم
+    """
+
+    def __init__(self, model: ProfileGeometryModel, angles: CutAngles):
+        self.model = model
+        self.angles = angles
+        self._web = WebInterpreter(model.dimensions, angles)
+        self._flange = FlangeInterpreter(model.dimensions, angles)
+
+    def compute(self, face: Face) -> List[IntersectionPoint]:
+        """كايحسب النقاط حسب الوجه (dispatch)."""
+        if face.is_web:
+            return self._web.compute(face)
+        if face.is_flange:
+            return self._flange.compute(face)
+        return []
+
+    def compute_all(self) -> Dict[Face, List[IntersectionPoint]]:
+        """كايحسب النقاط لكل الوجوه دفعة وحدة."""
+        return {face: self.compute(face) for face in self.model.faces}
+
+    @property
+    def is_cut_present(self) -> bool:
+        return not self.angles.is_identity
+
+    @property
+    def web_interpreter(self) -> WebInterpreter:
+        return self._web
+
+    @property
+    def flange_interpreter(self) -> FlangeInterpreter:
+        return self._flange
