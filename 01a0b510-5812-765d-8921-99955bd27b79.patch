@@ -0,0 +1,105 @@
+"""Shared NC1 text metrics and helpers — single source of truth.
+
+Functions extracted from app.py and file_import.py (D1-D8 deduplication).
+All callers import from this module instead of defining their own copies.
+"""
+import math
+import re
+
+
+# ── Steel grade regex (D6) ─────────────────────────────────────────
+GRADE_RE = re.compile(
+    r'^(?:S\s*\d{3}\s*[A-Za-z0-9]*|E\s*\d{2}\s*[A-Za-z0-9]*|'
+    r'FE\s*\d{3}\s*[A-Za-z0-9]*|A\s*\d{2,5}[A-Za-z0-9]*)$', re.I)
+
+# ── Profile type set (D7) ──────────────────────────────────────────
+PROFILE_TYPES = {'I', 'U', 'L', 'B', 'M', 'RO', 'RU', 'C', 'T', 'SO', 'Z', 'O'}
+
+# ── Steel density kg/mm^3 (D8) ────────────────────────────────────
+DENSITY = 7.85e-6  # 7850 kg/m^3
+
+
+# ── Helpers ─────────────────────────────────────────────────────────
+
+def extract_steel(text: str) -> str:
+    """Return the first steel grade line from NC1 text."""
+    for raw in (text or '').splitlines():
+        x = raw.strip()
+        if x and not x.startswith('**') and GRADE_RE.match(x):
+            return x
+    return ''
+
+
+def section_area(ptype: str, d: list) -> float:
+    """Cross-section area [mm²] from the 12-value dim block."""
+    def g(i, default=0.0):
+        return d[i] if len(d) > i else default
+
+    if ptype == 'I':
+        H, b, tf, tw = g(1), g(2), g(3), g(4)
+        return 2 * b * tf + max(H - 2 * tf, 0.0) * tw
+    if ptype in ('C', 'U'):
+        H, b, tw, tf = g(1), g(2), g(3), g(4)
+        return 2 * b * tf + max(H - 2 * tf, 0.0) * tw
+    if ptype == 'L':
+        a, b, th = g(1), g(2), g(3)
+        return a * th + max(b - th, 0.0) * th
+    if ptype == 'T':
+        H, b, th = g(1), g(2), g(3)
+        return b * th + max(H - th, 0.0) * th
+    if ptype in ('O', 'RO', 'RU'):
+        D = g(1) or g(2)
+        area = math.pi * D * D / 4.0
+        t = g(3)
+        if t and t < D:
+            area -= math.pi * (max(D - 2 * t, 0.0)) ** 2 / 4.0
+        return area
+    if ptype in ('S', 'SO'):
+        a, b = g(1), g(2)
+        return a * b
+    if ptype == 'Z':
+        H, b, th = g(1), g(2), g(3)
+        return 2 * b * th + max(H - 2 * th, 0.0) * th
+    return 0.0
+
+
+def part_metrics(text: str) -> tuple:
+    """Return (length_display, weight_kg) from the NC1 ST block.
+
+    Plates (B): long.mm = 'LxH', weight = t*L*H*density.
+    Rolled profiles: long.mm = length, weight = kg/m * L (fallback section area).
+    """
+    lines = [ln.strip() for ln in (text or '').splitlines()]
+    ptype, dims, in_dims = None, [], False
+    for ln in lines:
+        if ln in PROFILE_TYPES:
+            ptype, in_dims = ln, True
+            continue
+        if not in_dims:
+            continue
+        if ln.startswith('**') or not ln:
+            continue
+        m = re.match(r'^-?\d+(?:\.\d+)?$', ln)
+        if m:
+            dims.append(float(m.group(0)))
+            if len(dims) >= 12:
+                break
+            continue
+        break
+    L = dims[0] if len(dims) > 0 else 0.0
+    if ptype == 'B':
+        H = dims[1] if len(dims) > 1 else 0.0
+        t = dims[2] if len(dims) > 2 else 0.0
+        if not t:
+            for raw in lines:
+                m = re.match(r'^PL\s*(\d+(?:\.\d+)?)', raw, re.I)
+                if m:
+                    t = float(m.group(1))
+                    break
+        disp = f'{L:.0f}x{H:.0f}' if L and H else f'{L:.0f}'
+        return disp, t * L * H * DENSITY
+    if len(dims) > 6 and dims[6]:
+        weight = dims[6] * L / 1000.0
+    else:
+        weight = section_area(ptype, dims) * L * DENSITY
+    return f'{L:.0f}', weight
