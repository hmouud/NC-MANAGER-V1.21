+class TestDstvParsingRobustness(unittest.TestCase):
+    def test_comma_decimals_parsing(self):
+        # European format with commas: "v  1200,50  150,25  22,00"
+        nc_text = """ST
+** European Machine Output
+B
+HEA200
+1000,00  200,00  100,00  10,00  6,00
+BO
+v  150,50  80,25  18,00
+v  300,00  80,00  22,00  40,50l  30,00
+EN
+"""
+        geom = parse_geometry(nc_text)
+        self.assertEqual(len(geom['holes']), 2)
+        h1 = geom['holes'][0]
+        self.assertAlmostEqual(h1['x'], 150.50, delta=1e-3)
+        self.assertAlmostEqual(h1['y'], 80.25, delta=1e-3)
+        self.assertAlmostEqual(h1['d'], 18.00, delta=1e-3)
+
+        h2 = geom['holes'][1]
+        self.assertEqual(h2['kind'], 'slot')
+        self.assertAlmostEqual(h2['length'], 40.50, delta=1e-3)
+        self.assertAlmostEqual(h2['angle'], 30.00, delta=1e-3)
+
+        # Test with DstvParser
+        from nccorrection.engine.parser.dstv_parser import DstvParser
+        dstv_p = DstvParser()
+        part = dstv_p.parse_text(nc_text)
+        self.assertEqual(len(part.faces['v'].holes), 2)
+        self.assertAlmostEqual(part.faces['v'].holes[0].x, 150.50, delta=1e-3)
+
+    def test_comments_and_semicolons_ignored(self):
+        nc_text = """ST
+; Semicolon comment line
+# Hash comment line
+// Slash comment line
+** Standard DSTV comment
+I
+IPE300
+6000.0 300.0 150.0 10.7 7.1
+BO
+v 100.0 75.0 22.0
+EN
+"""
+        geom = parse_geometry(nc_text)
+        self.assertEqual(geom['st']['profile'], 'IPE300')
+        self.assertEqual(len(geom['holes']), 1)
+        self.assertEqual(geom['holes'][0]['d'], 22.0)
