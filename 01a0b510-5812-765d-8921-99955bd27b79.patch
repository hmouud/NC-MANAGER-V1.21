+import os
+import tempfile
+import shutil
+import unittest
+
+from nccorrection.core.importer import (
+    scan_folder, distinct_orders, plan_import, file_info_lines, fmt_date,
+)
+from nccorrection.core.order_utils import _extract_order, _replace_order_in_text
+
+
+def write_nc1(directory, name, order, extra=''):
+    path = os.path.join(directory, name)
+    with open(path, 'w', encoding='latin-1') as fh:
+        fh.write(f'ST\n** {name}\n{order}\nHEA200\n6000.0\n'
+                 f'BO\nv 10.00 20.00 18.00\n{extra}EN\n')
+    return path
+
+
+class TestScanFolder(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def test_scan_finds_nc_nc1_only_top_level(self):
+        write_nc1(self.tmp, 'C1.nc1', '23-001')
+        write_nc1(self.tmp, 'CH-1.nc', '23-001')
+        with open(os.path.join(self.tmp, 'notes.txt'), 'w') as fh:
+            fh.write('ignore me')
+        sub = os.path.join(self.tmp, 'sub')
+        os.makedirs(sub)
+        write_nc1(sub, 'deep.nc1', '23-001')
+        scan = scan_folder(self.tmp)
+        names = sorted(f['name'] for f in scan)
+        self.assertEqual(names, ['C1.nc1', 'CH-1.nc'])
+        for f in scan:
+            self.assertTrue(f['hash'])
+            self.assertTrue(f['order'])
+
+    def test_scan_extracts_orders_from_inside(self):
+        write_nc1(self.tmp, 'a.nc1', '23-001')
+        write_nc1(self.tmp, 'b.nc1', 'ouahbi123')
+        write_nc1(self.tmp, 'c.nc1', 'chrghui f1 rve B')
+        scan = scan_folder(self.tmp)
+        orders = distinct_orders(scan)
+        self.assertEqual(orders, ['23-001', 'ouahbi123', 'chrghui f1 rve B'])
+
+    def test_scan_skips_unreadable(self):
+        write_nc1(self.tmp, 'ok.nc1', '23-001')
+        scan = scan_folder(os.path.join(self.tmp, 'missing'))
+        self.assertEqual(scan, [])
+
+
+class TestPlanImport(unittest.TestCase):
+    def test_new_duplicate_conflict_classification(self):
+        import tempfile as _t
+        d = _t.mkdtemp()
+        try:
+            p1 = write_nc1(d, 'A.nc1', 'ord1')
+            p2 = write_nc1(d, 'B.nc1', 'ord1')
+            with open(p2, 'rb') as fh:
+                raw = fh.read()
+            with open(os.path.join(d, 'A2.nc1'), 'wb') as fh:
+                fh.write(raw)  # same content, different name -> new
+            scan = scan_folder(d)
+            # existing records: A.nc1 with same content as A2.nc1
+            existing = [
+                {'name': 'A.nc1', 'hash': next(f['hash'] for f in scan
+                                               if f['name'] == 'A.nc1')},
+            ]
+            plan = plan_import(scan, existing)
+            names_new = sorted(f['name'] for f in plan['new'])
+            self.assertEqual(names_new, ['A2.nc1', 'B.nc1'])
+            self.assertEqual(len(plan['duplicates']), 1)  # A.nc1
+            self.assertEqual(len(plan['conflicts']), 0)
+        finally:
+            shutil.rmtree(d, ignore_errors=True)
+
+    def test_conflict_carries_similarity(self):
+        import tempfile as _t
+        d = _t.mkdtemp()
+        try:
+            p = write_nc1(d, 'C.nc1', 'ord1')
+            with open(p, 'rb') as fh:
+                raw = fh.read()
+            text2 = raw.decode('latin-1').replace('6000.0', '12000.0')
+            import hashlib
+            inc = {'name': 'C.nc1', 'text': text2,
+                   'hash': hashlib.sha256(text2.encode('latin-1')).hexdigest(),
+                   'size': len(text2), 'ctime': 0, 'mtime': 0}
+            existing = [{'name': 'C.nc1', 'hash': 'other-hash',
+                         'text': raw.decode('latin-1')}]
+            plan = plan_import([inc], existing)
+            self.assertEqual(len(plan['conflicts']), 1)
+            conf = plan['conflicts'][0]
+            self.assertGreater(conf['similarity'], 0.0)
+            self.assertLess(conf['similarity'], 1.0)
+        finally:
+            shutil.rmtree(d, ignore_errors=True)
+
+
+class TestFileInfo(unittest.TestCase):
+    def test_file_info_lines(self):
+        lines = file_info_lines({'name': 'C1.nc1', 'size': 123,
+                                 'ctime': 0, 'mtime': 0, 'order': '23-001'})
+        self.assertIn('C1.nc1', lines)
+        self.assertIn('23-001', lines)
+        self.assertIn('Created', lines)
+
+    def test_fmt_date_formats(self):
+        # epoch is representable on Windows; assert the format shape
+        out = fmt_date(0)
+        self.assertRegex(out, r'\d{4}-\d{2}-\d{2} \d{2}:\d{2}')
+
+
+class TestOrderUtilsMoved(unittest.TestCase):
+    def test_extract_order_still_works(self):
+        text = 'ST\n** C-01\n23-001\nHEA200\nAK\nv 0 0\nEN\n'
+        self.assertEqual(_extract_order(text), '23-001')
+
+    def test_replace_order_still_works(self):
+        text = 'ST\n** C-01\n23-001\nHEA200\nAK\nv 0 0\nEN\n'
+        new = _replace_order_in_text(text, 'ouahbi123')
+        self.assertIn('ouahbi123', new)
+        self.assertNotIn('23-001', new)
+
+
+if __name__ == '__main__':
+    unittest.main()
