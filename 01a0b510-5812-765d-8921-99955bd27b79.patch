+class BeltGuardShape(PlateShape):
+    """Belt guard plate with mounting holes."""
+    name = "Belt Guard"
+    category = "Special"
+    parameters = [
+        ShapeParam("Height", "height", 300.0, 5.0, 10000.0),
+        ShapeParam("Width", "width", 200.0, 5.0, 10000.0),
+        ShapeParam("Corner radius", "corner_radius", 20.0, 0.0, 5000.0),
+        ShapeParam("Hole diameter", "hole_d", 10.0, 1.0, 500.0),
+        ShapeParam("Edge distance", "edge_dist", 20.0, 1.0, 5000.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        w, h = p["width"], p["height"]
+        cr = min(p["corner_radius"], w / 2, h / 2)
+        hd = p["hole_d"]
+        ed = min(p["edge_dist"], w / 2 - hd / 2, h / 2 - hd / 2)
+        if cr < 0.5:
+            outer = [(-w / 2, -h / 2), (w / 2, -h / 2),
+                     (w / 2, h / 2), (-w / 2, h / 2)]
+        else:
+            corners = [
+                (w / 2 - cr, -(h / 2 - cr), 0, -90),
+                (-(w / 2 - cr), -(h / 2 - cr), -90, -180),
+                (-(w / 2 - cr), h / 2 - cr, 180, 90),
+                (w / 2 - cr, h / 2 - cr, 90, 0),
+            ]
+            outer = []
+            for cx, cy, a_start, a_end in corners:
+                outer.extend(_arc_pts(cx, cy, cr, a_start, a_end, 8))
+        holes = [
+            {'x': -w / 2 + ed, 'y': -h / 2 + ed, 'd': hd},
+            {'x': w / 2 - ed, 'y': -h / 2 + ed, 'd': hd},
+            {'x': w / 2 - ed, 'y': h / 2 - ed, 'd': hd},
+            {'x': -w / 2 + ed, 'y': h / 2 - ed, 'd': hd},
+        ]
+        return ShapeResult(outer=outer, holes=holes)
