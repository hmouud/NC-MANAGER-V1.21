@@ -0,0 +1,139 @@
+"""CAD Command Bar / Silent HUD Prompt for Interactive Modeling.
+
+Provides an AutoCAD/Tekla-style silent prompt without any modal popups:
+- Step-by-step instruction label
+- Inline value input field with Enter key confirmation
+- Cancel / Escape support
+- Floating overlay or toolbar embedding
+"""
+from __future__ import annotations
+
+from typing import Optional
+
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtWidgets import (
+    QWidget, QHBoxLayout, QLabel, QLineEdit, QPushButton, QFrame,
+)
+
+from nccorrection.ui._colors import C
+
+
+class CadHudPrompt(QFrame):
+    """Silent HUD prompt line for multi-step CAD tools (e.g. Create Cut, Measure, Draw)."""
+
+    value_entered = Signal(float)
+    coords_entered = Signal(float, float)
+    cancelled = Signal()
+
+    def __init__(self, parent: Optional[QWidget] = None):
+        super().__init__(parent)
+        self.setFixedHeight(34)
+        self.setStyleSheet(f"""
+            QFrame {{
+                background-color: {C.panel2};
+                border: 1px solid {C.accent};
+                border-radius: 4px;
+                padding: 2px 8px;
+            }}
+            QLabel {{
+                color: {C.txt};
+                font-family: 'Consolas', 'Courier New', monospace;
+                font-size: 11px;
+                font-weight: bold;
+            }}
+            QLineEdit {{
+                background-color: {C.card};
+                color: #ffffff;
+                border: 1px solid {C.line};
+                border-radius: 3px;
+                padding: 2px 6px;
+                font-family: 'Consolas', monospace;
+                font-size: 11px;
+            }}
+            QLineEdit:focus {{
+                border-color: {C.accent};
+            }}
+            QPushButton {{
+                background-color: transparent;
+                color: {C.mut};
+                border: 1px solid {C.line};
+                border-radius: 3px;
+                padding: 2px 8px;
+                font-size: 10px;
+            }}
+            QPushButton:hover {{
+                background-color: {C.panel};
+                color: {C.txt};
+            }}
+        """)
+
+        layout = QHBoxLayout(self)
+        layout.setContentsMargins(6, 2, 6, 2)
+        layout.setSpacing(8)
+
+        # Status icon / command prefix
+        self.prefix_label = QLabel("CMD:")
+        self.prefix_label.setStyleSheet(f"color: {C.accent}; font-weight: bold;")
+        layout.addWidget(self.prefix_label)
+
+        # Instruction message
+        self.prompt_label = QLabel("Ready")
+        layout.addWidget(self.prompt_label, 1)
+
+        # Value input
+        self.input_edit = QLineEdit()
+        self.input_edit.setFixedWidth(90)
+        self.input_edit.setPlaceholderText("Value (mm)")
+        self.input_edit.returnPressed.connect(self._on_return_pressed)
+        layout.addWidget(self.input_edit)
+
+        # Cancel button
+        self.cancel_btn = QPushButton("Esc")
+        self.cancel_btn.setToolTip("Cancel active command (Esc)")
+        self.cancel_btn.clicked.connect(self.cancelled.emit)
+        layout.addWidget(self.cancel_btn)
+
+        self.hide()  # Initially hidden until a tool is activated
+
+    def start_prompt(self, prefix: str, message: str, initial_val: str = "") -> None:
+        """Show HUD with message and focus the input."""
+        self.prefix_label.setText(f"[{prefix.upper()}]:")
+        self.prompt_label.setText(message)
+        self.input_edit.setText(initial_val)
+        self.show()
+        self.input_edit.setFocus()
+        self.input_edit.selectAll()
+
+    def update_prompt(self, message: str, new_val: str = "") -> None:
+        """Update instruction text and value silently."""
+        self.prompt_label.setText(message)
+        if new_val:
+            self.input_edit.setText(new_val)
+            self.input_edit.selectAll()
+
+    def end_prompt(self) -> None:
+        """Hide HUD bar."""
+        self.input_edit.clear()
+        self.hide()
+
+    def _on_return_pressed(self) -> None:
+        text = self.input_edit.text().strip()
+        if not text:
+            return
+        # Check if coordinates pair 'x, y'
+        if ',' in text:
+            parts = text.split(',')
+            try:
+                x = float(parts[0].strip())
+                y = float(parts[1].strip())
+                self.coords_entered.emit(x, y)
+                self.input_edit.clear()
+                return
+            except ValueError:
+                pass
+        try:
+            val = float(text)
+            self.value_entered.emit(val)
+            self.input_edit.clear()
+        except ValueError:
+            pass
