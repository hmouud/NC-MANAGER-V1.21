+++ b/src/nccorrection/engine/drawing_tools/canvas/entities.py
@@ -0,0 +1,133 @@
+"""Drawing entities — data types for the 2D drawing canvas.
+
+Each entity (Line, Arc, Hole, Rectangle, Circle) is a pure data object
+that knows how to compute its geometry but does NOT touch the QGraphicsScene.
+Rendering is handled by the canvas widget.
+"""
+from __future__ import annotations
+
+import math
+from enum import Enum, auto
+from typing import List, Optional, Tuple
+
+from PySide6.QtWidgets import QGraphicsItem
+
+
+# ────────────────────────────────────────────────────────────────────
+# Types
+# ────────────────────────────────────────────────────────────────────
+
+Contour = List[Tuple[float, float]]
+
+
+class Tool(Enum):
+    SELECT = auto()
+    LINE = auto()
+    ARC = auto()
+    HOLE = auto()
+    RECTANGLE = auto()
+    CIRCLE = auto()
+    FILLET = auto()
+    DIMENSION = auto()
+
+
+# ────────────────────────────────────────────────────────────────────
+# Base entity
+# ────────────────────────────────────────────────────────────────────
+
+class DrawEntity:
+    """Base for a drawing entity stored in the scene."""
+    def __init__(self, kind: str):
+        self.kind = kind
+        self.points: List[Tuple[float, float]] = []
+        self._item: Optional[QGraphicsItem] = None
+
+    @property
+    def item(self) -> Optional[QGraphicsItem]:
+        return self._item
+
+    @item.setter
+    def item(self, val: QGraphicsItem):
+        self._item = val
+
+    def start_point(self) -> Optional[Tuple[float, float]]:
+        return self.points[0] if self.points else None
+
+    def end_point(self) -> Optional[Tuple[float, float]]:
+        return self.points[-1] if self.points else None
+
+
+# ────────────────────────────────────────────────────────────────────
+# Concrete entities
+# ────────────────────────────────────────────────────────────────────
+
+class LineEntity(DrawEntity):
+    def __init__(self, p1: Tuple[float, float], p2: Tuple[float, float]):
+        super().__init__("line")
+        self.points = [p1, p2]
+
+
+class ArcEntity(DrawEntity):
+    def __init__(self, center: Tuple[float, float], radius: float,
+                 start_angle: float, end_angle: float):
+        super().__init__("arc")
+        self.center = center
+        self.radius = radius
+        self.start_angle = start_angle  # degrees
+        self.end_angle = end_angle      # degrees
+
+    def arc_points(self, n: int = 32) -> List[Tuple[float, float]]:
+        """Flatten arc to N points."""
+        cx, cy = self.center
+        r = self.radius
+        a0 = math.radians(self.start_angle)
+        a1 = math.radians(self.end_angle)
+        return [(cx + r * math.cos(a0 + (a1 - a0) * i / n),
+                 cy + r * math.sin(a0 + (a1 - a0) * i / n))
+                for i in range(n + 1)]
+
+    def start_point(self):
+        pts = self.arc_points(2)
+        return pts[0] if pts else None
+
+    def end_point(self):
+        pts = self.arc_points(2)
+        return pts[-1] if pts else None
+
+
+class HoleEntity(DrawEntity):
+    def __init__(self, center: Tuple[float, float], diameter: float):
+        super().__init__("hole")
+        self.center = center
+        self.diameter = diameter
+
+    def start_point(self):
+        return self.center
+
+    def end_point(self):
+        return self.center
+
+
+class RectEntity(DrawEntity):
+    def __init__(self, p1: Tuple[float, float], p2: Tuple[float, float]):
+        super().__init__("rect")
+        self.points = [p1, p2]
+
+    def contour(self) -> Contour:
+        x1, y1 = self.points[0]
+        x2, y2 = self.points[1]
+        return [(x1, y1), (x2, y1), (x2, y2), (x1, y2), (x1, y1)]
+
+
+class CircleEntity(DrawEntity):
+    def __init__(self, center: Tuple[float, float], radius: float):
+        super().__init__("circle")
+        self.center = center
+        self.radius = radius
+
+    def contour(self, n: int = 64) -> Contour:
+        cx, cy = self.center
+        r = self.radius
+        return [(cx + r * math.cos(2 * math.pi * i / n),
+                 cy + r * math.sin(2 * math.pi * i / n))
+                for i in range(n)]
diff --git a/src/nccorrection/engine/drawing_tools/canvas/snap.py b/src/nccorrection/engine/drawing_tools/canvas/snap.py
