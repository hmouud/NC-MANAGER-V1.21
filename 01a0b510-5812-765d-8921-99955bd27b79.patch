+qt_viewer_3d.py — key new method (final signed-depth form):
+
+```python
+def pick_dstv(self, pos):
+    st = (self._geometry or {}).get('st') or {}
+    st_type = (st.get('type') or 'B').upper()
+    dims = st.get('dims') or []
+    thickness = float(st.get('thickness') or 10.0)
+    length = self._dstv_length()
+    hit = self._pick_facet(pos)
+    if hit is None:
+        return None
+    pt3, _nrm = hit
+    t = (st_type or '').upper()
+    flat = t not in ('I', 'C', 'U', 'L')
+    best, best_key = None, None
+    for face in real_faces(st_type):
+        fr = frame(st_type, dims, length, thickness, face)
+        x, y = fr.from_3d(pt3)
+        x0, x1, y0, y1 = self._face_extent(st_type, dims, thickness, face)
+        if not (x0 - self._DSTV_TOL <= x <= x1 + self._DSTV_TOL and
+                y0 - self._DSTV_TOL <= y <= y1 + self._DSTV_TOL):
+            continue
+        d = ((pt3[0] - fr.anchor[0]) * fr.normal[0]
+             + (pt3[1] - fr.anchor[1]) * fr.normal[1]
+             + (pt3[2] - fr.anchor[2]) * fr.normal[2])
+        key = (-d, 0.0) if flat else (abs(d), -d)
+        if best_key is None or key < best_key:
+            best_key, best = key, (face, float(x), float(y))
+    return best
+```
+
+renderer_2d.py — `dstv_point_at`:
+
+```python
+def dstv_point_at(self, sx, sy, tol=1.0):
+    canvases = list(self._snap_canvases())
+    if not canvases:
+        return None
+    if len(canvases) == 1:
+        code, _face, _scale, _tc, fc = canvases[0]
+        x, y = fc(sx, sy)
+        return code, float(x), float(y)
+    for code, face, _scale, tc, fc in canvases:
+        bx0, by0, bx1, by1 = self._face_box(face)
+        p1 = tc(bx0, by0); p2 = tc(bx1, by1)
+        sx0 = min(p1[0], p2[0]) - 2.0; sx1 = max(p1[0], p2[0]) + 2.0
+        sy0 = min(p1[1], p2[1]) - 2.0; sy1 = max(p1[1], p2[1]) + 2.0
+        if not (sx0 <= sx <= sx1 and sy0 <= sy <= sy1):
+            continue
+        x, y = fc(sx, sy)
+        outer = getattr(face, 'outer_contour', None)
+        if outer is None or not outer.vertices:
+            return code, float(x), float(y)
+        xs = [v.x for v in outer.vertices]; ys = [v.y for v in outer.vertices]
+        if (min(xs) - tol <= x <= max(xs) + tol and
+                min(ys) - tol <= y <= max(ys) + tol):
+            return code, float(x), float(y)
+    return None
+```
