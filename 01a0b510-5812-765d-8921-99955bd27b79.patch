+    def _ask_folder_conflict(self, rec, existing=None):
+        """Deferred same-name conflict (owner law): the message ALWAYS
+        appears with the file info (creation + modification dates) and the
+        three choices: Replace / Ignore / Compare. ``existing`` may be passed
+        explicitly (move/copy target row) - otherwise the existing row is
+        looked up by file name in ``self.files`` (import flow)."""
+        if existing is None:
+            existing = None
+            for f in self.files:
+                if f.get('name') == rec.get('name'):
+                    existing = f
+                    break
+            if existing is None:
+                for f in self.files:
+                    if f.get('name', '').lower() == rec.get('name', '').lower():
+                        existing = f
+                        break
+        ex_lines = ''
+        if existing is not None:
+            try:
+                st = os.stat(existing.get('path', ''))
+            except OSError:
+                st = None
+            ex_lines = file_info_lines({
+                'name': existing.get('name', '?'),
+                'size': st.st_size if st else '?',
+                'ctime': st.st_ctime if st else 0,
+                'mtime': st.st_mtime if st else 0,
+                'order': existing.get('order', ''),
+            })
+        sim = 100
+        if existing is not None and existing.get('text'):
+            sim = int(self.projects.similarity(
+                existing.get('text', ''), rec.get('text', '')) * 100)
+        box = QMessageBox(self)
+        box.setWindowTitle(self.tr_('import_conflict_title'))
+        box.setText(self.tr_('import_conflict_msg').format(
+            incoming=file_info_lines(rec),
+            existing=ex_lines or '(no file info)',
+            sim=sim))
+        replace_btn = box.addButton(self.tr_('conflict_replace'),
+                                    QMessageBox.AcceptRole)
+        ignore_btn = box.addButton(self.tr_('conflict_ignore'),
+                                   QMessageBox.RejectRole)
+        compare_btn = box.addButton(self.tr_('conflict_compare'),
+                                    QMessageBox.ActionRole)
+        box.exec()
+        clicked = box.clickedButton()
+        if clicked == ignore_btn:
+            return 'ignore'
+        if clicked == replace_btn:
+            return 'replace'
+        if clicked == compare_btn:
+            return self._ask_compare_files(rec, existing)
+        return 'ignore'
+
+    def _ask_compare_files(self, rec, existing):
+        """Side-by-side text comparison of the two conflicting files with
+        the similarity; the user then decides Replace or Ignore."""
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('compare_title'))
+        dlg.resize(900, 520)
+        lay = QVBoxLayout(dlg)
+        head = QLabel(self.tr_('import_conflict_msg').format(
+            incoming=file_info_lines(rec),
+            existing=file_info_lines(existing or {}),
+            sim='100'), dlg)
+        head.setWordWrap(True)
+        lay.addWidget(head)
+        h = QHBoxLayout()
+        for label, text in (('IN', rec.get('text', '')),
+                            ('EX', (existing or {}).get('text', ''))):
+            box = QVBoxLayout()
+            box.addWidget(QLabel(label, dlg))
+            ed = QTextEdit(dlg)
+            ed.setReadOnly(True)
+            ed.setPlainText(text)
+            box.addWidget(ed)
+            h.addLayout(box)
+        lay.addLayout(h)
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        rep = QPushButton(self.tr_('compare_replace'), dlg)
+        rep.setObjectName('green')
+        ign = QPushButton(self.tr_('compare_ignore'), dlg)
+        rep.clicked.connect(dlg.accept)
+        ign.clicked.connect(dlg.reject)
+        btns.addWidget(rep)
+        btns.addWidget(ign)
+        lay.addLayout(btns)
+        if dlg.exec() == QDialog.Accepted:
+            return 'replace'
+        return 'ignore'
+
+    def _add_files_direct(self, paths):
+        added, skipped = 0, 0
+        existing_paths = {f['path'] for f in self.files}
+        existing_hashes = {f['hash'] for f in self.files}
+        total = len(paths)
+        progress = None
+        if total > 40:
+            progress = QProgressDialog(self.tr_('loading'), self.tr_('cancel'),
+                                       0, total, self)
+            progress.setWindowModality(Qt.WindowModal)
+            progress.setMinimumDuration(400)
+            progress.setValue(0)
+        for i, path in enumerate(paths):
+            if progress is not None:
+                progress.setValue(i)
+                QApplication.processEvents()
+                if progress.wasCanceled():
+                    break
+            if path in existing_paths:
+                skipped += 1
+                continue
+            try:
+                with open(path, 'rb') as f:
+                    raw = f.read()
+                text = raw.decode('latin-1')
+                h = compute_hash(raw)
+                if h in existing_hashes:
+                    skipped += 1
+                    continue
+                c = classify_text(text, os.path.basename(path))
+                rec = self._make_record(path, text, h, c)
+                if self.settings.get_si_en_mode() == 'auto':
+                    new_text, _ = ensure_si_en(text, os.path.splitext(os.path.basename(path))[0])
+                    if new_text != text:
+                        rec['text'] = new_text
+                        rec['si'] = True
+                self.files.append(rec)
+                existing_paths.add(path)
+                existing_hashes.add(h)
+                added += 1
+                # Parse geometry and store faces for dynamic resolution
+                try:
+                    from nccorrection.core.viewer import parse_geometry
+                    g = parse_geometry(rec['text'])
+                    faces = g.get('contour_faces') or []
+                    if faces:
+                        self.parsed_parts[h] = {'faces': list(set(faces))}
+                except Exception as e:
+                    self._report_error('add-files-geometry-faces', e)
+                    pass
+            except Exception as e:
+                self._set_status(f'Error: {os.path.basename(path)}: {e}')
+        if progress is not None:
+            progress.setValue(total)
+            progress.close()
+        self._render_table()
+        self._refresh_order_combo()
+        # P2: freshly added files are new unsaved work -> tinted this session.
+        self._session_edited.update(rec['hash'] for rec in self.files
+                                    if rec.get('hash') not in self._saved_hashes)
+        self._set_status(f'+{added} ' + self.tr_('added') + (f' / {skipped} ' + self.tr_('skipped') if skipped else ''))
+        self.audit.log(f'Added {added} NC/NC1 file(s)', 'ok' if added else 'warn', 'OK-101')
+
+    # ---------------------------------------------------------------- import
+    def _import_files_direct(self, paths):
+        """Import NC/NC1 files into the project database on every add.
+
+        Copies land in ``projects/<name>/input/`` and each record keeps the
+        original location in ``src_path`` (used by "save to original").
+        Same-name files already in the list are handled with one question per
+        stage - dialogs are never nested:
+        - identical content -> "import only the new / rewrite all"
+        - different content  -> similarity % + "rename / same file / skip"
+        """
+        if not paths:
+            return
+        if not self._current_project:
+            pname = self._ask_import_project_name()
+            if not pname:
+                self._set_status(self.tr_('import_cancelled'))
+                return
+            self._current_project = pname
+
+        incoming = []
+        existing_paths = {f['path'] for f in self.files}
+        for path in paths:
+            if path in existing_paths:
+                continue
+            try:
+                with open(path, 'rb') as fh:
+                    raw = fh.read()
+                text = raw.decode('latin-1')
+                h = compute_hash(raw)
+                c = classify_text(text, os.path.basename(path))
+                rec = self._make_record(path, text, h, c)
+                if self.settings.get_si_en_mode() == 'auto':
+                    new_text, _ = ensure_si_en(text, os.path.splitext(os.path.basename(path))[0])
+                    if new_text != text:
+                        rec['text'] = new_text
+                        rec['si'] = True
+                incoming.append(rec)
+            except Exception as e:
+                self._set_status(f'Error: {os.path.basename(path)}: {e}')
+        if not incoming:
+            return
+
+        plan = self.projects.plan_imports(self.files, incoming)
+
+        # stage 1: duplicates (identical content) - one question, own stage
+        rewrite_duplicates = False
+        if plan['duplicates']:
+            rewrite_duplicates = self._ask_import_duplicates(len(plan['duplicates']))
+
+        # stage 2: conflicts (same name, different content) - one dialog each
+        to_import = list(plan['new'])
+        replace = []
+        for conf in plan['conflicts']:
+            action = self._ask_import_conflict(conf['incoming']['name'],
+                                               conf['similarity'])
+            if action == 'rename':
+                new_name = self._ask_import_new_name(conf['incoming']['name'])
+                if new_name:
+                    inc = dict(conf['incoming'])
+                    inc['name'] = new_name
+                    to_import.append(inc)
+            elif action == 'overwrite':
+                replace.append((conf['incoming'], conf['existing']))
+            # skip -> ignored
+
+        if rewrite_duplicates:
+            # rewrite = refresh the stored copies (same hash -> same file).
+            # The rows stay unique - we only re-import from the source.
+            for inc in plan['duplicates']:
+                self.projects.import_file(self._current_project, inc['path'],
+                                          inc['text'], inc['hash'])
+
+        # copy into the database and register the records
+        base = self.projects.project_path(self._current_project)
+        imported = 0
+        imported_hashes = set()
+        for inc in to_import:
+            stored = self.projects.import_file(self._current_project, inc['path'],
+                                               inc['text'], inc['hash'])
+            inc['src_path'] = inc['path']
+            inc['path'] = os.path.join(base, stored)
+            self.files.append(inc)
+            imported_hashes.add(inc['hash'])
+            imported += 1
+        for inc, existing in replace:
+            stored = self.projects.import_file(self._current_project, inc['path'],
+                                               inc['text'], inc['hash'])
+            rec = dict(inc)
+            rec['src_path'] = inc['path']
+            rec['path'] = os.path.join(base, stored)
+            for i, f in enumerate(self.files):
+                if f['hash'] == existing['hash']:
+                    self.files[i] = rec
+                    break
+            else:
+                self.files.append(rec)
+            imported_hashes.add(inc['hash'])
+            imported += 1
+
+        # P3a: foreign orders - one question, always (owner rule). The order
+        # extracted from the NC1 header may differ from the project name, so
+        # ask once whether every imported file should move to this project's
+        # order. The choice is persisted via save_project -> 'order' record.
+        if imported_hashes:
+            foreign = sorted({f.get('order') for f in self.files
+                              if f['hash'] in imported_hashes and f.get('order')
+                              and f.get('order') != self._current_project})
+            if foreign:
+                msg = (self.tr_('import_foreign_orders')
+                       .format(n=len(imported_hashes), orders=', '.join(foreign),
+                               project=self._current_project))
+                if QMessageBox.question(self, self.tr_('import_foreign_title'),
+                                        msg) == QMessageBox.Yes:
+                    for f in self.files:
+                        if f['hash'] in imported_hashes:
+                            f['order'] = self._current_project
+
+        self.projects.save_project(
+            self._current_project, self.files,
+            settings={k: self.settings.get(k) for k in
+                      ('language', 'theme', 'outputName', 'themeCustom')},
+            notes=dict(self.settings.get_all_notes() or {}),
+            hole_overrides=self.hole_overrides,
+            hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+            added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+            qty_overrides={h: f.get('qty_override') for f in self.files
+                           for h in [f['hash']] if f.get('qty_override') is not None},
+            source_folder=self._project_source_folder(),
+            orders=self.orders)
+
+        self._render_table()
+        self._refresh_order_combo()
+        # P2: imported files are now committed to the project manifest
+        # (not "new unsaved"); freshly imported rows are tinted this session.
+        # Owner rule 2026-08-20: upload a file -> the close dialog must still
+        # appear (session addition) even though the import auto-saved.
+        self._saved_hashes = {f['hash'] for f in self.files}
+        self._session_edited.update(f['hash'] for f in self.files)
+        self._session_added.update(imported_hashes)
+        self._set_status(f'+{imported} ' + self.tr_('import_done') + ' ' + self._current_project)
+        self.audit.log(f'Imported {imported} file(s) into project {self._current_project}',
+                       'ok' if imported else 'warn', 'OK-105')
+
+    def _ask_import_project_name(self):
+        from PySide6.QtWidgets import QInputDialog
+        dlg = QInputDialog(self)
+        dlg.setWindowTitle(self.tr_('import_project_title'))
+        dlg.setLabelText(self.tr_('import_project_prompt'))
+        dlg.setTextValue(self._current_project or self._project_name_from_files())
+        if dlg.exec() != QDialog.Accepted:
+            return ''
+        return (dlg.textValue() or '').strip()
+
+    def _ask_import_duplicates(self, n):
+        msg = self.tr_('import_duplicates_msg').format(n=n)
+        return QMessageBox.question(self, self.tr_('import_duplicates_title'),
+                                    msg) == QMessageBox.Yes
+
+    def _ask_import_conflict(self, name, similarity):
+        box = QMessageBox(self)
+        box.setWindowTitle(self.tr_('import_conflict_title'))
+        box.setText(self.tr_('import_conflict_msg').format(
+            name=name, sim=f'{similarity * 100:.0f}%'))
+        rename_btn = box.addButton(self.tr_('import_rename'), QMessageBox.AcceptRole)
+        same_btn = box.addButton(self.tr_('import_overwrite'), QMessageBox.AcceptRole)
+        skip_btn = box.addButton(self.tr_('import_skip'), QMessageBox.RejectRole)
+        box.exec()
+        clicked = box.clickedButton()
+        if clicked == rename_btn:
+            return 'rename'
+        if clicked == same_btn:
+            return 'overwrite'
+        return 'skip'
+
+    def _ask_import_new_name(self, old_name):
+        from PySide6.QtWidgets import QInputDialog
+        base, ext = os.path.splitext(old_name)
+        dlg = QInputDialog(self)
+        dlg.setWindowTitle(self.tr_('import_rename'))
+        dlg.setLabelText(f"{self.tr_('import_new_name')} {old_name}")
+        dlg.setTextValue(f'{base}_2{ext}')
+        if dlg.exec() != QDialog.Accepted:
+            return ''
+        return (dlg.textValue() or '').strip()
+
+    def _make_record(self, path, text, h, c):
+        try:
+            size = os.path.getsize(path)
+            modified = os.path.getmtime(path)
+        except OSError:
+            size, modified = 0, 0
+        rec = {
+            'name': os.path.basename(path), 'path': path, 'text': text, 'hash': h,
+            'src_path': path,
+            'category': c['category'], 'family': c['family'],
+            'profile': c['profile'], 'folder': c['target'],
+            'status': self.tr_('ready'), 'qty': parse_quantity(text),
+            'qty_override': None, 'o': detect_o_plane(text), 'si': has_si_en(text),
+            'size': size, 'modified': modified,
+            'steel': _extract_steel(text), 'quality': _extract_steel(text),
+            'order': _extract_order(text), 'dirty': False,
+        }
+        length_disp, weight = _part_metrics(text)
+        rec['length_mm'] = length_disp
+        rec['weight'] = round(weight, 2)
+        return rec
+
+    def _add_paths(self, paths):
+        """Add NC/NC1 files, resolving folders recursively (drop & scan support)."""
+        file_paths = []
+        for p in paths:
+            if os.path.isdir(p):
+                for dirpath, dirnames, filenames in os.walk(p):
+                    dirnames[:] = [d for d in dirnames if not d.startswith('.')]
+                    for fname in filenames:
+                        if fname.lower().endswith(('.nc', '.nc1')):
+                            file_paths.append(os.path.join(dirpath, fname))
+            elif os.path.isfile(p) and p.lower().endswith(('.nc', '.nc1')):
+                file_paths.append(p)
+        self._add_files_direct(file_paths)
+
+    def dragEnterEvent(self, event):
+        if event.mimeData().hasUrls():
+            event.acceptProposedAction()
+        else:
+            event.ignore()
+
+    def dragMoveEvent(self, event):
+        if event.mimeData().hasUrls():
+            event.acceptProposedAction()
+        else:
+            event.ignore()
+
+    def dropEvent(self, event):
+        paths = [u.toLocalFile() for u in event.mimeData().urls() if u.isLocalFile()]
+        if paths:
+            self._add_paths(paths)
+            event.acceptProposedAction()
+        else:
+            event.ignore()
