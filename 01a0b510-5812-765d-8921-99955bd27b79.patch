+"""constants.py — Magic numbers and tolerances.
+
+🚨 GUARDIAN LAW: No magic numbers scattered in the code.
+كل رقم خاصو يكون هنا، مسمّى، و موثّق.
+"""
+from __future__ import annotations
+import math
+
+# ─── Tolerances ──────────────────────────────────────────────
+TOLERANCE_MM: float = 0.01
+TOLERANCE_DEG: float = 1e-6
+EPSILON: float = 1e-9
+
+# ─── Math ────────────────────────────────────────────────────
+DEG_TO_RAD: float = math.pi / 180.0
+RAD_TO_DEG: float = 180.0 / math.pi
+
+# ─── Cut Angle Ranges ────────────────────────────────────────
+MIN_CUT_ANGLE: float = -180.0
+MAX_CUT_ANGLE: float = 180.0
+
+# ─── Header Layout (indices for ST block dims) ───────────────
+IDX_LENGTH: int = 0
+IDX_DEPTH: int = 1      # H (depth/height)
+IDX_WIDTH: int = 2      # b (flange width)
+IDX_FLANGE_THICK: int = 3  # tf
+IDX_WEB_THICK: int = 4   # tw
+IDX_ROOT_RADIUS: int = 5  # r
+IDX_STEG_FRONT: int = 8
+IDX_STEG_REAR: int = 9
+IDX_FLANGE_FRONT: int = 10
+IDX_FLANGE_REAR: int = 11
+
+MIN_HEADER_FIELDS: int = 6
+FULL_HEADER_FIELDS: int = 12
