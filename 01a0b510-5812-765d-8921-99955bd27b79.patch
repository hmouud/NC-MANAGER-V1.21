@@ -0,0 +1,413 @@
+import difflib
+import hashlib
+import json
+import os
+import shutil
+from datetime import datetime
+
+
+PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
+PROJECTS_DIR = os.path.join(PROJECT_ROOT, 'projects')
+
+
+class ProjectService:
+    """Manage NC Manager projects.
+
+    A project is a named folder inside the program's ``projects/`` directory.
+    It keeps a copy of every loaded NC file (``input/``), a mirror of the last
+    sort output (``sorted/``), and a ``project.json`` manifest with the file
+    list, settings, notes and hole-diameter overrides. The originals can be
+    deleted afterwards - the program can always restore and re-sort.
+    """
+
+    MANIFEST = 'project.json'
+
+    def __init__(self, projects_dir=None):
+        self._dir = projects_dir or PROJECTS_DIR
+        os.makedirs(self._dir, exist_ok=True)
+
+    # ---------------------------------------------------------------- helpers
+    @property
+    def projects_dir(self):
+        return self._dir
+
+    def project_path(self, name):
+        return os.path.join(self._dir, name)
+
+    def manifest_path(self, name):
+        return os.path.join(self.project_path(name), self.MANIFEST)
+
+    def exists(self, name):
+        return os.path.isfile(self.manifest_path(name))
+
+    def _sanitize(self, name):
+        name = (name or '').strip()
+        invalid = '<>:"/\\|?*'
+        for ch in invalid:
+            name = name.replace(ch, '_')
+        return name or 'project'
+
+    def _sanitize_file(self, name):
+        """Sanitize a display file name for storage. The sanitized name is
+        ONLY the storage name - the record keeps the ORIGINAL display name."""
+        name = (name or '').strip()
+        invalid = '<>:"/\\|?*'
+        for ch in invalid:
+            name = name.replace(ch, '_')
+        return name or 'file.nc1'
+
+    def _write_json(self, path, data):
+        tmp = path + '.tmp'
+        with open(tmp, 'w', encoding='utf-8') as f:
+            json.dump(data, f, indent=2, ensure_ascii=False)
+        os.replace(tmp, path)
+
+    def _read_json(self, path):
+        try:
+            with open(path, 'r', encoding='utf-8') as f:
+                return json.load(f)
+        except (OSError, json.JSONDecodeError):
+            return None
+
+    # ---------------------------------------------------------------- listing
+    def list_projects(self):
+        """Return a list of dicts: name, created, updated, file_count, size."""
+        result = []
+        try:
+            names = sorted(os.listdir(self._dir))
+        except OSError:
+            return result
+        for name in names:
+            mpath = self.manifest_path(name)
+            if not os.path.isfile(mpath):
+                continue
+            manifest = self._read_json(mpath) or {}
+            result.append({
+                'name': manifest.get('name', name),
+                'created': manifest.get('created', ''),
+                'updated': manifest.get('updated', ''),
+                'source_folder': manifest.get('source_folder', ''),
+                'file_count': len(manifest.get('files', [])),
+                'manifest': manifest,
+            })
+        return result
+
+    # ---------------------------------------------------------------- save
+    def save_project(self, name, files, settings=None, notes=None,
+                     hole_overrides=None, qty_overrides=None, source_folder='',
+                     hole_deleted=None, added_holes=None, orders=None):
+        """Copy the loaded files into a project folder and write the manifest.
+
+        ``orders``: list of order names that exist in the project even when
+        they currently hold zero files (empty orders survive restarts).
+        """
+        name = self._sanitize(name)
+        base = self.project_path(name)
+        os.makedirs(base, exist_ok=True)
+
+        existing = self._read_json(self.manifest_path(name)) or {}
+        manifest_files = {f['hash']: f for f in existing.get('files', [])}
+
+        # The input/ subfolder is LEGACY (P1 hash storage) - only create it
+        # when the project still has legacy records (owner law 2026-08-19:
+        # new projects store flat, NO hash paths, NO input/ folder).
+        needs_input = any(
+            (f.get('stored') or '').startswith('input/')
+            or (f.get('hash') in manifest_files
+                and manifest_files[f.get('hash')].get('stored', '')
+                .startswith('input/'))
+            for f in files)
+        if needs_input:
+            os.makedirs(os.path.join(base, 'input'), exist_ok=True)
+
+        manifest = {
+            'name': name,
+            'created': existing.get('created') or datetime.now().strftime('%Y-%m-%d %H:%M'),
+            'updated': datetime.now().strftime('%Y-%m-%d %H:%M'),
+            'source_folder': source_folder or existing.get('source_folder', ''),
+            'settings': settings or existing.get('settings') or {},
+            'notes': notes or existing.get('notes') or {},
+            'hole_overrides': hole_overrides or existing.get('hole_overrides') or {},
+            'hole_deleted': hole_deleted or existing.get('hole_deleted') or {},
+            'added_holes': added_holes or existing.get('added_holes') or {},
+            'qty_overrides': qty_overrides or existing.get('qty_overrides') or {},
+            'orders': orders if orders is not None else existing.get('orders', []),
+            'files': [],
+            'sorts': existing.get('sorts', []),
+        }
+
+        # A file record is unique per (display name, order): the SAME part can
+        # belong to several orders ("copy to"), each as its own row.
+        # Storage: NEW projects store flat under the ORIGINAL display name
+        # (owner law: no hash names); LEGACY projects keep their existing
+        # input/<hash>.nc1 stored paths until an explicit migration step.
+        written = set()
+        for f in files:
+            h = f.get('hash') or ''
+            key = (f.get('name'), f.get('order'))
+            if key in written:
+                continue
+            written.add(key)
+            ext = os.path.splitext(os.path.basename(f.get('path', '')))[1] or '.nc1'
+            legacy = f.get('stored')
+            if not legacy and h in manifest_files \
+                    and manifest_files[h].get('stored', '').startswith('input/'):
+                legacy = manifest_files[h]['stored']
+            if legacy and legacy.startswith('input/'):
+                stored = legacy
+            else:
+                stored = self._sanitize_file(f.get('name')
+                                             or os.path.basename(f.get('path', '')))
+                # A stored copy may live under a SUFFIXED flat name when a
+                # copy was made inside the same project folder (owner law:
+                # ``C1_2.nc1`` - same display name, own stored file). Keep the
+                # row's ACTUAL stored file - re-mapping it to the bare display
+                # name would CLOBBER the original row's stored copy on save.
+                base_dir = os.path.abspath(base) + os.sep
+                cur = os.path.abspath(f.get('path', ''))
+                if cur.startswith(base_dir):
+                    cur_rel = cur[len(base_dir):]
+                    if cur_rel != stored:
+                        stored = cur_rel
+            src = f.get('path', '')
+            dst = os.path.join(base, stored)
+            try:
+                if os.path.abspath(src) != os.path.abspath(dst) and os.path.isfile(src):
+                    shutil.copy2(src, dst)
+            except OSError:
+                if not os.path.isfile(dst):
+                    continue
+            record = {
+                'stored': stored,
+                'name': f.get('name'),
+                'hash': h,
+                'dirty': bool(f.get('dirty')),
+                'category': f.get('category'),
+                'family': f.get('family'),
+                'profile': f.get('profile'),
+                'folder': f.get('folder'),
+                'qty': f.get('qty'),
+                'qty_override': f.get('qty_override'),
+                'o': f.get('o'),
+                'si': f.get('si'),
+                'order': f.get('order'),
+            }
+            if f.get('src_path'):
+                record['src_path'] = f['src_path']
+            if h in manifest_files and manifest_files[h].get('stored') == stored:
+                record['stored'] = manifest_files[h]['stored']
+            manifest['files'].append(record)
+
+        self._write_json(self.manifest_path(name), manifest)
+        return name
+
+    # ---------------------------------------------------------------- load
+    def load_project(self, name):
+        """Return the manifest dict for a project (None if missing)."""
+        return self._read_json(self.manifest_path(name))
+
+    def load_files(self, name):
+        """Return a list of file records whose path points into the project."""
+        manifest = self.load_project(name)
+        if not manifest:
+            return None, None
+        base = self.project_path(name)
+        records = []
+        for f in manifest.get('files', []):
+            path = os.path.join(base, f.get('stored', ''))
+            if not os.path.isfile(path):
+                continue
+            try:
+                with open(path, 'rb') as fh:
+                    raw = fh.read()
+                text = raw.decode('latin-1')
+            except (OSError, UnicodeDecodeError):
+                continue
+            records.append({**f, 'path': path, 'text': text})
+        return manifest, records
+
+    def delete_project(self, name):
+        base = self.project_path(name)
+        if os.path.isdir(base):
+            shutil.rmtree(base, ignore_errors=True)
+            return True
+        return False
+
+    # ---------------------------------------------------------------- import
+    @staticmethod
+    def similarity(a, b):
+        """Similarity ratio (0.0..1.0) between two NC1 texts."""
+        if not a or not b:
+            return 0.0
+        if a == b:
+            return 1.0
+        return difflib.SequenceMatcher(None, a, b).ratio()
+
+    def plan_imports(self, existing, incoming):
+        """Classify incoming files against already-loaded records.
+
+        ``existing``: list of records (each with ``name``, ``hash``).
+        ``incoming``: list of dicts (each with ``name``, ``hash``, ``text``).
+
+        Returns a dict with three lists:
+        - ``new``: name not present at all.
+        - ``duplicates``: same name AND identical hash (already imported).
+        - ``conflicts``: same name, different content. Each entry carries the
+          incoming file plus ``similarity`` (0.0..1.0) and ``existing`` record.
+        """
+        by_name = {}
+        for rec in existing:
+            by_name.setdefault(rec.get('name'), []).append(rec)
+
+        plan = {'new': [], 'duplicates': [], 'conflicts': []}
+        for inc in incoming:
+            same_name = by_name.get(inc.get('name'), [])
+            if not same_name:
+                plan['new'].append(inc)
+                continue
+            if any(r.get('hash') == inc.get('hash') for r in same_name):
+                plan['duplicates'].append(inc)
+                continue
+            plan['conflicts'].append({
+                'incoming': inc,
+                'existing': same_name[0],
+                'similarity': self.similarity(
+                    same_name[0].get('text', ''), inc.get('text', '')),
+            })
+        return plan
+
+    def import_file(self, name, src_path, text, file_hash):
+        """Copy a single file into projects/<name>/input/ and return the
+        stored relative path (e.g. ``input/<hash>.nc1``).
+
+        LEGACY (P1 flow) - kept for backward compatibility. New imports use
+        :meth:`store_copy` (flat, original file name, no hash in the path).
+        """
+        name = self._sanitize(name)
+        base = self.project_path(name)
+        input_dir = os.path.join(base, 'input')
+        os.makedirs(input_dir, exist_ok=True)
+        ext = os.path.splitext(os.path.basename(src_path))[1] or '.nc1'
+        stored = f'input/{file_hash}{ext}'
+        dst = os.path.join(base, stored)
+        if os.path.isfile(src_path):
+            shutil.copy2(src_path, dst)
+        else:
+            with open(dst, 'w', encoding='latin-1', newline='') as fh:
+                fh.write(text)
+        return stored
+
+    def store_copy(self, name, display_name, src_path, text, file_hash,
+                   overwrite=False):
+        """Store one imported file in ``projects/<name>/`` under its ORIGINAL
+        display name - flat, NO hash in the path (owner law 2026-08-19).
+
+        Returns ``(stored_rel_path, status)``:
+        - ``'ok'``: freshly written (or overwritten when ``overwrite``).
+        - ``'duplicate'``: a file with the same name AND identical content
+          already exists - nothing written.
+        - ``'conflict'``: a file with the same name but DIFFERENT content
+          exists - nothing written unless ``overwrite`` is True.
+        ``text`` is written verbatim (it may already carry the rewritten
+        order header chosen by the user). The duplicate/conflict decision
+        compares the EXACT bytes of ``text`` against the stored file - the
+        caller's ``file_hash`` is kept for the record but the comparison
+        never depends on it (the header may have been rewritten).
+        """
+        name = self._sanitize(name)
+        base = self.project_path(name)
+        os.makedirs(base, exist_ok=True)
+        stored = self._sanitize_file(display_name)
+        dst = os.path.join(base, stored)
+        text_hash = hashlib.sha256(text.encode('latin-1')).hexdigest()
+        if os.path.isfile(dst):
+            try:
+                with open(dst, 'rb') as fh:
+                    existing_hash = hashlib.sha256(fh.read()).hexdigest()
+            except OSError:
+                existing_hash = ''
+            if existing_hash == text_hash:
+                return stored, 'duplicate'
+            if not overwrite:
+                return stored, 'conflict'
+        with open(dst, 'w', encoding='latin-1', newline='') as fh:
+            fh.write(text)
+        return stored, 'ok'
+
+    # ---------------------------------------------------------------- sort backup
+    def backup_sorted(self, name, results, source_folder=''):
+        """Mirror a finished sort into projects/<name>/sorted/<folder>/."""
+        name = self._sanitize(name)
+        base = self.project_path(name)
+        sorted_dir = os.path.join(base, 'sorted')
+        input_dir = os.path.join(base, 'input')
+        os.makedirs(sorted_dir, exist_ok=True)
+        os.makedirs(input_dir, exist_ok=True)
+
+        manifest = self._read_json(self.manifest_path(name)) or {
+            'name': name,
+            'created': datetime.now().strftime('%Y-%m-%d %H:%M'),
+        }
+        manifest.setdefault('updated', datetime.now().strftime('%Y-%m-%d %H:%M'))
+        manifest.setdefault('source_folder', source_folder)
+        manifest.setdefault('settings', {})
+        manifest.setdefault('notes', {})
+        manifest.setdefault('hole_overrides', {})
+        manifest.setdefault('qty_overrides', {})
+        manifest.setdefault('files', [])
+        sorts = manifest.setdefault('sorts', [])
+
+        copied = 0
+        for r in results:
+            if not r.get('ok') or r.get('action') not in ('MOVE', 'COPY'):
+                continue
+            src = r.get('src', '')
+            dest = r.get('dest', '')
+            folder = r.get('folder', 'UNKNOWN')
+            name_part = r.get('dest_name') or os.path.basename(dest)
+            target = os.path.join(sorted_dir, folder, name_part)
+            try:
+                os.makedirs(os.path.dirname(target), exist_ok=True)
+                if os.path.isfile(dest):
+                    shutil.copy2(dest, target)
+                    copied += 1
+                elif os.path.isfile(src):
+                    shutil.copy2(src, target)
+                    copied += 1
+            except OSError:
+                continue
+
+        sorts.append({
+            'date': datetime.now().strftime('%Y-%m-%d %H:%M'),
+            'summary': 'backup_sorted',
+            'copied': copied,
+        })
+        manifest['updated'] = datetime.now().strftime('%Y-%m-%d %H:%M')
+        self._write_json(self.manifest_path(name), manifest)
+        return copied
+
+    def update_manifest(self, name, settings=None, notes=None,
+                        hole_overrides=None, qty_overrides=None, source_folder=None,
+                        hole_deleted=None, added_holes=None, orders=None):
+        manifest = self._read_json(self.manifest_path(name))
+        if not manifest:
+            return False
+        if settings is not None:
+            manifest['settings'] = settings
+        if notes is not None:
+            manifest['notes'] = notes
+        if hole_overrides is not None:
+            manifest['hole_overrides'] = hole_overrides
+        if hole_deleted is not None:
+            manifest['hole_deleted'] = hole_deleted
+        if added_holes is not None:
+            manifest['added_holes'] = added_holes
+        if qty_overrides is not None:
+            manifest['qty_overrides'] = qty_overrides
+        if source_folder is not None:
+            manifest['source_folder'] = source_folder
+        if orders is not None:
+            manifest['orders'] = orders
+        manifest['updated'] = datetime.now().strftime('%Y-%m-%d %H:%M')
+        self._write_json(self.manifest_path(name), manifest)
+        return True
