+from PySide6.QtWidgets import QToolButton, QMenu
+from PySide6.QtCore import Qt, QSize
+from nccorrection.ui.components.scaling import sp, font_pt
+from nccorrection.ui.components.svg_icon import load_icon
+
+class HistoryButton(QToolButton):
+    """Icon-only split button: main area = Undo/Redo, small dropdown triangle =
+    "Undo All"/"Redo All" menu (same compact look as a music/speed control)."""
+    def __init__(self, action_type="undo", menu_label="Undo All", theme=None,
+                 parent=None):
+        super().__init__(parent)
+        self._theme = theme or {}
+        is_undo = action_type != "redo"
+
+        self.setPopupMode(QToolButton.MenuButtonPopup)
+        self.setToolButtonStyle(Qt.ToolButtonIconOnly)
+        self.setIconSize(QSize(sp(14), sp(14)))
+        self.setFixedSize(sp(32), sp(26))
+        self.setCursor(Qt.PointingHandCursor)
+
+        self.setIcon(load_icon(action_type))
+
+        # Dropdown menu revealed by the small triangle (Undo All / Redo All).
+        self.menu = QMenu(self)
+        self.action_all = self.menu.addAction(menu_label)
+        self.setMenu(self.menu)
+
+        self._apply_style()
+
+    def _apply_style(self):
+        txt = self._theme.get("txt", "#e8edf6")
+        line = self._theme.get("line", "#2c3a52")
+        hover = self._theme.get("panel2", "#1b2638")
+
+        self.setStyleSheet(f"""
+            QToolButton {{
+                background: transparent;
+                border: none;
+                border-radius: {sp(3)}px;
+                padding: 0px;
+                font-size: {font_pt(10)}pt;
+            }}
+            QToolButton:hover {{
+                background: {hover};
+            }}
+            /* divider between the icon area and the dropdown triangle,
+               only visible while hovering either zone */
+            QToolButton:hover::menu-button {{
+                border-left: 1px solid {line};
+            }}
+            QToolButton::menu-button {{
+                border: none;
+                width: {sp(9)}px;
+                subcontrol-origin: padding;
+                subcontrol-position: center right;
+            }}
+            QToolButton::menu-button:hover {{
+                background: {hover};
+                border-left: 1px solid {line};
+            }}
+        """)
