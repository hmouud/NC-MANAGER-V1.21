+        hit-test: slots respect their elongated length) or None.
+
+        ``self._holes_screen`` stores (sx, sy, r, idx, slot_len, angle) from
+        _draw_shapes during paintEvent; the double-click editor and the
+        right-click hole menu share this single hit-test.
+        """
+        mx, my = pos.x(), pos.y()
+        best_idx = None
+        best_dist = 9999
+
+        for sx, sy, r, idx, slen, ang in getattr(self, '_holes_screen', []):
+            if idx is None:
