+
+    def test_unknown_garbage_bytes(self):
+        fd, path = tempfile.mkstemp(suffix='.bin')
+        with os.fdopen(fd, 'wb') as fh:
+            fh.write(bytes(range(256)) * 8)
+        try:
+            self.assertEqual(detect_format(path), 'UNKNOWN')
+        finally:
