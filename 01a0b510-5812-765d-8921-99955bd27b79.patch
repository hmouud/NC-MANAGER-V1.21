+    def clear_measurements(self):
+        """Remove every placed measurement (dimension + corner) and any
+        in-progress points (the global Refresh action calls this on every
+        viewer)."""
+        self._measurements = []
+        self._corner_measures = []
+        self._diameter_measures = []
+        self._circle_first_click = None
+        self._m1 = None
+        self._m2 = None
