index 0000000..d950e71
--- /dev/null
+++ b/src/nccorrection/core/nc1_writer.py
@@ -0,0 +1,261 @@
+"""Serialize hole edits back into NC1 (DSTV) text.
+
+The parser (``core/viewer.py``) keeps a flat ``holes`` list built from the BO
+feature lines in file order. This module maps that order back onto the raw text
+so modifications, deletions and additions can be written out while preserving
+every other line of the file byte-for-byte.
+"""
+
+import re
+import sys
+
+from nccorrection.core.viewer import NUM_RE, DSTV_BLOCKS, _face_of
+
+_FEATURE_RE = re.compile(r'^\s*([uUoOhHvV])\s+(.+)$')
+
+
+def _feature_indices(text):
+    """Return (indices, lines) where indices[i] is the file line number of the
+    i-th BO feature, and lines are the raw text lines (with endings)."""
+    lines = text.splitlines(keepends=True)
+    indices = []
+    in_bo = False
+    for i, raw in enumerate(lines):
+        stripped = raw.strip()
+        if not stripped:
+            continue
+        if stripped.upper() in DSTV_BLOCKS:
+            in_bo = stripped.upper() == 'BO'
+            continue
+        if in_bo and len(NUM_RE.findall(stripped)) >= 3:
+            indices.append(i)
+    return indices, lines
+
+
+def _format_feature(face, x, y, d, length=None, angle=None, kind=None):
+    """Format a BO feature line matching the parser's convention.
+
+    Round hole: ``face x y d`` (3 numbers). Slotted hole: ``face x y d length``
+    (4 numbers, read back as x,y,d,length). If an angle is set, a 6-number
+    variant ``face x y d 0 length angle`` is emitted (the 4th value is a
+    placeholder the parser ignores), preserving the angle on round-trip.
+
+    ``kind`` makes the output deterministic regardless of leftover values: a
+    ``kind='hole'`` always writes a 3-number line (its ``length``/``angle``
+    are dropped), while ``kind='slot'`` always writes a slot line (a missing
+    length falls back to the width). Callers that already resolved the value
+    may omit ``kind`` and rely on ``length`` alone.
+    """
+    f = face.upper()
+    if kind == 'hole':
+        return f'{f} {x:.2f} {y:.2f} {d:.2f}'
+    if kind == 'slot':
+        L = float(length or 0.0)
+        if L <= 0:
+            L = max(float(d or 1.0), 1.0)
+        if float(angle or 0.0):
+            return f'{f} {x:.2f} {y:.2f} {d:.2f} 0.00 {L:.2f} {angle:.2f}'
+        return f'{f} {x:.2f} {y:.2f} {d:.2f} {L:.2f}'
+    if length:
+        if float(angle or 0.0):
+            return f'{f} {x:.2f} {y:.2f} {d:.2f} 0.00 {length:.2f} {angle:.2f}'
+        return f'{f} {x:.2f} {y:.2f} {d:.2f} {length:.2f}'
+    return f'{f} {x:.2f} {y:.2f} {d:.2f}'
+
+
+def apply_hole_edits(text, overrides, add_holes=None):
+    """Return a new NC1 text with hole edits applied.
+
+    ``overrides`` maps a hole index (order as parsed) to ``None`` (delete the
+    hole) or a dict with any of ``{'x', 'y', 'd', 'face', 'length', 'angle'}``.
+    ``add_holes`` is a list of new hole dicts
+    ``{'face', 'x', 'y', 'd', 'length', 'angle'}`` appended as a new BO block.
+
+    Every non-BO line is preserved exactly; the number formatting of edited
+    features follows DSTV (2 decimals).
+    """
+    if not overrides and not add_holes:
+        return text
+    indices, lines = _feature_indices(text)
+    new_lines = list(lines)
+
+    for hole_idx, ov in sorted(overrides.items(), key=lambda kv: kv[0], reverse=True):
+        if hole_idx < 0 or hole_idx >= len(indices):
+            # stale override (geometry re-parsed since the overrides were
+            # recorded): raising a structured ValueError lets the caller's
+            # funnel report it instead of writing silently misaligned output
+            # (or crashing on index access).
+            raise ValueError(
+                f'nc1_writer: hole index {hole_idx} out of range '
+                f'({len(indices)} BO features parsed) - stale override set')
+        line_no = indices[hole_idx]
+        if ov is None:
+            # remove the feature line and, if the BO block becomes empty, drop it
+            new_lines[line_no] = ''
+            continue
+        if not _FEATURE_RE.match(new_lines[line_no]):
+            print(f'nc1_writer: line {line_no + 1} is no longer a feature '
+                  f'line, skipping override {hole_idx}',
+                  file=sys.stderr)
+            continue
+        match = _FEATURE_RE.match(new_lines[line_no])
+        face = ov.get('face') or match.group(1).lower()
+        nums = NUM_RE.findall(new_lines[line_no])
+        if len(nums) < 3:
+            # the permissive regex cannot guarantee the numeric payload on a
+            # malformed line: skip this override (safe empty state) instead
+            # of crashing with IndexError on nums[0].
+            print(f'nc1_writer: malformed feature line {line_no + 1} '
+                  f'({len(nums)} number(s)), skipping override {hole_idx}',
+                  file=sys.stderr)
+            continue
+        x = ov.get('x', float(nums[0]))
+        y = ov.get('y', float(nums[1]))
+        d = ov.get('d', float(nums[2]))
+        # Slot fallbacks must mirror the parser: a 6-number line is
+        #   ``face x y d <0> length angle``  (length at [4], angle at [5])
+        # while a 4-number line is ``face x y d length`` (length at [3]).
+        if len(nums) >= 6:
+            length = ov.get('length', float(nums[4]))
+            angle = ov.get('angle', float(nums[5]))
+        elif len(nums) > 3:
+            length = ov.get('length', float(nums[3]))
+            angle = ov.get('angle', 0.0)
+        else:
+            length = ov.get('length', 0.0)
+            angle = ov.get('angle', 0.0)
+        kind = ov.get('kind')
+        if kind == 'hole':
+            length = 0.0
+            angle = 0.0
+        elif kind == 'slot' and not length:
+            length = d or 1.0
+        new_lines[line_no] = _format_feature(face, x, y, d, length, angle,
+                                             kind) + '\n'
+
+    # drop empty BO blocks (a BO header whose feature lines were all deleted)
+    cleaned = _drop_empty_blocks(new_lines)
+
+    if add_holes:
+        cleaned = _append_holes(cleaned, add_holes)
+
+    return ''.join(cleaned)
+
+
+def _drop_empty_blocks(lines):
+    """Remove a 'BO' header line when every following feature line is empty."""
+    out = []
+    n = len(lines)
+    i = 0
+    while i < n:
+        if lines[i].strip().upper() == 'BO':
+            # peek forward while lines are empty/blank
+            j = i + 1
+            while j < n and not lines[j].strip():
+                j += 1
+            if j >= n or (lines[j].strip().upper() in DSTV_BLOCKS):
+                i += 1  # drop the BO header
+                continue
+            out.append(lines[i])
+            i += 1
+            continue
+        out.append(lines[i])
+        i += 1
+    return out
+
+
+def _append_holes(lines, add_holes):
+    """Append a new BO block before the EN block (or at the end)."""
+    block = ['BO\n']
+    for h in add_holes:
+        block.append(_format_feature(
+            h.get('face', 'v'), h.get('x', 0.0), h.get('y', 0.0),
+            h.get('d', 10.0), h.get('length'), h.get('angle')) + '\n')
+    out = []
+    appended = False
+    for raw in lines:
+        if not appended and raw.strip().upper() == 'EN':
+            out.extend(block)
+            appended = True
+        out.append(raw)
+    if not appended:
+        out.extend(block)
+    return out
+
+
+def valid_faces(st_type):
+    """Return the faces a hole may be placed on for the given profile family.
+
+    Restricted to the surfaces that really exist on the section: L-sections
+    expose only v/u (never h/o), flat plates expose v/h, while I/C/U expose
+    the full set. Single source is ``core.face_planes.real_faces``.
+    """
+    from nccorrection.core.face_planes import real_faces
+    return real_faces(st_type)
+
+
+def current_face(text):
+    """Return the face letter used on the first BO feature of the file."""
+    indices, lines = _feature_indices(text)
+    if not indices:
+        return 'v'
+    return _face_of(lines[indices[0]]) or 'v'
+
+
+_SI_RE = re.compile(r'^\s*SI\s*$', re.I)
+_EN_RE = re.compile(r'^\s*EN\s*$', re.I)
+
+
+def ensure_si_en(text, mark=''):
+    """Guarantee a marked ``SI``/``EN`` block in the NC program.
+
+    Inserts the part ``mark`` (e.g. ``D12``) between SI and EN on first use and
+    refuses to duplicate an existing marked block. Returns ``(new_text, changed)``:
+
+      * ``changed`` is ``True`` when the text was modified (the block was
+        missing or empty) and ``False`` when it was already correctly marked.
+      * If ``mark`` is empty, only the ``SI``/``EN`` markers are ensured.
+    """
+    lines = text.split('\n') if text else []
+    nl = '\r\n' if any(l.endswith('\r') for l in lines) else '\n'
+    lines = [l[:-1] if l.endswith('\r') else l for l in lines]
+    si_idx = en_idx = None
+    for i, raw in enumerate(lines):
+        if si_idx is None and _SI_RE.match(raw):
+            si_idx = i
+        elif en_idx is None and _EN_RE.match(raw):
+            en_idx = i
+        if si_idx is not None and en_idx is not None:
+            break
+
+    mark_line = mark.strip() if mark else ''
+
+    def join(ls):
+        return nl.join(ls)
+
+    if si_idx is not None and en_idx is not None:
+        between = [l for l in lines[si_idx + 1:en_idx] if l.strip()]
+        if between:
+            return text, False
+        if not mark_line:
+            return text, False
+        lines.insert(si_idx + 1, mark_line)
+        return join(lines), True
+
+    if si_idx is None and en_idx is not None:
+        insert = ['SI'] if not mark_line else ['SI', mark_line]
+        lines[en_idx:en_idx] = insert
+        return join(lines), True
+
+    if si_idx is not None and en_idx is None:
+        insert = [mark_line, 'EN'] if mark_line else ['EN']
+        lines[si_idx + 1:si_idx + 1] = insert
+        return join(lines), True
+
+    # neither SI nor EN present: append a full marked block
+    block = ['SI'] if not mark_line else ['SI', mark_line, 'EN']
+    if lines and lines[-1] != '':
+        block.insert(0, '')
+        block.append('')
+    lines.extend(block)
+    return join(lines), True
