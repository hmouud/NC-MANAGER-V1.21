+# ── Helper: parse raw NC1 for ground truth ────────────────────────
+
+def _parse_nc1_template(filepath):
+    """Minimal NC1 parser for ground truth extraction."""
+    with open(filepath, encoding='utf-8') as f:
+        lines = f.read().split('\n')
+
+    result = {
+        'header': {'profile': lines[8].strip() if len(lines) > 8 else '',
+                    'kind': lines[9].strip() if len(lines) > 9 else '',
+                    'steel': lines[6].strip() if len(lines) > 6 else ''},
+        'dims': [],
+        'faces': {},
+    }
+
+    for i in range(10, min(22, len(lines))):
+        try:
+            result['dims'].append(float(lines[i].strip()))
+        except (ValueError, IndexError):
+            pass
+
+    current_face = None
+    current_points = []
+    in_ak = False
+
+    def flush():
+        nonlocal current_face, current_points
+        if current_face and current_points:
+            result['faces'].setdefault(current_face, []).append(current_points)
+        current_points = []
+
+    import re
+    def _parse_num(raw):
+        suffix = ''
+        for ch in raw:
+            if ch.isalpha():
+                suffix = ch
+                break
+        val = float(re.sub(r'[a-zA-Z]', '', raw))
+        return val, suffix
+
+    for raw in lines:
+        l = raw.strip()
+        if l == 'AK':
+            in_ak = True
+            continue
+        if l in ('BO', 'KA', 'IK', 'EN', 'SI', ''):
+            if in_ak:
+                flush()
+                in_ak = False
+                current_face = None
+            continue
+
+        parts = l.split()
+        if in_ak and len(parts) >= 2:
+            first = parts[0]
+            if first in ('v', 'o', 'u', 'h'):
+                flush()
+                current_face = first
+                x, _ = _parse_num(parts[1])
+                y, _ = _parse_num(parts[2])
+                current_points.append((x, y))
+            else:
+                try:
+                    x, _ = _parse_num(parts[0])
+                    y, _ = _parse_num(parts[1])
+                    current_points.append((x, y))
+                except (ValueError, IndexError):
+                    pass
+
+    if in_ak:
+        flush()
+
+    return result
