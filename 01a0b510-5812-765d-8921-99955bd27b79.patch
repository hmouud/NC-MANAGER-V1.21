+"""Cross-section geometry generator for structural steel profiles.
+
+Generates (x, y) point lists for the cross-section outline of each profile type.
+Output format matches ShapeResult from part_creator/shapes.py for consistency.
+
+Coordinates: origin at bottom-left of bounding box, x = width, y = height.
+All dimensions in mm (same as profile data).
+
+Uses the CANONICAL catalog from engine.steel_engine.catalog (single source of truth).
+"""
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass, field
+from typing import List, Tuple
+
+from nccorrection.engine.steel_engine.catalog import SteelProfile
+
+
+# ────────────────────────────────────────────────────────────────────
+# Output type
+# ────────────────────────────────────────────────────────────────────
+
+Contour = List[Tuple[float, float]]
+
+
+@dataclass
+class SectionGeometry:
+    """Cross-section geometry output."""
+    outer: Contour = field(default_factory=list)
+    inners: List[Contour] = field(default_factory=list)
+
+    @property
+    def bounding_box(self) -> Tuple[float, float]:
+        """Return (width, height) of the outer contour."""
+        if not self.outer:
+            return (0.0, 0.0)
+        xs = [p[0] for p in self.outer]
+        ys = [p[1] for p in self.outer]
+        return (max(xs) - min(xs), max(ys) - min(ys))
+
+
+# ────────────────────────────────────────────────────────────────────
+# I-profile cross-section (IPE / HEA / HEB / HEM — kind='I')
+# ────────────────────────────────────────────────────────────────────
+
+def i_profile_geometry(h: float, b: float, tw: float, tf: float,
+                       r: float = 0.0) -> SectionGeometry:
+    """Generate I-profile cross-section outline.
+
+    Points go: bottom-left → bottom-right → top-right → top-left → close
+    Root radius approximated as 45° chamfer at web-flange junction.
+    """
+    x0 = (b - tw) / 2.0  # left edge of web
+    cr = min(r, tw / 2.0, tf / 2.0)  # chamfer size
+
+    points: Contour = []
+    points.append((0.0, 0.0))
+    points.append((b, 0.0))
+    points.append((b, tf))
+    if cr > 0:
+        points.append((x0 + tw + cr, tf))
+        points.append((x0 + tw, tf + cr))
+    web_top = h - tf
+    if cr > 0:
+        points.append((x0 + tw, web_top - cr))
+        points.append((x0 + tw + cr, web_top))
+    points.append((b, h - tf))
+    points.append((b, h))
+    points.append((0.0, h))
+    points.append((0.0, h - tf))
+    if cr > 0:
+        points.append((x0 - cr, h - tf))
+        points.append((x0, h - tf - cr))
+    if cr > 0:
+        points.append((x0, tf + cr))
+        points.append((x0 - cr, tf))
+    points.append((0.0, tf))
+
+    return SectionGeometry(outer=points)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Channel cross-section (UPN / UPE — kind='U')
+# ────────────────────────────────────────────────────────────────────
+
+def channel_geometry(h: float, b: float, tw: float, tf: float,
+                     r: float = 0.0) -> SectionGeometry:
+    """Generate channel (C) cross-section outline."""
+    cr = min(r, tw / 2.0, tf / 2.0)
+    points: Contour = []
+    points.append((0.0, 0.0))
+    points.append((b, 0.0))
+    points.append((b, tf))
+    if cr > 0:
+        points.append((tw + cr, tf))
+        points.append((tw, tf + cr))
+    web_top = h - tf
+    if cr > 0:
+        points.append((tw, web_top - cr))
+        points.append((tw + cr, web_top))
+    points.append((b, h - tf))
+    points.append((b, h))
+    points.append((0.0, h))
+    points.append((0.0, h - tf))
+    return SectionGeometry(outer=points)
+
+
+# ────────────────────────────────────────────────────────────────────
+# L-angle cross-section (kind='L')
+# ────────────────────────────────────────────────────────────────────
+
+def angle_geometry(h: float, b: float, tw: float, tf: float,
+                   r: float = 0.0) -> SectionGeometry:
+    """Generate L-angle cross-section outline."""
+    points: Contour = []
+    points.append((0.0, 0.0))
+    points.append((b, 0.0))
+    points.append((b, tf))
+    points.append((tw, tf))
+    points.append((tw, h))
+    points.append((0.0, h))
+    return SectionGeometry(outer=points)
+
+
+# ────────────────────────────────────────────────────────────────────
+# CHS (Circular Hollow Section — kind='O')
+# ────────────────────────────────────────────────────────────────────
+
+def chs_geometry(d: float, t: float, n_points: int = 64) -> SectionGeometry:
+    """Generate CHS cross-section (outer circle + inner circle)."""
+    r_out = d / 2.0
+    r_in = r_out - t
+    cx = r_out
+    cy = r_out
+
+    outer: Contour = []
+    inner: Contour = []
+
+    for i in range(n_points):
+        angle = 2.0 * math.pi * i / n_points
+        x = cx + r_out * math.cos(angle)
+        y = cy + r_out * math.sin(angle)
+        outer.append((round(x, 4), round(y, 4)))
+
+    if r_in > 0:
+        for i in range(n_points):
+            angle = 2.0 * math.pi * i / n_points
+            x = cx + r_in * math.cos(angle)
+            y = cy + r_in * math.sin(angle)
+            inner.append((round(x, 4), round(y, 4)))
+
+    return SectionGeometry(outer=outer, inners=[inner] if inner else [])
+
+
+# ────────────────────────────────────────────────────────────────────
+# RHS / SHS (Rectangular / Square Hollow — kind='T')
+# ────────────────────────────────────────────────────────────────────
+
+def rhs_geometry(h: float, b: float, t: float,
+                 r_out: float = 0.0, r_in: float = 0.0) -> SectionGeometry:
+    """Generate RHS cross-section (outer rect + inner rect)."""
+    outer = _rounded_rect(b, h, r_out)
+    inner_h = h - 2 * t
+    inner_w = b - 2 * t
+    inner = _rounded_rect(inner_w, inner_h, r_in) if inner_w > 0 and inner_h > 0 else []
+    if inner:
+        ox = (b - inner_w) / 2.0
+        oy = (h - inner_h) / 2.0
+        inner = [(round(x + ox, 4), round(y + oy, 4)) for x, y in inner]
+    return SectionGeometry(outer=outer, inners=[inner] if inner else [])
+
+
+def _rounded_rect(w: float, h: float, r: float) -> Contour:
+    r = min(r, w / 2.0, h / 2.0)
+    if r <= 0:
+        return [(0.0, 0.0), (w, 0.0), (w, h), (0.0, h)]
+    n_arc = 8
+    points: Contour = []
+    _add_arc(points, r, r, r, math.pi, 1.5 * math.pi, n_arc)
+    _add_arc(points, w - r, r, r, 1.5 * math.pi, 2.0 * math.pi, n_arc)
+    _add_arc(points, w - r, h - r, r, 0.0, 0.5 * math.pi, n_arc)
+    _add_arc(points, r, h - r, r, 0.5 * math.pi, math.pi, n_arc)
+    return points
+
+
+def _add_arc(points: Contour, cx: float, cy: float, r: float,
+             a_start: float, a_end: float, n: int):
+    for i in range(n + 1):
+        angle = a_start + (a_end - a_start) * i / n
+        x = cx + r * math.cos(angle)
+        y = cy + r * math.sin(angle)
+        points.append((round(x, 4), round(y, 4)))
+
+
+# ────────────────────────────────────────────────────────────────────
+# Dispatcher: generate from any SteelProfile (from steel_engine catalog)
+# ────────────────────────────────────────────────────────────────────
+
+def generate_section(profile: SteelProfile) -> SectionGeometry:
+    """Generate cross-section geometry from a SteelProfile instance.
+
+    Dispatches based on profile.kind to the correct generator.
+    """
+    h = profile.depth
+    b = profile.width
+    tw = profile.web_thick
+    tf = profile.flange_thick
+    r = profile.root_radius
+    kind = profile.kind
+
+    if kind == 'I':
+        return i_profile_geometry(h, b, tw, tf, r)
+    elif kind == 'U':
+        return channel_geometry(h, b, tw, tf, r)
+    elif kind == 'L':
+        return angle_geometry(h, b, tw, tf, r)
+    elif kind == 'O':
+        # Could be CHS tube (tf < h) or solid round bar (tf == h)
+        if tf < h * 0.9:
+            return chs_geometry(h, tf)  # CHS tube
+        else:
+            # Solid round bar — just a circle outline
+            return chs_geometry(h, 0.0)  # solid circle
+    elif kind == 'T':
+        return rhs_geometry(h, b, tf, r)
+    elif kind in ('B', 'FB'):
+        # Plate or flat bar: simple rectangle
+        return SectionGeometry(outer=[(0.0, 0.0), (b, 0.0), (b, h), (0.0, h)])
+    else:
+        # Unknown kind — return empty instead of crashing
+        return SectionGeometry()
