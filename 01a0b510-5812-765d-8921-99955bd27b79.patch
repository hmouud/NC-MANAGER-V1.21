+class ArcTrapezoidWithHoleShape(PlateShape):
+    """Arc trapezoid with central hole."""
+    name = "Arc Trapezoid with Hole"
+    category = "Arc"
+    parameters = [
+        ShapeParam("Radius", "radius", 150.0, 5.0, 5000.0),
+        ShapeParam("Start angle", "start_angle", 0.0, 0.0, 359.0),
+        ShapeParam("End angle", "end_angle", 60.0, 1.0, 360.0),
+        ShapeParam("Height", "height", 50.0, 1.0, 5000.0),
+        ShapeParam("Hole radius", "hole_r", 10.0, 0.5, 4999.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["radius"]
+        sa, ea = p["start_angle"], p["end_angle"]
+        h = p["height"]
+        hr = p["hole_r"]
+        outer_arc = _arc_pts(0, 0, R, sa, ea, 32)
+        r_inner = R - h
+        if r_inner > 1.0:
+            inner_arc = _arc_pts(0, 0, r_inner, ea, sa, 32)
+            outer = outer_arc + inner_arc
+        else:
+            outer = outer_arc + [(0, 0)]
+        mid_angle = math.radians((sa + ea) / 2)
+        mid_r = (R + max(r_inner, 0)) / 2
+        holes = [{'x': mid_r * math.cos(mid_angle),
+                  'y': mid_r * math.sin(mid_angle), 'd': hr * 2}]
+        return ShapeResult(outer=outer, holes=holes)
