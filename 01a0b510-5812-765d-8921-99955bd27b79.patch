+"""Parser and cut-case recognition for DSTV NC1 part files.
+
+Reading contract (built from real production files, e.g. F1-T6 / F1-T1 /
+F1-T14, HEA100 grougage and IPE360 miter samples):
+
+ST header block (one value per line, 12 dimensions after the profile code)
+    dims[0]  length (mm)          dims[6]  weight per metre
+    dims[1]  profile height       dims[7]  painting surface
+    dims[2]  flange width         dims[8]  web start cut angle (deg, from the
+    dims[3]  flange thickness     dims[9]  web end cut angle       perpendicular
+    dims[4]  web thickness        dims[10] flange start cut angle to the beam)
+    dims[5]  fillet radius        dims[11] flange end cut angle
+
+    The ST length can be the saw over-length: the true beam reference for the
+    cuts is the AK contour extent, not dims[0].
+
+AK/IK contour block (one vertex per line), columns after the optional face
+letter:  X  Y  [radius]  alpha  beta ...  plus suffix letters:
+    's' on the first X  -> start-end reference edge (x_suffix)
+    'w' on Y            -> notch/cope point (web grougage)
+    'u'/'o' on a number -> cut measured from that flange edge
+    alpha = bevel angle in the face plane, beta = bevel across the thickness
+
+KA block (one bend per line, plate parts - press-brake fold in the
+unrolled flat pattern):
+    X1 Y1 X2 Y2 Angle Thickness     (6 floats; Angle in degrees)
+    X1 Y1 X2 Y2 Angle Radius        (6 floats; column 6 > 1000 = radius)
+
+    NOTE: field 6 is disambiguated by magnitude — values > 1000 are treated
+    as bend RADIUS; smaller values as plate THICKNESS (owner law 2026-09-12,
+    updated).  The radius is stored separately in the bend dict.
+
+Face semantics (the same physical end has different Y per face):
+    v = web elevation  (X along beam, Y = beam height)  -> end cuts / miters
+    o = top flange     (X along beam, Y = flange width)
+    u = bottom flange  (X along beam, Y = flange width)
+    h = back / end faces
+
+Cut cases the engine recognises (``recognize_cut_cases``):
+    * miter      - diagonal edge on the v face at an end (angular end cut)
+    * grougage   - 'w' notch points on the v face (cope / corner notch)
+    * flange_cut - o/u face shorter than the v extents at an end
+    * bevel      - alpha/beta angles written on a contour vertex
+"""
+
+import math
+import re
+
+NUM = r'-?\d+(?:[\.,]\d+)?'
+NUM_RE = re.compile(NUM)
+CIRCLE_RE = re.compile(rf'^\s*[oO]\s+({NUM})\s+({NUM})\s+({NUM})\s*$')
+SLOT_RE = re.compile(rf'^\s*[uUvVhH]\s+({NUM})\s+({NUM})\s+({NUM})\s+({NUM})\s*$')
+POINT_RE = re.compile(rf'^\s*[oOuUhHvV]\s+({NUM})\s+({NUM})\s*$')
+# DSTV AK contour line: each number may carry a letter suffix:
+#   s = cut/bevel edge, u/o = cut from below/top, w = notch/cope, l = slot length.
+AKTOK = re.compile(r'(-?\d+(?:[\.,]\d+)?)([suowl])?')
+
+DSTV_BLOCKS = {'ST', 'AK', 'IK', 'BO', 'SI', 'PU', 'KO', 'KA', 'EN', 'UE', 'PR', 'SC'}
+
+#: ST profile-type tokens (single DSTV letters + multi-letter tube codes)
+#: mapped to the app's profile type used by part3d / metrics.
+ST_TYPES = {
+    'B': 'B', 'I': 'I', 'U': 'U', 'L': 'L', 'C': 'C', 'T': 'T',
+    'O': 'O', 'S': 'S', 'Z': 'Z',
+    'RO': 'O', 'RU': 'O', 'SO': 'S', 'CA': 'S',
+    # Phase A: new steel-profile designations.
+    'TC': 'S', 'TR': 'S', 'TUBC': 'S', 'TUBE-C': 'S', 'TUBE-R': 'S',
+    'CFRHS': 'S', 'TE': 'T',
+}
+
+
+def _face_of(line):
+    for ch in line.strip():
+        if ch.lower() in 'vouh':
+            return ch.lower()
+    return 'v'
+
+
+def _leading_face(line):
+    """Face letter from the start of an AK line, stopping at the first digit
+    so a trailing suffix ('0.00u') is never mistaken for a face."""
+    for ch in line:
+        if ch.isdigit():
+            break
+        if ch.lower() in 'vouh':
+            return ch.lower()
+    return 'v'
+
+
+# DSTV BO feature line: every numeric token may carry a letter suffix
+# (o/v/h/u/s = measured-from / cut edges, l = slotted-hole marker).
+BO_TOKEN = re.compile(r'(-?\d+(?:[\.,]\d+)?(?:[eE][-+]?\d+)?)([A-Za-z_]*)')
+
+
+def parse_bo_feature(line):
+    toks = BO_TOKEN.findall(line)
+    values = [float(v.replace(',', '.')) for v, _ in toks]
+    if len(values) < 3:
+        return None
+    face = _face_of(line)
+    x, y, d = values[0], values[1], values[2]
+    slotted = any('l' in sfx.lower() for _, sfx in toks)
+    if slotted:
+        if len(values) > 3 and values[3] > 1e-6:
+            length = values[3]
+            angle = values[4] if len(values) > 4 else 0.0
+        elif len(values) > 4:
+            length = values[4]
+            angle = values[5] if len(values) > 5 else 0.0
+        else:
+            length = values[3] if len(values) > 3 else 0.0
+            angle = 0.0
+    elif len(values) >= 6:
+        length, angle = values[4], values[5]
+    elif len(values) == 5:
+        length, angle = values[3], values[4]
+    elif len(values) == 4:
+        length, angle = values[3], 0.0
+    else:
+        length, angle = 0.0, 0.0
+    if slotted or length:
+        return {'face': face, 'kind': 'slot', 'x': x, 'y': y, 'd': d,
+                'length': length, 'angle': angle}
+    return {'face': face, 'kind': 'hole', 'x': x, 'y': y, 'd': d,
+            'length': 0.0, 'angle': 0.0}
+
+
+def parse_ka_line(line):
+    """Parse one DSTV KA (bend) line into the canonical bend dict.
+
+    KA = Kanten = part-bending information (press-brake folds on plate
+    parts). Each line describes one bend in the unrolled flat pattern.
+    Three real-world dialects exist (owner law 2026-09-12, updated):
+
+        X1 Y1 X2 Y2 Angle Thickness      (6 floats — thickness)
+        X1 Y1 X2 Y2 Angle Radius         (6 floats — bend radius, NOT
+                                          thickness; values > 1000 are
+                                          treated as radius)
+        X1 Y1 X2 Y2 Angle                (5 floats — thickness omitted,
+                                          inherited from the plate's
+                                          thickness in the ST header)
+
+    Column 6 disambiguation: values > 1000 are almost certainly a bend
+    RADIUS (no steel plate exceeds ~100 mm thickness; a radius of 35 947
+    mm is a valid press-brake die radius).  Values <= 1000 are treated as
+    thickness.  When 5-column (no value), callers fall back to plate
+    thickness from the ST header.
+
+    Robust against a leading face letter and letter suffixes on any
+    numeric token (same matching as BO). A line with fewer than 5 numbers
+    cannot describe a bend and is skipped (returns None) — we never
+    fabricate a bend from partial data.
+
+    Returns a dict with keys 'x1', 'y1', 'x2', 'y2', 'angle',
+    'thickness' (None when column 6 is radius or absent), and 'radius'
+    (set when column 6 is a radius, else None), or None for malformed
+    lines.
+    """
+    nums = [float(m.group(1)) for m in BO_TOKEN.finditer(line)]
+    if len(nums) < 5:
+        return None
+    thickness = None
+    radius = None
+    if len(nums) >= 6:
+        val = nums[5]
+        if abs(val) > 1000:
+            radius = val
+        else:
+            thickness = val
+    return {'x1': nums[0], 'y1': nums[1], 'x2': nums[2], 'y2': nums[3],
+            'angle': nums[4], 'thickness': thickness, 'radius': radius}
+
+
+FACE_CUT = {
+    'v': 'Web (v)',
+    'o': 'Top Flange (o)',
+    'u': 'Bottom Flange (u)',
+    'h': 'Rear Web (h)',
+}
+
+
+def parse_geometry(text):
+    """Parse real DSTV NC1 (and legacy simple) geometry into shapes.
+
+    Returns dict with:
+      contours: list of closed outer contours, one per AK/IK block
+                (each contour is a list of (x, y) in part mm)
+      contour_faces: list of face letters ('v'/'o'/'u'/'h') per contour
+      contour_meta: list of dicts aligned with contours, each with
+                {face, pts, bevels: {idx: {alpha, beta}}, notches: [idx],
+                 x_suffix, first_x, first_y}
+      points:   list of (x, y) from simple 'face x y' / 'x y' lines
+      circles:  list of (x, y, diameter) round holes from BO blocks / 'o x y d'
+      slots:    list of (x1, y1, x2, y2, width, length, angle) slotted holes
+      holes:    list of dicts, one per BO feature: {face, kind, x, y, d,
+                length, angle}
+      bends:    list of dicts, one per KA bend line: {x1, y1, x2, y2,
+                angle, thickness} — fold segment in the flat pattern
+      st:       dict with profile info {type, profile, thickness, numbers}
+    """
+    contours = []
+    contour_faces = []
+    contour_meta = []
+    points = []
+    circles = []
+    slots = []
+    holes = []
+    bends = []
+    st = {}
+    st_numbers = []
+    st_dims = []
+    st_last_word = None
+    st_in_dims = False
+    block = None
+    current = None
+
+    def close_contour():
+        nonlocal current
+        if current and len(current['pts']) >= 3:
+            contours.append(current['pts'])
+            contour_faces.append(current['face'])
+            # Arc data: detect radius vs bulge convention (open-source rule).
+            arc_vals = current.get('arc_values', [])
+            check = arc_vals[:-1] if len(arc_vals) >= 3 else arc_vals
+            is_radius = any(abs(v) > 1.0 for v in check)
+            contour_meta.append({
+                'face': current['face'],
+                'pts': list(current['pts']),
+                'bevels': dict(current['bevels']),
+                'notches': sorted(current['notches']),
+                'x_suffix': current['x_suffix'],
+                'first_x': current['first_x'],
+                'first_y': current['first_y'],
+                'arc_values': arc_vals,
+                'arc_convention': 'radius' if is_radius else 'bulge',
+                'kind': current.get('kind', 'outer'),
+            })
+        current = None
+
+    def new_contour():
+        return {'face': 'v', 'pts': [], 'bevels': {},
+                'notches': set(), 'x_suffix': None,
+                'first_x': None, 'first_y': None,
+                'arc_values': [], 'kind': 'outer'}
+
+    for raw in (text or '').splitlines():
+        line = raw.rstrip('\n')
+        stripped = line.strip()
+        if not stripped:
+            continue
+        if stripped.upper() in DSTV_BLOCKS:
+            close_contour()
+            block = stripped.upper()
+            if block in ('AK', 'IK'):
+                current = new_contour()
+                if block == 'IK':
+                    current['kind'] = 'inner'
+            continue
+        nums = [float(n.replace(',', '.')) for n in NUM_RE.findall(line)]
+        if block == 'ST':
+            if st_in_dims:
+                if re.search(r'[A-Za-z]', stripped) or '\u00d8' in stripped:
+                    # designation line (e.g. "HEA300", "IPE140", "Ø30*2") after
+                    # the type letter: record it as the profile but never as a
+                    # dimension (its embedded digits must not shift the dims).
+                    if not st.get('profile'):
+                        st['profile'] = stripped.strip()
+                else:
+                    st_dims.extend(nums)
+            else:
+                if stripped.upper() in ST_TYPES:
+                    st['type'] = ST_TYPES[stripped.upper()]
+                    st['profile'] = st_last_word or st.get('profile')
+                    st_in_dims = True
+                elif stripped.startswith(('**', ';', '#', '//')):
+                    pass
+                elif re.search(r'[A-Za-z]', stripped) or '\u00d8' in stripped:
+                    st_last_word = stripped
+                elif nums:
+                    st_numbers.extend(nums)
+            continue
+        if block in ('AK', 'IK'):
+            toks = [(float(a.replace(',', '.')), sfx) for a, sfx in AKTOK.findall(line)]
+            if len(toks) < 2:
+                continue
+            if current is None:
+                current = new_contour()
+            if not current['pts']:
+                current['face'] = _leading_face(line)
+                current['first_x'] = toks[0][0]
+                current['first_y'] = toks[1][0]
+                if toks[0][1]:
+                    current['x_suffix'] = toks[0][1]
+            idx = len(current['pts'])
+            current['pts'].append((toks[0][0], toks[1][0]))
+            # 3rd column: bulge (DSTV standard) or radius (CAM convention)
+            arc_val = toks[2][0] if len(toks) > 2 else 0.0
+            current['arc_values'].append(arc_val)
+            alpha = toks[3][0] if len(toks) > 3 else 0.0
+            beta = toks[4][0] if len(toks) > 4 else 0.0
+            if abs(alpha) > 1e-9 or abs(beta) > 1e-9:
+                current['bevels'][idx] = {'alpha': alpha, 'beta': beta}
+            if toks[1][1] == 'w':
+                current['notches'].add(idx)
+            continue
+        if block == 'BO':
+            feat = parse_bo_feature(line)
+            if feat:
+                if feat['kind'] == 'slot':
+                    slots.append((feat['x'], feat['y'], feat['x'], feat['y'],
+                                  feat['d'], feat['length'], feat['angle']))
+                elif feat['d'] > 0:
+                    circles.append((feat['x'], feat['y'], feat['d']))
+                holes.append(feat)
+            continue
+        if block == 'KA':
+            bend = parse_ka_line(line)
+            if bend:
+                bends.append(bend)
+            continue
+        # legacy simple lines (outside any DSTV block)
+        m = CIRCLE_RE.match(stripped)
+        if m:
+            circles.append((float(m.group(1)), float(m.group(2)), float(m.group(3))))
+            holes.append({'face': 'v', 'kind': 'hole', 'x': float(m.group(1)),
+                          'y': float(m.group(2)), 'd': float(m.group(3)),
+                          'length': 0.0, 'angle': 0.0})
+            continue
+        m = SLOT_RE.match(stripped)
+        if m:
+            slots.append((float(m.group(1)), float(m.group(2)),
+                          float(m.group(3)), float(m.group(4)), 0.0, 0.0, 0.0))
+            holes.append({'face': 'v', 'kind': 'slot', 'x': float(m.group(1)),
+                          'y': float(m.group(2)), 'd': float(m.group(3)),
+                          'length': float(m.group(4)), 'angle': 0.0})
+            continue
+        m = POINT_RE.match(stripped)
+        if m:
+            points.append((float(m.group(1)), float(m.group(2))))
+            continue
+        if stripped[0] in 'oOuUhHvV':
+            continue
+        if len(nums) >= 2 and 2 <= len(line.split()) <= 4:
+            points.append((nums[0], nums[1]))
+    close_contour()
+    if not st.get('type'):
+        st['type'] = 'B'
+    st['numbers'] = st_numbers
+    st['dims'] = st_dims
+    st.setdefault('thickness', _estimate_thickness(st))
+    # 5-column KA dialect: bend thickness is omitted and inherited from the
+    # plate's thickness in the ST header (owner law 2026-09-12). Fill the
+    # fallback here so viewers/fold math never receive None.
+    plate_t = st.get('thickness') or 0.0
+    for b in bends:
+        if b.get('thickness') is None:
+            b['thickness'] = plate_t
+    return {'contours': contours, 'contour_faces': contour_faces,
+            'contour_meta': contour_meta,
+            'points': points, 'circles': circles, 'slots': slots,
+            'holes': holes, 'bends': bends, 'st': st}
+
+
+def bevel_summary(geometry, st=None):
+    """Return a list of human-readable cut / notch descriptions extracted
+    from the AK contours (numeric bevel angles, copes, sloped end cuts)."""
+    out = []
+    st = st or {}
+    dims = st.get('dims') or []
+    t = (st.get('type') or 'B').upper()
+    tf = None
+    if t == 'I' and len(dims) >= 4:
+        tf = dims[3] or None
+    for m in geometry.get('contour_meta', []):
+        face = m.get('face', 'v')
+        label = FACE_CUT.get(face, face)
+        pts = m.get('pts') or []
+        for idx in sorted((m.get('bevels') or {})):
+            b = m['bevels'][idx]
+            ang = float(b.get('alpha', 0.0) or 0.0)
+            if abs(ang) > 1e-9:
+                where = ''
+                if idx < len(pts):
+                    x, y = pts[idx]
+                    where = f' (x={x:g}, y={y:g})'
+                out.append(f'miter {abs(ang):.1f}\u00b0 \u2013 {label}{where}')
+        notches = m.get('notches') or []
+        if notches:
+            xs = sorted({pts[i][0] for i in notches if i < len(pts)})
+            out.append('cope/notch \u2013 ' + label +
+                       f' (x={", ".join(f"{x:g}" for x in xs)})')
+        first_x = m.get('first_x') or 0.0
+        if first_x > 1e-6 and m.get('x_suffix') in ('s', 'o', 'u'):
+            msg = (f'sloped end cut \u2013 {label} '
+                   f'(offset {first_x:g} mm)')
+            if tf and tf > 1e-9:
+                ang = math.degrees(math.atan2(tf, first_x))
+                msg += f' ~ {ang:.1f}\u00b0'
+            out.append(msg)
+    return out
+
+
+def classify_cuts(geometry, st=None):
+    """Return an ordered list of the part's cut features.
+
+    Classification order: first the cut *type* ('angle' = bevel/miter cut,
+    'grougage' = square corner/notch cut), then *ordering* (by beam end then
+    position), then the *location* (end start/end = front/rear, zone
+    web/top_flange/bottom_flange = web/flange).
+
+    Each entry is a dict with: id, kind, label ('A1'/'G1'), end
+    ('start'|'end'|None), zone, face, x, y, offset (mm), angle (degrees).
+    """
+    st = st or geometry.get('st') or {}
+    dims = st.get('dims') or []
+    t = (st.get('type') or 'B').upper()
+    tf = None
+    if t == 'I' and len(dims) >= 4:
+        tf = dims[3] or None
+    H = dims[1] if len(dims) > 1 else 0.0
+
+    metas = geometry.get('contour_meta') or []
+    v_min = v_max = None
+    for m in metas:
+        if m.get('face') == 'v':
+            xs = [p[0] for p in m.get('pts', [])]
+            if xs:
+                v_min, v_max = min(xs), max(xs)
+
+    def zone_of(face):
+        if face == 'v':
+            return 'web'
+        if face == 'o':
+            return 'top_flange'
+        if face == 'u':
+            return 'bottom_flange'
+        return str(face)
+
+    cuts = []
+
+    # end cuts on flanges (miter / sloped end = 'angle')
+    for m in metas:
+        face = m.get('face')
+        if face not in ('o', 'u'):
+            continue
+        pts = m.get('pts', [])
+        xs = [p[0] for p in pts]
+        if not xs:
+            continue
+        mn, mx = min(xs), max(xs)
+        zone = zone_of(face)
+        if v_min is not None and mn - v_min > 1e-6:
+            ang = None
+            if tf and tf > 1e-9:
+                ang = math.degrees(math.atan2(tf, mn - v_min))
+            cuts.append({'id': 0, 'kind': 'angle', 'label': '', 'end': 'start',
+                         'zone': zone, 'face': face, 'x': v_min, 'y': None,
+                         'offset': mn - v_min, 'angle': ang})
+        if v_max is not None and v_max - mx > 1e-6:
+            ang = None
+            if tf and tf > 1e-9:
+                ang = math.degrees(math.atan2(tf, v_max - mx))
+            cuts.append({'id': 0, 'kind': 'angle', 'label': '', 'end': 'end',
+                         'zone': zone, 'face': face, 'x': v_max, 'y': None,
+                         'offset': v_max - mx, 'angle': ang})
+
+    # numeric bevels (angles on a face) + notches (grougage corners)
+    for m in metas:
+        face = m.get('face', 'v')
+        pts = m.get('pts', [])
+        zone = zone_of(face)
+        for idx in sorted(m.get('bevels') or {}):
+            if idx >= len(pts):
+                continue
+            x, y = pts[idx]
+            cuts.append({'id': 0, 'kind': 'angle', 'label': '', 'end': None,
+                         'zone': zone, 'face': face, 'x': x, 'y': y,
+                         'offset': m['bevels'][idx].get('beta', 0.0),
+                         'angle': m['bevels'][idx].get('alpha', 0.0)})
+        for idx in m.get('notches') or []:
+            if idx >= len(pts):
+                continue
+            x, y = pts[idx]
+            end = 'start'
+            if v_min is not None and v_max is not None:
+                end = 'end' if (v_max - x) < (x - v_min) else 'start'
+            cuts.append({'id': 0, 'kind': 'grougage', 'label': '', 'end': end,
+                         'zone': zone, 'face': face, 'x': x, 'y': y,
+                         'offset': None, 'angle': None})
+
+    # angular end cuts on the web (miter) derived from the v-contour diagonal,
+    # using the same planes the 3D model is built from (`part3d._v_end_cuts`)
+    if t == 'I' and H > 0 and v_min is not None:
+        try:
+            from nccorrection.core.part3d import _v_end_cuts
+        except Exception:
+            _v_end_cuts = None
+        if _v_end_cuts is not None:
+            s_fn, e_fn, _, _ = _v_end_cuts(geometry, H)
+            wang_s = dims[8] if len(dims) > 8 else 0.0
+            wang_e = dims[9] if len(dims) > 9 else 0.0
+            if s_fn is not None:
+                cuts.append({'id': 0, 'kind': 'angle', 'label': '', 'end': 'start',
+                             'zone': 'web', 'face': 'v', 'x': v_min, 'y': None,
+                             'offset': s_fn(H), 'angle': wang_s})
+            if e_fn is not None:
+                cuts.append({'id': 0, 'kind': 'angle', 'label': '', 'end': 'end',
+                             'zone': 'web', 'face': 'v', 'x': v_max, 'y': None,
+                             'offset': e_fn(H), 'angle': wang_e})
+
+    cuts.sort(key=lambda c: (0 if c['end'] == 'start' else 1, c.get('x') or 0.0))
+    for i, c in enumerate(cuts, start=1):
+        c['id'] = i
+        c['label'] = ('G' if c['kind'] == 'grougage' else 'A') + str(i)
+    return cuts
+
+
+CASE_ZONE_LABELS = {'web': 'web', 'top_flange': 'top flange',
+                    'bottom_flange': 'bottom flange'}
+CASE_END_LABELS = {'start': 'start', 'end': 'end'}
+CASE_KIND_LABELS = {
+    'miter': 'miter',
+    'grougage': 'cope/notch',
+    'flange_cut': 'flange cut',
+    'bevel': 'bevel',
+    'straight': 'no cut',
+}
+
+
+def recognize_cut_cases(geometry, st=None):
+    """Return the list of cut cases a part carries.
+
+    This is the engine-level recognition built on the per-line reading
+    contract (see module docstring). Every entry is produced from the same
+    parsed lines the 3D model consumes, so the 2D/3D views and the report
+    always agree on what the part looks like.
+
+    Each case is a dict: kind ('miter'|'grougage'|'flange_cut'|'bevel'),
+    end ('start'|'end'|None), zone ('web'|'top_flange'|'bottom_flange'),
+    face, mm (length/offset), deg (angle), detail (human line).
+    """
+    st = st or geometry.get('st') or {}
+    dims = st.get('dims') or []
+    t = (st.get('type') or 'B').upper()
+    H = dims[1] if len(dims) > 1 else 0.0
+    metas = geometry.get('contour_meta') or []
+    cases = []
+
+    vm = next((m for m in metas if m.get('face') == 'v'), None)
+    v_min = v_max = None
+    if vm:
+        xs = [p[0] for p in vm.get('pts', [])]
+        if xs:
+            v_min, v_max = min(xs), max(xs)
+
+    if t == 'I' and H > 0 and v_min is not None:
+        try:
+            from nccorrection.core.part3d import _v_end_cuts
+        except Exception:
+            _v_end_cuts = None
+        if _v_end_cuts is not None:
+            s_fn, e_fn, _, _ = _v_end_cuts(geometry, H)
+            for end, fn, di in (('start', s_fn, 8), ('end', e_fn, 9)):
+                if fn is None:
+                    continue
+                cases.append({'kind': 'miter', 'end': end, 'zone': 'web',
+                              'face': 'v', 'mm': round(float(fn(H)), 2),
+                              'deg': (dims[di] if len(dims) > di else 0.0),
+                              'detail': f'miter {end} (web)'})
+        nxs = sorted({vm['pts'][i][0] for i in (vm.get('notches') or [])
+                      if i < len(vm['pts'])})
+        if nxs:
+            if nxs[0] - v_min > 1e-6:
+                cases.append({'kind': 'grougage', 'end': 'start', 'zone': 'web',
+                              'face': 'v', 'mm': round(nxs[0] - v_min, 2),
+                              'deg': None, 'detail': 'cope start (web)'})
+            if v_max - nxs[-1] > 1e-6:
+                cases.append({'kind': 'grougage', 'end': 'end', 'zone': 'web',
+                              'face': 'v', 'mm': round(v_max - nxs[-1], 2),
+                              'deg': None, 'detail': 'cope end (web)'})
+
+    for m in metas:
+        face = m.get('face')
+        if face in ('o', 'u') and v_min is not None:
+            xs = [p[0] for p in m.get('pts', [])]
+            if xs:
+                mn, mx = min(xs), max(xs)
+                zone = 'top_flange' if face == 'o' else 'bottom_flange'
+                if mn - v_min > 1e-6:
+                    cases.append({'kind': 'flange_cut', 'end': 'start', 'zone': zone,
+                                  'face': face, 'mm': round(mn - v_min, 2), 'deg': None,
+                                  'detail': f'flange cut start ({zone})'})
+                if v_max - mx > 1e-6:
+                    cases.append({'kind': 'flange_cut', 'end': 'end', 'zone': zone,
+                                  'face': face, 'mm': round(v_max - mx, 2), 'deg': None,
+                                  'detail': f'flange cut end ({zone})'})
+        pts = m.get('pts', [])
+        for idx in sorted(m.get('bevels') or {}):
+            if idx >= len(pts):
+                continue
+            b = m['bevels'][idx]
+            zone = {'v': 'web', 'o': 'top_flange',
+                    'u': 'bottom_flange'}.get(m.get('face', 'v'), m.get('face', 'v'))
+            cases.append({'kind': 'bevel', 'end': None, 'zone': zone,
+                          'face': m.get('face', 'v'), 'mm': round(b.get('beta', 0.0), 2),
+                          'deg': b.get('alpha', 0.0),
+                          'detail': f'bevel {b.get("alpha", 0.0):g}\u00b0 {zone}'})
+    return cases
+
+CUT_END_LABELS = {'start': 'start', 'end': 'end', None: 'point'}
+CUT_ZONE_LABELS = {'web': 'web', 'top_flange': 'top flange',
+                   'bottom_flange': 'bottom flange'}
+
+def _estimate_thickness(st):
+    """Best-effort part thickness in mm from ST block data."""
+    dims = st.get('dims') or []
+    if not dims:
+        return 10.0
+    t = st.get('type')
+    if t == 'B' and len(dims) >= 3:
+        return dims[2]
+    if t == 'I' and len(dims) >= 5:
+        return dims[4]  # web thickness
+    if t == 'L' and len(dims) >= 4:
+        return dims[3]
+    if len(dims) >= 3:
+        return dims[2] or dims[1]
+    return dims[0] or 10.0
+
+
+def apply_hole_overrides(geometry, overrides):
+    """Return a copy of geometry with hole edits applied by index.
+
+    Each entry in ``overrides`` may be:
+      * a scalar number          -> new diameter (holes)
+      * a 3-tuple                -> (diameter, length, angle)                 (slots)
+      * a dict with any of       -> {'d', 'x', 'y', 'length', 'angle'}        (full control)
+    Applied to the 'holes' list and mirrored into 'circles'/'slots' so viewers
+    render the edited sizes and positions live.
+    """
+    if not overrides:
+        return geometry
+    result = dict(geometry)
+    holes = list(geometry.get('holes', []))
+    circles = list(geometry.get('circles', []))
+    slots = list(geometry.get('slots', []))
+    ci = si = 0
+    for idx, h in enumerate(holes):
+        ov = overrides.get(idx)
+        if ov is None:
+            continue
+        h = dict(h)
+        if isinstance(ov, dict):
+            vals = ov
+        elif isinstance(ov, (tuple, list)):
+            vals = {'d': ov[0], 'length': ov[1] if len(ov) > 1 else h.get('length'),
+                    'angle': ov[2] if len(ov) > 2 else h.get('angle')}
+        else:
+            vals = {'d': ov}
+        if 'd' in vals:
+            h['d'] = float(vals['d'])
+        if 'x' in vals:
+            h['x'] = float(vals['x'])
+        if 'y' in vals:
+            h['y'] = float(vals['y'])
+        if 'length' in vals:
+            h['length'] = float(vals['length'])
+        if 'angle' in vals:
+            h['angle'] = float(vals['angle'])
+        if 'face' in vals and vals['face']:
+            h['face'] = vals['face']
+        holes[idx] = h
+        if h['kind'] == 'hole':
+            if ci < len(circles):
+                cir = list(circles[ci])
+                cir[0] = float(h['x'])
+                cir[1] = float(h['y'])
+                cir[2] = float(h['d'])
+                circles[ci] = tuple(cir)
+            ci += 1
+        else:
+            if si < len(slots):
+                s = list(slots[si])
+                s[0] = float(h['x'])
+                s[1] = float(h['y'])
+                if len(s) > 4:
+                    s[4] = float(h['d'])
+                if len(s) > 5:
+                    s[5] = float(h.get('length', s[5]))
+                if len(s) > 6:
+                    s[6] = float(h.get('angle', s[6]))
+                slots[si] = tuple(s)
+            si += 1
+    result['holes'] = holes
+    result['circles'] = circles
+    result['slots'] = slots
+    return result
+
+
+def compute_bounds(geometry, margin=5.0):
+    """Return (min_x, min_y, max_x, max_y) for all shapes or None if empty."""
+    xs = []
+    ys = []
+    for contour in geometry.get('contours', []):
+        for x, y in contour:
+            xs.append(x)
+            ys.append(y)
+    for x, y in geometry.get('points', []):
+        xs.append(x)
+        ys.append(y)
+    for x, y, d in geometry.get('circles', []):
+        xs.extend([x - d / 2, x + d / 2])
+        ys.extend([y - d / 2, y + d / 2])
+    for slot in geometry.get('slots', []):
+        x1, y1, x2, y2 = slot[0], slot[1], slot[2], slot[3]
+        xs.extend([x1, x2])
+        ys.extend([y1, y2])
+    if not xs:
+        return None
+    return (min(xs) - margin, min(ys) - margin, max(xs) + margin, max(ys) + margin)
+
+
+def build_transform(bounds, width, height, pad=30):
+    """Return (sx, ox, sy, oy) mapping geometry coords to canvas pixels.
+    Y axis is flipped so the part is upright."""
+    min_x, min_y, max_x, max_y = bounds
+    span_x = max(max_x - min_x, 1e-9)
+    span_y = max(max_y - min_y, 1e-9)
+    scale = min((width - 2 * pad) / span_x, (height - 2 * pad) / span_y)
+    scale = max(scale, 1e-9)
+    ox = pad + (width - 2 * pad - span_x * scale) / 2 - min_x * scale
+    oy = pad + (height - 2 * pad - span_y * scale) / 2 + max_y * scale
+    return scale, ox, -scale, oy
+
+def slot_major_axis(angle_deg):
+    """Face-local axis the slot's long side (DSTV ``length``) runs along.
+
+    Per DSTV the slot length is measured parallel to the face-local X axis at
+    an angle of 0 degrees; rotating the slot by 90 degrees swings it onto the
+    Y axis. Used by the hole/slot editor so the Width/Length mapping respects
+    the slot's rotation: a slot rotated ~90 degrees has its *horizontal* (X)
+    extent driven by the minor ``d`` (Width) token and its vertical extent by
+    ``length``.
+    """
+    a = round(float(angle_deg or 0.0) % 180.0)
+    return 'y' if abs(a - 90.0) < 22.5 else 'x'
