+        self.len_spin.setRange(1.0, 500.0)
+        self.len_spin.setValue(40.0)
+        self.len_spin.setSuffix(" mm")
+        self.len_spin.valueChanged.connect(self._update_preview_label)
+        dim_layout.addRow("Slot Length (L):", self.len_spin)
+
+        # Slot Angle
+        self.angle_spin = QDoubleSpinBox()
+        self.angle_spin.setRange(-180.0, 180.0)
+        self.angle_spin.setValue(0.0)
+        self.angle_spin.setSuffix("°")
+        self.angle_spin.valueChanged.connect(self._update_preview_label)
+
+        angle_container = QWidget()
+        angle_box = QHBoxLayout(angle_container)
+        angle_box.setContentsMargins(0, 0, 0, 0)
+        angle_box.setSpacing(4)
+        angle_box.addWidget(self.angle_spin, 1)
+
+        btn_horiz = QPushButton("0° Horiz")
+        btn_horiz.clicked.connect(lambda: self.angle_spin.setValue(0.0))
+        angle_box.addWidget(btn_horiz)
+
+        btn_vert = QPushButton("90° Vert")
+        btn_vert.clicked.connect(lambda: self.angle_spin.setValue(90.0))
+        angle_box.addWidget(btn_vert)
+
+        dim_layout.addRow("Slot Angle (α):", angle_container)
+
+        layout.addWidget(dim_group)
+
+        # ── Preview Summary & Validation ──
+        self.summary_label = QLabel()
+        self.summary_label.setStyleSheet(f"color: {C.accent}; font-weight: bold; font-size: 11px;")
+        layout.addWidget(self.summary_label)
+
+        # ── Buttons ──
+        self.button_box = QDialogButtonBox(
+            QDialogButtonBox.Ok | QDialogButtonBox.Cancel
+        )
+        self.button_box.accepted.connect(self.accept)
+        self.button_box.rejected.connect(self.reject)
+        layout.addWidget(self.button_box)
+
+        # Toggle slots visibility based on feature type
+        self.radio_hole.toggled.connect(self._toggle_slot_fields)
+        self.radio_slot.toggled.connect(self._toggle_slot_fields)
+
+        # If editing existing feature, populate
+        if feature:
+            self.set_feature(feature)
+
+        self._on_face_changed()
+        self._toggle_slot_fields()
+        self._update_preview_label()
+
+    def _on_face_changed(self) -> None:
+        """Update face dimension hints and max range based on current face."""
+        face = self.current_face()
+        dim_h = float(self.profile_dims.get('h', 240.0) or 240.0)
+        dim_b = float(self.profile_dims.get('b', 120.0) or 120.0)
+
+        if face in ('v', 'h'):
+            self.face_dim_label.setText(f"Face limit: 0 to {dim_h:.1f} mm (Web depth)")
+            self.y_spin.setRange(0.0, dim_h)
+        else:
+            self.face_dim_label.setText(f"Face limit: 0 to {dim_b:.1f} mm (Flange width)")
+            self.y_spin.setRange(0.0, dim_b)
+        self._update_preview_label()
+
+    def _align_y_center(self) -> None:
+        """Auto-align Y to the middle axis of the current face."""
+        face = self.current_face()
+        dim_h = float(self.profile_dims.get('h', 240.0) or 240.0)
+        dim_b = float(self.profile_dims.get('b', 120.0) or 120.0)
+        if face in ('v', 'h'):
+            self.y_spin.setValue(dim_h / 2.0)
+        else:
+            self.y_spin.setValue(dim_b / 2.0)
+
+    def _toggle_slot_fields(self) -> None:
+        """Enable or disable slot parameters depending on hole/slot selection."""
+        is_slot = self.radio_slot.isChecked()
+        self.len_spin.setEnabled(is_slot)
+        self.angle_spin.setEnabled(is_slot)
+        if is_slot and self.len_spin.value() < self.d_spin.value():
+            self.len_spin.setValue(self.d_spin.value() * 2.0)
+        self._update_preview_label()
+
+    def _on_diameter_changed(self, d: float) -> None:
+        if self.radio_slot.isChecked() and self.len_spin.value() < d:
+            self.len_spin.setValue(d * 1.5)
+        self._update_preview_label()
+
+    def _update_preview_label(self) -> None:
+        face = self.current_face().upper()
+        x = self.x_spin.value()
+        y = self.y_spin.value()
+        d = self.d_spin.value()
+        if self.radio_slot.isChecked():
+            length = self.len_spin.value()
+            ang = self.angle_spin.value()
+            self.summary_label.setText(
+                f"Slot: Ø{d:.1f} × {length:.1f}mm at Face {face} (X={x:.1f}, Y={y:.1f}), ∠{ang:.1f}°"
+            )
+        else:
+            self.summary_label.setText(
+                f"Round Hole: Ø{d:.1f}mm at Face {face} (X={x:.1f}, Y={y:.1f})"
+            )
+
+    def current_face(self) -> str:
+        idx = self.face_combo.currentIndex()
+        data = self.face_combo.itemData(idx)
+        return str(data or 'v')
+
+    def set_feature(self, feat: dict) -> None:
+        """Populate dialog from a feature dictionary."""
+        face = feat.get('face', 'v').lower()
+        idx = self.face_combo.findData(face)
+        if idx >= 0:
+            self.face_combo.setCurrentIndex(idx)
+
+        self.x_spin.setValue(float(feat.get('x', 0.0)))
+        self.y_spin.setValue(float(feat.get('y', 0.0)))
+        dia = float(feat.get('d', feat.get('diameter', 20.0)))
+        self.d_spin.setValue(dia)
+
+        length = float(feat.get('length', 0.0) or 0.0)
+        angle = float(feat.get('angle', 0.0) or 0.0)
+        kind = feat.get('kind', 'hole').lower()
+
+        if length > 0.0 or kind == 'slot':
+            self.radio_slot.setChecked(True)
+            self.len_spin.setValue(length if length > 0 else dia * 2.0)
+            self.angle_spin.setValue(angle)
+        else:
+            self.radio_hole.setChecked(True)
+
+        self._on_face_changed()
+        self._toggle_slot_fields()
+
+    def get_feature(self) -> dict:
+        """Return sanitized feature dictionary."""
+        is_slot = self.radio_slot.isChecked()
+        face = self.current_face()
+        x = round(self.x_spin.value(), 2)
+        y = round(self.y_spin.value(), 2)
+        d = round(self.d_spin.value(), 2)
+
+        data = {
+            'face': face,
+            'kind': 'slot' if is_slot else 'hole',
+            'x': x,
+            'y': y,
+            'd': d,
+            'length': round(self.len_spin.value(), 2) if is_slot else 0.0,
+            'angle': round(self.angle_spin.value(), 2) if is_slot else 0.0,
+        }
+        return data
