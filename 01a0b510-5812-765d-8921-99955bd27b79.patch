+"""point.py — 2D Point and Vector primitives.
+
+🚨 GUARDIAN LAW: Use these, not raw tuples. type safety + debugging السهل.
+"""
+from __future__ import annotations
+import math
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Point2D:
+    """نقطة ف المستوى XY."""
+    x: float = 0.0
+    y: float = 0.0
+
+    def distance_to(self, other: Point2D) -> float:
+        """المسافة الإقليدية بين نقطتين."""
+        return math.hypot(self.x - other.x, self.y - other.y)
+
+    def translated(self, dx: float, dy: float) -> Point2D:
+        """نقطة جديدة بعد الإزاحة."""
+        return Point2D(self.x + dx, self.y + dy)
+
+    def to_tuple(self) -> tuple:
+        return (self.x, self.y)
+
+
+@dataclass(frozen=True)
+class Vector2D:
+    """متجهة ف المستوى XY (للاتجاهات)."""
+    dx: float = 0.0
+    dy: float = 0.0
+
+    def length(self) -> float:
+        return math.hypot(self.dx, self.dy)
+
+    def normalized(self) -> Vector2D:
+        length = self.length()
+        if length < 1e-9:
+            return Vector2D(0.0, 0.0)
+        return Vector2D(self.dx / length, self.dy / length)
