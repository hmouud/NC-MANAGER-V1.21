+"""Tests for the flexible Smart Foreshortening math engine.
+
+Covers: relative (length-agnostic) void detection, the real<->display
+translation mapping and its exact inverse, break marks for the renderer, and
+measurement integrity across a hidden void (always true physical distance).
+"""
+
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+
+from nccorrection.engine.math.foreshorten import (
+    Foreshorten, build_foreshorten, merge_zones, find_voids,
+)
+
+
+class TestVoidDetection(unittest.TestCase):
+    def test_long_beam_single_central_void_cut(self):
+        # 70 000 mm beam, detail zones only at the two ends.
+        L = 70000.0
+        populated, cut = find_voids(L, [(0, 800), (69200, 70000)])
+        self.assertEqual(populated, [(0.0, 800.0), (69200.0, 70000.0)])
+        self.assertEqual(cut, [(800.0, 69200.0)])   # 68 400 mm = 97.7% of L
+
+    def test_short_part_insignificant_gap_not_cut(self):
+        # 6 490 mm part, zones almost contiguous -> the 100 mm gap is far
+        # below the 10% threshold (649 mm) and must NOT be cut.
+        populated, cut = find_voids(6490.0, [(0, 3000), (3100, 6490)])
+        self.assertEqual(cut, [])                    # gap only 100 mm = 1.5%
+
+    def test_relative_threshold_length_agnostic(self):
+        # Identical *fraction* of total length -> identical cuttable decision
+        # for a 6 490 mm and a 70 000 mm part.
+        _, cut_a = find_voids(6490.0, [(0, 100), (6400, 6490)])
+        _, cut_b = find_voids(70000.0, [(0, 1000), (69000, 70000)])
+        self.assertEqual(len(cut_a), len(cut_b))
+        self.assertTrue(cut_a)                       # 96.9% / 97.1% both > 10%
+
+    def test_overlapping_and_adjacent_zones_merged(self):
+        zones = [(100, 200), (180, 260), (280, 320)]  # overlap + adjacent (20 mm gap < 0.5% tol)
+        merged = merge_zones(5000.0, zones)
+        self.assertEqual(merged, [(100.0, 320.0)])
+
+    def test_zones_clamped_into_part_length(self):
+        merged = merge_zones(5000.0, [( -50, 600), (4800, 5200)])
+        self.assertEqual(merged, [(0.0, 600.0), (4800.0, 5000.0)])
+
+
+class TestForeshortenMapping(unittest.TestCase):
+    def setUp(self):
+        self.f = build_foreshorten(12000.0, [(0, 1000), (11500, 12000)])
+
+    def test_mapping_is_monotonic_and_pinned(self):
+        self.assertEqual(self.f.map_real_to_screen(0.0), 0.0)
+        self.assertEqual(self.f.map_real_to_screen(12000.0),
+                         self.f.display_length)
+
+    def test_round_trip_inverse(self):
+        for x in (0.0, 200.0, 1000.0, 6000.0, 11500.0, 11900.0, 12000.0):
+            s = self.f.map_real_to_screen(x)
+            self.assertAlmostEqual(self.f.map_screen_to_real(s), x,
+                                   delta=1e-6)
+
+    def test_measure_across_hidden_void_is_true_distance(self):
+        # The two endpoints straddle the 10 500 mm hidden void. On screen the
+        # span is compressed, but re-mapping both endpoints must reproduce the
+        # physical 11 700 mm.
+        a, b = 200.0, 11900.0
+        sa, sb = self.f.map_real_to_screen(a), self.f.map_real_to_screen(b)
+        self.assertLess(sb - sa, b - a)              # visually shortened
+        ra = self.f.map_screen_to_real(sa)
+        rb = self.f.map_screen_to_real(sb)
+        self.assertAlmostEqual(rb - ra, b - a, delta=1e-6)
+
+    def test_compression_proportional(self):
+        # 10 500 mm void at compress=0.10 -> display 1 050 mm.
+        self.assertAlmostEqual(self.f.display_length, 2550.0, delta=1e-6)
+
+    def test_break_marks(self):
+        marks = self.f.break_marks()
+        self.assertEqual(len(marks), 1)
+        m = marks[0]
+        self.assertEqual(m['x0'], 1000.0)
+        self.assertEqual(m['x1'], 11500.0)
+        self.assertEqual(m['sx0'], 1000.0)
+        self.assertEqual(m['sx1'], 2050.0)           # 10 500 * 0.1 + 1000
+
+    def test_no_voids_identity_mapping(self):
+        f = build_foreshorten(6490.0, [(0, 6490)])
+        self.assertEqual(f.void_count, 0)
+        self.assertEqual(f.display_length, 6490.0)
+        for x in (0.0, 100.0, 3000.0, 6490.0):
+            self.assertAlmostEqual(f.map_screen_to_real(f.map_real_to_screen(x)),
+                                   x, delta=1e-6)
+
+    def test_full_length_void_falls_back_to_center(self):
+        # No zones at all: the entire part is one void; the mapping must still
+        # be monotonic and invertible (identity-like compressed single step).
+        f = build_foreshorten(70000.0, [])
+        self.assertEqual(f.void_count, 1)
+        self.assertEqual(f.map_real_to_screen(0.0), 0.0)
+        self.assertEqual(f.map_real_to_screen(70000.0), f.display_length)
+
+
+class TestForeshortenValidation(unittest.TestCase):
+    def test_bad_arguments_rejected(self):
+        with self.assertRaises(ValueError):
+            build_foreshorten(0.0, [])
+        with self.assertRaises(ValueError):
+            build_foreshorten(5000.0, [], threshold=0.0)
+        with self.assertRaises(ValueError):
+            build_foreshorten(5000.0, [], compress=1.5)
+
+
+if __name__ == '__main__':
+    unittest.main()
