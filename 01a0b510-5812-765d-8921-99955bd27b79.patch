+        # No HEADER section; 0 / ENTITIES marker alone is enough.
+        text = '0\nSECTION\n2\nENTITIES\n0\nLINE\n8\n0\n10\n0.0\n20\n0.0\n11\n1.0\n21\n1.0\n0\nENDSEC\n0\nEOF\n'
+        path = _write_tmp(text, '.dxf')
+        try:
+            self.assertEqual(detect_format(path), 'DXF')
+        finally:
+            os.remove(path)
+
+    def test_binary_dxf_magic_detected(self):
+        fd, path = tempfile.mkstemp(suffix='.dxf')
+        with os.fdopen(fd, 'wb') as fh:
+            fh.write(b'AutoCAD Binary DXF\r\n\x1a\x00rest-of-file-bytes')
+        try:
+            self.assertEqual(detect_format(path), 'DXF')
+        finally:
+            os.remove(path)
+
+    def test_unknown_plain_text(self):
+        path = _write_tmp('hello world\nplain text, no signature\n', '.txt')
+        try:
+            self.assertEqual(detect_format(path), 'UNKNOWN')
+        finally:
