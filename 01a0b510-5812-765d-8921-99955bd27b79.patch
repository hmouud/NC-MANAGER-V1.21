+        # Create: [+] Add Hole/Slot at the clicked 2D position - opens the
+        # hole editor in ADD mode on the added-holes store (same store the
+        # paste flow uses). Cancel removes the record again; Save merges it.
+        if view == '2d' and local_pos is not None:
+            act = menu.addAction('[\u002b] Add Hole/Slot')
+            act.triggered.connect(
+                lambda: self._start_add_hole(view, local_pos))
+            menu.addSeparator()
+        # Measure (toggle)
+```
