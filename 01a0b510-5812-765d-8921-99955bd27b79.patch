index 0000000..9d9e79b
--- /dev/null
+++ b/src/nccorrection/core/input_mode.py
@@ -0,0 +1,87 @@
+"""Input modes for the cross-section (Y) coordinate of holes and slots.
+
+A machinist usually thinks of a hole position on a face in one of three
+ways, and the software must honour whichever mode is picked per face:
+
+* ``abs`` — absolute DSTV coordinate, straight from the origin (default,
+  identical to the historic behaviour);
+* ``sym`` — a signed offset from the **middle of the face** (the neutral
+  axis of its cross-section span). For face ``v``/``h`` of an I/U/C section
+  the span is the web height ``H`` (centre ``H/2``); for the flanges
+  ``o``/``u`` it is the flange breadth ``b`` (centre ``b/2``). A positive
+  value runs toward the top of the face, a negative one toward the bottom,
+  so ``+10`` and ``-10`` move the hole symmetrically about the centre;
+* ``top`` — a positive offset measured **from the top of the face** (its
+  maximum Y), flowing downward.
+
+Only the absolute coordinate is stored in the edit model, so the 3D
+position is unambiguous and every view (2D, 3D, blueprint, table, NC1
+text, temp file) renders the same single result; the modes are purely an
+entry convenience layered on top.
+
+The span table mirrors the DSTV conventions in :mod:`face_planes`:
+
+    dims (I):     [length, H, b, tf, tw]      v/h -> H, o/u -> b
+    dims (C/U):   [length, H, b, tw, tf]      v/h -> H, o/u -> b
+    dims (L):     [length, a, b, t]           v -> b,  u -> a
+    dims (B/P):   [length, width, thickness]  v -> width
+"""
+
+
+from nccorrection.core._dim import dim as _dim  # noqa: E402
+
+
+def y_span(st_type, dims, face):
+    """Cross-section span (the Y range) of a face, or 0.0 when unknown."""
+    t = (st_type or '').upper()
+    face = (face or 'v').lower()
+    dims = dims or ()
+    if t in ('I', 'C', 'U', 'T', 'S', 'Z', 'Z2'):
+        if face in ('v', 'h'):
+            return _dim(dims, 1)         # web height H
+        return _dim(dims, 2)             # flange breadth b / leg
+    if t == 'L':
+        # Angle: face v is the vertical leg b (dims[2]), face u is the
+        # horizontal leg a (dims[1]) — see face_planes._l_frame / part3d._cs_l.
+        return _dim(dims, 2) if face in ('v', 'h') else _dim(dims, 1)
+    if t in ('B', 'P'):
+        return _dim(dims, 1)             # plate width
+    return 0.0
+
+
+def absolute_y(st_type, dims, face, mode, value):
+    """A user-entered ``value`` in ``mode`` -> absolute DSTV Y."""
+    m = (mode or 'abs').lower()
+    value = float(value)
+    if m == 'abs':
+        return value
+    span = y_span(st_type, dims, face)
+    if not span:
+        return value
+    if m == 'sym':
+        return span / 2.0 + value
+    if m == 'top':
+        return span - value
+    return value
+
+
+def relative_y(st_type, dims, face, mode, value):
+    """An absolute DSTV Y -> the value to display for ``mode``."""
+    m = (mode or 'abs').lower()
+    value = float(value)
+    if m == 'abs':
+        return value
+    span = y_span(st_type, dims, face)
+    if not span:
+        return value
+    if m == 'sym':
+        return value - span / 2.0
+    if m == 'top':
+        return span - value
+    return value
+
+
+def y_centre(st_type, dims, face):
+    """The neutral axis coordinate for ``sym`` mode on a face."""
+    span = y_span(st_type, dims, face)
+    return span / 2.0 if span else 0.0
