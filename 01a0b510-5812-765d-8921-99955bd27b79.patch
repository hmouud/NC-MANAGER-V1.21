+"""notch_detector.py — Detect notches (w, t) in AK/IK blocks.
+
+🚨 GUARDIAN LAW: Single responsibility — detection فقط.
+ما كايحتويش على parsing (هادشي ف suffix_parser.py).
+ما كايحتويش على building (هادشي ف contour_builder.py — Phase 4).
+
+الهدف: كايقرا بلوك AK ولا IK كامل، كايرجع:
+    - list[ContourPoint] لكل وجه
+    - list[ContourPoint] ديال الـ notches فقط (للـ Debug/Validation)
+
+المصادر (من PROJECT_STATE.md):
+    - 'w' = Hole/Notch (مؤكد من SDS/2 CNC PDF + Byndyusoft.DSTV.Net)
+    - 't' = Tangential Notch
+    - الـ suffix كايجي على X ولا على Y (بجوج).
+"""
+from __future__ import annotations
+from typing import Dict, List
+
+from ..core.enums import Face
+from ..models.contour_point import ContourPoint
+from .suffix_parser import parse_ak_line
+
+
+class NotchDetector:
+    """كايقرا بلوك AK/IK و كايكتشف الـ notches.
+
+    الاستعمال:
+        detector = NotchDetector()
+        detector.feed_line("  v  0.00u  13.88  ...")
+        points = detector.get_points(Face.V)
+        notches = detector.get_notches()
+    """
+
+    def __init__(self) -> None:
+        self._points: Dict[Face, List[ContourPoint]] = {}
+        self._notches: List[ContourPoint] = []
+
+    def feed_line(self, line: str) -> bool:
+        """كاياخد سطر خام و كايضيفو إلا كان صالح.
+
+        Returns:
+            True إلا كانت النقطة صالحة و تزادت.
+        """
+        face_char, parsed = parse_ak_line(line)
+
+        if face_char is None or not parsed:
+            return False
+
+        try:
+            face = Face(face_char)
+        except ValueError:
+            return False
+
+        if len(parsed) < 2:
+            return False
+
+        x, x_suffix = parsed[0]
+        y, y_suffix = parsed[1]
+
+        suffix = x_suffix if x_suffix is not None else y_suffix
+
+        bulge = parsed[2][0] if len(parsed) > 2 else 0.0
+        angle = parsed[3][0] if len(parsed) > 3 else 0.0
+        thickness = parsed[4][0] if len(parsed) > 4 else 0.0
+
+        point = ContourPoint(
+            x=x, y=y, face=face,
+            suffix=suffix,
+            bulge=bulge, angle=angle, thickness=thickness,
+        )
+
+        self._points.setdefault(face, []).append(point)
+
+        if point.has_special_suffix:
+            self._notches.append(point)
+
+        return True
+
+    def feed_block(self, lines: List[str]) -> int:
+        """كاياخد بلوك كامل (list of strings) و كايغذي كل السطور.
+
+        Returns:
+            عدد السطور اللي تزادو بنجاح.
+        """
+        count = 0
+        for line in lines:
+            if self.feed_line(line):
+                count += 1
+        return count
+
+    def get_points(self, face: Face) -> List[ContourPoint]:
+        """كايرجع نقاط وجه معين."""
+        return list(self._points.get(face, []))
+
+    def get_all_points(self) -> Dict[Face, List[ContourPoint]]:
+        """كايرجع كل النقاط لكل الوجوه."""
+        return {face: list(pts) for face, pts in self._points.items()}
+
+    def get_notches(self) -> List[ContourPoint]:
+        """كايرجع كل الـ notches (w + t)."""
+        return list(self._notches)
+
+    def get_holes(self) -> List[ContourPoint]:
+        """كايرجع الـ notches ديال نوع 'w' فقط."""
+        return [p for p in self._notches if p.is_notch]
+
+    def get_tangential_notches(self) -> List[ContourPoint]:
+        """كايرجع الـ notches ديال نوع 't' فقط."""
+        return [p for p in self._notches if p.is_tangential]
+
+    @property
+    def total_points(self) -> int:
+        return sum(len(pts) for pts in self._points.values())
+
+    @property
+    def total_notches(self) -> int:
+        return len(self._notches)
+
+    @property
+    def has_notches(self) -> bool:
+        return bool(self._notches)
+
+    def reset(self) -> None:
+        """كايفرّغ كلشي (باش نعاودو نستعملو الكائن)."""
+        self._points.clear()
+        self._notches.clear()
