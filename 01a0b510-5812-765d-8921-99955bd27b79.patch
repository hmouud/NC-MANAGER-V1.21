+
+    def _on_add_hole_dialog(self) -> None:
+        """Open HoleSlotDialog to add a new circular hole."""
+        dlg = HoleSlotDialog(
+            parent=self,
+            mode="hole",
+            profile_dims=self._current_profile_dims(),
+            max_length=self.state_ctrl.state.profile.length,
+        )
+        if dlg.exec():
+            feat = dlg.get_feature()
+            self.state_ctrl.add_hole(feat)
+            self.hole_added.emit(feat['face'], feat['x'], feat['y'], feat['d'])
+            self.status_label.setText(f"Hole added at ({feat['x']}, {feat['y']})")
+
+    def _on_add_slot_dialog(self) -> None:
+        """Open HoleSlotDialog to add a new slotted hole."""
+        dlg = HoleSlotDialog(
+            parent=self,
+            mode="slot",
+            profile_dims=self._current_profile_dims(),
+            max_length=self.state_ctrl.state.profile.length,
+        )
+        if dlg.exec():
+            feat = dlg.get_feature()
+            self.state_ctrl.add_slot(feat)
+            self.slot_added.emit(feat['face'], feat['x'], feat['y'], feat['d'], feat['length'])
+            self.status_label.setText(f"Slot added at ({feat['x']}, {feat['y']})")
+
+    def _on_edit_feature(self, row: int) -> None:
+        """Edit an existing feature at row."""
+        feat = self.state_ctrl.get_feature(row)
+        if not feat:
+            return
+        dlg = HoleSlotDialog(
+            parent=self,
+            mode="edit",
+            feature=feat,
+            profile_dims=self._current_profile_dims(),
+            max_length=self.state_ctrl.state.profile.length,
+        )
+        if dlg.exec():
+            updated = dlg.get_feature()
+            self.state_ctrl.update_feature(row, updated)
+            self.status_label.setText(f"Feature {row + 1} updated")
+
+    def _on_duplicate_feature(self, row: int) -> None:
+        """Duplicate feature at row with +50mm X offset."""
+        dup = self.state_ctrl.duplicate_feature(row, dx=50.0)
+        if dup:
+            self.status_label.setText(f"Duplicated feature to X={dup['x']:.1f}")
+
+    def _on_delete_feature(self, row: int) -> None:
+        """Delete feature at row."""
+        if self.state_ctrl.remove_feature(row):
+            self.status_label.setText(f"Feature {row + 1} removed")
+
+    def _on_change_feature_face(self, row: int, new_face: str) -> None:
+        """Change the face of the feature at row."""
+        feat = self.state_ctrl.get_feature(row)
+        if feat:
+            feat['face'] = new_face
+            self.state_ctrl.update_feature(row, feat)
+            self.status_label.setText(f"Feature {row + 1} moved to face {new_face.upper()}")
+
+    def _on_feature_cell_edited(self, row: int, col: int, val: str) -> None:
+        """Handle inline double-click cell edits in holes table without modal dialog."""
+        feat = self.state_ctrl.get_feature(row)
+        if not feat:
+            return
+        feat = copy.deepcopy(feat)
+        try:
+            if col == 0:  # Face
+                f = val.lower()
+                if f in ('v', 'o', 'u', 'h'):
+                    feat['face'] = f
+            elif col == 1:  # Kind
+                if 'slot' in val.lower():
+                    feat['kind'] = 'slot'
+                    if float(feat.get('length', 0) or 0) <= 0:
+                        feat['length'] = 30.0
+                else:
+                    feat['kind'] = 'hole'
+                    feat['length'] = 0.0
+            elif col == 2:  # X
+                feat['x'] = float(val)
+            elif col == 3:  # Y
+                feat['y'] = float(val)
+            elif col == 4:  # Diameter
+                feat['d'] = float(val.replace('Ø', '').strip())
+            elif col == 5:  # Length
+                clean = val.replace('—', '').replace('-', '').strip()
+                if clean:
+                    feat['length'] = float(clean)
+                    feat['kind'] = 'slot'
+                else:
+                    feat['length'] = 0.0
+                    feat['kind'] = 'hole'
+            elif col == 6:  # Angle
+                clean = val.replace('°', '').replace('—', '').replace('-', '').strip()
+                if clean:
+                    feat['angle'] = float(clean)
+        except ValueError:
+            return  # invalid input, ignore
+        self.state_ctrl.update_feature(row, feat)
+        self.status_label.setText(f"Feature {row + 1} updated inline")
+
+    def _on_modify_delete(self) -> None:
+        """Delete key handler: deletes selected row in right panel table."""
+        row = self.right_panel.selected_row()
+        if row >= 0:
+            self._on_delete_feature(row)
+
+    # ────────────────────────────────────────────────────────────────
+    # Interactive Canvas Placement & Cut Tool
+    # ────────────────────────────────────────────────────────────────
+
+    def _on_create_cut(self) -> None:
+        """Start interactive cut creation workflow (silent HUD, crosshair cursor)."""
+        self._active_tool = 'cut'
+        self._cut_step = 1
+        self._cut_data = {}
+        self.canvas.setCursor(Qt.CrossCursor)
+        self.hud.start_prompt("CUT", "Pick first corner point on profile (click or enter 'x, y'):", "")
+        self.status_label.setText("Cut Tool active — click first corner point on profile")
+
+    def _handle_cut_click(self, x: float, y: float) -> None:
+        """Process click coordinates during cut creation."""
+        x = round(x, 2)
+        y = round(y, 2)
+        if self._cut_step == 1:
+            self._cut_data['x1'] = x
+            self._cut_data['y1'] = y
+            self._cut_step = 2
+            self.hud.update_prompt(
+                f"Corner 1: ({x:.1f}, {y:.1f}). Enter cut length ΔX (mm) or click second corner:",
+                "50.0"
+            )
+            self.status_label.setText(f"Corner 1: ({x:.1f}, {y:.1f})")
+        elif self._cut_step in (2, 3):
+            x1 = self._cut_data.get('x1', 0.0)
+            y1 = self._cut_data.get('y1', 0.0)
+            dx = abs(x - x1)
+            dy = abs(y - y1)
+            if dx > 0 and dy > 0:
+                self._cut_data['dx'] = dx
+                self._cut_data['dy'] = dy
+                self._finalize_cut()
+
+    def _on_hud_value_entered(self, val: float) -> None:
+        """Handle numeric input in HUD (length ΔX or depth ΔY)."""
+        if self._active_tool != 'cut':
+            return
+        if self._cut_step == 2:
+            self._cut_data['dx'] = abs(val)
+            self._cut_step = 3
+            self.hud.update_prompt(
+                f"Length ΔX={abs(val):.1f}mm. Enter cut depth ΔY (mm):",
+                "30.0"
+            )
+        elif self._cut_step == 3:
+            self._cut_data['dy'] = abs(val)
+            self._finalize_cut()
