+def _rot_matrix(rot, elev):
+    cr, sr = math.cos(rot), math.sin(rot)
+    ce, se = math.cos(elev), math.sin(elev)
+    return (
+        (cr, -sr, 0.0),
+        (sr * ce, cr * ce, -se),
+        (sr * se, cr * se, ce),
+    )
+
+
+def _mmul(A, B):
+    """3x3 matrix product (column-vector convention: A applied after B)."""
+    return (
+        (A[0][0] * B[0][0] + A[0][1] * B[1][0] + A[0][2] * B[2][0],
+         A[0][0] * B[0][1] + A[0][1] * B[1][1] + A[0][2] * B[2][1],
+         A[0][0] * B[0][2] + A[0][1] * B[1][2] + A[0][2] * B[2][2]),
+        (A[1][0] * B[0][0] + A[1][1] * B[1][0] + A[1][2] * B[2][0],
+         A[1][0] * B[0][1] + A[1][1] * B[1][1] + A[1][2] * B[2][1],
+         A[1][0] * B[0][2] + A[1][1] * B[1][2] + A[1][2] * B[2][2]),
+        (A[2][0] * B[0][0] + A[2][1] * B[1][0] + A[2][2] * B[2][0],
+         A[2][0] * B[0][1] + A[2][1] * B[1][1] + A[2][2] * B[2][1],
+         A[2][0] * B[0][2] + A[2][1] * B[1][2] + A[2][2] * B[2][2]),
+    )
+
+
+def _axis_angle_matrix(axis, angle):
+    """Rotation matrix (Rodrigues) about a unit axis."""
+    ax, ay, az = axis
+    c, s = math.cos(angle), math.sin(angle)
+    t = 1.0 - c
+    return (
+        (t * ax * ax + c,     t * ax * ay - s * az, t * ax * az + s * ay),
+        (t * ax * ay + s * az, t * ay * ay + c,     t * ay * az - s * ax),
+        (t * ax * az - s * ay, t * ay * az + s * ax, t * az * az + c),
+    )
+
+
+def _mapply(R, p):
+    return (R[0][0] * p[0] + R[0][1] * p[1] + R[0][2] * p[2],
+            R[1][0] * p[0] + R[1][1] * p[1] + R[1][2] * p[2],
+            R[2][0] * p[0] + R[2][1] * p[1] + R[2][2] * p[2])
+
+
+def _mtranspose(R):
+    return tuple(tuple(R[j][i] for j in range(3)) for i in range(3))
