+class SheaveShape(PlateShape):
+    """Wheel / sheave with hub and rim."""
+    name = "Sheave"
+    category = "Special"
+    parameters = [
+        ShapeParam("Outer radius", "outer_radius", 120.0, 5.0, 5000.0),
+        ShapeParam("Hub radius", "hub_radius", 30.0, 1.0, 4999.0),
+        ShapeParam("Bore radius", "bore_radius", 12.0, 0.0, 4999.0),
+        ShapeParam("Number of spokes", "n_spokes", 4.0, 0.0, 12.0),
+        ShapeParam("Spoke width", "spoke_width", 10.0, 2.0, 500.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        R = p["outer_radius"]
+        hr = p["hub_radius"]
+        br = p["bore_radius"]
+        n = int(p["n_spokes"])
+        sw = p["spoke_width"]
+        outer = _circle_pts(0, 0, R)
+        inners = []
+        # Hub hole
+        if br > 1.0:
+            inners.append(_circle_pts(0, 0, br))
+        # Rim cutout between spokes
+        if n > 0 and hr < R - 5:
+            rim_inner = hr + 5
+            rim_outer = R - 5
+            if rim_outer > rim_inner:
+                for i in range(n):
+                    a_start = 90.0 + 360.0 * i / n + 15
+                    a_end = 90.0 + 360.0 * (i + 1) / n - 15
+                    if a_end > a_start:
+                        arc_out = _arc_pts(0, 0, rim_outer, a_start, a_end, 12)
+                        arc_in = _arc_pts(0, 0, rim_inner, a_end, a_start, 12)
+                        inners.append(arc_out + arc_in)
+        return ShapeResult(outer=outer, inners=inners)
