+"""Tests for writers/nc1_formatter.py + writers/nc1_writer_advanced.py."""
+import unittest
+from nccorrection.engine.contour.writers.nc1_formatter import format_point, face_to_bo_op
+from nccorrection.engine.contour.writers.nc1_writer_advanced import NC1WriterAdvanced
+from nccorrection.engine.contour.models.contour_point import ContourPoint
+from nccorrection.engine.contour.models.contour import Contour
+from nccorrection.engine.contour.core.enums import Face, PointSuffix
+
+
+class TestFormatPoint(unittest.TestCase):
+    def test_start_point(self):
+        pt = ContourPoint(x=0.0, y=0.0, face=Face.V, suffix=PointSuffix.S)
+        line = format_point(pt)
+        self.assertTrue(line.startswith("  v"))
+        self.assertIn("0.00s", line)
+
+    def test_notch_point(self):
+        pt = ContourPoint(x=548.63, y=262.0, face=Face.V, suffix=PointSuffix.W)
+        line = format_point(pt)
+        self.assertIn("548.63w", line)
+
+    def test_plain_point(self):
+        pt = ContourPoint(x=100.0, y=200.0, face=Face.O)
+        line = format_point(pt)
+        self.assertIn("100.00", line)
+        self.assertIn("200.00", line)
+
+
+class TestFaceToBoOp(unittest.TestCase):
+    def test_v_face_maps_to_v(self):
+        self.assertEqual(face_to_bo_op(Face.V), "v")
+
+    def test_o_face_maps_to_v(self):
+        self.assertEqual(face_to_bo_op(Face.O), "v")
+
+    def test_h_face_maps_to_h(self):
+        self.assertEqual(face_to_bo_op(Face.H), "h")
+
+
+class TestNC1WriterAdvanced(unittest.TestCase):
+    def test_build_simple_contour(self):
+        contour = Contour(face=Face.V)
+        contour.add_points([
+            ContourPoint(x=0, y=0, face=Face.V, suffix=PointSuffix.S),
+            ContourPoint(x=100, y=0, face=Face.V, suffix=PointSuffix.U),
+            ContourPoint(x=100, y=50, face=Face.V, suffix=PointSuffix.U),
+            ContourPoint(x=0, y=50, face=Face.V, suffix=PointSuffix.U),
+            ContourPoint(x=0, y=0, face=Face.V),
+        ])
+        writer = NC1WriterAdvanced(
+            header_lines=["ST", "  I", "EN"],
+            contours={Face.V: contour},
+        )
+        text = writer.build()
+        self.assertIn("ST", text)
+        self.assertIn("AK", text)
+        self.assertIn("EN", text)
+        self.assertIn("  v", text)
+
+    def test_ordered_faces(self):
+        contour_v = Contour(face=Face.V)
+        contour_v.add_points([
+            ContourPoint(x=0, y=0, face=Face.V, suffix=PointSuffix.S),
+            ContourPoint(x=10, y=0, face=Face.V),
+            ContourPoint(x=10, y=10, face=Face.V),
+            ContourPoint(x=0, y=10, face=Face.V),
+            ContourPoint(x=0, y=0, face=Face.V),
+        ])
+        writer = NC1WriterAdvanced(
+            header_lines=["ST", "EN"],
+            contours={Face.V: contour_v},
+        )
+        text = writer.build()
+        ak_pos = text.index("AK")
+        # Use rindex to find the FINAL EN (header also has "EN")
+        en_pos = text.rindex("EN")
+        self.assertLess(ak_pos, en_pos)
