+"""Tests for the isolated CAD snap engine (engine/math/osnap.py).
+
+Covers the strict math primitives (line-line and line-arc intersection, the
+per-kind detectors), the resolver tie-breaking and the design-layer facade
+that re-exports the engine under the viewer-facing names.
+"""
+
+import os
+import sys
+import unittest
+import math
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+
+from nccorrection.engine.math.osnap import (
+    OsnapTargets, resolve_osnap, os_line_line_intersection,
+    os_line_arc_intersection, closest_on_segment, polar_snap, stadium_rim,
+    ENDPOINT, MIDPOINT, NEAREST, INTERSECTION, CENTRE, TANGENT,
+    EXTENSION, INSERTION, OSNAP_KINDS,
+)
+
+
+class TestLinePrimitives(unittest.TestCase):
+    def test_line_line_crossing(self):
+        pt = os_line_line_intersection((0, 0), (100, 0), (50, -10), (50, 60))
+        self.assertEqual(pt, (50, 0))
+
+    def test_line_line_parallel(self):
+        self.assertIsNone(os_line_line_intersection((0, 0), (1, 0), (0, 1), (1, 1)))
+
+    def test_line_arc_two_points(self):
+        # horizontal line y=25 through the circle centre (50, 25) r=10
+        pts = os_line_arc_intersection((0, 25), (100, 25), (50, 25), 10.0)
+        self.assertEqual(len(pts), 2)
+        for x, y in pts:
+            self.assertAlmostEqual((x - 50) ** 2 + (y - 25) ** 2, 100.0, places=6)
+
+    def test_line_arc_tangent_one_point(self):
+        # horizontal line y=35 is exactly one radius (10) above the centre
+        pts = os_line_arc_intersection((0, 35), (100, 35), (50, 25), 10.0)
+        self.assertEqual(len(pts), 1)
+        x, y = pts[0]
+        self.assertAlmostEqual(x, 50.0, places=6)
+        self.assertAlmostEqual(y, 35.0, places=6)
+
+    def test_line_arc_miss(self):
+        pts = os_line_arc_intersection((0, 60), (100, 60), (50, 25), 10.0)
+        self.assertEqual(pts, [])
+
+    def test_closest_on_segment(self):
+        q, t = closest_on_segment((60, 6), (0, 0), (100, 0))
+        self.assertEqual(q, (60, 0))
+        self.assertEqual(t, 0.6)
+
+
+class TestResolve(unittest.TestCase):
+    def _rect(self):
+        return OsnapTargets(
+            points=[(0, 0), (100, 0), (100, 50), (0, 50)],
+            segments=[((0, 0), (100, 0)), ((100, 0), (100, 50)),
+                      ((100, 50), (0, 50)), ((0, 50), (0, 0))],
+            circles=[(50, 25, 10)],
+            insertion=(0, 0),
+        )
+
+    def test_endpoint(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (3, 4), (ENDPOINT,), tol=12)
+        self.assertEqual((kind, pt), (ENDPOINT, (0, 0)))
+
+    def test_midpoint(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (50, 5), (MIDPOINT,), tol=12)
+        self.assertEqual((kind, pt), (MIDPOINT, (50, 0)))
+
+    def test_nearest(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (60, 6), (NEAREST,), tol=12)
+        self.assertEqual((kind, pt), (NEAREST, (60, 0)))
+
+    def test_centre(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (50, 25), (CENTRE,), tol=12)
+        self.assertEqual((kind, pt), (CENTRE, (50, 25)))
+
+    def test_tangent(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (37, 25), (TANGENT,), tol=12)
+        self.assertEqual(kind, TANGENT)
+        self.assertAlmostEqual((pt[0] - 50) ** 2 + (pt[1] - 25) ** 2, 100.0, places=3)
+
+    def test_extension(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (125, 8), (EXTENSION,), tol=12)
+        self.assertEqual((kind, pt), (EXTENSION, (125, 0)))
+
+    def test_insertion(self):
+        pt, kind, _ = resolve_osnap(self._rect(), (3, 3), (INSERTION,), tol=12)
+        self.assertEqual((kind, pt), (INSERTION, (0, 0)))
+
+    def test_intersection_line_line(self):
+        t = OsnapTargets(segments=[((0, 0), (100, 0)), ((50, -10), (50, 60))])
+        pt, kind, _ = resolve_osnap(t, (52, 3), (INTERSECTION,), tol=12)
+        self.assertEqual((kind, pt), (INTERSECTION, (50, 0)))
+
+    def test_intersection_line_arc(self):
+        # vertical segment x=60; distance from circle centre (50,25) to the
+        # line is exactly r=10 -> tangent, one double root at (60, 25)
+        t = OsnapTargets(segments=[((60, -20), (60, 70))], circles=[(50, 25, 10)])
+        pt, kind, _ = resolve_osnap(t, (60, 25), (INTERSECTION,), tol=12)
+        self.assertEqual(kind, INTERSECTION)
+        self.assertEqual(pt, (60, 25))
+
+    def test_intersection_line_arc_two_roots(self):
+        # vertical segment x=55: two crossings at y = 25 ± sqrt(75)
+        t = OsnapTargets(segments=[((55, -20), (55, 70))], circles=[(50, 25, 10)])
+        pt, kind, _ = resolve_osnap(t, (55, 25), (INTERSECTION,), tol=12)
+        self.assertEqual(kind, INTERSECTION)
+        self.assertAlmostEqual(abs(pt[1] - 25.0), 8.660254, places=4)
+
+    def test_priority_on_equal_distance(self):
+        # exactly on a corner: endpoint (prio 0) beats nearest (prio 5)
+        t = self._rect()
+        pt, kind, _ = resolve_osnap(t, (0, 0), (ENDPOINT, NEAREST))
+        self.assertEqual(kind, ENDPOINT)
+
+    def test_all_kinds_cover_osnap_kinds(self):
+        self.assertEqual(len(OSNAP_KINDS), 8)
+
