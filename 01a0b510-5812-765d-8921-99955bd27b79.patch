+class CircFlangeWithKeyholesShape(PlateShape):
+    """Flange with keyhole-shaped bolt slots."""
+    name = "Circ Flange w Keyholes"
+    category = "Circular"
+    parameters = [
+        ShapeParam("Flange radius", "flange_radius", 120.0, 5.0, 5000.0),
+        ShapeParam("Bore radius", "bore_radius", 25.0, 0.0, 4999.0),
+        ShapeParam("Bolt circle radius", "bolt_radius", 95.0, 5.0, 4999.0),
+        ShapeParam("Keyhole radius", "kh_radius", 8.0, 1.0, 200.0),
+        ShapeParam("Keyhole slot length", "kh_slot", 15.0, 1.0, 500.0),
+        ShapeParam("Number of keyholes", "n_holes", 6.0, 1.0, 36.0),
+    ]
+
+    def generate(self, params: dict) -> ShapeResult:
+        p = self.validate(params)
+        fr = p["flange_radius"]
+        br = p["bore_radius"]
+        bcr = p["bolt_radius"]
+        kr = p["kh_radius"]
+        ks = p["kh_slot"]
+        n = int(p["n_holes"])
+        outer = _circle_pts(0, 0, fr)
+        inners = []
+        if br > 1.0:
+            inners.append(_circle_pts(0, 0, br))
+        for i in range(n):
+            a = math.radians(90.0 + 360.0 * i / n)
+            cos_a, sin_a = math.cos(a), math.sin(a)
+            cx = bcr * cos_a
+            cy = bcr * sin_a
+            # Keyhole = circle + slot outward
+            kh_pts = _circle_pts(cx, cy, kr, 16)
+            # Slot extends outward from keyhole
+            slot_end_x = (bcr + ks) * cos_a
+            slot_end_y = (bcr + ks) * sin_a
+            slot_pts = _circle_pts(slot_end_x, slot_end_y, kr, 16)
+            # Connect with tangent lines (simplified: convex hull of both circles)
+            combined = kh_pts + slot_pts
+            # Use a simple angular sort to get outline
+            centroid_x = sum(pt[0] for pt in combined) / len(combined)
+            centroid_y = sum(pt[1] for pt in combined) / len(combined)
+            combined.sort(key=lambda pt: math.atan2(pt[1] - centroid_y, pt[0] - centroid_x))
+            inners.append(combined)
+        return ShapeResult(outer=outer, inners=inners)
+
