+# stocked sheet (1250 x 2500 mm), `web_thick`/`flange_thick` hold the plate
+# thickness t, and `area` holds the nominal section width×t (display/base
+# weight chain). Real weight is computed from the user's L×W×t in the create
+# dialog (weight_per_m has no physical meaning for a user-defined plate).
+_PLATE_THICKNESSES: List[float] = [
+    3.0, 4.0, 5.0, 6.0, 8.0, 10.0, 12.0, 15.0,
+    20.0, 25.0, 30.0, 40.0, 50.0, 60.0, 80.0, 100.0,
+]
+_PLATE_DEFAULT_W = 1250.0   # mm — most common stocked sheet width
+_PLATE_DEFAULT_L = 2500.0   # mm — most common stocked sheet length
+
+
+def _plate_rows() -> List[Tuple[str, float, float, float, float, float, float, str]]:
+    """Build PL<n> rows (name, depth, width, thickness, area, ix, iy, kind)."""
+    rows = []
+    for t in _PLATE_THICKNESSES:
+        name = f'PL{t:g}'
+        rows.append((name, _PLATE_DEFAULT_L, _PLATE_DEFAULT_W, t,
+                     _PLATE_DEFAULT_W * t, 0.0, 0.0, 'B'))
+    return rows
+
+
+def _normalise(name: str) -> str:
+    """Canonical catalogue key: ``'IPE 300'`` / ``'ipe300'`` -> ``'IPE300'``."""
+    return ''.join(str(name or '').upper().replace(' ', '').replace('-', ''))
+
+
+def _ipe_profile(row) -> SteelProfile:
+    """Build an IPE (I-beam) profile from an ``_IPE_ROWS`` row."""
+    return SteelProfile(row[0], row[1], row[2], row[3], row[4],
+                        row[5], row[6], row[7], row[8], row[9], row[10],
+                        kind='I')
+
+
+def _section_profile(row, kind: str) -> SteelProfile:
+    """Build any rolled-section profile (I beam, U channel, L angle) from an
+    11-field ``_IPE_ROWS``-style row: (name, area, depth, width, ix, iy,
+    web_thick, flange_thick, root_radius, wpl_x, wpl_y)."""
+    return SteelProfile(row[0], row[1], row[2], row[3], row[4],
+                        row[5], row[6], row[7], row[8], row[9], row[10],
+                        kind=kind)
+
+
+def _tube_profile(row) -> SteelProfile:
+    """Build a tube profile from a ``_TUBE_ROWS`` row.
+
+    Row layout: (name, B/h mm, b mm, t mm, A mm², I_major cm⁴,
+                 I_minor cm⁴, kind). ``web_thick``/``flange_thick`` both hold
+                 the wall thickness t (tubes have one uniform wall), and
+                 ``root_radius`` is the reference outer corne radius (2.0t
+                 cold-formed) used by the 3D/2D builders later.
+    """
+    name, h, b, t, area, ix, iy, kind = row
+    radius = 2.0 * t  # EN 10219 cold-formed corner radius reference
+    return SteelProfile(name, area, h, b, ix, iy,
+                        web_thick=t, flange_thick=t, root_radius=radius,
+                        wpl_x=0.0, wpl_y=0.0, kind=kind)
+
+
+def _plate_profile(row) -> SteelProfile:
+    """Build a plate profile from a ``_plate_rows()`` tuple.
+
+    Row layout: (name, length mm, width mm, thickness mm, area mm², 0, 0, 'B').
+    Plates carry no bending section properties (ix/iy/wpl=0) and their weight
+    is computed from user dimensions -- see ``SteelProfile.weight_per_m``.
+    """
+    name, length, width, thickness, area, _ix, _iy, kind = row
+    return SteelProfile(name, area, length, width, 0.0, 0.0,
+                        web_thick=thickness, flange_thick=thickness,
+                        root_radius=0.0, wpl_x=0.0, wpl_y=0.0, kind=kind)
+
+
+def _round_bar_profile(row) -> SteelProfile:
+    """Build a round bar profile.
+
+    Row layout: (name, diameter mm, area mm², Ix cm⁴, Iy cm⁴,
+                 depth, width, 0, 0, 0).  Both web_thick and flange_thick
+    hold the diameter (solid round has no distinct web/flange).
+    """
+    name, d, area, ix, iy, depth, width, _r, _wplx, _wply = row
+    return SteelProfile(name, area, d, d, ix, iy,
+                        web_thick=d, flange_thick=d, root_radius=0.0,
+                        wpl_x=0.0, wpl_y=0.0, kind='O')
+
+
+def _flat_bar_profile(row) -> SteelProfile:
+    """Build a flat bar profile.
+
+    Row layout: (name, width mm, thickness mm, area mm², Ix cm⁴, Iy cm⁴,
+                 depth, width2, 0, 0, 0).  depth=width, width=thickness for
+    the profile system; web_thick=thickness, flange_thick=thickness.
+    """
+    name, w, t, area, ix, iy, depth, width2, _r, _wplx, _wply = row
+    return SteelProfile(name, area, w, t, ix, iy,
+                        web_thick=t, flange_thick=t, root_radius=0.0,
+                        wpl_x=0.0, wpl_y=0.0, kind='FB')
+
+
+# Normalised lookup key: uppercase, no spaces/hyphens -> "IPE300"
+# Registration order = iteration/UI order: IPE first (stable leading family),
+# then the Step-1 rolled families HEA/HEB/UPN/UPE/L, then tubes, plates last.
+_CATALOG: Dict[str, SteelProfile] = {}
+for _row in _IPE_ROWS:
+    _p = _ipe_profile(_row)
+    _CATALOG[_normalise(_p.name)] = _p
+for _rows, _kind in ((_HEA_ROWS, 'I'), (_HEB_ROWS, 'I'), (_HEM_ROWS, 'I'),
+                     (_UPN_ROWS, 'U'), (_UPE_ROWS, 'U'),
+                     (_L_ROWS, 'L')):
+    for _row in _rows:
+        _p = _section_profile(_row, _kind)
+        _CATALOG[_normalise(_p.name)] = _p
+for _row in _TUBE_ROWS:
+    _p = _tube_profile(_row)
+    _CATALOG[_normalise(_p.name)] = _p
+for _row in _ROUND_BAR_ROWS:
+    _p = _round_bar_profile(_row)
+    _CATALOG[_normalise(_p.name)] = _p
+for _row in _FLAT_BAR_ROWS:
+    _p = _flat_bar_profile(_row)
+    _CATALOG[_normalise(_p.name)] = _p
+for _row in _plate_rows():
+    _p = _plate_profile(_row)
+    _CATALOG[_normalise(_p.name)] = _p
+
+
+def has_profile(name: str) -> bool:
+    """True when the catalogue contains ``name`` (case/spacing tolerant)."""
+    return _normalise(name) in _CATALOG
+
+
+def get_profile(name: str) -> Optional[SteelProfile]:
+    """Profile by name; ``None`` when it is not in the catalogue.
+
+    Accepts ``'IPE300'``, ``'ipe 300'``, ``'IPE-300'`` — any casing/spacing.
+    """
+    return _CATALOG.get(_normalise(name))
+
+
+def iter_profiles() -> Iterator[SteelProfile]:
+    """Iterate catalogue entries in insertion (size-ascending) order."""
+    return iter(_CATALOG.values())
+
+
+def profile_names() -> List[str]:
+    """All catalogue names (``'IPE80'`` … ``'IPE750x137'``)."""
+    return [p.name for p in iter_profiles()]
+
+
+def catalogue_stats() -> dict:
+    """Summary used by the Steel Engine UI (count, per-family counts, ranges).
+
+    ``depth_range_mm`` and ``weight_range_kg_per_m`` are computed over the
+    *rolled* sections only (kind I/T/O) — plates are excluded because their
+    ``depth`` is really the sheet length (up to 2500 mm) and they have no
+    per-metre weight in the rolled sense (weight is dimension-driven).
+    """
+    entries = list(iter_profiles())
+    if not entries:
+        return {}
+    rolled = [p for p in entries if p.kind != 'B']
+    families: Dict[str, int] = {}
+    for p in entries:
+        families[p.kind] = families.get(p.kind, 0) + 1
+    stats: Dict[str, object] = {
+        'count': len(entries),
+        'families': families,
+        'first': entries[0].name,
+        'last': entries[-1].name,
+    }
+    if rolled:
+        stats['depth_range_mm'] = (
+            min(p.depth for p in rolled), max(p.depth for p in rolled))
+        stats['weight_range_kg_per_m'] = (
+            min(round(p.weight_per_m, 2) for p in rolled),
+            max(round(p.weight_per_m, 2) for p in rolled))
+    return stats
+
+
+# Human-readable family labels (kind letter -> short English key used by the
+# UI filter; keys stay stable for future families).
+_FAMILY_LABELS: Dict[str, str] = {
+    'I': 'I \u2014 Beam',
+    'T': 'T \u2014 Tube (square/rect)',
+    'O': 'O \u2014 Tube (Round)',
+    'B': 'B \u2014 Plate',
+    'U': 'U \u2014 Channel (UPN/UPE)',
+    'L': 'L \u2014 Angle',
+}
+
+
+def family_label(kind: str) -> str:
+    """Human-readable label for a DSTV family letter (defensive fallback)."""
+    return _FAMILY_LABELS.get(kind, kind or '?')
