+"""Export mixin for NCManagerApp — NC/CN/DXF/PDF/OBJ/STL export + save-edits dialog."""
+
+from __future__ import annotations
+
+import os
+
+from PySide6.QtWidgets import (
+    QButtonGroup,
+    QDialog,
+    QFileDialog,
+    QHBoxLayout,
+    QLabel,
+    QLineEdit,
