+        )
+        self._btn_cancel.clicked.connect(self.reject)
+        self._btn_ok = QPushButton(t('ok'))
+        self._btn_ok.setStyleSheet(
+            "QPushButton { background: #007acc; color: white; "
+            "padding: 6px 20px; border-radius: 3px; font-weight: bold; }"
+            "QPushButton:hover { background: #005f9e; }"
+        )
+        self._btn_ok.clicked.connect(self._on_ok)
+        btn_row.addWidget(self._btn_cancel)
+        btn_row.addWidget(self._btn_ok)
+        right.addLayout(btn_row)
+
+        root.addLayout(right, 1)
+
+    # ── Grid management ──────────────────────────────────────────
+
+    def _populate_grid(self, shapes):
+        """Fill the grid with ShapeButtons for the given shape list."""
+        # Clear existing
+        while self._grid_layout.count():
+            item = self._grid_layout.takeAt(0)
+            w = item.widget()
+            if w:
+                w.setParent(None)
+                w.deleteLater()
+        self._shape_buttons.clear()
+
+        cols = 3
+        for i, shape in enumerate(shapes):
+            btn = ShapeButton(shape)
+            btn.clicked.connect(self._select_shape)
+            self._grid_layout.addWidget(btn, i // cols, i % cols)
+            self._shape_buttons[shape.name] = btn
+        self._grid_layout.setColumnStretch(cols, 1)
+        self._grid_layout.setRowStretch((len(shapes) // cols) + 1, 1)
+
+    def _set_category(self, category: str):
+        """Filter shapes by category and re-populate the grid."""
+        self._current_category = category
+        self._apply_filter()
+
+    def _on_search_changed(self, text: str):
+        """Filter shapes by search text."""
+        self._apply_filter()
+
+    def _apply_filter(self):
+        """Apply both category and search filters to the shape grid."""
+        query = self._search_box.text().strip().lower()
+        filtered = shapes_by_category(self._current_category)
+        if query:
+            filtered = [s for s in filtered if query in s.name.lower()]
+        self._populate_grid(filtered)
+        # Auto-select first if current selection is hidden
+        if self._shape not in filtered and filtered:
+            self._select_shape(filtered[0].name)
+
+    # ── Shape selection ───────────────────────────────────────────
+
+    def _select_shape(self, name: str):
+        shape = get_shape(name)
+        if not shape:
+            return
+        self._shape = shape
+        self._params = shape.defaults()
+        self._name_edit.setText(shape.name)
+
+        # Rebuild param form
+        while self._params_form.rowCount():
+            self._params_form.removeRow(0)
+        self._param_spins.clear()
+
+        for sp in shape.parameters:
+            spin = QDoubleSpinBox()
+            spin.setRange(sp.min_val, sp.max_val)
+            spin.setValue(sp.default)
+            spin.setSingleStep(sp.step)
+            spin.setSuffix(f" {sp.unit}" if sp.unit else "")
+            spin.setDecimals(1)
+            spin.valueChanged.connect(self._on_param_changed)
+            self._param_spins[sp.key] = spin
+            self._params_form.addRow(f"{sp.name}:", spin)
+
+        self._refresh_preview()
+
+    def _on_param_changed(self):
+        for key, spin in self._param_spins.items():
+            self._params[key] = spin.value()
+        self._refresh_preview()
+
+    def _refresh_preview(self):
+        t = self._t
+        scale = getattr(self, '_scale_spin', None) and self._scale_spin.value() or 1.0
+        count_x = getattr(self, '_array_x_spin', None) and self._array_x_spin.value() or 1
+        count_y = getattr(self, '_array_y_spin', None) and self._array_y_spin.value() or 1
+        self._preview.set_shape(self._shape, self._params, scale=scale, count_x=count_x, count_y=count_y)
+        result = self._shape.generate_transformed(self._shape.validate(self._params),
+                                                  scale=scale, count_x=count_x, count_y=count_y)
+        n_outer = len(result.outer)
+        n_inners = len(result.inners)
+        n_holes = len(result.holes)
+        multi_info = f"  |  Array: {count_x}×{count_y} ({count_x*count_y} pcs)" if (count_x > 1 or count_y > 1) else ""
+        scale_info = f"  |  Scale: {scale:.1f}x" if scale != 1.0 else ""
+        self._status.setText(
+            f"{t('contour_pts').format(n=n_outer)}  |  "
+            f"{t('inner_contours').format(n=n_inners)}  |  "
+            f"{t('holes').format(n=n_holes)}"
+            f"{scale_info}{multi_info}"
+        )
+
+    # ── OK → emit ─────────────────────────────────────────────────
+
+    def _on_ok(self):
+        params = self._shape.validate(self._params)
+        thickness = self._thickness_spin.value()
+        steel_grade = self._steel_combo.currentText()
+        scale = self._scale_spin.value()
+        count_x = self._array_x_spin.value()
+        count_y = self._array_y_spin.value()
+        nc1 = generate_nc1(self._shape, params,
+                           order=self._name_edit.text(),
+                           quantity=self._qty_spin.value(),
+                           thickness=thickness,
+                           steel_grade=steel_grade,
+                           scale=scale,
+                           count_x=count_x,
+                           count_y=count_y)
+        geometry = shape_to_geometry(self._shape, params, thickness=thickness,
+                                     scale=scale, count_x=count_x, count_y=count_y)
+        self.part_created.emit({
+            'nc1_text': nc1,
+            'shape_name': self._shape.name,
+            'params': params,
+            'thickness': thickness,
+            'scale': scale,
+            'count_x': count_x,
+            'count_y': count_y,
+            'order': self._name_edit.text(),
+            'quantity': self._qty_spin.value(),
+            'steel_grade': steel_grade,
+            'geometry': geometry,
+        })
+        self.accept()
