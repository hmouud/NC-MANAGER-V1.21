diff --git a/tests/test_slot_affine_parity.py b/tests/test_slot_affine_parity.py
new file mode 100644
index 0000000..6db7d3b
--- /dev/null
+++ b/tests/test_slot_affine_parity.py
@@ -0,0 +1,142 @@
+"""Pinning tests for the angular-slot affine capsule convention.
+
+STEP 2 of the GRAND FUSION: the slot angle signs across the three slot
+representations are NOT a bug to 'unify' -- they are coordinate-space
+conventions that are visually consistent once the canvas y-flip and the
+180-degree symmetry of the stadium rim are accounted for.
+
+Convention pinned here (verified empirically on 2026-09-12):
+
+1. DSTV angular slot ``v x y d L angle`` keeps the angle in degrees in a
+   mathematical y-up space (0 = along +X, +90 = along +Y).
+
+2. The 2D canvas path (``_build_slot_path`` -> ``QTransform().rotate(-angle)``)
+   draws with y pointing DOWN, so ``-angle`` renders the DSTV ``+angle`` as the
+   same visual ray: on-canvas direction is ``(cos a, -sin a)``.
+
+3. The snap rim (``stadium_rim(x, y, d, overall, angle)``) is built in scene
+   space which is the DSTV space itself (y-up). Its wall direction is
+   ``(cos a, sin a)``; after the viewer's ``_to_screen`` y-flip it matches the
+   2D path direction exactly.
+
+4. The 3D plate slot (``part3d._slot_placements`` default branch) places the
+   rim in the world X-Y plane with axis ``(cos a, sin a, 0)``; the default
+   camera keeps world +Y = screen down, so the projected rim long-axis LINE
+   equals the 2D line modulo 180 degrees (the stadium is symmetric under a
+   180-degree rotation, so the end-cap swap is unobservable).
+
+Any future change that flips one of these signs will break one of these three
+tests -- that is the point. If the DSTV angle convention ever changes, change
+THIS file and the two renderers together, never one in isolation.
+"""
+
+import math
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'src'))
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+
+from PySide6.QtGui import QTransform
+from PySide6.QtWidgets import QApplication
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.design.snaps import stadium_rim
+from nccorrection.ui.qt_viewer_3d import NcViewer3D
+
+
+PLATE_45 = (
+    'ST\n  B\n  1\n  1\n  P\n  P\n  S235JR\n  1\n  PL10\n'
+    '  1000.00\n  200.00\n  10.00\n'
+    'BO\n  v  40.00 50.00 20.00 100.00 45.00\n'
+    'AK\n  v  0.00 0.00 0.00 1000.00 0.00 0.00 1000.00 200.00 0.00'
+    ' 0.00 200.00 0.00\nEN\n'
+)
+
+
+def _line_angle_deg(dx, dy):
+    """Line orientation mod 180, normalized to (-90, 90]."""
+    a = math.degrees(math.atan2(dy, dx)) % 180.0
+    return a - 180.0 if a > 90.0 else a
+
+
+class TestSlotAffineConvention(unittest.TestCase):
+
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    # ----------------------------------------------------------- 2D path
+    def test_canvas_path_visual_direction_is_cos_sin_minus(self):
+        """rotate(-angle) in canvas y-down maps the long axis to (cos, -sin)."""
+        for ang in (0.0, 45.0, 90.0, 135.0):
+            t = QTransform()
+            t.rotate(-ang)
+            px, py = t.map(1.0, 0.0)
+            self.assertAlmostEqual(px, math.cos(math.radians(ang)), delta=1e-6,
+                                   msg='angle %f: canvas x' % ang)
+            self.assertAlmostEqual(py, -math.sin(math.radians(ang)), delta=1e-6,
+                                   msg='angle %f: canvas y' % ang)
+
+    # ----------------------------------------------------------- 2D path
+    def test_snap_rim_matches_path_after_screen_y_flip(self):
+        """stadium_rim is y-up scene space; viewer y-flip makes it identical
+        to the 2D path direction."""
+        for ang in (0.0, 30.0, 45.0, 90.0, 135.0):
+            segs, _arcs = stadium_rim(0.0, 0.0, 20.0, 120.0, ang)
+            x1, y1 = segs[0][0]
+            x2, y2 = segs[0][1]
+            dx, dy = x2 - x1, y2 - y1
+            # scene direction (y-up)
+            self.assertAlmostEqual(
+                _line_angle_deg(dx, dy), _line_angle_deg(math.cos(math.radians(ang)),
+                                                         math.sin(math.radians(ang))),
+                delta=1e-6)
+            # 2D canvas direction for the same DSTV angle
+            t = QTransform()
+            t.rotate(-ang)
+            px, py = t.map(1.0, 0.0)
+            # the viewer _to_screen flip turns scene (x, y) into canvas (x, -y)
+            self.assertAlmostEqual(
+                _line_angle_deg(dx, -dy), _line_angle_deg(px, py), delta=1e-6)
+
+    # ------------------------------------------------------- 3D projection
+    def test_3d_plate_rim_matches_2d_visual_line(self):
+        """The 3D projected rim long-axis LINE equals the 2D line modulo 180."""
+        def projected_long_axis_angle(angle_deg):
+            text = PLATE_45.replace('45.00', '%.2f' % angle_deg)
+            g = parse_geometry(text)
+            w = NcViewer3D()
+            w.resize(800, 600)
+            w.set_geometry_object(g)
+            rim = w._slot_rims.get(0)
+            self.assertIsNotNone(rim)
+            proj = [w._project(pt) for pt in rim]
+            best = (0.0, None, None)
+            n = len(proj)
+            for i in range(n):
+                for j in range(i + 1, n):
+                    d2 = ((proj[i][0] - proj[j][0]) ** 2
+                          + (proj[i][1] - proj[j][1]) ** 2)
+                    if d2 > best[0]:
+                        best = (d2, proj[i], proj[j])
+            _, a, b = best
+            return _line_angle_deg(b[0] - a[0], b[1] - a[1])
+
+        for ang in (30.0, 45.0, 60.0):
+            t = QTransform()
+            t.rotate(-ang)
+            px, py = t.map(1.0, 0.0)
+            two_d = _line_angle_deg(px, py)
+            three_d = projected_long_axis_angle(ang)
+            # tolerance 0.01 deg: the 3D rim is a ~16-segment polyline, so the
+            # longest-diameter-on-vertices measurement carries sub-milli-degree
+            # polygon noise (measured 0.0012 deg at 30 deg). A true sign flip
+            # would show a ~90 deg delta, far above this tolerance.
+            self.assertAlmostEqual(two_d, three_d, delta=0.01,
+                                   msg='angle %f: 2D=%f 3D=%f' % (ang, two_d, three_d))
+
+
+if __name__ == '__main__':
+    unittest.main()
