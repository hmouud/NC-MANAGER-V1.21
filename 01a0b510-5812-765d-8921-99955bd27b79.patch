+0
+EOF
+"""
+
+
+def _tmp(text: str, suffix: str) -> str:
+    fd, path = tempfile.mkstemp(suffix=suffix, prefix='fmt_demo_')
+    with os.fdopen(fd, 'w', encoding='latin-1') as fh:
+        fh.write(text)
+    return path
+
+
+def main():
+    nc1 = _tmp(NC1_PLATE, '.nc1')
+    dxf = _tmp(DXF_SAMPLE, '.dxf')
+    try:
+        for path in (nc1, dxf):
+            report = analyze_file(path)
+            print(json.dumps(report.to_dict(), indent=2, ensure_ascii=False))
+            print('-' * 60)
+    finally:
+        os.remove(nc1)
+        os.remove(dxf)
+
+
+if __name__ == '__main__':
+    main()
