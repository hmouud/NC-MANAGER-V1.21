+        st = geometry.get('st') or {}
+        st_type = (st.get('type') or 'B').upper()
+        dims = st.get('dims') or []
+        thickness = float(st.get('thickness') or 10.0)
+        try:
+            from nccorrection.core.part3d import _contour_length
+            length = dims[0] if dims and dims[0] else _contour_length(geometry)
+        except Exception as e:
+            print(f'[qt_viewer_3d.contour_length] {repr(e)}', file=sys.stderr)
+            length = 0.0
+        placements = indexed_hole_placements(geometry, st_type, dims, length, thickness)
+        self._hole_refs = [(c, n, r, idx) for c, n, r, idx in placements]
+        self._slot_rims = {}
+        try:
+            from nccorrection.core.part3d import slot_rims
+            self._slot_rims = dict(slot_rims(geometry, st_type, dims, thickness))
+        except Exception as e:
+            print(f'[qt_viewer_3d.slot_rims] {repr(e)}', file=sys.stderr)
+            self._slot_rims = {}
+        # Unfolded render copies (Folded View): the model + hole/slot geometry
+        # as built from the flat DSTV pattern. Toggling the fold rebuilds the
+        # render objects from these without re-parsing the DSTV text.
+        self._model_unfolded = self._model
+        self._slot_rims_unfolded = dict(self._slot_rims)
+        self._hole_refs_unfolded = list(self._hole_refs)
+        self._holes3d_unfolded = list(self._holes3d)
+        self._apply_fold()
+        self._hovered_hole = None
+        self._recompute_bounds()
+        if fit:
+            self.fit_view()
+        else:
+            self.update()
+
+    def clear_geometry(self):
+        self._stop_inertia()
+        self._pivot_mode = False
+        self._pivot_cursor_pt = None
+        self._geometry = None
+        self._model = []
+        self._holes3d = []
+        self._m1 = self._m2 = None
+        self._measurements3d = []
+        self._slot_rims = {}
+        self._cuts_cache = []
+        self._model_unfolded = []
+        self._slot_rims_unfolded = {}
+        self._hole_refs_unfolded = []
+        self._holes3d_unfolded = []
+        self.set_spin(0)
+        self.update()
+
+    def set_fold_state(self, state):
+        """Apply the shared Folded View state (see app context menu).
+
+        'fold' rebuilds the 3D model / slot rims / hole references from the
+        stored unfolded render copies (plates only), 'show_line' has no 3D
+        effect (the bend line is a flat-pattern annotation).
+        """
+        new = dict(state or self._fold_state)
+        if new.get('fold') == self._fold_state.get('fold'):
+            self._fold_state = new
+            self.update()
+            return
+        self._fold_state = new
+        self._apply_fold()
+        self._recompute_bounds()
+        self.fit_view()
+
+    def _apply_fold(self):
+        """Physically rotate the plate flap(s) around their DSTV KA bend lines
+        (exact rigid 3D rotation, +Z lift -- see core/fold.py). Non-plate
+        parts (or plates without bend lines) keep the flat extruded model."""
+        bends = (self._geometry or {}).get('bends') or []
+        st = (self._geometry or {}).get('st') or {}
+        st_type = (st.get('type') or 'B').upper()
+        if (not self._fold_state.get('fold') or not bends
+                or st_type != 'B'):
+            self._model = self._model_unfolded
+            self._slot_rims = dict(self._slot_rims_unfolded)
+            self._hole_refs = list(self._hole_refs_unfolded)
+            self._holes3d = list(self._holes3d_unfolded)
+            return
+        try:
+            from nccorrection.core.fold import (fold_mesh_vertices,
+                                                fold_face_parts,
+                                                face_normal)
+            model = []
+            for fac in self._model_unfolded:
+                # Faces that straddle a bend line cannot rotate rigidly (the
+                # skewed-triangle artefact); split each face at every bend
+                # boundary first so every sub-face stays planar -- the same
+                # dominant-axis rule the 2D/3D fold uses (core/fold.py).
+                for part in fold_face_parts(bends, fac['pts']):
+                    fac2 = dict(fac)
+                    fac2['pts'] = part
+                    fac2['normal'] = face_normal(part)
+                    model.append(fac2)
+            self._model = model
+            rims = {}
+            for k, pts in self._slot_rims_unfolded.items():
+                folded = []
+                for pt in pts:
+                    if len(pt) >= 3:
+                        folded.append(fold_mesh_vertices(bends, [pt])[0])
+                    else:
+                        fx, fy = fold_points_2d(bends, [(pt[0], pt[1])])[0]
+                        folded.append((fx, fy))
+                rims[k] = folded
+            self._slot_rims = rims
+            self._hole_refs = []
+            for c, n, r, idx in self._hole_refs_unfolded:
+                self._hole_refs.append(
+                    (fold_mesh_vertices(bends, [c])[0], n, r, idx))
+            self._holes3d = []
+            for (cx, cy, cz), r in self._holes3d_unfolded:
+                self._holes3d.append(
+                    (fold_mesh_vertices(bends, [(cx, cy, cz)])[0], r))
+        except Exception as e:
+            print(f'[qt_viewer_3d.fold] {repr(e)}', file=sys.stderr)
+            self._model = self._model_unfolded
+            self._slot_rims = dict(self._slot_rims_unfolded)
+            self._hole_refs = list(self._hole_refs_unfolded)
+            self._holes3d = list(self._holes3d_unfolded)
+
+    def has_geometry(self):
+        return bool(self._model)
+
+    def bounds(self):
+        return self._bounds
+
+    def _recompute_bounds(self):
+        xs, ys, zs = [], [], []
+        for fac in self._model:
+            for p in fac['pts']:
+                xs.append(p[0]); ys.append(p[1]); zs.append(p[2])
+        if not xs:
+            self._bounds = None
+            self._center = (0.0, 0.0, 0.0)
+            return
+        self._bounds = (min(xs), min(ys), max(xs), max(ys))
+        self._zmin, self._zmax = min(zs), max(zs)
+        self._center = ((min(xs) + max(xs)) / 2.0,
+                        (min(ys) + max(ys)) / 2.0,
+                        (min(zs) + max(zs)) / 2.0)
+
+    def fit_view(self):
+        self._recompute_bounds()
+        self._pan_ox = 0.0
+        self._pan_oy = 0.0
+        self._zoom = 1.0
+        self.update()
+
+    # ---------------------------------------------------------------- modes
+    def set_mode(self, mode):
+        self.mode = mode
+        if mode != 'measure':
+            self._m1 = self._m2 = None
+            self._measurements3d = []
+            self._corner_pts = []
+            self._measure_pt = None
+            self._hover_kind = None
+            self.measure_result.emit('')
+        self.setCursor(Qt.CrossCursor if mode == 'measure' else Qt.ArrowCursor)
+        self.update()
+
+    def set_corner_mode(self, on):
+        """Corner-angle measure: 3D click a point, the vertex, a point on the
+        other edge; the tool reports the corner angle (<= 90 / > 90)."""
+        self._corner_mode = bool(on)
+        self._corner_pts = []
+        self.update()
+
+    def set_preset(self, name):
+        self._stop_inertia()
+        self._pivot_mode = False
+        self._pivot_cursor_pt = None
+        if name == 'top':
+            self._R = _rot_matrix(0.0, 0.01)
+        elif name == 'front':
+            self._R = _rot_matrix(0.0, math.pi / 2 - 0.02)
+        elif name == 'right':
+            self._R = _rot_matrix(-math.pi / 2, math.pi / 2 - 0.02)
+        elif name == 'iso':
+            self._R = _rot_matrix(0.7854, 0.6155)
+        self._pan_ox = self._pan_oy = 0.0
+        self.update()
+
+    def _arcball_delta(self, cur, prev):
+        """Rotation (axis, angle) for a drag step using a virtual trackball.
+
+        Drags map to rotations around the screen-space axes, so the part can
+        orbit in any direction, over the top and around, without ever hitting
+        a clamp or flipping.
+        """
+        w, h = self.width(), self.height()
+        rad = 0.5 * min(w, h)
+        if rad <= 1.0:
+            return None
+        cx, cy = w / 2.0, h / 2.0
+
+        def sphere(pt):
+            x = (pt.x() - cx) / rad
+            y = -(pt.y() - cy) / rad
+            d2 = x * x + y * y
+            if d2 > 1.0:
+                n = math.sqrt(d2)
+                return (x / n, y / n, 0.0)
+            return (x, y, math.sqrt(1.0 - d2))
+
+        a = sphere(prev)
+        b = sphere(cur)
+        axis = _cross(a, b)
+        al = math.sqrt(axis[0] ** 2 + axis[1] ** 2 + axis[2] ** 2)
+        if al < 1e-9:
+            return None
+        dot = max(-1.0, min(1.0, a[0] * b[0] + a[1] * b[1] + a[2] * b[2]))
+        return (axis[0] / al, axis[1] / al, axis[2] / al), math.acos(dot)
+
+    # ---------------------------------------------------------------- project
+    def _origin(self):
+        return self._pivot if self._pivot is not None else self._center
+
+    def _project_xyz(self, x, y, z):
+        ox, oy, oz = self._origin()
+        R = self._R
+        x1, y1, z1 = _mapply(R, (x - ox, y - oy, z - oz))
+        sx = self._ox + self._pan_ox + x1 * self._scale * self._zoom
+        sy = self._oy + self._pan_oy - y1 * self._scale * self._zoom
+        return sx, sy
+
+    def _project(self, p):
+        return self._project_xyz(p[0], p[1], p[2])
+
+    def _unproject(self, sx, sy, normal, point):
+        R = self._R
+        Rt = _mtranspose(R)
+        ox, oy, oz = self._origin()
+        x1 = (sx - self._ox - self._pan_ox) / (self._scale * self._zoom)
+        y1 = (self._oy + self._pan_oy - sy) / (self._scale * self._zoom)
+        n3 = _mapply(R, normal)
+        q3 = _mapply(R, (point[0] - ox, point[1] - oy, point[2] - oz))
+        if abs(n3[2]) < 1e-9:
+            return None
+        z2 = (n3[0] * q3[0] + n3[1] * q3[1] + n3[2] * q3[2]
+              - n3[0] * x1 - n3[1] * y1) / n3[2]
+        p3 = _mapply(Rt, (x1, y1, z2))
+        return (p3[0] + ox, p3[1] + oy, p3[2] + oz)
+
+    def _pick_facet(self, pos):
+        """Return ((x, y, z), outward_normal) of the nearest face facet under
+        the cursor (or None).
+
+        Same hit-test as ``_pick`` but also returns the facet's outward
+        normal -- it tells which DSTV surface (v/h/o/u) the user is looking
+        at, so the picked point can be mapped back to face coordinates.
+        """
+        R = self._R
+        best, best_z, best_n = None, None, None
+        for fac in self._model:
+            if fac.get('is_hole'):
+                continue
+            poly = QPolygonF([QPointF(*self._project(p)) for p in fac['pts']])
+            if not poly.containsPoint(QPointF(pos.x(), pos.y()), Qt.OddEvenFill):
+                continue
+            p = self._unproject(pos.x(), pos.y(), fac['normal'], fac['pts'][0])
+            if p is None:
+                continue
+            # depth along view axis for the returned point
+            p3 = _mapply(R, p)
+            if best_z is None or p3[2] < best_z:
+                best_z = p3[2]
+                best = (p, fac['normal'])
+        return best
+
+    def _pick(self, pos):
+        """Return nearest 3D point under the cursor (or None)."""
+        hit = self._pick_facet(pos)
+        return hit[0] if hit is not None else None
+
+    # --------------------------------------------------- DSTV face mapping
+    _DSTV_TOL = 1.0  # mm containment slack around the face extents
+
+    def _dstv_length(self):
+        """Part length in DSTV x (dims[0], contour length as a fallback)."""
+        st = (self._geometry or {}).get('st') or {}
+        dims = st.get('dims') or []
+        if dims and dims[0]:
+            return float(dims[0])
+        try:
+            from nccorrection.core.part3d import _contour_length
+            return float(_contour_length(self._geometry or {}))
+        except Exception:
+            return 0.0
+
+    def _face_extent(self, st_type, dims, thickness, face):
+        """(x0, x1, y0, y1) DSTV extents of a real face of the section.
+
+        x runs the part length; y runs the face width from the profile dims
+        (web height H / flange breadth b / leg a-b / plate width), exactly
+        like the frames in ``core.face_planes``.
+        """
+        length = self._dstv_length()
+        t = (st_type or '').upper()
+        if t == 'I':
+            H = float(dims[1]) if len(dims) > 1 and dims[1] else 300.0
+            b = float(dims[2]) if len(dims) > 2 and dims[2] else 150.0
+            return 0.0, length, 0.0, (H if face in ('v', 'h') else b)
+        if t in ('C', 'U'):
+            H = float(dims[1]) if len(dims) > 1 and dims[1] else 300.0
+            b = float(dims[2]) if len(dims) > 2 and dims[2] else 100.0
+            return 0.0, length, 0.0, (H if face in ('v', 'h') else b)
+        if t == 'L':
+            b = float(dims[2]) if len(dims) > 2 and dims[2] else 50.0
+            a = float(dims[1]) if len(dims) > 1 and dims[1] else 50.0
+            return 0.0, length, 0.0, (b if face == 'v' else a)
+        w = float(dims[1]) if len(dims) > 1 and dims[1] else thickness
+        return 0.0, length, 0.0, max(w, float(thickness or 0.0))
+
+    def pick_dstv(self, pos):
+        """Map the picked surface point to DSTV (face, x, y) - or None.
+
+        The picked 3D point is projected orthogonally onto every real DSTV
+        face via the frames of ``core.face_planes`` (single source of truth
+        for the v/h/o/u planes). The face is chosen by how the point sits
+        against each frame plane, never by the model facet normals (the
+        prism caps carry reversed windings):
+
+        * prism families (I/C/U/L) keep the frames on the web/cap mid-planes
+          (v and h share one plane): the face whose plane the point is
+          nearest wins, ties going to the +d side (front web = v, back = h);
+        * flat parts keep the frames on the two outer surfaces: the +d side
+          IS the visible side (v = top, h = bottom).
+
+        Returns None on empty space / outside every face -- callers fall
+        back to the part centre.
+        """
+        st = (self._geometry or {}).get('st') or {}
+        st_type = (st.get('type') or 'B').upper()
+        dims = st.get('dims') or []
+        thickness = float(st.get('thickness') or 10.0)
+        length = self._dstv_length()
+        hit = self._pick_facet(pos)
+        if hit is None:
+            return None
+        pt3, _nrm = hit
+        t = (st_type or '').upper()
+        flat = t not in ('I', 'C', 'U', 'L')
+        best, best_key = None, None
+        for face in real_faces(st_type):
+            fr = frame(st_type, dims, length, thickness, face)
+            x, y = fr.from_3d(pt3)
+            x0, x1, y0, y1 = self._face_extent(st_type, dims, thickness, face)
+            if not (x0 - self._DSTV_TOL <= x <= x1 + self._DSTV_TOL and
+                    y0 - self._DSTV_TOL <= y <= y1 + self._DSTV_TOL):
+                continue
+            d = ((pt3[0] - fr.anchor[0]) * fr.normal[0]
+                 + (pt3[1] - fr.anchor[1]) * fr.normal[1]
+                 + (pt3[2] - fr.anchor[2]) * fr.normal[2])
+            key = (-d, 0.0) if flat else (abs(d), -d)
+            if best_key is None or key < best_key:
+                best_key, best = key, (face, float(x), float(y))
+        return best
+
+    def center_dstv(self):
+        """(face, x, y) at the part centre on the front face.
+
+        Fallback for Add Hole/Slot when a 3D/blueprint click lands in empty
+        space (CTO: centre of the part, face v).
+        """
+        st = (self._geometry or {}).get('st') or {}
+        st_type = (st.get('type') or 'B').upper()
+        dims = st.get('dims') or []
+        thickness = float(st.get('thickness') or 10.0)
+        x0, x1, y0, y1 = self._face_extent(st_type, dims, thickness, 'v')
+        return 'v', (x0 + x1) / 2.0, (y0 + y1) / 2.0
+
+    def _pick_plane(self, sx, sy):
+        """Pick a 3D point on the horizontal plane at the part center height."""
+        c = self._center
+        return self._unproject(sx, sy, (0.0, 0.0, 1.0), (c[0], c[1], c[2]))
+
+    def _snap_hole(self, pos, tol=14.0):
+        best, best_d = None, None
+        for c, r in self._holes3d:
+            sx, sy = self._project(c)
+            d = math.hypot(sx - pos.x(), sy - pos.y())
+            if d < tol and (best_d is None or d < best_d):
+                best_d = d
+                best = (c, r)
+        return best
+
+    def _snap_detail(self, pos):
+        """Best snap near ``pos`` as (3D_point, kind) via the design engine.
+
+        Hole circles and every visible face's vertices/edges are projected to
+        screen space, resolved with the shared snap engine, then the winning
+        screen point is unprojected back onto its face plane for a true 3D hit.
+        """
+        enabled, tol, exact_band = self.snap_config()
+        best, best_d, best_k = None, None, None
+        snap = self._snap_hole(pos, tol)
+        if snap:
+            c, r = snap
+            sx, sy = self._project(c)
+            best_d = math.hypot(sx - pos.x(), sy - pos.y())
+            best = c
+            best_k = 'centre'
+        for fac in self._model:
+            if fac.get('is_hole'):
+                continue
+            pts = [self._project(p) for p in fac['pts']]
+            if not pts:
+                continue
+            n = len(pts)
+            targets = SnapTargets(
+                points=pts,
+                segments=[(pts[i], pts[(i + 1) % n]) for i in range(n)],
+            )
+            res = resolve_snap(targets, (pos.x(), pos.y()), enabled=enabled,
+                               tol=tol, exact_band=exact_band)
+            if not res:
+                continue
+            spt, kind, d = res
+            p3 = self._unproject(spt[0], spt[1], fac['normal'], fac['pts'][0])
+            if p3 is None:
+                continue
+            if best_d is None or d < best_d:
+                best_d, best, best_k = d, p3, kind
+        return best, best_k
+
+    def _hit_hole(self, pos):
+        best, best_d = None, None
+        for c, _n, r, idx in self._hole_refs:
+            sx, sy = self._project(c)
+            d = math.hypot(sx - pos.x(), sy - pos.y())
+            if d <= max(r * self._scale * self._zoom + 3, 8) and \
+                    (best_d is None or d < best_d):
+                best_d = d
+                best = idx
+        return best
+
+    def hole_at(self, pos):
+        """Public row-index hit-test (3D): nearest hole centre on screen."""
+        return self._hit_hole(pos)
+
+    # ---------------------------------------------------------------- paint
+    def paintEvent(self, event):
+        self._paint_impl(event)
+
+    # ---------------------------------------------------------------- events
+    def wheelEvent(self, event):
+        # AutoCAD-style adaptive zoom: coarse while zoomed out, fine when deep.
+        z = self._zoom
+        if z < 8.0:
+            step = 0.12
+        elif z < 40.0:
+            step = 0.06
+        else:
+            step = 0.02
+        factor = 1.0 + step if event.angleDelta().y() > 0 else 1.0 - step
+        pos = event.position()
+        # anchor: prefer the actual surface point under the cursor
+        anchor = self._pick(pos)
+        if anchor is None:
+            anchor = self._pick_plane(pos.x(), pos.y())
+        self._zoom = max(0.02, min(self._zoom * factor, 200.0))
+        if anchor:
+            sx, sy = self._project(anchor)
+            self._pan_ox += pos.x() - sx
+            self._pan_oy += pos.y() - sy
+        self.update()
+        event.accept()
+
+    def mousePressEvent(self, event):
+        event.accept()
+        self._stop_inertia()  # any new interaction cancels a running fling
+        if self._pivot_mode and event.button() == Qt.LeftButton:
+            # left click confirms the ghost point -> orbit pivot placed
+            self._pivot = self._pivot_cursor_pt if self._pivot_cursor_pt is not None else self._center
+            self._pivot_mode = False
+            self._pivot_cursor_pt = None
+            px, py, pz = self._pivot
+            self.pivot_changed.emit(f'Pivot X={px:.0f} Y={py:.0f} Z={pz:.0f}')
+            self.setCursor(Qt.CrossCursor if self.mode == 'measure' else Qt.ArrowCursor)
+            self.update()
+            return
+        if event.button() == Qt.MiddleButton:
+            self._pan_drag = True
+            self._drag_pos = event.position()
+            self.setCursor(Qt.ClosedHandCursor)
+            return
+        if self.mode == 'measure' and event.button() == Qt.RightButton:
+            # FIRST right-click interrupts the measurement in progress (no
+            # menu). A second right-click (nothing pending) falls through to
+            # the app's full context menu: Refresh on top (delete all
+            # measurements + exit measure) + all the other settings.
+            if self._m1 is not None or self._corner_pts:
+                self._measure_cancel()
+                return
+        if event.button() == Qt.LeftButton:
+            if self.mode == 'measure':
+                # drag an existing measurement label to a corner (Tekla-style)
+                for i, (a, bpt, off, dim_off) in enumerate(self._measurements3d):
+                    if self._3d_label_rect(a, bpt, off, dim_off)[0].contains(event.position()):
+                        self._label_drag = i
+                        self._drag_pos = event.position()
+                        return
+                # press ON the dimension line itself -> parallel drag
+                # (Tekla/AutoCAD style: the whole dimension moves, keeping the
+                # measured points and value; long extension lines appear)
+                hit = self._measure_line_at(event.position())
+                if hit is not None:
+                    self._dim_drag = hit
+                    self._drag_pos = event.position()
+                    return
+                pt, _kind = self._snap_detail(event.position())
+                if pt is None:
+                    # pick strictly on the part surface so measurements never
+                    # float far away from the profile
+                    pt = self._pick(event.position())
+                if pt is None:
+                    # started on empty space far from the part: ignore the click
+                    return
+                if self._corner_mode:
+                    self._corner_pts.append(pt)
+                    if len(self._corner_pts) == 3:
+                        a, vertex, b = self._corner_pts
+                        ang = corner_angle(a, vertex, b)
+                        self._corner_measures3d.append((a, vertex, b, ang))
+                        self.measure_result.emit(corner_label(ang))
+                        self._corner_pts = []
+                    self._cursor = event.position()
+                    self.update()
+                    return
+                if self._m1 is None:
+                    self._m1 = pt
+                    self._m2 = None
+                else:
+                    self._m2 = pt
+                    self._measurements3d.append((self._m1, self._m2,
+                                                 (0.0, 0.0), 0.0))
+                    dist = math.dist(self._m1, self._m2)
+                    self.measure_result.emit(f'{dist:.1f} mm')
+                    self._m1 = None
+                    self._m2 = None
+                self._cursor = event.position()
+                self.update()
+                return
+            # Target-based orbit: the pivot is a deliberate user action (Ctrl+R),
+            # NOT a side-effect of a left press, so a single click or a
+            # double-click (hole editing) never re-anchors the orbit. Rotation
+            # drags simply orbit around the current pivot/centre.
+            self._rotate_drag = True
+            self._drag_pos = event.position()
+            self.setCursor(Qt.ClosedHandCursor)
+            return
+        super().mousePressEvent(event)
+
+    def mouseMoveEvent(self, event):
+        event.accept()
+        # Track the cursor continuously so Ctrl+R can raycast a pivot at the
+        # last position even when the mouse was never pressed.
+        self._last_mouse_pos = event.position()
+        if self._label_drag is not None and self._drag_pos is not None:
+            d = event.position() - self._drag_pos
+            self._drag_pos = event.position()
+            i = self._label_drag
+            a, bpt, off, dim_off = self._measurements3d[i]
+            self._measurements3d[i] = (a, bpt, (off[0] + d.x(), off[1] + d.y()),
+                                       dim_off)
+            self.update()
+        if self._dim_drag is not None and self._drag_pos is not None:
+            # parallel move: only the perpendicular component of the cursor
+            # delta is applied to the dimension line (Tekla/AutoCAD style)
+            d = event.position() - self._drag_pos
+            self._drag_pos = event.position()
+            i = self._dim_drag
+            a, bpt, off, dim_off = self._measurements3d[i]
+            g = self._measure_line_geometry(i)
+            if g is not None:
+                perp = g[4]
+                self._measurements3d[i] = (a, bpt, off,
+                                           dim_off + d.x() * perp.x()
+                                           + d.y() * perp.y())
+            self.update()
+        hover = None
+        for c, _n, r, idx in self._hole_refs:
+            sx, sy = self._project(c)
+            if idx is None:
+                continue
+            if math.hypot(sx - event.position().x(), sy - event.position().y()) <= max(r * self._scale * self._zoom + 2, 6):
+                hover = idx
+                break
+        if hover != self._hovered_hole:
+            self._hovered_hole = hover
+            self.update()
+        if self._pivot_mode:
+            # ghost pivot tracks the cursor (hole centre -> surface -> centre)
+            self._pivot_cursor_pt = self._pivot_ghost_at(event.position())
+            self.update()
+        if self.mode == 'measure':
+            self._cursor = event.position()
+            self._measure_pt, self._hover_kind = self._snap_detail(event.position())
+            self.update()
+        else:
+            # face-name tooltip (letters mode): hovering a face badge shows
+            # the full blueprint face name
+            from PySide6.QtWidgets import QToolTip
+            if self._face_labels == 'letters' and self._badge_pts:
+                hit = None
+                for (sx, sy), letter, full in self._badge_pts:
+                    if math.hypot(sx - event.position().x(),
+                                  sy - event.position().y()) <= 12.0:
+                        hit = full
+                        break
+                if hit:
+                    QToolTip.showText(self.mapToGlobal(
+                        event.position().toPoint()), hit, self)
+                else:
+                    QToolTip.hideText()
+            else:
+                QToolTip.hideText()
+        if self._pan_drag:
+            dx = event.position().x() - self._drag_pos.x()
+            dy = event.position().y() - self._drag_pos.y()
+            self._drag_pos = event.position()
+            self._pan_ox += dx
+            self._pan_oy += dy
+            self.update()
+        elif self._rotate_drag:
+            d = self._arcball_delta(event.position(), self._drag_pos)
+            if d is not None:
+                axis, angle = d
+                self._inertia_axis = axis
+                self._inertia_angle = min(angle, self.INERTIA_MAX)
+                self._R = _mmul(_axis_angle_matrix(axis, -angle), self._R)
+            self._drag_pos = event.position()
+            self.update()
+        super().mouseMoveEvent(event)
+
+    def mouseReleaseEvent(self, event):
+        event.accept()
+        if event.button() == Qt.LeftButton:
+            self._label_drag = None
+            self._dim_drag = None
+        if event.button() in (Qt.LeftButton, Qt.MiddleButton):
+            if self._rotate_drag and event.button() == Qt.LeftButton:
+                self._start_inertia()
+            self._pan_drag = False
+            self._rotate_drag = False
+            self._drag_pos = None
+            self.setCursor(Qt.CrossCursor if self.mode == 'measure' else Qt.ArrowCursor)
+        super().mouseReleaseEvent(event)
+
+    def mouseDoubleClickEvent(self, event):
+        """Edit a hole only on a deliberate double-click.
+
+        A single left click must stay free for selection / rotation (a single
+        press inside a hole no longer opens the property editor). In measure
+        mode double-clicks keep placing measurement points.
+        """
+        event.accept()
+        if event.button() == Qt.LeftButton and self.mode != 'measure':
+            idx = self._hit_hole(event.position())
+            if idx is not None:
+                self.hole_clicked.emit(idx)
+                return
+        super().mouseDoubleClickEvent(event)
