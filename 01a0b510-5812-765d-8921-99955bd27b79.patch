+    def test_contour_closure(self):
+        v = self.part.get_face('v')
+        pts = v.outer_contour.points
+        self.assertEqual(pts[0], (0.0, 0.0))
+        self.assertEqual(pts[-1], (0.0, 190.0))
+        # closing segment back to the first vertex exists in the polyline
+        poly = polyline_for_vertices(
+            [(x, y, 0.0) for x, y in v.outer_contour.points])
+        self.assertEqual(poly[0], poly[-1])
+
+    def test_suffix_stripping(self):
