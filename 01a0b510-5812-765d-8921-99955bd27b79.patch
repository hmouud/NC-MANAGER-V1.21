+"""3D isometric DSTV viewer (adapter over the shared 3D core).
+
+Historically this widget duplicated the whole 3D pipeline (its own Euler
+rotation matrix, projection, events). Under the consolidation directive the
+rendering core lives in exactly one place - :class:`NcViewer3D` (arcball
+rotation, target-based orbit/TRT pivot, raycaster, measure + OSNAP glyphs,
+palette-driven colours) - and :class:`DstvRenderer3D` is a thin adapter that
+feeds the *raw NC1 text* of a parsed DSTV part (``part.raw_lines``) into that
+core. There is no duplicated 3D math in this module.
+"""
+
+from nccorrection.ui.qt_viewer_3d import NcViewer3D
+
+
+class DstvRenderer3D(NcViewer3D):
+    """Backward-compatible wrapper that accepts a parsed ``DstvPart``.
+
+    ``set_part`` round-trips the part through its original NC1 text so the
+    shared core re-parses the very same DSTV data (identical faces, holes and
+    profile dimensions) - no second geometry model is kept in sync.
+    """
+
+    def set_part(self, part):
+        """Display a parsed DSTV part (any object exposing ``raw_lines``)."""
+        text = '\n'.join(part.raw_lines or [])
+        self.set_geometry(text)
+
+    def clear(self):
+        self.clear_geometry()
+
+
+__all__ = ['DstvRenderer3D']
