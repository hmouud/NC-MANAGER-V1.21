+"""DSTV NC1 face data model: all geometry for ONE face of the part."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import List, Optional, Tuple
+
+from nccorrection.engine.parser.dstv_part import DstvContour, DstvHole, DstvMarking
+
+
+@dataclass
+class DstvFace:
+    """All geometry that belongs to a single face (v/o/u/h)."""
+    face_code: str = 'v'
+    outer_contour: Optional[DstvContour] = None
+    inner_contours: List[DstvContour] = field(default_factory=list)
+    holes: List[DstvHole] = field(default_factory=list)
+    markings: List[DstvMarking] = field(default_factory=list)
+
+    @property
+    def bounds(self) -> Tuple[float, float, float, float]:
+        """Return ``(min_x, min_y, max_x, max_y)`` of the outer contour."""
+        pts = self.outer_contour.points if self.outer_contour else []
+        if not pts:
+            return (0.0, 0.0, 0.0, 0.0)
+        xs = [p[0] for p in pts]
+        ys = [p[1] for p in pts]
+        return (min(xs), min(ys), max(xs), max(ys))
