+                for dy in range(-int(2 * rr) - box, int(2 * rr) + box + 1):
+                    for dx in range(-int(2 * rr) - box, int(2 * rr) + box + 1):
+                        x, y = int(sx) + dx, int(sy) + dy
+                        if 0 <= x < img.width() and 0 <= y < img.height():
+                            if is_rose(img.pixelColor(x, y)):
+                                nrose += 1
+                self.assertGreaterEqual(nrose, 8,
