+        w.mouseMoveEvent(_move(mid.x() - 25.0, mid.y()))
+        _s1, _s2, _p1, _p2, _perp2, dim_off = w._measure_line_geometry(0)
+        self.assertNotAlmostEqual(dim_off, 0.0, delta=1e-6)
