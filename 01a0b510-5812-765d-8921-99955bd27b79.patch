index 0000000..b658efb
--- /dev/null
+++ b/src/nccorrection/engine/math/coordinate_transform.py
@@ -0,0 +1,79 @@
+"""Face coordinate systems for DSTV NC1 parts.
+
+Every DSTV face (``v``/``o``/``u``/``h``) has its own 2D coordinate system:
+
+    v (web)          X along the length, Y across the web height (0..H)
+    o (top flange)   X along the length, Y across the flange width (0..B)
+    u (bottom flange)X along the length, Y across the flange width (0..B)
+    h (rear)         X along the length, Y across the web height (mirror of v)
+
+Screen coordinates are the inverse of DSTV coordinates: the canvas Y axis
+goes DOWN while DSTV Y goes UP, so a vertical flip is required.
+"""
+
+
+class FaceCoordinateSystem:
+    """Handle the coordinate system of each DSTV face."""
+
+    FACE_ORDER = ['v', 'o', 'u', 'h']
+    FACE_LABELS = {
+        'v': 'v (Web)',
+        'o': 'o (Top Flange)',
+        'u': 'u (Bottom Flange)',
+        'h': 'h (Rear Web)',
+    }
+
+    @staticmethod
+    def valid_faces(profile_type: str) -> list:
+        """Face codes that exist for a given profile type.
+
+        Mirrors ``face_planes.real_faces`` / ``nc1_writer.valid_faces`` —
+        L-sections carry ``v`` and ``u`` only (their two machined legs).
+        """
+        t = (profile_type or 'B').upper()
+        if t == 'L':
+            return ['v', 'u']
+        if t in ('RO', 'RU'):
+            return ['v']
+        if t == 'SO':
+            return ['v', 'o']
+        return ['v', 'o', 'u', 'h']
+
+    @staticmethod
+    def get_face_bounds(profile_type, face_code, header):
+        """Return ``(width, height)`` of a face from the ST header.
+
+        I-profile:    v/h = (length, height) ; o/u = (length, flange_width)
+        L-profile:    v = (length, flange_width) ; u = (length, profile_height)
+        B (plate):    v = (length, width)
+        """
+        t = (profile_type or 'B').upper()
+        length = getattr(header, 'length', 0.0) or 0.0
+        height = getattr(header, 'profile_height', 0.0) or 0.0
+        width = getattr(header, 'flange_width', 0.0) or 0.0
+        if t == 'B':
+            return (length, width)
+        if t == 'L':
+            # Angle: face v is the vertical leg b (DSTV Y spans dims[2] =
+            # flange_width), face u is the horizontal leg a (DSTV Y spans
+            # dims[1] = profile_height) — see face_planes._l_frame.
+            return (length, width) if face_code in ('v', 'h') else (length, height)
+        if face_code in ('o', 'u'):
+            return (length, width)
+        return (length, height)
+
+    @staticmethod
+    def dstv_to_canvas(dstv_x, dstv_y, scale, offset_x, offset_y, canvas_height):
+        """Convert DSTV face coordinates to canvas coordinates.
+
+        DSTV: Y goes UP from the bottom of the face.
+        Canvas: Y goes DOWN from the top of the canvas.
+        """
+        return (dstv_x * scale + offset_x,
+                canvas_height - dstv_y * scale - offset_y)
+
+    @staticmethod
+    def canvas_to_dstv(canvas_x, canvas_y, scale, offset_x, offset_y, canvas_height):
+        """Inverse of :meth:`dstv_to_canvas`."""
+        return ((canvas_x - offset_x) / scale if scale else 0.0,
+                (canvas_height - canvas_y - offset_y) / scale if scale else 0.0)
diff --git a/src/nccorrection/engine/math/foreshorten.py b/src/nccorrection/engine/math/foreshorten.py
