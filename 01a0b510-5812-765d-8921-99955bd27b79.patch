index 0000000..01b4393
--- /dev/null
+++ b/src/nccorrection/engine/math/foreshorten.py
@@ -0,0 +1,256 @@
+"""Flexible Smart Foreshortening (View Break System) - pure math, no Qt.
+
+The problem: long profiles (70 000 mm, 12 000 mm) with details only at their
+ends become unreadable when zoomed out. The Tekla-style solution compresses
+the long empty middle sections (voids) on screen and draws a zig-zag break
+line there, pulling the detailed ends closer together - while every
+measurement keeps reporting the TRUE physical DSTV distance.
+
+Everything here is RELATIVE to ``total_length``: the cuttability threshold
+and the compression ratio are fractions, never hardcoded millimetres, so the
+exact same engine serves a 6 490 mm gusset and a 70 000 mm beam.
+
+Map definition (piecewise-linear, strictly monotonic):
+    real domain [0, L]   ->   display domain [0, D]
+
+        populated zone     : display_len = real_len              (1:1)
+        non-cuttable void  : display_len = real_len              (1:1)
+        cuttable void      : display_len = real_len * compress   (compress < 1)
+
+Every segment is an affine map with positive slope, so both
+``map_real_to_screen()`` and its exact inverse ``map_screen_to_real()`` are
+well defined. Inside a cut void the inverse slope is ``1/compress > 1``: a
+measurement that spans a hidden 50 000 mm void still reports the true real
+distance, because the measure tool maps each endpoint back to real X first.
+"""
+
+from __future__ import annotations
+
+import bisect
+from typing import List, Tuple, Optional
+
+# A populated [min_X, max_X] zone (any face) in real DSTV millimetres.
+Zone = Tuple[float, float]
+
+# A void: (real_start, real_end, display_len) or (real_start, real_end).
+Void = Tuple[float, float]
+
+
+# --------------------------------------------------------------------------- #
+# Step 1a - dynamic void detection (no hardcoded distances)
+# --------------------------------------------------------------------------- #
+def merge_zones(total_length: float, zones: List[Zone],
+                merge_tol: Optional[float] = None) -> List[Zone]:
+    """Normalise + merge the populated zones into disjoint intervals.
+
+    Zones are clamped into ``[0, total_length]``, sorted by start, then merged
+    when they overlap or are separated by less than ``merge_tol`` (default
+    ``0.5%`` of the total length) so a hairline gap between a hole rim and a
+    cut never masquerades as a cuttable void.
+    """
+    L = float(total_length)
+    if L <= 0.0:
+        return []
+    tol = L * 0.005 if merge_tol is None else float(merge_tol)
+    raw = sorted((max(0.0, min(a, b)), min(L, max(a, b)))
+                 for (a, b) in zones if a is not None and b is not None)
+    merged: List[Zone] = []
+    for a, b in raw:
+        if b - a <= 1e-12:          # degenerate point zone: skip (no length)
+            continue
+        if merged and a <= merged[-1][1] + tol:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], b))
+        else:
+            merged.append((a, b))
+    return merged
+
+
+def find_voids(total_length: float, zones: List[Zone],
+               threshold: float = 0.10,
+               merge_tol: Optional[float] = None) -> Tuple[List[Zone], List[Void]]:
+    """Return ``(populated, cuttable_voids)``.
+
+    A void is the complement of the populated zones inside ``[0, L]``. It is
+    only *cuttable* when it represents a significant share of the total
+    length: ``void_len >= total_length * threshold`` (inclusive boundary of
+    the "> 10%" rule, so a float-level exact 10% void is not missed).
+    ``cuttable_voids`` is a list of ``(v0, v1)`` in real DSTV millimetres.
+    """
+    L = float(total_length)
+    if L <= 0.0:
+        return [], []
+    populated = merge_zones(L, zones, merge_tol)
+    voids: List[Void] = []
+    if not populated:
+        voids = [(0.0, L)]
+    else:
+        if populated[0][0] > 0.0:
+            voids.append((0.0, populated[0][0]))
+        for (a1, b1), (a2, b2) in zip(populated, populated[1:]):
+            if b1 < a2:
+                voids.append((b1, a2))
+        if populated[-1][1] < L:
+            voids.append((populated[-1][1], L))
+    cut = [(a, b) for (a, b) in voids if (b - a) >= L * float(threshold)]
+    return populated, cut
+
+
+# --------------------------------------------------------------------------- #
+# Step 1b - the real <-> display translation mapping
+# --------------------------------------------------------------------------- #
+class Foreshorten:
+    """Flexible view-break mapping for one part.
+
+    Builds the monotonic piecewise-linear map real ``[0, L]`` -> display
+    ``[0, D]``. Populated zones and sub-threshold voids keep their real
+    length; cuttable voids are compressed by ``compress``.
+    """
+
+    def __init__(self, total_length: float, zones: List[Zone],
+                 threshold: float = 0.10, compress: Optional[float] = None,
+                 merge_tol: Optional[float] = None,
+                 widget_width: Optional[float] = None):
+        L = float(total_length)
+        if L <= 0.0:
+            raise ValueError('total_length must be > 0')
+        if not (0.0 < float(threshold) <= 1.0):
+            raise ValueError('threshold must be in (0, 1]')
+        if compress is not None and not (0.0 < float(compress) <= 1.0):
+            raise ValueError('compress must be in (0, 1]')
+        if widget_width is not None and float(widget_width) <= 0.0:
+            raise ValueError('widget_width must be > 0')
+        self._L = L
+        self._threshold = float(threshold)
+
+        populated, cut = find_voids(L, zones, threshold, merge_tol)
+        cut_set = set(cut)
+
+        # Enumerate the segments in build order once, then pre-accumulate the
+        # 1:1 content (P) and the cuttable void length (V) so the compression
+        # ratio can be DERIVED from the target display length (``0.8 * the
+        # widget width``) instead of a hardcoded constant.
+        segs = []
+        cursor = 0.0
+        for (a, b) in populated:
+            if cursor < a:
+                segs.append((cursor, a, 'void', (cursor, a) in cut_set))
+            segs.append((a, b, 'zone', False))
+            cursor = b
+        if cursor < L:
+            segs.append((cursor, L, 'void', (cursor, L) in cut_set))
+        P = sum(r1 - r0 for r0, r1, _k, c in segs if not c)
+        V = sum(r1 - r0 for r0, r1, _k, c in segs if c)
+
+        if compress is not None:
+            comp = float(compress)
+        elif widget_width is not None and V > 1e-9:
+            # Fill ~80% of the available widget width, giving the detailed ends
+            # breathing room without over-squashing them: the void display
+            # length is solved for so ``display_length == 0.8 * widget_width``,
+            # clamped to keep voids visible (>= 20%) and never expanded (> 1).
+            target = 0.8 * float(widget_width)
+            comp = min(1.0, max(0.20, (target - P) / V))
+        else:
+            comp = 0.10
+        self._compress = comp
+
+        self._r = [0.0]                 # real segment starts (monotonic)
+        self._d = [0.0]                 # display segment starts (monotonic)
+        self._slope = []                # display units per real unit
+        self._kind = []                 # 'zone' | 'void'
+        self._cut = []                  # bool: is this segment a cut void
+        self._D = 0.0
+
+        for (r0, r1, kind, is_cut) in segs:
+            self._append(r0, r1, kind, is_cut)
+
+    def _append(self, r0: float, r1: float, kind: str, cut: bool):
+        rl = r1 - r0
+        if rl <= 1e-12:
+            return
+        if kind == 'void' and cut:
+            dl = rl * self._compress
+        else:
+            dl = rl
+        self._r.append(r1)
+        self._d.append(self._D + dl)
+        self._slope.append(dl / rl)
+        self._kind.append(kind)
+        self._cut.append(cut)
+        self._D += dl
+
+    # ------------------------------------------------------------------ api
+    @property
+    def total_length(self) -> float:
+        """True physical length L (real DSTV mm)."""
+        return self._L
+
+    @property
+    def display_length(self) -> float:
+        """Foreshortened display length D (same units as real, compressed)."""
+        return self._D
+
+    @property
+    def void_count(self) -> int:
+        """Number of cuttable voids active in this mapping."""
+        return sum(1 for c in self._cut if c)
+
+    def map_real_to_screen(self, real_x: float) -> float:
+        """Real DSTV X -> display X (monotonic, invertible)."""
+        x = max(0.0, min(self._L, float(real_x)))
+        i = min(bisect.bisect_right(self._r, x) - 1, len(self._slope) - 1)
+        if i < 0:
+            return 0.0
+        return self._d[i] + (x - self._r[i]) * self._slope[i]
+
+    def map_screen_to_real(self, screen_x: float) -> float:
+        """Display X -> true real DSTV X (exact inverse of the above)."""
+        s = max(0.0, min(self._D, float(screen_x)))
+        i = min(bisect.bisect_right(self._d, s) - 1, len(self._r) - 2)
+        if i < 0:
+            return 0.0
+        rl = self._r[i + 1] - self._r[i]
+        dl = self._d[i + 1] - self._d[i]
+        if dl <= 1e-12:
+            return self._r[i]
+        return self._r[i] + (s - self._d[i]) * rl / dl
+
+    def break_marks(self) -> List[dict]:
+        """The cut voids for the renderer: where to draw the zig-zag lines.
+
+        Each mark carries the real interval and the display mid/span so the
+        renderer can place the break line without re-deriving the geometry::
+
+            {'x0': real_start, 'x1': real_end,
+             'sx0': display_start, 'sx1': display_end}
+        """
+        marks = []
+        for i in range(len(self._kind)):
+            if not self._cut[i]:
+                continue
+            marks.append({
+                'x0': self._r[i], 'x1': self._r[i + 1],
+                'sx0': self._d[i], 'sx1': self._d[i + 1],
+            })
+        return marks
+
+
+def build_foreshorten(total_length: float, zones: List[Zone],
+                      threshold: float = 0.10, compress: Optional[float] = None,
+                      merge_tol: Optional[float] = None,
+                      widget_width: Optional[float] = None) -> Foreshorten:
+    """Convenience factory returning a ready :class:`Foreshorten` instance.
+
+    When ``widget_width`` (pixels) is given and ``compress`` is left ``None``,
+    the void compression ratio is derived so the final ``display_length`` fills
+    roughly 80% of the widget width (with ends breathing room). The hardcoded
+    ``0.10`` default is kept for callers that do not supply a widget width.
+    """
+    return Foreshorten(total_length, zones, threshold, compress, merge_tol,
+                       widget_width)
+
+
+__all__ = [
+    'Foreshorten', 'build_foreshorten', 'merge_zones', 'find_voids',
+    'Zone', 'Void',
+]
\ No newline at end of file
