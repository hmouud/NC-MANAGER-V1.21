+"""Tests for interpreters/web_interpreter.py."""
+import unittest
+from nccorrection.engine.contour.interpreters.web_interpreter import WebInterpreter
+from nccorrection.engine.contour.geometry.dimensions import ProfileDimensions
+from nccorrection.engine.contour.models.cut_angles import CutAngles
+from nccorrection.engine.contour.core.enums import Face, CutSide
+from nccorrection.engine.contour.core.constants import TOLERANCE_DEG
+
+
+class TestWebInterpreter(unittest.TestCase):
+    def setUp(self):
+        dims = ProfileDimensions(H=524, b=306, tf=40, tw=21, r=27)
+        angles = CutAngles(steg_front=38.621, steg_rear=41.05)
+        self.wi = WebInterpreter(dims, angles)
+
+    def test_offset_38(self):
+        """Ground truth: A38 web_offset = 418.63mm."""
+        offset = self.wi.offset(38.621)
+        self.assertAlmostEqual(offset, 418.63, delta=1.0)
+
+    def test_offset_zero(self):
+        self.assertEqual(self.wi.offset(0.0), 0.0)
+
+    def test_compute_returns_two_points(self):
+        points = self.wi.compute(Face.V)
+        self.assertEqual(len(points), 2)
+
+    def test_compute_sorted_by_y_desc(self):
+        points = self.wi.compute(Face.V)
+        self.assertGreaterEqual(points[0].y, points[1].y)
+
+    def test_front_is_positive(self):
+        points = self.wi.compute(Face.V)
+        front = [p for p in points if p.side == CutSide.FRONT][0]
+        self.assertGreater(front.x, 0)
+
+    def test_rear_is_negative(self):
+        points = self.wi.compute(Face.V)
+        rear = [p for p in points if p.side == CutSide.REAR][0]
+        self.assertLess(rear.x, 0)
+
+
+class TestWebInterpreterNoCut(unittest.TestCase):
+    def test_no_cut_returns_empty(self):
+        dims = ProfileDimensions(H=100, b=50)
+        angles = CutAngles()
+        wi = WebInterpreter(dims, angles)
+        self.assertEqual(wi.compute(Face.V), [])
