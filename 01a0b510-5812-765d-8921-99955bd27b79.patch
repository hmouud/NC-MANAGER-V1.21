+        f = build_foreshorten(12000.0, [(0, 1000), (11000, 12000)], compress=0.25)
+        # Real distance between ends = 11000 - 1000 = 10000 mm
+        # Display length = 2000 + 10000 * 0.25 = 4500 mm
+        self.assertAlmostEqual(f.display_length, 4500.0)
+
+        # Measurements across the hidden void MUST stay 100% exact real distance:
+        pt1_disp = f.map_real_to_screen(500.0)
+        pt2_disp = f.map_real_to_screen(11500.0)
+        real1 = f.map_screen_to_real(pt1_disp)
+        real2 = f.map_screen_to_real(pt2_disp)
+        self.assertAlmostEqual(real2 - real1, 11000.0)
