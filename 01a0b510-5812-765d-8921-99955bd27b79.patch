diff --git a/src/nccorrection/engine/render_2d/renderer_2d.py b/src/nccorrection/engine/render_2d/renderer_2d.py
new file mode 100644
index 0000000..193fc8e
--- /dev/null
+++ b/src/nccorrection/engine/render_2d/renderer_2d.py
@@ -0,0 +1,2426 @@
+"""2D face-by-face DSTV renderer (Qt).
+
+Each DSTV face (``v``/``o``/``u``/``h``) is rendered in its own viewport with
+its own coordinate system and auto-fit scale. The ``all`` mode draws the four
+faces in a 2x2 grid so the whole part development is visible at once.
+
+Contour arcs (non-zero DSTV ``bulge``) are interpolated with
+:func:`~nccorrection.engine.math.arc_interpolation.bulge_to_arc_points`, holes are
+circles with crosshairs and diameter labels, inner contours (IK) are filled as
+cut-outs.
+"""
+
+import math
+import re
+from collections import defaultdict
+
+from PySide6.QtCore import Qt, QPointF, QRectF, QSizeF, QLineF, Signal
+from PySide6.QtGui import (QPainter, QColor, QPen, QBrush, QFont, QFontMetrics,
+                           QPainterPath, QPolygonF, QTransform)
+from PySide6.QtWidgets import QWidget, QMenu
+
+from nccorrection.engine.math.arc_interpolation import polyline_for_vertices
+from nccorrection.engine.math.coordinate_transform import FaceCoordinateSystem
+from nccorrection.design.snaps import (SNAP_KINDS, SnapTargets, resolve_snap,
+                                       SNAP_PRIORITY, polar_snap, stadium_rim)
+from nccorrection.design.theme import blueprint_palette, measure_palette
+from nccorrection.ui.components.scaling import sp
+from nccorrection.design.measure import (corner_angle, corner_label,
+                                         angle_label, angle_verdict)
+from nccorrection.engine.steel_engine.catalog import get_profile
+
+
+def _hdr(hdr, field, default=''):
+    """Read a header attribute defensively (the part may lack a header or a
+    field); the Fabrication Title Block must never crash on empty data."""
+    if hdr is None:
+        return default
+    return getattr(hdr, field, default)
+
+
+def _mm(hdr):
+    """Longueur cell helper: length in mm as an integer when available."""
+    if hdr is None:
+        return ''
+    length = getattr(hdr, 'length', 0.0)
+    if not length:
+        return ''
+    return f'{float(length):.0f}'
+
+
+# ------------------------------------------------------------- Mémotech link
+_STEEL_KG_MM3 = 7.85e-6   # 7850 kg/m³, same constant as ui.app / steel catalog
+
+# Nom cell: true structural designation by DSTV profile-type code (CTO
+# directive 2026-09-01): I->POUTRE, B->PLAQUE, L->CORNIÈRE, U->FER U, T->TUBE.
+_NOM_STYLE = {
+    'I': 'POUTRE',
+    'B': 'PLAQUE',
+    'L': 'CORNI\u00c8RE',
+    'U': 'FER U',
+    'T': 'TUBE',
+}
+
+
+def _nom_style(profile_type):
+    """Structural designation for the cartouche Nom cell; unknown codes are
+    echoed verbatim (defensive, never crashes)."""
+    return _NOM_STYLE.get(profile_type, profile_type or '')
+
+
+def _poids_u_kg(hdr):
+    """Piece weight (kg) for the cartouche Poids U cell -- mathematically
+    sound chain (CTO directive 2026-09-01):
+      1. Plate (B): Length * Width * Thickness * 7.85e-6        [kg]
+      2. Rolled:    raw_dims[6] (kg/m from the DSTV header) * L/1000
+      3. Rolled:    Mémotech catalogue Area (mm²) * L * 7.85e-6 [kg]
+                    (profile-by-name lookup; catalogue is engine-pure)
+    Returns None when no source exists (cell renders empty, never crashes).
+    """
+    if hdr is None:
+        return None
+    dims = hdr.raw_dims or []
+    if not dims:
+        return None
+    L = dims[0]
+    if not L:
+        return None
+
+    if hdr.profile_type == 'B':
+        # plate: dims = [L, W, t] (ui.app._part_metrics convention)
+        W = dims[1] if len(dims) > 1 else 0.0
+        t = dims[2] if len(dims) > 2 else 0.0
+        if not t:  # NC1 plates declare the thickness in the name: PL<t>x<b>
+            m = re.match(r'^PL\s*(\d+(?:\.\d+)?)',
+                         str(getattr(hdr, 'profile_name', '') or ''), re.I)
+            if m:
+                t = float(m.group(1))
+        return t * L * W * _STEEL_KG_MM3 if (t and W) else None
+
+    # rolled: authoritative DSTV weight-per-metre wins when present
+    if len(dims) > 6 and dims[6]:
+        return dims[6] * L / 1000.0
+
+    # Mémotech catalogue fallback: Area (mm²) * length * density
+    name = str(getattr(hdr, 'profile_name', '') or '')
+    prof = get_profile(name) if name else None
+    if prof is not None:
+        return prof.area * L * _STEEL_KG_MM3
+    return None
+
+
+def _poids_u_text(part):
+    """Formatted Poids U cell text (kg, 2 decimals like ui.app); '' when the
+    weight cannot be determined from any of the three sources."""
+    kg = _poids_u_kg(getattr(part, 'header', None))
+    return f'{kg:.2f}' if kg is not None else ''
+
+
