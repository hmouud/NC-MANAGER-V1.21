+Extracted from profile_catalog.nc1_writer and part_creator.nc1_generator
+to eliminate D9 duplication.
+"""
+
+
+def fmt(val: float) -> str:
+    """Format float for NC1: 2 decimal places, strip trailing zeros."""
+    return f"{val:.2f}".rstrip('0').rstrip('.')
+
+
+def fmt3(val: float) -> str:
+    """Format float with exactly 3 decimal places."""
+    return f"{val:.3f}"
