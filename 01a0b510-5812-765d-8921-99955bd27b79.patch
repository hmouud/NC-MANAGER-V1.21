+    def test_import_folder_conflict_deferred_replace(self):
+        self._set_import_projects()
+        self.w._current_project = '23-001'
+        folder = os.path.join(self.tmp, 'srcfolder')
+        os.makedirs(folder)
+        p1 = self._write_ord_nc1(folder, 'C1.nc1', '23-001')
+        # existing row: C1.nc1 with DIFFERENT content (longer profile)
+        existing = os.path.join(self.tmp, 'existing', 'C1.nc1')
+        os.makedirs(os.path.dirname(existing))
+        with open(existing, 'w', encoding='latin-1') as fh:
+            fh.write('ST\n** C1.nc1\n23-001\nHEA300\n9000.0\nBO\nEN\n')
+        import hashlib
+        with open(existing, 'rb') as fh:
+            h = hashlib.sha256(fh.read()).hexdigest()
+        from nccorrection.core.classifier import classify_text
+        with open(existing, encoding='latin-1') as fh:
+            text = fh.read()
+        c = classify_text(text, 'C1.nc1')
+        rec = self.w._make_record(existing, text, h, c)
+        rec['order'] = '23-001'
+        rec['src_path'] = existing
+        stored, _ = self.w.projects.store_copy('23-001', 'C1.nc1', existing,
+                                               text, h)
+        rec['path'] = os.path.join(self.w.projects.project_path('23-001'), stored)
+        self.w.files.append(rec)
+        # persist the manifest like a real saved project (load_files on the
+        # next import must find this row)
+        self.w.projects.save_project('23-001', [rec])
+        # now import the folder -> same name, different content -> deferred
+        self.w._ask_folder_conflict = lambda rec2: 'replace'
+        self.w._import_folder(folder)
+        # one row only, stored copy replaced with the incoming content
+        self.assertEqual(len(self.w.files), 1)
+        base = self.w.projects.project_path('23-001')
+        with open(os.path.join(base, 'C1.nc1'), encoding='latin-1') as fh:
+            content = fh.read()
+        self.assertIn('HEA200', content)
+        self.assertNotIn('HEA300', content)
