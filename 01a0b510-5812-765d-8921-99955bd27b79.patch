+    def test_blueprint_dstv_point_at_face_and_padding(self):
+        """Renderer-level DSTV mapping: dstv_point_at returns the DSTV face
+        code + part coords for clicks inside a face canvas (v + u are the
+        faces the beam fixture actually carries) and None in the padding."""
+        from nccorrection.engine.parser.dstv_parser import DstvParser
+        self._load_beam()
+        f = self.w.files[0]
