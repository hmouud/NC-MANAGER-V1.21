+class TestStadiumRim(unittest.TestCase):
+    """True B-Rep slot rims fed to the snap engine (d=22, overall=40)."""
+
+    def test_walls_and_caps_geometry(self):
+        segs, arcs = stadium_rim(0.0, 0.0, 22.0, 40.0, 0.0)
+        self.assertEqual(len(segs), 2)
+        self.assertEqual(len(arcs), 2)
+        # tangent walls sit at y = +-11 with half straight = 9
+        (w1a, w1b), (w2a, w2b) = segs
+        self.assertAlmostEqual(w1a[1], 11.0)
+        self.assertAlmostEqual(w1b[1], 11.0)
+        self.assertAlmostEqual(abs(w1a[0]), 9.0)
+        self.assertAlmostEqual(abs(w1b[0]), 9.0)
+        self.assertAlmostEqual(w2a[1], -11.0)
+        self.assertAlmostEqual(w2b[1], -11.0)
+        # caps centred at +-9 with the slot radius
+        c1 = (arcs[0][0], arcs[0][1], arcs[0][2])
+        c2 = (arcs[1][0], arcs[1][1], arcs[1][2])
+        self.assertAlmostEqual(abs(c1[0]), 9.0)
+        self.assertAlmostEqual(abs(c2[0]), 9.0)
+        self.assertAlmostEqual(c1[2], 11.0)
+        self.assertAlmostEqual(c2[2], 11.0)
+
+    def test_nearest_snaps_onto_slot_rim(self):
+        segs, arcs = stadium_rim(0.0, 0.0, 22.0, 40.0, 0.0)
+        t = OsnapTargets(segments=segs, arcs=arcs)
+        pt, kind, _ = resolve_osnap(t, (0.0, 14.0), (NEAREST,), tol=8.0)
+        self.assertEqual(kind, NEAREST)
+        self.assertAlmostEqual(pt[1], 11.0)
+        self.assertAlmostEqual(pt[0], 0.0)
+
+    def test_nearest_snaps_onto_cap_rim(self):
+        # cursor just beyond the right cap rim: nearest lands on the cap arc
+        segs, arcs = stadium_rim(0.0, 0.0, 22.0, 40.0, 0.0)
+        t = OsnapTargets(segments=segs, arcs=arcs)
+        pt, kind, _ = resolve_osnap(t, (22.0, 3.0), (NEAREST,), tol=8.0)
+        self.assertEqual(kind, NEAREST)
+        self.assertAlmostEqual((pt[0] - 9.0) ** 2 + pt[1] ** 2, 121.0, places=3)
+
+    def test_midpoint_on_arc(self):
+        # top cap midpoint of the right cap (angle 0 from its centre)
+        segs, arcs = stadium_rim(0.0, 0.0, 22.0, 40.0, 0.0)
+        right = [a for a in arcs if a[0] > 0][0]
+        t = OsnapTargets(segments=segs, arcs=[right])
+        pt, kind, _ = resolve_osnap(t, (20.0, 2.0), (MIDPOINT,), tol=8.0)
+        self.assertEqual(kind, MIDPOINT)
+        self.assertAlmostEqual(pt[1], 0.0, places=6)
+        self.assertAlmostEqual(pt[0], 20.0, places=6)
+
+    def test_intersection_filtered_to_arc_span(self):
+        # vertical edge x=0 cuts the left cap circle at (0, +-6.32) but those
+        # points lie on the buried half of the cap -> must be rejected
+        segs, arcs = stadium_rim(0.0, 0.0, 22.0, 40.0, 0.0)
+        left = [a for a in arcs if a[0] < 0][0]
+        t = OsnapTargets(segments=[((-1.0, -20.0), (-1.0, 20.0))],
+                         circles=[], arcs=[left])
+        res = resolve_osnap(t, (-1.0, 0.0), (INTERSECTION,), tol=20.0)
+        self.assertIsNone(res)
+
+    def test_intersection_on_exposed_cap(self):
+        # vertical edge x=20 just inside the right cap tip: exposed cap point
+        segs, arcs = stadium_rim(0.0, 0.0, 22.0, 40.0, 0.0)
+        right = [a for a in arcs if a[0] > 0][0]
+        t = OsnapTargets(segments=[((20.0, -20.0), (20.0, 20.0))],
+                         circles=[], arcs=[right])
+        pt, kind, _ = resolve_osnap(t, (20.0, 0.0), (INTERSECTION,), tol=20.0)
+        self.assertEqual(kind, INTERSECTION)
+        self.assertAlmostEqual(pt[0], 20.0, places=6)
+
