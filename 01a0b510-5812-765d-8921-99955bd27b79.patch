+        # label sits above the midpoint (500, -24) in screen space
+        hit = s.label_at((500, -24), to_screen)
+        self.assertIsNotNone(hit)
+        idx, a, b, off = hit
+        self.assertEqual(idx, 0)
+        self.assertEqual(off, (0.0, 0.0))
+        # a point far from any label is a miss
+        self.assertIsNone(s.label_at((0, 0), to_screen))
+        # dragging applies the offset
+        off = s.move_label(0, (40, -60))
+        self.assertEqual(off, (40.0, -60.0))
+        hit = s.label_at((500 + 40, -24 - 60), to_screen)
