+        grp.addButton(orig_rb)
+        grp.addButton(copy_rb)
+        lay.addWidget(imported_rb)
+        lay.addWidget(orig_rb)
+        lay.addWidget(copy_rb)
+
+        name_row = QHBoxLayout()
+        name_row.addWidget(QLabel(self.tr_('save_name') + ':', dlg))
