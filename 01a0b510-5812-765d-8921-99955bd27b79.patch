+"""SettingsMixin — settings / theme / about dialog logic extracted from NCManagerApp.
+
+Kept as a mixin so that app.py stays manageable while the settings
+domain methods remain on the same ``self`` and require zero call-site
+changes.
+
+Extracted methods:
+    _set_lang, _show_about, _open_settings, _toggle_column,
+    _set_beginner_help, _reset_view_opts, _apply_theme_choice,
+    _reset_theme, _customize_colors (with nested pick), _pick_output_dir.
+"""
+
+import os
+
+from PySide6.QtWidgets import (
+    QColorDialog,
+    QDialog,
+    QFileDialog,
+    QHBoxLayout,
+    QLabel,
+    QPushButton,
+    QVBoxLayout,
+)
+from PySide6.QtCore import Qt
+
+from nccorrection.services.settings_service import DEFAULT_SETTINGS
+from nccorrection.ui.styles import apply_theme, THEMES
+
+_VERSION = '1.v21'
+
+
+class SettingsMixin:
+    """Settings / theme / about dialog helpers mixed into NCManagerApp."""
+
+    def _set_lang(self, code):
+        self.lang = code
+        self.settings.set('language', code)
+        self._settings_dirty = True
+        self._build()
+        self._set_status(self.tr_('ready'))
+
+    def _show_about(self):
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('about'))
+        dlg.setModal(True)
+        dlg.setFixedWidth(400)
+        outer = QVBoxLayout(dlg)
+        outer.setContentsMargins(20, 20, 20, 16)
+        top = QHBoxLayout()
+        from nccorrection.ui.components.svg_icon import rasterize_svg
+        logo_path = self._path('artsbuilderexecute.png')
+        if os.path.isfile(logo_path):
+            logo = QLabel(dlg)
+            logo.setPixmap(rasterize_svg(logo_path, 48))
+            top.addWidget(logo)
+        name = QLabel(f"{self.tr_('app_title')} {_VERSION}", dlg)
+        name.setStyleSheet(f'font-size:16px; font-weight:600; color:{self._theme["txt"]};')
+        top.addWidget(name)
+        top.addStretch(1)
+        outer.addLayout(top)
+        desc = QLabel(self.tr_('about_text'), dlg)
+        desc.setWordWrap(True)
+        desc.setStyleSheet(f'color:{self._theme["mut"]}; font-size:12px;')
+        outer.addWidget(desc)
+        ok = QPushButton('OK', dlg)
+        ok.clicked.connect(dlg.accept)
+        outer.addWidget(ok, 0, Qt.AlignRight)
+        dlg.exec()
+
+    def _open_settings(self):
+        """P2: settings dialog moved to DialogManager. Thin delegate kept for
+        the toolbar button binding and the radio-capture test helper."""
+        return self.dialog_manager.open_settings()
+
+    def _toggle_column(self, key, checked):
+        self.settings.set_column_visible(key, checked)
+        self._render_table()
+
+    def _set_beginner_help(self, checked):
+        self.settings.set_beginner_help(checked)
+        self._update_help()
+
+    def _reset_view_opts(self):
+        default = DEFAULT_SETTINGS.get('viewOpts', {})
+        for k in (self.VIEW_OPTS_2D + self.VIEW_OPTS_3D):
+            self._apply_view_opt(k[0], default.get(k[0], False))
+        self.help_label.setText('')
+
+    def _apply_theme_choice(self, name):
+        self.settings.set('theme', name)
+        self._theme = apply_theme(name, self.settings.get('themeCustom'))
+        self._settings_dirty = True
+        self._build()
+        self._set_status(self.tr_('ready'))
+
+    def _reset_theme(self):
+        name = self.settings.get('theme', 'industrial-dark')
+        self.settings.set('themeCustom', None)
+        self._theme = apply_theme(name, None)
+        self._settings_dirty = True
+        self._build()
+        self._set_status(self.tr_('ready'))
+
+    def _customize_colors(self):
+        custom = dict(self.settings.get('themeCustom') or {})
+        base = THEMES.get(self.settings.get('theme', 'industrial-dark'), THEMES['industrial-dark'])
+        keys = [('accent', self.tr_('custom_accent')),
+                ('blue', self.tr_('custom_blue')),
+                ('green', self.tr_('custom_green')),
+                ('red', self.tr_('custom_red'))]
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('customize_theme'))
+        v = QVBoxLayout(dlg)
+        spins = {}
+        for key, label in keys:
+            row = QHBoxLayout()
+            row.addWidget(QLabel(label, dlg))
+            cur = custom.get(key, base.get(key, '#38bdf8'))
+            btn = QPushButton(cur, dlg)
+            btn.setFixedWidth(110)
+
+            def pick(k=key, b=btn):
+                c = QColorDialog.getColor(QColor(b.text()), dlg, self.tr_('customize_theme'))
+                if c.isValid():
+                    b.setText(c.name())
+
+            btn.clicked.connect(pick)
+            row.addWidget(btn)
+            row.addStretch(1)
+            v.addLayout(row)
+            spins[key] = btn
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        btns.addWidget(cancel)
+        ok = QPushButton(self.tr_('save'), dlg)
+        ok.setObjectName('green')
+        ok.clicked.connect(dlg.accept)
+        btns.addWidget(ok)
+        v.addLayout(btns)
+        if dlg.exec() != QDialog.Accepted:
+            return
+        for key, btn in spins.items():
+            custom[key] = btn.text()
+        self.settings.set('themeCustom', custom)
+        self._theme = apply_theme(self.settings.get('theme', 'industrial-dark'), custom)
+        self._settings_dirty = True
+        self._build()
+        self._set_status(self.tr_('ready'))
+
+    def _pick_output_dir(self, edit, parent):
+        start = edit.text().strip() or 'output'
+        d = QFileDialog.getExistingDirectory(parent, self.tr_('browse'), start)
+        if d:
+            edit.setText(os.path.normpath(d))
