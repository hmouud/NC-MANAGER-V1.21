+        try:
+            geometry = parse_geometry(f['text'])
+        except Exception as e:
+            self._report_error('refresh-viewers-parse', e, toast=True)
+            geometry = None
+        if geometry is None:
+            self.viewer.clear_geometry()
+            self.viewer3d.clear_geometry()
+            self.profile_bar.setText('')
+            return
+        overrides = self.hole_overrides.get(f['hash'], {})
+        deleted = self.hole_deleted.get(f['hash'], set())
+        added = self.added_holes.get(f['hash'], [])
+        from nccorrection.core.hole_ops import apply_edits
+        try:
+            geometry, active = apply_edits(geometry, overrides, deleted, added)
+        except Exception as e:
+            self._report_error('refresh-viewers-apply-edits', e, toast=True)
+            active = list(range(len(geometry.get('holes', []))))
+        self._current_geometry = geometry
+        self._current_active = active
+        try:
+            from nccorrection.core.part3d import profile_info
+            info = profile_info(geometry.get('st'), geometry)
+            holes = geometry.get('holes', [])
+            n_h = sum(1 for h in holes if h.get('kind') == 'hole')
+            n_s = sum(1 for h in holes if h.get('kind') == 'slot')
+            extra = []
+            if n_h:
+                extra.append(f"{n_h} hole(s)")
+            if n_s:
+                extra.append(f"{n_s} slot(s)")
+            if extra:
+                info += '  \u00b7  ' + ' \u00b7 '.join(extra)
+            try:
+                from nccorrection.core.viewer import bevel_summary
+                cuts = bevel_summary(geometry, geometry.get('st'))
+                if cuts:
+                    info += '  \u00b7  ' + ' \u00b7 '.join(cuts)
+            except Exception as e:
+                self._report_error('refresh-viewers-bevel', e)
+                pass
+        except Exception as e:
+            self._report_error('refresh-viewers-profile-info', e)
+            info = ''
+        self.profile_bar.setText(info)
+        if preserve_view:
+            self.viewer.set_geometry_object(geometry, fit=False)
+            self.viewer3d.set_geometry_object(geometry, fit=False)
+        else:
+            self.viewer.set_geometry_object(geometry)
+            self.viewer3d.set_geometry_object(geometry)
+            self.viewer3d.set_preset('top')
+        try:
+            from nccorrection.core.nc1_writer import apply_hole_edits
+            merged = dict(overrides)
+            for i in (deleted or ()):
+                merged[i] = None
+            edited = apply_hole_edits(f['text'], merged,
+                                      list(added) if added else None)
+            self.face_viewer.set_part(DstvParser().parse_text(edited))
+        except Exception as e:
+            self._report_error('refresh-viewers-face-edit', e, toast=True)
+            try:
+                self.face_viewer.set_part(DstvParser().parse_text(f['text']))
+            except Exception as e2:
+                self._report_error('refresh-viewers-face-raw', e2)
+                self.face_viewer.clear()
