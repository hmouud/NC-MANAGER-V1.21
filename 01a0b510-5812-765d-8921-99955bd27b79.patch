+"""dimensions.py — ProfileDimensions data class.
+
+🚨 GUARDIAN LAW: هاد الملف ما كايحتويش أي منطق. غير البيانات + validation + factory.
+"""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import List
+
+from ..core.enums import ProfileKind
+from ..core.exceptions import InvalidDimensionsError
+
+
+@dataclass(frozen=True)
+class ProfileDimensions:
+    """الأبعاد القياسية لأي بروفيل.
+
+    I/U/L: H (عمق), b (عرض الفلانج), tf, tw, r
+    O/T:   D (قطر خارجي), t (سمك الجدار)
+    B/FB:  b (عرض), t (سمك)
+    """
+    H: float = 0.0
+    b: float = 0.0
+    tf: float = 0.0
+    tw: float = 0.0
+    r: float = 0.0
+    D: float = 0.0
+    t: float = 0.0
+    length: float = 0.0
+
+    def __post_init__(self) -> None:
+        for name in ("H", "b", "tf", "tw", "r", "D", "t", "length"):
+            value = getattr(self, name)
+            if value < 0:
+                raise InvalidDimensionsError(name, value)
+
+    @classmethod
+    def from_i_profile(cls, dims: List[float]) -> ProfileDimensions:
+        """من ملفات I-beam / Channel / Angle."""
+        def _v(idx: int) -> float:
+            return float(dims[idx]) if len(dims) > idx else 0.0
+        return cls(length=_v(0), H=_v(1), b=_v(2), tf=_v(3), tw=_v(4), r=_v(5))
+
+    @classmethod
+    def from_tube(cls, dims: List[float]) -> ProfileDimensions:
+        """من ملفات Round/SHS/RHS."""
+        def _v(idx: int) -> float:
+            return float(dims[idx]) if len(dims) > idx else 0.0
+        od = _v(1)
+        return cls(length=_v(0), H=od, b=od, D=od, t=_v(3))
+
+    @classmethod
+    def from_plate(cls, dims: List[float]) -> ProfileDimensions:
+        """من ملفات Plate / Flat Bar."""
+        def _v(idx: int) -> float:
+            return float(dims[idx]) if len(dims) > idx else 0.0
+        w = _v(1)
+        return cls(length=_v(0), H=w, b=w, t=_v(2))
+
+    @classmethod
+    def from_header(cls, kind: ProfileKind, dims: List[float]) -> ProfileDimensions:
+        """Dispatcher: كايختار الـ factory المناسب حسب نوع البروفيل."""
+        if kind in (ProfileKind.I, ProfileKind.U, ProfileKind.L):
+            return cls.from_i_profile(dims)
+        if kind in (ProfileKind.O, ProfileKind.T):
+            return cls.from_tube(dims)
+        if kind in (ProfileKind.B, ProfileKind.FB):
+            return cls.from_plate(dims)
+        return cls(length=float(dims[0]) if dims else 0.0)
