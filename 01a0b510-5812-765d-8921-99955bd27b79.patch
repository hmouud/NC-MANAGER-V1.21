+def _write_tmp(text: str, suffix: str) -> str:
+    fd, path = tempfile.mkstemp(suffix=suffix, prefix='fmt_an_')
+    with os.fdopen(fd, 'w', encoding='latin-1') as fh:
+        fh.write(text)
+    return path
+
+
+class TestDetectFormat(unittest.TestCase):
+
+    def test_nc1_detected(self):
+        path = _write_tmp(NC1_PLATE, '.nc1')
+        try:
+            self.assertEqual(detect_format(path), 'NC1')
+        finally:
+            os.remove(path)
+
+    def test_nc1_extension_fallback(self):
+        # ST block present but no data block -> weak; extension keeps NC1.
+        path = _write_tmp('ST\nSomeone\nIPE360\nI\nEN\n', '.nc1')
+        try:
+            self.assertEqual(detect_format(path), 'NC1')
+        finally:
+            os.remove(path)
+
+    def test_dxf_header_detected(self):
+        path = _write_tmp(DXF_SAMPLE, '.dxf')
+        try:
+            self.assertEqual(detect_format(path), 'DXF')
+        finally:
