new file mode 100644
index 0000000..cdb348b
--- /dev/null
+++ b/src/nccorrection/ui/mixins/close_quit.py
@@ -0,0 +1,136 @@
+"""Close/Quit mixin for NCManagerApp.
+
+Extracted from app.py (lines 5909-6021) to keep the main application file
+focused on UI construction and event handling.  Every method references
+``self.`` attributes that live on :class:`NCManagerApp` — this mixin is
+**not** usable standalone.
+"""
+
+from PySide6.QtWidgets import (
+    QApplication,
+    QDialog,
+    QHBoxLayout,
+    QLabel,
+    QPushButton,
+    QVBoxLayout,
+)
+
+from nccorrection.core.classifier import compute_hash
+
+
+class CloseQuitMixin:
+    """Close / save-all / quit-without-save / confirm-close logic."""
+
+    def _dirty_summary(self):
+        """Count what would be lost on close: edited files (persistent dirty),
+        files added this session (import/create - owner rule: the close
+        dialog shows even when the import auto-saved the project), and
+        UI-preference changes."""
+        edited = [f for f in self.files if self._file_dirty(f)]
+        new = [f for f in self.files
+               if (f.get('hash', '') not in self._saved_hashes
+                   or f.get('hash', '') in self._session_added)]
+        return {'edited': len(edited), 'new': len(new),
+                'settings': self._settings_dirty}
+
+    def _save_all_and_close(self):
+        """Commit every pending edit to its imported copy, save the project
+        manifest + settings, then quit. Returns True when the app may quit."""
+        for f in self.files:
+            if not self._file_dirty(f):
+                continue
+            h = f.get('hash', '')
+            edits = dict(self.hole_overrides.get(h, {}))
+            for i in self.hole_deleted.get(h, set()):
+                edits[i] = None
+            added = self.added_holes.get(h, [])
+            try:
+                from nccorrection.core.nc1_writer import apply_hole_edits
+                new_text = apply_hole_edits(f['text'], edits, add_holes=added)
+            except Exception as exc:
+                self._toast(f"{self.tr_('export_fail')}\n{exc}", kind='error',
+                            title=self.tr_('save_all'))
+                return False
+            try:
+                with open(f['path'], 'w', encoding='latin-1', newline='') as fh:
+                    fh.write(new_text)
+            except OSError as exc:
+                self._toast(f"{self.tr_('export_fail')}\n{exc}", kind='error',
+                            title=self.tr_('save_all'))
+                return False
+            f['text'] = new_text
+            f['hash'] = compute_hash(new_text.encode('latin-1'))
+            self.hole_overrides.pop(h, None)
+            self.hole_deleted.pop(h, None)
+            self.added_holes.pop(h, None)
+            f['dirty'] = False
+            f.pop('dirty_at', None)
+            self._session_edited.discard(h)
+        if self.files:
+            pname = self._current_project or self._project_name_from_files() or 'project'
+            self.projects.save_project(
+                pname, self.files,
+                settings={k: self.settings.get(k) for k in
+                          ('language', 'theme', 'outputName', 'themeCustom')},
+                notes=dict(self.settings.get_all_notes() or {}),
+                hole_overrides=self.hole_overrides,
+                hole_deleted={h: list(s) for h, s in self.hole_deleted.items()},
+                added_holes={h: list(lst) for h, lst in self.added_holes.items()},
+                qty_overrides={h: f.get('qty_override') for f in self.files
+                               for h in [f['hash']] if f.get('qty_override') is not None},
+                source_folder=self._project_source_folder(),
+                orders=self.orders)
+            self._current_project = pname
+            self._saved_hashes = {f['hash'] for f in self.files}
+            self._session_added.clear()
+            self.audit.log(f'Close: saved all edits + project {pname}', 'ok', 'OK-500')
+        self._settings_dirty = False
+        self._quit_app()
+        return True
+
+    def _quit_without_save(self):
+        """Close without committing edits/project; settings/geometry still saved."""
+        self._quit_app()
+
+    def _quit_app(self):
+        self._save_geometry()
+        self.settings.save()
+        QApplication.quit()
+
+    def _confirm_close(self):
+        summary = self._dirty_summary()
+        if not any(summary.values()):
+            self._quit_app()
+            return
+        dlg = QDialog(self)
+        dlg.setWindowTitle(self.tr_('close_warning'))
+        dlg.resize(440, 240)
+        v = QVBoxLayout(dlg)
+        warn = QLabel('\u26a0 ' + self.tr_('close_warning'), dlg)
+        warn.setStyleSheet(f'font-size:14px; font-weight:bold; color:{self._theme["yel"]};')
+        v.addWidget(warn)
+        if summary['edited']:
+            v.addWidget(QLabel(self.tr_('close_modified_count').format(n=summary['edited']), dlg))
+        if summary['new']:
+            v.addWidget(QLabel(self.tr_('close_new_count').format(n=summary['new']), dlg))
+        if summary['settings']:
+            v.addWidget(QLabel(self.tr_('close_settings_changed'), dlg))
+        btns = QHBoxLayout()
+        btns.addStretch(1)
+        save_all = QPushButton(self.tr_('save_all'), dlg)
+        save_all.setObjectName('green')
+        save_all.clicked.connect(lambda: (dlg.accept(), self._save_all_and_close()))
+        btns.addWidget(save_all)
+        cancel = QPushButton(self.tr_('cancel'), dlg)
+        cancel.clicked.connect(dlg.reject)
+        btns.addWidget(cancel)
+        close = QPushButton(self.tr_('close_without_save'), dlg)
+        close.setObjectName('red')
+        close.clicked.connect(lambda: (dlg.accept(), self._quit_without_save()))
+        btns.addWidget(close)
+        v.addLayout(btns)
+        dlg.exec()
+
+    def closeEvent(self, event):
+        self._confirm_close()
+        event.ignore()
