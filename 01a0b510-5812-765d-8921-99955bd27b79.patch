+"""Cotation engine — dimension style presets (ISO, ANSI, etc.).
+
+Standard dimension styles used in steel fabrication drawings.
+"""
+from __future__ import annotations
+
+from .models import DimensionStyle
+
+
+def iso_standard() -> DimensionStyle:
+    """ISO 129-1 standard dimension style (mm-based, European)."""
+    return DimensionStyle(
+        text_height=3.5,
+        arrow_size=2.5,
+        precision=0,
+        extension_gap=1.5,
+        line_offset=0.3,
+        color="#f8fafc",
+        extension_color="#94a3b8",
+    )
+
+
+def iso_detailed() -> DimensionStyle:
+    """ISO style with decimal precision (for tight tolerances)."""
+    return DimensionStyle(
+        text_height=3.0,
+        arrow_size=2.0,
+        precision=1,
+        extension_gap=1.0,
+        line_offset=0.25,
+        color="#f8fafc",
+        extension_color="#94a3b8",
+    )
+
+
+def ansi_imperial() -> DimensionStyle:
+    """ANSI style adapted for mm display (US fabrication convention)."""
+    return DimensionStyle(
+        text_height=3.2,
+        arrow_size=3.0,
+        precision=0,
+        extension_gap=2.0,
+        line_offset=0.35,
+        color="#f8fafc",
+        extension_color="#94a3b8",
+    )
+
+
+def compact() -> DimensionStyle:
+    """Compact style for tight spaces (small text, small arrows)."""
+    return DimensionStyle(
+        text_height=2.5,
+        arrow_size=1.8,
+        precision=0,
+        extension_gap=0.8,
+        line_offset=0.2,
+        color="#f8fafc",
+        extension_color="#94a3b8",
+    )
+
+
+def blueprint() -> DimensionStyle:
+    """Blueprint/print style (larger text for paper output)."""
+    return DimensionStyle(
+        text_height=5.0,
+        arrow_size=3.5,
+        precision=0,
+        extension_gap=2.0,
+        line_offset=0.4,
+        color="#f8fafc",
+        extension_color="#94a3b8",
+    )
+
+
+# Registry for lookup by name
+PRESETS = {
+    "iso": iso_standard,
+    "iso_detailed": iso_detailed,
+    "ansi": ansi_imperial,
+    "compact": compact,
+    "blueprint": blueprint,
+}
+
+
+def get_preset(name: str) -> DimensionStyle:
+    """Get a dimension style preset by name.
+
+    Raises KeyError if the preset name is not found.
+    """
+    factory = PRESETS.get(name.lower())
+    if factory is None:
+        available = ", ".join(sorted(PRESETS.keys()))
+        raise KeyError(f"Unknown preset '{name}'. Available: {available}")
+    return factory()
+
+
+def list_presets() -> list[str]:
+    """Return sorted list of available preset names."""
+    return sorted(PRESETS.keys())
diff --git a/src/nccorrection/engine/cotation/renderer.py b/src/nccorrection/engine/cotation/renderer.py
new file mode 100644
index 0000000..6aa0dc4
--- /dev/null
+++ b/src/nccorrection/engine/cotation/renderer.py
@@ -0,0 +1,418 @@
+"""Cotation engine — QPainter renderer for dimension sets.
+
+Tekla-compatible rendering:
+  - Extension lines: gap from part, extend past dimension line
+  - Dimension line: broken where text sits (text has a white background)
+  - Arrows: filled triangles at ends, pointing outward
+  - Text: centered in the break, bold, with background for readability
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Tuple
+
+from PySide6.QtCore import Qt, QPointF, QRectF
+from PySide6.QtGui import (
+    QPen, QColor, QPainter, QFont, QFontMetrics, QPolygonF, QBrush,
+)
+
+from .models import DimensionSet, DimensionStyle
+
+
+# ────────────────────────────────────────────────────────────────────
+# Public API
+# ────────────────────────────────────────────────────────────────────
+
+def render_dimension_set(
+    painter: QPainter,
+    dim: DimensionSet,
+    *,
+    scale: float = 1.0,
+) -> None:
+    """Render a Tekla-style dimension set onto *painter*.
+
+    Rendering order:
+      1. Extension lines (from part edge → past dimension line)
+      2. Dimension line segments (broken where text sits)
+      3. Arrows at ends of each segment
+      4. Text labels with white background (sits in the line break)
+    """
+    if len(dim.points) < 2:
+        return
+
+    style = dim.style
+    color = QColor(style.color)
+    ext_color = QColor(style.extension_color)
+    bg_color = QColor("#0f172a")  # match canvas background
+
+    sorted_pts = sorted(dim.points, key=lambda p: p.projected)
+    dir_x, dir_y = dim.direction
+    norm_x, norm_y = dim.normal
+
+    # ── 1. Extension lines ────────────────────────────────────────
+    ext_pen = QPen(ext_color, style.line_offset * scale)
+    ext_pen.setCosmetic(True)
+    # Extension lines extend past the dimension line by this amount
+    overshoot = style.arrow_size * 2.5
+
+    for pt in dim.points:
+        part_x, part_y = pt.world
+        # Start: gap from part edge
+        ext_start_x = part_x + norm_x * style.extension_gap
+        ext_start_y = part_y + norm_y * style.extension_gap
+        # End: past the dimension line
+        ext_end_x = part_x + norm_x * (dim.offset + overshoot)
+        ext_end_y = part_y + norm_y * (dim.offset + overshoot)
+
+        painter.setPen(ext_pen)
+        painter.drawLine(
+            QPointF(ext_start_x, ext_start_y),
+            QPointF(ext_end_x, ext_end_y),
+        )
+
+    # ── 2-4. Dimension line segments with text breaks ─────────────
+    font = QFont("Segoe UI", int(style.text_height * scale))
+    font.setBold(True)
+    metrics = QFontMetrics(font)
+    text_gap = style.text_height * 0.8 * scale  # half-gap on each side of text
+
+    for i in range(len(sorted_pts) - 1):
+        p1 = sorted_pts[i]
+        p2 = sorted_pts[i + 1]
+
+        # Projected positions along the direction axis
+        proj1 = p1.projected
+        proj2 = p2.projected
+
+        # World positions on the dimension line
+        dl1_x = dim.ref_p1[0] + dir_x * proj1 + norm_x * dim.offset
+        dl1_y = dim.ref_p1[1] + dir_y * proj1 + norm_y * dim.offset
+        dl2_x = dim.ref_p1[0] + dir_x * proj2 + norm_x * dim.offset
+        dl2_y = dim.ref_p1[1] + dir_y * proj2 + norm_y * dim.offset
+
+        # Midpoint for text
+        mid_proj = (proj1 + proj2) / 2.0
+        mid_x = dim.ref_p1[0] + dir_x * mid_proj + norm_x * dim.offset
+        mid_y = dim.ref_p1[1] + dir_y * mid_proj + norm_y * dim.offset
+
+        # Value and label
+        value = proj2 - proj1
+        label = p2.label if p2.label else _format_value(value, style.precision)
+        text_w = metrics.horizontalAdvance(label)
+        text_h = metrics.height()
+
+        # ── Draw dimension line (broken at text) ──────────────────
+        line_pen = QPen(color, style.line_offset * scale)
+        line_pen.setCosmetic(True)
+        painter.setPen(line_pen)
+
+        # For horizontal dimensions, the break is along X
+        # For vertical dimensions, the break is along Y
+        if abs(dir_x) > abs(dir_y):
+            # Horizontal: break along X axis
+            # Line from dl1 to (mid - text_w/2 - gap)
+            break_start_x = mid_x - text_w / 2 - text_gap
+            break_end_x = mid_x + text_w / 2 + text_gap
+
+            # Clamp to segment bounds
+            break_start_x = max(break_start_x, dl1_x)
+            break_end_x = min(break_end_x, dl2_x)
+
+            # Line before text
+            if break_start_x > dl1_x + 0.1:
+                painter.drawLine(QPointF(dl1_x, dl1_y),
+                                 QPointF(break_start_x, dl1_y))
+            # Line after text
+            if break_end_x < dl2_x - 0.1:
+                painter.drawLine(QPointF(break_end_x, dl2_y),
+                                 QPointF(dl2_x, dl2_y))
+        else:
+            # Vertical: break along Y axis
+            break_start_y = mid_y - text_w / 2 - text_gap
+            break_end_y = mid_y + text_w / 2 + text_gap
+
+            break_start_y = max(break_start_y, dl2_y)  # dl2 is "higher"
+            break_end_y = min(break_end_y, dl1_y)      # dl1 is "lower"
+
+            if break_start_y > dl2_y + 0.1:
+                painter.drawLine(QPointF(dl2_x, dl2_y),
+                                 QPointF(dl2_x, break_start_y))
+            if break_end_y < dl1_y - 0.1:
+                painter.drawLine(QPointF(dl1_x, break_end_y),
+                                 QPointF(dl1_x, dl1_y))
+
+        # ── Arrows at segment ends ────────────────────────────────
+        arrow_sz = style.arrow_size
+        # Left/bottom arrow: tip at dl1, pointing outward (away from dl2)
+        _draw_arrow(painter, dl1_x, dl1_y, -dir_x, -dir_y,
+                    arrow_sz, color, scale)
+        # Right/top arrow: tip at dl2, pointing outward (away from dl1)
+        _draw_arrow(painter, dl2_x, dl2_y, dir_x, dir_y,
+                    arrow_sz, color, scale)
+
+        # ── Text with background (sits in the line break) ─────────
+        _draw_dim_text(painter, mid_x, mid_y, label, font, metrics,
+                       bg_color, color, dir_x, dir_y, scale)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Helpers
+# ────────────────────────────────────────────────────────────────────
+
+def _format_value(value: float, precision: int) -> str:
+    """Format a dimension value with the given decimal precision."""
+    if precision == 0:
+        return str(int(round(value)))
+    return f"{value:.{precision}f}"
+
+
+def _draw_arrow(
+    painter: QPainter,
+    tip_x: float,
+    tip_y: float,
+    dir_x: float,
+    dir_y: float,
+    size: float,
+    color: QColor,
+    scale: float,
+) -> None:
+    """Draw a filled triangle arrow at (tip_x, tip_y) pointing in (dir_x, dir_y).
+
+    The arrow tip is at (tip_x, tip_y). The arrow body extends BACKWARD
+    from the tip along the direction vector.
+    """
+    length = math.hypot(dir_x, dir_y)
+    if length < 1e-9:
+        return
+
+    # Unit direction (pointing outward from the dimension line)
+    ux = dir_x / length
+    uy = dir_y / length
+    # Perpendicular
+    px = -uy
+    py = ux
+
+    arrow_len = size * scale
+    arrow_w = size * 0.35 * scale
+
+    painter.setBrush(QBrush(color))
+    painter.setPen(Qt.NoPen)
+    painter.drawPolygon(QPolygonF([
+        QPointF(tip_x, tip_y),
+        QPointF(tip_x - ux * arrow_len + px * arrow_w,
+                tip_y - uy * arrow_len + py * arrow_w),
+        QPointF(tip_x - ux * arrow_len - px * arrow_w,
+                tip_y - uy * arrow_len - py * arrow_w),
+    ]))
+
+
+def _draw_dim_text(
+    painter: QPainter,
+    x: float,
+    y: float,
+    text: str,
+    font: QFont,
+    metrics: QFontMetrics,
+    bg_color: QColor,
+    text_color: QColor,
+    dir_x: float,
+    dir_y: float,
+    scale: float,
+) -> None:
+    """Draw dimension text with a background rectangle (Tekla style).
+
+    The text sits in the break of the dimension line with a small
+    background rectangle for readability.
+    """
+    tw = metrics.horizontalAdvance(text)
+    th = metrics.height()
+    pad = 2.0 * scale  # padding around text
+
+    painter.save()
+
+    if abs(dir_y) > abs(dir_x):
+        # Vertical dimension — rotate text 90°
+        painter.translate(QPointF(x, y))
+        painter.rotate(-90)
+
+        # Background rect
+        bg_rect = QRectF(-tw / 2 - pad, -th / 2 - pad,
+                         tw + 2 * pad, th + 2 * pad)
+        painter.fillRect(bg_rect, bg_color)
+
+        # Text
+        painter.setFont(font)
+        painter.setPen(QPen(text_color, 1.0))
+        painter.drawText(QPointF(-tw / 2, th / 3), text)
+    else:
+        # Horizontal dimension — normal text
+        # Background rect
+        bg_rect = QRectF(x - tw / 2 - pad, y - th / 2 - pad,
+                         tw + 2 * pad, th + 2 * pad)
+        painter.fillRect(bg_rect, bg_color)
+
+        # Text
+        painter.setFont(font)
+        painter.setPen(QPen(text_color, 1.0))
+        painter.drawText(QPointF(x - tw / 2, y + th / 3), text)
+
+    painter.restore()
+
+
+# ────────────────────────────────────────────────────────────────────
+# Angular dimension rendering
+# ────────────────────────────────────────────────────────────────────
+
+def render_angular_dimension(
+    painter: QPainter,
+    dim,
+    *,
+    scale: float = 1.0,
+) -> None:
+    """Render an AngularDimension (from angular.py).
+
+    Tekla style:
+      - Arc from vertex along the two arms
+      - Extension lines from vertex along the arms (past the arc)
+      - Text (degrees) centered on the arc
+      - Small dot at the vertex
+    """
+    style = dim.style
+    color = QColor(style.color)
+    bg_color = QColor("#0f172a")
+
+    vx, vy = dim.vertex
+    a1 = math.atan2(dim.arm1_end[1] - vy, dim.arm1_end[0] - vx)
+    a2 = math.atan2(dim.arm2_end[1] - vy, dim.arm2_end[0] - vx)
+
+    r = dim.radius
+
+    # Normalize angles to find the smaller arc
+    start_deg = math.degrees(a1)
+    end_deg = math.degrees(a2)
+    span = end_deg - start_deg
+    if span < 0:
+        span += 360
+    if span > 180:
+        start_deg, end_deg = end_deg, start_deg
+        span = 360 - span
+
+    # ── Extension lines from vertex along the arms ────────────────
+    ext_pen = QPen(QColor(style.extension_color), style.line_offset * scale)
+    ext_pen.setCosmetic(True)
+    painter.setPen(ext_pen)
+    ext_len = r + style.arrow_size * 3
+    for angle in (a1, a2):
+        ex = vx + ext_len * math.cos(angle)
+        ey = vy + ext_len * math.sin(angle)
+        painter.drawLine(QPointF(vx, vy), QPointF(ex, ey))
+
+    # ── Arc ───────────────────────────────────────────────────────
+    arc_pen = QPen(color, style.line_offset * scale)
+    arc_pen.setCosmetic(True)
+    painter.setPen(arc_pen)
+    painter.setBrush(Qt.NoBrush)
+    arc_rect = QRectF(vx - r, vy - r, r * 2, r * 2)
+    painter.drawArc(arc_rect, int(-start_deg * 16), int(-span * 16))
+
+    # ── Text at arc midpoint ──────────────────────────────────────
+    mid_angle = math.radians(start_deg + span / 2)
+    label_x = vx + (r + style.text_height * 1.2) * math.cos(mid_angle)
+    label_y = vy + (r + style.text_height * 1.2) * math.sin(mid_angle)
+
+    font = QFont("Segoe UI", int(style.text_height * scale))
+    font.setBold(True)
+    metrics = QFontMetrics(font)
+    label = dim.label()
+    tw = metrics.horizontalAdvance(label)
+    th = metrics.height()
+    pad = 2.0 * scale
+
+    # Background
+    bg_rect = QRectF(label_x - tw / 2 - pad, label_y - th / 2 - pad,
+                     tw + 2 * pad, th + 2 * pad)
+    painter.fillRect(bg_rect, bg_color)
+
+    # Text
+    painter.setFont(font)
+    painter.setPen(QPen(color, 1.0))
+    painter.drawText(QPointF(label_x - tw / 2, label_y + th / 3), label)
+
+    # ── Vertex dot ────────────────────────────────────────────────
+    painter.setPen(Qt.NoPen)
+    painter.setBrush(QBrush(color))
+    painter.drawEllipse(QPointF(vx, vy), 1.5 * scale, 1.5 * scale)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Arc dimension rendering
+# ────────────────────────────────────────────────────────────────────
+
+def render_arc_dimension(
+    painter: QPainter,
+    dim,
+    *,
+    scale: float = 1.0,
+) -> None:
+    """Render an ArcDimension (from angular.py).
+
+    Tekla style:
+      - Arc drawn with solid line
+      - Radial reference lines (dashed) from center to arc endpoints
+      - Text (arc length) centered on the arc
+    """
+    style = dim.style
+    color = QColor(style.color)
+    bg_color = QColor("#0f172a")
+    cx, cy = dim.center
+    r = dim.radius
+
+    a1 = dim.start_angle
+    a2 = dim.end_angle
+    da = a2 - a1
+    if da > 180:
+        da -= 360
+    elif da < -180:
+        da += 360
+
+    # ── Radial reference lines (dashed) ───────────────────────────
+    ext_pen = QPen(QColor(style.extension_color), style.line_offset * scale)
+    ext_pen.setCosmetic(True)
+    ext_pen.setStyle(Qt.DashLine)
+    painter.setPen(ext_pen)
+    for angle_deg in (a1, a2):
+        angle_rad = math.radians(angle_deg)
+        inner = (cx + r * 0.15 * math.cos(angle_rad),
+                 cy + r * 0.15 * math.sin(angle_rad))
+        outer = (cx + (r + style.arrow_size * 2.5) * math.cos(angle_rad),
+                 cy + (r + style.arrow_size * 2.5) * math.sin(angle_rad))
+        painter.drawLine(QPointF(*inner), QPointF(*outer))
+
+    # ── Arc ───────────────────────────────────────────────────────
+    arc_pen = QPen(color, style.line_offset * scale * 1.5)
+    arc_pen.setCosmetic(True)
+    painter.setPen(arc_pen)
+    painter.setBrush(Qt.NoBrush)
+    arc_rect = QRectF(cx - r, cy - r, r * 2, r * 2)
+    painter.drawArc(arc_rect, int(-a1 * 16), int(-da * 16))
+
+    # ── Text at arc midpoint ──────────────────────────────────────
+    mid_angle = math.radians(a1 + da / 2)
+    label_x = cx + (r + style.text_height * 1.5) * math.cos(mid_angle)
+    label_y = cy + (r + style.text_height * 1.5) * math.sin(mid_angle)
+
+    font = QFont("Segoe UI", int(style.text_height * scale))
+    font.setBold(True)
+    metrics = QFontMetrics(font)
+    label = dim.label()
+    tw = metrics.horizontalAdvance(label)
+    th = metrics.height()
+    pad = 2.0 * scale
+
+    bg_rect = QRectF(label_x - tw / 2 - pad, label_y - th / 2 - pad,
+                     tw + 2 * pad, th + 2 * pad)
+    painter.fillRect(bg_rect, bg_color)
+
+    painter.setFont(font)
+    painter.setPen(QPen(color, 1.0))
+    painter.drawText(QPointF(label_x - tw / 2, label_y + th / 3), label)
