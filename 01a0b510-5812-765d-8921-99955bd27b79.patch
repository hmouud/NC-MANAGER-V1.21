+
+class TestUnfoldLayout(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QApplication.instance() or QApplication([])
+
+    def setUp(self):
+        self.w = DstvRenderer2D()
+        self.w.resize(900, 640)
+
+    def test_offsets_anchor_web_and_align_flanges(self):
+        part = DstvParser().parse_text(SAMPLE)
+        offsets, bounds = self.w._unfold_layout(part)
+        boxes = {c: self.w._face_box(part.get_face(c))
+                 for c in part.faces}
+        # v sits at the origin
+        self.assertAlmostEqual(offsets['v'][0], 0.0)
+        self.assertAlmostEqual(offsets['v'][1], 0.0)
+        # o/u x-aligned with the web so the end cuts line up
+        self.assertAlmostEqual(offsets['o'][0], 0.0)
+        self.assertAlmostEqual(offsets['u'][0], 0.0)
+        # an equal breathing gap separates each flange from the web (no gluing)
+        gap_above = offsets['o'][1] + boxes['o'][1] - boxes['v'][3]
+        gap_below = boxes['v'][1] - (offsets['u'][1] + boxes['u'][3])
+        self.assertGreater(gap_above, 0.0)
+        self.assertGreater(gap_below, 0.0)
+        self.assertAlmostEqual(gap_above, gap_below)
+        # h sits to the right of v, clear of the web's beam-length axis
+        self.assertGreater(offsets['h'][0], boxes['v'][2])
+        # scene bounds are exactly the envelope of all four plates
+        self.assertAlmostEqual(bounds[0],
+                               min(offsets[c][0] + boxes[c][0] for c in offsets))
+        self.assertAlmostEqual(bounds[2],
+                               max(offsets[c][0] + boxes[c][2] for c in offsets))
+        self.assertAlmostEqual(bounds[1],
+                               min(offsets[c][1] + boxes[c][1] for c in offsets))
+        self.assertAlmostEqual(bounds[3],
+                               max(offsets[c][1] + boxes[c][3] for c in offsets))
+
+    def test_coped_flanges_share_web_x_axis(self):
+        """A coped beam (web corner notch, D-61 style) must keep the flanges on
+        the web's X axis so their end cuts line up with the web's cope."""
+        part = DstvParser().parse_text(D61)
+        offsets, _ = self.w._unfold_layout(part)
+        boxes = {c: self.w._face_box(part.get_face(c))
+                 for c in part.faces}
+        # web notch boundary at x=45; o/u cuts at x=45 map to scene x=45
+        self.assertAlmostEqual(offsets['o'][0], 0.0)
+        self.assertAlmostEqual(offsets['u'][0], 0.0)
+        self.assertAlmostEqual(offsets['o'][0] + 45.0, 45.0)
+        self.assertAlmostEqual(offsets['u'][0] + 45.0, 45.0)
+        # no X mirror auto-detected for this direct-alignment case
+        self.assertFalse(offsets['o'][2])
+        self.assertFalse(offsets['u'][2])
+        # the flanges sit above/below the web across an equal breathing gap
+        gap_above = offsets['o'][1] + boxes['o'][1] - boxes['v'][3]
