+"""QPainter rendering engine for dimension annotations.
+
+Reads pure data types from :mod:`types` and paints them using QPainter.
+This is the ONLY module that imports Qt — types, geometry, style, and
+detector remain pure Python.
+
+Supports every dimension type: radius, diameter, angular, linear, leader,
+center mark, and bolt-circle annotation.
+
+Design goal: match professional CAD reference images — clean radius
+leaders with horizontal tails, no text background pills, minimal angular
+annotations showing only the bolt-circle spacing pattern.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Optional, Tuple
+
+from PySide6.QtCore import Qt, QPointF, QRectF
+from PySide6.QtGui import (QPainter, QPen, QBrush, QColor, QFont,
+                           QFontMetrics, QPainterPath, QPolygonF)
+
+from .types import (
+    Point2D, RadiusDimension, DiameterDimension, AngularDimension,
+    LinearDimension, LeaderDimension, CenterMark, BoltCirclePattern,
+    DimensionGroup, ArrowStyle, TextPlacement,
+)
+from .style import DimensionStyle, DEFAULT_STYLE
+from .geometry import (
+    arc_points, leader_endpoint, text_position_for_radius,
+    text_position_for_diameter, text_position_for_angular,
+    optimal_text_rotation, extension_line_endpoints,
+    nearest_angle_on_circle, angular_spacing,
+)
+
+
+class DimensionRenderer:
+    """Professional CAD dimension renderer using QPainter.
+
+    Draws clean engineering dimensions matching standard CAD conventions:
+
+    - **Radius leader**: center→edge line with arrow at edge, then a short
+      horizontal tail extending beyond the arrow with text (no background pill).
+    - **Diameter leader**: line through center to edge, arrow at edge, tail
+      with ``Ø`` prefix.
+    - **Angular**: arc between two lines with text at midpoint.
+    - **Bolt circle**: ONE radius leader + ONE angular spacing label + one
+      ``NxØd`` hole-count label — avoids cluttering every gap.
+    - **Center mark**: small cross + short extended dash lines past the circle
+      radius (not to full radius).
+
+    Usage::
+
+        renderer = DimensionRenderer(painter, style, to_screen)
+        renderer.draw_radius(dim)
+        renderer.draw_angular(dim)
+        renderer.draw_bolt_circle(pattern)
+    """
+
+    def __init__(self, painter: QPainter, style: DimensionStyle = None,
+                 to_screen=None):
+        self.p = painter
+        self.style = style or DEFAULT_STYLE
+        self._to_screen = to_screen or (lambda x, y: (x, y))
+
+    # ── Helpers ──────────────────────────────────────────────────
+
+    def _s(self, pt: Point2D) -> QPointF:
+        """Convert data point to screen QPointF."""
+        sx, sy = self._to_screen(pt.x, pt.y)
+        return QPointF(sx, sy)
+
+    def _sxy(self, pt: Point2D) -> Tuple[float, float]:
+        return self._to_screen(pt.x, pt.y)
+
+    def _pen(self, color: str = None, width: float = None,
+             dash: str = None) -> QPen:
+        c = QColor(color or self.style.dim_line_color)
+        w = width or self.style.dim_line_width
+        pen = QPen(c, w)
+        if dash == 'dash':
+            pen.setStyle(Qt.DashLine)
+        elif dash == 'dot':
+            pen.setStyle(Qt.DotLine)
+        elif dash == 'dashdot':
+            pen.setStyle(Qt.DashDotLine)
+        return pen
+
+    def _font(self, size: float = None) -> QFont:
+        f = QFont(self.style.text_font)
+        f.setPixelSize(int(size or self.style.text_height))
+        return f
+
+    # ── Arrow drawing ────────────────────────────────────────────
+
+    def _draw_arrow(self, tip: QPointF, direction_angle: float,
+                    size: float = None, style: ArrowStyle = None):
+        """Draw an arrowhead at ``tip`` pointing in ``direction_angle``."""
+        s = size or self.style.arrow_size
+        st = style or self.style.arrow_style
+        ang = math.radians(direction_angle)
+
+        if st == ArrowStyle.TICK:
+            perp = ang + math.pi / 2.0
+            dx = s * 0.6 * math.cos(perp)
+            dy = s * 0.6 * math.sin(perp)
+            self.p.drawLine(
+                QPointF(tip.x() - dx, tip.y() - dy),
+                QPointF(tip.x() + dx, tip.y() + dy))
+            return
+
+        if st == ArrowStyle.DOT:
+            r = s * 0.3
+            self.p.setBrush(QBrush(QColor(self.style.arrow_fill)))
+            self.p.drawEllipse(tip, r, r)
+            self.p.setBrush(Qt.NoBrush)
+            return
+
+        # Triangle arrowhead (FILLED or OPEN)
+        cos_a = math.cos(ang)
+        sin_a = math.sin(ang)
+        base_x = tip.x() - s * cos_a
+        base_y = tip.y() - s * sin_a
+        splay = s * 0.22
+        perp_x = -sin_a * splay
+        perp_y = cos_a * splay
+
+        tri = QPolygonF([
+            tip,
+            QPointF(base_x + perp_x, base_y + perp_y),
+            QPointF(base_x - perp_x, base_y - perp_y),
+        ])
+
+        if st == ArrowStyle.FILLED:
+            self.p.setBrush(QBrush(QColor(self.style.arrow_fill)))
+            self.p.setPen(QPen(QColor(self.style.arrow_color), 0.3))
+            self.p.drawPolygon(tri)
+            self.p.setBrush(Qt.NoBrush)
+        else:
+            self.p.drawLine(QPointF(tip.x(), tip.y()),
+                           QPointF(base_x + perp_x, base_y + perp_y))
+            self.p.drawLine(QPointF(tip.x(), tip.y()),
+                           QPointF(base_x - perp_x, base_y - perp_y))
+
+    # ── Text helpers ─────────────────────────────────────────────
+
+    def _draw_text_plain(self, pos: QPointF, text: str, font: QFont = None,
+                         color: str = None):
+        """Draw plain text without a background pill (clean CAD style)."""
+        f = font or self._font()
+        self.p.setFont(f)
+        self.p.setPen(QColor(color or self.style.text_color))
+        self.p.drawText(pos, text)
+
+    # ── Radius dimension ─────────────────────────────────────────
+
+    def draw_radius(self, dim: RadiusDimension):
+        """Draw R xxx leader: line center→edge, arrow at edge, horizontal
+        tail extending beyond arrow with text label.
+
+        Matches the clean professional CAD reference: no dashed extension,
+        no background pill — just a solid leader with a short horizontal tail.
+        """
+        s = self.style
+        self.p.setPen(self._pen(s.dim_line_color, s.dim_line_width))
+        self.p.setBrush(Qt.NoBrush)
+
+        center_s = self._s(dim.center)
+        edge_s = self._s(dim.point_on_circle)
+
+        # 1. Solid line from center to the circle edge
+        self.p.drawLine(center_s, edge_s)
+
+        # 2. Arrow at the edge, pointing inward along the leader line
+        angle = dim.center.angle_to(dim.point_on_circle)
+        self._draw_arrow(edge_s, angle + 180.0)
+
+        # 3. Short horizontal tail extending beyond the arrow
+        #    The tail goes in the general outward direction of the leader
+        #    but snaps to horizontal for clean text readability.
+        dir_angle = math.radians(angle)
+        tail_len = s.leader_tail_length
+        # Tail endpoint: beyond the edge, displaced horizontally
+        tx = dim.point_on_circle.x + tail_len * math.cos(dir_angle)
+        ty = dim.point_on_circle.y + tail_len * math.sin(dir_angle)
+        tail_end = Point2D(tx, ty)
+        tail_end_s = self._s(tail_end)
+
+        # Draw the tail (solid line extending from edge)
+        self.p.drawLine(edge_s, tail_end_s)
+
+        # 4. Text label at the tail end (plain, no background pill)
+        text_s = QPointF(tail_end_s.x() + 3, tail_end_s.y())
+        self._draw_text_plain(text_s, dim.text)
+
+    # ── Diameter dimension ───────────────────────────────────────
+
+    def draw_diameter(self, dim: DiameterDimension):
+        """Draw Ø xxx leader: line through center, arrow at edge, tail with
+        text label.  Same clean style as radius."""
+        s = self.style
+        self.p.setPen(self._pen(s.dim_line_color, s.dim_line_width))
+        self.p.setBrush(Qt.NoBrush)
+
+        center_s = self._s(dim.center)
+        edge_s = self._s(dim.point_on_circle)
+
+        # Line through center to opposite side
+        opp = Point2D(
+            2 * dim.center.x - dim.point_on_circle.x,
+            2 * dim.center.y - dim.point_on_circle.y,
+        )
+        opp_s = self._s(opp)
+
+        # Full diameter line: opposite → edge (passing through center)
+        self.p.drawLine(opp_s, edge_s)
+
+        # Arrow at the edge (pointing inward)
+        angle = dim.center.angle_to(dim.point_on_circle)
+        self._draw_arrow(edge_s, angle + 180.0)
+
+        # Small arrow at opposite side (pointing outward)
+        self._draw_arrow(opp_s, angle)
+
+        # Horizontal tail beyond the edge arrow
+        dir_angle = math.radians(angle)
+        tail_len = s.leader_tail_length
+        tx = dim.point_on_circle.x + tail_len * math.cos(dir_angle)
+        ty = dim.point_on_circle.y + tail_len * math.sin(dir_angle)
+        tail_end = Point2D(tx, ty)
+        tail_end_s = self._s(tail_end)
+        self.p.drawLine(edge_s, tail_end_s)
+
+        # Text at tail end (no background pill)
+        text_s = QPointF(tail_end_s.x() + 3, tail_end_s.y())
+        self._draw_text_plain(text_s, dim.text)
+
+    # ── Angular dimension ────────────────────────────────────────
+
+    def draw_angular(self, dim: AngularDimension):
+        """Draw angle arc between two lines with text at midpoint.
+
+        Clean style: arc + text, no background pill.
+        """
+        s = self.style
+        self.p.setPen(self._pen(s.dim_line_color, s.dim_line_width))
+        self.p.setBrush(Qt.NoBrush)
+
+        # Determine arc radius
+        r = dim.dim_arc_radius
+        if r < 1.0:
+            d1 = dim.vertex.distance_to(dim.line1_end)
+            d2 = dim.vertex.distance_to(dim.line2_end)
+            r = min(d1, d2) * 0.7 + 10.0
+
+        # Generate arc points
+        a1 = dim.line1_angle
+        a2 = dim.line2_angle
+
+        # Determine sweep direction (always draw the smaller arc)
+        sweep = a2 - a1
+        if sweep < 0:
+            sweep += 360.0
+        if sweep > 180.0:
+            a1, a2 = a2, a1
+            sweep = 360.0 - sweep
+
+        arc_pts = arc_points(dim.vertex, r, a1, a1 + sweep, 32)
+
+        # Draw the arc
+        path = QPainterPath()
+        if arc_pts:
+            path.moveTo(self._s(arc_pts[0]))
+            for pt in arc_pts[1:]:
+                path.lineTo(self._s(pt))
+        self.p.drawPath(path)
+
+        # Small extension lines from vertex toward the arc
+        for angle_deg in [a1, a1 + sweep]:
+            rad = math.radians(angle_deg)
+            ext_start = Point2D(
+                dim.vertex.x + 5.0 * math.cos(rad),
+                dim.vertex.y + 5.0 * math.sin(rad),
+            )
+            ext_end = Point2D(
+                dim.vertex.x + (r + 3.0) * math.cos(rad),
+                dim.vertex.y + (r + 3.0) * math.sin(rad),
+            )
+            self.p.setPen(self._pen(s.ext_line_color, s.ext_line_width))
+            self.p.drawLine(self._s(ext_start), self._s(ext_end))
+
+        # Text at midpoint of arc (no background pill)
+        mid_angle = a1 + sweep / 2.0
+        text_pt = Point2D(
+            dim.vertex.x + (r + s.text_gap + 4.0) * math.cos(math.radians(mid_angle)),
+            dim.vertex.y + (r + s.text_gap + 4.0) * math.sin(math.radians(mid_angle)),
+        )
+        text_s = self._s(text_pt)
+        self._draw_text_plain(text_s, dim.text)
+
+    # ── Linear dimension ─────────────────────────────────────────
+
+    def draw_linear(self, dim: LinearDimension):
+        """Draw linear distance between two points with extension lines."""
+        s = self.style
+        self.p.setPen(self._pen(s.dim_line_color, s.dim_line_width))
+        self.p.setBrush(Qt.NoBrush)
+
+        dx = dim.point2.x - dim.point1.x
+        dy = dim.point2.y - dim.point1.y
+        length = math.hypot(dx, dy)
+        if length < 1e-12:
+            return
+        perp_x = -dy / length * dim.offset
+        perp_y = dx / length * dim.offset
+
+        p1o = Point2D(dim.point1.x + perp_x, dim.point1.y + perp_y)
+        p2o = Point2D(dim.point2.x + perp_x, dim.point2.y + perp_y)
+
+        # Dimension line
+        self.p.drawLine(self._s(p1o), self._s(p2o))
+
+        # Arrows at both ends
+        ang1 = p1o.angle_to(p2o)
+        ang2 = p2o.angle_to(p1o)
+        self._draw_arrow(self._s(p1o), ang1)
+        self._draw_arrow(self._s(p2o), ang2)
+
+        # Extension lines
+        self.p.setPen(self._pen(s.ext_line_color, s.ext_line_width))
+        self.p.drawLine(self._s(dim.point1), self._s(p1o))
+        self.p.drawLine(self._s(dim.point2), self._s(p2o))
+
+        # Text at midpoint (no background pill)
+        mid = p1o.lerp(p2o, 0.5)
+        text_s = self._s(mid)
+        self._draw_text_plain(text_s, dim.text)
+
+    # ── Leader dimension ─────────────────────────────────────────
+
+    def draw_leader(self, dim: LeaderDimension):
+        """Draw arrow + text note."""
+        s = self.style
+        self.p.setPen(self._pen(s.leader_color, s.leader_width))
+        self.p.setBrush(Qt.NoBrush)
+
+        start_s = self._s(dim.start)
+        tail_s = self._s(dim.tail)
+
+        self.p.drawLine(start_s, tail_s)
+
+        ang = dim.tail.angle_to(dim.start)
+        self._draw_arrow(start_s, ang, s.leader_arrow_size)
+
+        text_s = self._s(dim.tail)
+        self._draw_text_plain(text_s, dim.text)
+
+    # ── Center mark ──────────────────────────────────────────────
+
+    def draw_center_mark(self, cm: CenterMark):
+        """Draw center cross + short extended dash lines.
+
+        Matches the reference images: a small cross at the centre with
+        dashed lines extending slightly past the circle radius — not all
+        the way to the edge.
+        """
+        s = self.style
+        self.p.setPen(self._pen(s.center_mark_color, s.center_mark_width,
+                                'dashdot'))
+        self.p.setBrush(Qt.NoBrush)
+
+        c = cm.center
+        sz = cm.mark_size
+
+        # Small cross at centre
+        self.p.drawLine(self._s(c.offset(-sz, 0)), self._s(c.offset(sz, 0)))
+        self.p.drawLine(self._s(c.offset(0, -sz)), self._s(c.offset(0, sz)))
+
+        # Extended dash lines past the circle (20% beyond radius for visibility)
+        if cm.extended and cm.radius > sz:
+            ext = cm.radius * 1.15  # extend 15% past the circle edge
+            gap = sz  # gap between cross end and dash start
+            self.p.drawLine(self._s(c.offset(-ext, 0)),
+                          self._s(c.offset(-gap, 0)))
+            self.p.drawLine(self._s(c.offset(gap, 0)),
+                          self._s(c.offset(ext, 0)))
+            self.p.drawLine(self._s(c.offset(0, -ext)),
+                          self._s(c.offset(0, -gap)))
+            self.p.drawLine(self._s(c.offset(0, gap)),
+                          self._s(c.offset(0, ext)))
+
+    def _draw_center_mark_simple(self, center: Point2D):
+        """Quick small center cross (used inside radius/diameter dims)."""
+        s = self.style
+        self.p.setPen(self._pen(s.center_mark_color, 0.4))
+        sz = s.center_mark_size * 0.6
+        self.p.drawLine(self._s(center.offset(-sz, 0)),
+                       self._s(center.offset(sz, 0)))
+        self.p.drawLine(self._s(center.offset(0, -sz)),
+                       self._s(center.offset(0, sz)))
+
+    # ── Bolt circle annotation ───────────────────────────────────
+
+    def draw_bolt_circle(self, bc: BoltCirclePattern):
+        """Full bolt circle annotation — clean, minimal.
+
+        Draws:
+        1. Center mark (extended)
+        2. ONE radius leader to the bolt circle
+        3. ONE angular spacing label showing the uniform angle
+        4. ONE ``NxØd`` label showing hole count and diameter
+
+        This avoids the clutter of drawing angular dimensions between
+        every consecutive pair of holes (which the old code did).
+        """
+        s = self.style
+
+        # 1. Center mark (extended)
+        cm = CenterMark(
+            center=bc.center,
+            mark_size=s.center_mark_size,
+            extended=True,
+            radius=bc.bolt_radius,
+        )
+        self.draw_center_mark(cm)
+
+        # 2. Radius leader to the bolt circle (first hole position as direction)
+        if bc.hole_positions:
+            ref_pt = bc.hole_positions[0]
+        else:
+            ref_pt = Point2D(bc.center.x + bc.bolt_radius, bc.center.y)
+
+        rd = RadiusDimension(
+            center=bc.center,
+            point_on_circle=ref_pt,
+            radius=bc.bolt_radius,
+            label=f'R {bc.bolt_radius:.1f}',
+        )
+        self.draw_radius(rd)
+
+        # 3. ONE angular spacing label (the uniform angle)
+        if bc.hole_count >= 3:
+            uniform_angle = 360.0 / bc.hole_count
+            # Place the angular dimension between the first two holes
+            angles = angular_spacing(bc.hole_positions, bc.center)
+            if len(angles) >= 2:
+                a1 = angles[0]
+                a2 = angles[1]
+                # Handle wrap-around
+                sweep = a2 - a1
+                if sweep < 0:
+                    sweep += 360.0
+
+                rad1 = math.radians(a1)
+                rad2 = math.radians(a2)
+                arm_len = bc.bolt_radius * 0.5
+                line1_end = Point2D(
+                    bc.center.x + arm_len * math.cos(rad1),
+                    bc.center.y + arm_len * math.sin(rad1),
+                )
+                line2_end = Point2D(
+                    bc.center.x + arm_len * math.cos(rad2),
+                    bc.center.y + arm_len * math.sin(rad2),
+                )
+
+                ad = AngularDimension(
+                    vertex=bc.center,
+                    line1_end=line1_end,
+                    line2_end=line2_end,
+                    dim_arc_radius=bc.bolt_radius * 0.28,
+                    label=f'{uniform_angle:.0f}\u00b0',
+                )
+                self.draw_angular(ad)
+
+        # 4. One NxØd label near the first hole (replaces N individual labels)
+        if bc.hole_positions and bc.hole_diameter > 0:
+            label_pos = Point2D(
+                bc.hole_positions[0].x,
+                bc.hole_positions[0].y + bc.hole_diameter / 2.0 + 6.0,
+            )
+            label = f'{bc.hole_count}x\u00d8{bc.hole_diameter:.0f}'
+            self._draw_text_plain(self._s(label_pos), label)
+
+    # ── Batch drawing ────────────────────────────────────────────
+
+    def draw_group(self, group: DimensionGroup):
+        """Draw all dimensions in a group."""
+        for rd in group.radii:
+            self.draw_radius(rd)
+        for dd in group.diameters:
+            self.draw_diameter(dd)
+        for ad in group.angulars:
+            self.draw_angular(ad)
+        for ld in group.linears:
+            self.draw_linear(ld)
+        for lr in group.leaders:
+            self.draw_leader(lr)
+        for cm in group.center_marks:
+            self.draw_center_mark(cm)
+        for bc in group.bolt_circles:
+            self.draw_bolt_circle(bc)
