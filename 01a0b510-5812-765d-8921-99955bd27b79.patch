+
+    def add_hole(self, face: str, kind: str, x: float, y: float,
+                 diameter: float, length: float = 0.0, angle: float = 0.0) -> None:
+        """Add a hole/slot row to the table (backward compatibility)."""
+        row = self.holes_table.rowCount()
+        self.holes_table.insertRow(row)
+        self.holes_table.setItem(row, 0, QTableWidgetItem(str(face).upper()))
+        self.holes_table.setItem(row, 1, QTableWidgetItem("Slot" if length > 0 or kind == 'slot' else "Hole"))
+        self.holes_table.setItem(row, 2, QTableWidgetItem(f"{x:.1f}"))
+        self.holes_table.setItem(row, 3, QTableWidgetItem(f"{y:.1f}"))
+        self.holes_table.setItem(row, 4, QTableWidgetItem(f"{diameter:.1f}"))
+        self.holes_table.setItem(row, 5, QTableWidgetItem(f"{length:.1f}" if length > 0 else "—"))
+        self.holes_table.setItem(row, 6, QTableWidgetItem(f"{angle:.0f}°" if (length > 0 and angle != 0) else "—"))
+
+    def add_slot(self, face: str, kind: str, x: float, y: float,
