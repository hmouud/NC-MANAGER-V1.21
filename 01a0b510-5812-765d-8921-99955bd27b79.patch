diff --git a/src/nccorrection/ui/dialogs/create_part/dialog.py b/src/nccorrection/ui/dialogs/create_part/dialog.py
new file mode 100644
index 0000000..4b79f69
--- /dev/null
+++ b/src/nccorrection/ui/dialogs/create_part/dialog.py
@@ -0,0 +1,321 @@
+"""Create Part Dialog — orchestrator composing toolbar, tabs, and canvas."""
+
+from PySide6.QtWidgets import (
+    QDialog, QVBoxLayout, QHBoxLayout, QSplitter, QWidget, QPushButton,
+)
+from PySide6.QtCore import Qt, Signal
+
+from nccorrection.ui.components.modern_button import AnimatedButton
+from nccorrection.ui.components.interactive_canvas import (
+    LiveUnfoldedCanvas, build_unfolded_geometry,
+)
+from nccorrection.ui.components.cotation_bar import SlidingCotationBar
+from nccorrection.ui.dialogs.create_part.profile_library import ProfileLibraryDialog
+from nccorrection.ui.dialogs.create_part.settings_tab import SettingsTab
+from nccorrection.ui.dialogs.create_part.processes_tab import ProcessesTab
+from nccorrection.ui._colors import C
+from nccorrection.ui.translations import t as tr
+
+
+_DIALOG_STYLE = f"""
+    QDialog {{ background-color: {C.bg}; }}
+    QLabel {{ color: {C.mut}; font-weight: bold; }}
+    QTabWidget::pane {{ border: 1px solid {C.line}; background: {C.panel}; }}
+    QTabBar::tab {{ background: {C.bg}; color: {C.mut}; padding: 8px 20px;
+                   border: 1px solid {C.line}; }}
+    QTabBar::tab:selected {{ background: {C.accent}; color: {C.txt}; }}
+    QLineEdit, QSpinBox, QDoubleSpinBox {{
+        background-color: {C.panel}; color: {C.txt};
+        border: 1px solid {C.line}; padding: 4px; border-radius: 2px; }}
+    QTableWidget {{ background-color: {C.panel}; color: {C.txt};
+                   gridline-color: {C.line}; border: none; }}
+    QHeaderView::section {{ background-color: {C.bg}; color: {C.mut};
+                           padding: 4px; border: 1px solid {C.line}; }}
+    QComboBox {{ background-color: {C.panel}; color: {C.txt};
+                border: 1px solid {C.line}; padding: 4px; border-radius: 2px; }}
+    QComboBox::drop-down {{ border: none; }}
+    QComboBox QAbstractItemView {{ background-color: {C.panel}; color: {C.txt};
+                                  selection-background-color: {C.accent}; }}
+    QSplitter::handle {{ background-color: {C.line}; width: 3px; }}
+"""
+
+_TOOLBAR_BTN = (
+    f"QPushButton {{ background: transparent; border: 1px solid {C.line}; "
+    f"color: {C.mut}; padding: 4px 12px; border-radius: 4px; }}"
+    f"QPushButton:hover {{ background-color: {C.line}; color: {C.txt}; }}"
+)
+
+
+class CreatePartDialog(QDialog):
+    """NC Manager — Profile Creator dialog.
+
+    Layout:
+        ┌─────────────┬──────────────────────────┐
+        │  Left panel  │  Toolbar (Measure/...)   │
+        │  ┌─────────┐ │  ┌──────────────────────┐│
+        │  │Settings │ │  │                      ││
+        │  │---------│ │  │   LiveUnfoldedCanvas  ││
+        │  │Processes│ │  │                      ││
+        │  └─────────┘ │  └──────────────────────┘│
+        │              │  SlidingCotationBar       │
+        ├──────────────┴──────────────────────────┤
+        │           [Cancel]  [Create Part]        │
+        └─────────────────────────────────────────┘
+    """
+
+    part_created = Signal(dict)
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._lang = 'en'
+        self.setWindowTitle(tr('cp_title', self._lang))
+        self.setMinimumSize(1100, 700)
+        self.resize(1300, 800)
+        self.setStyleSheet(_DIALOG_STYLE)
+
+        self._current_profile = None
+
+        self._build_layout()
+        self._wire_signals()
+
+        # Auto-load default profile so canvas is never empty
+        self.settings_tab.length_spin.setValue(6000)
+        self._on_profile_changed()
+
+    # ------------------------------------------------------------------
+    # Layout
+    # ------------------------------------------------------------------
+
+    def _build_layout(self):
+        root = QVBoxLayout(self)
+        root.setContentsMargins(4, 4, 4, 4)
+
+        # Cotation toggle (used inside settings_tab)
+        self._cot_toggle_btn = QPushButton("\U0001f4d0")
+        self._cot_toggle_btn.setFixedSize(28, 28)
+        self._cot_toggle_btn.setToolTip(tr('cp_toggle_cotation', self._lang))
+        self._cot_toggle_btn.setStyleSheet(
+            f"QPushButton {{ background: transparent; color: {C.mut}; "
+            f"border: 1px solid {C.line}; border-radius: 3px; font-size: 14px; }}"
+            f"QPushButton:hover {{ background-color: {C.line}; color: {C.txt}; }}"
+        )
+
+        # Splitter: left (tabs) | right (toolbar + canvas + cotation)
+        splitter = QSplitter(Qt.Horizontal)
+        splitter.setOpaqueResize(True)
+        splitter.setHandleWidth(3)
+
+        # ── Left: tabs ───────────────────────────────────────────
+        left = QWidget()
+        left_lay = QVBoxLayout(left)
+        left_lay.setContentsMargins(0, 0, 0, 0)
+
+        from PySide6.QtWidgets import QTabWidget
+        tabs = QTabWidget()
+        self.settings_tab = SettingsTab(self._cot_toggle_btn, lang_getter=lambda: self._lang)
+        self.processes_tab = ProcessesTab(lang_getter=lambda: self._lang)
+        tabs.addTab(self.settings_tab, tr('cp_settings', self._lang))
+        tabs.addTab(self.processes_tab, tr('cp_processes', self._lang))
+        left_lay.addWidget(tabs)
+        splitter.addWidget(left)
+
+        # ── Right: toolbar + canvas + cotation bar ───────────────
+        right = QWidget()
+        right_lay = QVBoxLayout(right)
+        right_lay.setContentsMargins(0, 0, 0, 0)
+        right_lay.setSpacing(2)
+
+        # Toolbar
+        toolbar = QHBoxLayout()
+        toolbar.setContentsMargins(4, 2, 4, 2)
+        toolbar.setSpacing(4)
+        self.btn_measure = QPushButton(tr('cp_measure', self._lang))
+        self.btn_measure.setStyleSheet(_TOOLBAR_BTN)
+        self.btn_cotation = QPushButton(tr('cp_cotation_btn', self._lang))
+        self.btn_cotation.setStyleSheet(_TOOLBAR_BTN)
+        toolbar.addWidget(self.btn_measure)
+        toolbar.addWidget(self.btn_cotation)
+        toolbar.addStretch()
+        right_lay.addLayout(toolbar)
+
+        # Canvas + cotation bar
+        self._canvas = LiveUnfoldedCanvas()
+        self._cotation_bar = SlidingCotationBar()
+        right_lay.addWidget(self._canvas, 1)
+        right_lay.addWidget(self._cotation_bar, 0)
+        splitter.addWidget(right)
+
+        splitter.setSizes([400, 700])
+        root.addWidget(splitter, 1)
+
+        # Bottom buttons
+        btn_row = QHBoxLayout()
+        btn_row.addStretch()
+        self.btn_cancel = AnimatedButton(tr('cp_cancel', self._lang), variant="ghost")
+        self.btn_create = AnimatedButton(tr('cp_create', self._lang), variant="success")
+        btn_row.addWidget(self.btn_cancel)
+        btn_row.addWidget(self.btn_create)
+        root.addLayout(btn_row)
+
+    # ------------------------------------------------------------------
+    # Wiring
+    # ------------------------------------------------------------------
+
+    def _wire_signals(self):
+        # Close
+        self.btn_cancel.clicked.connect(self.reject)
+        self.btn_create.clicked.connect(self._on_create)
+
+        # Toolbar
+        self.btn_cotation.clicked.connect(self._cotation_bar.toggle)
+
+        # Cotation bar ↔ canvas
+        self._cotation_bar.cotation_toggled.connect(self._canvas.toggle_cotation)
+        self._cotation_bar.cotation_params_changed.connect(
+            lambda e, ga: self._canvas.set_cotation_params(e, ga))
+        self._cot_toggle_btn.clicked.connect(self._cotation_bar.toggle)
+
+        # Canvas → table (right-click add hole)
+        self._canvas.add_hole_requested.connect(self._on_canvas_add_hole)
+
+        # Settings → canvas
+        self.settings_tab.profile_changed.connect(self._on_profile_changed)
+        self.settings_tab.canvas_update_requested.connect(self._update_canvas)
+
+        # Table → canvas
+        self.processes_tab.canvas_sync_needed.connect(self._sync_holes_to_canvas)
+
+    # ------------------------------------------------------------------
+    # Profile ↔ Canvas
+    # ------------------------------------------------------------------
+
+    def _open_profile_library(self):
+        dlg = ProfileLibraryDialog(self, lang_getter=lambda: self._lang)
+        if dlg.exec() == QDialog.Accepted and dlg.selected_name():
+            self.settings_tab.btn_profile.setText(f"{dlg.selected_name()} \u25bc")
+            self._on_profile_changed()
+
+    def _on_profile_changed(self):
+        import nccorrection.engine.steel_engine.catalog as _cat
+        name = self.settings_tab.btn_profile.text().replace(" \u25bc", "").strip()
+        self._current_profile = _cat.get_profile(name)
+        self._update_canvas()
+
+    def _update_canvas(self):
+        prof = self._current_profile
+        length = self.settings_tab.length_spin.value()
+        if length <= 0:
+            length = 1000.0
+
+        # Read cut angles from settings
+        asf = self.settings_tab.angle_steg_front.value()
+        asr = self.settings_tab.angle_steg_rear.value()
+        aff = self.settings_tab.angle_flange_front.value()
+        afr = self.settings_tab.angle_flange_rear.value()
+
+        if prof and prof.kind in ('I', 'U', 'L', 'B', 'T', 'O'):
+            faces = build_unfolded_geometry(
+                profile_kind=prof.kind, length=length,
+                depth=prof.depth, width=prof.width,
+                web_thick=prof.web_thick, flange_thick=prof.flange_thick,
+                angle_steg_front=asf, angle_steg_rear=asr,
+                angle_flange_front=aff, angle_flange_rear=afr,
+            )
+        else:
+            faces = build_unfolded_geometry(
+                profile_kind='B', length=length,
+                depth=2500.0, width=1250.0,
+                web_thick=10.0, flange_thick=10.0,
+            )
+        self._canvas.set_faces(faces)
+        self._sync_holes_to_canvas()
+
+    def _sync_holes_to_canvas(self):
+        self._canvas.set_holes(self.processes_tab.get_active_holes())
+
+    def _on_canvas_add_hole(self, x: float, y: float, face: str):
+        rev = {'v': 'Web', 'o': 'Flange', 'u': 'Both', 'h': 'Web'}
+        self.processes_tab.add_row('Hole', prefill={
+            'x': x, 'y': y, 'd': 12.0, 'face': rev.get(face, 'Web'),
+        })
+
+    # ------------------------------------------------------------------
+    # Data extraction
+    # ------------------------------------------------------------------
+
+    def get_part_data(self) -> dict:
+        s = self.settings_tab
+        return {
+            'order_name': s.order_edit.text(),
+            'profile_type': s.btn_profile.text().replace(' \u25bc', ''),
+            'length': s.length_spin.value(),
+            'qt_need': s.qty_spin.value(),
+            'orientation': s.orientation_spin.value(),
+            'angle_steg_front': s.angle_steg_front.value(),
+            'angle_steg_rear': s.angle_steg_rear.value(),
+            'angle_flange_front': s.angle_flange_front.value(),
+            'angle_flange_rear': s.angle_flange_rear.value(),
+            'steel_type': s.btn_steel.text().replace(' \u25bc', ''),
+            'processes': self.processes_tab.get_active_processes(),
+        }
+
+    def _on_create(self):
+        import nccorrection.engine.steel_engine.catalog as _cat
+        from nccorrection.engine.profile_catalog.nc1_writer import (
+            generate_beam_nc1, Hole,
+        )
+        data = self.get_part_data()
+        prof = _cat.get_profile(data['profile_type'])
+        if prof is None:
+            return
+
+        holes = [
+            Hole(face={'Web': 'v', 'Flange': 'o', 'Both': 'u'}.get(p['plane'], 'v'),
+                 x=p['x'], y=p['y'], diameter=p['d'])
+            for p in data['processes']
+        ]
+
+        data['nc1_text'] = generate_beam_nc1(
+            prof, data['length'],
+            order=data['order_name'],
+            steel_grade=data['steel_type'],
+            quantity=data['qt_need'] or 1,
+            angle_steg_front=data['angle_steg_front'],
+            angle_steg_rear=data['angle_steg_rear'],
+            angle_flange_front=data['angle_flange_front'],
+            angle_flange_rear=data['angle_flange_rear'],
+            holes=holes or None,
+        )
+        self.part_created.emit(data)
+        self.accept()
+
+    # ------------------------------------------------------------------
+    # Load existing data (edit / double-click)
+    # ------------------------------------------------------------------
+
+    def load_part_data(self, record):
+        s = self.settings_tab
+        s.order_edit.setText(record.get('order', ''))
+        profile = record.get('profile', '')
+        if profile:
+            s.btn_profile.setText(f"{profile} \u25bc")
+        steel = record.get('quality', '') or record.get('steel', '')
+        if steel:
+            s.btn_steel.setText(f"{steel} \u25bc")
+        try:
+            length = float(record.get('length_mm', 0) or 0)
+            if length > 0:
+                s.length_spin.setValue(length)
+        except (TypeError, ValueError):
+            pass
+        self.processes_tab.clear_and_load(record.get('holes', []))
+        self._on_profile_changed()
+
+    def load_geometry_data(self, geometry):
+        if 'length' in geometry:
+            try:
+                self.settings_tab.length_spin.setValue(float(geometry['length']))
+            except (TypeError, ValueError):
+                pass
+        self.processes_tab.clear_and_load(geometry.get('holes', []), kind_key='kind')
+        self._update_canvas()
diff --git a/src/nccorrection/ui/dialogs/create_part/processes_tab.py b/src/nccorrection/ui/dialogs/create_part/processes_tab.py
new file mode 100644
index 0000000..0708547
--- /dev/null
+++ b/src/nccorrection/ui/dialogs/create_part/processes_tab.py
@@ -0,0 +1,274 @@
+"""Processes Tab — holes / slots table with context menu."""
+
+from PySide6.QtWidgets import (
+    QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton,
+    QTableWidget, QTableWidgetItem, QMenu, QComboBox,
+    QHeaderView, QCheckBox, QAbstractItemView,
+)
+from PySide6.QtCore import Qt, Signal
+from PySide6.QtGui import QColor
+
+from nccorrection.ui._colors import C
+from nccorrection.ui.translations import t as tr
+
+
+# face ↔ plane label mapping (shared with dialog)
+FACE_TO_PLANE = {'v': 'Web', 'u': 'Flange', 'o': 'Both',
+                 'Web': 'Web', 'Flange': 'Flange', 'Both': 'Both'}
+PLANE_TO_FACE = {'Web': 'v', 'Flange': 'o', 'Both': 'u'}
+
+
+class ProcessesTab(QWidget):
+    """Processes panel: add/remove/convert holes and slots on the part."""
+
+    row_changed = Signal()   # fires when any row data changes
+    canvas_sync_needed = Signal()
+
+    def __init__(self, parent=None, lang_getter=None):
+        super().__init__(parent)
+        self._lang_getter = lang_getter or (lambda: 'en')
+        self._build_ui()
+
+    # ------------------------------------------------------------------
+    # UI
+    # ------------------------------------------------------------------
+
+    def _build_ui(self):
+        layout = QVBoxLayout(self)
+
+        # Top bar
+        top_bar = QHBoxLayout()
+        title = QLabel(tr('cp_process_list', self._lang_getter()))
+        self.btn_add = QPushButton("+")
+        self.btn_add.setFixedSize(28, 28)
+        self.btn_add.setStyleSheet(
+            f"background-color: {C.accent}; color: white; font-weight: bold; "
+            "font-size: 16px; border-radius: 14px;"
+        )
+        add_menu = QMenu(self.btn_add)
+        add_menu.setStyleSheet(
+            f"QMenu {{ background-color: {C.panel}; color: white; }} "
+            f"QMenu::item:selected {{ background-color: {C.accent}; }}"
+        )
+        add_menu.addAction(tr('cp_add_hole', self._lang_getter())).triggered.connect(
+            lambda: self.add_row("Hole"))
+        add_menu.addAction(tr('cp_add_slot', self._lang_getter())).triggered.connect(
+            lambda: self.add_row("Slot"))
+        self.btn_add.setMenu(add_menu)
+
+        top_bar.addWidget(title)
+        top_bar.addStretch()
+        top_bar.addWidget(self.btn_add)
+        layout.addLayout(top_bar)
+
+        # Table
+        self.table = QTableWidget(0, 10)
+        self.table.setHorizontalHeaderLabels(
+            ["#", "!", "X", "X Mode", "Y", "Plane", "Process", "D", "Depth", "Angle"])
+        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
+        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeToContents)
+        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeToContents)
+        self.table.setSelectionBehavior(QAbstractItemView.SelectRows)
+        self.table.setSelectionMode(QAbstractItemView.SingleSelection)
+        self.table.setContextMenuPolicy(Qt.CustomContextMenu)
+        self.table.customContextMenuRequested.connect(self._context_menu)
+        layout.addWidget(self.table)
+
+        # Status
+        self.status_lbl = QLabel(tr('cp_status', self._lang_getter()).format(active=0, total=0))
+        self.status_lbl.setStyleSheet(f"color: {C.mut}; font-size: 11px;")
+        layout.addWidget(self.status_lbl)
+
+    # ------------------------------------------------------------------
+    # Public API
+    # ------------------------------------------------------------------
+
+    def add_row(self, proc_type: str, prefill: dict | None = None):
+        """Insert a new process row. ``prefill`` optional keys: x, y, d, face, angle, depth."""
+        pf = prefill or {}
+        row = self.table.rowCount()
+        self.table.insertRow(row)
+
+        # 0: row number
+        num = QTableWidgetItem(str(row + 1))
+        num.setFlags(num.flags() & ~Qt.ItemIsEditable)
+        num.setTextAlignment(Qt.AlignCenter)
+        self.table.setItem(row, 0, num)
+
+        # 1: active checkbox
+        chk = QCheckBox()
+        chk.setChecked(True)
+        self.table.setCellWidget(row, 1, chk)
+
+        # 2: X
+        x_val = float(pf.get('x', 0) or 0)
+        x_item = QTableWidgetItem(f"{x_val:.2f}")
+        x_item.setTextAlignment(Qt.AlignCenter)
+        self.table.setItem(row, 2, x_item)
+
+        # 3: X Mode
+        xmode = QComboBox()
+        xmode.addItems(["ABS", "INC"])
+        self.table.setCellWidget(row, 3, xmode)
+
+        # 4: Y
+        y_val = float(pf.get('y', 0) or 0)
+        y_item = QTableWidgetItem(f"{y_val:.2f}")
+        y_item.setTextAlignment(Qt.AlignCenter)
+        self.table.setItem(row, 4, y_item)
+
+        # 5: Plane
+        plane_text = FACE_TO_PLANE.get(pf.get('face', ''), 'Web')
+        plane_combo = QComboBox()
+        plane_combo.addItems(["Web", "Flange", "Both"])
+        idx = plane_combo.findText(plane_text)
+        if idx >= 0:
+            plane_combo.setCurrentIndex(idx)
+        plane_combo.currentTextChanged.connect(lambda: self.canvas_sync_needed.emit())
+        self.table.setCellWidget(row, 5, plane_combo)
+
+        # 6: Process
+        proc_combo = QComboBox()
+        proc_combo.addItems(["Hole", "Slot", "Marking"])
+        proc_combo.setCurrentIndex({"Hole": 0, "Slot": 1, "Marking": 2}.get(proc_type, 0))
+        proc_combo.currentTextChanged.connect(
+            lambda txt, r=row: self._on_process_type_changed(r, txt))
+        self.table.setCellWidget(row, 6, proc_combo)
+
+        # 7: D
+        d_val = float(pf.get('d', 0) or 0)
+        d_item = QTableWidgetItem(f"{d_val:.2f}")
+        d_item.setTextAlignment(Qt.AlignCenter)
+        self.table.setItem(row, 7, d_item)
+
+        # 8: Depth
+        depth_val = float(pf.get('depth', pf.get('length', 0)) or 0)
+        depth_item = QTableWidgetItem(f"{depth_val:.2f}")
+        depth_item.setTextAlignment(Qt.AlignCenter)
+        self.table.setItem(row, 8, depth_item)
+
+        # 9: Angle
+        angle_val = float(pf.get('angle', 0) or 0)
+        angle_item = QTableWidgetItem(f"{angle_val:.2f}")
+        angle_item.setTextAlignment(Qt.AlignCenter)
+        self.table.setItem(row, 9, angle_item)
+
+        self._on_process_type_changed(row, proc_type)
+        self.table.selectRow(row)
+        self._refresh_status()
+        self.canvas_sync_needed.emit()
+
+    def get_active_holes(self) -> list[dict]:
+        """Return list of active hole dicts [{x, y, d, face}, ...]."""
+        holes = []
+        for row in range(self.table.rowCount()):
+            chk = self.table.cellWidget(row, 1)
+            if not isinstance(chk, QCheckBox) or not chk.isChecked():
+                continue
+            try:
+                x = float(self.table.item(row, 2).text() or 0)
+                y = float(self.table.item(row, 4).text() or 0)
+                d = float(self.table.item(row, 7).text() or 12.0)
+            except (TypeError, ValueError):
+                continue
+            plane_combo = self.table.cellWidget(row, 5)
+            plane = plane_combo.currentText() if plane_combo else 'Web'
+            holes.append({'x': x, 'y': y, 'd': d, 'face': PLANE_TO_FACE.get(plane, 'v')})
+        return holes
+
+    def get_active_processes(self) -> list[dict]:
+        """Return list of active process dicts for get_part_data."""
+        processes = []
+        for row in range(self.table.rowCount()):
+            chk = self.table.cellWidget(row, 1)
+            if not isinstance(chk, QCheckBox) or not chk.isChecked():
+                continue
+            try:
+                x_val = float(self.table.item(row, 2).text() or 0.0)
+                y_val = float(self.table.item(row, 4).text() or 0.0)
+                diameter = float(self.table.item(row, 7).text() or 0.0)
+                depth = float(self.table.item(row, 8).text() or 0.0)
+            except (TypeError, ValueError):
+                continue
+            plane_combo = self.table.cellWidget(row, 5)
+            plane = plane_combo.currentText() if plane_combo else 'Web'
+            proc_combo = self.table.cellWidget(row, 6)
+            proc_type = proc_combo.currentText() if proc_combo else 'Hole'
+            angle_item = self.table.item(row, 9)
+            angle = float(angle_item.text()) if angle_item and angle_item.text() else 0.0
+            processes.append({
+                'x': x_val, 'y': y_val, 'plane': plane,
+                'type': proc_type, 'd': diameter, 'depth': depth, 'angle': angle,
+            })
+        return processes
+
+    def clear_and_load(self, items: list[dict], kind_key: str = 'kind'):
+        """Replace all rows from a list of dicts (e.g. record['holes'])."""
+        self.table.setRowCount(0)
+        for h in items:
+            kind = str(h.get(kind_key, '')).lower()
+            proc_type = 'Slot' if kind == 'slot' else 'Hole'
+            self.add_row(proc_type, prefill=h)
+
+    # ------------------------------------------------------------------
+    # Internal
+    # ------------------------------------------------------------------
+
+    def _on_process_type_changed(self, row: int, proc_text: str):
+        angle_item = self.table.item(row, 9)
+        if not angle_item:
+            return
+        if proc_text == "Hole":
+            angle_item.setFlags(angle_item.flags() & ~Qt.ItemIsEditable)
+            angle_item.setForeground(QColor("#475569"))
+            angle_item.setText("0.00")
+        else:
+            angle_item.setFlags(angle_item.flags() | Qt.ItemIsEditable)
+            angle_item.setForeground(QColor(C.txt))
+
+    def _context_menu(self, pos):
+        row = self.table.rowAt(pos.y())
+        if row < 0:
+            return
+        menu = QMenu(self)
+        menu.setStyleSheet(
+            f"QMenu {{ background-color: {C.panel}; color: white; "
+            f"border: 1px solid {C.line}; }} "
+            f"QMenu::item:selected {{ background-color: {C.accent}; }}"
+        )
+        act_hole = menu.addAction(tr('cp_convert_hole', self._lang_getter()))
+        act_slot = menu.addAction(tr('cp_convert_slot', self._lang_getter()))
+        menu.addSeparator()
+        act_delete = menu.addAction(tr('cp_delete', self._lang_getter()))
+
+        action = menu.exec(self.table.viewport().mapToGlobal(pos))
+        if action == act_hole:
+            self._convert(row, "Hole")
+        elif action == act_slot:
+            self._convert(row, "Slot")
+        elif action == act_delete:
+            self.table.removeRow(row)
+            self._renumber()
+            self._refresh_status()
+        self.canvas_sync_needed.emit()
+
+    def _convert(self, row: int, target: str):
+        combo = self.table.cellWidget(row, 6)
+        if isinstance(combo, QComboBox):
+            combo.setCurrentIndex({"Hole": 0, "Slot": 1, "Marking": 2}.get(target, 0))
+
+    def _renumber(self):
+        for r in range(self.table.rowCount()):
+            item = self.table.item(r, 0)
+            if item:
+                item.setText(str(r + 1))
+
+    def _refresh_status(self):
+        total = self.table.rowCount()
+        active = sum(
+            1 for r in range(total)
+            if isinstance(self.table.cellWidget(r, 1), QCheckBox)
+            and self.table.cellWidget(r, 1).isChecked()
+        )
+        self.status_lbl.setText(
+            tr('cp_status', self._lang_getter()).format(active=active, total=total))
