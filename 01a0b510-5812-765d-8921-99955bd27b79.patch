@@ -0,0 +1,64 @@
+"""segment_builder.py — Split faces into segments.
+
+🚨 GUARDIAN LAW: Single responsibility — segmentation فقط.
+
+الهدف: ملي كاين cut ولا notch، الوجه كايتقسم ل segments.
+"""
+from __future__ import annotations
+from typing import List, Optional
+
+from ..core.enums import Face
+from ..geometry.dimensions import ProfileDimensions
+from ..models.contour_point import ContourPoint
+from ..models.intersection import IntersectionPoint
+from .base_builder import BaseBuilder
+
+
+class SegmentBuilder(BaseBuilder):
+    """كايقسّم وجه واحد ل segments حسب الـ intersection points."""
+
+    def __init__(
+        self,
+        face: Face,
+        dims: ProfileDimensions,
+        intersections: Optional[List[IntersectionPoint]] = None,
+    ):
+        super().__init__()
+        self.face = face
+        self.d = dims
+        self.intersections = intersections or []
+
+    def _build_impl(self) -> List[List[ContourPoint]]:
+        if not self.intersections:
+            return [self._build_full_face()]
+        return self._build_split_face()
+
+    def _build_full_face(self) -> List[ContourPoint]:
+        from .face_builder import FaceBuilder
+        fb = FaceBuilder(self.face, self.d)
+        return fb.build()
+
+    def _build_split_face(self) -> List[List[ContourPoint]]:
+        from .face_builder import FaceBuilder
+
+        fb = FaceBuilder(self.face, self.d)
+        base_points = fb.build()
+
+        sorted_ints = sorted(self.intersections, key=lambda p: p.x)
+
+        int_points = [
+            ContourPoint(x=p.x, y=p.y, face=self.face, suffix=None)
+            for p in sorted_ints
+        ]
+
+        all_points = base_points + int_points
+        all_points.sort(key=lambda p: (p.x, p.y))
+
+        segments: List[List[ContourPoint]] = []
+        for i in range(len(all_points) - 1):
+            segments.append([all_points[i], all_points[i + 1]])
+
+        return segments if segments else [base_points]
+
+    def _validate(self) -> bool:
+        return bool(self._result) and len(self._result) >= 1
