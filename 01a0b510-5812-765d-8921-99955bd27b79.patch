+"""face_registry.py — Face mappings per profile kind.
+
+🚨 GUARDIAN LAW: Single source of truth for face mappings.
+كل التخطيطات هنا، ما تتكررش ف ملفات أخرى.
+"""
+from __future__ import annotations
+from typing import Dict, List
+
+from ..core.enums import ProfileKind, Face
+
+
+# ─── أي وجوه كاينة لكل نوع بروفيل ──────────────────────────
+# Ground truth from 37 NC1 templates: v=37, o=28, u=32, h=0
+FACES_BY_KIND: Dict[ProfileKind, List[Face]] = {
+    ProfileKind.I:  [Face.V, Face.O, Face.U],
+    ProfileKind.U:  [Face.V, Face.O, Face.U, Face.H],
+    ProfileKind.L:  [Face.V, Face.U],
+    ProfileKind.O:  [Face.V],
+    ProfileKind.T:  [Face.V],
+    ProfileKind.B:  [Face.V],
+    ProfileKind.FB: [Face.V],
+}
+
+
+# ─── عرض كل وجه (规则) ──────────────────────────────────────
+# None = كايتم حسابها ديناميكيا
+FACE_WIDTH_RULES: Dict[ProfileKind, Dict[Face, str]] = {
+    ProfileKind.I:  {Face.V: "H", Face.O: "b", Face.U: "b"},
+    ProfileKind.U:  {Face.V: "H", Face.O: "b", Face.U: "b", Face.H: "H"},
+    ProfileKind.L:  {Face.V: "H", Face.U: "b"},
+    ProfileKind.O:  {Face.V: "circumference"},
+    ProfileKind.T:  {Face.V: "H"},
+    ProfileKind.B:  {Face.V: "H"},  # Plate: H = stocked width (dims[1])
+    ProfileKind.FB: {Face.V: "H"},
+}
+
+
+def get_faces(kind: ProfileKind) -> List[Face]:
+    """كايرجع الوجوه المتوفرة لنوع بروفيل."""
+    return list(FACES_BY_KIND.get(kind, [Face.V]))
+
+
+def get_width_rule(kind: ProfileKind, face: Face) -> str:
+    """كايرجع القاعدة ديال حساب العرض لوجه معين."""
+    return FACE_WIDTH_RULES.get(kind, {}).get(face, "H")
