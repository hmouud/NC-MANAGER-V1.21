+"""cut_angles.py — CutAngles data class + parser.
+
+🚨 GUARDIAN LAW: هاد الملف ما كايحتويش على business logic. غير البيانات + القراءة.
+"""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import List
+
+from ..core.enums import ProfileKind
+from ..core.constants import (
+    IDX_STEG_FRONT, IDX_STEG_REAR,
+    IDX_FLANGE_FRONT, IDX_FLANGE_REAR,
+    TOLERANCE_DEG,
+)
+from ..core.exceptions import InvalidCutAngleError
+
+
+@dataclass(frozen=True)
+class CutAngles:
+    """زوايا القطع الأربعة (بالدرجات)."""
+    steg_front: float = 0.0
+    steg_rear: float = 0.0
+    flange_front: float = 0.0
+    flange_rear: float = 0.0
+
+    def __post_init__(self) -> None:
+        for name in ("steg_front", "steg_rear", "flange_front", "flange_rear"):
+            value = getattr(self, name)
+            if abs(value) > 180.0:
+                raise InvalidCutAngleError(value)
+
+    @property
+    def is_identity(self) -> bool:
+        """واش كل الزوايا صفر؟"""
+        return all(
+            abs(a) < TOLERANCE_DEG
+            for a in (self.steg_front, self.steg_rear,
+                      self.flange_front, self.flange_rear)
+        )
+
+    @property
+    def has_web_cut(self) -> bool:
+        return (abs(self.steg_front) > TOLERANCE_DEG or
+                abs(self.steg_rear) > TOLERANCE_DEG)
+
+    @property
+    def has_flange_cut(self) -> bool:
+        return (abs(self.flange_front) > TOLERANCE_DEG or
+                abs(self.flange_rear) > TOLERANCE_DEG)
+
+
+def parse_cut_angles(kind: ProfileKind, dims: List[float]) -> CutAngles:
+    """كايقرا الزوايا من الـ Header حسب نوع البروفيل.
+
+    البروفيلات B/FB/O ما عندهاش زوايا ف الـ Header.
+    """
+    if kind in (ProfileKind.B, ProfileKind.FB, ProfileKind.O):
+        return CutAngles()
+
+    def _safe(idx: int) -> float:
+        return float(dims[idx]) if len(dims) > idx else 0.0
+
+    return CutAngles(
+        steg_front=_safe(IDX_STEG_FRONT),
+        steg_rear=_safe(IDX_STEG_REAR),
+        flange_front=_safe(IDX_FLANGE_FRONT),
+        flange_rear=_safe(IDX_FLANGE_REAR),
+    )
