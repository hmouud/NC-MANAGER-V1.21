+"""contour_validator.py — Validate contours.
+
+🚨 GUARDIAN LAW: Single responsibility — validation فقط.
+"""
+from __future__ import annotations
+from typing import List
+
+from ..models.contour import Contour
+from ..models.contour_point import ContourPoint
+from ..core.constants import TOLERANCE_MM
+
+
+class BasicContourValidator:
+    """Validator أساسي: كايتحقق من:
+        - المحيط مسدود.
+        - على الأقل 4 نقاط (قبل السد).
+        - الترتيب: counter-clockwise (للـ AK).
+    """
+
+    def __init__(self, min_points: int = 4):
+        self.min_points = min_points
+        self._errors: List[str] = []
+
+    def validate(self, contour: Contour) -> bool:
+        """كايتحقق من المحيط. كايرجع True إلا كان صالح."""
+        self._errors.clear()
+
+        if not contour.is_closed:
+            self._errors.append("Contour is not closed")
+
+        if contour.point_count < self.min_points + 1:
+            self._errors.append(
+                f"Contour has {contour.point_count} points, "
+                f"need at least {self.min_points + 1}"
+            )
+
+        if contour.points:
+            first = contour.points[0]
+            last = contour.points[-1]
+            if not self._same_point(first, last):
+                self._errors.append(
+                    "First and last points do not match (not closed)"
+                )
+
+        if not self._is_counter_clockwise(contour.points):
+            self._errors.append(
+                "Contour points are not in counter-clockwise order"
+            )
+
+        return len(self._errors) == 0
+
+    def _same_point(self, a: ContourPoint, b: ContourPoint) -> bool:
+        return (
+            abs(a.x - b.x) < TOLERANCE_MM
+            and abs(a.y - b.y) < TOLERANCE_MM
+        )
+
+    def _is_counter_clockwise(self, points: List[ContourPoint]) -> bool:
+        """Shoelace formula (Signed Area).
+
+        إلا كانت المساحة موجبة → counter-clockwise.
+        """
+        if len(points) < 3:
+            return False
+
+        area = 0.0
+        n = len(points)
+        for i in range(n):
+            j = (i + 1) % n
+            area += points[i].x * points[j].y
+            area -= points[j].x * points[i].y
+
+        return area > 0.0
+
+    @property
+    def errors(self) -> List[str]:
+        """كايرجع الأخطاء اللي لقاها آخر validation."""
+        return list(self._errors)
