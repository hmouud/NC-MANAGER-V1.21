+"""IronForge Parametric & Nesting Engine - Workspace UI (Phase 4 scaffold).
+
+``NestingWorkspaceWidget`` is the massive, browser-chrome-styled workspace that
+replaces the 2D/3D viewer panel inside NC Manager. It currently carries NO
+packing / nesting algorithms (Phase 5): it only implements the Auto-Routing
+mockup that groups selected DSTV plates by thickness into one tab per
+thickness (``PL - 10mm``, ``PL - 15mm``, ...) and rolls the 1D profiles into a
+single tab, with placeholder labels where the real renderers will live.
+"""
+
+from PySide6.QtCore import Qt
+from PySide6.QtWidgets import (QWidget, QVBoxLayout, QHBoxLayout, QFrame,
+                               QLabel, QTabWidget, QButtonGroup)
+
+from nccorrection.core.viewer import parse_geometry
+from nccorrection.ui.components.modern_button import AnimatedButton
+from nccorrection.ui._colors import C
+from nccorrection.ui.components.scaling import sp
+
+
+class NestingWorkspaceWidget(QWidget):
+    """IronForge nesting workspace: smart-filter control bar + chrome tabs.
+
+    The left-side file list stays visible in the app (only the right-hand
+    workspace panel is swapped), so the user can keep selecting files and
+    pressing the toolbar toggle to re-route them into the tabs.
+    """
+
+    FILTER_ALL = 'all'
+    FILTER_PROFILES = 'profiles'  # 1D - Mis-en-barre
+    FILTER_PLATES = 'plates'      # 2D - Mis-en-tôle
+
+    def __init__(self, parent=None, theme=None, tr=None):
+        super().__init__(parent)
+        self._theme = dict(theme) if theme else {}
+        self._tr = tr or (lambda k, *a: k)
+        self._filter = self.FILTER_ALL
+        self._tab_meta = []
+        self._build()
+        self.set_theme(self._theme)
+
+    # ---------------------------------------------------------------- build
+    def _build(self):
+        lay = QVBoxLayout(self)
+        lay.setContentsMargins(8, 6, 8, 6)
+        lay.setSpacing(6)
+
+        # Chrome-style tab bar (the workspace's main surface).
+        self.tab_widget = QTabWidget(self)
+        self.tab_widget.setDocumentMode(True)
+        self.tab_widget.setMovable(True)
+        self.tab_widget.setTabsClosable(False)
+        self.tab_widget.setElideMode(Qt.ElideMiddle)
+        self.tab_widget.setMinimumHeight(200)
+
+        # Control panel: smart-filtering toggle buttons.
+        self.control_bar = QFrame(self)
+        self.control_bar.setObjectName('nestingControls')
+        cl = QHBoxLayout(self.control_bar)
+        cl.setContentsMargins(8, 5, 8, 5)
+        cl.setSpacing(6)
+
+        self.badge = QLabel('[ IRONFORGE NESTING ]', self.control_bar)
+        self.badge.setObjectName('nestingBadge')
+        cl.addWidget(self.badge)
+
+        self.filter_all_btn = AnimatedButton(
+            self._tr('nest_all'), variant='default', theme=self._theme,
+            parent=self.control_bar, height=sp(28))
+        self.filter_profiles_btn = AnimatedButton(
+            self._tr('profiles_only'), variant='default', theme=self._theme,
+            parent=self.control_bar, height=sp(28))
+        self.filter_plates_btn = AnimatedButton(
+            self._tr('plates_only'), variant='default', theme=self._theme,
+            parent=self.control_bar, height=sp(28))
+        for b in (self.filter_all_btn, self.filter_profiles_btn,
+                  self.filter_plates_btn):
+            b.setCheckable(True)
+        self._filter_group = QButtonGroup(self)
+        self._filter_group.setExclusive(True)
+        for b in (self.filter_all_btn, self.filter_profiles_btn,
+                  self.filter_plates_btn):
+            self._filter_group.addButton(b)
+        self.filter_all_btn.setChecked(True)
+        self.filter_all_btn.toggled.connect(
+            lambda chk, k=self.FILTER_ALL: self._on_filter_toggled(k, chk))
+        self.filter_profiles_btn.toggled.connect(
+            lambda chk, k=self.FILTER_PROFILES: self._on_filter_toggled(k, chk))
+        self.filter_plates_btn.toggled.connect(
+            lambda chk, k=self.FILTER_PLATES: self._on_filter_toggled(k, chk))
+
+        cl.addStretch(1)
+        cl.addWidget(self.filter_all_btn)
+        cl.addWidget(self.filter_profiles_btn)
+        cl.addWidget(self.filter_plates_btn)
+
+        lay.addWidget(self.control_bar)
+        lay.addWidget(self.tab_widget, 1)
+
+    # ---------------------------------------------------------------- theme
+    def set_theme(self, theme):
+        self._theme = dict(theme) if theme else {}
+        th = self._theme
+        for b in (self.filter_all_btn, self.filter_profiles_btn,
+                  self.filter_plates_btn):
+            b.set_theme(self._theme)
+        self.setStyleSheet(self._build_qss())
+        for meta in self._tab_meta:
+            page = self.tab_widget.widget(meta['index'])
+            for lbl in (page.findChildren(QLabel)
+                        if page is not None else []):
+                lbl.setStyleSheet(f"color:{C.mut};"
+                                  f" font-family:'Arial';"
+                                  f" font-size:13px; background:transparent;"
+                                  f" border:none;")
+        self.update()
+
+    def _build_qss(self):
+        return f'''
+            QWidget#nestingControls {{
+                background:{C.panel2};
+                border:1px solid {C.line};
+                border-radius:8px;
+            }}
+            QLabel#nestingBadge {{
+                color:{C.accent};
+                font-weight:bold; font-size:12px; background:transparent;
+            }}
+            QTabWidget::pane {{
+                border:1px solid {C.line};
+                border-radius:8px; background:{C.panel};
+                top:-1px;
+            }}
+            QTabBar {{ background:transparent; }}
+            QTabBar::tab {{
+                background:{C.panel2};
+                color:{C.mut};
+                border:1px solid {C.line};
+                border-bottom:none;
+                padding:8px 20px; margin-right:3px;
+                border-top-left-radius:8px; border-top-right-radius:8px;
+                font-family:'Arial'; font-size:11px; font-weight:bold;
+            }}
+            QTabBar::tab:selected {{
+                background:{C.panel};
+                color:{C.txt};
+                border-color:{C.accent};
+            }}
+            QTabBar::tab:hover:!selected {{
+                background:{C.panel2};
+                color:{C.txt};
+            }}
+            QTabBar::tab:disabled {{
+                color:{C.mut};
+                background:{C.bg};
+            }}
+        '''
+
+    # ---------------------------------------------------------------- routing
+    def load_files_for_nesting(self, files_list):
+        """Auto-Routing mockup: route DSTV files into the workspace tabs.
+
+        Plates (DSTV ``B`` profile / ``PLATE`` category) are grouped by their
+        thickness and get one chrome tab per unique thickness
+        (``PL - 10mm``, ``PL - 15mm``, ...). Rolled profiles are grouped into
+        a single ``Profiles (1D)`` tab. No nesting/packing is computed yet:
+        each tab only carries a placeholder label (Phase 5).
+        """
+        self._clear_tabs()
+        plates = {}
+        profiles = []
+        for f in (files_list or []):
+            if not isinstance(f, dict):
+                continue
+            try:
+                st = (parse_geometry(f.get('text') or '') or {}).get('st') or {}
+            except Exception:
+                st = {}
+            ptype = str(st.get('type') or '').upper()
+            is_plate = ptype == 'B' or f.get('category') == 'PLATE'
+            if is_plate:
+                t = st.get('thickness') or 0.0
+                plates.setdefault(t, []).append(f)
+            else:
+                profiles.append(f)
+        for t in sorted(plates, key=lambda x: float(x or 0.0)):
+            label = f"PL - {self._fmt_thickness(t)}mm"
+            self._add_tab(label, self.FILTER_PLATES,
+                          thickness=t, files=plates[t])
+        if profiles:
+            self._add_tab('Profiles (1D)', self.FILTER_PROFILES,
+                          thickness=None, files=profiles)
+        if self.tab_widget.count() == 0:
+            self._add_tab('NESTING WORKSPACE', self.FILTER_ALL, files=[])
+        self._apply_filter()
+
+    def _clear_tabs(self):
+        while self.tab_widget.count():
+            self.tab_widget.removeTab(0)
+        self._tab_meta = []
+
+    def _add_tab(self, label, kind, thickness=None, files=None):
+        page = QWidget(self.tab_widget)
+        lay = QVBoxLayout(page)
+        lay.setContentsMargins(10, 10, 10, 10)
+        ph = QLabel(self._placeholder_text(kind, thickness, files or []), page)
+        ph.setAlignment(Qt.AlignCenter)
+        ph.setWordWrap(True)
+        th = self._theme
+        ph.setStyleSheet(f"color:{C.mut};"
+                         f" font-family:'Arial'; font-size:13px;"
+                         f" background:transparent; border:none;")
+        lay.addWidget(ph)
+        index = self.tab_widget.addTab(page, label)
+        self._tab_meta.append({'index': index, 'kind': kind,
+                               'label': label, 'thickness': thickness,
+                               'files': list(files or [])})
+
+    def _placeholder_text(self, kind, thickness, files):
+        n = len(files)
+        if kind == self.FILTER_PLATES:
+            return (f"PLATE NESTING (Mis-en-t\u00f4le) \u2014 "
+                    f"PL {self._fmt_thickness(thickness)}mm\n\n"
+                    f"{n} plate(s) queued\n\n"
+                    f"Packing & plate renderer ship in Phase 5.")
+        if kind == self.FILTER_PROFILES:
+            return (f"1D BAR NESTING (Mis-en-barre)\n\n"
+                    f"{n} profile(s) queued\n\n"
+                    f"Cutting-optimisation engine ships in Phase 5.")
+        return ("IRONFORGE NESTING WORKSPACE\n\n"
+                "Select NC/NC1 files in the left list, then press "
+                "[ NESTING WORKSPACE ] again to route them here.")
+
+    # ---------------------------------------------------------------- filters
+    def _on_filter_toggled(self, kind, checked):
+        if not checked:
+            return
+        self._filter = kind
+        self._apply_filter()
+
+    def _tab_visible(self, meta):
+        if self._filter == self.FILTER_ALL:
+            return True
+        if self._filter == self.FILTER_PLATES:
+            return meta['kind'] == self.FILTER_PLATES
+        if self._filter == self.FILTER_PROFILES:
+            return meta['kind'] == self.FILTER_PROFILES
+        return True
+
+    def _apply_filter(self):
+        for i, meta in enumerate(self._tab_meta):
+            self.tab_widget.setTabEnabled(i, self._tab_visible(meta))
+        for i, meta in enumerate(self._tab_meta):
+            if self._tab_visible(meta):
+                self.tab_widget.setCurrentIndex(i)
+                break
+
+    # ---------------------------------------------------------------- helpers
+    @staticmethod
+    def _fmt_thickness(t):
+        try:
+            v = float(t)
+            return f'{v:g}' if v == int(v) else f'{v:.1f}'
+        except (TypeError, ValueError):
+            return str(t if t is not None else '?')
