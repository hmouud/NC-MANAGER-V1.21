+class TestArcInterpolation(unittest.TestCase):
+    def test_bulge_to_arc_points_zero(self):
+        pts = bulge_to_arc_points(0.0, 0.0, 10.0, 0.0, 0.0)
+        self.assertEqual(len(pts), 2)
+        self.assertEqual(pts[0], (0.0, 0.0))
+        self.assertEqual(pts[1], (10.0, 0.0))
+
+    def test_bulge_to_arc_points_semicircle(self):
+        # bulge=1.0 -> theta = pi -> a semicircle from (0,0) to (10,0)
+        pts = bulge_to_arc_points(0.0, 0.0, 10.0, 0.0, 1.0, num_segments=32)
+        mid = pts[len(pts) // 2]
+        # apex of the semicircle is at x=5, y=5 (bulge>0 curves to the left)
+        self.assertAlmostEqual(mid[0], 5.0, places=1)
+        self.assertAlmostEqual(mid[1], 5.0, places=1)
+        self.assertAlmostEqual(pts[0][0], 0.0)
+        self.assertAlmostEqual(pts[-1][0], 10.0)
+
+    def test_bulge_negative_side(self):
+        pts = bulge_to_arc_points(0.0, 0.0, 10.0, 0.0, -1.0, num_segments=32)
+        mid = pts[len(pts) // 2]
+        self.assertAlmostEqual(mid[0], 5.0, places=1)
+        self.assertAlmostEqual(mid[1], -5.0, places=1)
+
