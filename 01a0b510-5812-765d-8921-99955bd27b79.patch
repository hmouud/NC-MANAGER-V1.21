+"""Tests for validators/contour_validator.py."""
+import unittest
+from nccorrection.engine.contour.validators.contour_validator import BasicContourValidator
+from nccorrection.engine.contour.models.contour import Contour
+from nccorrection.engine.contour.models.contour_point import ContourPoint
+from nccorrection.engine.contour.core.enums import Face
+
+
+class TestBasicContourValidator(unittest.TestCase):
+    def test_valid_contour_passes(self):
+        """CCW rectangle: (0,0)→(100,0)→(100,50)→(0,50)→(0,0)."""
+        contour = Contour(face=Face.V)
+        contour.add_points([
+            ContourPoint(x=0, y=0, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+            ContourPoint(x=100, y=50, face=Face.V),
+            ContourPoint(x=0, y=50, face=Face.V),
+            ContourPoint(x=0, y=0, face=Face.V),
+        ])
+        contour.is_closed = True
+        validator = BasicContourValidator()
+        self.assertTrue(validator.validate(contour))
+        self.assertEqual(len(validator.errors), 0)
+
+    def test_unclosed_contour_fails(self):
+        contour = Contour(face=Face.V)
+        contour.add_points([
+            ContourPoint(x=0, y=0, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+            ContourPoint(x=100, y=100, face=Face.V),
+        ])
+        validator = BasicContourValidator()
+        self.assertFalse(validator.validate(contour))
+        self.assertTrue(any("not closed" in e for e in validator.errors))
+
+    def test_too_few_points_fails(self):
+        contour = Contour(face=Face.V)
+        contour.add_points([
+            ContourPoint(x=0, y=0, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+        ])
+        contour.is_closed = True
+        validator = BasicContourValidator()
+        self.assertFalse(validator.validate(contour))
+
+    def test_cw_contour_fails(self):
+        """CW rectangle should fail CCW check."""
+        contour = Contour(face=Face.V)
+        contour.add_points([
+            ContourPoint(x=0, y=0, face=Face.V),
+            ContourPoint(x=0, y=50, face=Face.V),
+            ContourPoint(x=100, y=50, face=Face.V),
+            ContourPoint(x=100, y=0, face=Face.V),
+            ContourPoint(x=0, y=0, face=Face.V),
+        ])
+        contour.is_closed = True
+        validator = BasicContourValidator()
+        result = validator.validate(contour)
+        # CW → negative area → should fail
+        self.assertFalse(result)
