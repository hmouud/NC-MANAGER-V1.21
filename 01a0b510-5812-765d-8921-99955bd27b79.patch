@@ -0,0 +1,853 @@
+"""Painting mixin for NcViewer — grid, axes, shapes, cotations, unfold, etc."""
+
+import math
+
+from PySide6.QtCore import Qt, QPointF, QRectF
+from PySide6.QtGui import (QPen, QBrush, QColor, QPainter, QPainterPath,
+                           QPolygonF, QFont, QFontMetrics, QTransform)
+from nccorrection.ui._colors import C
+from nccorrection.core.viewer import compute_bounds
+
+
+class _ViewerPaintMixin:
+    """Mixin that holds all painting/drawing methods for NcViewer.
+
+    This is a plain class (NOT QWidget).  All methods access ``self`` which
+    is the actual :class:`NcViewer` instance at runtime.
+    """
+
+    _FACE_ORDER = ['v', 'h', 'o', 'u']
+    _EURO_ORDER = {'u': 0, 'v': 1, 'o': 2, 'h': 3}
+
+    def _face_badge_label(self, face):
+        """Badge text for one face under the current label mode (None = hide)."""
+        if self._face_labels == 'off':
+            return None
+        if self._face_labels == 'letters':
+            return (face or '?').upper()
+        from nccorrection.engine.render_2d.renderer_2d import DstvRenderer2D
+        return DstvRenderer2D.FACE_DESCR.get(face, face)
+
+    # ---------------------------------------------------------------- paint
+    def _paint_impl(self, event):
+        """Core paint logic — called from NcViewer.paintEvent.
+
+        PySide6 C++ trampolines only dispatch virtual methods found in the
+        immediate class dict, so paintEvent must live on NcViewer itself.
+        This method holds the actual implementation so the painting code
+        stays in the mixin file.
+        """
+        p = QPainter(self)
+        p.setRenderHint(QPainter.Antialiasing)
+        p.fillRect(self.rect(), self._bg)
+        if not self._geometry:
+            p.setPen(QColor(C.mut))
+            p.setFont(QFont('Arial', 10))
+            p.drawText(self.rect(), Qt.AlignCenter, 'No geometry to display')
+            p.end()
+            return
+
+        if self._unfold:
+            self._draw_unfold(p)
+            self._draw_status(p)
+            p.end()
+            return
+
+        b = self._bounds or compute_bounds(self._geometry, margin=2.0)
+        if not b:
+            self._bounds = None
+            p.setPen(QColor(C.mut))
+            p.setFont(QFont('Arial', 10))
+            p.drawText(self.rect(), Qt.AlignCenter, 'No geometry to display')
+            p.end()
+            return
+        if self._ensure_face_bands():
+            b = self._exploded_bounds() or b
+        self._bounds = b
+        w = max(b[2] - b[0], 1e-6)
+        h = max(b[3] - b[1], 1e-6)
+        need_right = need_top = 0.0
+        if self._cotation:
+            if self._geometry.get('circles') or self._geometry.get('slots'):
+                need_right = 40.0
+                need_top = 38.0
+        self._scale = min(max(self.width() - 40 - need_right, 10) / w,
+                          max(self.height() - 40 - need_top, 10) / h)
+        self._ox = (self.width() - need_right) / 2.0 \
+            - (b[0] + b[2]) / 2.0 * self._scale
+        self._oy = (self.height() - need_top) / 2.0 \
+            + (b[1] + b[3]) / 2.0 * self._scale
+
+        if self._show_grid:
+            self._draw_grid(p, b)
+        if self._show_axes:
+            self._draw_axes(p, b)
+        self._draw_shapes(p, b)
+        self._draw_trusquinage(p, b)
+        if self._cotation:
+            self._draw_cotation(p, b)
+        self._draw_measure(p)
+        self._draw_status(p)
+        p.end()
+
+    def _draw_grid(self, p, b):
+        """Draw minor + major grid lines (Linear Dark tokens).
+
+        Major lines every 5 minor steps — darker/thicker for orientation.
+        """
+        ext = max(b[2] - b[0], b[3] - b[1], 1.0)
+        step = next((s for s in self.GRID_STEPS if ext / s <= 50), self.GRID_STEPS[-1])
+        px = self._scale * self._zoom
+        if step * px < 6:
+            step = next((s for s in self.GRID_STEPS if s * px >= 6), self.GRID_STEPS[-1])
+        major_every = 5
+        # Minor grid
+        pen_minor = QPen(QColor(C.grid_minor))
+        pen_minor.setWidthF(0.5)
+        # Major grid
+        pen_major = QPen(QColor(C.grid_major))
+        pen_major.setWidthF(1.0)
+        x0 = math.floor(b[0] / step) * step
+        idx = 0
+        while x0 <= b[2]:
+            sx, _ = self._to_screen(x0, 0)
+            p.setPen(pen_major if idx % major_every == 0 else pen_minor)
+            p.drawLine(QPointF(sx, 0), QPointF(sx, self.height()))
+            x0 += step
+            idx += 1
+        y0 = math.floor(b[1] / step) * step
+        idx = 0
+        while y0 <= b[3]:
+            _, sy = self._to_screen(0, y0)
+            p.setPen(pen_major if idx % major_every == 0 else pen_minor)
+            p.drawLine(QPointF(0, sy), QPointF(self.width(), sy))
+            y0 += step
+            idx += 1
+
+    def _draw_axes(self, p, b):
+        # Bottom-left corner X:Y reference. 2D shows only X and Y (no Z).
+        cx, cy = 24.0, self.height() - 26.0
+        L, arr = 17.0, 5.0
+        for name, col, dx, dy in (('Y', '#22c55e', 0.0, -L),
+                                  ('X', '#ef4444', L, 0.0)):
+            p.setPen(QPen(QColor(col), 1.2))
+            p.drawLine(QPointF(cx, cy), QPointF(cx + dx, cy + dy))
+            ang = math.atan2(-(dy), dx)
+            a = math.radians(18)
+            for sa in (a, -a):
+                p.drawLine(QPointF(cx + dx, cy + dy),
+                           QPointF(cx + dx - arr * math.cos(ang + sa),
+                                   cy + dy + arr * math.sin(ang + sa)))
+            p.setPen(QColor(col))
+            p.setFont(QFont('Arial', 8, QFont.Bold))
+            p.drawText(QPointF(cx + dx + 2, cy + dy - 2), name)
+
+    def _build_slot_path(self, cx, cy, diameter, slot_length, angle_deg, scale):
+        """
+        Max-Level CAD implementation (explicit B-Rep).
+        Constructs a slot strictly using explicit arcs and tangent lines.
+        This ensures future Nesting collision-detection algorithms can parse
+        the exact geometry.
+
+        ``slot_length`` is the OVERALL slot length (the NC centre-to-centre
+        straight part PLUS one diameter). Real DSTV slots (e.g. ``d=22``, NC
+        ``L=18``) therefore pass ``L + d = 40`` and produce a stadium of
+        exactly ``40 x 22`` mm.
+        """
+        from PySide6.QtGui import QPainterPath, QTransform
+
+        path = QPainterPath()
+
+        r = (diameter / 2.0) * scale
+        # The straight part between the two drill centers
+        straight_len = max(0, (slot_length - diameter) * scale)
+        half_straight = straight_len / 2.0
+
+        # Start at top tangent of the left semicircle
+        path.moveTo(-half_straight, -r)
+
+        # Top straight line
+        path.lineTo(half_straight, -r)
+
+        # Right semicircle (sweep 180 degrees from 90 to -90)
+        path.arcTo(half_straight - r, -r, r * 2, r * 2, 90, -180)
+
+        # Bottom straight line
+        path.lineTo(-half_straight, r)
+
+        # Left semicircle (sweep 180 degrees from 270 to 90)
+        path.arcTo(-half_straight - r, -r, r * 2, r * 2, 270, -180)
+
+        path.closeSubpath()
+
+        # Apply True Spatial Transformation
+        transform = QTransform()
+        transform.translate(cx, cy)
+        transform.rotate(-angle_deg)  # Account for inverted Canvas Y
+
+        return transform.map(path)
+
+    def _draw_shapes(self, p, b):
+        from nccorrection.core.part3d import profile_color
+        geom = self._display_geometry()
+        st = geom.get('st') or {}
+        st_type = (st.get('type') or 'B').upper()
+        # White profile contour lines in 2D views for clean high-contrast CAD readability
+        accent = QColor(C.contour) if C.contour else QColor('#ffffff')
+        hole_col = QColor(C.hole)
+        slot_col = QColor(C.slot)
+        pen = QPen(accent)
+        pen.setWidthF(1.2)
+        pen.setJoinStyle(Qt.RoundJoin)
+        p.setPen(pen)
+        p.setBrush(Qt.NoBrush)
+
+        contours = geom.get('contours', [])
+        faces = geom.get('contour_faces') or ['v'] * len(contours)
+        metas = geom.get('contour_meta') or []
+        face_styles = {'v': (accent, False), 'o': (QColor('#34d399'), False),
+                       'u': (QColor('#a78bfa'), False), 'h': (QColor('#f472b6'), True)}
+        if contours:
+            # --- Separate outer and inner contours (IK = hole/cutout) ----
+            outer_contours = []   # (index, contour)
+            inner_contours = []   # (index, contour, face_letter)
+            for i, contour in enumerate(contours):
+                if len(contour) < 2:
+                    continue
+                meta = metas[i] if i < len(metas) else None
+                face = faces[i] if i < len(faces) else 'v'
+                kind = meta.get('kind', 'outer') if meta else 'outer'
+                if kind == 'inner':
+                    inner_contours.append((i, contour, face))
+                else:
+                    outer_contours.append((i, contour))
+
+            def _build_contour_path(contour, face, meta):
+                """Build QPainterPath for one contour with arc interpolation."""
+                arc_vals = meta.get('arc_values', []) if meta else []
+                has_arcs = any(abs(v) > 1e-12 for v in arc_vals)
+                if has_arcs and len(contour) >= 2:
+                    from nccorrection.engine.math.arc_interpolation import (
+                        polyline_for_vertices)
+                    conv = meta.get('arc_convention', 'bulge') if meta else 'bulge'
+                    verts_4d = []
+                    for j, pt in enumerate(contour):
+                        av = arc_vals[j] if j < len(arc_vals) else 0.0
+                        if conv == 'radius':
+                            verts_4d.append((pt[0], pt[1], 0.0, av))
+                        else:
+                            verts_4d.append((pt[0], pt[1], av, 0.0))
+                    pts = polyline_for_vertices(verts_4d)
+                    exploded = [(x, self._explode_y(face, y)) for x, y in pts]
+                else:
+                    exploded = [(x, self._explode_y(face, y))
+                                for x, y in contour]
+                path = QPainterPath(QPointF(*self._to_screen(*exploded[0])))
+                for ex, ey in exploded[1:]:
+                    path.lineTo(QPointF(*self._to_screen(ex, ey)))
+                if contour[0] != contour[-1]:
+                    path.closeSubpath()
+                return path
+
+            # --- Draw each outer contour with OddEvenFill + inner subpaths
+            for idx, contour in outer_contours:
+                face = faces[idx] if idx < len(faces) else 'v'
+                meta = metas[idx] if idx < len(metas) else None
+                fcol, dashed = face_styles.get(face, (accent, False))
+                fpen = QPen(QColor(20, 30, 48, 150), 0.8) if dashed else QPen(fcol, 1.0)
+                if dashed:
+                    fpen.setDashPattern([5, 4])
+                fpen.setJoinStyle(Qt.RoundJoin)
+
+                path = _build_contour_path(contour, face, meta)
+                path.setFillRule(Qt.OddEvenFill)
+
+                # Add inner contour subpaths (same face) — punches holes
+                for ii, icontour, iface in inner_contours:
+                    if iface != face:
+                        continue
+                    imeta = metas[ii] if ii < len(metas) else None
+                    inner_path = _build_contour_path(icontour, iface, imeta)
+                    path.addPath(inner_path)
+
+                # Draw filled outer + hole-cutouts
+                p.setPen(fpen)
+                p.setBrush(QBrush(accent))
+                p.drawPath(path)
+
+            # Draw inner contour outlines separately (hole_col, no fill)
+            for ii, icontour, iface in inner_contours:
+                imeta = metas[ii] if ii < len(metas) else None
+                opath = _build_contour_path(icontour, iface, imeta)
+                p.setPen(QPen(hole_col, 1.0))
+                p.setBrush(Qt.NoBrush)
+                p.drawPath(opath)
+
+            # --- Face badges on outer contours ---
+            for idx, contour in outer_contours:
+                face = faces[idx] if idx < len(faces) else 'v'
+                fcol = face_styles.get(face, (accent, False))[0]
+                # face badge: in the faces layout draw the blueprint-style
+                # name (same labels as the blueprint renderer) placed clearly
+                # away from the contour; single-face parts keep the
+                # historical letter badge exactly as before. The display mode
+                # (full names / letters / hidden) is a GLOBAL setting shared
+                # by every view.
+                if self._face_bands:
+                    label = self._face_badge_label(face)
+                    bx, by = self._to_screen(contour[0][0],
+                                             self._explode_y(face, contour[0][1]))
+                    if label is None:
