+"""State Layer for Advanced Profile Creator — Single Source of Truth.
+
+    ProfileState  — profile geometry parameters
+    ProcessState  — holes, slots, dimensions
+    AppState      — profile + processes + metadata
+    AppStateController — QObject with signals (state writes, UI reads)
+"""
+from __future__ import annotations
+
+import copy
+import json
+import os
+from dataclasses import dataclass, field, asdict
+from typing import List, Optional
+
+try:
+    from PySide6.QtCore import QObject, Signal
+except ImportError:
+    class Signal:
+        def __init__(self, *args):
+            self._callbacks = []
+
+        def connect(self, cb):
+            self._callbacks.append(cb)
+
+        def emit(self, *args, **kwargs):
+            for cb in self._callbacks:
+                cb(*args, **kwargs)
+
+    class QObject:
+        def __init__(self, parent=None):
+            self._parent = parent
+
+
+# ─── Data Classes ────────────────────────────────────────────
+
+@dataclass
+class ProfileState:
+    """Profile geometry parameters — one per part."""
+    profile_name: str = "IPE240"
+    material: str = "S235JR"
+    length: float = 6000.0
+    # CAD / Tekla Metadata
+    part_name: str = "B1"
+    order_number: str = "ORD-001"
+    phase: str = "1"
+    quantity: int = 1
+    # Cross-section dims (read from catalog, not user-edited)
+    width: float = 240.0
+    height: float = 240.0
+    web: float = 9.8
+    flange: float = 15.0
+    # Cut angles (degrees)
+    angle_steg_front: float = 0.0
+    angle_steg_rear: float = 0.0
+    angle_flange_front: float = 0.0
+    angle_flange_rear: float = 0.0
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+    @classmethod
+    def from_dict(cls, d: dict) -> ProfileState:
+        return cls(**{k: v for k, v in d.items() if k in cls.__dataclass_fields__})
+
+
+@dataclass
+class ProcessState:
+    """Manufacturing processes — holes, slots, cuts, dimensions."""
+    holes: List[dict] = field(default_factory=list)
+    slots: List[dict] = field(default_factory=list)
+    cuts: List[dict] = field(default_factory=list)
+    dimensions: List[dict] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        return {
+            'holes': list(self.holes),
+            'slots': list(self.slots),
+            'cuts': list(self.cuts),
+            'dimensions': list(self.dimensions),
+        }
+
+    @classmethod
+    def from_dict(cls, d: dict) -> ProcessState:
+        return cls(
+            holes=list(d.get('holes', [])),
+            slots=list(d.get('slots', [])),
+            cuts=list(d.get('cuts', [])),
+            dimensions=list(d.get('dimensions', [])),
+        )
+
+
+@dataclass
+class AppState:
+    """Complete application state — single source of truth."""
+    profile: ProfileState = field(default_factory=ProfileState)
+    processes: ProcessState = field(default_factory=ProcessState)
+    # Metadata
+    file_path: Optional[str] = None
+    is_dirty: bool = False
+
+    def to_dict(self) -> dict:
+        return {
+            'version': '1.0',
+            'profile': self.profile.to_dict(),
+            'processes': self.processes.to_dict(),
+            'metadata': {
+                'file_path': self.file_path,
+            },
+        }
+
+    @classmethod
+    def from_dict(cls, d: dict) -> AppState:
+        profile = ProfileState.from_dict(d.get('profile', {}))
+        processes = ProcessState.from_dict(d.get('processes', {}))
+        meta = d.get('metadata', {})
+        return cls(
+            profile=profile,
+            processes=processes,
+            file_path=meta.get('file_path'),
+        )
+
+    def snapshot(self) -> AppState:
+        """Return a deep copy for undo/redo."""
+        return copy.deepcopy(self)
+
+# Controller (QObject with signals)
+
+class AppStateController(QObject):
+    """Owns AppState, emits signals on change. State writes, UI reads."""
+    profile_changed = Signal(str)       # field name that changed
+    processes_changed = Signal(str)     # 'holes' | 'slots' | 'dimensions'
+    dirty_changed = Signal(bool)        # is_dirty value
+    file_changed = Signal()             # file_path changed
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._state = AppState()
+
+    @property
+    def state(self):
+        return self._state
+
+    def set_profile_name(self, name: str) -> None:
+        if self._state.profile.profile_name != name:
+            self._state.profile.profile_name = name
+            self._mark_dirty()
+            self.profile_changed.emit('profile_name')
+
+    def set_profile_material(self, material: str) -> None:
+        if self._state.profile.material != material:
+            self._state.profile.material = material
+            self._mark_dirty()
+            self.profile_changed.emit('material')
+
+    def set_profile_length(self, length: float) -> None:
+        if self._state.profile.length != length:
+            self._state.profile.length = length
+            self._mark_dirty()
+            self.profile_changed.emit('length')
+
+    def set_profile_dims(self, width: float, height: float,
+                         web: float, flange: float) -> None:
+        """Set cross-section dims (from catalog lookup)."""
+        p = self._state.profile
+        changed = False
+        if p.width != width: p.width = width; changed = True
+        if p.height != height: p.height = height; changed = True
+        if p.web != web: p.web = web; changed = True
+        if p.flange != flange: p.flange = flange; changed = True
+        if changed:
+            self._mark_dirty()
+            self.profile_changed.emit('dims')
+
+    def set_angle(self, name: str, value: float) -> None:
+        """Set a cut angle by field name."""
+        current = getattr(self._state.profile, name, None)
+        if current is None: return
+        if current != value:
+            setattr(self._state.profile, name, value)
+            self._mark_dirty()
+            self.profile_changed.emit(name)
+
+    def add_hole(self, hole: dict) -> None:
+        self._state.processes.holes.append(dict(hole))
+        self._mark_dirty()
+        self.processes_changed.emit('holes')
+
+    def add_slot(self, slot: dict) -> None:
+        self._state.processes.slots.append(dict(slot))
+        self._mark_dirty()
+        self.processes_changed.emit('slots')
+
+    def add_cut(self, cut: dict) -> None:
+        """Add rectangular cut/notch to state."""
+        self._state.processes.cuts.append(dict(cut))
+        self._mark_dirty()
+        self.processes_changed.emit('cuts')
+
+    def get_cuts(self) -> List[dict]:
+        """Return all cuts."""
+        return [dict(c) for c in self._state.processes.cuts]
+
+    def remove_cut(self, index: int) -> bool:
+        """Remove cut at index."""
+        if 0 <= index < len(self._state.processes.cuts):
+            self._state.processes.cuts.pop(index)
+            self._mark_dirty()
+            self.processes_changed.emit('cuts')
+            return True
+        return False
+
+    def get_all_features(self) -> List[dict]:
+        """Return unified list of all holes and slots."""
+        features = []
+        for h in self._state.processes.holes:
+            feat = dict(h)
+            feat.setdefault('kind', 'hole')
+            features.append(feat)
+        for s in self._state.processes.slots:
+            feat = dict(s)
+            feat.setdefault('kind', 'slot')
+            features.append(feat)
+        return features
+
+    def get_feature(self, index: int) -> Optional[dict]:
+        """Get feature at combined index."""
+        features = self.get_all_features()
+        if 0 <= index < len(features):
+            return dict(features[index])
+        return None
+
+    def update_feature(self, index: int, new_data: dict) -> bool:
+        """Update a hole or slot at the given combined index."""
+        num_holes = len(self._state.processes.holes)
+        if index < 0:
+            return False
+        is_slot = float(new_data.get('length', 0.0) or 0.0) > 0 or new_data.get('kind') == 'slot'
+
+        if index < num_holes:
+            if is_slot:
+                # Transformed into a slot: move from holes to slots
+                self._state.processes.holes.pop(index)
+                self._state.processes.slots.append(dict(new_data))
+                self._mark_dirty()
+                self.processes_changed.emit('slots')
+            else:
+                self._state.processes.holes[index] = dict(new_data)
+                self._mark_dirty()
+                self.processes_changed.emit('holes')
+            return True
+        else:
+            slot_idx = index - num_holes
+            if slot_idx < len(self._state.processes.slots):
+                if not is_slot:
+                    # Transformed into a hole: move from slots to holes
+                    self._state.processes.slots.pop(slot_idx)
+                    self._state.processes.holes.append(dict(new_data))
+                    self._mark_dirty()
+                    self.processes_changed.emit('holes')
+                else:
+                    self._state.processes.slots[slot_idx] = dict(new_data)
+                    self._mark_dirty()
+                    self.processes_changed.emit('slots')
+                return True
+        return False
+
+    def remove_feature(self, index: int) -> bool:
+        """Remove feature at combined index."""
+        num_holes = len(self._state.processes.holes)
+        if index < 0:
+            return False
+        if index < num_holes:
+            self._state.processes.holes.pop(index)
+            self._mark_dirty()
+            self.processes_changed.emit('holes')
+            return True
+        else:
+            slot_idx = index - num_holes
+            if slot_idx < len(self._state.processes.slots):
+                self._state.processes.slots.pop(slot_idx)
+                self._mark_dirty()
+                self.processes_changed.emit('slots')
+                return True
+        return False
+
+    def duplicate_feature(self, index: int, dx: float = 50.0, dy: float = 0.0) -> Optional[dict]:
+        """Duplicate feature at index with coordinate offset."""
+        feat = self.get_feature(index)
+        if not feat:
+            return None
+        dup = copy.deepcopy(feat)
+        dup['x'] = float(dup.get('x', 0.0)) + dx
+        dup['y'] = float(dup.get('y', 0.0)) + dy
+        is_slot = float(dup.get('length', 0.0) or 0.0) > 0 or dup.get('kind') == 'slot'
+        if is_slot:
+            self.add_slot(dup)
+        else:
+            self.add_hole(dup)
+        return dup
+
+    def remove_hole(self, index: int) -> None:
+        if 0 <= index < len(self._state.processes.holes):
+            self._state.processes.holes.pop(index)
+            self._mark_dirty()
+            self.processes_changed.emit('holes')
+
+    def remove_slot(self, index: int) -> None:
+        if 0 <= index < len(self._state.processes.slots):
+            self._state.processes.slots.pop(index)
+            self._mark_dirty()
+            self.processes_changed.emit('slots')
+
+    def clear_processes(self) -> None:
+        self._state.processes.holes.clear()
+        self._state.processes.slots.clear()
+        self._state.processes.cuts.clear()
+        self._state.processes.dimensions.clear()
+        self._mark_dirty()
+        self.processes_changed.emit('holes')
+
+    def set_file_path(self, path) -> None:
+        self._state.file_path = path
+        self.file_changed.emit()
+
+    def mark_clean(self) -> None:
+        self._state.is_dirty = False
+        self.dirty_changed.emit(False)
+
+    def _mark_dirty(self) -> None:
+        if not self._state.is_dirty:
+            self._state.is_dirty = True
+            self.dirty_changed.emit(True)
+
+    def load_from_dict(self, data: dict) -> None:
+        """Load from .ncp dict — handles old format (profile.name) and new."""
+        if 'processes' not in data:
+            data = _normalize_legacy_format(data)
+        self._state = AppState.from_dict(data)
+        self.profile_changed.emit('all')
+        self.processes_changed.emit('holes')
+        self.mark_clean()
+        self.file_changed.emit()
+
+    def save_to_dict(self) -> dict:
+        """Export current state as a JSON-serializable dict."""
+        return self._state.to_dict()
+
+    def load_from_file(self, path: str) -> None:
+        """Load from .ncp JSON file."""
+        with open(path, 'r', encoding='utf-8') as f:
+            data = json.load(f)
+        self._state.file_path = path
+        self.load_from_dict(data)
+
+    def save_to_file(self, path: str) -> None:
+        """Save to .ncp JSON file (atomic write)."""
+        data = self.save_to_dict()
+        tmp = path + '.tmp'
+        with open(tmp, 'w', encoding='utf-8') as f:
+            json.dump(data, f, indent=2, ensure_ascii=False)
+        os.replace(tmp, path)
+        self._state.file_path = path
+        self.mark_clean()
+        self.file_changed.emit()
+
+
+def _normalize_legacy_format(data: dict) -> dict:
+    """Convert old .ncp format (profile.name, top-level holes) to new format."""
+    profile = data.get('profile', {})
+    name = profile.get('name', profile.get('profile_name', 'IPE240'))
+    angles = profile.get('angles', {})
+    return {
+        'version': data.get('version', '1.0'),
+        'profile': {
+            'profile_name': name,
+            'material': profile.get('material', 'S235JR'),
+            'length': profile.get('length', 6000.0),
+            'angle_steg_front': angles.get('steg_front', 0.0),
+            'angle_steg_rear': angles.get('steg_rear', 0.0),
+            'angle_flange_front': angles.get('flange_front', 0.0),
+            'angle_flange_rear': angles.get('flange_rear', 0.0),
+        },
+        'processes': {
+            'holes': data.get('holes', []),
+            'slots': data.get('slots', []),
+            'cuts': data.get('cuts', []),
+            'dimensions': data.get('dimensions', []),
+        },
+    }
diff --git a/src/nccorrection/ui/dialogs/create_file_dialog.py b/src/nccorrection/ui/dialogs/create_file_dialog.py
new file mode 100644
index 0000000..8b951d9
--- /dev/null
+++ b/src/nccorrection/ui/dialogs/create_file_dialog.py
@@ -0,0 +1,218 @@
+"""Create-a-new-part wizard (Phase D).
+
+The "+" button in the NC list opens this dialog to author a brand-new NC1/DXF
+part without having a file on disk. It offers:
+  * mark (part name)
+  * output format  : NC1  or  DXF
+  * profile type   : IPE / HEA / HEB / HEM / UPN / UPE / L / TUB / TUBC / PL
+  * length (mm)
+  * a hole spreadsheet (one per row: x, y, diameter) with add/remove
+
+Three commit buttons, each meaning something different (the user insisted each
+option has its own job):
+  * OK            -> build the part, add it to the list, close the dialog
+  * Apply         -> build + add to the list, keep the dialog open (repeat)
+  * Save to disk  -> build, write the file to a chosen folder, add + close
+
+The dialog never touches ``QDialog.exec`` from inside its own widgets; it
+exposes :meth:`build_parts` so the main window can decide when to commit, which
+keeps it testable in offscreen mode.
+"""
+
+from PySide6.QtWidgets import (QDialog, QVBoxLayout, QHBoxLayout, QFormLayout,
+                               QLineEdit, QComboBox, QSpinBox,
+                               QLabel, QPushButton, QTableWidget,
+                               QTableWidgetItem, QHeaderView, QMessageBox,
+                               QFileDialog)
+
+import os
+
+from nccorrection.core.file_factory import build_nc1
+
+
+def _f(text):
+    try:
+        return float(text)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+class CreateFileDialog(QDialog):
+    """Author a new NC1/DXF part from scratch."""
+
+    def __init__(self, parent=None, tr_=None):
+        super().__init__(parent)
+        self._t = tr_ or (lambda s: s)
+        self.setWindowTitle(self._t('create_new_file'))
+        self.resize(560, 520)
+        self._build_ui()
+
+    # -- helpers -----------------------------------------------------------
+    def t(self, key):
+        return self._t(key)
+
+    def _build_ui(self):
+        lay = QVBoxLayout(self)
+        form = QFormLayout()
+
+        self.mark_edit = QLineEdit(self)
+        self.mark_edit.setPlaceholderText('IPE360-01')
+        form.addRow(self.t('mark'), self.mark_edit)
+
+        self.format_combo = QComboBox(self)
+        self.format_combo.addItems(['NC1', 'DXF'])
+        form.addRow(self.t('format'), self.format_combo)
+
+        self.profile_combo = QComboBox(self)
+        self.profile_combo.setEditable(True)
+        self.profile_combo.addItems(
+            ['IPE', 'HEA', 'HEB', 'HEM', 'UPN', 'UPE', 'L', 'TUB', 'TUBC', 'PL'])
+        form.addRow(self.t('profile_type'), self.profile_combo)
+
+        self.length_spin = QSpinBox(self)
+        self.length_spin.setRange(1, 50000)
+        self.length_spin.setValue(5000)
+        self.length_spin.setSuffix(' mm')
+        form.addRow(self.t('length'), self.length_spin)
+
+        lay.addLayout(form)
+
+        lab = QLabel(self.t('holes'), self)
+        lay.addWidget(lab)
+
+        self.holes_table = QTableWidget(1, 3, self)
+        self.holes_table.setHorizontalHeaderLabels(
+            [self.t('hole_x'), self.t('hole_y'), self.t('hole_d')])
+        self.holes_table.horizontalHeader().setSectionResizeMode(
+            QHeaderView.Stretch)
+        self.holes_table.setItem(0, 0, QTableWidgetItem('200'))
+        self.holes_table.setItem(0, 1, QTableWidgetItem('50'))
+        self.holes_table.setItem(0, 2, QTableWidgetItem('22'))
+        lay.addWidget(self.holes_table)
+
+        rowbtns = QHBoxLayout()
+        add = QPushButton(self.t('add_hole'), self)
+        add.clicked.connect(self._add_row)
+        remove = QPushButton(self.t('remove_hole'), self)
+        remove.clicked.connect(self._remove_row)
+        rowbtns.addWidget(add)
+        rowbtns.addWidget(remove)
+        rowbtns.addStretch(1)
+        lay.addLayout(rowbtns)
+
+        lay.addStretch(1)
+
+        btns = QHBoxLayout()
+        self.ok_btn = QPushButton(self.t('ok'), self)
+        self.ok_btn.clicked.connect(self._ok)
+        self.apply_btn = QPushButton(self.t('apply'), self)
+        self.apply_btn.clicked.connect(self._apply)
+        self.save_btn = QPushButton(self.t('save_to_disk'), self)
+        self.save_btn.clicked.connect(self._save_to_disk)
+        cancel = QPushButton(self.t('cancel'), self)
+        cancel.clicked.connect(self.reject)
+        btns.addWidget(cancel)
+        btns.addStretch(1)
+        btns.addWidget(self.apply_btn)
+        btns.addWidget(self.save_btn)
+        btns.addWidget(self.ok_btn)
+        lay.addLayout(btns)
+
+        self._pending = []
+
+    def _add_row(self):
+        r = self.holes_table.rowCount()
+        self.holes_table.insertRow(r)
+        self.holes_table.setItem(r, 0, QTableWidgetItem('200'))
+        self.holes_table.setItem(r, 1, QTableWidgetItem('50'))
+        self.holes_table.setItem(r, 2, QTableWidgetItem('22'))
+
+    def _remove_row(self):
+        r = self.holes_table.currentRow()
+        if r >= 0:
+            self.holes_table.removeRow(r)
+
+    def _collect_holes(self):
+        holes = []
+        for r in range(self.holes_table.rowCount()):
+            x = _f(self.holes_table.item(r, 0).text() if self.holes_table.item(r, 0) else '')
+            y = _f(self.holes_table.item(r, 1).text() if self.holes_table.item(r, 1) else '')
+            d = _f(self.holes_table.item(r, 2).text() if self.holes_table.item(r, 2) else '')
+            if d > 0:
+                holes.append({'x': x, 'y': y, 'd': d})
+        return holes
+
+    def _mark(self):
+        m = self.mark_edit.text().strip().replace(' ', '_')
+        if not m:
+            m = 'NEW'
+        return m
+
+    def _profile_name(self):
+        p = self.profile_combo.currentText().strip()
+        m = self._mark()
+        if p.upper() in ('IPE', 'HEA', 'HEB', 'HEM', 'UPN', 'UPE', 'L', 'TUB',
+                         'TUBC', 'PL'):
+            return m  # designation embedded in the mark
+        return p
+
+    def _build_text(self):
+        mark = self._mark()
+        profile = self._profile_name()
+        length = self.length_spin.value()
+        holes = self._collect_holes()
+        if self.format_combo.currentText().upper() == 'NC1':
+            return mark, build_nc1(mark, profile, length, holes)
+        return mark, _dxf_text(mark, length, holes)
+
+    def _apply(self):
+        mark, text = self._build_text()
+        self._pending.append((mark, text))
+        self.mark_edit.selectAll()
+
+    def _ok(self):
+        self._apply()
+        self.accept()
+
+    def _save_to_disk(self):
+        mark, text = self._build_text()
+        folder = QFileDialog.getExistingDirectory(self, self.t('choose_folder'))
+        if not folder:
+            return
+        ext = 'dxf' if self.format_combo.currentText().upper() == 'DXF' else 'nc1'
+        path = os.path.join(folder, f'{mark}.{ext}')
+        try:
+            with open(path, 'w', encoding='latin-1', newline='') as fh:
+                fh.write(text)
+        except OSError:
+            QMessageBox.warning(self, self.t('create_new_file'),
+                                self.t('save_error') + f': {path}')
+            return
+        self._pending.append((mark, text, path))
+        self.accept()
+
+    # -- public ------------------------------------------------------------
+    def pending_parts(self):
+        """Return authored (mark, text) pairs not yet committed."""
+        if self.result() == QDialog.DialogCode.Accepted and self._pending:
+            return list(self._pending)
+        return []
+def _dxf_text(mark, length, holes):
+    """Minimal DXF R12: rectangle outline + circle holes."""
+    import io
+    out = io.StringIO()
+    out.write('0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1009\n'
+              '9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n')
+    w = 100.0
+    rect = [(0, 0), (length, 0), (length, w), (0, w), (0, 0)]
+    for i in range(len(rect) - 1):
+        x1, y1 = rect[i]
+        x2, y2 = rect[i + 1]
+        out.write('0\nLINE\n8\nOUTLINE\n10\n%.4f\n20\n%.4f\n30\n0.0\n'
+                  '11\n%.4f\n21\n%.4f\n31\n0.0\n' % (x1, y1, x2, y2))
+    for h in holes:
+        d = float(h.get('d', 22))
+        out.write('0\nCIRCLE\n8\nHOLES\n10\n%.4f\n20\n%.4f\n30\n0.0\n40\n%.4f\n'
+                  % (float(h.get('x', 0)), float(h.get('y', 0)), d / 2.0))
+    out.write('0\nENDSEC\n0\nEOF\n')
+    return out.getvalue()
diff --git a/src/nccorrection/ui/dialogs/create_part/__init__.py b/src/nccorrection/ui/dialogs/create_part/__init__.py
