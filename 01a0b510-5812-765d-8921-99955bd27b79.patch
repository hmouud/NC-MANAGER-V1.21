+        self.assertAlmostEqual(rect.center().x(), mid_x, delta=1e-6)
+        self.assertIn('mm', label)
+        # with a parallel dim offset the label rides the shifted line
+        rect2, _ = w._measure_label_rect(a, b, dim_off=40.0)
+        self.assertAlmostEqual(rect2.center().x(), mid_x, delta=1e-6)
+        self.assertNotEqual(rect2.center().y(), rect.center().y())
