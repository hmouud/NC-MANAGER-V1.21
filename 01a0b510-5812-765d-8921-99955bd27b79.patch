+    def _measure_line_geometry(self, i):
+        """Screen geometry of measurement ``i`` as
+        ``(s1, s2, p1, p2, perp, dim_off)`` where ``p1/p2`` are the points of
+        the dimension line shifted parallel by ``dim_off`` (Tekla/AutoCAD
+        style) and ``perp`` is the unit perpendicular of the base line.
+        """
+        a, bpt, _off, dim_off = self._measurements3d[i]
+        s1 = QPointF(*self._project(a))
+        s2 = QPointF(*self._project(bpt))
+        ln = math.hypot(s2.x() - s1.x(), s2.y() - s1.y())
+        if ln < 1e-9:
+            perp = QPointF(0.0, -1.0)
+        else:
+            perp = QPointF(-(s2.y() - s1.y()) / ln, (s2.x() - s1.x()) / ln)
+        shift = perp * dim_off
+        return s1, s2, s1 + shift, s2 + shift, perp, dim_off
