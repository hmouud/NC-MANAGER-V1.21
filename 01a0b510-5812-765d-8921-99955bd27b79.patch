@@ -0,0 +1,352 @@
+"""Pure geometry math for the dimensioning engine.
+
+No Qt, no rendering — just mathematical helpers for computing dimension
+positions, arc interpolation, circle fitting, and bolt-circle detection.
+Every function takes/returns :class:`Point2D` or plain floats.
+"""
+from __future__ import annotations
+
+import math
+from typing import List, Optional, Tuple
+
+from .types import Point2D, Circle, Arc
+
+
+# ────────────────────────────────────────────────────────────────────
+# Circle fitting
+# ────────────────────────────────────────────────────────────────────
+
+def circle_from_3_points(p1: Point2D, p2: Point2D, p3: Point2D) -> Optional[Circle]:
+    """Compute the unique circle passing through three non-collinear points.
+
+    Uses perpendicular-bisector intersection (Euclidean geometry).
+    Returns None if points are collinear or degenerate.
+    """
+    ax, ay = p1.x, p1.y
+    bx, by = p2.x, p2.y
+    cx, cy = p3.x, p3.y
+
+    d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by))
+    if abs(d) < 1e-12:
+        return None  # Collinear
+
+    ux = ((ax * ax + ay * ay) * (by - cy) +
+          (bx * bx + by * by) * (cy - ay) +
+          (cx * cx + cy * cy) * (ay - by)) / d
+    uy = ((ax * ax + ay * ay) * (cx - bx) +
+          (bx * bx + by * by) * (ax - cx) +
+          (cx * cx + cy * cy) * (bx - ax)) / d
+
+    center = Point2D(ux, uy)
+    radius = math.hypot(ax - ux, ay - uy)
+    return Circle(center=center, radius=radius)
+
+
+def circle_from_center_and_radius(center: Point2D, radius: float) -> Circle:
+    """Convenience constructor."""
+    return Circle(center=center, radius=radius)
+
+
+def circle_center_from_contour(pts: List[Tuple[float, float]]) -> Optional[Point2D]:
+    """Estimate circle centre from a list of (x, y) contour points.
+
+    Uses bounding-box midpoint (fast and sufficient for circular contours).
+    """
+    if len(pts) < 2:
+        return None
+    xs = [p[0] for p in pts]
+    ys = [p[1] for p in pts]
+    return Point2D((min(xs) + max(xs)) / 2.0, (min(ys) + max(ys)) / 2.0)
+
+
+def circle_radius_from_contour(pts: List[Tuple[float, float]],
+                               center: Point2D) -> float:
+    """Average distance from centre to each contour point."""
+    if not pts:
+        return 0.0
+    dists = [math.hypot(x - center.x, y - center.y) for x, y in pts]
+    return sum(dists) / len(dists)
+
+
+# ────────────────────────────────────────────────────────────────────
+# Arc interpolation
+# ────────────────────────────────────────────────────────────────────
+
+def arc_points(center: Point2D, radius: float,
+               start_deg: float, end_deg: float,
+               num_segments: int = 48) -> List[Point2D]:
+    """Generate evenly-spaced points along an arc."""
+    sweep = end_deg - start_deg
+    if sweep < 0:
+        sweep += 360.0
+    if sweep < 1e-9:
+        return [center.offset(radius, 0)]
+
+    points = []
+    for i in range(num_segments + 1):
+        t = start_deg + sweep * i / num_segments
+        rad = math.radians(t)
+        points.append(Point2D(
+            center.x + radius * math.cos(rad),
+            center.y + radius * math.sin(rad),
+        ))
+    return points
+
+
+def arc_between_angles(center: Point2D, radius: float,
+                       angle1_deg: float, angle2_deg: float,
+                       num_segments: int = 48) -> List[Point2D]:
+    """Generate arc points from angle1 to angle2 (counter-clockwise)."""
+    return arc_points(center, radius, angle1_deg, angle2_deg, num_segments)
+
+
+def nearest_angle_on_circle(pt: Point2D, center: Point2D) -> float:
+    """Angle in degrees from centre to point (0-360)."""
+    return math.degrees(math.atan2(pt.y - center.y, pt.x - center.x)) % 360.0
+
+
+# ────────────────────────────────────────────────────────────────────
+# Dimension geometry helpers
+# ────────────────────────────────────────────────────────────────────
+
+def leader_endpoint(center: Point2D, point_on_circle: Point2D,
+                    leader_length: float) -> Point2D:
+    """Compute the endpoint of a radius leader line.
+
+    The leader extends beyond point_on_circle by leader_length in the
+    same direction (center → edge).
+    """
+    dx = point_on_circle.x - center.x
+    dy = point_on_circle.y - center.y
+    length = math.hypot(dx, dy)
+    if length < 1e-12:
+        return center.offset(leader_length, 0)
+    ux, uy = dx / length, dy / length
+    return Point2D(
+        point_on_circle.x + ux * leader_length,
+        point_on_circle.y + uy * leader_length,
+    )
+
+
+def leader_tail_point(start: Point2D, end: Point2D,
+                      tail_length: float = 8.0) -> Tuple[Point2D, Point2D]:
+    """Compute the bent leader path: slant from start, then horizontal tail.
+
+    Returns (bend_point, tail_end).
+    """
+    # Bend point is at the same x as end, same y as start
+    bend = Point2D(end.x, start.y)
+    # Tail extends horizontally
+    if end.x > start.x:
+        tail_end = Point2D(end.x + tail_length, end.y)
+    else:
+        tail_end = Point2D(end.x - tail_length, end.y)
+    return bend, tail_end
+
+
+def text_position_for_radius(center: Point2D, radius: float,
+                             angle_deg: float,
+                             text_width: float = 20.0,
+                             outside: bool = True,
+                             text_height: float = 8.0) -> Point2D:
+    """Compute the text midpoint for a radius dimension.
+
+    When outside: text sits beyond the arrow.
+    When inside: text sits between center and arrow.
+    """
+    rad = math.radians(angle_deg)
+    direction = Point2D(math.cos(rad), math.sin(rad))
+
+    if outside:
+        # Text beyond the point_on_circle
+        dist = radius + text_width / 2.0 + 3.0
+    else:
+        # Text halfway between center and edge
+        dist = radius / 2.0
+
+    return Point2D(
+        center.x + direction.x * dist,
+        center.y + direction.y * dist,
+    )
+
+
+def text_position_for_diameter(center: Point2D, radius: float,
+                                angle_deg: float,
+                                text_width: float = 30.0,
+                                outside: bool = True) -> Point2D:
+    """Compute text midpoint for a diameter dimension."""
+    rad = math.radians(angle_deg)
+    direction = Point2D(math.cos(rad), math.sin(rad))
+
+    if outside:
+        dist = radius + text_width / 2.0 + 3.0
+    else:
+        dist = 0.0  # At center
+
+    return Point2D(
+        center.x + direction.x * dist,
+        center.y + direction.y * dist,
+    )
+
+
+def text_position_for_angular(vertex: Point2D, radius: float,
+                               angle1_deg: float, angle2_deg: float,
+                               text_height: float = 8.0) -> Point2D:
+    """Compute text midpoint for an angular dimension.
+
+    Text sits on the arc at the midpoint angle, offset outward slightly.
+    """
+    mid_angle = angle1_deg + (angle2_deg - angle1_deg) / 2.0
+    # Ensure positive sweep
+    sweep = angle2_deg - angle1_deg
+    if sweep < 0:
+        sweep += 360.0
+    mid_angle = angle1_deg + sweep / 2.0
+
+    rad = math.radians(mid_angle)
+    dist = radius + text_height / 2.0 + 2.0
+    return Point2D(
+        vertex.x + dist * math.cos(rad),
+        vertex.y + dist * math.sin(rad),
+    )
+
+
+def optimal_text_rotation(angle_deg: float) -> float:
+    """Return the optimal text rotation so it's never upside-down.
+
+    Standard convention: text reads left-to-right or bottom-to-top.
+    """
+    a = angle_deg % 360.0
+    if 90.0 < a <= 270.0:
+        return a - 180.0
+    return a
+
+
+def extension_line_endpoints(point: Point2D, dim_line_angle: float,
+                              offset: float = 1.5,
+                              extend: float = 3.0) -> Tuple[Point2D, Point2D]:
+    """Compute the start and end of an extension line.
+
+    Returns (start, end) where start is near the point and end is near
+    the dimension line.
+    """
+    rad = math.radians(dim_line_angle)
+    perp_x, perp_y = -math.sin(rad), math.cos(rad)  # Perpendicular
+    start = Point2D(
+        point.x + perp_x * offset,
+        point.y + perp_y * offset,
+    )
+    end = Point2D(
+        start.x + perp_x * extend,
+        start.y + perp_y * extend,
+    )
+    return start, end
+
+
+# ────────────────────────────────────────────────────────────────────
+# Bolt circle detection
+# ────────────────────────────────────────────────────────────────────
+
+def detect_bolt_circles(hole_positions: List[Point2D],
+                         tolerance: float = 2.0,
+                         min_holes: int = 3) -> List[Tuple[Point2D, float, List[Point2D]]]:
+    """Detect bolt circle patterns from a list of hole centres.
+
+    Algorithm:
+    1. For every pair of holes, estimate the circle that could contain
+       both (centre at midpoint, radius = half-distance).
+    2. Count how many other holes lie on that circle (within tolerance).
+    3. If >= min_holes, record it as a bolt circle.
+    4. De-duplicate by merging circles with similar centres + radii.
+
+    Returns list of (centre, radius, hole_positions_on_circle).
+    """
+    if len(hole_positions) < min_holes:
+        return []
+
+    candidates: List[Tuple[Point2D, float, List[Point2D]]] = []
+
+    # Strategy 1: Midpoint of every pair (fast, catches diameter-based patterns)
+    for i in range(len(hole_positions)):
+        for j in range(i + 1, len(hole_positions)):
+            p1 = hole_positions[i]
+            p2 = hole_positions[j]
+            cx = (p1.x + p2.x) / 2.0
+            cy = (p1.y + p2.y) / 2.0
+            r = math.hypot(p2.x - p1.x, p2.y - p1.y) / 2.0
+            if r < 1.0:
+                continue
+            centre = Point2D(cx, cy)
+            on_circle = [pt for pt in hole_positions
+                         if abs(pt.distance_to(centre) - r) < tolerance]
+            if len(on_circle) >= min_holes:
+                candidates.append((centre, r, on_circle))
+
+    # Strategy 2: Circle through every triple (catches non-diameter patterns)
+    for i in range(len(hole_positions)):
+        for j in range(i + 1, len(hole_positions)):
+            for k in range(j + 1, len(hole_positions)):
+                circ = circle_from_3_points(
+                    hole_positions[i], hole_positions[j], hole_positions[k])
+                if circ is None or circ.radius < 1.0:
+                    continue
+                on_circle = [pt for pt in hole_positions
+                             if abs(pt.distance_to(circ.center) - circ.radius)
+                             < tolerance]
+                if len(on_circle) >= min_holes:
+                    candidates.append((circ.center, circ.radius, on_circle))
+
+    # De-duplicate: merge candidates with similar centres + radii
+    merged: List[Tuple[Point2D, float, List[Point2D]]] = []
+    used = [False] * len(candidates)
+
+    for i, (c1, r1, pts1) in enumerate(candidates):
+        if used[i]:
+            continue
+        group_centres = [c1]
+        group_radii = [r1]
+        group_pts = list(pts1)
+
+        for j in range(i + 1, len(candidates)):
+            if used[j]:
+                continue
+            c2, r2, pts2 = candidates[j]
+            if (c1.distance_to(c2) < tolerance and
+                    abs(r1 - r2) < tolerance):
+                group_centres.append(c2)
+                group_radii.append(r2)
+                group_pts.extend(pts2)
+                used[j] = True
+
+        # Average the group
+        avg_cx = sum(c.x for c in group_centres) / len(group_centres)
+        avg_cy = sum(c.y for c in group_centres) / len(group_centres)
+        avg_r = sum(group_radii) / len(group_radii)
+
+        # Unique points on the circle
+        unique_pts = []
+        seen = set()
+        for pt in group_pts:
+            key = (round(pt.x, 1), round(pt.y, 1))
+            if key not in seen:
+                seen.add(key)
+                unique_pts.append(pt)
+
+        if len(unique_pts) >= min_holes:
+            merged.append((Point2D(avg_cx, avg_cy), avg_r, unique_pts))
+        used[i] = True
+
+    return merged
+
+
+def angular_spacing(hole_positions: List[Point2D],
+                    center: Point2D) -> List[float]:
+    """Compute sorted angular positions of holes around a centre.
+
+    Returns angles in degrees (0-360) sorted ascending.
+    """
+    angles = []
+    for pt in hole_positions:
+        a = math.degrees(math.atan2(pt.y - center.y, pt.x - center.x)) % 360.0
+        angles.append(a)
+    return sorted(angles)
