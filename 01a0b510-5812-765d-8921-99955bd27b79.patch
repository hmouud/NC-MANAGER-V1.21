@@ -0,0 +1,55 @@
+"""flange_interpreter.py — Flange cuts (o/u faces).
+
+🚨 GUARDIAN LAW: Single responsibility — غير الفلانج.
+"""
+from __future__ import annotations
+from typing import List
+
+from ..core.enums import Face, CutSide
+from ..core.constants import TOLERANCE_DEG
+from ..geometry.math_utils import tan_deg
+from ..geometry.dimensions import ProfileDimensions
+from ..models.cut_angles import CutAngles
+from ..models.intersection import IntersectionPoint
+
+
+class FlangeInterpreter:
+    """كايحسب نقاط التقاطع على الفلانج (o/u faces).
+
+    المعادلة: flange_offset = (H/2 - tf) * tan(angle)
+    """
+
+    def __init__(self, dims: ProfileDimensions, angles: CutAngles):
+        self.d = dims
+        self.angles = angles
+
+    def offset(self, angle_deg: float) -> float:
+        """flange_cut = (H/2 - tf) * tan(angle)."""
+        if abs(angle_deg) < TOLERANCE_DEG:
+            return 0.0
+        lever = max((self.d.H / 2.0) - self.d.tf, 0.0)
+        return lever * tan_deg(angle_deg)
+
+    def compute(self, face: Face) -> List[IntersectionPoint]:
+        if not self.angles.has_flange_cut:
+            return []
+
+        points: List[IntersectionPoint] = []
+
+        if abs(self.angles.flange_front) > TOLERANCE_DEG:
+            points.append(IntersectionPoint(
+                x=self.offset(self.angles.flange_front),
+                y=self.d.b, face=face, side=CutSide.FRONT,
+                source_angle=self.angles.flange_front,
+                description="flange_front cut",
+            ))
+
+        if abs(self.angles.flange_rear) > TOLERANCE_DEG:
+            points.append(IntersectionPoint(
+                x=-self.offset(self.angles.flange_rear),
+                y=self.d.b, face=face, side=CutSide.REAR,
+                source_angle=self.angles.flange_rear,
+                description="flange_rear cut",
+            ))
+
+        return sorted(points, key=lambda p: -p.y)
diff --git a/src/nccorrection/engine/contour/interpreters/web_interpreter.py b/src/nccorrection/engine/contour/interpreters/web_interpreter.py
